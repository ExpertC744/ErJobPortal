@model ErJobPortal.Models.SATopStatisticsVM

@* Radhika30-09 *@
<link rel="stylesheet"
      href="~/css/OrgTopSearch.css"
      asp-append-version="true" />

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Charts";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "SuperAdmin";
}

<div class="organization-charts-page">

    <!-- PAGE HEADER -->
    <div class="charts-header">
        <div>
            <h1>Charts &amp; Statistics</h1>
            <p>Candidate Statistics</p>
        </div>
    </div>

    <!-- TOP ROW -->
    <div class="charts-grid">

        <!-- TOP SKILLS -->
        <div class="chart-card">

            <div class="chart-card-header">
                <div class="chart-icon">
                    <i class="fas fa-code"></i>
                </div>

                <div>
                    <h3>Top Skills</h3>
                    <p>Most preferred trainee skills</p>
                </div>
            </div>

            <div class="chart-list">

                @if (Model.TopSkills != null && Model.TopSkills.Any())
                {
                    int rank = 1;

                    foreach (var item in Model.TopSkills)
                    {
                        decimal percentage = Math.Clamp(
                        item.Percentage, 0m, 100m);

                        <div class="chart-item">

                            <div class="chart-item-top">
                                <span class="rank">
                                    @rank.ToString("D2")
                                </span>

                                <span class="item-name">
                                    @item.Name
                                </span>

                                <span class="percentage">
                                    @item.Percentage.ToString("0.##")%
                                </span>
                            </div>

                            <div class="progress-track">
                                <div class="progress-fill"
                                     style="width: @percentage.ToString(
                                                                              System.Globalization.CultureInfo.InvariantCulture)%;">
                        </div>
                    </div>

                        </div>

                                rank++;
                    }
                }
                else
                {
                    <p>No skill data available.</p>
                }

            </div>
        </div>

        <!-- TOP CITIES -->
        <div class="chart-card">

            <div class="chart-card-header">
                <div class="chart-icon">
                    <i class="fas fa-location-dot"></i>
                </div>

                <div>
                    <h3>Top Cities</h3>
                    <p>Locations with maximum trainees</p>
                </div>
            </div>

            <div class="chart-list">

                @if (Model.TopCities != null && Model.TopCities.Any())
                {
                    int rank = 1;

                    foreach (var item in Model.TopCities)
                    {
                        decimal percentage = Math.Clamp(
                        item.Percentage, 0m, 100m);

                        <div class="chart-item">

                            <div class="chart-item-top">
                                <span class="rank">
                                    @rank.ToString("D2")
                                </span>

                                <span class="item-name">
                                    @item.Name
                                </span>

                                <span class="percentage">
                                    @item.Percentage.ToString("0.##")%
                                </span>
                            </div>

                            <div class="progress-track">
                                <div class="progress-fill"
                                     style="width: @percentage.ToString(
                                                                              System.Globalization.CultureInfo.InvariantCulture)%;">
                        </div>
                    </div>

                        </div>

                                rank++;
                    }
                }
                else
                {
                    <p>No city data available.</p>
                }

            </div>
        </div>

    </div>

    <!-- TOP FIELDS -->
    <div class="fields-wrapper">

        <div class="chart-card fields-card">

            <div class="chart-card-header">
                <div class="chart-icon">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div>
                    <h3>Top Fields</h3>
                    <p>Most selected candidate skill categories</p>
                </div>
            </div>

            <div class="chart-list">

                @if (Model.TopFields != null && Model.TopFields.Any())
                {
                    int rank = 1;

                    foreach (var item in Model.TopFields)
                    {
                        decimal percentage = Math.Clamp(
                        item.Percentage, 0m, 100m);

                        <div class="chart-item">

                            <div class="chart-item-top">
                                <span class="rank">
                                    @rank.ToString("D2")
                                </span>

                                <span class="item-name">
                                    @item.Name
                                </span>

                                <span class="percentage">
                                    @item.Percentage.ToString("0.##")%
                                </span>
                            </div>

                            <div class="progress-track">
                                <div class="progress-fill"
                                     style="width: @percentage.ToString(
                                                                              System.Globalization.CultureInfo.InvariantCulture)%;">
                        </div>
                    </div>

                        </div>

                                rank++;
                    }
                }
                else
                {
                    <p>No field data available.</p>
                }

            </div>
        </div>

    </div>

</div>
