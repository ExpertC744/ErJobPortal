                <!-- Chart -->
                <div class="chart-wrapper">

                    <svg id="yearlyTraineeChart"
                         viewBox="0 0 760 300"
                         preserveAspectRatio="none">

                        <!-- Horizontal Grid -->
                        <line class="chart-grid"
                              x1="65" y1="25"
                              x2="735" y2="25" />

                        <line class="chart-grid"
                              x1="65" y1="70"
                              x2="735" y2="70" />

                        <line class="chart-grid"
                              x1="65" y1="115"
                              x2="735" y2="115" />

                        <line class="chart-grid"
                              x1="65" y1="160"
                              x2="735" y2="160" />

                        <line class="chart-grid"
                              x1="65" y1="205"
                              x2="735" y2="205" />

                        <line class="chart-grid"
                              x1="65" y1="250"
                              x2="735" y2="250" />


                        <!-- Vertical Grid -->
                        <g id="yearlyVerticalGrid"></g>


                        <!-- Axis -->
                        <line class="chart-axis"
                              x1="65"
                              y1="25"
                              x2="65"
                              y2="250" />

                        <line class="chart-axis"
                              x1="65"
                              y1="250"
                              x2="735"
                              y2="250" />


                        <!-- Y Axis Values -->
                        <text class="chart-axis-text"
                              x="53"
                              y="254"
                              text-anchor="end">
                            0
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="209"
                              text-anchor="end">
                            100
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="164"
                              text-anchor="end">
                            200
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="119"
                              text-anchor="end">
                            300
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="74"
                              text-anchor="end">
                            400
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="29"
                              text-anchor="end">
                            500
                        </text>


                        <!-- Y Axis Title -->
                        <text class="chart-axis-text"
                              transform="translate(17 140) rotate(-90)"
