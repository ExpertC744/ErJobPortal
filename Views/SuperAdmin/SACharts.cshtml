                            No. of Trainee registered

                        </text>


                        <!-- Area -->
                        <polygon id="yearlyTraineeArea"
                                 class="chart-area"
                                 points="">
                        </polygon>


                        <!-- Line -->
                        <polyline id="yearlyTraineeLine"
                                  class="chart-line"
                                  points="">
                        </polyline>


                        <!-- Points -->
                        <g id="yearlyTraineePoints"></g>


                        <!-- X Axis -->
                        <g id="yearlyTraineeMonths"></g>


                        <!-- X Axis Title -->
                        <text class="chart-axis-text"
                              x="400"
                              y="295"
                              text-anchor="middle">

                            No. Of months

                        </text>

                    </svg>

                </div>

            </div>


            <!-- Footer -->
            <div class="analytics-footer">

                <i class="fas fa-chart-line"></i>

                Monthly trainee registration trend

            </div>

        </div>

    </div>


    <!-- =================================================
         INTERNSHIP POST FROM ORGANIZATION
    ================================================== -->

    <div class="col-xl-6 col-lg-6 col-md-12">

        <div class="analytics-card">

            <!-- Header -->
            <div class="analytics-header">

                <div class="analytics-header-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>

                <h5>
                    Internship post from Organization
                </h5>

            </div>


            <!-- Body -->
            <div class="analytics-body">

                <!-- Legend -->
                <div class="chart-legend">

                    <span class="legend-box-bar"></span>

                    <span>
                        No. of post
                    </span>

                </div>


                <!-- Chart -->
                <div class="chart-wrapper">

                    <svg id="organizationPostChart"
                         viewBox="0 0 760 300"
                         preserveAspectRatio="none">

                        <!-- Horizontal Grid -->
                        <line class="chart-grid"
                              x1="65" y1="25"
                              x2="735" y2="25" />

                        <line class="chart-grid"
                              x1="65" y1="70"
                              x2="735" y2="70" />

                        <line class="chart-grid"
                              x1="65" y1="115"
                              x2="735" y2="115" />

                        <line class="chart-grid"
                              x1="65" y1="160"
                              x2="735" y2="160" />

                        <line class="chart-grid"
                              x1="65" y1="205"
                              x2="735" y2="205" />

                        <line class="chart-grid"
                              x1="65" y1="250"
                              x2="735" y2="250" />


                        <!-- Vertical Grid -->
                        <g id="organizationVerticalGrid"></g>


                        <!-- Axis -->
                        <line class="chart-axis"
                              x1="65"
                              y1="25"
                              x2="65"
                              y2="250" />

                        <line class="chart-axis"
                              x1="65"
                              y1="250"
                              x2="735"
                              y2="250" />


                        <!-- Y Axis Values -->
                        <text class="chart-axis-text"
                              x="53"
                              y="254"
                              text-anchor="end">
                            0
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="209"
                              text-anchor="end">
                            14
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="164"
                              text-anchor="end">
                            28
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="119"
                              text-anchor="end">
                            42
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="74"
                              text-anchor="end">
                            56
                        </text>

                        <text class="chart-axis-text"
                              x="53"
                              y="29"
                              text-anchor="end">
                            70
                        </text>


                        <!-- Y Axis Title -->
                        <text class="chart-axis-text"
                              transform="translate(17 140) rotate(-90)"
                              text-anchor="middle">

                            No. of post

                        </text>


                        <!-- Bars -->
                        <g id="organizationPostBars"></g>


                        <!-- X Axis -->
                        <g id="organizationPostMonths"></g>


                        <!-- X Axis Title -->
                        <text class="chart-axis-text"
                              x="400"
                              y="295"
