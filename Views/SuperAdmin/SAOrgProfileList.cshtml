                    <script>

    function toggleOrganizationStatus(button) {

        var id = $(button).data("id");

        // Current button state
        var currentStatus = $(button).hasClass("enabled");

        // New status
        var newStatus = !currentStatus;

        // Prevent double click
        $(button).prop("disabled", true);

        $.ajax({

            url: '@Url.Action("ToggleOrganizationStatus", "SuperAdmin")',

            type: 'POST',

            data: {
                id: id,
                status: newStatus
            },

            success: function (response) {

                console.log(response);

                if (response.success) {

                    if (response.status) {

                        $(button)
                            .removeClass("disabled")
                            .addClass("enabled")
                            .text("Enabled");

                    }
                    else {

                        $(button)
                            .removeClass("enabled")
                            .addClass("disabled")
                            .text("Disabled");

                    }

                }
                else {

                    alert(response.message || "Unable to update organization status.");

                }

            },

            error: function (xhr) {

                console.log("HTTP STATUS:", xhr.status);
                console.log("RESPONSE:", xhr.responseText);

                alert(
                    "Error updating organization status.\n\n" +
                    "HTTP Status: " + xhr.status
                );

            },

            complete: function () {

                $(button).prop("disabled", false);

            }

        });

    }

</script>