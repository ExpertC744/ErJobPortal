
@model ErJobPortal.Models.SAObjectiveM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Objective";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

<style>
    /* =========================================================
       EDIT OBJECTIVE FORM
       ========================================================= */

    .trainee-form-page {
        width: 100%;
        padding: 30px 20px 50px;
        background: #f7faf9;
        min-height: calc(100vh - 80px);
    }

    .trainee-form-wrapper {
        max-width: 850px;
        margin: 0 auto;
    }

    .trainee-form-heading {
        margin-bottom: 22px;
    }

    .trainee-form-heading h2 {
        margin: 0;
        color: #0f172a;
        font-size: 26px;
        font-weight: 700;
    }

    .trainee-form-heading p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .trainee-form-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(15, 118, 110, 0.08);
        overflow: hidden;
    }

    .trainee-form-card-header {
        position: relative;
        padding: 20px 26px;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        color: #ffffff;
    }

    .trainee-form-card-header h3 {
        position: relative;
        z-index: 1;
        margin: 0;
        font-size: 20px;
        font-weight: 700;
    }

    .trainee-form-card-header p {
        position: relative;
        z-index: 1;
        margin: 5px 0 0;
        font-size: 13px;
        opacity: 0.9;
    }

    .trainee-form-body {
        padding: 30px;
    }

    .trainee-form-group {
        margin-bottom: 22px;
    }

    .trainee-form-label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 14px;
        font-weight: 600;
    }

    .required {
        color: #dc2626;
        margin-left: 2px;
    }

    .trainee-field-icon {
        color: #0d9488;
        margin-right: 5px;
    }

    .trainee-form-input,
    .trainee-form-select,
    .trainee-form-textarea {
        width: 100%;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: #0f172a;
        font-size: 14px;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }

    .trainee-form-input,
    .trainee-form-select {
        height: 46px;
        padding: 0 14px;
    }

    .trainee-form-textarea {
        min-height: 120px;
        padding: 12px 14px;
        resize: vertical;
        line-height: 1.5;
    }

    .trainee-form-input:focus,
    .trainee-form-select:focus,
    .trainee-form-textarea:focus {
        border-color: #0d9488;
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.10);
    }

    .trainee-error {
        display: block;
        margin-top: 6px;
        color: #dc2626;
        font-size: 12px;
        min-height: 17px;
    }

    .trainee-form-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        padding: 20px 30px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .trainee-btn {
        border: none;
        border-radius: 8px;
        height: 42px;
        padding: 0 22px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .trainee-btn-primary {
        color: #ffffff;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        box-shadow: 0 4px 10px rgba(13, 148, 136, 0.18);
    }

    .trainee-btn-primary:hover {
        background: linear-gradient(135deg, #0f766e, #115e59);
        transform: translateY(-1px);
    }

    .trainee-btn-secondary {
        color: #334155;
        background: #e2e8f0;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .trainee-btn-secondary:hover {
        background: #cbd5e1;
        color: #0f172a;
    }

    .validation-summary-errors {
        color: #dc2626;
        margin-bottom: 15px;
    }

    @@media (max-width: 768px) {

        .trainee-form-page {
            padding: 20px 12px 40px;
        }

        .trainee-form-body {
            padding: 22px 18px;
        }

        .trainee-form-footer {
            padding: 16px 18px;
        }
    }

    @@media (max-width: 480px) {

        .trainee-form-body {
            padding: 20px 15px;
        }

        .trainee-form-footer {
            padding: 15px;
            flex-direction: column;
        }

        .trainee-btn {
            width: 100%;
        }
    }
</style>


<div class="trainee-form-page">

    <div class="trainee-form-wrapper">

        <!-- PAGE HEADING -->

        <div class="trainee-form-heading">

            <h2>
                <i class="fas fa-edit trainee-field-icon"></i>
                Edit Objective
            </h2>

            <p>
                Update the candidate objective details.
            </p>

        </div>


        <!-- FORM CARD -->

        <div class="trainee-form-card">

            <!-- HEADER -->

            <div class="trainee-form-card-header">

                <h3>
                    <i class="fas fa-bullseye me-2"></i>
                    Objective Details
                </h3>

                <p>
                    Update the required information below.
                </p>

            </div>


            <!-- FORM -->

            <form asp-controller="SuperAdmin"
                  asp-action="EditObjective"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Hidden ID -->

                <input type="hidden"
                       asp-for="nID" />


                <div class="trainee-form-body">

                    <!-- Validation -->

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary-errors">
                    </div>


                    <!-- Gender -->

                    <div class="trainee-form-group">

                        <label asp-for="nGenderID"
                               class="trainee-form-label">

                            <i class="fas fa-venus-mars trainee-field-icon"></i>

                            Gender

                            <span class="required">*</span>

                        </label>


                        <select asp-for="nGenderID"
                                class="trainee-form-select">

                            <option value="">
                                -- Select Gender --
                            </option>

                            <option value="1">
                                Male
                            </option>

                            <option value="2">
                                Female
                            </option>

                        </select>


                        <span asp-validation-for="nGenderID"
                              class="trainee-error">
                        </span>

                    </div>


                    <!-- Objective -->

                    <div class="trainee-form-group">

                        <label asp-for="sObjective"
                               class="trainee-form-label">

                            <i class="fas fa-align-left trainee-field-icon"></i>

                            Objective

                            <span class="required">*</span>

                        </label>


                        <textarea asp-for="sObjective"
                                  class="trainee-form-textarea"
                                  rows="5"
                                  placeholder="Enter objective">
                        </textarea>


                        <span asp-validation-for="sObjective"
                              class="trainee-error">
                        </span>

                    </div>

                </div>


                <!-- FOOTER -->

                <div class="trainee-form-footer">

                    <a asp-controller="SuperAdmin"
                       asp-action="ViewObjective"
                       asp-route-id="1"
                       class="trainee-btn trainee-btn-secondary">

                        <i class="fas fa-arrow-left me-2"></i>

                        Back

                    </a>


                    <button type="submit"
                            class="trainee-btn trainee-btn-primary">

                        <i class="fas fa-save me-2"></i>

                        Update Objective

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

