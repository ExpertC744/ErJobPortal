@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
     Layout = null;
    ViewData["Title"] = "Payment Receipt";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";

}

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAViewAdvertisement.css" asp-append-version="true" />


<div class="container-fluid payment-receipt-page">


   

    <!-- RECEIPT + ACTIONS -->

    <div class="receipt-area">


        <!-- =====================================================
             RECEIPT
        ====================================================== -->

        <div class="payment-receipt">


            <!-- TOP -->

            <div class="receipt-top">

                <div class="receipt-top-header">


                    <!-- LOGO -->

                    <img src="~/img/core-img/Logo.png"
                         class="receipt-logo"
                         alt="ItNetworkZ" />


                    <!-- TITLE -->

                    <div class="receipt-heading">

                        <h1>
                            Payment Receipt
                        </h1>

                        <span>
                            1Trainee Advertisement
                        </span>

                    </div>


                    <!-- RECEIPT NUMBER -->

                    <div class="receipt-number-box">

                        <small>
                            Receipt No.
                        </small>

                        <strong>
                            1T26112438R
                        </strong>

                    </div>

                </div>

            </div>


            <div class="receipt-divider"></div>


            <!-- =================================================
                 BASIC INFORMATION
            ================================================== -->

            <div class="receipt-section"
                 style="margin-top:0;">

                <div class="receipt-details">


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Date :
                        </span>

                        <span class="receipt-detail-value">
                            26-11-2024
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Client Name :
                        </span>

                        <span class="receipt-detail-value">
                            Tyuqw
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Company :
                        </span>

                        <span class="receipt-detail-value">
                            ItNetworkZ
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Payment Purpose :
                        </span>

                        <span class="receipt-detail-value">
                            Advertisement
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Paid Amount :
                        </span>

                        <span class="receipt-detail-value">
                            ₹ 500.00
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Payment Mode :
                        </span>

                        <span class="receipt-detail-value">
                            By Cash
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Amount In Words :
                        </span>

                        <span class="receipt-detail-value">
                            Five Hundred Rupees Only
                        </span>

                    </div>


                    <div class="receipt-detail">

                        <span class="receipt-detail-label">
                            Status :
                        </span>

                        <span class="receipt-detail-value">
                            Paid
                        </span>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 ADVERTISEMENT
            ================================================== -->

            <div class="receipt-section">

                <div class="receipt-section-title">

                    Advertisement Details

                </div>


                <div class="advertisement-row">


                    <div class="advertisement-item">

                        <div class="advertisement-label">
                            Location
                        </div>

                        <div class="advertisement-value">
                            BN-A
                        </div>

                    </div>


                    <div class="advertisement-item">

                        <div class="advertisement-label">
                            Duration
                        </div>

                        <div class="advertisement-value">
                            1 Month
                        </div>

                    </div>


                    <div class="advertisement-item">

                        <div class="advertisement-label">
                            Start Date
                        </div>

                        <div class="advertisement-value">
                            27-11-2024
                        </div>

                    </div>


                    <div class="advertisement-item">

                        <div class="advertisement-label">
                            End Date
                        </div>

                        <div class="advertisement-value">
                            27-12-2024
                        </div>

                    </div>


                </div>

            </div>


            <!-- =================================================
                 PAYMENT DETAILS
            ================================================== -->

            <div class="receipt-section">

                <div class="receipt-section-title">

                    Payment Details

                </div>


                <table class="receipt-payment-table">

                    <thead>

                        <tr>

                            <th>
                                Particulars
                            </th>

                            <th>
                                Amount
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <tr>

                            <td>
                                Actual Amount
                            </td>

                            <td>
                                ₹ 1,200.00
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Discount
                            </td>

                            <td>
                                ₹ 0.00
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Taxes
                            </td>

                            <td>
                                ₹ 70.00
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Offered Amount
                            </td>

                            <td>
                                ₹ 1,270.00
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Paid Amount / Advance
                            </td>

                            <td>
                                ₹ 500.00
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Balance Amount
                            </td>

                            <td>
                                ₹ 270.00
                            </td>

                        </tr>


                        <tr>

                            <td>
                                Next Installment Date
                            </td>

                            <td>
                                07-12-2024
                            </td>

                        </tr>


                        <tr class="total-row">

                            <td>
                                Total Paid
                            </td>

                            <td>
                                ₹ 500.00
                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 NOTE
            ================================================== -->

            <div class="receipt-note">

                <div class="receipt-note-title">
                    Note
                </div>

                <ul>

                    <li>
                        Amount paid is non-refundable.
                    </li>

                    <li>
                        This is an auto-generated payment receipt.
                    </li>

                    <li>
                        Signature is not required for this receipt.
                    </li>

                </ul>

            </div>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <div class="receipt-footer">

                <div class="receipt-footer-text">

                    Powered by
                    <strong>1Trainee</strong>

                </div>


                <div class="receipt-status">

                    <i class="fas fa-check-circle"></i>

                    PAYMENT RECEIVED

                </div>

            </div>


        </div>


        <!-- =====================================================
             ACTION BUTTONS
        ====================================================== -->

        <div class="receipt-actions">


            <!-- BACK -->

            <a asp-controller="SuperAdminAdvertisement"
               asp-action="AdvertisementList"
               class="receipt-action-btn back"
               title="Back">

                <i class="fas fa-arrow-left"></i>

            </a>


            <!-- HOME -->

            <a asp-controller="SuperAdmin"
               asp-action="Index"
               class="receipt-action-btn"
               title="Home">

                <i class="fas fa-home"></i>

            </a>


            <!-- PRINT -->

            <button type="button"
                    class="receipt-action-btn"
                    onclick="window.print();"
                    title="Print">

                <i class="fas fa-print"></i>

            </button>


            <!-- DOWNLOAD -->

            <button type="button"
                    class="receipt-action-btn"
                    onclick="downloadReceipt();"
                    title="Download Receipt">

                <i class="fas fa-download"></i>

            </button>


        </div>


    </div>

</div>


<script>

    function downloadReceipt() {

        window.print();

    }

</script>