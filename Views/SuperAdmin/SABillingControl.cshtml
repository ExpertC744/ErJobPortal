@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Billing Controller";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SABillingControl.css" asp-append-version="true" />

<div class="container-fluid billing-page">

    <!-- Page Header -->
    <div class="billing-page-header">
        <div>
            <h1>
               
                Billing Controller
            </h1>
              <p>ItNetworkZ</p>
           
        </div>
    </div>


  


    <!-- Billing Options -->
    <div class="billing-options">

        <!-- Add Bank Details -->
        <a asp-controller="SuperAdmin"
           asp-action="SAAddBankDetails"
           class="billing-option-card">

            <div class="billing-option-icon">
                <i class="fas fa-university"></i>
            </div>

            <div class="billing-option-content">
                <h3>Add Bank Details</h3>
                <p>Add and maintain bank account information.</p>
            </div>

            <div class="billing-option-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>

        </a>


        <!-- View Bank Details -->
        <a asp-controller="SuperAdmin"
           asp-action="SAViewBankDetails"
           class="billing-option-card">

            <div class="billing-option-icon">
                <i class="fas fa-landmark"></i>
            </div>

            <div class="billing-option-content">
                <h3>View Bank Details</h3>
                <p>View the registered bank account details.</p>
            </div>

            <div class="billing-option-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>

        </a>


        <!-- View Taxes Details -->
        <a asp-controller="SuperAdmin"
           asp-action="SAViewTaxesDetails"
           class="billing-option-card">

            <div class="billing-option-icon">
                <i class="fas fa-percent"></i>
            </div>

            <div class="billing-option-content">
                <h3>View Taxes Details</h3>
                <p>View applicable tax and billing information.</p>
            </div>

            <div class="billing-option-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>

        </a>


        <!-- View Plan -->
        <a asp-controller="SuperAdmin"
           asp-action="SAViewPlan"
           class="billing-option-card">

            <div class="billing-option-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div class="billing-option-content">
                <h3>View Plan</h3>
                <p>View the current billing and subscription plan.</p>
            </div>

            <div class="billing-option-arrow">
                <i class="fas fa-chevron-right"></i>
            </div>

        </a>

    </div>

</div>

