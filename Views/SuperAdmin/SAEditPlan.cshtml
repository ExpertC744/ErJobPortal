@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Plans";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid plan-edit-page">

    <!-- Page Header -->
    <div class="page-heading">
        <h1>Edit Plans</h1>
        <p>ItNetworkZ</p>
    </div>

    <!-- Edit Plan Card -->
    <div class="plan-card">

        <!-- Card Header -->
       @*  <div class="plan-card-header">
            <div class="header-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <h2>Edit Plan Details</h2>
                <p>Update plan information</p>
            </div>
        </div> *@

        <form asp-controller="Billing"
              asp-action="EditPlan"
              method="post">

            <input type="hidden" name="id" value="1" />

            <div class="plan-form-grid">

                <!-- Sr. No -->
                <div class="form-group">
                    <label>Sr. No</label>

                    <div class="input-wrapper">
                        <i class="fas fa-list-ol"></i>

                        <input type="text"
                               name="SrNo"
                               class="form-control"
                               value="1"
                               readonly />
                    </div>
                </div>

                <!-- Duration -->
                <div class="form-group">
                    <label>Duration</label>

                    <div class="input-wrapper">
                        <i class="fas fa-calendar-alt"></i>

                        <input type="text"
                               name="Duration"
                               class="form-control"
                               placeholder="Enter Duration" />
                    </div>
                </div>

                <!-- Rectangular Price -->
                <div class="form-group">
                    <label>
                        Rectangular Price <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-rupee-sign"></i>

                        <input type="text"
                               name="RectangularPrice"
                               class="form-control"
                               placeholder="Enter Rectangular Price"
                               required />
                    </div>
                </div>

                <!-- Square Price -->
                <div class="form-group">
                    <label>
                        Square Price <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-rupee-sign"></i>

                        <input type="text"
                               name="SquarePrice"
                               class="form-control"
                               placeholder="Enter Square Price"
                               required />
                    </div>
                </div>

                <!-- Discount -->
                <div class="form-group">
                    <label>Discount %</label>

                    <div class="input-wrapper">
                        <i class="fas fa-percent"></i>

                        <input type="text"
                               name="Discount"
                               class="form-control"
                               placeholder="Enter Discount %" />
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="form-footer">

                <a asp-controller="Billing"
                   asp-action="ViewPlan"
                   class="btn-close-form">
                    <i class="fas fa-times"></i>
                    Close
                </a>

                <button type="submit"
                        class="btn-save-form">
                    <i class="fas fa-save"></i>
                    Save
                </button>

            </div>

        </form>

    </div>
</div>

<style>

    .plan-edit-page {
        padding-bottom: 40px;
    }

    .page-heading {
        margin-bottom: 25px;
    }

    .page-heading h1 {
        margin: 0 0 6px;
        color: #0f172a;
        font-size: 28px;
        font-weight: 700;
    }

    .page-heading p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }

    .plan-card {
        max-width: 1050px;
        margin: 0 auto;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.07);
    }

    .plan-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 22px 28px;
        background: linear-gradient(135deg, #f0fdfa, #ffffff);
        border-bottom: 1px solid #e2e8f0;
    }

    .header-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: #ccfbf1;
        color: #0d9488;
        font-size: 20px;
    }

    .plan-card-header h2 {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 19px;
        font-weight: 700;
    }

    .plan-card-header p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }

    .plan-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 22px;
        padding: 30px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 14px;
        font-weight: 600;
    }

    .form-group label span {
        color: #dc2626;
    }

    .input-wrapper {
        position: relative;
    }

    .input-wrapper > i {
        position: absolute;
        top: 50%;
        left: 15px;
        z-index: 2;
        transform: translateY(-50%);
        color: #0d9488;
        font-size: 14px;
    }

    .form-control {
        width: 100%;
        height: 45px;
        box-sizing: border-box;
        padding: 0 15px 0 43px;
        color: #0f172a;
        background: #ffffff;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        outline: none;
        font-size: 14px;
        transition: 0.2s ease;
    }

    .form-control:focus {
        border-color: #0d9488;
        box-shadow: 0 0 0 3px rgba(13, 148, 136, 0.10);
    }

    .form-control[readonly] {
        background: #f8fafc;
        color: #64748b;
        cursor: not-allowed;
    }

    .form-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding: 20px 30px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }

    .btn-close-form,
    .btn-save-form {
        min-width: 115px;
        height: 42px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 9px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

    .btn-close-form {
        color: #475569;
        background: #ffffff;
        border: 1px solid #cbd5e1;
    }

    .btn-close-form:hover {
        color: #334155;
        background: #f1f5f9;
    }

    .btn-save-form {
        color: #ffffff;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        border: none;
        box-shadow: 0 4px 12px rgba(13, 148, 136, 0.20);
    }

    .btn-save-form:hover {
        background: linear-gradient(135deg, #0f766e, #115e59);
    }

    @@media (max-width: 768px) {

        .plan-form-grid {
            grid-template-columns: 1fr;
            padding: 22px;
        }

        .plan-card-header {
            padding: 18px 22px;
        }

        .form-footer {
            padding: 18px 22px;
        }
    }

    @@media (max-width: 480px) {

        .page-heading h1 {
            font-size: 23px;
        }

        .plan-form-grid {
            padding: 18px;
            gap: 18px;
        }

        .form-footer {
            flex-direction: column-reverse;
        }

        .btn-close-form,
        .btn-save-form {
            width: 100%;
        }
    }

</style>