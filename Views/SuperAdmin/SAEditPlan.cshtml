@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Plans";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAEditPlan.css" asp-append-version="true" />
<div class="container-fluid plan-edit-page">

    <!-- Page Header -->
    <div class="page-heading">
        <h1>Edit Plans</h1>
        <p>ItNetworkZ</p>
    </div>

    <!-- Edit Plan Card -->
    <div class="plan-card">

        <!-- Card Header -->
       @*  <div class="plan-card-header">
            <div class="header-icon">
                <i class="fas fa-layer-group"></i>
            </div>

            <div>
                <h2>Edit Plan Details</h2>
                <p>Update plan information</p>
            </div>
        </div> *@

        <form asp-controller="Billing"
              asp-action="EditPlan"
              method="post">

            <input type="hidden" name="id" value="1" />

            <div class="plan-form-grid">

                <!-- Sr. No -->
                <div class="form-group">
                    <label>Sr. No</label>

                    <div class="input-wrapper">
                        <i class="fas fa-list-ol"></i>

                        <input type="text"
                               name="SrNo"
                               class="form-control"
                               value="1"
                               readonly />
                    </div>
                </div>

                <!-- Duration -->
                <div class="form-group">
                    <label>Duration</label>

                    <div class="input-wrapper">
                        <i class="fas fa-calendar-alt"></i>

                        <input type="text"
                               name="Duration"
                               class="form-control"
                               placeholder="Enter Duration" />
                    </div>
                </div>

                <!-- Rectangular Price -->
                <div class="form-group">
                    <label>
                        Rectangular Price <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-rupee-sign"></i>

                        <input type="text"
                               name="RectangularPrice"
                               class="form-control"
                               placeholder="Enter Rectangular Price"
                               required />
                    </div>
                </div>

                <!-- Square Price -->
                <div class="form-group">
                    <label>
                        Square Price <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-rupee-sign"></i>

                        <input type="text"
                               name="SquarePrice"
                               class="form-control"
                               placeholder="Enter Square Price"
                               required />
                    </div>
                </div>

                <!-- Discount -->
                <div class="form-group">
                    <label>Discount %</label>

                    <div class="input-wrapper">
                        <i class="fas fa-percent"></i>

                        <input type="text"
                               name="Discount"
                               class="form-control"
                               placeholder="Enter Discount %" />
                    </div>
                </div>

            </div>

            <!-- Footer -->
            <div class="form-footer">

                <a asp-controller="Billing"
                   asp-action="ViewPlan"
                   class="btn-close-form">
                    <i class="fas fa-times"></i>
                    Close
                </a>

                <button type="submit"
                        class="btn-save-form">
                    <i class="fas fa-save"></i>
                    Save
                </button>

            </div>

        </form>

    </div>
</div>

