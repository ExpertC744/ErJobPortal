@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Taxes";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}
@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAEditTaxesDetails.css" asp-append-version="true" />

<div class="container-fluid taxes-edit-page">

    

    <!-- Form Card -->
    <div class="tax-card">

        <div class="tax-card-header">
            <div class="header-icon">
                <i class="fas fa-percent"></i>
            </div>

            <div>
                <h2>Edit Taxes Details</h2>
                <p>Update tax information</p>
            </div>
        </div>

        <form asp-controller="Billing"
              asp-action="EditTaxesDetails"
              method="post">

            <input type="hidden" name="id" value="1" />

            <div class="tax-form-grid">

                <!-- Taxes 1 -->
                <div class="form-group">
                    <label>
                        Taxes 1 <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-tag"></i>
                        <input type="text"
                               name="Taxes1"
                               class="form-control"
                               placeholder="Enter Taxes 1"
                               value="GST"
                               required />
                    </div>
                </div>

                <!-- Rate 1 -->
                <div class="form-group">
                    <label>
                        Rate 1 <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-percent"></i>
                        <input type="text"
                               name="Rate1"
                               class="form-control"
                               placeholder="Enter Rate 1"
                               value="5"
                               required />
                    </div>
                </div>

                <!-- Taxes 2 -->
                <div class="form-group">
                    <label>
                        Taxes 2 <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-tag"></i>
                        <input type="text"
                               name="Taxes2"
                               class="form-control"
                               placeholder="Enter Taxes 2"
                               value="CGST"
                               required />
                    </div>
                </div>

                <!-- Rate 2 -->
                <div class="form-group">
                    <label>
                        Rate 2 <span>*</span>
                    </label>

                    <div class="input-wrapper">
                        <i class="fas fa-percent"></i>
                        <input type="text"
                               name="Rate2"
                               class="form-control"
                               placeholder="Enter Rate 2"
                               value="2.5"
                               required />
                    </div>
                </div>

                <!-- Taxes 3 -->
                <div class="form-group">
                    <label>Taxes 3</label>

                    <div class="input-wrapper">
                        <i class="fas fa-tag"></i>
                        <input type="text"
                               name="Taxes3"
                               class="form-control"
                               placeholder="Enter Taxes 3"
                               value="SGST" />
                    </div>
                </div>

                <!-- Rate 3 -->
                <div class="form-group">
                    <label>Rate 3</label>

                    <div class="input-wrapper">
                        <i class="fas fa-percent"></i>
                        <input type="text"
                               name="Rate3"
                               class="form-control"
                               placeholder="Enter Rate 3"
                               value="2.5" />
                    </div>
                </div>

                <!-- Taxes 4 -->
                <div class="form-group">
                    <label>Taxes 4</label>

                    <div class="input-wrapper">
                        <i class="fas fa-tag"></i>
                        <input type="text"
                               name="Taxes4"
                               class="form-control"
                               placeholder="Enter Taxes 4" />
                    </div>
                </div>

                <!-- Rate 4 -->
                <div class="form-group">
                    <label>Rate 4</label>

                    <div class="input-wrapper">
                        <i class="fas fa-percent"></i>
                        <input type="text"
                               name="Rate4"
                               class="form-control"
                               placeholder="Enter Rate 4"
                               value="0" />
                    </div>
                </div>

                <!-- Total Tax -->
                <div class="form-group total-tax-field">
                    <label>Total Tax</label>

                    <div class="input-wrapper">
                        <i class="fas fa-calculator"></i>
                        <input type="text"
                               name="TotalTax"
                               class="form-control"
                               placeholder="Enter Total Tax"
                               value="10" />
                    </div>
                </div>

            </div>

            <!-- Footer Buttons -->
            <div class="form-footer">

                <a asp-controller="Billing"
                   asp-action="ViewTaxesDetails"
                   class="btn-close-form">
                    <i class="fas fa-times"></i>
                    Close
                </a>

                <button type="submit"
                        class="btn-save-form">
                    <i class="fas fa-save"></i>
                    Save
                </button>

            </div>

        </form>

    </div>
</div>
