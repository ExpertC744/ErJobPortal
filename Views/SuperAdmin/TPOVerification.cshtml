@model List<ErJobPortal.Models.TPORegistration>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "TPO Verification";
    ViewData["Panel"] = "SuperAdmin";
}

<link rel="stylesheet"
      href="~/css/TPOVerification.css"
      asp-append-version="true" />

<div class="container-fluid py-4 tv-page">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show tv-alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show tv-alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4 tv-page-header">
        <div>
            <h2 class="tv-page-title">TPO Verification</h2>
            <p class="text-muted mb-0 tv-page-subtitle">
                Review pending TPO and Sub-TPO registrations.
            </p>
        </div>

        <span class="badge bg-warning text-dark tv-pending-badge">
            Pending: @(ViewBag.PendingCount ?? 0)
        </span>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info tv-empty-alert">
            <i class="bi bi-info-circle"></i>
            No pending TPO or Sub-TPO registrations found.
        </div>
    }
    else
    {
        <div class="tv-table-card">
            <div class="tv-table-heading">
                <div>
                    <h5>Registration Requests</h5>
                    <p>Review applicant details, documents, and take action.</p>
                </div>

                <span class="tv-record-count">
                    @Model.Count Records
                </span>
            </div>

            <div class="table-responsive tv-table-responsive">
                <table class="table table-bordered table-hover align-middle tv-table">
                    <thead>
                        <tr>
                            <th class="tv-id-column">ID</th>
                            <th class="tv-type-column">Type</th>
                            <th class="tv-name-column">Name</th>
                            <th class="tv-college-column">College</th>
                            <th class="tv-email-column">Email</th>
                            <th class="tv-mobile-column">Mobile</th>
                            <th class="tv-date-column">Registered</th>
                            <th class="tv-documents-column">Documents</th>
                            <th class="tv-actions-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var tpo in Model)
                        {
                            <tr>
                                <td class="tv-id-column">
                                    <span class="tv-id-badge">@tpo.TPOID</span>
                                </td>

                                <td class="tv-type-column">
                                    @if (tpo.SubTpoBit == true)
                                    {
                                        <span class="badge bg-info tv-type-badge">Sub-TPO</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary tv-type-badge">Main TPO</span>
                                    }
                                </td>

                                <td class="tv-name-column">
                                    <span class="tv-name-text">@tpo.FullName</span>
                                </td>

                                <td class="tv-college-column">
                                    <span class="tv-college-name">@tpo.CollegeName</span>
                                    <small class="text-muted tv-college-code">
                                        Code: @tpo.CollegeCode
                                    </small>
                                </td>

                                <td class="tv-email-column">
                                    <span class="tv-break-text">@tpo.CollegeMailID</span>
                                </td>

                                <td class="tv-mobile-column">
                                    <span class="tv-break-text">@tpo.MobileNo</span>
                                </td>

                                <td class="tv-date-column">
                                    <span class="tv-date-text">
                                        @(tpo.CreatedDate?.ToString("dd-MMM-yyyy") ?? "-")
                                    </span>
                                </td>

                                <td class="tv-documents-column">
                                    <div class="tv-documents-list">
                                        @if (!string.IsNullOrWhiteSpace(tpo.SupportingDocument1))
                                        {
                                            <a class="tv-document-link"
                                               href="@Url.Content(tpo.SupportingDocument1)"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <i class="bi bi-file-earmark-text"></i>
                                                Document 1
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(tpo.SupportingDocument2))
                                        {
                                            <a class="tv-document-link"
                                               href="@Url.Content(tpo.SupportingDocument2)"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <i class="bi bi-file-earmark-text"></i>
                                                Document 2
                                            </a>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(tpo.ProfilePhoto))
                                        {
                                            <a class="tv-document-link tv-photo-link"
                                               href="@Url.Content(tpo.ProfilePhoto)"
                                               target="_blank"
                                               rel="noopener noreferrer">
                                                <i class="bi bi-image"></i>
                                                Photo
                                            </a>
                                        }
                                    </div>
                                </td>

                                <td class="tv-actions-column tv-actions-cell" style="min-width: 230px;">
                                    <div class="tv-actions-panel">

                                        <form asp-controller="SuperAdmin"
                                              asp-action="ApproveTPO"
                                              asp-route-id="1"
                                              method="post"
                                              class="tv-approve-form">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@tpo.TPOID" />

                                            <button type="submit"
                                                    class="btn btn-success btn-sm tv-action-btn tv-approve-btn"
                                                    onclick="return confirm('Approve this registration?');">
                                                <i class="bi bi-check-circle"></i>
                                                Approve
                                            </button>
                                        </form>

                                        <div class="tv-reject-panel">
                                            <div class="tv-reject-heading">
                                                <i class="bi bi-x-circle"></i>
                                                Reject Registration
                                            </div>

                                            <form asp-controller="SuperAdmin"
                                                  asp-action="RejectTPO"
                                                  asp-route-id="1"
                                                  method="post"
                                                  class="tv-reject-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@tpo.TPOID" />

                                                <input type="text"
                                                       name="rejectionReason"
                                                       class="form-control form-control-sm tv-rejection-input"
                                                       maxlength="1000"
                                                       placeholder="Reason for rejection"
                                                       required />

                                                <button type="submit"
                                                        class="btn btn-danger btn-sm tv-action-btn tv-reject-btn"
                                                        onclick="return confirm('Reject this registration?');">
                                                    <i class="bi bi-x-lg"></i>
                                                    Reject
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="tv-table-footer">
                <i class="bi bi-arrows"></i>
                Scroll horizontally to view all registration details.
            </div>
        </div>
    }
</div>
