@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Selected Trainees";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid selected-trainees-page">

   

    <!-- Selected Trainees Table -->
    <div class="master-table-container">
 
        <div class="table-responsive">
             <!-- Page Header -->
    <div class="mb-4">
        <h1 class="mb-2">Selected Trainees</h1>
        <p class="mb-0 text-muted">ItNetworkZ</p>
    </div>
            <table id="selectedTraineesTable"
                   class="master-data-table">

                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>Post Date</th>
                        <th>Position</th>
                        <th>Name</th>
                        <th>Email ID</th>
                        <th>Skills</th>
                        <th>View Resume</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>

                        <td class="master-id">1</td>

                        <td>25-09-2026</td>

                        <td>.NET Trainee</td>

                        <td>Khushi Fale</td>

                        <td>khushi@example.com</td>

                        <td>
                            HTML, CSS, JavaScript, .NET
                        </td>

                        <td class="resume-column">

                         
           <a asp-controller="Candidate"
   asp-action="Resume"
   asp-route-id="1"
   class="resume-view-btn"
   title="View Resume">
    <i class="fas fa-eye"></i>
</a>
       

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>

        <div id="selectedTraineesPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>