@model List<ErJobPortal.Models.SAFinalSelectionViewModel>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Selected Trainees";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid selected-trainees-page">

    <!-- Selected Trainees Table -->
    <div class="master-table-container">

        <div class="table-responsive">

            <!-- Page Header -->
            <div class="mb-4">
                <h1 class="mb-2">Selected Trainees</h1>
                <p class="mb-0 text-muted">ItNetworkZ</p>
            </div>

            <table id="selectedTraineesTable"
                   class="master-data-table">

                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>Post Date</th>
                        <th>Position</th>
                        <th>Name</th>
                        <th>Email ID</th>
                        <th>Skills</th>
                        <th>View Resume</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        int srNo = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <td class="master-id">
                                    @srNo
                                </td>

                                <td>
                                    @(item.PostDate.HasValue
                                                                ? item.PostDate.Value.ToString("dd-MM-yyyy")
                                                                : "-")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.PositionName)
                                                                ? "-"
                                                                : item.PositionName)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.CandidateName)
                                                                ? "-"
                                                                : item.CandidateName)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.EmailID)
                                                                ? "-"
                                                                : item.EmailID)
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Skills)
                                                                ? "-"
                                                                : item.Skills)
                                </td>

                                <td class="resume-column">

                                    @*shrirang 05/10/26*@
                                    <a asp-controller="Resume"
                                       asp-action="Resume"
                                       asp-route-id="1"
                                       class="resume-view-btn"
                                       title="View Resume"
                                       target="_blank">

                                        <i class="fas fa-eye"></i>

                                    </a>
                                    @*end*@

                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="text-center">
                                No selected trainees found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div id="selectedTraineesPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>