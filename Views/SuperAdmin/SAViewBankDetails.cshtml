                        </td>

                        <td>
                            Nagpur1
                        </td>

                        <td>
                            HDHDHD1231
                        </td>

                        <td>
                            12345678901
                        </td>

                        <td>
                            12345678901
                        </td>

                        <td>

                            <a asp-controller="SuperAdmin"
                               asp-action="SAEditBankDetails"
                               asp-route-id="1"
