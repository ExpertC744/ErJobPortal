@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Bank Details List";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4">
        <h1 class="mb-2">Bank Details List</h1>
        <p class="mb-0 text-muted">ItNetworkZ</p>
    </div>


    <!-- Master Table -->
    <div class="master-table-container">

     @*    <div class="master-table-title">
            <div>
                <h2>
                    <i class="fas fa-university me-2"></i>
                    Bank Details
                </h2>
            </div>
        </div>
 *@

