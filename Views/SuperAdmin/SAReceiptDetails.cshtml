@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Receipt Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="mb-4 d-flex justify-content-between align-items-start">

        <div>
            <h1 class="mb-2">Receipt Details</h1>
            <p class="mb-0 text-muted">ItNetworkZ</p>
        </div>

        <a asp-controller="SuperAdminAdvertisement"
           asp-action="PaymentDetails"
           class="btn btn-primary"
           title="Back">
            <i class="fas fa-arrow-left"></i>
        </a>

    </div>


    <!-- Master Table -->
