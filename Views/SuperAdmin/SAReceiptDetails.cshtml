        <div class="table-responsive">

            <table id="receiptDetailsTable"
                   class="master-data-table">

                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>Client Name</th>
                        <th>Company Name</th>
                        <th>Address</th>
                        <th>Contact No</th>
                        <th>DOB</th>
                        <th>Reference</th>
                        <th>Banner Location</th>
                        <th>Banner Duration</th>
                        <th>Adv Start Date</th>
                        <th>Adv End Date</th>
                        <th>Total No. Of Days</th>
                        <th>Banner</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    <tr>

                        <td class="master-id">
                            1
                        </td>

                        <td>
                            Tyuqw
                        </td>

                        <td>
                            IT-NetworkZ
                        </td>

                        <td>
                            Laxmi
                        </td>

                        <td>
                            76786869
                        </td>

                        <td>
                            14-09-2008
                        </td>

                        <td>
                            News Paper
                        </td>

                        <td>
                            No Data
                        </td>

                        <td>
                            1 Month
                        </td>

                        <td>
                            27-11-2024
                        </td>

                        <td>
                            27-12-2024
                        </td>

                        <td>
                            30
                        </td>

                        <td>
                            <img src=""
                                 alt="Product Image"
                                 style="width:70px;height:35px;object-fit:contain;" />
                        </td>

                        <td>

                            <a asp-controller="SuperAdmin"
                               asp-action="SAViewAdvertisement"
                               asp-route-id="1"
                               class="resume-view-btn"
                               title="View Advertisement">

                                <i class="fas fa-eye"></i>

                            </a>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


        <div id="receiptDetailsPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>