@model ErJobPortal.Models.OrganizationProfileDetailsVM

@{
Layout = "~/Views/Shared/_DashboardLayout.cshtml";

   
ViewData["Title"] = "Organization Profile Details";   
ViewData["Panel"] = "SuperAdmin";
ViewData["UserName"] = "Super Admin";

var org = Model.Organization;
      

}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<!-- =====================================================
     PAGE
     ===================================================== -->

<div class="organization-profile-page">

   
<!-- =================================================
     MAIN CARD
     ================================================= -->

<div class="organization-profile-card">


    <!-- =================================================
         HEADER
         ================================================= -->

    <div class="organization-profile-header">

        <div class="header-content">

            <div class="header-badge">

                <i class="fa-solid fa-building"></i>

                ORGANIZATION PROFILE

            </div>


            <h1 class="organization-title">

                @(string.IsNullOrWhiteSpace(org.OrganizationName)
                    ? "Organization Name Not Available"
                    : org.OrganizationName)

            </h1>


            <div class="organization-subtitle">

                Complete organization profile information

            </div>


            <div class="organization-id">

                <i class="fa-solid fa-id-card"></i>

                Organization ID:
                @org.nOrgID

            </div>

        </div>

    </div>


    <!-- =================================================
         PROFILE IMAGE
         ================================================= -->

    <div class="profile-image-area">

        <div class="company-logo">

            @if (!string.IsNullOrWhiteSpace(org.OrganizationLogo))
            {
                <img src="@org.OrganizationLogo"
                     alt="@org.OrganizationName" />
            }
            else
            {
                <img src="@Url.Content("~/images/HUNTCV.png")"
                     alt="HUNTCV" />
            }

        </div>

    </div>


    <!-- =================================================
         CONTENT
         ================================================= -->

    <div class="organization-profile-content">


        <!-- =================================================
             BASIC INFORMATION
             ================================================= -->

        <div class="section-title">

            <span class="section-icon">

                <i class="fa-solid fa-building"></i>

            </span>

            <span>
                Basic Information
            </span>

        </div>


        <div class="profile-details-grid">


            <!-- ORGANIZATION NAME -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-building"></i>

                </div>

                <div class="profile-detail-label">
                    Organization Name
                </div>

                <div class="profile-detail-value">

                    @ShowValue(org.OrganizationName)

                </div>

            </div>


            <!-- EMAIL -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-envelope"></i>

                </div>

                <div class="profile-detail-label">
                    Verification Email
                </div>

                <div class="profile-detail-value">

                    @ShowValue(org.VerificationEmail)

                </div>

            </div>


            <!-- PROFILE CREATION DATE -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div class="profile-detail-label">
                    Profile Creation Date
                </div>

                <div class="profile-detail-value">

                    @(org.ProfileCreationDate.HasValue
                        ? org.ProfileCreationDate.Value.ToString("dd-MM-yyyy")
                        : "N/A")

                </div>

            </div>


            <!-- DATE OF BIRTH -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-cake-candles"></i>

                </div>

                <div class="profile-detail-label">
                    Date of Birth
                </div>

                <div class="profile-detail-value">

                    @(org.DOB.HasValue
                        ? org.DOB.Value.ToString("dd-MM-yyyy")
                        : "N/A")

                </div>

            </div>


            <!-- ESTABLISHMENT YEAR -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-calendar-check"></i>

                </div>

                <div class="profile-detail-label">
                    Establishment Year
                </div>

                <div class="profile-detail-value">

                    @(org.EstablishmentYear.HasValue
                        ? org.EstablishmentYear.Value.ToString()
                        : "N/A")

                </div>

            </div>


            <!-- STATUS -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-toggle-on"></i>

                </div>

                <div class="profile-detail-label">
                    Organization Status
                </div>

                <div class="profile-detail-value">

                    @if (org.nSABit)
                    {
                        <span class="status-active">

                            <span class="status-dot"></span>

                            Active

                        </span>
                    }
                    else
                    {
                        <span class="status-inactive">

                            <span class="status-dot"></span>

                            Inactive

                        </span>
                    }

                </div>

            </div>


        </div>


        <!-- =================================================
             BUSINESS INFORMATION
             ================================================= -->

        <div class="section-title">

            <span class="section-icon">

                <i class="fa-solid fa-chart-column"></i>

            </span>

            <span>
                Business Information
            </span>

        </div>


        <div class="profile-details-grid">


            <!-- GST -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-file-invoice"></i>

                </div>

                <div class="profile-detail-label">
                    GST Number
                </div>

                <div class="profile-detail-value">

                    @ShowValue(org.GSTNo)

                </div>

            </div>


            <!-- CIN -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-file-lines"></i>

                </div>

                <div class="profile-detail-label">
                    CIN Number
                </div>

                <div class="profile-detail-value">

                    @ShowValue(org.CINNo)

                </div>

            </div>


            <!-- EMPLOYEE STRENGTH -->

            <div class="profile-detail-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-users"></i>

                </div>

                <div class="profile-detail-label">
                    Current Employee Strength
                </div>

                <div class="profile-detail-value">

                    @ShowValue(org.CurrentEmployeeStrength)

                </div>

            </div>


        </div>


        <!-- =================================================
             ADDRESS
             ================================================= -->

        <div class="section-title">

            <span class="section-icon">

                <i class="fa-solid fa-location-dot"></i>

            </span>

            <span>
                Organization Address
            </span>

        </div>


        <div class="profile-details-grid">


            <div class="profile-detail-item address-item">

                <div class="detail-icon">

                    <i class="fa-solid fa-map-location-dot"></i>

                </div>

                <div class="profile-detail-label">
                    Complete Address
                </div>

                <div class="profile-detail-value address-value">

                    @ShowValue(org.OrganizationAddress)

                </div>

            </div>


        </div>


    </div>


    <!-- =================================================
         FOOTER
         ================================================= -->

    <div class="organization-profile-footer">


        <!-- BACK -->

        <a asp-controller="SuperAdmin"
           asp-action="SAOrgProfileList"
           class="nav-btn back-btn">

            <i class="fa-solid fa-arrow-left"></i>

            Back to List

        </a>


        <!-- CENTER -->

        <div class="navigation-center">

            Organization
            @Model.CurrentIndex
            /
            @Model.TotalRecords

        </div>


        <!-- PREVIOUS / NEXT -->

        <div class="navigation-buttons">


            @if (Model.HasPrevious)
            {
                <a asp-controller="SuperAdminOrganization"
                   asp-action="OrganizationProfileDetails"
                   asp-route-id="@Model.PreviousId"
                   class="nav-btn prev-btn">

                    <i class="fa-solid fa-chevron-left"></i>

                    Previous

                </a>
            }
            else
            {
                <span class="nav-btn prev-btn disabled">

                    <i class="fa-solid fa-chevron-left"></i>

                    Previous

                </span>
            }


            @if (Model.HasNext)
            {
                <a asp-controller="SuperAdminOrganization"
                   asp-action="OrganizationProfileDetails"
                   asp-route-id="@Model.NextId"
                   class="nav-btn next-btn">

                    Next

                    <i class="fa-solid fa-chevron-right"></i>

                </a>
            }
            else
            {
                <span class="nav-btn next-btn disabled">

                    Next

                    <i class="fa-solid fa-chevron-right"></i>

                </span>
            }

        </div>

    </div>


</div>


<!-- =====================================================
     RIGHT BUTTONS
     ===================================================== -->

<div class="right-buttons">


    <!-- HOME -->

    <a asp-controller="SuperAdmin"
       asp-action="Dashboard"
       class="right-button"
       title="Super Admin Dashboard">

        <i class="fa-solid fa-house"></i>

    </a>


    <!-- PRINT -->

    <a href="javascript:window.print();"
       class="right-button"
       title="Print">

        <i class="fa-solid fa-print"></i>

    </a>


    <!-- DOWNLOAD -->

    <a href="javascript:window.print();"
       class="right-button"
       title="Download">

        <i class="fa-solid fa-download"></i>

    </a>


</div>
   

</div>

@functions {

   
public string ShowValue(string? value)
{
    if (string.IsNullOrWhiteSpace(value))
    {
        return "N/A";
    }

    return value;
}
   

}
