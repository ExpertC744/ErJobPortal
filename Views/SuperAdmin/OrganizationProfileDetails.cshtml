@model ErJobPortal.Models.OrganizationProfileDetailsVM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Profile Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";

    var org = Model.Organization;
}

<style>

    .org-details-wrapper {
        padding: 25px 20px 40px;
    }

    /* =========================================
       HEADER
    ========================================= */

    .org-details-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .org-details-title h2 {
        margin: 0;
        font-size: 27px;
        font-weight: 700;
        color: #1f2937;
    }

    .org-details-title p {
        margin: 6px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .record-counter {
        background: #1e7b67;
        color: white;
        padding: 9px 17px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    /* =========================================
       MAIN CARD
    ========================================= */

    .organization-details-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 8px 30px rgba(0,0,0,0.08);
        overflow: hidden;
        border: 1px solid #edf0f2;
    }

    /* =========================================
       PROFILE HEADER
    ========================================= */

    .organization-profile-header {
        background: linear-gradient(
            135deg,
            #1e7b67,
            #155e52
        );

        padding: 30px 35px;

        display: flex;
        align-items: center;
        gap: 25px;

        color: white;
    }

    .organization-logo-box {
        width: 105px;
        height: 105px;

        background: white;
        border-radius: 16px;

        display: flex;
        align-items: center;
        justify-content: center;

        overflow: hidden;

        box-shadow: 0 5px 20px rgba(0,0,0,0.18);

        flex-shrink: 0;
    }

    .organization-logo-box img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 10px;
    }

    .no-logo {
        color: #9ca3af;
        font-size: 13px;
        text-align: center;
    }

    .organization-heading {
        flex: 1;
    }

    .organization-heading h1 {
        margin: 0 0 7px;
        font-size: 28px;
        font-weight: 700;
    }

    .organization-heading p {
        margin: 0;
        font-size: 14px;
        opacity: 0.9;
    }

    .organization-status {
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.3);
        white-space: nowrap;
    }

    /* =========================================
       FORM SECTION
    ========================================= */

    .details-section {
        padding: 30px 35px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 10px;

        margin-bottom: 22px;
        padding-bottom: 12px;

        border-bottom: 1px solid #e5e7eb;
    }

    .section-heading h4 {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
    }

    .section-heading span {
        width: 7px;
        height: 25px;
        border-radius: 5px;
        background: #1e7b67;
    }

    /* =========================================
       FORM GROUP
    ========================================= */

    .detail-field {
        margin-bottom: 20px;
    }

    .detail-label {
        display: block;
        margin-bottom: 7px;

        font-size: 12px;
        font-weight: 700;
        color: #6b7280;

        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .detail-value {
        width: 100%;
        min-height: 44px;

        padding: 11px 14px;

        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 9px;

        color: #1f2937;
        font-size: 14px;

        display: flex;
        align-items: center;

        word-break: break-word;
    }

    .detail-value.address {
        min-height: 80px;
        align-items: flex-start;
        line-height: 1.6;
    }

    .empty-value {
        color: #9ca3af;
        font-style: italic;
    }

    /* =========================================
       NAVIGATION
    ========================================= */

    .navigation-footer {
        padding: 20px 35px;

        background: #f8fafc;
        border-top: 1px solid #e5e7eb;

        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .navigation-center {
        font-size: 13px;
        color: #6b7280;
        font-weight: 600;
    }

    .navigation-buttons {
        display: flex;
        gap: 10px;
    }

    .nav-btn {
        min-width: 115px;
        height: 42px;

        border: none;
        border-radius: 8px;

        font-size: 13px;
        font-weight: 600;

        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;

        text-decoration: none;

        transition: all 0.2s ease;
    }

    .prev-btn {
        background: #e5e7eb;
        color: #374151;
    }

    .prev-btn:hover {
        background: #d1d5db;
        color: #111827;
        transform: translateX(-2px);
    }

    .next-btn {
        background: #1e7b67;
        color: white;
    }

    .next-btn:hover {
        background: #155e52;
        color: white;
        transform: translateX(2px);
    }

    .back-btn {
        background: white;
        color: #374151;
        border: 1px solid #d1d5db;
    }

    .back-btn:hover {
        background: #f3f4f6;
        color: #111827;
    }

    .nav-btn.disabled {
        pointer-events: none;
        opacity: 0.45;
    }

    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 768px) {

        .org-details-wrapper {
            padding: 15px 10px 30px;
        }

        .org-details-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .organization-profile-header {
            flex-direction: column;
            text-align: center;
            padding: 25px 20px;
        }

        .organization-heading h1 {
            font-size: 22px;
        }

        .details-section {
            padding: 25px 20px;
        }

        .navigation-footer {
            flex-direction: column;
        }

        .navigation-center {
            order: -1;
        }

        .navigation-buttons {
            width: 100%;
        }

        .nav-btn {
            flex: 1;
        }
    }

</style>


<div class="container-fluid">

    <div class="org-details-wrapper">

        <!-- =========================================
             PAGE HEADER
        ========================================== -->

        <div class="org-details-header">

            <div class="org-details-title">

                <h2>
                    Organization Profile
                </h2>

                <p>
                    Complete organization profile information
                </p>

            </div>


            <div class="record-counter">

                Record
                @Model.CurrentIndex
                of
                @Model.TotalRecords

            </div>

        </div>


        <!-- =========================================
             MAIN CARD
        ========================================== -->

        <div class="organization-details-card">


            <!-- =====================================
                 PROFILE HEADER
            ====================================== -->

            <div class="organization-profile-header">


                <!-- LOGO -->

                <div class="organization-logo-box">

                    @if (!string.IsNullOrWhiteSpace(org.OrganizationLogo))
                    {
                        <img src="@org.OrganizationLogo"
                             alt="@org.OrganizationName" />
                    }
                    else
                    {
                        <span class="no-logo">
                            No Logo
                        </span>
                    }

                </div>


                <!-- ORGANIZATION NAME -->

                <div class="organization-heading">

                    <h1>
                        @(string.IsNullOrWhiteSpace(org.OrganizationName)
                            ? "Organization Name Not Available"
                            : org.OrganizationName)
                    </h1>

                    <p>
                        Organization ID:
                        @org.nOrgID
                    </p>

                </div>


                <!-- STATUS -->

                <div class="organization-status">

                    @(org.nSABit ? "Active" : "Inactive")

                </div>

            </div>


            <!-- =====================================
                 DETAILS
            ====================================== -->

            <div class="details-section">


                <!-- BASIC INFORMATION -->

                <div class="section-heading">

                    <span></span>

                    <h4>
                        Basic Information
                    </h4>

                </div>


                <div class="row">


                    <!-- ORGANIZATION NAME -->

                    <div class="col-lg-6 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                Organization Name
                            </label>

                            <div class="detail-value">

                                @ShowValue(org.OrganizationName)

                            </div>

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="col-lg-6 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                Verification Email
                            </label>

                            <div class="detail-value">

                                @ShowValue(org.VerificationEmail)

                            </div>

                        </div>

                    </div>


                    <!-- PROFILE DATE -->

                    <div class="col-lg-4 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                Profile Creation Date
                            </label>

                            <div class="detail-value">

                                @(org.ProfileCreationDate.HasValue
                                    ? org.ProfileCreationDate.Value.ToString("dd-MM-yyyy")
                                    : "N/A")

                            </div>

                        </div>

                    </div>


                    <!-- DOB -->

                    <div class="col-lg-4 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                Date of Birth
                            </label>

                            <div class="detail-value">

                                @(org.DOB.HasValue
                                    ? org.DOB.Value.ToString("dd-MM-yyyy")
                                    : "N/A")

                            </div>

                        </div>

                    </div>


                    <!-- ESTABLISHMENT -->

                    <div class="col-lg-4 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                Establishment Year
                            </label>

                            <div class="detail-value">

                                @(org.EstablishmentYear.HasValue
                                    ? org.EstablishmentYear.Value.ToString()
                                    : "N/A")

                            </div>

                        </div>

                    </div>


                </div>


                <!-- =================================
                     BUSINESS INFORMATION
                ================================== -->

                <div class="section-heading mt-3">

                    <span></span>

                    <h4>
                        Business Information
                    </h4>

                </div>


                <div class="row">


                    <!-- GST -->

                    <div class="col-lg-4 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                GST Number
                            </label>

                            <div class="detail-value">

                                @ShowValue(org.GSTNo)

                            </div>

                        </div>

                    </div>


                    <!-- CIN -->

                    <div class="col-lg-4 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                CIN Number
                            </label>

                            <div class="detail-value">

                                @ShowValue(org.CINNo)

                            </div>

                        </div>

                    </div>


                    <!-- EMPLOYEE STRENGTH -->

                    <div class="col-lg-4 col-md-6">

                        <div class="detail-field">

                            <label class="detail-label">
                                Current Employee Strength
                            </label>

                            <div class="detail-value">

                                @ShowValue(org.CurrentEmployeeStrength)

                            </div>

                        </div>

                    </div>


                </div>


                <!-- =================================
                     ADDRESS
                ================================== -->

                <div class="section-heading mt-3">

                    <span></span>

                    <h4>
                        Organization Address
                    </h4>

                </div>


                <div class="detail-field">

                    <label class="detail-label">
                        Complete Address
                    </label>

                    <div class="detail-value address">

                        @ShowValue(org.OrganizationAddress)

                    </div>

                </div>


            </div>


            <!-- =====================================
                 NAVIGATION FOOTER
            ====================================== -->

            <div class="navigation-footer">


                <!-- BACK -->

                <a asp-controller="SuperAdmin"
                   asp-action="SAOrgProfileList"
                   class="nav-btn back-btn">

                    ← Back to List

                </a>


                <!-- CENTER -->

                <div class="navigation-center">

                    Organization
                    @Model.CurrentIndex
                    /
                    @Model.TotalRecords

                </div>


                <!-- PREVIOUS / NEXT -->

                <div class="navigation-buttons">


                    @if (Model.HasPrevious)
                    {
                        <a asp-controller="SuperAdminOrganization"
                           asp-action="OrganizationProfileDetails"
                           asp-route-id="@Model.PreviousId"
                           class="nav-btn prev-btn">

                            ← Previous

                        </a>
                    }
                    else
                    {
                        <span class="nav-btn prev-btn disabled">

                            ← Previous

                        </span>
                    }


                    @if (Model.HasNext)
                    {
                        <a asp-controller="SuperAdminOrganization"
                           asp-action="OrganizationProfileDetails"
                           asp-route-id="@Model.NextId"
                           class="nav-btn next-btn">

                            Next →

                        </a>
                    }
                    else
                    {
                        <span class="nav-btn next-btn disabled">

                            Next →

                        </span>
                    }

                </div>

            </div>


        </div>

    </div>

</div>


@functions {

    public string ShowValue(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "N/A";
        }

        return value;
    }

}