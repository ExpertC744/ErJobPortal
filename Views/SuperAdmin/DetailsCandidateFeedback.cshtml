@model ErJobPortal.Models.SACandidateFeedbackDetailsM
@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SADetailsCandidateFeedback.css" asp-append-version="true" />
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
        Layout = null;

    ViewData["Title"] = "Trainee Feedback Details";

    ViewData["Panel"] = "SuperAdmin";

    ViewData["UserName"] = "Super Admin";
}
 <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


<div class="feedback-details-page">


    <!-- =================================
         RIGHT SIDE BUTTONS
         ================================= -->

 <div class="side-buttons">

    <!-- BACK -->
    <a href="javascript:history.back();"
       class="side-button"
       title="Back">
        <i class="fa-solid fa-arrow-left"></i>
    </a>

    <!-- HOME -->
    <a asp-controller="SuperAdmin"
       asp-action="Dashboard"
       class="side-button"
       title="Home">
        <i class="fa-solid fa-house"></i>
    </a>

    <!-- PRINT -->
    <a href="javascript:window.print();"
       class="side-button"
       title="Print">
        <i class="fa-solid fa-print"></i>
    </a>

</div>


    <!-- =================================
         MAIN CARD
         ================================= -->

    <div class="feedback-details-card">


        <!-- =================================
             CANDIDATE INFORMATION
             ================================= -->

        <div class="candidate-header">


            <!-- PROFILE IMAGE -->

            <div class="candidate-image-box">

                @if (!string.IsNullOrWhiteSpace(Model.sProfileImage))
                {
                    <img src="@Model.sProfileImage"
                         class="candidate-image"
                         alt="Candidate Image" />
                }
                else
                {
                    <span class="no-image">
                        No Image
                    </span>
                }

            </div>


            <!-- NAME -->

            <h1 class="candidate-name">

                @Model.sFName @Model.sLName

            </h1>


        </div>



        <!-- =================================
             QUESTION 1
             ================================= -->

        <div class="feedback-row">

            <div>

                <div class="question-title">
                    Question 1
                </div>

                <div class="question-text">

                    The resource &amp; contents provided on the
                    1 Trainee portal to be relevant &amp; useful
                    for your internship needs.

                </div>

            </div>


            <div>

                <div class="answer-title">
                    Answer 1
                </div>

                <div class="answer-text">

                    @if (Model.sQue1 == 1)
                    {
                        @:True
                    }
                    else
                    {
                        @:False
                    }

                </div>

            </div>

        </div>



        <!-- =================================
             QUESTION 2
             ================================= -->

        <div class="feedback-row">

            <div>

                <div class="question-title">
                    Question 2
                </div>

                <div class="question-text">

                    How would you rate the responsiveness
                    &amp; accessibility of 1trainee.com for
                    getting an internship opportunity?

                </div>

            </div>


            <div>

                <div class="answer-title">
                    Answer 2
                </div>

                <div class="answer-text">

                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.sQue2)
                        {
                            <span class="star star-filled">
                                ★
                            </span>
                        }
                        else
                        {
                            <span class="star star-empty">
                                ☆
                            </span>
                        }
                    }

                </div>

            </div>

        </div>



        <!-- =================================
             QUESTION 3
             ================================= -->

        <div class="feedback-row">

            <div>

                <div class="question-title">
                    Question 3
                </div>

                <div class="question-text">

                    Would you like to recommend
                    1trainee.com to your friends &amp; family?

                </div>

            </div>


            <div>

                <div class="answer-title">
                    Answer 3
                </div>

                <div class="answer-text">

                    @if (Model.sQue3 == 1)
                    {
                        @:Yes
                    }
                    else
                    {
                        @:No
                    }

                </div>

            </div>

        </div>



        <!-- =================================
             QUESTION 4
             ================================= -->

        <div class="feedback-row">

            <div>

                <div class="question-title">
                    Question 4
                </div>

                <div class="question-text">

                    How satisfied are you overall with the
                    details available on the 1 Trainee portal?

                </div>

            </div>


            <div>

                <div class="answer-title">
                    Answer 4
                </div>

                <div class="answer-text">

                    @switch (Model.sQue4)
                    {
                        case 1:
                            @:😞
                            break;

                        case 2:
                            @:😐
                            break;

                        case 3:
                            @:🙂
                            break;

                        case 4:
                            @:😊
                            break;

                        case 5:
                            @:😍
                            break;
                    }

                </div>

            </div>

        </div>



        <!-- =================================
             QUESTION 5
             ================================= -->

        <div class="feedback-row">

            <div>

                <div class="question-title">
                    Question 5
                </div>

                <div class="question-text">

                    What suggestions do you have for improving
                    the 1 Trainee portal to better meet your
                    internships objective &amp; preferences?

                </div>

            </div>


            <div>

                <div class="answer-title">
                    Answer 5
                </div>

                <div class="answer-text">

                    @Model.sQue5

                </div>

            </div>

        </div>



    </div>

</div>