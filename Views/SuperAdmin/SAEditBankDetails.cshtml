@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Bank Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}
@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAEditBankDetails.css" asp-append-version="true" />
<div class="container-fluid edit-bank-page">

    <!-- Page Header -->
    <div class="edit-bank-header">

        <div>
            <h1>
                <i class="fas fa-edit"></i>
                Edit Bank Details
            </h1>

            <p>ItNetworkZ</p>
        </div>

        <a asp-controller="SuperAdmin"
           asp-action="SABillingControl"
           class="bank-back-btn">
            <i class="fas fa-arrow-left"></i>
            Back
        </a>

    </div>


    <!-- Form Card -->
    <div class="edit-bank-card">

       


        <!-- Form -->
        <form asp-controller="Billing"
              asp-action="EditBankDetails"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="1" />


            <div class="edit-bank-body">

                <div class="row g-4">

                    <!-- Account No -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                Account No.
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-credit-card"></i>

                                <input type="text"
                                       name="AccountNo"
                                       class="form-control"
                                       value="12345678901"
                                       placeholder="Enter account number"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Bank Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                Bank Name
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-university"></i>

                                <input type="text"
                                       name="BankName"
                                       class="form-control"
                                       value="HDFC1"
                                       placeholder="Enter bank name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Customer Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                Customer Name
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-user"></i>

                                <input type="text"
                                       name="CustomerName"
                                       class="form-control"
                                       value="Sam1"
                                       placeholder="Enter customer name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- IFSC Code -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                IFSC Code
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-code"></i>

                                <input type="text"
                                       name="IFSCCode"
                                       class="form-control"
                                       value="HDFC0001231"
                                       placeholder="Enter IFSC code"
                                       maxlength="11"
                                       style="text-transform:uppercase;"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Account Type -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                Account Type
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-wallet"></i>

                                <select name="AccountType"
                                        class="form-control"
                                        required>

                                    <option value="">
                                        Select account type
                                    </option>

                                    <option value="Savings" selected>
                                        Savings
                                    </option>

                                    <option value="Current">
                                        Current
                                    </option>

                                    <option value="Salary">
                                        Salary
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- Branch -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                Branch
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-code-branch"></i>

                                <input type="text"
                                       name="Branch"
                                       class="form-control"
                                       value="Nagpur1"
                                       placeholder="Enter branch"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- City -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                City
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-location-dot"></i>

                                <input type="text"
                                       name="City"
                                       class="form-control"
                                       value="Nagpur1"
                                       placeholder="Enter city"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- PAN No -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                PAN No.
                                <span>*</span>
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-id-card"></i>

                                <input type="text"
                                       name="PANNo"
                                       class="form-control"
                                       value="HDHDHD1231"
                                       placeholder="Enter PAN number"
                                       maxlength="10"
                                       style="text-transform:uppercase;"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- GST No -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                GST No.
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-file-invoice"></i>

                                <input type="text"
                                       name="GSTNo"
                                       class="form-control"
                                       value="12345678901"
                                       placeholder="Enter GST number"
                                       style="text-transform:uppercase;" />

                            </div>

                        </div>

                    </div>


                    <!-- CIN No -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="edit-bank-field">

                            <label>
                                CIN No.
                            </label>

                            <div class="edit-bank-input">

                                <i class="fas fa-building"></i>

                                <input type="text"
                                       name="CINNo"
                                       class="form-control"
                                       value="12345678901"
                                       placeholder="Enter CIN number"
                                       style="text-transform:uppercase;" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Footer -->
            <div class="edit-bank-footer">

                <a asp-controller="Billing"
                   asp-action="ViewBankDetails"
                   class="bank-cancel-btn">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>

                <button type="submit"
                        class="bank-save-btn">
                    <i class="fas fa-save"></i>
                    Save
                </button>

            </div>

        </form>

    </div>

</div>

