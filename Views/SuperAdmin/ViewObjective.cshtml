@model List<ErJobPortal.Models.SAObjectiveM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Objectives";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";

    var genderNames =
        ViewBag.GenderNames as Dictionary<int, string>
        ?? new Dictionary<int, string>();
}

<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
    ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="mb-1">
                Objectives
            </h1>

            <p class="text-muted mb-0">
                Manage candidate objectives
            </p>
        </div>

        <a asp-controller="SuperAdmin"
           asp-action="AddObjective"
           asp-route-id="1"
           class="btn btn-success px-4 py-2">

            <i class="fas fa-plus me-2"></i>

            Add Objective

        </a>

    </div>


    <!-- =====================================================
         1TRAINEE MASTER TABLE
    ===================================================== -->

    <div class="master-table-container">

        <!-- MASTER TABLE HEADER -->

        <div class="master-table-title">

            <div>

                <h2>

                    <i class="fas fa-table me-2"></i>

                    Objectives

                </h2>

            </div>

        </div>


        <!-- MASTER TABLE BODY -->

        <div class="p-3">

            <div class="table-responsive">

                <table id="objectiveTable"
                       class="master-data-table">

                    <thead>

                        <tr>

                            <th>
                                Sr. No
                            </th>

                            <th>
                                Gender Name
                            </th>

                            <th>
                                Objective
                            </th>
                              <th>
                                Action
                            </th>
                            <th>
                                Status
                            </th>

                          

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model != null && Model.Count > 0)
                        {
                            int srNo = 1;

                            foreach (var item in Model)
                            {
                                string genderName = "N/A";

                                if (genderNames.ContainsKey(item.nGenderID))
                                {
                                    genderName =
                                        genderNames[item.nGenderID];
                                }

                                <tr>

                                    <!-- SR NO -->

                                    <td class="master-id">
                                        @srNo
                                    </td>


                                    <!-- GENDER -->

                                    <td>
                                        @genderName
                                    </td>


                                    <!-- OBJECTIVE -->

                                    <td class="text-start">
                                        @item.sObjective
                                    </td>

                                      <!-- ACTION -->

                                    <td>

                                        <a asp-controller="SuperAdmin"
                                           asp-action="EditObjective"
                                           asp-route-id="@item.nID"
                                           class="resume-view-btn"
                                           title="Edit Objective">

                                            <i class="fas fa-edit"></i>

                                        </a>

                                    </td>
                                    <!-- STATUS -->

                                    <td>

                                        @if (item.nBit)
                                        {
                                            <button type="button"
                                                    class="master-status master-status-active"
                                                    onclick="changeStatus(@item.nID, false)">

                                                Enabled

                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="master-status master-status-disabled"
                                                    onclick="changeStatus(@item.nID, true)">

                                                Disabled

                                            </button>
                                        }

                                    </td>


                                  

                                </tr>

                                srNo++;
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       OBJECTIVE PAGE
       Only small page-specific styling.
       Main table styling uses 1Trainee Master Table classes.
    ========================================================= */

    .master-status {
        border: none;
        cursor: pointer;
        min-width: 95px;
        text-align: center;
    }


    .master-status-active {
        background: #198754;
        color: #fff;
    }


    .master-status-disabled {
        background: #dc3545;
        color: #fff;
    }


    #objectiveTable th,
    #objectiveTable td {
        vertical-align: middle;
    }


    #objectiveTable th:nth-child(1),
    #objectiveTable td:nth-child(1) {
        width: 90px;
        text-align: center;
    }


    #objectiveTable th:nth-child(2),
    #objectiveTable td:nth-child(2) {
        width: 160px;
        text-align: center;
    }


    #objectiveTable th:nth-child(3),
    #objectiveTable td:nth-child(3) {
        min-width: 350px;
    }


    #objectiveTable th:nth-child(4),
    #objectiveTable td:nth-child(4) {
        width: 150px;
        text-align: center;
    }


    #objectiveTable th:nth-child(5),
    #objectiveTable td:nth-child(5) {
        width: 100px;
        text-align: center;
    }


    @@media (max-width: 768px) {

        #objectiveTable {
            min-width: 850px;
        }

    }

</style>


@section Scripts {

    <script>

        /* =====================================================
           CHANGE STATUS
        ===================================================== */

        function changeStatus(id, status) {

            $.ajax({

                url: '@Url.Action("ChangeStatus", "SuperAdmin")',

                type: "POST",

                data: {
                    id: id,
                    status: status
                },

                success: function (response) {

                    if (response.success) {

                        location.reload();

                    }
                    else {

                        alert(response.message);

                    }

                },

                error: function (xhr) {

                    console.log(xhr.responseText);

                    alert("Unable to change status.");

                }

            });

        }

    </script>

}