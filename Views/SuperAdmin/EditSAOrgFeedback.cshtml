@model ErJobPortal.Models.SAOrgFeedbackM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Feedback";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/EditSAOrgFeedback.css"
          asp-append-version="true" />

}

<div class="feedback-page">

    <!-- PAGE HEADER -->
    <div class="feedback-page-header">

        <h1 class="feedback-page-title">
            Edit Feedback
        </h1>

        <p class="feedback-page-subtitle">
            Update organization feedback questions and answers
        </p>

    </div>


    <form asp-controller="SuperAdmin"
          asp-action="EditSAOrgFeedback"
          method="post"
          class="feedback-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="nID" />


        <!-- ===================================================== -->
        <!-- QUESTION 1 -->
        <!-- ===================================================== -->

        <div class="question-card">

            <div class="question-header">

                <span class="question-number">
                    1.
                </span>

                <div class="question-content">

                    

                    <textarea asp-for="Que1"
                              class="question-input"
                              rows="3"
                              placeholder="Enter feedback question..."></textarea>

                </div>

            </div>


            <div class="answer-block">

               

                <div class="choice-row">

                    <label class="choice-card">

                        <input type="radio"
                               name="Ans1Radio"
                               value="True"
                               onclick="setAnswer1('True')"
                               @(Model.Ans1 == "True" ? "checked" : "") />

                        <span class="choice-circle"></span>

                        <span class="choice-text">
                            True
                        </span>

                    </label>


                    <label class="choice-card">

                        <input type="radio"
                               name="Ans1Radio"
                               value="False"
                               onclick="setAnswer1('False')"
                               @(Model.Ans1 == "False" ? "checked" : "") />

                        <span class="choice-circle"></span>

                        <span class="choice-text">
                            False
                        </span>

                    </label>

                </div>

            </div>

            <input type="hidden"
                   asp-for="Ans1"
                   id="Ans1" />

        </div>



        <!-- ===================================================== -->
        <!-- QUESTION 2 -->
        <!-- ===================================================== -->

        <div class="question-card">

            <div class="question-header">

                <span class="question-number">
                    2.
                </span>

                <div class="question-content">

                    

                    <textarea asp-for="Que2"
                              class="question-input"
                              rows="3"
                              placeholder="Enter feedback question..."></textarea>

                </div>

            </div>


            <div class="answer-block">

             


                <div class="star-rating"
                     id="starRating">

                    <span class="star"
                          data-value="1"
                          onclick="setStarRating(1)">
                        ★
                    </span>

                    <span class="star"
                          data-value="2"
                          onclick="setStarRating(2)">
                        ★
                    </span>

                    <span class="star"
                          data-value="3"
                          onclick="setStarRating(3)">
                        ★
                    </span>

                    <span class="star"
                          data-value="4"
                          onclick="setStarRating(4)">
                        ★
                    </span>

                    <span class="star"
                          data-value="5"
                          onclick="setStarRating(5)">
                        ★
                    </span>

                </div>

                 

            </div>

            <input type="hidden"
                   asp-for="Ans2"
                   id="Ans2" />

        </div>



        <!-- ===================================================== -->
        <!-- QUESTION 3 -->
        <!-- ===================================================== -->

        <div class="question-card">

            <div class="question-header">

                <span class="question-number">
                    3.
                </span>

                <div class="question-content">

                   

                    <textarea asp-for="Que3"
                              class="question-input"
                              rows="3"
                              placeholder="Enter feedback question..."></textarea>

                </div>

            </div>


            <div class="answer-block">

                


                <div class="choice-row">

                    <label class="choice-card">

                        <input type="radio"
                               name="Ans3Radio"
                               value="Yes"
                               onclick="setAnswer3('Yes')"
                               @(Model.Ans3 == "Yes" ? "checked" : "") />

                        <span class="choice-circle"></span>

                        <span class="choice-text">
                            Yes
                        </span>

                    </label>


                    <label class="choice-card">

                        <input type="radio"
                               name="Ans3Radio"
                               value="No"
                               onclick="setAnswer3('No')"
                               @(Model.Ans3 == "No" ? "checked" : "") />

                        <span class="choice-circle"></span>

                        <span class="choice-text">
                            No
                        </span>

                    </label>

                </div>

            </div>

            <input type="hidden"
                   asp-for="Ans3"
                   id="Ans3" />

        </div>



        <!-- ===================================================== -->
        <!-- QUESTION 4 -->
        <!-- ===================================================== -->

        <div class="question-card">

            <div class="question-header">

                <span class="question-number">
                    4.
                </span>

                <div class="question-content">

                    

                    <textarea asp-for="Que4"
                              class="question-input"
                              rows="3"
                              placeholder="Enter feedback question..."></textarea>

                </div>

            </div>


            <div class="answer-block">

             


                <div class="emoji-rating"
                     id="emojiRating">

                    <span class="emoji"
                          data-value="1"
                          onclick="setEmojiRating(1)">
                        😟
                    </span>

                    <span class="emoji"
                          data-value="2"
                          onclick="setEmojiRating(2)">
                        😧
                    </span>

                    <span class="emoji"
                          data-value="3"
                          onclick="setEmojiRating(3)">
                        😃
                    </span>

                    <span class="emoji"
                          data-value="4"
                          onclick="setEmojiRating(4)">
                        😄
                    </span>

                    <span class="emoji"
                          data-value="5"
                          onclick="setEmojiRating(5)">
                        😍
                    </span>

                </div>

                

            </div>

            <input type="hidden"
                   asp-for="Ans4"
                   id="Ans4" />

        </div>



        <!-- ===================================================== -->
        <!-- QUESTION 5 -->
        <!-- ===================================================== -->

        <div class="question-card">

            <div class="question-header">

                <span class="question-number">
                    5.
                </span>

                <div class="question-content">

                     

                    <textarea asp-for="Que5"
                              class="question-input"
                              rows="3"
                              placeholder="Enter feedback question..."></textarea>

                </div>

            </div>


            <div class="answer-block">

                

                <textarea asp-for="Ans5"
                          class="description-input"
                          rows="5"
                          placeholder="Enter description..."></textarea>

            </div>

        </div>



        <!-- ===================================================== -->
        <!-- SAVE AREA -->
        <!-- ===================================================== -->

        <div class="save-area">

            <button type="submit"
                    class="save-button">

                <span class="save-icon">
                    ✓
                </span>

                Save Changes

            </button>

        </div>

    </form>

</div>


<script>

    /* =========================================================
       QUESTION 1
       ========================================================= */

    function setAnswer1(value) {

        document.getElementById("Ans1").value = value;

    }


    /* =========================================================
       QUESTION 3
       ========================================================= */

    function setAnswer3(value) {

        document.getElementById("Ans3").value = value;

    }


    /* =========================================================
       STAR RATING
       ========================================================= */

    function setStarRating(value) {

        document.getElementById("Ans2").value = value;

        var stars = document.querySelectorAll("#starRating .star");

        stars.forEach(function (star) {

            var starValue =
                parseInt(star.getAttribute("data-value"));

            if (starValue <= value) {

                star.classList.add("active");

            }
            else {

                star.classList.remove("active");

            }

        });

    }


    /* =========================================================
       EMOJI RATING
       ========================================================= */

    function setEmojiRating(value) {

        document.getElementById("Ans4").value = value;

        var emojis =
            document.querySelectorAll("#emojiRating .emoji");

        emojis.forEach(function (emoji) {

            var emojiValue =
                parseInt(emoji.getAttribute("data-value"));

            if (emojiValue === value) {

                emoji.classList.add("active");

            }
            else {

                emoji.classList.remove("active");

            }

        });

    }


    /* =========================================================
       LOAD EXISTING VALUES
       ========================================================= */

    document.addEventListener("DOMContentLoaded", function () {

        var starInput =
            document.getElementById("Ans2");

        if (starInput) {

            var starValue =
                parseInt(starInput.value);

            if (!isNaN(starValue) &&
                starValue >= 1 &&
                starValue <= 5) {

                setStarRating(starValue);

            }

        }


        var emojiInput =
            document.getElementById("Ans4");

        if (emojiInput) {

            var emojiValue =
                parseInt(emojiInput.value);

            if (!isNaN(emojiValue) &&
                emojiValue >= 1 &&
                emojiValue <= 5) {

                setEmojiRating(emojiValue);

            }

        }

    });

</script>