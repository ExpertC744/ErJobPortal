@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Advertisement";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid advertisement-edit-page">

   


    <!-- Edit Advertisement Card -->
    <div class="advertisement-card">

        <div class="advertisement-card-header">
            <div class="header-icon">
                <i class="fas fa-bullhorn"></i>
            </div>

            <div>
                <h2>Edit Advertisement</h2>
                 
            </div>
        </div>


        <form method="post"
              enctype="multipart/form-data"
              asp-controller="SuperAdminAdvertisement"
              asp-action="EditAdvertisement">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="1" />


            <div class="advertisement-form-body">

                <div class="row g-4">

                    <!-- Client Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="form-group">

                            <label>
                                Client Name
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="fas fa-user"></i>

                                <input type="text"
                                       name="ClientName"
                                       class="form-control"
                                       value="Tyuqw"
                                       placeholder="Enter client name"
                                       required />
                            </div>

                        </div>

                    </div>


                    <!-- Company Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="form-group">

                            <label>
                                Company Name
                                <span>*</span>
                            </label>

                            <div class="input-wrapper">
                                <i class="fas fa-building"></i>

                                <input type="text"
                                       name="CompanyName"
                                       class="form-control"
                                       value="IT-NetworkZ"
                                       placeholder="Enter company name"
                                       required />
                            </div>

                        </div>

                    </div>


                    <!-- Banner Image -->
                    <div class="col-xl-4 col-lg-12 col-md-12 col-12">

                        <div class="form-group">

                            <label>
                                Banner Image
                                <span>*</span>
                            </label>

                            <div class="file-wrapper">

                                <i class="fas fa-cloud-upload-alt"></i>

                                <input type="file"
                                       id="bannerImage"
                                       name="BannerImage"
                                       class="form-control"
                                       accept="image/png,image/jpeg,image/jpg,image/webp"
                                       onchange="previewAdvertisementImage(this)" />

                            </div>

                            <small class="form-help">
                                JPG, JPEG, PNG or WEBP
                            </small>

                        </div>

                    </div>


                    <!-- Image Preview -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="preview-section">

                            <label>Banner Preview</label>

                            <div class="image-preview-box">

                                <div id="previewPlaceholder"
                                     class="preview-placeholder">

                                    <i class="fas fa-image"></i>

                                    <span>
                                        No image selected
                                    </span>

                                </div>

                                <img id="advertisementPreview"
                                     src=""
                                     alt="Advertisement Preview"
                                     class="advertisement-preview d-none" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Footer -->
            <div class="advertisement-card-footer">

                <a asp-controller="SuperAdminAdvertisement"
                   asp-action="AdvertisementList"
                   class="btn-cancel">
                    <i class="fas fa-times me-1"></i>
                    Cancel
                </a>

                <button type="submit"
                        class="btn-save">
                    <i class="fas fa-save me-1"></i>
                    Save Advertisement
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    /* ================================
       1TRAINEE EDIT ADVERTISEMENT
       ================================ */

    .advertisement-edit-page {
        padding-bottom: 40px;
    }


    /* Page Header */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .page-header h1 {
        margin: 0 0 6px;
        color: #0f172a;
        font-size: 28px;
        font-weight: 700;
    }

    .page-header h1 i {
        color: #0d9488;
    }

    .page-header p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }


    /* Back Button */

    .back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 17px;
        border: 1px solid #99f6e4;
        border-radius: 9px;
        background: #f0fdfa;
        color: #0f766e;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }

    .back-btn:hover {
        background: #ccfbf1;
        color: #115e59;
        text-decoration: none;
    }


    /* Main Card */

    .advertisement-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(15, 23, 42, .06);
    }


    /* Card Header */

    .advertisement-card-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 24px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fffe;
    }

    .header-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #ccfbf1;
        color: #0d9488;
        font-size: 18px;
    }

    .advertisement-card-header h2 {
        margin: 0 0 3px;
        color: #0f172a;
        font-size: 18px;
        font-weight: 700;
    }

    .advertisement-card-header p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }


    /* Form */

    .advertisement-form-body {
        padding: 28px 24px;
    }

    .form-group label,
    .preview-section > label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .form-group label span {
        color: #ef4444;
        margin-left: 2px;
    }


    /* Input */

    .input-wrapper {
        position: relative;
    }

    .input-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #0d9488;
        font-size: 14px;
        z-index: 2;
    }

    .form-control {
        width: 100%;
        height: 46px;
        padding: 0 14px 0 40px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        background: #ffffff;
        color: #0f172a;
        font-size: 13px;
        outline: none;
        box-shadow: none;
    }

    .form-control:focus {
        border-color: #14b8a6;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
    }


    /* File Upload */

    .file-wrapper {
        position: relative;
    }

    .file-wrapper > i {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #0d9488;
        z-index: 2;
        pointer-events: none;
    }

    .file-wrapper .form-control {
        padding-left: 40px;
        padding-top: 10px;
        cursor: pointer;
    }

    .form-help {
        display: block;
        margin-top: 6px;
        color: #94a3b8;
        font-size: 11px;
    }


    /* Preview */

    .image-preview-box {
        width: 100%;
        min-height: 150px;
        border: 1px dashed #99f6e4;
        border-radius: 12px;
        background: #f0fdfa;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .preview-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 150px;
        color: #94a3b8;
        font-size: 12px;
    }

    .preview-placeholder i {
        color: #5eead4;
        font-size: 30px;
    }

    .advertisement-preview {
        display: block;
        width: 100%;
        max-height: 180px;
        object-fit: contain;
        padding: 8px;
    }

    .d-none {
        display: none !important;
    }


    /* Footer */

    .advertisement-card-footer {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 18px 24px;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
    }


    /* Cancel */

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 95px;
        height: 42px;
        padding: 0 16px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-cancel:hover {
        background: #f8fafc;
        color: #334155;
        text-decoration: none;
    }


    /* Save */

    .btn-save {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 155px;
        height: 42px;
        padding: 0 18px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 5px 12px rgba(13, 148, 136, .20);
        transition: all .2s ease;
    }

    .btn-save:hover {
        background: linear-gradient(135deg, #0f766e, #115e59);
        color: #ffffff;
        transform: translateY(-1px);
    }


    /* ================================
       RESPONSIVE
       ================================ */

    @@media (max-width: 991px) {

        .page-header h1 {
            font-size: 25px;
        }

        .advertisement-form-body {
            padding: 24px 20px;
        }

    }


    @@media (max-width: 767px) {

        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .back-btn {
            width: 100%;
        }

        .advertisement-card-header {
            padding: 18px;
        }

        .advertisement-form-body {
            padding: 22px 18px;
        }

        .advertisement-card-footer {
            padding: 16px 18px;
            flex-direction: column-reverse;
        }

        .btn-cancel,
        .btn-save {
            width: 100%;
        }

    }


    @@media (max-width: 480px) {

        .advertisement-edit-page {
            padding-left: 4px;
            padding-right: 4px;
        }

        .page-header h1 {
            font-size: 22px;
        }

        .advertisement-card-header {
            align-items: flex-start;
        }

        .header-icon {
            width: 40px;
            height: 40px;
            flex-shrink: 0;
        }

    }

</style>


<script>

    function previewAdvertisementImage(input) {

        const preview = document.getElementById("advertisementPreview");
        const placeholder = document.getElementById("previewPlaceholder");

        if (!input.files || input.files.length === 0) {

            preview.src = "";
            preview.classList.add("d-none");
            placeholder.classList.remove("d-none");

            return;
        }

        const file = input.files[0];

        if (!file.type.startsWith("image/")) {

            input.value = "";

            preview.src = "";
            preview.classList.add("d-none");
            placeholder.classList.remove("d-none");

            return;
        }

        const reader = new FileReader();

        reader.onload = function (e) {

            preview.src = e.target.result;

            preview.classList.remove("d-none");
            placeholder.classList.add("d-none");

        };

        reader.readAsDataURL(file);
    }

</script>