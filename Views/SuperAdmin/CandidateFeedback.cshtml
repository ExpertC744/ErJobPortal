```cshtml
@model IEnumerable<ErJobPortal.Models.SACandidateFeedbackM>

<link rel="stylesheet"
      href="~/css/SACandidateFeedback.css"
      asp-append-version="true" />

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Trainee Feedback";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

<div class="feedback-page container-fluid trainee-selection-page">

    <div class="master-table-container">

        <!-- ========================================================= -->
        <!-- PAGE HEADER -->
        <!-- ========================================================= -->

        <div class="feedback-title-row">

            <div>
                <h1 class="feedback-title">
                    Trainee Feedback Details
                </h1>

                <div class="feedback-subtitle">
                    ItNetworkZ
                </div>
            </div>

            <!-- BACK BUTTON -->
            <a href="javascript:history.back();"
               class="back-button"
               title="Back">

                <i class="fas fa-arrow-left"></i>

            </a>

        </div>


        <!-- ========================================================= -->
        <!-- SUCCESS / ERROR MESSAGE -->
        <!-- ========================================================= -->

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <!-- ========================================================= -->
        <!-- FEEDBACK TABLE -->
        <!-- ========================================================= -->

        <div class="table-responsive">

            <table id="feedbackTable"
                   class="master-data-table"
                   data-mobile-scroll="true">

                <thead>

                    <tr>

                        <th>
                            Sr. No
                        </th>

                        <th>
                            Trainee ID
                        </th>

                        <th>
                            Trainee Name
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @{
                        int srNo = 1;
                    }

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- ================================================= -->
                                <!-- SR NO -->
                                <!-- ================================================= -->

                                <td>
                                    @srNo
                                </td>


                                <!-- ================================================= -->
                                <!-- TRAINEE ID -->
                                <!-- ================================================= -->

                                <td>
                                    @item.nAdminID
                                </td>


                                <!-- ================================================= -->
                                <!-- TRAINEE NAME -->
                                <!-- ================================================= -->

                                <td>
                                    @item.sFName @item.sLName
                                </td>


                                <!-- ================================================= -->
                                <!-- STATUS -->
                                <!-- ================================================= -->

                                <td>

                                    <form asp-controller="SuperAdmin"
                                          asp-action="ToggleCandidateFeedback"
                                          method="post"
                                          class="feedback-toggle-form"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <!--
                                            IMPORTANT:
                                            Send FeedbackID, NOT CandidateID.
                                        -->

                                        <input type="hidden"
                                               name="id"
                                               value="@item.FeedbackID" />


                                        @if (item.nSABit == 1)
                                        {
                                            <!-- ===================================== -->
                                            <!-- ENABLED -->
                                            <!-- ===================================== -->

                                            <button type="submit"
                                                    class="status-button status-enabled"
                                                    onclick="return confirm('Are you sure you want to disable this feedback?');">

                                                Enabled

                                            </button>
                                        }
                                        else
                                        {
                                            <!-- ===================================== -->
                                            <!-- DISABLED -->
                                            <!-- ===================================== -->

                                            <button type="submit"
                                                    class="status-button status-disabled"
                                                    onclick="return confirm('Are you sure you want to enable this feedback?');">

                                                Disabled

                                            </button>
                                        }

                                    </form>

                                </td>


                                <!-- ================================================= -->
                                <!-- ACTION -->
                                <!-- ================================================= -->

                                <td>

                                    <a asp-controller="SuperAdmin"
                                       asp-action="DetailsCandidateFeedback"
                                       asp-route-id="@item.FeedbackID"
                                       class="master-action-btn"
                                       title="View Feedback">

                                        <i class="fas fa-eye"></i>

                                    </a>

                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <!-- ========================================================= -->
                        <!-- NO DATA -->
                        <!-- ========================================================= -->

                        <tr>

                            <td colspan="5"
                                class="text-center">

                                No trainee feedback found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- ========================================================= -->
        <!-- PAGINATION INFO -->
        <!-- ========================================================= -->

        <div id="feedbackPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- OPTIONAL AUTO HIDE ALERT -->
<!-- ============================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        setTimeout(function () {

            const alerts = document.querySelectorAll(".alert");

            alerts.forEach(function (alert) {

                if (typeof bootstrap !== "undefined") {

                    const bsAlert =
                        bootstrap.Alert.getOrCreateInstance(alert);

                    bsAlert.close();

                }

            });

        }, 4000);

    });

</script>
```
