@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Bank Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}

<div class="container-fluid bank-details-page">

    <!-- Page Header -->
    <div class="bank-page-header">

        <div>
            <h1>
                <i class="fas fa-university"></i>
                Add Bank Details
            </h1>

            <p>ItNetworkZ</p>
        </div>

        <a asp-controller="SuperAdmin"
           asp-action="SABillingControl"
           class="bank-back-btn">
            <i class="fas fa-arrow-left"></i>
            Back
        </a>

    </div>


    <!-- Form Card -->
    <div class="bank-form-card">

        <div class="bank-form-header">

            <div class="bank-header-icon">
                <i class="fas fa-building-columns"></i>
            </div>

            <div>
                <h2>Bank Account Information</h2>
                <p>Enter the organization's bank details</p>
            </div>

        </div>


        <form asp-controller="Billing"
              asp-action="AddBankDetails"
              method="post">

            @Html.AntiForgeryToken()


            <div class="bank-form-body">

                <div class="row g-4">

                    <!-- Account No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Account No.
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-credit-card"></i>

                                <input type="text"
                                       name="AccountNo"
                                       class="form-control"
                                       placeholder="Enter account number"
                                       autocomplete="off"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Bank Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Bank Name
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-university"></i>

                                <input type="text"
                                       name="BankName"
                                       class="form-control"
                                       placeholder="Enter bank name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Customer Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Customer Name
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-user"></i>

                                <input type="text"
                                       name="CustomerName"
                                       class="form-control"
                                       placeholder="Enter customer name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- IFSC Code -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                IFSC Code
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-code"></i>

                                <input type="text"
                                       name="IFSCCode"
                                       class="form-control"
                                       placeholder="Enter IFSC code"
                                       style="text-transform:uppercase;"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Account Type -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Account Type
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-wallet"></i>

                                <select name="AccountType"
                                        class="form-control"
                                        required>

                                    <option value="">
                                        Select account type
                                    </option>

                                    <option value="Savings">
                                        Savings
                                    </option>

                                    <option value="Current">
                                        Current
                                    </option>

                                    <option value="Salary">
                                        Salary
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- Branch -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Branch
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-code-branch"></i>

                                <input type="text"
                                       name="Branch"
                                       class="form-control"
                                       placeholder="Enter branch name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- City -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                City
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-location-dot"></i>

                                <input type="text"
                                       name="City"
                                       class="form-control"
                                       placeholder="Enter city"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- PAN No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                PAN No.
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-id-card"></i>

                                <input type="text"
                                       name="PANNo"
                                       class="form-control"
                                       placeholder="Enter PAN number"
                                       style="text-transform:uppercase;"
                                       maxlength="10"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- GST No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                GST No.
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-file-invoice"></i>

                                <input type="text"
                                       name="GSTNo"
                                       class="form-control"
                                       placeholder="Enter GST number"
                                       style="text-transform:uppercase;" />

                            </div>

                        </div>

                    </div>


                    <!-- CIN No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                CIN No.
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-building"></i>

                                <input type="text"
                                       name="CINNo"
                                       class="form-control"
                                       placeholder="Enter CIN number"
                                       style="text-transform:uppercase;" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Form Footer -->
            <div class="bank-form-footer">

                <a asp-controller="Billing"
                   asp-action="Index"
                   class="bank-cancel-btn">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>

                <button type="submit"
                        class="bank-submit-btn">
                    <i class="fas fa-save"></i>
                    Submit
                </button>

            </div>

        </form>

    </div>

</div>


<style>

    /* ==========================================
       1TRAINEE - ADD BANK DETAILS
       ========================================== */

    .bank-details-page {
        padding-bottom: 40px;
    }


    /* Page Header */

    .bank-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 24px;
    }

    .bank-page-header h1 {
        margin: 0 0 5px;
        color: #0f172a;
        font-size: 27px;
        font-weight: 700;
    }

    .bank-page-header h1 i {
        margin-right: 9px;
        color: #0d9488;
    }

    .bank-page-header p {
        margin: 0;
        color: #64748b;
        font-size: 14px;
    }


    /* Back Button */

    .bank-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 85px;
        height: 40px;
        padding: 0 16px;
        border-radius: 8px;
        background: #f0fdfa;
        border: 1px solid #99f6e4;
        color: #0f766e;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .bank-back-btn:hover {
        background: #ccfbf1;
        color: #115e59;
        text-decoration: none;
    }


    /* Main Card */

    .bank-form-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        box-shadow: 0 6px 24px rgba(15, 23, 42, .06);
    }


    /* Card Header */

    .bank-form-header {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 20px 24px;
        background: #f0fdfa;
        border-bottom: 1px solid #e2e8f0;
    }

    .bank-header-icon {
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        background: #ccfbf1;
        color: #0d9488;
        font-size: 19px;
    }

    .bank-form-header h2 {
        margin: 0 0 4px;
        color: #0f172a;
        font-size: 18px;
        font-weight: 700;
    }

    .bank-form-header p {
        margin: 0;
        color: #64748b;
        font-size: 13px;
    }


    /* Form Body */

    .bank-form-body {
        padding: 28px 24px;
    }


    /* Field */

    .bank-field label {
        display: block;
        margin-bottom: 8px;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
    }

    .bank-field label span {
        margin-left: 2px;
        color: #ef4444;
    }


    /* Input */

    .bank-input {
        position: relative;
    }

    .bank-input > i {
        position: absolute;
        left: 14px;
        top: 50%;
        z-index: 2;
        transform: translateY(-50%);
        color: #0d9488;
        font-size: 13px;
        pointer-events: none;
    }

    .bank-input .form-control {
        width: 100%;
        height: 45px;
        padding: 0 14px 0 40px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: #0f172a;
        font-size: 13px;
        box-shadow: none;
    }

    .bank-input .form-control::placeholder {
        color: #94a3b8;
    }

    .bank-input .form-control:focus {
        border-color: #14b8a6;
        outline: none;
        box-shadow: 0 0 0 3px rgba(20, 184, 166, .12);
    }

    .bank-input select.form-control {
        cursor: pointer;
    }


    /* Footer */

    .bank-form-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 24px;
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
    }


    /* Cancel */

    .bank-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 95px;
        height: 42px;
        padding: 0 17px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        background: #ffffff;
        color: #475569;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

    .bank-cancel-btn:hover {
        background: #f8fafc;
        color: #334155;
        text-decoration: none;
    }


    /* Submit */

    .bank-submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-width: 105px;
        height: 42px;
        padding: 0 18px;
        border: 0;
        border-radius: 8px;
        background: linear-gradient(135deg, #0d9488, #0f766e);
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 5px 12px rgba(13, 148, 136, .18);
    }

    .bank-submit-btn:hover {
        background: linear-gradient(135deg, #0f766e, #115e59);
        color: #ffffff;
    }


    /* ==========================================
       RESPONSIVE
       ========================================== */

    @@media (max-width: 991px) {

        .bank-page-header h1 {
            font-size: 24px;
        }

        .bank-form-body {
            padding: 24px 20px;
        }

    }


    @@media (max-width: 767px) {

        .bank-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .bank-back-btn {
            width: 100%;
        }

        .bank-form-header {
            padding: 18px;
        }

        .bank-form-body {
            padding: 22px 18px;
        }

        .bank-form-footer {
            flex-direction: column-reverse;
            padding: 16px 18px;
        }

        .bank-cancel-btn,
        .bank-submit-btn {
            width: 100%;
        }

    }


    @@media (max-width: 480px) {

        .bank-details-page {
            padding-left: 4px;
            padding-right: 4px;
        }

        .bank-page-header h1 {
            font-size: 22px;
        }

        .bank-header-icon {
            width: 41px;
            height: 41px;
        }

    }

</style>