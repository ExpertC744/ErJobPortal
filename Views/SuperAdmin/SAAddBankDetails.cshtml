@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Bank Details";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";
}
@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAAddBankDetails.css" asp-append-version="true" />
<div class="container-fluid bank-details-page">

    <!-- Page Header -->
    <div class="bank-page-header">

        <div>
            <h1>
                <i class="fas fa-university"></i>
                Add Bank Details
            </h1>

            <p>ItNetworkZ</p>
        </div>

        <a asp-controller="SuperAdmin"
           asp-action="SABillingControl"
           class="bank-back-btn">
            <i class="fas fa-arrow-left"></i>
            Back
        </a>

    </div>


    <!-- Form Card -->
    <div class="bank-form-card">

        <div class="bank-form-header">

            <div class="bank-header-icon">
                <i class="fas fa-building-columns"></i>
            </div>

            <div>
                <h2>Bank Account Information</h2>
                <p>Enter the organization's bank details</p>
            </div>

        </div>


        <form asp-controller="Billing"
              asp-action="AddBankDetails"
              method="post">

            @Html.AntiForgeryToken()


            <div class="bank-form-body">

                <div class="row g-4">

                    <!-- Account No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Account No.
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-credit-card"></i>

                                <input type="text"
                                       name="AccountNo"
                                       class="form-control"
                                       placeholder="Enter account number"
                                       autocomplete="off"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Bank Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Bank Name
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-university"></i>

                                <input type="text"
                                       name="BankName"
                                       class="form-control"
                                       placeholder="Enter bank name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Customer Name -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Customer Name
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-user"></i>

                                <input type="text"
                                       name="CustomerName"
                                       class="form-control"
                                       placeholder="Enter customer name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- IFSC Code -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                IFSC Code
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-code"></i>

                                <input type="text"
                                       name="IFSCCode"
                                       class="form-control"
                                       placeholder="Enter IFSC code"
                                       style="text-transform:uppercase;"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- Account Type -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Account Type
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-wallet"></i>

                                <select name="AccountType"
                                        class="form-control"
                                        required>

                                    <option value="">
                                        Select account type
                                    </option>

                                    <option value="Savings">
                                        Savings
                                    </option>

                                    <option value="Current">
                                        Current
                                    </option>

                                    <option value="Salary">
                                        Salary
                                    </option>

                                </select>

                            </div>

                        </div>

                    </div>


                    <!-- Branch -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                Branch
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-code-branch"></i>

                                <input type="text"
                                       name="Branch"
                                       class="form-control"
                                       placeholder="Enter branch name"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- City -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                City
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-location-dot"></i>

                                <input type="text"
                                       name="City"
                                       class="form-control"
                                       placeholder="Enter city"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- PAN No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                PAN No.
                                <span>*</span>
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-id-card"></i>

                                <input type="text"
                                       name="PANNo"
                                       class="form-control"
                                       placeholder="Enter PAN number"
                                       style="text-transform:uppercase;"
                                       maxlength="10"
                                       required />

                            </div>

                        </div>

                    </div>


                    <!-- GST No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                GST No.
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-file-invoice"></i>

                                <input type="text"
                                       name="GSTNo"
                                       class="form-control"
                                       placeholder="Enter GST number"
                                       style="text-transform:uppercase;" />

                            </div>

                        </div>

                    </div>


                    <!-- CIN No. -->
                    <div class="col-xl-4 col-lg-6 col-md-6 col-12">

                        <div class="bank-field">

                            <label>
                                CIN No.
                            </label>

                            <div class="bank-input">

                                <i class="fas fa-building"></i>

                                <input type="text"
                                       name="CINNo"
                                       class="form-control"
                                       placeholder="Enter CIN number"
                                       style="text-transform:uppercase;" />

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- Form Footer -->
            <div class="bank-form-footer">

                <a asp-controller="Billing"
                   asp-action="Index"
                   class="bank-cancel-btn">
                    <i class="fas fa-times"></i>
                    Cancel
                </a>

                <button type="submit"
                        class="bank-submit-btn">
                    <i class="fas fa-save"></i>
                    Submit
                </button>

            </div>

        </form>

    </div>

</div>

