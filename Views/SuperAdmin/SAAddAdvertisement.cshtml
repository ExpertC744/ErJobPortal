@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Advertisement";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

@* Radhika03-10 *@
<link rel="stylesheet" href="~/css/SAAddAdvertisement.css" asp-append-version="true" />


<div class="container-fluid ad-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="ad-page-header">

        <h2>
            Add Advertisement
        </h2>

        <p>
            ItNetworkZ
        </p>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="ad-card">


        <!-- CARD HEADER -->

        <div class="ad-card-header">

            <div class="ad-header-icon">
                <i class="fas fa-bullhorn"></i>
            </div>

            <h3>
                Add Advertisement
            </h3>

        </div>


        <!-- FORM -->

        <div class="ad-card-body">

            <form>


                <!-- =================================================
                     CLIENT INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-user"></i>

                        Client Information

                    </div>


                    <div class="ad-form-grid">


                        <!-- Client Name -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Client Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter client name" />

                        </div>


                        <!-- Company Name -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Company Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter company name" />

                        </div>


                        <!-- Email -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Email
                                <span class="required">*</span>
                            </label>

                            <input type="email"
                                   class="ad-input"
                                   placeholder="Enter email address" />

                        </div>


                        <!-- Contact -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Contact No.
                                <span class="required">*</span>
                            </label>

                            <input type="tel"
                                   class="ad-input"
                                   placeholder="Enter contact number" />

                        </div>


                        <!-- Date of Birth -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Date of Birth
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Reference -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Reference
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Reference --
                                </option>

                                <option>
                                    Media
                                </option>

                                <option>
                                    News Paper
                                </option>

                                <option>
                                    Online Adv
                                </option>

                                <option>
                                    Referred By Friend
                                </option>

                                <option>
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Address -->

                        <div class="ad-field full">

                            <label class="ad-label">
                                Address
                                <span class="required">*</span>
                            </label>

                            <textarea class="ad-textarea"
                                      placeholder="Enter complete address"></textarea>

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     BANNER INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-image"></i>

                        Banner Information

                    </div>


                    <div class="ad-form-grid">


                        <!-- Banner Location -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Banner Location
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select location-select">

                                <option selected disabled>
                                    -- Select a Banner Location --
                                </option>

                                <option>BN-A</option>
                                <option>BN-B</option>
                                <option>BN-C</option>

                                <option>CL-A</option>
                                <option>CL-B</option>
                                <option>CL-C</option>
                                <option>CL-D</option>
                                <option>CL-E</option>
                                <option>CL-F</option>
                                <option>CL-G</option>

                                <option>CT-A</option>
                                <option>CT-B</option>
                                <option>CT-C</option>

                                <option>EC-A</option>
                                <option>EC-B</option>
                                <option>EC-C</option>

                                <option>EO-A</option>
                                <option>EO-B</option>
                                <option>EO-C</option>
                                <option>EO-D</option>
                                <option>EO-E</option>
                                <option>EO-F</option>
                                <option>EO-G</option>
                                <option>EO-H</option>
                                <option>EO-I</option>
                                <option>EO-J</option>

                                <option>ET-A</option>
                                <option>ET-B</option>
                                <option>ET-C</option>

                                <option>FAQ-A</option>
                                <option>FAQ-B</option>
                                <option>FAQ-C</option>
                                <option>FAQ-D</option>
                                <option>FAQ-E</option>
                                <option>FAQ-F</option>
                                <option>FAQ-G</option>
                                <option>FAQ-H</option>
                                <option>FAQ-I</option>
                                <option>FAQ-J</option>

                                <option>HM-A</option>

                                <option>IN-A</option>
                                <option>IN-B</option>
                                <option>IN-C</option>
                                <option>IN-D</option>

                                <option>IP-A</option>
                                <option>IP-B</option>
                                <option>IP-C</option>
                                <option>IP-D</option>
                                <option>IP-E</option>
                                <option>IP-F</option>

                                <option>IT-A</option>

                                <option>MI-A</option>
                                <option>MI-B</option>

                                <option>OB-A</option>
                                <option>OB-B</option>
                                <option>OB-C</option>
                                <option>OB-D</option>
                                <option>OB-E</option>
                                <option>OB-F</option>

                                <option>OR-A</option>
                                <option>OR-B</option>
                                <option>OR-C</option>

                                <option>SN-A</option>
                                <option>SN-B</option>

                                <option>SS-A</option>
                                <option>SS-B</option>

                                <option>TC-A</option>
                                <option>TC-B</option>
                                <option>TC-C</option>
                                <option>TC-D</option>
                                <option>TC-E</option>
                                <option>TC-F</option>
                                <option>TC-G</option>
                                <option>TC-H</option>
                                <option>TC-I</option>
                                <option>TC-J</option>
                                <option>TC-K</option>

                                <option>TF-A</option>
                                <option>TF-B</option>

                                <option>TO-A</option>
                                <option>TO-B</option>
                                <option>TO-C</option>
                                <option>TO-D</option>

                                <option>TR-A</option>
                                <option>TR-B</option>
                                <option>TR-C</option>

                            </select>

                        </div>


                        <!-- Duration -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Banner Duration
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Banner Duration --
                                </option>

                                <option>1 Month</option>
                                <option>3 Months</option>
                                <option>6 Months</option>
                                <option>9 Months</option>
                                <option>12 Months</option>

                            </select>

                        </div>


                        <!-- Start Date -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Start Date
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Till Date -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Till Date
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Total Days -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Total No. Of Days
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   class="ad-input"
                                   placeholder="Enter total days" />

                        </div>


                        <!-- Upload Banner -->

                        <div class="ad-field full">

                            <label class="ad-label">
                                Upload Banner
                                <span class="required">*</span>
                            </label>


                            <div class="upload-box">


                                <div class="upload-input-wrapper">

                                    <i class="fas fa-cloud-upload-alt upload-icon"></i>

                                    <input type="file"
                                           class="ad-input"
                                           accept="image/*" />

                                    <div class="upload-help">
                                        Recommended banner image format:
                                        JPG, JPEG, PNG or WEBP.
                                    </div>

                                </div>


                                <div class="banner-preview">

                                    <div class="banner-preview-title">
                                        Banner Preview
                                    </div>

                                    <img src="https://placehold.jp/100x100.png"
                                         alt="Banner Preview" />

                                </div>

                            </div>

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     PAYMENT INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-credit-card"></i>

                        Payment Information

                    </div>


                    <div class="ad-form-grid">


                        <!-- Payment Purpose -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Payment Purpose
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Payment Purpose --
                                </option>

                                <option>
                                    Adv.
                                </option>

                                <option>
                                    Donation
                                </option>

                                <option>
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Payment Mode -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Payment Mode
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Payment Mode --
                                </option>

                                <option>
                                    Online
                                </option>

                                <option>
                                    By Cash
                                </option>

                                <option>
                                    Cheque
                                </option>

                                <option>
                                    Draft
                                </option>

                            </select>

                        </div>


                        <!-- Cheque Draft -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Cheque / Draft No.
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter cheque / draft number" />

                        </div>


                        <!-- Bank -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Bank Name
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter bank name" />

                        </div>


                        <!-- Cheque Date -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Cheque Date
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Payable At -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Payable At (City)
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter city" />

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     AMOUNT INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-calculator"></i>

                        Amount Details

                    </div>


                    <div class="amount-box">

                        <div class="amount-grid">


                            <!-- Actual Amount -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Actual Amount
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Actual Amount --
                                    </option>

                                    <option>1000</option>
                                    <option>2500</option>
                                    <option>5000</option>
                                    <option>10000</option>
                                    <option>25000</option>

                                </select>

                            </div>


                            <!-- Discount -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Discount %
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Discount --
                                    </option>

                                    <option>0%</option>
                                    <option>5%</option>
                                    <option>10%</option>
                                    <option>15%</option>
                                    <option>20%</option>

                                </select>

                            </div>


                            <!-- Offered -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Offered Amount
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Offered Amount --
                                    </option>

                                    <option>950</option>
                                    <option>2250</option>
                                    <option>4500</option>
                                    <option>8500</option>
                                    <option>20000</option>

                                </select>

                            </div>


                            <!-- Taxes -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Taxes %
                                    <span class="required">*</span>
                                </label>

                                <input type="number"
                                       class="ad-input"
                                       placeholder="Enter tax percentage" />

                            </div>


                            <!-- Total -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Total Amount
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Total Amount --
                                    </option>

                                    <option>950</option>
                                    <option>2250</option>
                                    <option>4500</option>
                                    <option>8500</option>
                                    <option>20000</option>

                                </select>

                            </div>


                            <!-- Paid -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Paid Amount
                                    <span class="required">*</span>
                                </label>

                                <input type="number"
                                       class="ad-input"
                                       placeholder="Enter paid amount" />

                            </div>


                            <!-- Balance -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Balance Amount
                                    <span class="required">*</span>
                                </label>

                                <input type="number"
                                       class="ad-input"
                                       placeholder="Enter balance amount" />

                            </div>


                            <!-- Installment -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Next Installment Date
                                    <span class="required">*</span>
                                </label>

                                <input type="date"
                                       class="ad-input" />

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="ad-form-actions">

                    <button type="button"
                            class="ad-btn ad-btn-cancel">

                        <i class="fas fa-times"></i>

                        Cancel

                    </button>


                    <button type="submit"
                            class="ad-btn ad-btn-save">

                        <i class="fas fa-save"></i>

                        Save Advertisement

                    </button>

                </div>


            </form>

        </div>

    </div>

</div>