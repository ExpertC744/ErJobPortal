@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Advertisement";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

<style>

    /* =========================================================
       ADD ADVERTISEMENT PAGE
    ========================================================= */

    .ad-page {
        width: 100%;
        padding: 5px 0 35px;
        color: #344054;
    }


    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .ad-page-header {
        margin-bottom: 22px;
    }

    .ad-page-header h2 {
        margin: 0;
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
    }

    .ad-page-header p {
        margin: 5px 0 0;
        color: #98a2b3;
        font-size: 13px;
    }


    /* =========================================================
       MAIN CARD
    ========================================================= */

    .ad-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.035);
        overflow: hidden;
    }


    /* =========================================================
       CARD HEADER
    ========================================================= */

    .ad-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        min-height: 62px;
        padding: 0 24px;
        background: #ffffff;
        border-bottom: 1px solid #edf0f2;
    }

    .ad-header-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 16px;
    }

    .ad-card-header h3 {
        margin: 0;
        color: #1f2937;
        font-size: 17px;
        font-weight: 600;
    }


    /* =========================================================
       FORM BODY
    ========================================================= */

    .ad-card-body {
        padding: 28px;
    }


    /* =========================================================
       SECTION
    ========================================================= */

    .ad-section {
        margin-bottom: 30px;
    }

    .ad-section:last-child {
        margin-bottom: 0;
    }


    .ad-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f2;
        color: #1f2937;
        font-size: 15px;
        font-weight: 700;
    }

    .ad-section-title i {
        color: #1e7b67;
        font-size: 14px;
    }


    /* =========================================================
       GRID
    ========================================================= */

    .ad-form-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 20px 22px;
    }


    .ad-field {
        min-width: 0;
    }

    .ad-field.full {
        grid-column: 1 / -1;
    }


    /* =========================================================
       LABEL
    ========================================================= */

    .ad-label {
        display: block;
        margin-bottom: 7px;
        color: #344054;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #dc3545;
        margin-left: 2px;
    }


    /* =========================================================
       INPUT
    ========================================================= */

    .ad-input,
    .ad-select,
    .ad-textarea {
        width: 100%;
        height: 44px;
        padding: 0 13px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font-family: inherit;
        font-size: 13px;
        outline: none;
        transition: border-color .2s ease,
                    box-shadow .2s ease;
        box-sizing: border-box;
    }


    .ad-input:focus,
    .ad-select:focus,
    .ad-textarea:focus {
        border-color: #1e7b67;
        box-shadow: 0 0 0 3px rgba(30, 123, 103, .08);
    }


    .ad-input::placeholder,
    .ad-textarea::placeholder {
        color: #98a2b3;
    }


    .ad-select {
        cursor: pointer;
        appearance: auto;
    }


    .ad-textarea {
        height: 90px;
        padding-top: 12px;
        padding-bottom: 12px;
        resize: vertical;
    }


    /* =========================================================
       BANNER LOCATION
    ========================================================= */

    .location-select {
        font-size: 12px;
    }


    /* =========================================================
       UPLOAD AREA
    ========================================================= */

    .upload-box {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 130px;
        gap: 20px;
        align-items: stretch;
    }


    .upload-input-wrapper {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-height: 125px;
        padding: 20px;
        border: 1px dashed #b8c9c4;
        border-radius: 10px;
        background: #f8fbfa;
    }


    .upload-input-wrapper .upload-icon {
        margin-bottom: 8px;
        color: #1e7b67;
        font-size: 22px;
    }


    .upload-help {
        margin-top: 7px;
        color: #98a2b3;
        font-size: 11px;
    }


    .banner-preview {
        min-height: 125px;
        padding: 10px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border: 1px solid #e1e7e5;
        border-radius: 10px;
        background: #fafafa;
    }


    .banner-preview-title {
        margin-bottom: 8px;
        color: #667085;
        font-size: 11px;
        font-weight: 600;
    }


    .banner-preview img {
        width: 80px;
        height: 80px;
        object-fit: cover;
        border-radius: 7px;
        border: 1px solid #e5e7eb;
    }


    /* =========================================================
       AMOUNT SUMMARY
    ========================================================= */

    .amount-box {
        padding: 18px;
        border: 1px solid #dfe8e5;
        border-radius: 11px;
        background: #f8fbfa;
    }


    .amount-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px 20px;
    }


    .amount-highlight .ad-input {
        background: #ffffff;
        font-weight: 600;
    }


    /* =========================================================
       BUTTON AREA
    ========================================================= */

    .ad-form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f2;
    }


    .ad-btn {
        min-width: 120px;
        height: 43px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: none;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s ease;
    }


    .ad-btn-cancel {
        background: #f2f4f7;
        color: #475467;
        border: 1px solid #e4e7ec;
    }


    .ad-btn-cancel:hover {
        background: #e4e7ec;
        color: #344054;
    }


    .ad-btn-save {
        background: #1e7b67;
        color: #ffffff;
        box-shadow: 0 5px 12px rgba(30, 123, 103, .16);
    }


    .ad-btn-save:hover {
        background: #176653;
        color: #ffffff;
    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @@media (max-width: 1100px) {

        .ad-form-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .amount-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

    }


    @@media (max-width: 767px) {

        .ad-page {
            padding-top: 0;
        }

        .ad-page-header h2 {
            font-size: 22px;
        }

        .ad-page-header p {
            font-size: 12px;
        }

        .ad-card-header {
            padding: 0 16px;
        }

        .ad-card-body {
            padding: 20px 16px;
        }

        .ad-form-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .amount-grid {
            grid-template-columns: 1fr;
        }

        .ad-field.full {
            grid-column: auto;
        }

        .upload-box {
            grid-template-columns: 1fr;
        }

        .banner-preview {
            min-height: 150px;
        }

        

    }


    @@media (max-width: 400px) {

        .ad-card-body {
            padding: 16px 12px;
        }

        .ad-card-header h3 {
            font-size: 15px;
        }

    }

</style>


<div class="container-fluid ad-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="ad-page-header">

        <h2>
            Add Advertisement
        </h2>

        <p>
            ItNetworkZ
        </p>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="ad-card">


        <!-- CARD HEADER -->

        <div class="ad-card-header">

            <div class="ad-header-icon">
                <i class="fas fa-bullhorn"></i>
            </div>

            <h3>
                Add Advertisement
            </h3>

        </div>


        <!-- FORM -->

        <div class="ad-card-body">

            <form>


                <!-- =================================================
                     CLIENT INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-user"></i>

                        Client Information

                    </div>


                    <div class="ad-form-grid">


                        <!-- Client Name -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Client Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter client name" />

                        </div>


                        <!-- Company Name -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Company Name
                                <span class="required">*</span>
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter company name" />

                        </div>


                        <!-- Email -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Email
                                <span class="required">*</span>
                            </label>

                            <input type="email"
                                   class="ad-input"
                                   placeholder="Enter email address" />

                        </div>


                        <!-- Contact -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Contact No.
                                <span class="required">*</span>
                            </label>

                            <input type="tel"
                                   class="ad-input"
                                   placeholder="Enter contact number" />

                        </div>


                        <!-- Date of Birth -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Date of Birth
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Reference -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Reference
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Reference --
                                </option>

                                <option>
                                    Media
                                </option>

                                <option>
                                    News Paper
                                </option>

                                <option>
                                    Online Adv
                                </option>

                                <option>
                                    Referred By Friend
                                </option>

                                <option>
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Address -->

                        <div class="ad-field full">

                            <label class="ad-label">
                                Address
                                <span class="required">*</span>
                            </label>

                            <textarea class="ad-textarea"
                                      placeholder="Enter complete address"></textarea>

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     BANNER INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-image"></i>

                        Banner Information

                    </div>


                    <div class="ad-form-grid">


                        <!-- Banner Location -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Banner Location
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select location-select">

                                <option selected disabled>
                                    -- Select a Banner Location --
                                </option>

                                <option>BN-A</option>
                                <option>BN-B</option>
                                <option>BN-C</option>

                                <option>CL-A</option>
                                <option>CL-B</option>
                                <option>CL-C</option>
                                <option>CL-D</option>
                                <option>CL-E</option>
                                <option>CL-F</option>
                                <option>CL-G</option>

                                <option>CT-A</option>
                                <option>CT-B</option>
                                <option>CT-C</option>

                                <option>EC-A</option>
                                <option>EC-B</option>
                                <option>EC-C</option>

                                <option>EO-A</option>
                                <option>EO-B</option>
                                <option>EO-C</option>
                                <option>EO-D</option>
                                <option>EO-E</option>
                                <option>EO-F</option>
                                <option>EO-G</option>
                                <option>EO-H</option>
                                <option>EO-I</option>
                                <option>EO-J</option>

                                <option>ET-A</option>
                                <option>ET-B</option>
                                <option>ET-C</option>

                                <option>FAQ-A</option>
                                <option>FAQ-B</option>
                                <option>FAQ-C</option>
                                <option>FAQ-D</option>
                                <option>FAQ-E</option>
                                <option>FAQ-F</option>
                                <option>FAQ-G</option>
                                <option>FAQ-H</option>
                                <option>FAQ-I</option>
                                <option>FAQ-J</option>

                                <option>HM-A</option>

                                <option>IN-A</option>
                                <option>IN-B</option>
                                <option>IN-C</option>
                                <option>IN-D</option>

                                <option>IP-A</option>
                                <option>IP-B</option>
                                <option>IP-C</option>
                                <option>IP-D</option>
                                <option>IP-E</option>
                                <option>IP-F</option>

                                <option>IT-A</option>

                                <option>MI-A</option>
                                <option>MI-B</option>

                                <option>OB-A</option>
                                <option>OB-B</option>
                                <option>OB-C</option>
                                <option>OB-D</option>
                                <option>OB-E</option>
                                <option>OB-F</option>

                                <option>OR-A</option>
                                <option>OR-B</option>
                                <option>OR-C</option>

                                <option>SN-A</option>
                                <option>SN-B</option>

                                <option>SS-A</option>
                                <option>SS-B</option>

                                <option>TC-A</option>
                                <option>TC-B</option>
                                <option>TC-C</option>
                                <option>TC-D</option>
                                <option>TC-E</option>
                                <option>TC-F</option>
                                <option>TC-G</option>
                                <option>TC-H</option>
                                <option>TC-I</option>
                                <option>TC-J</option>
                                <option>TC-K</option>

                                <option>TF-A</option>
                                <option>TF-B</option>

                                <option>TO-A</option>
                                <option>TO-B</option>
                                <option>TO-C</option>
                                <option>TO-D</option>

                                <option>TR-A</option>
                                <option>TR-B</option>
                                <option>TR-C</option>

                            </select>

                        </div>


                        <!-- Duration -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Banner Duration
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Banner Duration --
                                </option>

                                <option>1 Month</option>
                                <option>3 Months</option>
                                <option>6 Months</option>
                                <option>9 Months</option>
                                <option>12 Months</option>

                            </select>

                        </div>


                        <!-- Start Date -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Start Date
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Till Date -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Till Date
                                <span class="required">*</span>
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Total Days -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Total No. Of Days
                                <span class="required">*</span>
                            </label>

                            <input type="number"
                                   class="ad-input"
                                   placeholder="Enter total days" />

                        </div>


                        <!-- Upload Banner -->

                        <div class="ad-field full">

                            <label class="ad-label">
                                Upload Banner
                                <span class="required">*</span>
                            </label>


                            <div class="upload-box">


                                <div class="upload-input-wrapper">

                                    <i class="fas fa-cloud-upload-alt upload-icon"></i>

                                    <input type="file"
                                           class="ad-input"
                                           accept="image/*" />

                                    <div class="upload-help">
                                        Recommended banner image format:
                                        JPG, JPEG, PNG or WEBP.
                                    </div>

                                </div>


                                <div class="banner-preview">

                                    <div class="banner-preview-title">
                                        Banner Preview
                                    </div>

                                    <img src="https://placehold.jp/100x100.png"
                                         alt="Banner Preview" />

                                </div>

                            </div>

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     PAYMENT INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-credit-card"></i>

                        Payment Information

                    </div>


                    <div class="ad-form-grid">


                        <!-- Payment Purpose -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Payment Purpose
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Payment Purpose --
                                </option>

                                <option>
                                    Adv.
                                </option>

                                <option>
                                    Donation
                                </option>

                                <option>
                                    Other
                                </option>

                            </select>

                        </div>


                        <!-- Payment Mode -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Payment Mode
                                <span class="required">*</span>
                            </label>

                            <select class="ad-select">

                                <option selected disabled>
                                    -- Select a Payment Mode --
                                </option>

                                <option>
                                    Online
                                </option>

                                <option>
                                    By Cash
                                </option>

                                <option>
                                    Cheque
                                </option>

                                <option>
                                    Draft
                                </option>

                            </select>

                        </div>


                        <!-- Cheque Draft -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Cheque / Draft No.
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter cheque / draft number" />

                        </div>


                        <!-- Bank -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Bank Name
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter bank name" />

                        </div>


                        <!-- Cheque Date -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Cheque Date
                            </label>

                            <input type="date"
                                   class="ad-input" />

                        </div>


                        <!-- Payable At -->

                        <div class="ad-field">

                            <label class="ad-label">
                                Payable At (City)
                            </label>

                            <input type="text"
                                   class="ad-input"
                                   placeholder="Enter city" />

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     AMOUNT INFORMATION
                ================================================== -->

                <div class="ad-section">

                    <div class="ad-section-title">

                        <i class="fas fa-calculator"></i>

                        Amount Details

                    </div>


                    <div class="amount-box">

                        <div class="amount-grid">


                            <!-- Actual Amount -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Actual Amount
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Actual Amount --
                                    </option>

                                    <option>1000</option>
                                    <option>2500</option>
                                    <option>5000</option>
                                    <option>10000</option>
                                    <option>25000</option>

                                </select>

                            </div>


                            <!-- Discount -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Discount %
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Discount --
                                    </option>

                                    <option>0%</option>
                                    <option>5%</option>
                                    <option>10%</option>
                                    <option>15%</option>
                                    <option>20%</option>

                                </select>

                            </div>


                            <!-- Offered -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Offered Amount
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Offered Amount --
                                    </option>

                                    <option>950</option>
                                    <option>2250</option>
                                    <option>4500</option>
                                    <option>8500</option>
                                    <option>20000</option>

                                </select>

                            </div>


                            <!-- Taxes -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Taxes %
                                    <span class="required">*</span>
                                </label>

                                <input type="number"
                                       class="ad-input"
                                       placeholder="Enter tax percentage" />

                            </div>


                            <!-- Total -->

                            <div class="ad-field amount-highlight">

                                <label class="ad-label">
                                    Total Amount
                                    <span class="required">*</span>
                                </label>

                                <select class="ad-select">

                                    <option selected disabled>
                                        -- Select Total Amount --
                                    </option>

                                    <option>950</option>
                                    <option>2250</option>
                                    <option>4500</option>
                                    <option>8500</option>
                                    <option>20000</option>

                                </select>

                            </div>


                            <!-- Paid -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Paid Amount
                                    <span class="required">*</span>
                                </label>

                                <input type="number"
                                       class="ad-input"
                                       placeholder="Enter paid amount" />

                            </div>


                            <!-- Balance -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Balance Amount
                                    <span class="required">*</span>
                                </label>

                                <input type="number"
                                       class="ad-input"
                                       placeholder="Enter balance amount" />

                            </div>


                            <!-- Installment -->

                            <div class="ad-field">

                                <label class="ad-label">
                                    Next Installment Date
                                    <span class="required">*</span>
                                </label>

                                <input type="date"
                                       class="ad-input" />

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="ad-form-actions">

                    <button type="button"
