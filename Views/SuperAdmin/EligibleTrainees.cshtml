
@model List<EligibleTraineeM>
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Eligible Trainees";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "ItNetworkZ";

    int postID = ViewBag.PostID ?? 0;
   int orgID = ViewBag.OrgID ?? 0;

   string orgCode =
       ViewBag.OrgCode?.ToString() ?? "";
}
@* @{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Eligible Trainees";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";

    int postID = ViewBag.PostID ?? 0;
    string orgCode = ViewBag.OrgCode?.ToString() ?? "";
} *@

<style>

    /* =========================================================
                   ELIGIBLE TRAINEES
                   PAGE HEADER
                ========================================================= */

    .eligible-trainees-page {
        padding-top: 20px;
        padding-bottom: 40px;
    }


    .eligible-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }


        .eligible-page-header h1 {
            margin: 0;
            color: #0f172a;
            font-size: 36px;
            line-height: 1.2;
            font-weight: 700;
        }


        .eligible-page-header p {
            margin: 10px 0 0;
            color: #64748b;
            font-size: 18px;
        }


    /* =========================================================
                   BACK BUTTON
                ========================================================= */

    .eligible-back-btn {
        width: 66px;
        height: 54px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        margin-top: 5px;
        background: #4267d9;
        color: #ffffff;
        border-radius: 8px;
        text-decoration: none;
        font-size: 20px;
        transition: all .2s ease;
    }


        .eligible-back-btn:hover {
            background: #3156c7;
            color: #ffffff;
            transform: translateY(-1px);
        }


    /* =========================================================
                   MASTER TABLE
                   Small adjustments only.
                   Main table styling comes from the existing
                   1Trainee master table CSS.
                ========================================================= */

    #eligibleTraineesTable {
        width: 100% !important;
    }


        #eligibleTraineesTable th,
        #eligibleTraineesTable td {
            vertical-align: middle;
        }


            /* =========================================================
                   COLUMN WIDTHS
                ========================================================= */

            #eligibleTraineesTable th:nth-child(1) {
                min-width: 70px;
            }

            #eligibleTraineesTable th:nth-child(2) {
                min-width: 110px;
            }

            #eligibleTraineesTable th:nth-child(3) {
                min-width: 105px;
            }

            #eligibleTraineesTable th:nth-child(4) {
                min-width: 280px;
            }

            #eligibleTraineesTable th:nth-child(5) {
                min-width: 95px;
            }

            #eligibleTraineesTable th:nth-child(6) {
                min-width: 80px;
            }

            #eligibleTraineesTable th:nth-child(7) {
                min-width: 300px;
            }

            #eligibleTraineesTable th:nth-child(8) {
                min-width: 120px;
            }

            #eligibleTraineesTable th:nth-child(9) {
                min-width: 100px;
            }

            #eligibleTraineesTable th:nth-child(10) {
                min-width: 110px;
            }

            #eligibleTraineesTable th:nth-child(11) {
                min-width: 130px;
            }

            #eligibleTraineesTable th:nth-child(12) {
                min-width: 130px;
            }


        /* =========================================================
                   RESUME BUTTON
                   Uses existing master class, with only fallback styling.
                ========================================================= */

        #eligibleTraineesTable .resume-view-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            color: #2563eb;
            text-decoration: none;
            font-size: 17px;
        }


            #eligibleTraineesTable .resume-view-btn:hover {
                color: #1d4ed8;
            }


    /* =========================================================
                   RESPONSIVE
                ========================================================= */

    @@media (max-width: 768px) {

        .eligible-page-header h1 {
            font-size: 28px;
        }

        .eligible-page-header p {
            font-size: 15px;
        }

        .eligible-back-btn {
            width: 54px;
            height: 48px;
            font-size: 18px;
        }
    }


    @@media (max-width: 480px) {

        .eligible-page-header {
            margin-bottom: 20px;
        }

            .eligible-page-header h1 {
                font-size: 24px;
            }

            .eligible-page-header p {
                font-size: 14px;
            }

        .eligible-back-btn {
            width: 45px;
            height: 42px;
            font-size: 16px;
        }
    }

</style>

<div class="container-fluid eligible-trainees-page">

    <!-- =====================================================
         PAGE HEADER
    ===================================================== -->

    <div class="eligible-page-header">

        <div>
            <h1>Eligible Trainees</h1>

            <p>
                @orgCode
            </p>
        </div>

        <!-- Back -->
        <a asp-controller="Organization"
           asp-action="Dashboard"
           class="master-back-btn"
           title="Back to Dashboard">
            <i class="fas fa-arrow-left"></i>
        </a>

    </div>


    <!-- =====================================================
         MASTER TABLE
    ===================================================== -->

    <div class="master-table-container">

        <!-- Master Table Header -->

        <div class="master-table-title">

            <div>

                <h2>
                    <i class="fas fa-table me-2"></i>
                    Eligible Trainees
                </h2>

            </div>

        </div>


        <!-- Table -->

        <div class="table-responsive">

            <table id="eligibleTraineesTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>Sr. No</th>

                        <th>Name</th>

                        <th>View Resume</th>

                        <th>Email</th>

                        <th>Gender</th>

                        <th>DOB</th>

                        <th>Skills</th>

                        <th>Apply Status</th>

                        <th>Status</th>

                        <th>Final Result</th>

                        <th>Comment</th>

                        <th>Update Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        int srNo = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Sr. No -->
                                <td class="master-id">
                                    @srNo
                                </td>

                                <!-- Name -->
                                <td>
                                    @item.Name
                                </td>

                                <!-- Resume -->
                                <td>
                                        <a asp-controller="SuperAdmin"
                                           asp-action="ViewTraineeResume"
                                           asp-route-id="@item.CandidateID"
                                           class="resume-view-btn"
                                           title="View Resume">

                                            <i class="fas fa-eye"></i>

                                        </a>
                                </td>

                                <!-- Email -->
                                <td>
                                    @item.EmailID
                                </td>

                                <!-- Gender -->
                                <td>
                                    @item.Gender
                                </td>

                                <!-- DOB -->
                                <td>
                                    @(item.DateOfBirth.HasValue
                                                                ? item.DateOfBirth.Value.ToString("dd-MM-yyyy")
                                                                : "")
                                </td>

                                <!-- Skills -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.MedicalSkillNames))
                                    {
                                        <strong>Medical:</strong>
                                        @item.MedicalSkillNames
                                        <br />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.TechnicalSkillNames))
                                    {
                                        <strong>Technical:</strong>
                                        @item.TechnicalSkillNames
                                        <br />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.NonTechnicalSkillNames))
                                    {
                                        <strong>Non-Technical:</strong>
                                        @item.NonTechnicalSkillNames
                                    }

                                </td>

                                <!-- Apply Status -->
                                <td>
                                    @if (item.CApply.HasValue)
                                    {
                                        @(item.CApply.Value == 1 ? "Applied" : "Yet To Apply")
                                    }
                                    else
                                    {
                                        <span>Yet To Applied</span>
                                    }
                                </td>

                                <!-- Status -->
                                <td>
                                    @item.Status
                                </td>

                                <!-- Final Result -->
                                <td>
                                    @item.FinalStatus
                                </td>

                                <!-- Comment -->
                                <td>
                                    @item.Comment
                                </td>

                                <!-- Update Status -->
                                <td>
                                    <!-- Your status update button/action can be added here -->
                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="12" class="text-center">
                                No eligible trainees found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


