@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Super Admin Dashboard";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}


<style>

    /* =========================================================
       SUPER ADMIN DASHBOARD
    ========================================================= */

    .superadmin-dashboard {
        width: 100%;
        padding: 5px 0;
        color: #344054;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .sa-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
    }

    .sa-header-left h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: #1f2937;
    }

    .sa-header-left p {
        margin: 5px 0 0;
        color: #98a2b3;
        font-size: 13px;
    }

    .sa-header-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 30px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 11px;
        font-weight: 700;
    }

    .sa-header-badge span {
        width: 7px;
        height: 7px;
        background: #1e7b67;
        border-radius: 50%;
    }


    /* =========================================================
       CARD GRID
    ========================================================= */

    .sa-card-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }


    /* =========================================================
       CARD
    ========================================================= */

    .sa-card {
        position: relative;
        min-width: 0;
        height: 170px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #edf0f2;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
        overflow: hidden;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .sa-card:hover {
        transform: translateY(-4px);
        border-color: #d4e8e2;
        box-shadow: 0 12px 30px rgba(30, 123, 103, 0.10);
    }

    .sa-card::after {
        content: "";
        position: absolute;
        width: 90px;
        height: 90px;
        right: -38px;
        bottom: -38px;
        border-radius: 50%;
        background: #f6faf8;
        pointer-events: none;
    }


    /* =========================================================
       CARD TOP
    ========================================================= */

    .sa-card-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }


    /* =========================================================
       ICON
    ========================================================= */

    .sa-card-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 17px;
    }


    /* =========================================================
       ICON COLORS
    ========================================================= */

    .icon-green {
        background: #e8f5f1;
        color: #1e7b67;
    }

    .icon-purple {
        background: #f2edff;
        color: #7655c9;
    }

    .icon-blue {
        background: #edf5ff;
        color: #3978c8;
    }

    .icon-cyan {
        background: #e7f7fb;
        color: #0891b2;
    }

    .icon-orange {
        background: #fff3e8;
        color: #d77b2b;
    }

    .icon-pink {
        background: #fff0f7;
        color: #d9468b;
    }

    .icon-indigo {
        background: #eef2ff;
        color: #4f46e5;
    }

    .icon-violet {
        background: #f3eefe;
        color: #7c3aed;
    }


    /* =========================================================
       CARD BADGE
    ========================================================= */

    .sa-card-badge {
        position: relative;
        z-index: 2;
        padding: 4px 8px;
        border-radius: 20px;
        background: #f5f7f8;
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .sa-card-badge.active {
        background: #e8f7f2;
        color: #1e7b67;
    }


    /* =========================================================
       TITLE
    ========================================================= */

    .sa-card-title {
        position: relative;
        z-index: 2;
        margin-top: 14px;
        color: #667085;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.3;
    }


    /* =========================================================
       NUMBER
    ========================================================= */

    .sa-card-number {
        position: relative;
        z-index: 2;
        margin-top: 3px;
        color: #1f2937;
        font-size: 27px;
        font-weight: 700;
        line-height: 1.1;
    }


    /* =========================================================
       CARD FOOTER
    ========================================================= */

    .sa-card-footer {
        position: relative;
        z-index: 2;
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .sa-card-info {
        color: #98a2b3;
        font-size: 10px;
    }


    /* =========================================================
       VIEW BUTTON
    ========================================================= */

    .sa-view-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #e8f5f1;
        color: #1e7b67;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        transition: all .2s ease;
    }

    .sa-view-btn:hover {
        background: #1e7b67;
        color: #ffffff;
        text-decoration: none;
    }

    .sa-view-btn i {
        font-size: 9px;
    }


   
 /* =====================================================
   1TRAINEE MONTHLY ANALYTICS @* Radhika29-09 *@
===================================================== */

.analytics-card {
    background: #ffffff;
    border: 1px solid #dfe5e8;
    border-radius: 14px;
    overflow: hidden;
    height: 100%;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
    transition: all .25s ease;
}

.analytics-card:hover {
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
}

/* Chart Header */
.analytics-header {
    min-height: 52px;
    padding: 0 18px;
    display: flex;
    align-items: center;
    gap: 11px;
    border-bottom: 1px solid #dfe5e8;
    background: #ffffff;
}

.analytics-header-icon {
    width: 25px;
    height: 25px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #1e7b67;
    font-size: 17px;
}

.analytics-header h5 {
    margin: 0;
    color: #16324f;
    font-size: 17px;
    font-weight: 500;
    letter-spacing: .1px;
}

/* Chart Body */
.analytics-body {
    padding: 18px 16px 14px;
}

.chart-wrapper {
    position: relative;
    width: 100%;
    height: 235px;
}

.chart-wrapper svg {
    width: 100%;
    height: 100%;
    display: block;
}

/* Legend */
.chart-legend {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    color: #667085;
    font-size: 12px;
}

.legend-box {
    width: 50px;
    height: 16px;
    border: 2px solid #1e7b67;
    background: rgba(30, 123, 103, .14);
}

.legend-box-bar {
    width: 50px;
    height: 16px;
    background: #1e7b67;
}

/* Axis text */
.chart-axis-text {
    fill: #667085;
    font-size: 11px;
    font-family: Arial, sans-serif;
}

/* Grid */
.chart-grid {
    stroke: #e6eaed;
    stroke-width: 1;
}

.chart-axis {
    stroke: #cfd6da;
    stroke-width: 1;
}

/* Line chart */
.chart-line {
    fill: none;
    stroke: #1e7b67;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.chart-area {
    fill: rgba(30, 123, 103, .14);
}

.chart-point {
    fill: #ffffff;
    stroke: #1e7b67;
    stroke-width: 2;
}

/* Bar chart */
.chart-bar {
    fill: #1e7b67;
    transition: opacity .2s ease;
}

.chart-bar:hover {
    opacity: .78;
}

/* Current value */
.analytics-value {
    text-align: center;
    margin-top: 5px;
    color: #667085;
    font-size: 11px;
}

/* Footer */
.analytics-footer {
    border-top: 1px solid #edf0f2;
    padding: 10px 16px;
    color: #7a8494;
    font-size: 11px;
}

.analytics-footer i {
    color: #1e7b67;
    margin-right: 5px;
}

@@media (max-width: 767px) {

    .analytics-header {
        min-height: 48px;
        padding: 0 14px;
    }

    .analytics-header h5 {
        font-size: 15px;
    }

    .analytics-body {
        padding: 15px 10px 10px;
    }

    .chart-wrapper {
        height: 210px;
    }

    .chart-axis-text {
        font-size: 9px;
    }
}

    /* =========================================================
       TABLET
    ========================================================= */

    @@media (max-width: 1100px) {

        .sa-card-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sa-chart-row {
            grid-template-columns: 1fr;
            gap: 20px;
        }

    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @@media (max-width: 767px) {

        .sa-header {
            align-items: flex-start;
            gap: 12px;
        }

        .sa-header-left h2 {
            font-size: 22px;
        }

        .sa-header-left p {
            font-size: 12px;
        }

        .sa-header-badge {
            display: none;
        }


        /* Cards */

        .sa-card-row {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .sa-card {
            height: 165px;
        }


        /* Charts */

        .sa-chart-row {
            margin-top: 20px;
        }

        .sa-chart-card {
            height: 350px;

            padding: 23px 20px 18px;

            border-radius: 20px;
        }

        .sa-chart-title {
            font-size: 14px;
        }

        .sa-chart-number {
            font-size: 34px;
        }

        .sa-chart-icon {
            width: 48px;
            height: 48px;

            border-radius: 13px;

            font-size: 18px;
        }

        .sa-chart-area {
            height: 140px;
        }

        .sa-chart-area canvas {
            height: 140px !important;
        }

        .sa-chart-footer {
            font-size: 12px;
        }

    }


    /* =========================================================
       SMALL MOBILE
    ========================================================= */

    @@media (max-width: 400px) {

        .sa-card {
            height: 160px;
            padding: 16px;
        }

        .sa-card-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
        }

        .sa-card-number {
            font-size: 25px;
        }


        .sa-chart-card {
            height: 340px;

            padding: 20px 16px;
        }

        .sa-chart-number {
            font-size: 31px;
        }

        .sa-chart-icon {
            width: 44px;
            height: 44px;

            font-size: 16px;
        }

    }

</style>


