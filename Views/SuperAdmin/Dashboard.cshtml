<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    /* =====================================================
       MONTHS
    ===================================================== */

    const months = [
        "Jan'24",
        "Feb'24",
        "Mar'24",
        "Apr'24",
        "May'24",
        "June'24",
        "July'24",
        "Aug'24",
        "Sept'24",
        "Oct'24",
        "Nov'24",
        "Dec'24"
    ];


    /* =====================================================
       TRAINEE REGISTERED DATA
       
       Replace with your actual monthly values.
    ===================================================== */

    const traineeRegisteredData = [
        390,
        275,
        145,
        150,
        460,
        220,
        120,
        400,
        250,
        390,
        100,
        40
    ];


    /* =====================================================
       ORGANIZATION INTERNSHIP POST DATA
       
       Replace with your actual monthly values.
    ===================================================== */

    const organizationPostData = [
        20,
        2,
        2,
        62,
        52,
        2,
        15,
        14,
        70,
        1,
        1,
        0
    ];


    /* =====================================================
       CHART AREA
    ===================================================== */

    const left = 65;
    const right = 735;

    const top = 25;
    const bottom = 250;

    const width = right - left;
    const height = bottom - top;

    const gap = width / 11;


    /* =====================================================
       LEFT CHART
       TRAINEE REGISTERED
    ===================================================== */

    const traineeMax = 500;

    const traineePoints = [];


    traineeRegisteredData.forEach(function (value, index) {

        const x =
            left + (index * gap);

        const y =
            bottom -
            ((value / traineeMax) * height);

        traineePoints.push(
            `${x},${y}`
        );

    });


    /* =====================================================
       AREA
    ===================================================== */

    const traineeArea =
        document.getElementById(
            "yearlyTraineeArea"
        );


    if (traineeArea) {

        traineeArea.setAttribute(
            "points",

            `${left},${bottom} ` +
            traineePoints.join(" ") +
            ` ${right},${bottom}`
        );

    }


    /* =====================================================
       LINE
    ===================================================== */

    const traineeLine =
        document.getElementById(
            "yearlyTraineeLine"
        );


    if (traineeLine) {

        traineeLine.setAttribute(
            "points",
            traineePoints.join(" ")
        );

    }


    /* =====================================================
       POINTS
    ===================================================== */

    const traineePointGroup =
        document.getElementById(
            "yearlyTraineePoints"
        );


    traineeRegisteredData.forEach(
        function (value, index) {

            const x =
                left + (index * gap);

            const y =
                bottom -
                ((value / traineeMax) * height);


            const circle =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "circle"
                );


            circle.setAttribute(
                "cx",
                x
            );

            circle.setAttribute(
                "cy",
                y
            );

            circle.setAttribute(
                "r",
                "4"
            );

            circle.setAttribute(
                "class",
                "chart-point"
            );


            traineePointGroup.appendChild(
                circle
            );

        }
    );


    /* =====================================================
       LEFT MONTH LABELS
    ===================================================== */

    const traineeMonths =
        document.getElementById(
            "yearlyTraineeMonths"
        );


    months.forEach(function (month, index) {

        const x =
            left + (index * gap);


        const text =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "text"
            );


        text.setAttribute(
            "x",
            x
        );

        text.setAttribute(
            "y",
            bottom + 20
        );

        text.setAttribute(
            "text-anchor",
            "middle"
        );

        text.setAttribute(
            "class",
            "chart-axis-text"
        );


        text.textContent = month;


        traineeMonths.appendChild(
            text
        );

    });


    /* =====================================================
       LEFT VERTICAL GRID
    ===================================================== */

    const traineeGrid =
        document.getElementById(
            "yearlyVerticalGrid"
        );


    months.forEach(function (_, index) {

        const x =
            left + (index * gap);


        const line =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "line"
            );


        line.setAttribute(
            "x1",
            x
        );

        line.setAttribute(
            "y1",
            top
        );

        line.setAttribute(
            "x2",
            x
        );

        line.setAttribute(
            "y2",
            bottom
        );

        line.setAttribute(
            "class",
            "chart-grid"
        );


        traineeGrid.appendChild(
            line
        );

    });


    /* =====================================================
       RIGHT CHART
       ORGANIZATION POSTS
    ===================================================== */

    const postMax = 70;

    const postBars =
        document.getElementById(
            "organizationPostBars"
        );


    const barWidth = 32;


    organizationPostData.forEach(
        function (value, index) {

            const x =
                left +
                (index * gap) -
                (barWidth / 2);


            const barHeight =
                (value / postMax) *
                height;


            const y =
                bottom - barHeight;


            const rect =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "rect"
                );


            rect.setAttribute(
                "x",
                x
            );

            rect.setAttribute(
                "y",
                y
            );

            rect.setAttribute(
                "width",
                barWidth
            );

            rect.setAttribute(
                "height",
                barHeight
            );

            rect.setAttribute(
                "class",
                "chart-bar"
            );


            postBars.appendChild(
                rect
            );

        }
    );


    /* =====================================================
       RIGHT MONTH LABELS
    ===================================================== */

    const postMonths =
        document.getElementById(
            "organizationPostMonths"
        );


    months.forEach(function (month, index) {

        const x =
            left + (index * gap);


        const text =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "text"
            );


        text.setAttribute(
            "x",
            x
        );

        text.setAttribute(
            "y",
            bottom + 20
        );

        text.setAttribute(
            "text-anchor",
            "middle"
        );

        text.setAttribute(
            "class",
            "chart-axis-text"
        );


        text.textContent = month;


        postMonths.appendChild(
            text
        );

    });


    /* =====================================================
       RIGHT VERTICAL GRID
    ===================================================== */

    const postGrid =
        document.getElementById(
            "organizationVerticalGrid"
        );


    months.forEach(function (_, index) {

        const x =
            left + (index * gap);


        const line =
            document.createElementNS(
                "http://www.w3.org/2000/svg",
                "line"
            );


        line.setAttribute(
            "x1",
            x
        );

        line.setAttribute(
            "y1",
            top
        );

        line.setAttribute(
            "x2",
            x
        );

        line.setAttribute(
            "y2",
            bottom
        );

        line.setAttribute(
            "class",
            "chart-grid"
        );


        postGrid.appendChild(
            line
        );

    });

});

</script>