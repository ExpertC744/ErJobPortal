@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Super Admin Dashboard";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}


<style>

    /* =========================================================
       SUPER ADMIN DASHBOARD
    ========================================================= */

    .superadmin-dashboard {
        width: 100%;
        padding: 5px 0;
        color: #344054;
    }


    /* =========================================================
       HEADER
    ========================================================= */

    .sa-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 22px;
    }

    .sa-header-left h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        color: #1f2937;
    }

    .sa-header-left p {
        margin: 5px 0 0;
        color: #98a2b3;
        font-size: 13px;
    }

    .sa-header-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        border-radius: 30px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 11px;
        font-weight: 700;
    }

    .sa-header-badge span {
        width: 7px;
        height: 7px;
        background: #1e7b67;
        border-radius: 50%;
    }


    /* =========================================================
       CARD GRID
    ========================================================= */

    .sa-card-row {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }


    /* =========================================================
       CARD
    ========================================================= */

    .sa-card {
        position: relative;
        min-width: 0;
        height: 170px;
        padding: 18px;
        background: #ffffff;
        border: 1px solid #edf0f2;
        border-radius: 15px;
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.035);
        overflow: hidden;
        transition: all 0.25s ease;
        display: flex;
        flex-direction: column;
    }

    .sa-card:hover {
        transform: translateY(-4px);
        border-color: #d4e8e2;
        box-shadow: 0 12px 30px rgba(30, 123, 103, 0.10);
    }

    .sa-card::after {
        content: "";
        position: absolute;
        width: 90px;
        height: 90px;
        right: -38px;
        bottom: -38px;
        border-radius: 50%;
        background: #f6faf8;
        pointer-events: none;
    }


    /* =========================================================
       CARD TOP
    ========================================================= */

    .sa-card-top {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }


    /* =========================================================
       ICON
    ========================================================= */

    .sa-card-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        font-size: 17px;
    }


    /* =========================================================
       ICON COLORS
    ========================================================= */

    .icon-green {
        background: #e8f5f1;
        color: #1e7b67;
    }

    .icon-purple {
        background: #f2edff;
        color: #7655c9;
    }

    .icon-blue {
        background: #edf5ff;
        color: #3978c8;
    }

    .icon-cyan {
        background: #e7f7fb;
        color: #0891b2;
    }

    .icon-orange {
        background: #fff3e8;
        color: #d77b2b;
    }

    .icon-pink {
        background: #fff0f7;
        color: #d9468b;
    }

    .icon-indigo {
        background: #eef2ff;
        color: #4f46e5;
    }

    .icon-violet {
        background: #f3eefe;
        color: #7c3aed;
    }


    /* =========================================================
       CARD BADGE
    ========================================================= */

    .sa-card-badge {
        position: relative;
        z-index: 2;
        padding: 4px 8px;
        border-radius: 20px;
        background: #f5f7f8;
        color: #98a2b3;
        font-size: 9px;
        font-weight: 700;
        white-space: nowrap;
    }

    .sa-card-badge.active {
        background: #e8f7f2;
        color: #1e7b67;
    }


    /* =========================================================
       TITLE
    ========================================================= */

    .sa-card-title {
        position: relative;
        z-index: 2;
        margin-top: 14px;
        color: #667085;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.3;
    }


    /* =========================================================
       NUMBER
    ========================================================= */

    .sa-card-number {
        position: relative;
        z-index: 2;
        margin-top: 3px;
        color: #1f2937;
        font-size: 27px;
        font-weight: 700;
        line-height: 1.1;
    }


    /* =========================================================
       CARD FOOTER
    ========================================================= */

    .sa-card-footer {
        position: relative;
        z-index: 2;
        margin-top: auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .sa-card-info {
        color: #98a2b3;
        font-size: 10px;
    }


    /* =========================================================
       VIEW BUTTON
    ========================================================= */

    .sa-view-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #e8f5f1;
        color: #1e7b67;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        transition: all .2s ease;
    }

    .sa-view-btn:hover {
        background: #1e7b67;
        color: #ffffff;
        text-decoration: none;
    }

    .sa-view-btn i {
        font-size: 9px;
    }


    /* =========================================================
       =========================================================
       CHART SECTION
       =========================================================
       ========================================================= */

    .sa-chart-row {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 30px;
        margin-top: 28px;
        margin-bottom: 25px;
    }


    /* =========================================================
       CHART CARD
    ========================================================= */

    .sa-chart-card {
        position: relative;
        min-width: 0;

        height: 370px;

        padding: 28px 30px 20px;

        background: #ffffff;

        border: 1px solid #edf0f2;

        border-radius: 24px;

        box-shadow: 0 6px 24px rgba(15, 23, 42, 0.045);

        overflow: hidden;

        transition: all 0.25s ease;
    }

    .sa-chart-card:hover {
        border-color: #d4e8e2;
        box-shadow: 0 12px 30px rgba(30, 123, 103, 0.08);
    }


    /* =========================================================
       CHART TOP
    ========================================================= */

    .sa-chart-top {
        position: relative;
        z-index: 2;

        display: flex;
        align-items: flex-start;
        justify-content: space-between;

        min-height: 100px;
    }


    /* =========================================================
       CHART TITLE
    ========================================================= */

    .sa-chart-title {
        color: #667085;

        font-size: 15px;

        font-weight: 500;

        line-height: 1.4;
    }


    /* =========================================================
       CHART NUMBER
    ========================================================= */

    .sa-chart-number {
        margin-top: 8px;

        color: #172b4d;

        font-size: 38px;

        font-weight: 700;

        line-height: 1;
    }


    /* =========================================================
       CHART PERIOD
    ========================================================= */

    .sa-chart-period {
        margin-top: 9px;

        color: #98a2b3;

        font-size: 12px;

        font-weight: 400;
    }


    /* =========================================================
       CHART ICON
    ========================================================= */

    .sa-chart-icon {
        width: 54px;
        height: 54px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 15px;

        background: #e8f5f1;

        color: #1e7b67;

        font-size: 20px;
    }


    /* =========================================================
       CHART AREA
    ========================================================= */

    .sa-chart-area {
        position: relative;

        width: 100%;

        height: 150px;

        margin-top: 5px;
    }

    .sa-chart-area canvas {
        width: 100% !important;
        height: 150px !important;
    }


    /* =========================================================
       CHART FOOTER
    ========================================================= */

    .sa-chart-footer {
        display: flex;

        align-items: center;

        gap: 9px;

        margin-top: 15px;

        color: #667085;

        font-size: 13px;
    }

    .sa-chart-footer i {
        color: #1e7b67;

        font-size: 14px;
    }


    /* =========================================================
       TABLET
    ========================================================= */

    @@media (max-width: 1100px) {

        .sa-card-row {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sa-chart-row {
            grid-template-columns: 1fr;
            gap: 20px;
        }

    }


    /* =========================================================
       MOBILE
    ========================================================= */

    @@media (max-width: 767px) {

        .sa-header {
            align-items: flex-start;
            gap: 12px;
        }

        .sa-header-left h2 {
            font-size: 22px;
        }

        .sa-header-left p {
            font-size: 12px;
        }

        .sa-header-badge {
            display: none;
        }


        /* Cards */

        .sa-card-row {
            grid-template-columns: 1fr;
            gap: 14px;
        }

        .sa-card {
            height: 165px;
        }


        /* Charts */

        .sa-chart-row {
            margin-top: 20px;
        }

        .sa-chart-card {
            height: 350px;

            padding: 23px 20px 18px;

            border-radius: 20px;
        }

        .sa-chart-title {
            font-size: 14px;
        }

        .sa-chart-number {
            font-size: 34px;
        }

        .sa-chart-icon {
            width: 48px;
            height: 48px;

            border-radius: 13px;

            font-size: 18px;
        }

        .sa-chart-area {
            height: 140px;
        }

        .sa-chart-area canvas {
            height: 140px !important;
        }

        .sa-chart-footer {
            font-size: 12px;
        }

    }


    /* =========================================================
       SMALL MOBILE
    ========================================================= */

    @@media (max-width: 400px) {

        .sa-card {
            height: 160px;
            padding: 16px;
        }

        .sa-card-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
        }

        .sa-card-number {
            font-size: 25px;
        }


        .sa-chart-card {
            height: 340px;

            padding: 20px 16px;
        }

        .sa-chart-number {
            font-size: 31px;
        }

        .sa-chart-icon {
            width: 44px;
            height: 44px;

            font-size: 16px;
        }

    }

</style>


<!-- =========================================================
     SUPER ADMIN DASHBOARD
========================================================= -->

<div class="container-fluid superadmin-dashboard">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="sa-header">

        <div class="sa-header-left">

            <h2>
                Super Admin Dashboard
            </h2>

        </div>

    </div>


    <!-- =====================================================
         DASHBOARD CARDS
    ====================================================== -->

    <div class="sa-card-row">


        <!-- =================================================
             TRAINEE REGISTRATION
        ================================================== -->

        <div class="sa-card card-trainee">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-green">

                    <i class="fas fa-user-plus"></i>

                </div>

                <div class="sa-card-badge active">
                    ACTIVE
                </div>

            </div>

            <div class="sa-card-title">
                Trainee Registration
            </div>

            <div class="sa-card-number">
                @ViewBag.TraineeRegistrationCount
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Registered trainees
                </span>

                <a asp-controller="SuperAdmin"
                   asp-action="SATrainees"
                   asp-route-id="1"
                   class="sa-view-btn">

                    View

                    <i class="fas fa-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- =================================================
             TRAINEE PROFILE
        ================================================== -->

        <div class="sa-card card-profile">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-purple">

                    <i class="fas fa-id-card"></i>

                </div>

                <div class="sa-card-badge">
                    PROFILE
                </div>

            </div>

            <div class="sa-card-title">
                Trainee Profiles
            </div>

            <div class="sa-card-number">
                500
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Total profiles
                </span>

            </div>

        </div>


        <!-- =================================================
             ORGANIZATION REGISTRATION
        ================================================== -->

        <div class="sa-card card-organization">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-blue">

                    <i class="fas fa-building"></i>

                </div>

                <div class="sa-card-badge active">
                    ACTIVE
                </div>

            </div>

            <div class="sa-card-title">
                Organization Registration
            </div>

            <div class="sa-card-number">
                @ViewBag.OrganizationRegistrationCount
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Registered organizations
                </span>

                <a asp-controller="SuperAdmin"
                   asp-action="SAOrganizations"
                   asp-route-id="1"
                   class="sa-view-btn">

                    View

                    <i class="fas fa-arrow-right"></i>

                </a>

            </div>

        </div>


        <!-- =================================================
             ORGANIZATION PROFILE
        ================================================== -->

        <div class="sa-card card-org-profile">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-cyan">

                    <i class="fas fa-city"></i>

                </div>

                <div class="sa-card-badge">
                    PROFILE
                </div>

            </div>

            <div class="sa-card-title">
                Organization Profile
            </div>

            <div class="sa-card-number">
                250
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Total profiles
                </span>

            </div>

        </div>


        <!-- =================================================
             OBJECTIVES
        ================================================== -->

        <div class="sa-card card-objective">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-orange">

                    <i class="fas fa-bullseye"></i>

                </div>

                <div class="sa-card-badge">
                    TOTAL
                </div>

            </div>

            <div class="sa-card-title">
                Objectives
            </div>

            <div class="sa-card-number">
                1800
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Platform objectives
                </span>

            </div>

        </div>


        <!-- =================================================
             ADVERTISEMENT
        ================================================== -->

        <div class="sa-card card-advertisement">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-pink">

                    <i class="fas fa-bullhorn"></i>

                </div>

                <div class="sa-card-badge">
                    TOTAL
                </div>

            </div>

            <div class="sa-card-title">
                Advertisement
            </div>

            <div class="sa-card-number">
                1800
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Active advertisements
                </span>

            </div>

        </div>


        <!-- =================================================
             TOP SEARCH
        ================================================== -->

        <div class="sa-card card-search">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-indigo">

                    <i class="fas fa-search"></i>

                </div>

                <div class="sa-card-badge">
                    TOTAL
                </div>

            </div>

            <div class="sa-card-title">
                Top Search
            </div>

            <div class="sa-card-number">
                1800
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    Search activities
                </span>

            </div>

        </div>


        <!-- =================================================
             FEEDBACK
        ================================================== -->

        <div class="sa-card card-feedback">

            <div class="sa-card-top">

                <div class="sa-card-icon icon-violet">

                    <i class="fas fa-comments"></i>

                </div>

                <div class="sa-card-badge">
                    TOTAL
                </div>

            </div>

            <div class="sa-card-title">
                Feedback
            </div>

            <div class="sa-card-number">
                1800
            </div>

            <div class="sa-card-footer">

                <span class="sa-card-info">
                    User feedback
                </span>

            </div>

        </div>


    </div>


    <!-- =========================================================
         CHARTS BELOW DASHBOARD CARDS
    ========================================================== -->

    <div class="sa-chart-row">


        <!-- =====================================================
             TRAINEE REGISTERED CHART
        ====================================================== -->

        <div class="sa-chart-card">

            <div class="sa-chart-top">

                <div>

                    <div class="sa-chart-title">
                        No. of Trainee registered in one year
                    </div>

                    <div class="sa-chart-number">
                        103
                    </div>

                    <div class="sa-chart-period">
                        Current month
                    </div>

                </div>


                <div class="sa-chart-icon">

                    <i class="fas fa-user-graduate"></i>

                </div>

            </div>


            <div class="sa-chart-area">

                <canvas id="traineeRegistrationChart"></canvas>

            </div>


            <div class="sa-chart-footer">

                <i class="fas fa-chart-line"></i>

                <span>
                    Monthly trainee registration trend
                </span>

            </div>

        </div>


        <!-- =====================================================
             INTERNSHIP POST CHART
        ====================================================== -->

        <div class="sa-chart-card">

            <div class="sa-chart-top">

                <div>

                    <div class="sa-chart-title">
                        Internship post from Organization
                    </div>

                    <div class="sa-chart-number">
                        154
                    </div>

                    <div class="sa-chart-period">
                        Current month
                    </div>

                </div>


                <div class="sa-chart-icon">

                    <i class="fas fa-building"></i>

                </div>

            </div>


            <div class="sa-chart-area">

                <canvas id="internshipPostChart"></canvas>

            </div>


            <div class="sa-chart-footer">

                <i class="fas fa-chart-line"></i>

                <span>
                    Monthly organization internship trend
                </span>

            </div>

        </div>


    </div>


</div>


<!-- =========================================================
     CHART.JS
========================================================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    /* =========================================================
       MONTHS
    ========================================================= */

    const saMonths = [

        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"

    ];


    /* =========================================================
       TRAINEE REGISTRATION CHART
    ========================================================= */

    const traineeCtx =
        document.getElementById("traineeRegistrationChart");


    const traineeGradient =
        traineeCtx
            .getContext("2d")
            .createLinearGradient(0, 0, 0, 150);


    traineeGradient.addColorStop(
        0,
        "rgba(30, 123, 103, 0.18)"
    );


    traineeGradient.addColorStop(
        1,
        "rgba(30, 123, 103, 0.01)"
    );


    new Chart(traineeCtx, {

        type: "line",

        data: {

            labels: saMonths,

            datasets: [

                {

                    label: "No. of Trainee registered",

                    data: [

                        42,
                        55,
                        48,
                        68,
                        74,
                        61,
                        82,
                        94,
                        88,
                        108,
                        101,
                        121

                    ],

                    borderColor: "#1e7b67",

                    backgroundColor: traineeGradient,

                    borderWidth: 3,

                    fill: true,

                    tension: 0.25,

                    pointRadius: function (context) {

                        return context.dataIndex === 11
                            ? 5
                            : 0;

                    },

                    pointHoverRadius: 5,

                    pointBackgroundColor: "#ffffff",

                    pointBorderColor: "#1e7b67",

                    pointBorderWidth: 3

                }

            ]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {

                    display: false

                },

                tooltip: {

                    backgroundColor: "#172b4d",

                    titleFont: {
                        size: 12
                    },

                    bodyFont: {
                        size: 12
                    },

                    padding: 9,

                    displayColors: false

                }

            },

            scales: {

                x: {

                    grid: {

                        display: false

                    },

                    border: {

                        display: false

                    },

                    ticks: {

                        color: "#98a2b3",

                        font: {

                            size: 10

                        },

                        padding: 8

                    }

                },

                y: {

                    display: false,

                    beginAtZero: false,

                    grid: {

                        display: false

                    }

                }

            }

        }

    });


    /* =========================================================
       INTERNSHIP POST CHART
    ========================================================= */

    const internshipCtx =
        document.getElementById("internshipPostChart");


    const internshipGradient =
        internshipCtx
            .getContext("2d")
            .createLinearGradient(0, 0, 0, 150);


    internshipGradient.addColorStop(
        0,
        "rgba(30, 123, 103, 0.18)"
    );


    internshipGradient.addColorStop(
        1,
        "rgba(30, 123, 103, 0.01)"
    );


    new Chart(internshipCtx, {

        type: "line",

        data: {

            labels: saMonths,

            datasets: [

                {

                    label: "Internship post from Organization",

                    data: [

                        38,
                        52,
                        43,
                        62,
                        74,
                        66,
                        88,
                        99,
                        83,
                        106,
                        95,
                        121

                    ],

                    borderColor: "#1e7b67",

                    backgroundColor: internshipGradient,

                    borderWidth: 3,

                    fill: true,

                    tension: 0.25,

                    pointRadius: function (context) {

                        return context.dataIndex === 11
                            ? 5
                            : 0;

                    },

                    pointHoverRadius: 5,

                    pointBackgroundColor: "#ffffff",

                    pointBorderColor: "#1e7b67",

                    pointBorderWidth: 3

                }

            ]

        },

        options: {

            responsive: true,

            maintainAspectRatio: false,

            plugins: {

                legend: {

                    display: false

                },

                tooltip: {

                    backgroundColor: "#172b4d",

                    titleFont: {

                        size: 12

                    },

                    bodyFont: {

                        size: 12

                    },

                    padding: 9,

                    displayColors: false

                }

            },

            scales: {

                x: {

                    grid: {

                        display: false

                    },

                    border: {

                        display: false

                    },

                    ticks: {

                        color: "#98a2b3",

                        font: {

                            size: 10

                        },

                        padding: 8

                    }

                },

                y: {

                    display: false,

                    beginAtZero: false,

                    grid: {

                        display: false

                    }

                }

            }

        }

    });

</script>