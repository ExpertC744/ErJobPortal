@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Installment";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

<style>

    /* =========================================================
       ADD INSTALLMENT - 1TRAINEE DESIGN
    ========================================================= */

    .installment-page {
        width: 100%;
        padding: 5px 0 35px;
        color: #344054;
    }

    /* =========================================================
       PAGE HEADER
    ========================================================= */

    .installment-page-header {
        margin-bottom: 22px;
    }

    .installment-page-header h2 {
        margin: 0;
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
    }

    .installment-page-header p {
        margin: 5px 0 0;
        color: #98a2b3;
        font-size: 13px;
    }

    /* =========================================================
       MAIN CARD
    ========================================================= */

    .installment-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, .035);
        overflow: hidden;
    }

    /* =========================================================
       CARD HEADER
    ========================================================= */

    .installment-card-header {
        min-height: 64px;
        padding: 0 24px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-bottom: 1px solid #edf0f2;
    }

    .installment-header-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 16px;
    }

    .installment-card-header h3 {
        margin: 0;
        color: #1f2937;
        font-size: 17px;
        font-weight: 600;
    }

    .installment-card-header span {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 11px;
    }

    /* =========================================================
       CARD BODY
    ========================================================= */

    .installment-card-body {
        padding: 28px;
    }

    /* =========================================================
       SECTION
    ========================================================= */

    .installment-section {
        margin-bottom: 30px;
    }

    .installment-section:last-child {
        margin-bottom: 0;
    }

    .installment-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f2;
        color: #1f2937;
        font-size: 15px;
        font-weight: 700;
    }

    .installment-section-title i {
        color: #1e7b67;
        font-size: 14px;
    }

    /* =========================================================
       FORM GRID
    ========================================================= */

    .installment-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px 18px;
    }

    .installment-field {
        min-width: 0;
    }

    /* =========================================================
       LABEL
    ========================================================= */

    .installment-label {
        display: block;
        margin-bottom: 7px;
        color: #344054;
        font-size: 13px;
        font-weight: 600;
    }

    .required {
        color: #dc3545;
        margin-left: 2px;
    }

    /* =========================================================
       INPUT / SELECT
    ========================================================= */

    .installment-input,
    .installment-select {
        width: 100%;
        height: 44px;
        padding: 0 13px;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font-family: inherit;
        font-size: 13px;
        outline: none;
        transition: border-color .2s ease,
                    box-shadow .2s ease;
        box-sizing: border-box;
    }

    .installment-input:focus,
    .installment-select:focus {
        border-color: #1e7b67;
        box-shadow: 0 0 0 3px rgba(30, 123, 103, .08);
    }

    .installment-input::placeholder {
        color: #98a2b3;
    }

    .installment-select {
        cursor: pointer;
    }

    /* =========================================================
       PAYMENT SUMMARY
    ========================================================= */

    .payment-summary {
        padding: 20px;
        background: #f8fbfa;
        border: 1px solid #dfe8e5;
        border-radius: 11px;
    }

    .payment-summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .summary-field {
        min-width: 0;
    }

    .summary-field .installment-input {
        background: #ffffff;
        font-weight: 600;
    }

    .summary-field.highlight .installment-input {
        border-color: #b9ddd2;
        color: #1e7b67;
        background: #f5fbf9;
    }

    /* =========================================================
       INSTALLMENT AREA
    ========================================================= */

    .installment-payment-box {
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 11px;
        background: #ffffff;
    }

    .installment-payment-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .installment-payment-item {
        padding: 14px;
        background: #f8faf9;
        border: 1px solid #e6ebe9;
        border-radius: 9px;
    }

    .installment-payment-item .installment-label {
        margin-bottom: 8px;
    }

    /* =========================================================
       ACTIONS
    ========================================================= */

    .installment-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #edf0f2;
    }

    .installment-btn {
        min-width: 115px;
        height: 43px;
        padding: 0 20px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s ease;
    }

    .installment-btn-cancel {
        background: #f2f4f7;
        color: #475467;
        border: 1px solid #e4e7ec;
    }

    .installment-btn-cancel:hover {
        background: #e4e7ec;
        color: #344054;
    }

    .installment-btn-save {
        background: #1e7b67;
        color: #ffffff;
        border: 1px solid #1e7b67;
        box-shadow: 0 5px 12px rgba(30, 123, 103, .15);
    }

    .installment-btn-save:hover {
        background: #176653;
        color: #ffffff;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1100px) {

        .installment-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .payment-summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .installment-payment-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 767px) {

        .installment-page {
            padding-top: 0;
        }

        .installment-page-header h2 {
            font-size: 22px;
        }

        .installment-card-header {
            padding: 0 16px;
        }

        .installment-card-body {
            padding: 20px 16px;
        }

        .installment-grid,
        .payment-summary-grid,
        .installment-payment-grid {
            grid-template-columns: 1fr;
        }

        .installment-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .installment-btn {
            width: 100%;
        }
    }

    @@media (max-width: 400px) {

        .installment-card-body {
            padding: 16px 12px;
        }

        .installment-card-header h3 {
            font-size: 15px;
        }

    }

</style>


<div class="container-fluid installment-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="installment-page-header">

        <h2>
            Add Installment
        </h2>

        <p>
            ItNetworkZ
        </p>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="installment-card">


        <!-- CARD HEADER -->

        <div class="installment-card-header">

            <div class="installment-header-icon">

                <i class="fas fa-money-bill-wave"></i>

            </div>

            <div>

                <h3>
                    Add Installment
                </h3>

                <span>
                    Advertisement Payment Details
                </span>

            </div>

        </div>


        <!-- CARD BODY -->

        <div class="installment-card-body">

            <form>


                <!-- =================================================
                     PAYMENT INFORMATION
                ================================================== -->

                <div class="installment-section">

                    <div class="installment-section-title">

                        <i class="fas fa-credit-card"></i>

                        Payment Information

                    </div>


                    <div class="installment-grid">


                        <!-- PAYMENT MODE -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Payment Mode

                                <span class="required">*</span>

                            </label>

                            <select class="installment-select">

                                <option selected disabled>
                                    -- Select Payment Mode --
                                </option>

                                <option>
                                    Online
                                </option>

                                <option>
                                    By Cash
                                </option>

                                <option>
                                    Cheque
                                </option>

                                <option>
                                    Draft
                                </option>

                            </select>

                        </div>


                        <!-- CHEQUE / DD -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Cheque / DD No.

                            </label>

                            <input type="text"
                                   class="installment-input"
                                   placeholder="Enter cheque / DD number" />

                        </div>


                        <!-- BANK -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Bank Name

                            </label>

                            <input type="text"
                                   class="installment-input"
                                   placeholder="Enter bank name" />

                        </div>


                        <!-- CHEQUE DATE -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Cheque Date

                            </label>

                            <input type="date"
                                   class="installment-input" />

                        </div>


                        <!-- PAYABLE CITY -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Payable At (City)

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   class="installment-input"
                                   placeholder="Enter payable city" />

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     AMOUNT DETAILS
                ================================================== -->

                <div class="installment-section">

                    <div class="installment-section-title">

                        <i class="fas fa-calculator"></i>

                        Amount Details

                    </div>


                    <div class="payment-summary">

                        <div class="payment-summary-grid">


                            <!-- ACTUAL -->

                            <div class="summary-field">

                                <label class="installment-label">

                                    Actual Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1200" />

                            </div>


                            <!-- DISCOUNT -->

                            <div class="summary-field">

                                <label class="installment-label">

                                    Discount %

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="10" />

                            </div>


                            <!-- OFFERED -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Offered Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1080" />

                            </div>


                            <!-- TAX -->

                            <div class="summary-field">

                                <label class="installment-label">

                                    Taxes

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="13.00" />

                            </div>


                            <!-- TOTAL -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Total Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1270" />

                            </div>


                            <!-- PAID -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Paid Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="500" />

                            </div>


                            <!-- BALANCE -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Balance Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="270.00" />

                            </div>


                            <!-- GRAND TOTAL -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Grand Total

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1000.00" />

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     INSTALLMENT DETAILS
                ================================================== -->

                <div class="installment-section">

                    <div class="installment-section-title">

                        <i class="fas fa-calendar-check"></i>

                        Installment Details

                    </div>


                    <div class="installment-payment-box">

                        <div class="installment-payment-grid">


                            <!-- INSTALLMENT 1 -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Installment 1

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="500" />

                            </div>


                            <!-- INSTALLMENT 2 -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Installment 2

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       placeholder="Enter installment amount" />

                            </div>


                            <!-- NEXT DATE -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Next Installment Date

                                    <span class="required">*</span>

                                </label>

                                <input type="date"
                                       class="installment-input" />

                            </div>


                            <!-- INSTALLMENT STATUS -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Installment Status

                                </label>

                                <select class="installment-select">

                                    <option selected>
                                        Pending
                                    </option>

                                    <option>
                                        Paid
                                    </option>

                                </select>

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="installment-actions">


                    <a asp-controller="SuperAdminAdvertisement"
                       asp-action="AdvertisementList"
                       class="installment-btn installment-btn-cancel">

                        <i class="fas fa-times"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="installment-btn installment-btn-save">

                        <i class="fas fa-save"></i>

                        Save Installment

                    </button>


                </div>


            </form>

        </div>

    </div>

</div>