@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Installment";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAAddInstallment.css" asp-append-version="true" />


<div class="container-fluid installment-page">


    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="installment-page-header">

        <h2>
            Add Installment
        </h2>

        <p>
            ItNetworkZ
        </p>

    </div>


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="installment-card">


        <!-- CARD HEADER -->

        <div class="installment-card-header">

            <div class="installment-header-icon">

                <i class="fas fa-money-bill-wave"></i>

            </div>

            <div>

                <h3>
                    Add Installment
                </h3>

                <span>
                    Advertisement Payment Details
                </span>

            </div>

        </div>


        <!-- CARD BODY -->

        <div class="installment-card-body">

            <form>


                <!-- =================================================
                     PAYMENT INFORMATION
                ================================================== -->

                <div class="installment-section">

                    <div class="installment-section-title">

                        <i class="fas fa-credit-card"></i>

                        Payment Information

                    </div>


                    <div class="installment-grid">


                        <!-- PAYMENT MODE -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Payment Mode

                                <span class="required">*</span>

                            </label>

                            <select class="installment-select">

                                <option selected disabled>
                                    -- Select Payment Mode --
                                </option>

                                <option>
                                    Online
                                </option>

                                <option>
                                    By Cash
                                </option>

                                <option>
                                    Cheque
                                </option>

                                <option>
                                    Draft
                                </option>

                            </select>

                        </div>


                        <!-- CHEQUE / DD -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Cheque / DD No.

                            </label>

                            <input type="text"
                                   class="installment-input"
                                   placeholder="Enter cheque / DD number" />

                        </div>


                        <!-- BANK -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Bank Name

                            </label>

                            <input type="text"
                                   class="installment-input"
                                   placeholder="Enter bank name" />

                        </div>


                        <!-- CHEQUE DATE -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Cheque Date

                            </label>

                            <input type="date"
                                   class="installment-input" />

                        </div>


                        <!-- PAYABLE CITY -->

                        <div class="installment-field">

                            <label class="installment-label">

                                Payable At (City)

                                <span class="required">*</span>

                            </label>

                            <input type="text"
                                   class="installment-input"
                                   placeholder="Enter payable city" />

                        </div>


                    </div>

                </div>


                <!-- =================================================
                     AMOUNT DETAILS
                ================================================== -->

                <div class="installment-section">

                    <div class="installment-section-title">

                        <i class="fas fa-calculator"></i>

                        Amount Details

                    </div>


                    <div class="payment-summary">

                        <div class="payment-summary-grid">


                            <!-- ACTUAL -->

                            <div class="summary-field">

                                <label class="installment-label">

                                    Actual Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1200" />

                            </div>


                            <!-- DISCOUNT -->

                            <div class="summary-field">

                                <label class="installment-label">

                                    Discount %

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="10" />

                            </div>


                            <!-- OFFERED -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Offered Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1080" />

                            </div>


                            <!-- TAX -->

                            <div class="summary-field">

                                <label class="installment-label">

                                    Taxes

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="13.00" />

                            </div>


                            <!-- TOTAL -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Total Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1270" />

                            </div>


                            <!-- PAID -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Paid Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="500" />

                            </div>


                            <!-- BALANCE -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Balance Amount

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="270.00" />

                            </div>


                            <!-- GRAND TOTAL -->

                            <div class="summary-field highlight">

                                <label class="installment-label">

                                    Grand Total

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="1000.00" />

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     INSTALLMENT DETAILS
                ================================================== -->

                <div class="installment-section">

                    <div class="installment-section-title">

                        <i class="fas fa-calendar-check"></i>

                        Installment Details

                    </div>


                    <div class="installment-payment-box">

                        <div class="installment-payment-grid">


                            <!-- INSTALLMENT 1 -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Installment 1

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       value="500" />

                            </div>


                            <!-- INSTALLMENT 2 -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Installment 2

                                    <span class="required">*</span>

                                </label>

                                <input type="number"
                                       class="installment-input"
                                       placeholder="Enter installment amount" />

                            </div>


                            <!-- NEXT DATE -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Next Installment Date

                                    <span class="required">*</span>

                                </label>

                                <input type="date"
                                       class="installment-input" />

                            </div>


                            <!-- INSTALLMENT STATUS -->

                            <div class="installment-payment-item">

                                <label class="installment-label">

                                    Installment Status

                                </label>

                                <select class="installment-select">

                                    <option selected>
                                        Pending
                                    </option>

                                    <option>
                                        Paid
                                    </option>

                                </select>

                            </div>


                        </div>

                    </div>

                </div>


                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="installment-actions">


                    <a asp-controller="SuperAdminAdvertisement"
                       asp-action="AdvertisementList"
                       class="installment-btn installment-btn-cancel">

                        <i class="fas fa-times"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="installment-btn installment-btn-save">

                        <i class="fas fa-save"></i>

                        Save Installment

                    </button>


                </div>


            </form>

        </div>

    </div>

</div>