@model IEnumerable<ErJobPortal.Models.SAOrganizationFeedbackM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Feedback";
    ViewData["Panel"] = "SuperAdmin";
    ViewData["UserName"] = "Super Admin";
}

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/SAOrganizationFeedback.css" asp-append-version="true" />

<div class="feedback-page">

  <!-- CARD -->
<div class="feedback-card">

    

    <div class="master-table-container">
           <!-- TITLE -->
    <div class="feedback-title-row">

        <div>

            <h1 class="feedback-title">
                Organization Feedback Details
            </h1>

            <div class="feedback-subtitle">
                Organization Feedback
            </div>

        </div>

        <!-- RIGHT SIDE -->
  <a asp-controller="SuperAdmin"
   asp-action="Dashboard"
   class="master-back-btn"
   title="Back to Dashboard">
    <i class="fas fa-arrow-left"></i>
</a>

    </div>
        <table id="organizationFeedbackTable"
               class="master-data-table"
               data-mobile-scroll="true">

            <thead>
                <tr>

                    <th>
                        Sr. No
                    </th>

                    <th>
                        Organization Name
                    </th>

                    <th>
                        Status
                    </th>

                    <th>
                        Action
                    </th>

                </tr>
            </thead>

            <tbody>

                @if (Model != null && Model.Any())
                {
                    int srNo = 1;

                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @srNo
                            </td>

                            <td>
                                @item.sOrgName
                            </td>

                            <td>

                                <form asp-controller="SuperAdmin"
                                      asp-action="ToggleOrganizationFeedback"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.nID" />

                                    @if (item.nSABit == 1)
                                    {
                                        <button type="submit"
                                                class="status-button status-enabled"
                                                onclick="return confirm('Are you sure you want to disable this feedback?');">

                                            Enabled

                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="status-button status-disabled"
                                                onclick="return confirm('Are you sure you want to enable this feedback?');">

                                            Disabled

                                        </button>
                                    }

                                </form>

                            </td>

                            <td>

                                <a asp-controller="SuperAdmin"
                                   asp-action="DetailsOrgFeedback"
                                   asp-route-id="@item.nID"
                                   class="view-button"
                                   title="View">

                                    <i class="fas fa-eye"></i>

                                </a>

                            </td>

                        </tr>

                        srNo++;
                    }
                }
                else
                {
                    <tr>

                        <td colspan="4"
                            class="text-center">

                            No organization feedback found.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div id="organizationFeedbackPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>
        <script>
            document.querySelectorAll(".organization-feedback-toggle-form")
                .forEach(function (form) {

                    form.addEventListener("submit", function (e) {

                        e.preventDefault();

                        const button = form.querySelector(".status-button");
                        const formData = new FormData(form);

                        fetch(form.action, {
                            method: "POST",
                            body: formData
                        })
                        .then(response => {

                            if (!response.ok) {
                                throw new Error("Update failed");
                            }

                            if (button.classList.contains("status-enabled")) {

                                button.innerText = "Disabled";

                                button.classList.remove("status-enabled");
                                button.classList.add("status-disabled");

                            }
                            else {

                                button.innerText = "Enabled";

                                button.classList.remove("status-disabled");
                                button.classList.add("status-enabled");
                            }
                        })
                        .catch(error => {

                            console.error(error);
                            alert("Unable to update organization feedback status.");

                        });

                    });

                });
        </script>

</div>
</div>

<script>

    const searchInput = document.getElementById("searchInput");

    const entriesSelect = document.getElementById("entriesSelect");

    const table = document.getElementById("feedbackTable");

    const rows = table.querySelectorAll("tbody tr");


    function filterTable() {

        const searchValue =
            searchInput.value.toLowerCase().trim();

        const maxRows =
            parseInt(entriesSelect.value);

        let visibleCount = 0;


        rows.forEach(function (row) {

            const rowText =
                row.innerText.toLowerCase();


            if (
                rowText.includes(searchValue) &&
                visibleCount < maxRows
            ) {

                row.style.display = "";

                visibleCount++;

            }
            else {

                row.style.display = "none";

            }

        });

    }


    searchInput.addEventListener(
        "keyup",
        filterTable
    );


    entriesSelect.addEventListener(
        "change",
        filterTable
    );


    // Apply pagination when page loads
    filterTable();

</script>