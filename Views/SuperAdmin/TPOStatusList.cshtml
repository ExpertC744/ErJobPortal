@model IEnumerable<ErJobPortal.Models.TPORegistration>

@{
    
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
   

    ViewData["Title"] = "TPO Status List";
    ViewData["Panel"] = "SuperAdmin";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>TPO & Sub-TPO Status List</h2>
            <p class="text-muted mb-0">
                View approved and rejected TPO registrations.
            </p>
        </div>
        <a href="/SuperAdmin/Dashboard/1"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card border-success shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Approved</h6>
                    <h3 class="text-success">
                        @ViewBag.ApprovedCount
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-danger shadow-sm">
                <div class="card-body">
                    <h6 class="text-muted">Rejected</h6>
                    <h3 class="text-danger">
                        @ViewBag.RejectedCount
                    </h3>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <input type="text"
                           id="searchTPO"
                           class="form-control"
                           placeholder="Search name, email, college or code..." />
                </div>

                <div class="col-md-3">
                    <select id="filterStatus" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="approved">Approved</option>
                        <option value="rejected">Rejected</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select id="filterType" class="form-select">
                        <option value="">All Types</option>
                        <option value="main tpo">Main TPO</option>
                        <option value="sub-tpo">Sub-TPO</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle"
                       id="tpoTable">

                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>TPO Type</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>College</th>
                            <th>College Code</th>
                            <th>Status</th>
                            <th>Active</th>
                            <th>Created Date</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                    @if (Model != null && Model.Any())
                    {
                        var sr = 1;

                        foreach (var tpo in Model)
                        {
                            var status = tpo.Status ?? "";
                            var type = tpo.SubTpoBit == true
                                ? "Sub-TPO"
                                : "Main TPO";

                            <tr>
                                <td>@sr</td>
                                <td>@type</td>
                                <td>@tpo.FullName</td>
                                <td>@tpo.CollegeMailID</td>
                                <td>@tpo.MobileNo</td>
                                <td>@tpo.CollegeName</td>
                                <td>@tpo.CollegeCode</td>

                                <td>
                                    @if (status.Equals(
                                        "Approved",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }
                                </td>

                                <td>
                                    @if (tpo.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(tpo.CreatedDate?.ToString("dd-MMM-yyyy") ?? "-")
                                </td>

                                <td>
                                    @if (string.Equals(
                                        tpo.Status,
                                        "Rejected",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-controller="SuperAdmin"
                                              asp-action="RollbackTPORejection"
                                              method="post"
                                              onsubmit="return confirm(
                                                  'Restore this registration to Pending for review?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="tpoId"
                                                   value="@tpo.TPOID" />

                                            <button type="submit"
                                                    class="btn btn-warning btn-sm">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                                Restore
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                            </tr>

                            sr++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10"
                                class="text-center text-muted py-4">
                                No approved or rejected TPO records found.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="text-muted small">
                Total records: <span id="visibleCount">0</span>
            </div>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const search = document.getElementById("searchTPO");
        const statusFilter = document.getElementById("filterStatus");
        const typeFilter = document.getElementById("filterType");
        const rows = Array.from(
            document.querySelectorAll("#tpoTable tbody tr")
        );
        const count = document.getElementById("visibleCount");

        function filterRows() {
            let visible = 0;

            rows.forEach(function (row) {
                if (row.cells.length < 10) {
                    row.style.display = "none";
                    return;
                }

                const text = row.innerText.toLowerCase();
                const status = row.cells[7].innerText.trim().toLowerCase();
                const type = row.cells[1].innerText.trim().toLowerCase();

                const matchesSearch =
                    text.includes(search.value.trim().toLowerCase());

                const matchesStatus =
                    !statusFilter.value ||
                    status === statusFilter.value;

                const matchesType =
                    !typeFilter.value ||
                    type === typeFilter.value;

                const show =
                    matchesSearch && matchesStatus && matchesType;

                row.style.display = show ? "" : "none";

                if (show) visible++;
            });

            count.textContent = visible;
        }

        search.addEventListener("input", filterRows);
        statusFilter.addEventListener("change", filterRows);
        typeFilter.addEventListener("change", filterRows);

        filterRows();
    });
</script>
