@model ErJobPortal.Models.CandidateForgotPassword

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Forgot Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: "Inter", sans-serif;
            background: #f0fdfa;
            color: #0f172a;
        }

        .forgot-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 35px 20px;
            position: relative;
            overflow: hidden;
        }

        /* Background Shapes */

        .background-shape {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .shape-one {
            width: 280px;
            height: 280px;
            background: #ccfbf1;
            top: -120px;
            left: -100px;
            opacity: .65;
        }

        .shape-two {
            width: 340px;
            height: 340px;
            background: #dff7f3;
            right: -150px;
            bottom: -150px;
            opacity: .7;
        }

        .forgot-wrapper {
            width: 100%;
            max-width: 920px;
            position: relative;
            z-index: 2;
        }

        .forgot-card {
            display: grid;
            grid-template-columns: 40% 60%;
            background: #ffffff;
            border: 1px solid #dcefeb;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 20px 55px rgba(15, 118, 110, .10);
        }

        /* =====================================================
           LEFT BRAND PANEL
        ===================================================== */

        .brand-panel {
            background: #0f766e;
            color: #ffffff;
            padding: 48px 38px;
            position: relative;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 540px;
            overflow: hidden;
        }

        .brand-panel::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.15);
            right: -80px;
            top: -70px;
        }

        .brand-panel::before {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,.10);
            left: -150px;
            bottom: -120px;
        }

        .brand-content {
            position: relative;
            z-index: 2;
        }

        .brand-logo {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 50px;
        }

        .brand-logo-icon {
            width: 42px;
            height: 42px;
            border-radius: 11px;
            background: #ffffff;
            color: #0f766e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            font-weight: 800;
        }

        .brand-logo-text {
            font-size: 21px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .brand-small {
            display: block;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: #a7e4dc;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .brand-heading {
            font-size: 31px;
            line-height: 1.15;
            font-weight: 800;
            margin: 0 0 18px;
            letter-spacing: -.8px;
        }

        .brand-description {
            font-size: 13px;
            line-height: 1.8;
            color: #d7f2ef;
            margin: 0;
        }

        .security-note {
            position: relative;
            z-index: 2;
            border-top: 1px solid rgba(255,255,255,.2);
            padding-top: 22px;
            margin-top: 35px;
        }

        .security-note-icon {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: rgba(255,255,255,.12);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
            font-size: 13px;
        }

        .security-note-title {
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .security-note-text {
            font-size: 10px;
            line-height: 1.6;
            color: #bde8e3;
            margin: 0;
        }

        /* =====================================================
           RIGHT FORM
        ===================================================== */

        .form-panel {
            padding: 48px 55px;
            display: flex;
            align-items: center;
            background: #ffffff;
        }

        .form-content {
            width: 100%;
            max-width: 450px;
            margin: auto;
        }

        .form-icon {
            width: 58px;
            height: 58px;
            border-radius: 16px;
            background: #e6f7f4;
            color: #0f766e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 23px;
        }

        .form-kicker {
            font-size: 10px;
            color: #0f766e;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 8px;
        }

        .form-title {
            font-size: 28px;
            line-height: 1.2;
            font-weight: 800;
            color: #0f172a;
            margin: 0 0 10px;
            letter-spacing: -.6px;
        }

        .form-description {
            font-size: 13px;
            line-height: 1.7;
            color: #64748b;
            margin: 0 0 28px;
        }

        /* Alerts */

        .custom-alert {
            border-radius: 10px;
            padding: 12px 14px;
            font-size: 12px;
            margin-bottom: 20px;
            border: 1px solid;
        }

        .custom-alert.success {
            color: #166534;
            background: #f0fdf4;
            border-color: #bbf7d0;
        }

        .custom-alert.error {
            color: #b91c1c;
            background: #fef2f2;
            border-color: #fecaca;
        }

        /* Validation */

        .validation-summary {
            font-size: 12px;
            margin-bottom: 18px;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        /* Form */

        .form-group {
            margin-bottom: 22px;
        }

        .form-label-custom {
            display: block;
            color: #334155;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 9px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 14px;
            pointer-events: none;
            z-index: 2;
        }

        .form-control-custom {
            width: 100%;
            height: 48px;
            border: 1px solid #d7e3e1;
            border-radius: 10px;
            background: #fbfefd;
            padding: 0 15px 0 43px;
            color: #0f172a;
            font-size: 13px;
            outline: none;
            transition: border-color .2s ease,
                        box-shadow .2s ease,
                        background .2s ease;
        }

        .form-control-custom::placeholder {
            color: #a0acb5;
        }

        .form-control-custom:focus {
            background: #ffffff;
            border-color: #14b8a6;
            box-shadow: 0 0 0 4px rgba(20,184,166,.10);
        }

        .field-validation {
            display: block;
            font-size: 11px;
            margin-top: 6px;
        }

        .submit-btn {
            width: auto;
            min-width: 170px;
            height: 44px;
            padding: 0 20px;
            border: 0;
            border-radius: 9px;
            background: #0f766e;
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            transition: background .2s ease, transform .2s ease, box-shadow .2s ease;
        }

            .submit-btn:hover {
                background: #115e59;
                transform: translateY(-1px);
                box-shadow: 0 6px 15px rgba(15, 118, 110, .16);
            }

            .submit-btn i {
                margin: 0;
            }

        /* Back Login */

        .back-login {
            text-align: center;
            margin-top: 25px;
            padding-top: 22px;
            border-top: 1px solid #edf1f0;
        }

        .back-login a {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: #0f766e;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
        }

        .back-login a:hover {
            color: #115e59;
        }

        .form-footer {
            text-align: center;
            margin-top: 20px;
            color: #94a3b8;
            font-size: 10px;
        }

        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @@media (max-width: 767px) {

            body {
                min-width: 0;
            }

            .forgot-page {
                padding: 20px 15px;
            }

            .forgot-card {
                grid-template-columns: 1fr;
                border-radius: 18px;
            }

            .brand-panel {
                min-height: auto;
                padding: 30px 25px;
            }

            .brand-logo {
                margin-bottom: 32px;
            }

            .brand-heading {
                font-size: 25px;
            }

            .brand-description {
                font-size: 12px;
            }

            .security-note {
                margin-top: 25px;
            }

            .form-panel {
                padding: 35px 25px;
            }

            .form-title {
                font-size: 25px;
            }

            .submit-btn {
                min-width: 0;
                height: 45px;
            }

        }

        @@media (max-width: 420px) {

            .forgot-page {
                padding: 12px;
            }

            .brand-panel {
                padding: 25px 20px;
            }

            .form-panel {
                padding: 30px 20px;
            }

            .form-title {
                font-size: 23px;
            }

            .submit-btn {
                height: 44px;
                font-size: 12px;
                padding: 0 15px;
            }
        }

    </style>

</head>

<body>

    <main class="forgot-page">

        <div class="background-shape shape-one"></div>
        <div class="background-shape shape-two"></div>

        <div class="forgot-wrapper">

            <div class="forgot-card">


                <!-- =================================================
                     BRAND PANEL
                ================================================== -->

                <section class="brand-panel">

                    <div class="brand-content">

                        <div class="brand-logo">

                            <div class="brand-logo-icon">
                                <i class="fas fa-user-graduate"></i>
                            </div>

                            <span class="brand-logo-text">
                                1Trainee
                            </span>

                        </div>


                        <span class="brand-small">
                            Account Recovery
                        </span>

                        <h1 class="brand-heading">
                            Get back to your career journey.
                        </h1>

                        <p class="brand-description">
                            Enter the email address associated with
                            your candidate account. We will send the
                            login details to your registered email.
                        </p>

                    </div>


                    <div class="security-note">

                        <div class="security-note-icon">
                            <i class="fas fa-shield-halved"></i>
                        </div>

                    
                        <p class="security-note-text">
                            For your security, login information is
                            sent only to the email address registered
                            with your candidate account.
                        </p>

                    </div>

                </section>


                <!-- =================================================
                     FORM PANEL
                ================================================== -->

                <section class="form-panel">

                    <div class="form-content">


                        <div class="form-icon">

                            <i class="fas fa-key"></i>

                        </div>


                        <div class="form-kicker">
                            Candidate Account
                        </div>


                        <h2 class="form-title">
                            Forgot Password?
                        </h2>


                        <p class="form-description">
                            No problem. Enter your registered email
                            address below and we will send your
                            login details.
                        </p>


                        <!-- SUCCESS -->
                        @if (TempData["Success"] != null)
                        {
                            <div class="custom-alert success">

                                <i class="fas fa-circle-check me-2"></i>

                                @TempData["Success"]

                            </div>
                        }


                        <!-- ERROR -->
                        @if (TempData["Error"] != null)
                        {
                            <div class="custom-alert error">

                                <i class="fas fa-circle-exclamation me-2"></i>

                                @TempData["Error"]

                            </div>
                        }


                        <!-- VALIDATION -->

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger validation-summary">
                        </div>


                        <!-- FORM -->

                        <form asp-controller="Account"
                              asp-action="CandidateForgotPassword"
                              method="post">

                            @Html.AntiForgeryToken()


                            <div class="form-group">

                                <label asp-for="sEmail"
                                       class="form-label-custom">

                                    Registered Email Address

                                </label>


                                <div class="input-wrapper">

                                    <i class="fas fa-envelope input-icon"></i>

                                    <input asp-for="sEmail"
                                           class="form-control-custom"
                                           placeholder="Enter your registered email"
                                           autocomplete="email" />

                                </div>


                                <span asp-validation-for="sEmail"
                                      class="text-danger field-validation">
                                </span>

                            </div>


                            <button type="submit"
                                    class="submit-btn">

                                <i class="fas fa-paper-plane"></i>

                                Send Login Details

                            </button>

                        </form>


                        <!-- BACK -->

                        <div class="back-login">

                            <a asp-controller="Account"
                               asp-action="CandidateLogin">

                                <i class="fas fa-arrow-left"></i>

                                Back to Candidate Login

                            </a>

                        </div>


                        <div class="form-footer">

                            Candidate account recovery · 1Trainee

                        </div>

                    </div>

                </section>

            </div>

        </div>

    </main>


    <partial name="_ValidationScriptsPartial" />

</body>

</html>