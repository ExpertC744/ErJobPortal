@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "TPO Registration";
}

<link rel="stylesheet" href="~/css/TPORegister.css" />

<div class="candidate-register-page">

    <div class="candidate-register-card">

        <!-- =====================================================
             REGISTRATION SWITCH
        ====================================================== -->

        <div class="registration-switch">

            @* <a asp-controller="Account"
               asp-action="CandidateRegister"
               class="switch-btn">
                Trainee
            </a>

            <a asp-controller="Account"
               asp-action="OrganizationRegister"
               class="switch-btn">
                Organization
            </a>

            <a asp-controller="Account"
               asp-action="TPORegister"
               class="switch-btn active">
                TPO
            </a> *@

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="register-icon">
            <i class="fa-solid fa-user-tie"></i>
        </div>

        <div class="register-heading">

            <h2>TPO Registration</h2>

            <p>
                Register as a Training &amp; Placement Officer
            </p>

        </div>


        <!-- =====================================================
             SUCCESS / ERROR MESSAGE
        ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success register-alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger register-alert">
                @TempData["Error"]
            </div>
        }


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-controller="Account"
              asp-action="TPORegister"
              method="post"
              enctype="multipart/form-data"
              id="tpoRegistrationForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger register-summary">
            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="FullName" class="register-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           type="text"
                           class="register-input"
                           placeholder="Enter full name"
                           autocomplete="name" />

                    <span asp-validation-for="FullName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="MobileNo" class="register-label">
                        Mobile Number
                    </label>

                    <input asp-for="MobileNo"
                           type="tel"
                           class="register-input"
                           placeholder="Enter 10 digit mobile number"
                           maxlength="10"
                           inputmode="numeric"
                           autocomplete="tel" />

                    <span asp-validation-for="MobileNo"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="CollegeMailID" class="register-label">
                        College Mail ID
                    </label>

                    <input asp-for="CollegeMailID"
                           type="email"
                           class="register-input"
                           placeholder="Enter official college email"
                           autocomplete="email" />

                    <span asp-validation-for="CollegeMailID"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="CollegeEmployeeID" class="register-label">
                        College Employee ID
                    </label>

                    <input asp-for="CollegeEmployeeID"
                           type="text"
                           class="register-input"
                           placeholder="Enter employee ID"
                           autocomplete="off" />

                    <span asp-validation-for="CollegeEmployeeID"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="CollegeName" class="register-label">
                        College Name
                    </label>

                    <div class="register-input-box">

                        <select asp-for="CollegeName"
                                id="CollegeName"
                                class="register-select">

                            <option value="0">
                                -- Select College Name --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="CollegeName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="CollegeCode" class="register-label">
                        College Code
                    </label>

                    <div class="register-input-box">

                        <select asp-for="CollegeCode"
                                id="CollegeCode"
                                class="register-select">

                            <option value="0">
                                -- Select College Code --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="CollegeCode"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="Designation" class="register-label">
                        Designation
                    </label>

                    <input asp-for="Designation"
                           type="text"
                           class="register-input"
                           placeholder="e.g. Training &amp; Placement Officer" />

                    <span asp-validation-for="Designation"
                          class="text-danger register-validation">
                    </span>

                </div>


                
                <div class="register-form-group">

                    <label asp-for="nDepartment" class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">

                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">

                            <option value="">
                                -- Select Department --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation">
                    </span>

                </div>


            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="OrganizationWebsiteURL" class="register-label">
                        College Website URL
                    </label>

                    <input asp-for="OrganizationWebsiteURL"
                           type="url"
                           class="register-input"
                           placeholder="https://www.examplecollege.ac.in"
                           autocomplete="url" />

                    <span asp-validation-for="OrganizationWebsiteURL"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="ProfilePhotoFile" class="register-label">
                        Profile Photo
                    </label>

                    <input asp-for="ProfilePhotoFile"
                           type="file"
                           accept=".jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="ProfilePhotoFile"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row full">

                <div class="register-form-group">

                    <label for="CollegeAddress" class="register-label">
                        College Address
                    </label>

                    <textarea asp-for="CollegeAddress"
                              class="register-input"
                              rows="3"
                              placeholder="Enter complete college address"></textarea>

                    <span asp-validation-for="CollegeAddress"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Department -->

                <!-- Department -->

                @* <div class="register-form-group">

                    <label asp-for="nDepartment" class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">
                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">

                            <option value="">-- Select Department --</option>

                        </select>
                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation">
                    </span>

                </div> *@

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="SupportingDocument1File" class="register-label">
                        Supporting Document 1
                        <small>(ID Card / Appointment Letter)</small>
                    </label>

                    <input asp-for="SupportingDocument1File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="SupportingDocument1File"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="SupportingDocument2File" class="register-label">
                        Supporting Document 2
                        <small>(Authorization / Other Proof)</small>
                    </label>

                    <input asp-for="SupportingDocument2File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="SupportingDocument2File"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="Password" class="register-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="register-input"
                           placeholder="Create password"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="ConfirmPassword" class="register-label">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="register-input"
                           placeholder="Confirm password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <!-- =================================================
                 OTP VERIFICATION
            ================================================== -->

            <div class="otp-section">

                <label class="otp-label">
                    OTP Verification
                </label>

                <input asp-for="OTP" type="hidden" id="OTP" />

                <div class="otp-options">

                    <label class="radio-option">
                        <input type="radio" name="OTPType" value="Mobile" checked />
                        <span>Mobile No.</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio" name="OTPType" value="Email" />
                        <span>College Email</span>
                    </label>

                    <button type="button"
                            class="send-otp-btn"
                            id="btnSendOTP">
                        <i class="fa-solid fa-paper-plane"></i>
                        Send OTP
                    </button>

                </div>

                <div class="otp-box-row">

                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />

                </div>

                <span class="register-validation org-otp-status"
                      role="status"
                      aria-live="polite">
                    Click Send OTP, then enter the 6-digit OTP.
                </span>

                <span asp-validation-for="OTP"
                      class="text-danger register-validation">
                </span>

            </div>


            <!-- =================================================
                 IMPORTANT NOTICE
            ================================================== -->

            <div class="alert alert-info">

                <i class="fa-solid fa-circle-info"></i>

                Your TPO account will remain pending until it is
                verified and approved by the Super Admin.

            </div>


            <!-- =================================================
                 REGISTER BUTTON
            ================================================== -->

            <button type="submit"
                    class="register-main-btn">

                <i class="fa-solid fa-user-tie"></i>

                Submit TPO Registration

            </button>


            <!-- =================================================
                 LOGIN LINK
            ================================================== -->

            <div class="register-bottom-text">

                Already have a TPO account?

                <a asp-controller="Account"
                   asp-action="TPOLogin">
                    Sign In
                </a>

            </div>

        </form>

    </div>

</div>



@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // =====================================================
            // ELEMENT REFERENCES
            // =====================================================

            const collegeNameSelect = $('#CollegeName');
            const collegeCodeSelect = $('#CollegeCode');
            const departmentSelect = $('#departmentSelect');

            const otpInputs = document.querySelectorAll('.org-otp-input');
            const otpHidden = document.getElementById('OTP');
            const otpStatus = document.querySelector('.org-otp-status');
            const tpoForm = document.getElementById('tpoRegistrationForm');
            const sendOtpButton = $('#btnSendOTP');

            // =====================================================
            // BASIC INPUT SPACE HANDLING
            // =====================================================

            $('input[type="text"], input[type="email"], input[type="url"], input[type="tel"], input[type="password"], textarea')
                .not('.org-otp-input')
                .on('keydown', function (e) {
                    if (e.key === ' ' && this.value.length === 0) {
                        e.preventDefault();
                    }
                })
                .on('input', function () {
                    this.value = this.value.replace(/^\s+/, '');
                })
                .on('blur', function () {
                    this.value = this.value.trim();
                });

            // =====================================================
            // MOBILE NUMBER - ONLY 10 DIGITS
            // =====================================================

            $('#MobileNo').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 10);
            });

            // =====================================================
            // HELPER: HANDLE AJAX RESPONSE
            // =====================================================

            function getArrayResponse(data) {
                if (Array.isArray(data)) {
                    return data;
                }

                if (data && Array.isArray(data.data)) {
                    return data.data;
                }

                return [];
            }

            function getProperty(object, propertyNames) {
                for (const propertyName of propertyNames) {
                    if (object && object[propertyName] !== undefined &&
                        object[propertyName] !== null) {
                        return object[propertyName];
                    }
                }

                return '';
            }

            function resetDropdown(dropdown, placeholder) {
                dropdown.empty();
                dropdown.append(
                    $('<option>', {
                        value: '',
                        text: placeholder
                    })
                );
            }

            // =====================================================
            // LOAD COLLEGES
            // Endpoint must return an array containing nID and
            // sCollegeName (or equivalent property names).
            // =====================================================

            function loadColleges() {

                resetDropdown(
                    collegeNameSelect,
                    '-- Select College Name --'
                );

                resetDropdown(
                    collegeCodeSelect,
                    '-- Select College Code --'
                );

                $.ajax({
                    url: '@Url.Action("GetColleges", "Account")',
                    type: 'GET',
                    dataType: 'json',
                    cache: false,

                    success: function (response) {

                        const colleges = getArrayResponse(response);

                        console.log('Colleges response:', response);

                        if (colleges.length === 0) {
                            console.warn('No colleges returned by GetColleges.');
                            return;
                        }

                        $.each(colleges, function (index, college) {

                            const collegeId = getProperty(
                                college,
                                ['nID', 'nId', 'id', 'collegeId', 'CollegeID']
                            );

                            const collegeName = getProperty(
                                college,
                                ['sCollegeName', 'collegeName', 'CollegeName']
                            );

                            if (collegeId === '' || collegeName === '') {
                                console.warn(
                                    'College record is missing an ID or name:',
                                    college
                                );
                                return;
                            }

                            collegeNameSelect.append(
                                $('<option>', {
                                    value: collegeId,
                                    text: collegeName
                                })
                            );
                        });
                    },

                    error: function (xhr, status, error) {
                        console.error(
                            'College loading failed:',
                            status,
                            error,
                            xhr.responseText
                        );
                    }
                });
            }

            // =====================================================
            // LOAD DEPARTMENTS
            // Endpoint must return an array containing nID and
            // sDepartment (or equivalent property names).
            // =====================================================

            function loadDepartments() {

                resetDropdown(
                    departmentSelect,
                    '-- Select Department --'
                );

                $.ajax({
                    url: '@Url.Action("GetDepartments", "Account")',
                    type: 'GET',
                    dataType: 'json',
                    cache: false,

                    success: function (response) {

                        const departments = getArrayResponse(response);

                        console.log('Departments response:', response);

                        if (departments.length === 0) {
                            console.warn(
                                'No departments returned by GetDepartments.'
                            );
                            return;
                        }

                        $.each(departments, function (index, department) {

                            const departmentId = getProperty(
                                department,
                                ['nID', 'nId', 'id', 'departmentId', 'DepartmentID']
                            );

                            const departmentName = getProperty(
                                department,
                                ['sDepartment', 'departmentName', 'DepartmentName']
                            );

                            if (departmentName === '') {
                                console.warn(
                                    'Department record is missing its name:',
                                    department
                                );
                                return;
                            }

                                    departmentSelect.append(
            $('<option>', {
                value: Number(departmentId),
                text: departmentName
            })
        );
                        });
                    },

                    error: function (xhr, status, error) {
                        console.error(
                            'Department loading failed:',
                            status,
                            error,
                            xhr.responseText
                        );
                    }
                });
            }

            // =====================================================
            // LOAD COLLEGE CODES WHEN COLLEGE CHANGES
            // =====================================================

            collegeNameSelect.on('change', function () {

                const collegeId = $(this).val();

                resetDropdown(
                    collegeCodeSelect,
                    '-- Select College Code --'
                );

                if (!collegeId) {
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetCollegeCodes", "Account")',
                    type: 'GET',
                    dataType: 'json',
                    data: {
                        collegeId: collegeId
                    },
                    cache: false,

                    success: function (response) {

                        const codes = getArrayResponse(response);

                        console.log('College codes response:', response);

                        if (codes.length === 0) {
                            collegeCodeSelect.append(
                                $('<option>', {
                                    value: '',
                                    text: 'No College Code Available'
                                })
                            );
                            return;
                        }

                        $.each(codes, function (index, item) {

                            const code = getProperty(
                                item,
                                ['nCode', 'ncode', 'collegeCode', 'CollegeCode', 'code']
                            );

                            if (code === '') {
                                console.warn(
                                    'College code record is missing its code:',
                                    item
                                );
                                return;
                            }

                            collegeCodeSelect.append(
                                $('<option>', {
                                    value: code,
                                    text: code
                                })
                            );
                        });
                    },

                    error: function (xhr, status, error) {
                        console.error(
                            'College code loading failed:',
                            status,
                            error,
                            xhr.responseText
                        );
                    }
                });
            });

            // =====================================================
            // OTP HELPERS
            // =====================================================

            function getOtp() {
                return Array.from(otpInputs)
                    .map(function (input) {
                        return input.value;
                    })
                    .join('');
            }

            function syncOtp() {
                if (otpHidden) {
                    otpHidden.value = getOtp();
                }
            }

            function showOtpStatus(message, success) {

                if (!otpStatus) {
                    console.log(message);
                    return;
                }

                otpStatus.textContent = message;
                otpStatus.classList.remove('success', 'error');
                otpStatus.classList.add(success ? 'success' : 'error');
            }

            // =====================================================
            // OTP INPUT: DIGITS, AUTO-FOCUS, BACKSPACE, PASTE
            // =====================================================

            otpInputs.forEach(function (input, index) {

                input.setAttribute('inputmode', 'numeric');
                input.setAttribute('maxlength', '1');
                input.setAttribute('autocomplete', 'one-time-code');

                input.addEventListener('input', function () {

                    this.value = this.value.replace(/\D/g, '').substring(0, 1);

                    if (this.value && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }

                    syncOtp();
                });

                input.addEventListener('keydown', function (e) {

                    if (
                        e.key === 'Backspace' &&
                        this.value === '' &&
                        index > 0
                    ) {
                        otpInputs[index - 1].focus();
                    }

                    if (e.key === 'ArrowLeft' && index > 0) {
                        otpInputs[index - 1].focus();
                    }

                    if (
                        e.key === 'ArrowRight' &&
                        index < otpInputs.length - 1
                    ) {
                        otpInputs[index + 1].focus();
                    }
                });

                input.addEventListener('paste', function (e) {

                    e.preventDefault();

                    const clipboard = e.clipboardData ||
                        window.clipboardData;

                    const pasted = clipboard
                        .getData('text')
                        .replace(/\D/g, '')
                        .substring(0, otpInputs.length);

                    otpInputs.forEach(function (otpInput) {
                        otpInput.value = '';
                    });

                    pasted.split('').forEach(function (digit, i) {
                        if (otpInputs[i]) {
                            otpInputs[i].value = digit;
                        }
                    });

                    if (pasted.length > 0) {
                        otpInputs[
                            Math.min(pasted.length, otpInputs.length) - 1
                        ].focus();
                    }

                    syncOtp();
                });
            });

            // =====================================================
            // VALIDATE OTP BEFORE FORM SUBMISSION
            // =====================================================

            if (tpoForm) {

                tpoForm.addEventListener('submit', function (e) {

                    syncOtp();

                    if (otpInputs.length > 0 && getOtp().length !== 6) {

                        e.preventDefault();

                        showOtpStatus(
                            'Please enter the complete 6-digit OTP.',
                            false
                        );

                        if (otpInputs[0]) {
                            otpInputs[0].focus();
                        }

                        return false;
                    }
                });
            }

            // =====================================================
            // SEND OTP
            // =====================================================

            sendOtpButton.on('click', function (e) {

                e.preventDefault();

                const otpType = $('input[name="OTPType"]:checked').val();
                const email = ($('#CollegeMailID').val() || '').trim();
                const mobile = ($('#MobileNo').val() || '').trim();

                if (!otpType) {
                    showOtpStatus(
                        'Please select Email or Mobile OTP.',
                        false
                    );
                    return;
                }

                if (otpType === 'Email' && !email) {
                    showOtpStatus(
                        'Please enter College Mail ID.',
                        false
                    );
                    $('#CollegeMailID').focus();
                    return;
                }

                if (otpType === 'Mobile' && !mobile) {
                    showOtpStatus(
                        'Please enter Mobile Number.',
                        false
                    );
                    $('#MobileNo').focus();
                    return;
                }

                if (otpType === 'Mobile' && !/^\d{10}$/.test(mobile)) {
                    showOtpStatus(
                        'Please enter a valid 10-digit mobile number.',
                        false
                    );
                    $('#MobileNo').focus();
                    return;
                }

                const originalButtonHtml = sendOtpButton.html();

                sendOtpButton
                    .prop('disabled', true)
                    .html(
                        '<i class="fa-solid fa-spinner fa-spin"></i> Sending...'
                    );

                $.ajax({
                    url: '@Url.Action("SendTPOOTP", "Account")',
                    type: 'POST',
                    dataType: 'json',

                    // If the controller requires anti-forgery validation,
                    // add the token here and ensure the form contains
                    // @Html.AntiForgeryToken().
                    data: {
                        email: email,
                        mobile: mobile,
                        otpType: otpType
                    },

                    success: function (response) {

                        console.log('Send OTP response:', response);

                        const success = response &&
                            (
                                response.success === true ||
                                response.success === 'true'
                            );

                        const message = response && response.message
                            ? response.message
                            : (
                                success
                                    ? 'OTP sent successfully.'
                                    : 'Unable to send OTP.'
                            );

                        showOtpStatus(message, success);

                        if (success) {

                            sendOtpButton.html(
                                '<i class="fa-solid fa-check"></i> OTP Sent'
                            );

                            if (otpInputs.length > 0) {
                                otpInputs[0].focus();
                            }

                        } else {

                            sendOtpButton
                                .prop('disabled', false)
                                .html(originalButtonHtml);
                        }
                    },

                    error: function (xhr, status, error) {

                        console.error(
                            'OTP sending failed:',
                            status,
                            error,
                            xhr.responseText
                        );

                        let message = 'Unable to send OTP. Please try again.';

                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }

                        showOtpStatus(message, false);

                        sendOtpButton
                            .prop('disabled', false)
                            .html(originalButtonHtml);
                    }
                });
            });

            // =====================================================
            // INITIALIZE DROPDOWNS ONCE
            // =====================================================

            loadColleges();
            loadDepartments();

        });
    </script>
}

}
