@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "TPO Registration";
}

<link rel="stylesheet" href="~/css/TPORegister.css" />

<div class="candidate-register-page">

    <div class="candidate-register-card">

        <!-- =====================================================
             REGISTRATION SWITCH
        ====================================================== -->

        <div class="registration-switch">

            @* <a asp-controller="Account"
               asp-action="CandidateRegister"
               class="switch-btn">
                Trainee
            </a>

            <a asp-controller="Account"
               asp-action="OrganizationRegister"
               class="switch-btn">
                Organization
            </a>

            <a asp-controller="Account"
               asp-action="TPORegister"
               class="switch-btn active">
                TPO
            </a> *@

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="register-icon">
            <i class="fa-solid fa-user-tie"></i>
        </div>

        <div class="register-heading">

            <h2>TPO Registration</h2>

            <p>
                Register as a Training &amp; Placement Officer
            </p>

        </div>


        <!-- =====================================================
             SUCCESS / ERROR MESSAGE
        ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success register-alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger register-alert">
                @TempData["Error"]
            </div>
        }


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-controller="Account"
              asp-action="TPORegister"
              method="post"
              enctype="multipart/form-data"
              id="tpoRegistrationForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger register-summary">
            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="FullName" class="register-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           type="text"
                           class="register-input"
                           placeholder="Enter full name"
                           autocomplete="name" />

                    <span asp-validation-for="FullName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="MobileNo" class="register-label">
                        Mobile Number
                    </label>

                    <input asp-for="MobileNo"
                           type="tel"
                           class="register-input"
                           placeholder="Enter 10 digit mobile number"
                           maxlength="10"
                           inputmode="numeric"
                           autocomplete="tel" />

                    <span asp-validation-for="MobileNo"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="CollegeMailID" class="register-label">
                        College Mail ID
                    </label>

                    <input asp-for="CollegeMailID"
                           type="email"
                           class="register-input"
                           placeholder="Enter official college email"
                           autocomplete="email" />

                    <span asp-validation-for="CollegeMailID"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="CollegeEmployeeID" class="register-label">
                        College Employee ID
                    </label>

                    <input asp-for="CollegeEmployeeID"
                           type="text"
                           class="register-input"
                           placeholder="Enter employee ID"
                           autocomplete="off" />

                    <span asp-validation-for="CollegeEmployeeID"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="CollegeName" class="register-label">
                        College Name
                    </label>

                    <div class="register-input-box">

                        <select asp-for="CollegeName"
                                id="CollegeName"
                                class="register-select">

                            <option value="0">
                                -- Select College Name --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="CollegeName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="CollegeCode" class="register-label">
                        College Code
                    </label>

                    <div class="register-input-box">

                        <select asp-for="CollegeCode"
                                id="CollegeCode"
                                class="register-select">

                            <option value="0">
                                -- Select College Code --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="CollegeCode"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="Designation" class="register-label">
                        Designation
                    </label>

                    <input asp-for="Designation"
                           type="text"
                           class="register-input"
                           placeholder="e.g. Training &amp; Placement Officer" />

                    <span asp-validation-for="Designation"
                          class="text-danger register-validation">
                    </span>

                </div>



                <div class="register-form-group">

                    <label asp-for="nDepartment" class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">

                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">

                            <option value="">
                                -- Select Department --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation">
                    </span>

                </div>


            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="OrganizationWebsiteURL" class="register-label">
                        College Website URL
                    </label>

                    <input asp-for="OrganizationWebsiteURL"
                           type="url"
                           class="register-input"
                           placeholder="https://www.examplecollege.ac.in"
                           autocomplete="url" />

                    <span asp-validation-for="OrganizationWebsiteURL"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="ProfilePhotoFile" class="register-label">
                        Profile Photo
                    </label>

                    <input asp-for="ProfilePhotoFile"
                           type="file"
                           accept=".jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="ProfilePhotoFile"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row full">

                <div class="register-form-group">

                    <label for="CollegeAddress" class="register-label">
                        College Address
                    </label>

                    <textarea asp-for="CollegeAddress"
                              class="register-input"
                              rows="3"
                              placeholder="Enter complete college address"></textarea>

                    <span asp-validation-for="CollegeAddress"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- Department -->
                <!-- Department -->
                @* <div class="register-form-group">

                    <label asp-for="nDepartment" class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">
                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">

                            <option value="">-- Select Department --</option>

                        </select>
                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation">
                    </span>

                </div> *@

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="SupportingDocument1File" class="register-label">
                        Supporting Document 1
                        <small>(ID Card / Appointment Letter)</small>
                    </label>

                    <input asp-for="SupportingDocument1File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="SupportingDocument1File"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="SupportingDocument2File" class="register-label">
                        Supporting Document 2
                        <small>(Authorization / Other Proof)</small>
                    </label>

                    <input asp-for="SupportingDocument2File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="SupportingDocument2File"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="Password" class="register-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="register-input"
                           placeholder="Create password"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="ConfirmPassword" class="register-label">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="register-input"
                           placeholder="Confirm password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <!-- =================================================
                 OTP VERIFICATION
            ================================================== -->

            <div class="otp-section">
                <label class="otp-label">OTP Verification</label>

                <input asp-for="OTP" type="hidden" id="OTP" />
                <input asp-for="OTPType" type="hidden" id="SelectedOTPType" />

                <div class="otp-options">
                    <label class="otp-radio-option">
                        <input type="radio" name="otpMethod" value="Email" checked />
                        <i class="fa-solid fa-envelope"></i>
                        Email OTP
                    </label>

                    <label class="otp-radio-option">
                        <input type="radio" name="otpMethod" value="Mobile" />
                        <i class="fa-solid fa-mobile-screen-button"></i>
                        Mobile OTP
                    </label>
                </div>

                <div class="otp-box-row">
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                </div>

                <div class="otp-action-row">
                    <button type="button" class="send-otp-btn" id="btnSendOTP">
                        <i class="fa-solid fa-paper-plane"></i>
                        <span id="sendOtpText">Send Email OTP</span>
                    </button>

                    <button type="button" class="send-otp-btn" id="btnVerifyOTP" disabled>
                        <i class="fa-solid fa-circle-check"></i>
                        Verify OTP
                    </button>
                </div>

                <span class="register-validation org-otp-status"
                      id="otpStatus" role="status" aria-live="polite">
                    Enter your email and request an OTP.
                </span>

                <span asp-validation-for="OTP"
                      class="text-danger register-validation"></span>
            </div>



            <!-- =================================================
                 IMPORTANT NOTICE
            ================================================== -->

            <div class="alert alert-info">

                <i class="fa-solid fa-circle-info"></i>

                Your TPO account will remain pending until it is
                verified and approved by the Super Admin.

            </div>


            <!-- =================================================
                 REGISTER BUTTON
            ================================================== -->
            @* Sanidhya *@

            <button type="submit"
                    class="register-main-btn">
                id="btnSubmitTPO"
                <i class="fa-solid fa-user-tie"></i>

                Submit TPO Registration

            </button>




            <!-- =================================================
                 LOGIN LINK
            ================================================== -->

            <div class="register-bottom-text">

                Already have a TPO account?

                <a asp-controller="Account"
                   asp-action="TPOLogin">
                    Sign In
                </a>

            </div>

        </form>

    </div>

</div>








@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // =====================================================
            // ELEMENT REFERENCES
            // =====================================================

            const collegeNameSelect = $('#CollegeName');
            const collegeCodeSelect = $('#CollegeCode');
            const departmentSelect = $('#departmentSelect');

            const otpInputs = $('.org-otp-input');
            const otpHidden = $('#OTP');
            const otpTypeHidden = $('#SelectedOTPType');

            const sendButton = $('#btnSendOTP');
            const verifyButton = $('#btnVerifyOTP');
            const statusBox = $('#otpStatus');

            const tpoForm = $('#tpoRegistrationForm');
            const submitButton = $('#btnSubmitTPO');

            let otpSent = false;
            let otpVerified = false;
            let isSubmitting = false;

            // =====================================================
            // BASIC INPUT SPACE HANDLING
            // =====================================================

            $('input[type="text"], input[type="email"], input[type="url"], input[type="tel"], input[type="password"], textarea')
                .not('.org-otp-input')
                .on('keydown', function (e) {

                    if (e.key === ' ' && this.value.length === 0) {
                        e.preventDefault();
                    }

                })
                .on('input', function () {
                    this.value = this.value.replace(/^\s+/, '');
                })
                .on('blur', function () {
                    this.value = this.value.trim();
                });


            // =====================================================
            // MOBILE NUMBER - ONLY 10 DIGITS
            // =====================================================

            $('#MobileNo').on('input', function () {

                this.value = this.value.replace(/\D/g, '').substring(0, 10);

            });


            // =====================================================
            // COMMON AJAX HELPERS
            // =====================================================

            function getArrayResponse(response) {

                if (Array.isArray(response)) {
                    return response;
                }

                if (response && Array.isArray(response.data)) {
                    return response.data;
                }

                return [];
            }


            function getProperty(object, propertyNames) {

                for (const propertyName of propertyNames) {

                    if (
                        object &&
                        object[propertyName] !== undefined &&
                        object[propertyName] !== null
                    ) {
                        return object[propertyName];
                    }

                }

                return '';
            }


            function resetDropdown(dropdown, placeholder) {

                dropdown.empty();

                dropdown.append(
                    $('<option>', {
                        value: '',
                        text: placeholder
                    })
                );

            }


            // =====================================================
            // LOAD COLLEGES
            // =====================================================

            function loadColleges() {

                resetDropdown(
                    collegeNameSelect,
                    '-- Select College Name --'
                );

                resetDropdown(
                    collegeCodeSelect,
                    '-- Select College Code --'
                );

                $.ajax({

                    url: '@Url.Action("GetColleges", "Account")',
                    type: 'GET',
                    dataType: 'json',
                    cache: false,

                    success: function (response) {

                        console.log('College Response:', response);

                        const colleges = getArrayResponse(response);

                        $.each(colleges, function (index, college) {

                            const collegeId = getProperty(
                                college,
                                ['nID', 'nId', 'id', 'collegeId', 'CollegeID']
                            );

                            const collegeName = getProperty(
                                college,
                                ['sCollegeName', 'collegeName', 'CollegeName']
                            );

                            if (collegeId === '' || collegeName === '') {
                                console.warn('Invalid college:', college);
                                return;
                            }

                            collegeNameSelect.append(
                                $('<option>', {
                                    value: collegeId,
                                    text: collegeName
                                })
                            );

                        });

                    },

                    error: function (xhr, status, error) {

                        console.error('College loading error:', error);
                        console.error(xhr.responseText);

                    }

                });

            }


            // =====================================================
            // LOAD DEPARTMENTS
            // =====================================================

            function loadDepartments() {

                resetDropdown(
                    departmentSelect,
                    '-- Select Department --'
                );

                $.ajax({

                    url: '@Url.Action("GetDepartments", "Account")',
                    type: 'GET',
                    dataType: 'json',
                    cache: false,

                    success: function (response) {

                        console.log('Department Response:', response);

                        const departments = getArrayResponse(response);

                        $.each(departments, function (index, department) {

                            const departmentId = getProperty(
                                department,
                                ['nID', 'nId', 'id', 'departmentId', 'DepartmentID']
                            );

                            const departmentName = getProperty(
                                department,
                                ['sDepartment', 'departmentName', 'DepartmentName']
                            );

                            if (departmentId === '' || departmentName === '') {
                                return;
                            }

                            departmentSelect.append(
                                $('<option>', {
                                    value: departmentId,
                                    text: departmentName
                                })
                            );

                        });

                    },

                    error: function (xhr, status, error) {

                        console.error('Department loading error:', error);
                        console.error(xhr.responseText);

                    }

                });

            }


            // =====================================================
            // LOAD COLLEGE CODES
            // =====================================================

            collegeNameSelect.on('change', function () {

                const collegeId = $(this).val();

                resetDropdown(
                    collegeCodeSelect,
                    '-- Select College Code --'
                );

                if (!collegeId) {
                    return;
                }

                $.ajax({

                    url: '@Url.Action("GetCollegeCodes", "Account")',
                    type: 'GET',
                    dataType: 'json',

                    data: {
                        collegeId: collegeId
                    },

                    cache: false,

                    success: function (response) {

                        console.log('College Code Response:', response);

                        const codes = getArrayResponse(response);

                        if (codes.length === 0) {

                            collegeCodeSelect.append(
                                $('<option>', {
                                    value: '',
                                    text: 'No College Code Available'
                                })
                            );

                            return;
                        }

                        $.each(codes, function (index, item) {

                            const code = getProperty(
                                item,
                                ['nCode', 'ncode', 'collegeCode', 'CollegeCode', 'code']
                            );

                            if (code === '') {
                                return;
                            }

                            collegeCodeSelect.append(
                                $('<option>', {
                                    value: code,
                                    text: code
                                })
                            );

                        });

                    },

                    error: function (xhr, status, error) {

                        console.error('College code error:', error);
                        console.error(xhr.responseText);

                    }

                });

            });


            // =====================================================
            // OTP HELPERS
            // =====================================================

            function getOtpMethod() {

                return $('input[name="otpMethod"]:checked').val() || 'Email';

            }


            function getEnteredOTP() {

                return otpInputs.map(function () {
                    return this.value;
                }).get().join('');

            }


            function showOtpStatus(message, success) {

                statusBox
                    .text(message)
                    .removeClass('success error')
                    .addClass(success ? 'success' : 'error');

            }


            function resetOTP() {

                otpSent = false;
                otpVerified = false;

                otpHidden.val('');

                otpInputs
                    .val('')
                    .prop('readonly', false);

                verifyButton
                    .prop('disabled', true)
                    .html('<i class="fa-solid fa-circle-check"></i> Verify OTP');

                sendButton.prop('disabled', false);

                $('#sendOtpText').text(
                    getOtpMethod() === 'Email'
                        ? 'Send Email OTP'
                        : 'Send Mobile OTP'
                );

            }


            // =====================================================
            // OTP METHOD CHANGE
            // =====================================================

            $('input[name="otpMethod"]').on('change', function () {

                resetOTP();

                const method = getOtpMethod();

                otpTypeHidden.val(method);

                if (method === 'Email') {

                    showOtpStatus(
                        'Enter your college email and request an OTP.',
                        false
                    );

                } else {

                    showOtpStatus(
                        'Mobile OTP is currently not supported. Please select Email OTP.',
                        false
                    );

                }

            });


            // =====================================================
            // OTP INPUT - AUTO FOCUS
            // =====================================================

            otpInputs.on('input', function () {

                this.value = this.value.replace(/\D/g, '').slice(0, 1);

                const index = otpInputs.index(this);

                if (this.value && index < otpInputs.length - 1) {
                    otpInputs.eq(index + 1).trigger('focus');
                }

                otpHidden.val(getEnteredOTP());

            });


            // =====================================================
            // OTP BACKSPACE
            // =====================================================

            otpInputs.on('keydown', function (e) {

                if (e.key === 'Backspace' && !this.value) {

                    const index = otpInputs.index(this);

                    if (index > 0) {
                        otpInputs.eq(index - 1).trigger('focus');
                    }

                }

            });


            // =====================================================
            // OTP PASTE
            // =====================================================

            otpInputs.first().on('paste', function (e) {

                e.preventDefault();

                const clipboard = (
                    e.originalEvent.clipboardData ||
                    window.clipboardData
                );

                const pasted = clipboard
                    .getData('text')
                    .replace(/\D/g, '')
                    .slice(0, otpInputs.length);

                otpInputs.each(function (index) {

                    $(this).val(pasted[index] || '');

                });

                otpHidden.val(getEnteredOTP());

                if (pasted.length > 0) {

                    otpInputs
                        .eq(pasted.length - 1)
                        .trigger('focus');

                }

            });


            // =====================================================
            // RESET OTP WHEN EMAIL OR MOBILE CHANGES
            // =====================================================

            $('#CollegeMailID, #MobileNo').on('input', function () {

                if (otpSent || otpVerified) {

                    resetOTP();

                    showOtpStatus(
                        'Contact details changed. Please request a new OTP.',
                        false
                    );

                }

            });


            // =====================================================
            // SEND OTP
            // =====================================================

            sendButton.on('click', function (e) {

                e.preventDefault();

                const method = getOtpMethod();

                const email = $('#CollegeMailID').val().trim();

                const mobile = $('#MobileNo').val().trim();

                if (method !== 'Email') {

                    showOtpStatus(
                        'Mobile OTP is currently not supported. Please select Email OTP.',
                        false
                    );

                    return;
                }

                if (!email) {

                    showOtpStatus(
                        'Please enter your college email address.',
                        false
                    );

                    $('#CollegeMailID').trigger('focus');

                    return;
                }

                if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(email)) {

                    showOtpStatus(
                        'Please enter a valid email address.',
                        false
                    );

                    return;
                }

                resetOTP();

                otpTypeHidden.val(method);

                sendButton.prop('disabled', true);

                $('#sendOtpText').text('Sending...');

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({

                    url: '@Url.Action("SendTPOOTP", "Account")',

                    type: 'POST',

                    dataType: 'json',

                    data: {
                        email: email,
                        mobile: mobile,
                        otpType: method,
                        __RequestVerificationToken: token
                    },

                    headers: {
                        'RequestVerificationToken': token
                    },

                    success: function (response) {

                        console.log('Send OTP Response:', response);

                        if (response && response.success === true) {

                            otpSent = true;
                            otpVerified = false;

                            otpInputs
                                .val('')
                                .prop('readonly', false);

                            otpHidden.val('');

                            verifyButton
                                .prop('disabled', false)
                                .html('<i class="fa-solid fa-circle-check"></i> Verify OTP');

                            $('#sendOtpText').text('OTP Sent');

                            showOtpStatus(
                                response.message || 'OTP sent successfully. Please check your email.',
                                true
                            );

                            otpInputs.first().trigger('focus');

                        } else {

                            resetOTP();

                            showOtpStatus(
                                response?.message || 'Unable to send OTP.',
                                false
                            );

                        }

                    },

                    error: function (xhr, status, error) {

                        console.error('Send OTP Error:', xhr.status, error);
                        console.error(xhr.responseText);

                        resetOTP();

                        let message = 'Unable to send OTP. Please try again.';

                        if (xhr.status === 400) {

                            message = 'Invalid request or security token. Refresh the page and try again.';

                        } else if (xhr.status === 404) {

                            message = 'SendTPOOTP action not found.';

                        } else if (xhr.status === 500) {

                            message = 'Server error while sending OTP. Check server logs and email configuration.';

                        }

                        showOtpStatus(message, false);

                    }

                });

            });


            // =====================================================
            // VERIFY OTP
            // =====================================================

            verifyButton.on('click', function (e) {

                e.preventDefault();

                const otp = getEnteredOTP();

                const email = $('#CollegeMailID').val().trim();

                const mobile = $('#MobileNo').val().trim();

                const method = getOtpMethod();

                if (!otpSent) {

                    showOtpStatus(
                        'Please request an OTP first.',
                        false
                    );

                    return;
                }

                if (otp.length !== 6) {

                    showOtpStatus(
                        'Please enter all 6 digits of OTP.',
                        false
                    );

                    return;
                }

                verifyButton
                    .prop('disabled', true)
                    .text('Verifying...');

                const token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({

                    url: '@Url.Action("VerifyTPOOTP", "Account")',

                    type: 'POST',

                    dataType: 'json',

                    data: {
                        email: email,
                        mobile: mobile,
                        otp: otp,
                        otpType: method,
                        __RequestVerificationToken: token
                    },

                    headers: {
                        'RequestVerificationToken': token
                    },

                    success: function (response) {

                        console.log('Verify OTP Response:', response);

                        if (response && response.success === true) {

                            otpVerified = true;

                            otpHidden.val(otp);

                            otpTypeHidden.val(method);

                            otpInputs.prop('readonly', true);

                            verifyButton
                                .prop('disabled', true)
                                .html('<i class="fa-solid fa-check"></i> Verified ✓');

                            sendButton.prop('disabled', true);

                            showOtpStatus(
                                response.message || 'OTP verified successfully!',
                                true
                            );

                        } else {

                            otpVerified = false;

                            otpHidden.val('');

                            verifyButton
                                .prop('disabled', false)
                                .html('<i class="fa-solid fa-circle-check"></i> Verify OTP');

                            showOtpStatus(
                                response?.message || 'Invalid OTP. Please try again.',
                                false
                            );

                        }

                    },

                    error: function (xhr, status, error) {

                        console.error('Verify OTP Error:', xhr.status, error);
                        console.error(xhr.responseText);

                        verifyButton
                            .prop('disabled', false)
                            .html('<i class="fa-solid fa-circle-check"></i> Verify OTP');

                        showOtpStatus(
                            'Unable to verify OTP. Please try again.',
                            false
                        );

                    }

                });

            });


            // =====================================================
            // FORM SUBMISSION
            // =====================================================

            tpoForm.on('submit', function (e) {

                // Prevent duplicate submissions.
                if (isSubmitting) {
                    e.preventDefault();
                    return false;
                }

                // Check form validation.
                if (!$(this).valid()) {
                    return;
                }

                // OTP verification is mandatory.
                if (!otpVerified) {

                    e.preventDefault();

                    showOtpStatus(
                        'Please send and verify your email OTP before registration.',
                        false
                    );

                    return false;
                }

                // Check verified OTP.
                if (!otpHidden.val() || otpHidden.val().length !== 6) {

                    e.preventDefault();

                    showOtpStatus(
                        'OTP verification is incomplete. Please verify again.',
                        false
                    );

                    return false;
                }

                // Set OTP type.
                otpTypeHidden.val(getOtpMethod());

                // Disable submit button.
                isSubmitting = true;

                submitButton
                    .prop('disabled', true)
                    .html('<i class="fa-solid fa-spinner fa-spin"></i> Submitting...');

                return true;

            });


            // =====================================================
            // INITIALIZE
            // =====================================================

            otpTypeHidden.val(getOtpMethod());

            verifyButton.prop('disabled', true);

            loadColleges();

            loadDepartments();

        });
    </script>
}
