@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "TPO Registration";
}

<link rel="stylesheet" href="~/css/TPORegister.css" />

<div class="candidate-register-page">

    <div class="candidate-register-card">

        <!-- =====================================================
             REGISTRATION SWITCH
        ====================================================== -->

        <div class="registration-switch">

            @* <a asp-controller="Account"
               asp-action="CandidateRegister"
               class="switch-btn">
                Trainee
            </a>

            <a asp-controller="Account"
               asp-action="OrganizationRegister"
               class="switch-btn">
                Organization
            </a>

            <a asp-controller="Account"
               asp-action="TPORegister"
               class="switch-btn active">
                TPO
            </a> *@

        </div>


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="register-icon">
            <i class="fa-solid fa-user-tie"></i>
        </div>

        <div class="register-heading">

            <h2>TPO Registration</h2>

            <p>
                Register as a Training &amp; Placement Officer
            </p>

        </div>


        <!-- =====================================================
             SUCCESS / ERROR MESSAGE
        ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success register-alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger register-alert">
                @TempData["Error"]
            </div>
        }


        <!-- =====================================================
             FORM
        ====================================================== -->

        <form asp-controller="Account"
              asp-action="TPORegister"
              method="post"
              enctype="multipart/form-data"
              id="tpoRegistrationForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger register-summary">
            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="FullName" class="register-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           type="text"
                           class="register-input"
                           placeholder="Enter full name"
                           autocomplete="name" />

                    <span asp-validation-for="FullName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="MobileNo" class="register-label">
                        Mobile Number
                    </label>

                    <input asp-for="MobileNo"
                           type="tel"
                           class="register-input"
                           placeholder="Enter 10 digit mobile number"
                           maxlength="10"
                           inputmode="numeric"
                           autocomplete="tel" />

                    <span asp-validation-for="MobileNo"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="CollegeMailID" class="register-label">
                        College Mail ID
                    </label>

                    <input asp-for="CollegeMailID"
                           type="email"
                           class="register-input"
                           placeholder="Enter official college email"
                           autocomplete="email" />

                    <span asp-validation-for="CollegeMailID"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="CollegeEmployeeID" class="register-label">
                        College Employee ID
                    </label>

                    <input asp-for="CollegeEmployeeID"
                           type="text"
                           class="register-input"
                           placeholder="Enter employee ID"
                           autocomplete="off" />

                    <span asp-validation-for="CollegeEmployeeID"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="CollegeName" class="register-label">
                        College Name
                    </label>

                    <div class="register-input-box">

                        <select asp-for="CollegeName"
                                id="CollegeName"
                                class="register-select">

                            <option value="0">
                                -- Select College Name --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="CollegeName"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="CollegeCode" class="register-label">
                        College Code
                    </label>

                    <div class="register-input-box">

                        <select asp-for="CollegeCode"
                                id="CollegeCode"
                                class="register-select">

                            <option value="0">
                                -- Select College Code --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="CollegeCode"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="Designation" class="register-label">
                        Designation
                    </label>

                    <input asp-for="Designation"
                           type="text"
                           class="register-input"
                           placeholder="e.g. Training &amp; Placement Officer" />

                    <span asp-validation-for="Designation"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="nDepartment" class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">

                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">

                            <option value="0">
                                -- Select Department --
                            </option>

                        </select>

                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="OrganizationWebsiteURL" class="register-label">
                        College Website URL
                    </label>

                    <input asp-for="OrganizationWebsiteURL"
                           type="url"
                           class="register-input"
                           placeholder="https://www.examplecollege.ac.in"
                           autocomplete="url" />

                    <span asp-validation-for="OrganizationWebsiteURL"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="ProfilePhotoFile" class="register-label">
                        Profile Photo
                    </label>

                    <input asp-for="ProfilePhotoFile"
                           type="file"
                           accept=".jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="ProfilePhotoFile"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row full">

                <div class="register-form-group">

                    <label for="CollegeAddress" class="register-label">
                        College Address
                    </label>

                    <textarea asp-for="CollegeAddress"
                              class="register-input"
                              rows="3"
                              placeholder="Enter complete college address"></textarea>

                    <span asp-validation-for="CollegeAddress"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="SupportingDocument1File" class="register-label">
                        Supporting Document 1
                        <small>(ID Card / Appointment Letter)</small>
                    </label>

                    <input asp-for="SupportingDocument1File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="SupportingDocument1File"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="SupportingDocument2File" class="register-label">
                        Supporting Document 2
                        <small>(Authorization / Other Proof)</small>
                    </label>

                    <input asp-for="SupportingDocument2File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <span asp-validation-for="SupportingDocument2File"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">

                    <label for="Password" class="register-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="register-input"
                           placeholder="Create password"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger register-validation">
                    </span>

                </div>


                <div class="register-form-group">

                    <label for="ConfirmPassword" class="register-label">
                        Confirm Password
                    </label>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           class="register-input"
                           placeholder="Confirm password"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger register-validation">
                    </span>

                </div>

            </div>

            <!-- =================================================
                 OTP VERIFICATION
            ================================================== -->

            <div class="otp-section">

                <label class="otp-label">
                    OTP Verification
                </label>

                <input asp-for="OTP" type="hidden" id="OTP" />

                <div class="otp-options">

                    <label class="radio-option">
                        <input type="radio" name="OTPType" value="Mobile" checked />
                        <span>Mobile No.</span>
                    </label>

                    <label class="radio-option">
                        <input type="radio" name="OTPType" value="Email" />
                        <span>College Email</span>
                    </label>

                    <button type="button"
                            class="send-otp-btn"
                            id="btnSendOTP">
                        <i class="fa-solid fa-paper-plane"></i>
                        Send OTP
                    </button>

                </div>

                <div class="otp-box-row">

                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" autocomplete="one-time-code" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                    <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />

                </div>

                <span class="register-validation org-otp-status"
                      role="status"
                      aria-live="polite">
                    Click Send OTP, then enter the 6-digit OTP.
                </span>

                <span asp-validation-for="OTP"
                      class="text-danger register-validation">
                </span>

            </div>


            <!-- =================================================
                 IMPORTANT NOTICE
            ================================================== -->

            <div class="alert alert-info">

                <i class="fa-solid fa-circle-info"></i>

                Your TPO account will remain pending until it is
                verified and approved by the Super Admin.

            </div>


            <!-- =================================================
                 REGISTER BUTTON
            ================================================== -->

            <button type="submit"
                    class="register-main-btn">

                <i class="fa-solid fa-user-tie"></i>

                Submit TPO Registration

            </button>


            <!-- =================================================
                 LOGIN LINK
            ================================================== -->

            <div class="register-bottom-text">

                Already have a TPO account?

                <a asp-controller="Account"
                   asp-action="TPOLogin">
                    Sign In
                </a>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        $(document).ready(function () {

            const collegeNameSelect = $('#CollegeName');
            const collegeCodeSelect = $('#CollegeCode');
            const departmentSelect = $('#departmentSelect');


            // =====================================================
            // BASIC INPUT SPACE HANDLING
            // =====================================================

            $('input[type="text"], input[type="email"], input[type="url"], input[type="tel"], input[type="password"], textarea')
                .not('.org-otp-input')
                .on('keydown', function (e) {
                    if (e.key === " " && this.value.length === 0) {
                        e.preventDefault();
                    }
                })
                .on('input', function () {
                    this.value = this.value.replace(/^\s+/, '');
                })
                .on('blur', function () {
                    this.value = this.value.trim();
                });


            // =====================================================
            // MOBILE NUMBER - ONLY DIGITS
            // =====================================================

            $('#MobileNo').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 10);
            });


            // =====================================================
            // LOAD COLLEGES
            // =====================================================

            $.ajax({
                url: '@Url.Action("GetColleges", "Account")',
                type: 'GET',

                success: function (data) {

                    collegeNameSelect.empty();

                    collegeNameSelect.append(
                        $('<option>', { value: '0', text: '-- Select College Name --' })
                    );

                    $.each(data, function (index, college) {
                        collegeNameSelect.append(
                            $('<option>', {
                                value: college.nID,
                                text: college.sCollegeName
                            })
                        );
                    });
                },

                error: function (xhr, status, error) {
                    console.error("College loading failed:", error);
                }
            });


            // =====================================================
            // LOAD DEPARTMENTS
            // =====================================================

            $.ajax({
                url: '@Url.Action("GetDepartments", "Account")',
                type: 'GET',

                success: function (data) {

                    departmentSelect.empty();

                    departmentSelect.append(
                        $('<option>', { value: '0', text: '-- Select Department --' })
                    );

                    $.each(data, function (index, item) {
                        departmentSelect.append(
                            $('<option>', {
                                value: item.nID,
                                text: item.sDepartment
                            })
                        );
                    });
                },

                error: function (xhr, status, error) {
                    console.error("Department loading failed:", error);
                }
            });


            // =====================================================
            // COLLEGE CHANGE - LOAD COLLEGE CODE
            // =====================================================

            collegeNameSelect.on('change', function () {

                const collegeId = $(this).val();

                collegeCodeSelect.empty();

                collegeCodeSelect.append(
                    $('<option>', { value: '0', text: '-- Select College Code --' })
                );

                if (!collegeId || collegeId === '0') {
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetCollegeCodes", "Account")',
                    type: 'GET',
                    data: { collegeId: collegeId },

                    success: function (data) {

                        if (!data || data.length === 0) {
                            collegeCodeSelect.append(
                                $('<option>', { value: '0', text: 'No College Code Available' })
                            );
                            return;
                        }

                        $.each(data, function (index, code) {
                            collegeCodeSelect.append(
                                $('<option>', {
                                    value: code.nCode,
                                    text: code.nCode
                                })
                            );
                        });
                    },

                    error: function (xhr, status, error) {
                        console.error("College code loading failed:", error);
                    }
                });
            });


            // =====================================================
            // OTP BOXES -> HIDDEN OTP FIELD
            // =====================================================

            const otpInputs = document.querySelectorAll(".org-otp-input");
            const otpHidden = document.getElementById("OTP");
            const otpStatus = document.querySelector(".org-otp-status");
            const tpoForm = document.getElementById("tpoRegistrationForm");

            function getOtp() {
                let otp = "";
                otpInputs.forEach(function (input) {
                    otp += input.value;
                });
                return otp;
            }

            function syncOtp() {
                otpHidden.value = getOtp();
            }

            function showOtpStatus(message, success) {
                otpStatus.textContent = message;
                otpStatus.classList.remove("success", "error");
                otpStatus.classList.add(success ? "success" : "error");
            }

            otpInputs.forEach(function (input, index) {

                input.addEventListener("input", function () {

                    this.value = this.value.replace(/\D/g, '').substring(0, 1);

                    if (this.value.length === 1 && index < otpInputs.length - 1) {
                        otpInputs[index + 1].focus();
                    }

                    syncOtp();
                });

                input.addEventListener("keydown", function (e) {

                    if (e.key === "Backspace" && this.value === "" && index > 0) {
                        otpInputs[index - 1].focus();
                    }
                });

                input.addEventListener("paste", function (e) {

                    e.preventDefault();

                    const pasted = (e.clipboardData || window.clipboardData)
                        .getData("text")
                        .replace(/\D/g, '')
                        .substring(0, 6);

                    pasted.split("").forEach(function (digit, i) {
                        if (otpInputs[i]) {
                            otpInputs[i].value = digit;
                        }
                    });

                    if (pasted.length > 0) {
                        otpInputs[Math.min(pasted.length, otpInputs.length) - 1].focus();
                    }

                    syncOtp();
                });
            });

            if (tpoForm) {

                tpoForm.addEventListener("submit", function (e) {

                    syncOtp();

                    if (getOtp().length !== 6) {

                        e.preventDefault();

                        showOtpStatus("Please enter the complete 6-digit OTP.", false);
                        otpInputs[0].focus();

                        return false;
                    }
                });
            }


            // =====================================================
            // SEND OTP
            // =====================================================

            $('#btnSendOTP').click(function () {

                const otpType = $('input[name="OTPType"]:checked').val();
                const email = $('#CollegeMailID').val();
                const mobile = $('#MobileNo').val();

                if (otpType === "Email") {

                    if (!email) {
                        showOtpStatus("Please enter College Mail ID.", false);
                        $('#CollegeMailID').focus();
                        return;
                    }
                }
                else {

                    if (!mobile) {
                        showOtpStatus("Please enter Mobile Number.", false);
                        $('#MobileNo').focus();
                        return;
                    }
                }

                const button = $(this);

                button.prop('disabled', true);
                button.html('<i class="fa-solid fa-spinner fa-spin"></i> Sending...');

                $.ajax({
                    url: '@Url.Action("SendTPOOTP", "Account")',
                    type: 'POST',

                    data: {
                        email: email,
                        mobile: mobile,
                        otpType: otpType
                    },

                    success: function (response) {

                        showOtpStatus(response.message, response.success);

                        if (response.success) {
                            button.html('<i class="fa-solid fa-check"></i> OTP Sent');
                            otpInputs[0].focus();
                        }
                        else {
                            button.prop('disabled', false);
                            button.html('<i class="fa-solid fa-paper-plane"></i> Send OTP');
                        }
                    },

                    error: function (xhr, status, error) {

                        console.error("OTP Error:", error);

                        showOtpStatus("Unable to send OTP. Please try again.", false);

                        button.prop('disabled', false);
                        button.html('<i class="fa-solid fa-paper-plane"></i> Send OTP');
                    }
                });
            });

        });

    </script>
}
