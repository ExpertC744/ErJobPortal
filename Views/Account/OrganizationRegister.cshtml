    @model ErJobPortal.Models.OrganizationRegister

    @{
        ViewData["Title"] = "Organization Registration";
    }

    <link rel="stylesheet" href="~/css/OrganizationRegister.css" />

    <div class="candidate-register-page">

        <div class="candidate-register-card">

            <!-- =====================================================
                 REGISTRATION SWITCH
            ====================================================== -->

            <div class="registration-switch">

                <a asp-controller="Account"
                   asp-action="CandidateRegister"
                   class="switch-btn">
                    Trainee
                </a>

                <a asp-controller="Account"
                   asp-action="OrganizationRegister"
                   class="switch-btn active">
                    Organization
                </a>

                <a asp-controller="Account"
                   asp-action="TPORegister"
                   class="switch-btn">
                    TPO
                </a>

            </div>


            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <div class="register-icon">
                <i class="fa-solid fa-building"></i>
            </div>

            <div class="register-heading">

                <h2>Create Organization Account</h2>

                <p>
                    Provide your organization details to get started
                </p>

            </div>


            <!-- =====================================================
                 SUCCESS / ERROR MESSAGE
            ====================================================== -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success register-alert">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger register-alert">
                    @TempData["Error"]
                </div>
            }


            <!-- =====================================================
                 FORM
            ====================================================== -->

            <form asp-controller="Account"
                  asp-action="OrganizationRegister"
                  method="post"
                  id="orgRegistrationForm">

                @Html.AntiForgeryToken()


                <!-- =================================================
                     ORGANIZATION NAME + WEBSITE
                ================================================== -->

                <div class="register-form-row">

                    <div class="register-form-group">

                        <label for="sOrgName" class="register-label">
                            Organization Name
                        </label>

                        <input asp-for="sOrgName"
                               type="text"
                               class="register-input"
                               placeholder="Enter organization name" />

                        <span asp-validation-for="sOrgName"
                              class="text-danger register-validation">
                        </span>

                    </div>


                    <div class="register-form-group">

                        <label for="sOrgUrl" class="register-label">
                            Organization Website
                        </label>

                        <input asp-for="sOrgUrl"
                               type="url"
                               class="register-input"
                               placeholder="https://example.com" />

                        <span asp-validation-for="sOrgUrl"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     COLLEGE NAME + COLLEGE CODE
                ================================================== -->

                <div class="register-form-row">

                    <div class="register-form-group">

                        <label for="nCollegeName" class="register-label">
                            College Name
                        </label>

                        <div class="register-input-box">

                            <select asp-for="nCollegeName"
                                    id="nCollegeName"
                                    class="register-select">

                                <option value="0">
                                    -- Select College Name --
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="nCollegeName"
                              class="text-danger register-validation">
                        </span>

                    </div>


                    <div class="register-form-group">

                        <label for="nCollegeCode" class="register-label">
                            College Code
                        </label>

                        <div class="register-input-box">

                            <select asp-for="nCollegeCode"
                                    id="nCollegeCode"
                                    class="register-select">

                                <option value="0">
                                    -- Select College Code --
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="nCollegeCode"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     DEPARTMENT + BRANCH
                ================================================== -->

                <div class="register-form-row">

                    <div class="register-form-group">

                        <label for="departmentSelect" class="register-label">
                            Department
                        </label>

                        <div class="register-input-box">

                            <select asp-for="nDepartment"
                                    id="departmentSelect"
                                    class="register-select">

                                <option value="0">
                                    -- Select Department --
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="nDepartment"
                              class="text-danger register-validation">
                        </span>

                    </div>


                    <div class="register-form-group">

                        <label for="branchSelect" class="register-label">
                            Branch
                        </label>

                        <div class="register-input-box">

                            <select asp-for="nBranch"
                                    id="branchSelect"
                                    class="register-select">

                                <option value="0">
                                    -- Select Branch --
                                </option>

                            </select>

                        </div>

                        <span asp-validation-for="nBranch"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     CONTACT PERSON + DESIGNATION
                ================================================== -->

                <div class="register-form-row">

                    <div class="register-form-group">

                        <label for="sName" class="register-label">
                            Contact Person
                        </label>

                        <input asp-for="sName"
                               type="text"
                               class="register-input"
                               placeholder="Enter contact person name"
                               autocomplete="name" />

                        <span asp-validation-for="sName"
                              class="text-danger register-validation">
                        </span>

                    </div>


                    <div class="register-form-group">

                        <label for="sDesignation" class="register-label">
                            Designation
                        </label>

                        <input asp-for="sDesignation"
                               type="text"
                               class="register-input"
                               placeholder="HR Manager or similar role"
                               autocomplete="organization-title" />

                        <span asp-validation-for="sDesignation"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     MOBILE + EMAIL
                ================================================== -->

                <div class="register-form-row">

                    <div class="register-form-group">

                        <label for="sMobile" class="register-label">
                            Mobile Number
                        </label>

                        <input asp-for="sMobile"
                               type="tel"
                               class="register-input"
                               placeholder="Enter 10 digit mobile number"
                               maxlength="10"
                               inputmode="numeric"
                               autocomplete="tel" />

                        <span asp-validation-for="sMobile"
                              class="text-danger register-validation">
                        </span>

                    </div>


                    <div class="register-form-group">

                        <label for="sEmail" class="register-label">
                            Email
                        </label>

                        <input asp-for="sEmail"
                               type="email"
                               class="register-input"
                               placeholder="Enter organization email"
                               autocomplete="email" />

                        <span asp-validation-for="sEmail"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     PASSWORD
                ================================================== -->

                <div class="register-form-row">

                    <div class="register-form-group">

                        <label for="sPassword" class="register-label">
                            Password
                        </label>

                        <input asp-for="sPassword"
                               type="password"
                               class="register-input"
                               placeholder="Create password"
                               autocomplete="new-password" />

                        <span asp-validation-for="sPassword"
                              class="text-danger register-validation">
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     OTP VERIFICATION
                ================================================== -->

                <div class="otp-section">

                    <label class="otp-label">
                        Email Verification
                        <span class="otp-hint">(Testing OTP: 123456)</span>
                    </label>

                    <input asp-for="sOTP" type="hidden" id="sOTP" />

                    <div class="otp-box-row">

                        <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" autocomplete="one-time-code" />
                        <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                        <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                        <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                        <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />
                        <input type="text" maxlength="1" class="org-otp-input" inputmode="numeric" />

                        <button type="button"
                                class="send-otp-btn org-otp-verify">
                            Verify OTP
                        </button>

                    </div>

                    <span class="register-validation org-otp-status"
                          role="status"
                          aria-live="polite">
                        Enter the 6-digit OTP and click Verify.
                    </span>

                    <span asp-validation-for="sOTP"
                          class="text-danger register-validation">
                    </span>

                </div>


                <!-- =================================================
                     REGISTER BUTTON
                ================================================== -->

                <button type="submit"
                        class="register-main-btn">

                    <i class="fa-solid fa-user-plus"></i>

                    Create Account

                </button>


                <!-- =================================================
                     LOGIN LINK
                ================================================== -->

                <div class="register-bottom-text">

                    Already registered?

                    <a asp-controller="Account"
                       asp-action="OrganizationLogin">
                        Sign In
                    </a>

                </div>

            </form>

        </div>

    </div>


    @section Scripts
    {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }

        <script>

            $(document).ready(function () {

                // =====================================================
                // ELEMENTS
                // =====================================================

                const collegeNameSelect = $('#nCollegeName');
                const collegeCodeSelect = $('#nCollegeCode');
                const departmentSelect = $('#departmentSelect');
                const branchSelect = $('#branchSelect');


                // =====================================================
                // BASIC INPUT SPACE HANDLING
                // =====================================================

                $('input[type="text"], input[type="email"], input[type="url"], input[type="tel"], input[type="password"]')
                    .not('.org-otp-input')
                    .on('keydown', function (e) {
                        if (e.key === " " && this.value.length === 0) {
                            e.preventDefault();
                        }
                    })
                    .on('input', function () {
                        this.value = this.value.replace(/^\s+/, '');
                    })
                    .on('blur', function () {
                        this.value = this.value.trim();
                    });


                // =====================================================
                // MOBILE NUMBER - DIGITS ONLY
                // =====================================================

                $('input[name="sMobile"]').on('input', function () {
                    this.value = this.value.replace(/\D/g, '').substring(0, 10);
                });


                // =====================================================
                // LOAD COLLEGES
                // =====================================================

                $.ajax({
                    url: '@Url.Action("GetColleges", "Account")',
                    type: 'GET',

                    success: function (data) {

                        collegeNameSelect.empty();

                        collegeNameSelect.append(
                            $('<option>', { value: '0', text: '-- Select College Name --' })
                        );

                        $.each(data, function (index, college) {
                            collegeNameSelect.append(
                                $('<option>', {
                                    value: college.nID,
                                    text: college.sCollegeName
                                })
                            );
                        });
                    },

                    error: function (xhr, status, error) {
                        console.error("College loading failed:", error);
                    }
                });


                // =====================================================
                // COLLEGE CHANGE - LOAD COLLEGE CODE
                // =====================================================

                collegeNameSelect.on('change', function () {

                    const collegeId = $(this).val();

                    collegeCodeSelect.empty();

                    collegeCodeSelect.append(
                        $('<option>', { value: '0', text: '-- Select College Code --' })
                    );

                    if (!collegeId || collegeId === '0') {
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("GetCollegeCodes", "Account")',
                        type: 'GET',
                        data: { collegeId: collegeId },

                        success: function (data) {

                            if (!data || data.length === 0) {
                                collegeCodeSelect.append(
                                    $('<option>', { value: '0', text: 'No College Code Available' })
                                );
                                return;
                            }

                            $.each(data, function (index, code) {
                                collegeCodeSelect.append(
                                    $('<option>', {
                                        value: code.nCode,
                                        text: code.nCode
                                    })
                                );
                            });
                        },

                        error: function (xhr, status, error) {
                            console.error("College code loading failed:", error);
                        }
                    });
                });


                // =====================================================
                // LOAD DEPARTMENTS
                // =====================================================

                $.ajax({
                    url: '@Url.Action("GetDepartments", "Account")',
                    type: 'GET',

                    success: function (data) {

                        departmentSelect.empty();

                        departmentSelect.append(
                            $('<option>', { value: '0', text: '-- Select Department --' })
                        );

                        $.each(data, function (index, item) {
                            departmentSelect.append(
                                $('<option>', {
                                    value: item.nID,
                                    text: item.sDepartment
                                })
                            );
                        });
                    },

                    error: function (xhr, status, error) {
                        console.error("Department loading failed:", error);
                    }
                });


                // =====================================================
                // DEPARTMENT CHANGE - LOAD BRANCHES
                // =====================================================

                departmentSelect.on('change', function () {

                    const departmentId = $(this).val();

                    branchSelect.empty();

                    branchSelect.append(
                        $('<option>', { value: '0', text: '-- Select Branch --' })
                    );

                    if (!departmentId || departmentId === '0') {
                        return;
                    }

                    $.ajax({
                        url: '@Url.Action("GetBranches", "Account")',
                        type: 'GET',
                        data: { departmentId: departmentId },

                        success: function (data) {

                            if (!data || data.length === 0) {
                                branchSelect.append(
                                    $('<option>', { value: '0', text: 'No Branch Available' })
                                );
                                return;
                            }

                            $.each(data, function (index, item) {
                                branchSelect.append(
                                    $('<option>', {
                                        value: item.nID,
                                        text: item.sBranch
                                    })
                                );
                            });
                        },

                        error: function (xhr, status, error) {
                            console.error("Branch loading failed:", error);
                        }
                    });
                });


                // =====================================================
                // OTP (TESTING - DUMMY OTP 123456)
                // =====================================================

                const otpInputs = document.querySelectorAll(".org-otp-input");
                const otpHidden = document.getElementById("sOTP");
                const verifyButton = document.querySelector(".org-otp-verify");
                const otpStatus = document.querySelector(".org-otp-status");
                const orgForm = document.getElementById("orgRegistrationForm");

                function getOtp() {
                    let otp = "";
                    otpInputs.forEach(function (input) {
                        otp += input.value;
                    });
                    return otp;
                }

                function showOtpStatus(message, success) {
                    otpStatus.textContent = message;
                    otpStatus.classList.remove("success", "error");
                    otpStatus.classList.add(success ? "success" : "error");
                }

                otpInputs.forEach(function (input, index) {

                    // Digits only + auto move next
                    input.addEventListener("input", function () {

                        this.value = this.value.replace(/\D/g, '').substring(0, 1);

                        if (this.value.length === 1 && index < otpInputs.length - 1) {
                            otpInputs[index + 1].focus();
                        }
                    });

                    // Backspace moves to previous box
                    input.addEventListener("keydown", function (e) {

                        if (e.key === "Backspace" && this.value === "" && index > 0) {
                            otpInputs[index - 1].focus();
                        }
                    });

                    // Paste full OTP
                    input.addEventListener("paste", function (e) {

                        e.preventDefault();

                        const pasted = (e.clipboardData || window.clipboardData)
                            .getData("text")
                            .replace(/\D/g, '')
                            .substring(0, 6);

                        pasted.split("").forEach(function (digit, i) {
                            if (otpInputs[i]) {
                                otpInputs[i].value = digit;
                            }
                        });

                        if (pasted.length > 0) {
                            otpInputs[Math.min(pasted.length, otpInputs.length) - 1].focus();
                        }
                    });
                });

                // Verify OTP
                if (verifyButton) {

                    verifyButton.addEventListener("click", function () {

                        const otp = getOtp();

                        if (otp.length !== 6) {
                            otpHidden.value = "";
                            showOtpStatus("Please enter the complete 6-digit OTP.", false);
                            return;
                        }

                        if (otp === "123456") {
                            otpHidden.value = otp;
                            showOtpStatus("OTP verified successfully.", true);
                        }
                        else {
                            otpHidden.value = "";
                            showOtpStatus("Invalid OTP. Please enter 123456.", false);
                        }
                    });
                }

                // Form submit guard
                if (orgForm) {

                    orgForm.addEventListener("submit", function (e) {

                        if (getOtp() !== "123456") {

                            e.preventDefault();

                            otpHidden.value = "";
                            showOtpStatus("Invalid OTP. Please enter 123456.", false);
                            otpInputs[0].focus();

                            return false;
                        }

                        otpHidden.value = "123456";
                    });
                }

            });

        </script>
    }
