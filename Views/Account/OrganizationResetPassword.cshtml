@model ErJobPortal.Models.OrganizationResetPassword

@{
    ViewData["Title"] = "Organization Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Organization Reset Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            font-family: "Inter", sans-serif;
        }

        body {
            background: radial-gradient(circle at 10% 10%, rgba(20,184,166,.10), transparent 28%), radial-gradient(circle at 90% 90%, rgba(13,148,136,.08), transparent 28%), #f5faf8;
            color: #0f172a;
        }

        .reset-page {
            min-height: 100vh;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

            .reset-page::before {
                content: "";
                position: absolute;
                width: 260px;
                height: 260px;
                border-radius: 50%;
                background: rgba(45,212,191,.08);
                top: -120px;
                left: -100px;
                pointer-events: none;
            }

            .reset-page::after {
                content: "";
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                background: rgba(13,148,136,.06);
                bottom: -150px;
                right: -120px;
                pointer-events: none;
            }

        .reset-card {
            width: 100%;
            max-width: 430px;
            background: #fff;
            border: 1px solid rgba(13,148,136,.10);
            border-radius: 24px;
            padding: 30px 34px 24px;
            position: relative;
            z-index: 2;
            box-shadow: 0 18px 45px rgba(15,118,110,.10), 0 4px 12px rgba(15,23,42,.04);
        }

        .card-accent {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 70px;
            height: 4px;
            border-radius: 0 0 10px 10px;
            background: linear-gradient(90deg,#0f766e,#14b8a6);
        }

        .reset-header {
            text-align: center;
            margin-bottom: 22px;
        }

        .reset-icon {
            width: 54px;
            height: 54px;
            margin: 0 auto 12px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient(135deg,#ccfbf1,#f0fdfa);
            color: #0d9488;
            border: 1px solid #d5f5ee;
            box-shadow: 0 8px 18px rgba(13,148,136,.10);
        }

            .reset-icon i {
                font-size: 22px;
            }

        .reset-title {
            margin: 0;
            font-size: 24px;
            line-height: 1.25;
            font-weight: 800;
            letter-spacing: -.6px;
            color: #0f172a;
        }

        .reset-subtitle {
            margin: 6px 0 0;
            font-size: 11px;
            line-height: 1.5;
            color: #64748b;
        }

        .reset-alert {
            display: flex;
            align-items: center;
            gap: 8px;
            border-radius: 10px;
            padding: 9px 11px;
            margin-bottom: 14px;
            font-size: 11px;
            line-height: 1.4;
        }

        .alert-success {
            color: #166534;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        .form-group {
            margin-bottom: 14px;
        }

        .form-label {
            display: block;
            margin-bottom: 6px;
            font-size: 11px;
            font-weight: 700;
            color: #334155;
        }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

            .input-wrapper > i.input-icon {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 12px;
                z-index: 2;
                pointer-events: none;
            }

        .reset-input {
            width: 100%;
            height: 43px;
            border: 1px solid #dbe7e4;
            border-radius: 10px;
            background: #fbfefd;
            color: #0f172a;
            padding: 0 42px 0 38px;
            font-size: 12px;
            outline: none;
            transition: all .2s ease;
        }

            .reset-input::placeholder {
                color: #a1aebd;
            }

            .reset-input:focus {
                border-color: #14b8a6;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(20,184,166,.10);
            }

        .password-toggle {
            position: absolute;
            right: 7px;
            top: 50%;
            transform: translateY(-50%);
            width: 29px;
            height: 29px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #94a3b8;
            cursor: pointer;
            transition: all .2s ease;
        }

            .password-toggle:hover {
                color: #0d9488;
                background: #f0fdfa;
            }

            .password-toggle i {
                font-size: 12px;
            }

        .validation-summary {
            font-size: 11px;
            color: #dc2626;
            margin-bottom: 12px;
        }

        .field-validation {
            display: block;
            margin-top: 4px;
            font-size: 10px;
            line-height: 1.3;
            color: #dc2626;
        }

        .input-validation-error {
            border-color: #ef4444 !important;
        }

        .reset-button {
            min-width: 155px;
            min-height: 40px;
            padding: 0 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin: 4px auto 0;
            border: 0;
            border-radius: 10px;
            background: linear-gradient(135deg,#0f766e,#0d9488);
            color: #fff;
            font-size: 11px;
            font-weight: 700;
            box-shadow: 0 7px 16px rgba(13,148,136,.20);
            transition: all .2s ease;
        }

            .reset-button:hover {
                transform: translateY(-1px);
                box-shadow: 0 9px 20px rgba(13,148,136,.25);
            }

            .reset-button:disabled,
            .otp-button:disabled {
                opacity: .65;
                cursor: not-allowed;
                transform: none;
            }

            .reset-button i {
                font-size: 11px;
            }

        .otp-button {
            width: 100%;
            min-height: 40px;
            border: 1px solid #0d9488;
            border-radius: 10px;
            background: #f0fdfa;
            color: #0f766e;
            font-size: 11px;
            font-weight: 700;
            transition: all .2s ease;
        }

            .otp-button:hover {
                background: #ccfbf1;
            }

        .otp-section {
            margin: 12px 0 16px;
            padding: 14px;
            border: 1px solid #d5f5ee;
            border-radius: 12px;
            background: #f8fffd;
        }

        .otp-code {
            letter-spacing: 7px;
            text-align: center;
            font-size: 17px;
            font-weight: 800;
        }

        .otp-status {
            display: none;
            margin: 10px 0;
            padding: 9px 10px;
            border-radius: 9px;
            font-size: 11px;
            line-height: 1.45;
        }

            .otp-status.success {
                display: block;
                color: #166534;
                background: #f0fdf4;
                border: 1px solid #bbf7d0;
            }

            .otp-status.error {
                display: block;
                color: #b91c1c;
                background: #fef2f2;
                border: 1px solid #fecaca;
            }

        .back-login {
            text-align: center;
            margin-top: 17px;
        }

            .back-login a {
                color: #0d9488;
                font-size: 11px;
                font-weight: 600;
                text-decoration: none;
                transition: color .2s ease;
            }

                .back-login a:hover {
                    color: #0f766e;
                    text-decoration: underline;
                }

            .back-login i {
                font-size: 10px;
            }

        @@media (max-width: 600px) {
            .reset-page {
                padding: 16px;
            }

            .reset-card {
                max-width: 430px;
                padding: 28px 26px 22px;
            }
        }

        @@media (max-width: 480px) {
            .reset-page {
                padding: 14px;
            }

            .reset-card {
                border-radius: 20px;
                padding: 26px 20px 20px;
            }

            .reset-title {
                font-size: 22px;
            }

            .reset-icon {
                width: 50px;
                height: 50px;
                border-radius: 14px;
            }

                .reset-icon i {
                    font-size: 20px;
                }
        }

        @@media (max-width: 360px) {
            .reset-page {
                padding: 10px;
            }

            .reset-card {
                border-radius: 18px;
                padding: 23px 16px 18px;
            }

            .reset-title {
                font-size: 20px;
            }

            .reset-subtitle {
                display: none;
            }

            .form-group {
                margin-bottom: 12px;
            }

            .reset-input {
                height: 41px;
            }

            .reset-button {
                width: 100%;
            }
        }
    </style>
</head>

<body>
    <div class="reset-page">
        <div class="reset-card">
            <div class="card-accent"></div>

            <div class="reset-header">
                <div class="reset-icon">
                    <i class="fa-solid fa-building"></i>
                </div>

                <h1 class="reset-title">Reset Password</h1>

                <p class="reset-subtitle">
                    Enter your registered organization email and create a new password.
                </p>
            </div>

            @if (TempData["Success"] != null)
            {
                <div class="reset-alert alert-success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span>@TempData["Success"]</span>
                </div>
            }

            <form id="organizationResetForm"
                  asp-controller="Account"
                  asp-action="OrganizationResetPassword"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <!-- ORGANIZATION EMAIL -->
                <div class="form-group">
                    <label asp-for="sEmail" class="form-label">
                        Organization Email ID
                    </label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-envelope input-icon"></i>

                        <input asp-for="sEmail"
                               id="sEmail"
                               class="reset-input"
                               placeholder="Enter registered organization email"
                               autocomplete="email" />
                    </div>

                    <span asp-validation-for="sEmail"
                          class="field-validation"></span>
                </div>

                <!-- SEND OTP -->
                <button type="button"
                        class="otp-button mt-2"
                        id="sendOrganizationResetOtpBtn">
                    <i class="fa-solid fa-paper-plane me-1"></i>
                    <span id="sendOrganizationResetOtpText">
                        Send Verification OTP
                    </span>
                </button>

                <!-- OTP SECTION -->
                <div class="otp-section mt-3"
                     id="organizationResetOtpSection"
                     style="display:none;">

                    <div class="form-group mb-2">
                        <label for="organizationResetOtp"
                               class="form-label">
                            Verify Email OTP
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-shield-halved input-icon"></i>

                            <input id="organizationResetOtp"
                                   name="otp"
                                   class="reset-input otp-code"
                                   type="text"
                                   inputmode="numeric"
                                   autocomplete="one-time-code"
                                   maxlength="6"
                                   pattern="[0-9]{6}"
                                   placeholder="Enter 6-digit OTP" />
                        </div>

                        <small class="field-validation"
                               style="color:#64748b">
                            Enter the OTP sent to your organization email.
                            It expires in 10 minutes.
                        </small>
                    </div>

                    <button type="button"
                            class="otp-button"
                            id="verifyOrganizationResetOtpBtn">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Verify OTP
                    </button>

                    <button type="button"
                            class="otp-button mt-2"
                            id="resendOrganizationResetOtpBtn"
                            style="display:none;">
                        Resend OTP
                    </button>
                </div>

                <div id="organizationResetOtpStatus"
                     class="otp-status"
                     role="status"
                     aria-live="polite"></div>

                <!-- PASSWORD FIELDS: HIDDEN UNTIL OTP VERIFIED -->
                <div id="organizationResetPasswordFields"
                     style="display:none;">

                    <div class="form-group">
                        <label asp-for="NewPassword" class="form-label">
                            New Password
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock input-icon"></i>

                            <input asp-for="NewPassword"
                                   id="organizationNewPassword"
                                   class="reset-input"
                                   placeholder="Enter new password"
                                   autocomplete="new-password"
                                   type="password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="toggleOrganizationNewPassword"
                                    aria-label="Show password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="NewPassword"
                              class="field-validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm New Password
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock input-icon"></i>

                            <input asp-for="ConfirmPassword"
                                   id="organizationConfirmPassword"
                                   class="reset-input"
                                   placeholder="Confirm new password"
                                   autocomplete="new-password"
                                   type="password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="toggleOrganizationConfirmPassword"
                                    aria-label="Show password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-validation"></span>
                    </div>

                    <button type="submit"
                            class="reset-button">
                        <i class="fa-solid fa-key"></i>
                        <span>Reset Password</span>
                    </button>
                </div>
            </form>

            <div class="back-login">
                <a asp-controller="Account"
                   asp-action="OrganizationLogin">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Back to Organization Login
                </a>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("organizationResetForm");
            const emailInput = document.getElementById("sEmail");

            const sendBtn = document.getElementById("sendOrganizationResetOtpBtn");
            const sendText = document.getElementById("sendOrganizationResetOtpText");
            const otpSection = document.getElementById("organizationResetOtpSection");
            const otpInput = document.getElementById("organizationResetOtp");
            const verifyBtn = document.getElementById("verifyOrganizationResetOtpBtn");
            const resendBtn = document.getElementById("resendOrganizationResetOtpBtn");
            const statusBox = document.getElementById("organizationResetOtpStatus");
            const passwordFields = document.getElementById("organizationResetPasswordFields");

            const sendOtpUrl =
                '@Url.Action("SendOrganizationResetOTP", "Account")';

            const verifyOtpUrl =
                '@Url.Action("VerifyOrganizationResetOTP", "Account")';

            let verifiedEmail = "";
            let emailAtOtpRequest = "";
            let resendTimer = null;

            function showStatus(message, type) {
                statusBox.textContent = message;
                statusBox.className = "otp-status " + type;
            }

            function getToken() {
                const tokenInput = form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );

                return tokenInput ? tokenInput.value : "";
            }

            async function postForm(url, values) {
                const body = new URLSearchParams();

                Object.keys(values).forEach(function (key) {
                    body.append(key, values[key]);
                });

                const token = getToken();

                if (token) {
                    body.set("__RequestVerificationToken", token);
                }

                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded;charset=UTF-8",
                        "RequestVerificationToken": token
                    },
                    body: body.toString(),
                    credentials: "same-origin"
                });

                if (!response.ok) {
                    throw new Error("Request failed. Please try again.");
                }

                return await response.json();
            }

            function startResendTimer() {
                clearInterval(resendTimer);

                let seconds = 30;

                resendBtn.style.display = "block";
                resendBtn.disabled = true;
                resendBtn.textContent = "Resend OTP in " + seconds + "s";

                resendTimer = setInterval(function () {
                    seconds--;

                    if (seconds <= 0) {
                        clearInterval(resendTimer);
                        resendBtn.disabled = false;
                        resendBtn.textContent = "Resend OTP";
                        return;
                    }

                    resendBtn.textContent = "Resend OTP in " + seconds + "s";
                }, 1000);
            }

            async function sendOtp() {
                const email = emailInput.value.trim();

                if (!email || !emailInput.checkValidity()) {
                    emailInput.reportValidity();
                    return;
                }

                sendBtn.disabled = true;
                resendBtn.disabled = true;
                sendText.textContent = "Sending OTP...";

                try {
                    const result = await postForm(sendOtpUrl, {
                        sEmail: email
                    });

                    if (!result.success) {
                        showStatus(
                            result.message || "Unable to send OTP.",
                            "error"
                        );

                        resendBtn.disabled = false;
                        return;
                    }

                    verifiedEmail = "";
                    emailAtOtpRequest = email.toLowerCase();

                    passwordFields.style.display = "none";
                    otpSection.style.display = "block";
                    emailInput.readOnly = true;
                    otpInput.value = "";

                    showStatus(
                        result.message || "OTP sent to your organization email.",
                        "success"
                    );

                    startResendTimer();
                    otpInput.focus();
                } catch (error) {
                    showStatus(
                        error.message || "Unable to send OTP.",
                        "error"
                    );

                    resendBtn.disabled = false;
                } finally {
                    sendBtn.disabled = false;
                    sendText.textContent = "Send Verification OTP";
                }
            }

            sendBtn.addEventListener("click", sendOtp);
            resendBtn.addEventListener("click", sendOtp);

            verifyBtn.addEventListener("click", async function () {
                const email = emailInput.value.trim();
                const otp = otpInput.value.trim();

                if (!/^[0-9]{6}$/.test(otp)) {
                    showStatus("Enter a valid 6-digit OTP.", "error");
                    otpInput.focus();
                    return;
                }

                if (email.toLowerCase() !== emailAtOtpRequest) {
                    showStatus(
                        "Please request a new OTP for this email address.",
                        "error"
                    );
                    return;
                }

                verifyBtn.disabled = true;

                try {
                    const result = await postForm(verifyOtpUrl, {
                        sEmail: email,
                        otp: otp
                    });

                    if (!result.success) {
                        showStatus(
                            result.message || "Invalid or expired OTP.",
                            "error"
                        );
                        return;
                    }

                    verifiedEmail = email.toLowerCase();

                    clearInterval(resendTimer);
                    otpSection.style.display = "none";
                    sendBtn.style.display = "none";
                    passwordFields.style.display = "block";
                    emailInput.readOnly = true;

                    showStatus(
                        result.message ||
                        "Email verified. You can now reset your password.",
                        "success"
                    );

                    passwordFields.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                } catch (error) {
                    showStatus(
                        error.message || "OTP verification failed.",
                        "error"
                    );
                } finally {
                    verifyBtn.disabled = false;
                }
            });

            emailInput.addEventListener("input", function () {
                if (emailAtOtpRequest &&
                    emailInput.value.trim().toLowerCase() !== emailAtOtpRequest) {

                    verifiedEmail = "";
                    emailAtOtpRequest = "";

                    clearInterval(resendTimer);

                    passwordFields.style.display = "none";
                    otpSection.style.display = "none";
                    sendBtn.style.display = "block";
                    sendBtn.disabled = false;
                    resendBtn.style.display = "none";
                    emailInput.readOnly = false;

                    statusBox.className = "otp-status";
                    statusBox.textContent = "";
                }
            });

            form.addEventListener("submit", function (event) {
                if (!verifiedEmail ||
                    emailInput.value.trim().toLowerCase() !== verifiedEmail ||
                    passwordFields.style.display === "none") {

                    event.preventDefault();

                    showStatus(
                        "Please verify your organization email OTP first.",
                        "error"
                    );
                    return;
                }

                const newPassword =
                    document.getElementById("organizationNewPassword").value;

                const confirmPassword =
                    document.getElementById("organizationConfirmPassword").value;

                if (newPassword !== confirmPassword) {
                    event.preventDefault();

                    showStatus(
                        "New password and confirm password do not match.",
                        "error"
                    );
                }
            });

            function setupPasswordToggle(inputId, buttonId) {
                const input = document.getElementById(inputId);
                const button = document.getElementById(buttonId);

                if (!input || !button) {
                    return;
                }

                const icon = button.querySelector("i");

                button.addEventListener("click", function () {
                    if (input.type === "password") {
                        input.type = "text";
                        icon.classList.remove("fa-eye");
                        icon.classList.add("fa-eye-slash");
                        button.setAttribute("aria-label", "Hide password");
                    } else {
                        input.type = "password";
                        icon.classList.remove("fa-eye-slash");
                        icon.classList.add("fa-eye");
                        button.setAttribute("aria-label", "Show password");
                    }
                });
            }

            setupPasswordToggle(
                "organizationNewPassword",
                "toggleOrganizationNewPassword"
            );

            setupPasswordToggle(
                "organizationConfirmPassword",
                "toggleOrganizationConfirmPassword"
            );
        });
    </script>

    <partial name="_ValidationScriptsPartial" />
</body>
</html>
