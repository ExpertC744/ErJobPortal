@model ErJobPortal.Models.TPOForgotPassword

@{
    ViewData["Title"] = "TPO Forgot Password";
}

<div class="login-page">

    <div class="login-card">

        <div class="text-center mb-4">

            <div class="login-icon">
                <i class="fa-solid fa-key"></i>
            </div>

            <h2>TPO Forgot Password</h2>

            <p class="text-muted">
                Enter your registered college email address.
            </p>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }


        <form asp-controller="Account"
              asp-action="TPOForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- COLLEGE EMAIL -->

            <div class="mb-3">

                <label asp-for="CollegeMailID"
                       class="form-label">
                    College Email ID
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="fa-solid fa-envelope"></i>
                    </span>

                    <input asp-for="CollegeMailID"
                           class="form-control"
                           placeholder="Enter your registered college email"
                           autocomplete="email" />

                </div>

                <span asp-validation-for="CollegeMailID"
                      class="text-danger">
                </span>

            </div>


            <button type="submit"
                    class="btn btn-primary w-100">

                <i class="fa-solid fa-paper-plane me-2"></i>

                Send Login Credentials

            </button>

        </form>


        <div class="text-center mt-4">

            <a asp-controller="Account"
               asp-action="TPOLogin">

                <i class="fa-solid fa-arrow-left me-1"></i>

                Back to TPO Login

            </a>

        </div>

    </div>

</div>