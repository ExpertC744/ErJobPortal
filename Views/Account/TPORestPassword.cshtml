@model ErJobPortal.Models.TPORestPassword

@{
    ViewData["Title"] = "TPO Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>TPO Reset Password  </title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            font-family: "Inter", sans-serif;
        }

        body {
            background: radial-gradient(circle at 10% 10%, rgba(20, 184, 166, 0.10), transparent 28%), radial-gradient(circle at 90% 90%, rgba(13, 148, 136, 0.08), transparent 28%), #f5faf8;
            color: #0f172a;
        }

        /* =========================================================
                   PAGE
                ========================================================= */

        .reset-page {
            min-height: 100vh;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }

            /* =========================================================
                   BACKGROUND DECORATION
                ========================================================= */

            .reset-page::before {
                content: "";
                position: absolute;
                width: 260px;
                height: 260px;
                border-radius: 50%;
                background: rgba(45, 212, 191, 0.08);
                top: -120px;
                left: -100px;
                pointer-events: none;
            }

            .reset-page::after {
                content: "";
                position: absolute;
                width: 300px;
                height: 300px;
                border-radius: 50%;
                background: rgba(13, 148, 136, 0.06);
                bottom: -150px;
                right: -120px;
                pointer-events: none;
            }

        /* =========================================================
                   CARD
                ========================================================= */

        .reset-card {
            width: 100%;
            max-width: 430px;
            background: #ffffff;
            border: 1px solid rgba(13, 148, 136, 0.10);
            border-radius: 24px;
            padding: 30px 34px 24px;
            position: relative;
            z-index: 2;
            box-shadow: 0 18px 45px rgba(15, 118, 110, 0.10), 0 4px 12px rgba(15, 23, 42, 0.04);
        }

        /* =========================================================
                   TOP ACCENT
                ========================================================= */

        .card-accent {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 70px;
            height: 4px;
            border-radius: 0 0 10px 10px;
            background: linear-gradient( 90deg, #0f766e, #14b8a6 );
        }

        /* =========================================================
                   HEADER
                ========================================================= */

        .reset-header {
            text-align: center;
            margin-bottom: 22px;
        }

        .reset-icon {
            width: 54px;
            height: 54px;
            margin: 0 auto 12px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: linear-gradient( 135deg, #ccfbf1, #f0fdfa );
            color: #0d9488;
            border: 1px solid #d5f5ee;
            box-shadow: 0 8px 18px rgba(13, 148, 136, 0.10);
        }

            .reset-icon i {
                font-size: 22px;
            }

        .reset-title {
            margin: 0;
            font-size: 24px;
            line-height: 1.25;
            font-weight: 800;
            letter-spacing: -0.6px;
            color: #0f172a;
        }

        .reset-subtitle {
            margin: 6px 0 0;
            font-size: 11px;
            line-height: 1.5;
            color: #64748b;
        }

        /* =========================================================
                   ALERT
                ========================================================= */

        .reset-alert {
            display: flex;
            align-items: center;
            gap: 8px;
            border-radius: 10px;
            padding: 9px 11px;
            margin-bottom: 14px;
            font-size: 11px;
            line-height: 1.4;
        }

            .reset-alert i {
                font-size: 12px;
                flex-shrink: 0;
            }

        .alert-success {
            color: #166534;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
        }

        /* =========================================================
                   FORM
                ========================================================= */

        .form-group {
            margin-bottom: 14px;
        }

        .form-label {
            display: block;
            margin-bottom: 6px;
            font-size: 11px;
            font-weight: 700;
            color: #334155;
        }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

            .input-wrapper > i.input-icon {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 12px;
                z-index: 2;
                pointer-events: none;
            }

        .reset-input {
            width: 100%;
            height: 43px;
            border: 1px solid #dbe7e4;
            border-radius: 10px;
            background: #fbfefd;
            color: #0f172a;
            padding: 0 42px 0 38px;
            font-size: 12px;
            outline: none;
            transition: all 0.2s ease;
        }

            .reset-input::placeholder {
                color: #a1aebd;
            }

            .reset-input:focus {
                border-color: #14b8a6;
                background: #ffffff;
                box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.10);
            }

        /* =========================================================
                   PASSWORD TOGGLE
                ========================================================= */

        .password-toggle {
            position: absolute;
            right: 7px;
            top: 50%;
            transform: translateY(-50%);
            width: 29px;
            height: 29px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 8px;
            background: transparent;
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.2s ease;
        }

            .password-toggle:hover {
                color: #0d9488;
                background: #f0fdfa;
            }

            .password-toggle i {
                font-size: 12px;
            }

        /* =========================================================
                   VALIDATION
                ========================================================= */

        .validation-summary {
            font-size: 11px;
            color: #dc2626;
            margin-bottom: 12px;
        }

        .field-validation {
            display: block;
            margin-top: 4px;
            font-size: 10px;
            line-height: 1.3;
            color: #dc2626;
        }

        .input-validation-error {
            border-color: #ef4444 !important;
        }

            .input-validation-error:focus {
                box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.08);
            }

        /* =========================================================
                   RESET BUTTON
                ========================================================= */

        .reset-button {
            min-width: 155px;
            height: 40px;
            padding: 0 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            margin: 4px auto 0;
            border: 0;
            border-radius: 10px;
            background: linear-gradient( 135deg, #0f766e, #0d9488 );
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            box-shadow: 0 7px 16px rgba(13, 148, 136, 0.20);
            transition: all 0.2s ease;
        }

            .reset-button:hover {
                transform: translateY(-1px);
                box-shadow: 0 9px 20px rgba(13, 148, 136, 0.25);
            }

            .reset-button:active {
                transform: translateY(0);
            }

            .reset-button i {
                font-size: 11px;
            }

        /* =========================================================
                   BACK LINK
                ========================================================= */

        .back-login {
            text-align: center;
            margin-top: 17px;
        }

            .back-login a {
                color: #0d9488;
                font-size: 11px;
                font-weight: 600;
                text-decoration: none;
                transition: color 0.2s ease;
            }

                .back-login a:hover {
                    color: #0f766e;
                    text-decoration: underline;
                }

            .back-login i {
                font-size: 10px;
            }

        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 600px) {

            .reset-page {
                padding: 16px;
            }

            .reset-card {
                max-width: 430px;
                padding: 28px 26px 22px;
            }
        }

        @@media (max-width: 480px) {

            .reset-page {
                padding: 14px;
            }

            .reset-card {
                border-radius: 20px;
                padding: 26px 20px 20px;
            }

            .reset-title {
                font-size: 22px;
            }

            .reset-icon {
                width: 50px;
                height: 50px;
                border-radius: 14px;
            }

                .reset-icon i {
                    font-size: 20px;
                }
        }

        @@media (max-width: 360px) {

            .reset-page {
                padding: 10px;
            }

            .reset-card {
                border-radius: 18px;
                padding: 23px 16px 18px;
            }

            .reset-title {
                font-size: 20px;
            }

            .reset-subtitle {
                display: none;
            }

            .form-group {
                margin-bottom: 12px;
            }

            .reset-input {
                height: 41px;
            }

            .reset-button {
                width: 100%;
            }
        }

    </style>

</head>

<body>

    <div class="reset-page">

        <div class="reset-card">

            <div class="card-accent"></div>


            <!-- HEADER -->

            <div class="reset-header">

                <div class="reset-icon">
                    <i class="fa-solid fa-building-columns"></i>
                </div>

                <h1 class="reset-title">
                     Reset Password
                </h1>

                <p class="reset-subtitle">
                    Enter your registered college email and create a new password.
                </p>

            </div>


            <!-- SUCCESS MESSAGE -->
            @if (TempData["Success"] != null)
            {
                <div class="reset-alert alert-success">

                    <i class="fa-solid fa-circle-check"></i>

                    <span>
                        @TempData["Success"]
                    </span>

                </div>
            }


            <!-- FORM -->

            <form asp-controller="Account"
                  asp-action="TPORestPassword"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDATION SUMMARY -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>


                <!-- COLLEGE EMAIL -->

                <div class="form-group">

                    <label asp-for="CollegeMailID"
                           class="form-label">
                        College Email ID
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-envelope input-icon"></i>

                        <input asp-for="CollegeMailID"
                               class="reset-input"
                               placeholder="Enter registered college email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="CollegeMailID"
                          class="field-validation">
                    </span>

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label asp-for="NewPassword"
                           class="form-label">
                        New Password
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-lock input-icon"></i>

                        <input asp-for="NewPassword"
                               id="tpoNewPassword"
                               class="reset-input"
                               placeholder="Enter new password"
                               autocomplete="new-password"
                               type="password" />

                        <button type="button"
                                class="password-toggle"
                                id="toggleTpoNewPassword"
                                aria-label="Show password">

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="field-validation">
                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        Confirm New Password
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-lock input-icon"></i>

                        <input asp-for="ConfirmPassword"
                               id="tpoConfirmPassword"
                               class="reset-input"
                               placeholder="Confirm new password"
                               autocomplete="new-password"
                               type="password" />

                        <button type="button"
                                class="password-toggle"
                                id="toggleTpoConfirmPassword"
                                aria-label="Show password">

                            <i class="fa-solid fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="field-validation">
                    </span>

                </div>


                <!-- RESET BUTTON -->

                <button type="submit"
                        class="reset-button">

                    <i class="fa-solid fa-key"></i>

                    <span>Reset Password</span>

                </button>

            </form>


            <!-- BACK TO LOGIN -->

            <div class="back-login">

                <a asp-controller="Account"
                   asp-action="TPOLogin">

                    <i class="fa-solid fa-arrow-left me-1"></i>

                    Back to TPO Login

                </a>

            </div>

        </div>

    </div>


    <!-- PASSWORD TOGGLE -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            function setupPasswordToggle(inputId, buttonId) {

                const input = document.getElementById(inputId);
                const button = document.getElementById(buttonId);

                if (!input || !button) {
                    return;
                }

                const icon = button.querySelector("i");

                button.addEventListener("click", function () {

                    if (input.type === "password") {

                        input.type = "text";

                        icon.classList.remove("fa-eye");
                        icon.classList.add("fa-eye-slash");

                        button.setAttribute(
                            "aria-label",
                            "Hide password"
                        );

                    } else {

                        input.type = "password";

                        icon.classList.remove("fa-eye-slash");
                        icon.classList.add("fa-eye");

                        button.setAttribute(
                            "aria-label",
                            "Show password"
                        );
                    }

                });

            }


            setupPasswordToggle(
                "tpoNewPassword",
                "toggleTpoNewPassword"
            );

            setupPasswordToggle(
                "tpoConfirmPassword",
                "toggleTpoConfirmPassword"
            );

        });

    </script>


    @section Scripts
    {
        @{
            await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
            );
        }
    }

</body>

</html>