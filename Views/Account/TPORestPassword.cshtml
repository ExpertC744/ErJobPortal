@model ErJobPortal.Models.TPORestPassword

@{
    ViewData["Title"] = "TPO Reset Password";
}

<div class="login-page">

    <div class="login-card">

        <div class="text-center mb-4">

            <div class="login-icon">
                <i class="fa-solid fa-lock"></i>
            </div>

            <h2>TPO Reset Password</h2>

            <p class="text-muted">
                Enter your registered college email and create a new password.
            </p>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }


        <form asp-controller="Account"
              asp-action="TPORestPassword"
              method="post">

            @Html.AntiForgeryToken()


            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>


            <!-- COLLEGE EMAIL -->

            <div class="mb-3">

                <label asp-for="CollegeMailID"
                       class="form-label">
                    College Email ID
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="fa-solid fa-envelope"></i>
                    </span>

                    <input asp-for="CollegeMailID"
                           class="form-control"
                           placeholder="Enter registered college email"
                           autocomplete="email" />

                </div>

                <span asp-validation-for="CollegeMailID"
                      class="text-danger">
                </span>

            </div>


            <!-- NEW PASSWORD -->

            <div class="mb-3">

                <label asp-for="NewPassword"
                       class="form-label">
                    New Password
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="fa-solid fa-lock"></i>
                    </span>

                    <input asp-for="NewPassword"
                           class="form-control"
                           placeholder="Enter new password"
                           autocomplete="new-password" />

                </div>

                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- CONFIRM PASSWORD -->

            <div class="mb-3">

                <label asp-for="ConfirmPassword"
                       class="form-label">
                    Confirm New Password
                </label>

                <div class="input-group">

                    <span class="input-group-text">
                        <i class="fa-solid fa-lock"></i>
                    </span>

                    <input asp-for="ConfirmPassword"
                           class="form-control"
                           placeholder="Confirm new password"
                           autocomplete="new-password" />

                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- RESET BUTTON -->

            <button type="submit"
                    class="btn btn-primary w-100">

                <i class="fa-solid fa-key me-2"></i>

                Reset Password

            </button>

        </form>


        <!-- BACK TO LOGIN -->

        <div class="text-center mt-4">

            <a asp-controller="Account"
               asp-action="TPOLogin">

                <i class="fa-solid fa-arrow-left me-1"></i>

                Back to TPO Login

            </a>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial"
        );
    }
}