@model ErJobPortal.Models.CandidateResetPassword

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reset Password - 1Trainee</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <!-- Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />


    <style>

        /* =========================================================
                   RESET
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
            font-family: "Inter", sans-serif;
        }


        body {
            background: radial-gradient( circle at 10% 10%, rgba(20, 184, 166, 0.13), transparent 28% ), radial-gradient( circle at 90% 90%, rgba(13, 148, 136, 0.09), transparent 30% ), #f5faf8;
            color: #0f172a;
        }


        /* =========================================================
                   PAGE
                ========================================================= */

        .reset-page {
            width: 100%;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            position: relative;
            overflow: hidden;
        }


            /* =========================================================
                   BACKGROUND DECORATION
                ========================================================= */

            .reset-page::before {
                content: "";
                position: absolute;
                width: 330px;
                height: 330px;
                border-radius: 50%;
                top: -180px;
                left: -150px;
                background: rgba(20, 184, 166, 0.07);
                pointer-events: none;
            }


            .reset-page::after {
                content: "";
                position: absolute;
                width: 360px;
                height: 360px;
                border-radius: 50%;
                right: -190px;
                bottom: -190px;
                background: rgba(13, 148, 136, 0.06);
                pointer-events: none;
            }


        /* =========================================================
                   CARD
                ========================================================= */

        .reset-card {
            width: 100%;
            max-width: 430px;
            background: #ffffff;
            border-radius: 24px;
            padding: 30px 34px 24px;
            position: relative;
            z-index: 2;
            border: 1px solid rgba(13, 148, 136, 0.10);
            box-shadow: 0 25px 60px rgba(15, 118, 110, 0.12), 0 5px 18px rgba(15, 23, 42, 0.04);
        }


        /* =========================================================
                   TOP ACCENT
                ========================================================= */

        .card-accent {
            position: absolute;
            top: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 70px;
            height: 4px;
            border-radius: 0 0 10px 10px;
            background: linear-gradient( 90deg, #0f766e, #14b8a6 );
        }


        /* =========================================================
                   HEADER
                ========================================================= */

        .reset-header {
            text-align: center;
            margin-bottom: 22px;
        }


        .reset-icon {
            width: 54px;
            height: 54px;
            margin: 0 auto 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 16px;
            background: linear-gradient( 145deg, #ccfbf1, #f0fdfa );
            color: #0d9488;
            font-size: 21px;
            border: 1px solid #d5f5ee;
            box-shadow: 0 8px 20px rgba(13, 148, 136, 0.10);
        }


        .reset-title {
            color: #0f172a;
            font-size: 24px;
            line-height: 1.2;
            font-weight: 800;
            letter-spacing: -0.6px;
        }


        .reset-subtitle {
            margin-top: 6px;
            color: #64748b;
            font-size: 11px;
            font-weight: 500;
        }


        /* =========================================================
                   ALERT
                ========================================================= */

        .alert {
            display: flex;
            align-items: center;
            border-radius: 10px;
            padding: 9px 11px;
            margin-bottom: 13px;
            font-size: 11px;
            border: 0;
        }


        /* =========================================================
                   FORM
                ========================================================= */

        .form-group {
            margin-bottom: 14px;
        }


        .form-label {
            display: block;
            color: #334155;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 6px;
        }


        .input-wrapper {
            position: relative;
        }


        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 12px;
            pointer-events: none;
            z-index: 2;
        }


        .form-control {
            width: 100%;
            height: 43px;
            border: 1px solid #dbe7e4;
            border-radius: 10px;
            background: #fbfefd;
            color: #0f172a;
            padding: 0 42px 0 38px;
            font-size: 12px;
            font-weight: 500;
            box-shadow: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
        }


            .form-control:hover {
                border-color: #b9dcd6;
            }


            .form-control:focus {
                border-color: #14b8a6;
                background: #ffffff;
                outline: none;
                box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.10);
            }


            .form-control::placeholder {
                color: #a7b1bd;
                font-weight: 400;
            }


        /* =========================================================
                   PASSWORD TOGGLE
                ========================================================= */

        .password-toggle {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            width: 29px;
            height: 29px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: 0;
            border-radius: 7px;
            background: transparent;
            color: #94a3b8;
            cursor: pointer;
            transition: all 0.2s ease;
        }


            .password-toggle:hover {
                background: #ecfdf9;
                color: #0d9488;
            }


            .password-toggle:focus {
                outline: none;
                background: #ecfdf9;
                color: #0d9488;
            }


        /* =========================================================
                   VALIDATION
                ========================================================= */

        .validation-summary-errors {
            color: #dc2626;
            font-size: 11px;
            margin-bottom: 12px;
        }


        .field-validation-error {
            display: block;
            color: #dc2626;
            font-size: 10px;
            margin-top: 4px;
        }


        /* =========================================================
                   SHORT BUTTON
                ========================================================= */

        .reset-button {
            width: auto;
            min-width: 155px;
            height: 40px;
            margin: 5px auto 0;
            padding: 0 22px;
            border: 0;
            border-radius: 9px;
            background: linear-gradient( 135deg, #0f766e 0%, #0d9488 100% );
            color: #ffffff;
            font-size: 11px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            cursor: pointer;
            box-shadow: 0 7px 16px rgba(13, 148, 136, 0.20);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }


            .reset-button:hover {
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(13, 148, 136, 0.25);
            }


            .reset-button:active {
                transform: translateY(0);
            }


            .reset-button i {
                font-size: 10px;
            }


        /* =========================================================
                   BUTTON CONTAINER
                ========================================================= */

        .button-container {
            width: 100%;
            display: flex;
            justify-content: center;
        }


        /* =========================================================
                   BACK LINK
                ========================================================= */

        .back-login {
            text-align: center;
            margin-top: 14px;
        }


            .back-login a {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 6px;
                color: #0d9488;
                font-size: 11px;
                font-weight: 600;
                text-decoration: none;
                transition: color 0.2s ease;
            }


                .back-login a:hover {
                    color: #0f766e;
                }


            .back-login i {
                font-size: 10px;
            }


        /* =========================================================
                   TABLET
                ========================================================= */

        @@media (max-width: 600px) {

            .reset-page {
                padding: 15px;
            }


            .reset-card {
                max-width: 410px;
                padding: 28px 28px 23px;
                border-radius: 21px;
            }


            .reset-title {
                font-size: 23px;
            }
        }


        /* =========================================================
                   MOBILE
                ========================================================= */

        @@media (max-width: 480px) {

            .reset-page {
                padding: 12px;
            }


            .reset-card {
                max-width: 100%;
                padding: 25px 21px 21px;
                border-radius: 19px;
            }


            .reset-header {
                margin-bottom: 19px;
            }


            .reset-icon {
                width: 49px;
                height: 49px;
                border-radius: 14px;
                font-size: 19px;
                margin-bottom: 11px;
            }


            .reset-title {
                font-size: 21px;
            }


            .reset-subtitle {
                font-size: 10px;
            }


            .form-group {
                margin-bottom: 12px;
            }


            .form-control {
                height: 41px;
            }


            .reset-button {
                min-width: 145px;
                height: 39px;
                padding: 0 19px;
            }
        }


        /* =========================================================
                   SMALL MOBILE
                ========================================================= */

        @@media (max-width: 360px) {

            .reset-page {
                padding: 8px;
            }


            .reset-card {
                padding: 22px 17px 18px;
                border-radius: 17px;
            }


            .reset-header {
                margin-bottom: 16px;
            }


            .reset-icon {
                width: 44px;
                height: 44px;
                font-size: 17px;
            }


            .reset-title {
                font-size: 19px;
            }


            .reset-subtitle {
                display: none;
            }


            .form-label {
                font-size: 10px;
            }


            .form-control {
                height: 39px;
                font-size: 11px;
            }


            .reset-button {
                min-width: 135px;
                height: 38px;
                padding: 0 17px;
                font-size: 10px;
            }


            .back-login {
                margin-top: 11px;
            }
        }

    </style>

</head>


<body>

    <main class="reset-page">

        <div class="reset-card">

            <div class="card-accent"></div>


            <!-- =========================================
                 HEADER
            ========================================== -->

            <div class="reset-header">

                <div class="reset-icon">
                    <i class="fas fa-key"></i>
                </div>

                <h1 class="reset-title">
                    Reset Password
                </h1>

                <div class="reset-subtitle">
                    Update your account password
                </div>

            </div>


            <!-- =========================================
                 ERROR
            ========================================== -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">

                    <i class="fas fa-circle-exclamation me-2"></i>

                    @TempData["Error"]

                </div>
            }


            <!-- =========================================
                 SUCCESS
            ========================================== -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">

                    <i class="fas fa-circle-check me-2"></i>

                    @TempData["Success"]

                </div>
            }


            <!-- =========================================
                 VALIDATION
            ========================================== -->

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-errors">
            </div>


            <!-- =========================================
                 FORM
            ========================================== -->

            <form asp-controller="Account"
                  asp-action="CandidateResetPassword"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- EMAIL -->

                <div class="form-group">

                    <label asp-for="sEmail"
                           class="form-label">
                        Registered Email
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-envelope input-icon"></i>

                        <input asp-for="sEmail"
                               class="form-control"
                               placeholder="Enter registered email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="sEmail"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- NEW PASSWORD -->

                <div class="form-group">

                    <label asp-for="NewPassword"
                           class="form-label">
                        New Password
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-lock input-icon"></i>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control"
                               id="newPassword"
                               placeholder="Enter new password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                id="toggleNewPassword"
                                aria-label="Show password">

                            <i class="fas fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- CONFIRM PASSWORD -->

                <div class="form-group">

                    <label asp-for="ConfirmPassword"
                           class="form-label">
                        Confirm Password
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-lock input-icon"></i>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               id="confirmPassword"
                               placeholder="Confirm new password"
                               autocomplete="new-password" />

                        <button type="button"
                                class="password-toggle"
                                id="toggleConfirmPassword"
                                aria-label="Show password">

                            <i class="fas fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- BUTTON -->

                <div class="button-container">

                    <button type="submit"
                            class="reset-button">

                        <i class="fas fa-key"></i>

                        Reset Password

                    </button>

                </div>

            </form>


            <!-- =========================================
                 BACK
            ========================================== -->

            <div class="back-login">

                <a asp-controller="Account"
                   asp-action="CandidateLogin">

                    <i class="fas fa-arrow-left"></i>

                    Back to Login

                </a>

            </div>

        </div>

    </main>


    <!-- VALIDATION -->

    <partial name="_ValidationScriptsPartial" />


    <!-- PASSWORD TOGGLE -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            function setupPasswordToggle(inputId, toggleId) {

                const input = document.getElementById(inputId);
                const toggle = document.getElementById(toggleId);

                if (!input || !toggle) {
                    return;
                }

                toggle.addEventListener("click", function () {

                    const icon = toggle.querySelector("i");

                    if (input.type === "password") {

                        input.type = "text";

                        icon.classList.remove("fa-eye");
                        icon.classList.add("fa-eye-slash");

                        toggle.setAttribute(
                            "aria-label",
                            "Hide password"
                        );

                    }
                    else {

                        input.type = "password";

                        icon.classList.remove("fa-eye-slash");
                        icon.classList.add("fa-eye");

                        toggle.setAttribute(
                            "aria-label",
                            "Show password"
                        );

                    }

                });

            }


            setupPasswordToggle(
                "newPassword",
                "toggleNewPassword"
            );


            setupPasswordToggle(
                "confirmPassword",
                "toggleConfirmPassword"
            );

        });

    </script>

</body>

</html>