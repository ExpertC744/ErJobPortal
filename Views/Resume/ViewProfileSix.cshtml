@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Creative Editorial";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }

        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);

    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(Has(candidateName)
            ? candidateName + " - Resume"
            : "Resume")
    </title>


    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />


    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap"
          rel="stylesheet" />


    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <style>

        /* =========================================================
                   ROOT
                ========================================================= */

        :root {
            --primary: #263b47;
            --primary-light: #edf2f3;
            --accent: #b4773c;
            --accent-light: #f5ece3;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
            --soft: #f6f7f7;
            --white: #ffffff;
        }


        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
        }


        body {
            background: #e9edef;
            color: var(--text);
            font-family: "DM Sans", Arial, sans-serif;
        }


        /* =========================================================
                   TOOLBAR
                ========================================================= */

        .resume-toolbar {
            width: 297mm;
            max-width: calc(100% - 30px);
            margin: 14px auto 8px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }


            .resume-toolbar button,
            .resume-toolbar a {
                border: 0;
                min-height: 32px;
                padding: 8px 14px;
                border-radius: 5px;
                font-family: "DM Sans";
                font-size: 10px;
                font-weight: 700;
                text-decoration: none;
                cursor: pointer;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }


        .btn-edit {
            background: #ffffff;
            color: var(--primary);
            border: 1px solid var(--border) !important;
        }


        .btn-print {
            background: var(--primary);
            color: white;
        }


        .btn-download {
            background: var(--accent);
            color: white;
        }


        /* =========================================================
                   THEMES
                ========================================================= */

        .theme-switcher {
            width: 297mm;
            max-width: calc(100% - 30px);
            margin: 0 auto 10px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }


            .theme-switcher span {
                font-size: 9px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .6px;
            }


        .theme-swatch {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid white;
            cursor: pointer;
            box-shadow: 0 1px 5px rgba(0,0,0,.15);
        }


            .theme-swatch.active {
                box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch);
            }


        /* =========================================================
                   PAGE
                ========================================================= */

        .resume-page-wrapper {
            display: flex;
            justify-content: center;
            padding: 5px 0 25px;
        }


        .resume-sheet {
            width: 297mm;
            height: 210mm;
            background: white;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(20,40,50,.14);
            --theme: #263b47;
            --theme-soft: #edf2f3;
            --accent-color: #b4773c;
            --accent-soft: #f5ece3;
        }


            /* =========================================================
                   THEMES
                ========================================================= */

            .resume-sheet[data-theme="navy"] {
                --theme: #263b47;
                --theme-soft: #edf2f3;
                --accent-color: #b4773c;
                --accent-soft: #f5ece3;
            }


            .resume-sheet[data-theme="teal"] {
                --theme: #245f61;
                --theme-soft: #e8f2f2;
                --accent-color: #a87842;
                --accent-soft: #f5eee6;
            }


            .resume-sheet[data-theme="olive"] {
                --theme: #4f5d45;
                --theme-soft: #eef2eb;
                --accent-color: #a4783e;
                --accent-soft: #f5eee5;
            }


            .resume-sheet[data-theme="blue"] {
                --theme: #315875;
                --theme-soft: #eaf0f5;
                --accent-color: #b4773c;
                --accent-soft: #f6eee5;
            }


            .resume-sheet[data-theme="brown"] {
                --theme: #654d3b;
                --theme-soft: #f3eeea;
                --accent-color: #9d7040;
                --accent-soft: #f5eee6;
            }


        /* =========================================================
                   TOP CREATIVE HEADER
                ========================================================= */

        .creative-header {
            height: 61mm;
            display: grid;
            grid-template-columns: 63% 37%;
            position: relative;
            background: #ffffff;
            border-bottom: 1px solid var(--border);
        }


        /* =========================================================
                   HEADER LEFT
                ========================================================= */

        .header-main {
            position: relative;
            padding: 10mm 8mm 8mm 18mm;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }


            .header-main::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 7px;
                height: 100%;
                background: var(--theme);
            }


        .small-label {
            font-size: 8px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--accent-color);
            margin-bottom: 6px;
        }


        .candidate-name {
            font-family: "Libre Baskerville", Georgia, serif;
            font-size: 30px;
            line-height: 1.12;
            font-weight: 700;
            color: var(--theme);
            max-width: 175mm;
        }


        .candidate-role {
            margin-top: 7px;
            font-size: 11px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 1.2px;
        }


        .header-description {
            margin-top: 9px;
            max-width: 150mm;
            font-size: 9px;
            line-height: 1.5;
            color: #748188;
        }


        /* =========================================================
                   HEADER RIGHT
                ========================================================= */

        .header-side {
            background: var(--theme-soft);
            position: relative;
            padding: 8mm 14mm 8mm 20mm;
            display: flex;
            align-items: center;
        }


            .header-side::before {
                content: "";
                position: absolute;
                left: -14mm;
                top: 0;
                width: 28mm;
                height: 100%;
                background: linear-gradient( 135deg, transparent 50%, var(--theme-soft) 50% );
            }


        .profile-photo {
            position: relative;
            width: 32mm;
            height: 32mm;
            object-fit: cover;
            border-radius: 6px;
            border: 4px solid #ffffff;
            box-shadow: 0 5px 18px rgba(30,50,60,.15);
            margin-right: 12mm;
        }


        .profile-placeholder {
            position: relative;
            width: 32mm;
            height: 32mm;
            border-radius: 6px;
            background: #ffffff;
            border: 1px solid var(--border);
            color: var(--theme);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            margin-right: 12mm;
        }


        .header-contact {
            position: relative;
            display: flex;
            flex-direction: column;
            gap: 7px;
        }


        .contact-row {
            display: flex;
            align-items: flex-start;
            gap: 7px;
            font-size: 8.5px;
            color: #5e6d74;
            line-height: 1.4;
        }


            .contact-row i {
                color: var(--accent-color);
                width: 13px;
                margin-top: 1px;
            }


        /* =========================================================
                   BODY
                ========================================================= */

        .resume-body {
            height: calc(210mm - 61mm);
            display: grid;
            grid-template-columns: 74mm 1fr;
        }


        /* =========================================================
                   LEFT SIDE
                ========================================================= */

        .left-panel {
            background: #f8f9f9;
            border-right: 1px solid var(--border);
            padding: 7mm 8mm 7mm 10mm;
            overflow: hidden;
        }


        /* =========================================================
                   RIGHT SIDE
                ========================================================= */

        .right-panel {
            padding: 7mm 11mm 7mm 10mm;
            overflow: hidden;
        }


        /* =========================================================
                   SECTION
                ========================================================= */

        .section {
            margin-bottom: 13px;
            break-inside: avoid;
        }


        .section-heading {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 7px;
        }


        .section-number {
            font-family: "Libre Baskerville", Georgia, serif;
            font-size: 9px;
            font-weight: 700;
            color: var(--accent-color);
        }


        .section-title {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--theme);
        }


        .section-line {
            flex: 1;
            height: 1px;
            background: var(--border);
        }


        /* =========================================================
                   SUMMARY
                ========================================================= */

        .summary {
            font-size: 9.5px;
            line-height: 1.65;
            color: #596a72;
            text-align: justify;
        }


        /* =========================================================
                   SKILLS
                ========================================================= */

        .skill-category {
            margin-bottom: 9px;
        }


        .skill-category-title {
            font-size: 7.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .9px;
            color: #8a969c;
            margin-bottom: 5px;
        }


        .skill-list {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
        }


        .skill {
            padding: 4px 7px;
            border: 1px solid var(--border);
            background: #ffffff;
            border-radius: 3px;
            font-size: 8px;
            font-weight: 600;
            color: #4d6069;
        }


            .skill:first-letter {
                color: var(--accent-color);
            }


        /* =========================================================
                   LANGUAGES
                ========================================================= */

        .language-row {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: center;
            padding: 5px 0;
            border-bottom: 1px solid var(--border);
            font-size: 8.5px;
        }


        .language-name {
            font-weight: 650;
            color: #53656d;
        }


        .language-level {
            font-size: 7.5px;
            font-weight: 700;
            color: var(--accent-color);
        }


        /* =========================================================
                   INTERESTS
                ========================================================= */

        .interest-text {
            padding-left: 10px;
            border-left: 2px solid var(--accent-color);
            font-size: 8.8px;
            line-height: 1.55;
            color: #65747b;
        }


        /* =========================================================
                   SOCIAL
                ========================================================= */

        .social-row {
            display: flex;
            gap: 7px;
            margin-bottom: 6px;
            font-size: 8px;
            line-height: 1.4;
            color: #64737a;
            word-break: break-word;
        }


            .social-row i {
                color: var(--theme);
                width: 13px;
                flex-shrink: 0;
            }


        /* =========================================================
                   EXPERIENCE TIMELINE
                ========================================================= */

        .timeline {
            position: relative;
            margin-left: 3px;
            padding-left: 19px;
        }


            .timeline::before {
                content: "";
                position: absolute;
                left: 4px;
                top: 5px;
                bottom: 5px;
                width: 1px;
                background: #d8e0e3;
            }


        .timeline-item {
            position: relative;
            margin-bottom: 11px;
        }


            .timeline-item:last-child {
                margin-bottom: 0;
            }


            .timeline-item::before {
                content: "";
                position: absolute;
                left: -19px;
                top: 4px;
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #ffffff;
                border: 2px solid var(--accent-color);
            }


        .experience-title {
            font-size: 10px;
            font-weight: 800;
            color: var(--theme);
            line-height: 1.35;
        }


        .experience-company {
            font-size: 9.5px;
            font-weight: 700;
            color: #5b6d75;
            margin-top: 2px;
        }


        .experience-meta {
            margin-top: 3px;
            font-size: 8px;
            color: #879399;
        }


        /* =========================================================
                   EDUCATION
                ========================================================= */

        .education-strip {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }


        .education-item {
            position: relative;
            padding: 8px;
            background: var(--theme-soft);
            border-top: 2px solid var(--theme);
            min-height: 43px;
        }


        .education-year {
            font-size: 8px;
            font-weight: 800;
            color: var(--accent-color);
        }


        .education-title {
            margin-top: 3px;
            font-size: 8.5px;
            font-weight: 750;
            line-height: 1.3;
            color: #425660;
        }


        .education-type {
            margin-top: 2px;
            font-size: 7px;
            color: #7b898f;
        }


        /* =========================================================
                   ACHIEVEMENTS
                ========================================================= */

        .achievement-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 7px;
        }


        .achievement {
            padding: 8px 9px;
            border: 1px solid var(--border);
            background: #ffffff;
            position: relative;
        }


        .achievement-number {
            font-family: "Libre Baskerville", Georgia, serif;
            font-size: 16px;
            font-weight: 700;
            color: var(--accent-color);
            opacity: .75;
        }


        .achievement-text {
            margin-top: 3px;
            font-size: 8.5px;
            line-height: 1.45;
            color: #596a72;
        }


        /* =========================================================
                   REFERENCES
                ========================================================= */

        .reference-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }


        .reference {
            padding: 7px 9px;
            border-left: 3px solid var(--theme);
            background: var(--soft);
        }


        .reference-name {
            font-size: 9px;
            font-weight: 750;
            color: var(--theme);
        }


        .reference-relation {
            font-size: 7.5px;
            color: var(--accent-color);
            margin-top: 2px;
        }


        .reference-phone {
            margin-top: 3px;
            font-size: 7.8px;
            color: #76848a;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1200px) {

            .resume-toolbar,
            .theme-switcher {
                width: 100%;
                padding-left: 12px;
                padding-right: 12px;
            }


            .resume-sheet {
                transform: scale(.78);
                transform-origin: top center;
                margin-bottom: -42mm;
            }
        }


        @@media (max-width: 768px) {

            .resume-sheet {
                transform: scale(.55);
                margin-bottom: -95mm;
            }
        }


        /* =========================================================
                   PRINT
                ========================================================= */

        @@media print {

            html,
            body {
                width: 297mm;
                height: 210mm;
                background: white;
            }


            .resume-toolbar,
            .theme-switcher {
                display: none !important;
            }


            .resume-page-wrapper {
                padding: 0;
            }


            .resume-sheet {
                width: 297mm;
                height: 210mm;
                margin: 0;
                box-shadow: none;
                transform: none;
            }


            @@page {
                size: A4 landscape;
                margin: 0;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         TOOLBAR
    ========================================================== -->

    <div class="resume-toolbar">

        <a asp-controller="Candidate"
           asp-action="Profile"
           class="btn-edit">

            <i class="fa fa-pen"></i>

            Edit

        </a>


        <button type="button"
                class="btn-print"
                onclick="window.print()">

            <i class="fa fa-print"></i>

            Print / PDF

        </button>


        <button type="button"
                class="btn-download"
                onclick="downloadResumePDF()">

            <i class="fa fa-download"></i>

            Download

        </button>

    </div>


    <!-- =========================================================
         THEMES
    ========================================================== -->

    <div class="theme-switcher">

        <span>Theme</span>


        <div class="theme-swatch active"
             data-theme="navy"
             style="background:#263b47;--swatch:#263b47">
        </div>


        <div class="theme-swatch"
             data-theme="teal"
             style="background:#245f61;--swatch:#245f61">
        </div>


        <div class="theme-swatch"
             data-theme="olive"
             style="background:#4f5d45;--swatch:#4f5d45">
        </div>


        <div class="theme-swatch"
             data-theme="blue"
             style="background:#315875;--swatch:#315875">
        </div>


        <div class="theme-swatch"
             data-theme="brown"
             style="background:#654d3b;--swatch:#654d3b">
        </div>

    </div>


    <!-- =========================================================
         RESUME
    ========================================================== -->

    <div class="resume-page-wrapper">

        <div class="resume-sheet"
             id="resumeSheet"
             data-theme="navy">


            <!-- =================================================
                 CREATIVE HEADER
            ================================================= -->

            <header class="creative-header">


                <!-- LEFT HEADER -->

                <div class="header-main">

                    <div class="small-label">
                        Professional Resume
                    </div>


                    @if (Has(candidateName))
                    {
                        <div class="candidate-name">
                            @candidateName
                        </div>
                    }


                    @if (Has(candidateRole))
                    {
                        <div class="candidate-role">
                            @candidateRole
                        </div>
                    }


                    @if (Has(p.Objective))
                    {
                        <div class="header-description">

                            @p.Objective

                        </div>
                    }

                </div>


                <!-- RIGHT HEADER -->

                <div class="header-side">


                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto"
                             class="profile-photo"
                             alt="Profile" />
                    }
                    else
                    {
                        <div class="profile-placeholder">

                            <i class="fa fa-user"></i>

                        </div>
                    }


                    <div class="header-contact">


                        @if (Has(Model.CandidatePhone))
                        {
                            <div class="contact-row">

                                <i class="fa fa-phone"></i>

                                <span>
                                    @Model.CandidatePhone
                                </span>

                            </div>
                        }


                        @if (Has(Model.CandidateEmail))
                        {
                            <div class="contact-row">

                                <i class="fa fa-envelope"></i>

                                <span>
                                    @Model.CandidateEmail
                                </span>

                            </div>
                        }


                        @if (Has(p.Pincode))
                        {
                            <div class="contact-row">

                                <i class="fa fa-location-dot"></i>

                                <span id="rvAddress"
                                      data-country-id="@p.CountryID"
                                      data-state-id="@p.StateID"
                                      data-city-id="@p.CityID"
                                      data-pincode="@p.Pincode">

                                    @p.Pincode

                                </span>

                            </div>
                        }

                    </div>

                </div>

            </header>


            <!-- =================================================
                 TWO COLUMN BODY
            ================================================== -->

            <div class="resume-body">


                <!-- =================================================
                     LEFT PANEL
                ================================================== -->

                <aside class="left-panel">


                    <!-- CONTACT -->

                    <section class="section">

                        <div class="section-heading">

                            <span class="section-number">
                                01
                            </span>

                            <span class="section-title">
                                Contact
                            </span>

                            <span class="section-line"></span>

                        </div>


                        @if (Has(Model.CandidatePhone))
                        {
                            <div class="social-row">

                                <i class="fa fa-phone"></i>

                                <span>
                                    @Model.CandidatePhone
                                </span>

                            </div>
                        }


                        @if (Has(Model.CandidateEmail))
                        {
                            <div class="social-row">

                                <i class="fa fa-envelope"></i>

                                <span>
                                    @Model.CandidateEmail
                                </span>

                            </div>
                        }


                        @if (Has(p.Pincode))
                        {
                            <div class="social-row">

                                <i class="fa fa-location-dot"></i>

                                <span id="rvAddressLeft"
                                      data-country-id="@p.CountryID"
                                      data-state-id="@p.StateID"
                                      data-city-id="@p.CityID"
                                      data-pincode="@p.Pincode">

                                    @p.Pincode

                                </span>

                            </div>
                        }

                    </section>


                    <!-- SKILLS -->
                    @{
                        var skillGroups = new[]
                        {
                    ("Technical", p.sTechnicalSkillIDs),
                    ("Medical", p.sMedicalSkillIDs),
                    ("Non-Technical", p.sNonTechnicalSkillIDs)
                    }
                        .Where(x => Has(x.Item2))
                        .ToList();
                    }


                    @if (skillGroups.Any())
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    02
                                </span>

                                <span class="section-title">
                                    Expertise
                                </span>

                                <span class="section-line"></span>

                            </div>


                            @foreach (var group in skillGroups)
                            {

                                <div class="skill-category">

                                    <div class="skill-category-title">
                                        @group.Item1
                                    </div>


                                    <div class="skill-list">

                                        @foreach (var skill in group.Item2.Split(
                                       new[] { ',', ';', '|' },
                                       StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="skill">
                                                @skill.Trim()
                                            </span>
                                        }

                                    </div>

                                </div>

                            }

                        </section>
                    }


                    <!-- LANGUAGES -->
                    @{
                        var langItems =
                        new List<(string Lang, string Star)>();

                        for (int i = 1; i <= 8; i++)
                        {
                            var lang =
                            typeof(
                            ErJobPortal.Models.CandidateProfileModel
                            )
                            .GetProperty(
                            $"sLanguage{i}"
                            )
                            ?.GetValue(p)
                            ?.ToString();


                            var star =
                            typeof(
                            ErJobPortal.Models.CandidateProfileModel
                            )
                            .GetProperty(
                            $"sLanguageStar{i}"
                            )
                            ?.GetValue(p)
                            ?.ToString();


                            if (Has(lang))
                            {
                                langItems.Add(
                                (lang, star)
                                );
                            }
                        }
                    }


                    @if (langItems.Any())
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    03
                                </span>

                                <span class="section-title">
                                    Languages
                                </span>

                                <span class="section-line"></span>

                            </div>


                            @foreach (var lang in langItems)
                            {
                                <div class="language-row">

                                    <span class="language-name">
                                        @lang.Lang
                                    </span>


                                    @if (Has(lang.Star))
                                    {
                                        <span class="language-level">

                                            @lang.Star ★

                                        </span>
                                    }

                                </div>
                            }

                        </section>
                    }


                    <!-- INTERESTS -->
                    @if (Has(p.sHobbies))
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    04
                                </span>

                                <span class="section-title">
                                    Interests
                                </span>

                                <span class="section-line"></span>

                            </div>


                            <div class="interest-text">

                                @p.sHobbies

                            </div>

                        </section>
                    }


                    <!-- LINKS -->
                    @if (Has(p.GitHub) || Has(p.Linkedin))
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    05
                                </span>

                                <span class="section-title">
                                    Online
                                </span>

                                <span class="section-line"></span>

                            </div>


                            @if (Has(p.GitHub))
                            {
                                <div class="social-row">

                                    <i class="fa-brands fa-github"></i>

                                    <span>
                                        @p.GitHub
                                    </span>

                                </div>
                            }


                            @if (Has(p.Linkedin))
                            {
                                <div class="social-row">

                                    <i class="fa-brands fa-linkedin"></i>

                                    <span>
                                        @p.Linkedin
                                    </span>

                                </div>
                            }

                        </section>
                    }


                </aside>


                <!-- =================================================
                     RIGHT PANEL
                ================================================== -->

                <main class="right-panel">


                    <!-- EXPERIENCE -->
                    @{
                        var internships = new[]
                        {
                    new
                    {
                    Name = p.sOrgName1,
                    Title = p.sOrgIntTitle1,
                    Duration = p.sOrgIntDuration1,
                    Status = p.sOrgIntStatus1
                    },

                    new
                    {
                    Name = p.sOrgName2,
                    Title = p.sOrgIntTitle2,
                    Duration = p.sOrgIntDuration2,
                    Status = p.sOrgIntStatus2
                    },

                    new
                    {
                    Name = p.sOrgName3,
                    Title = p.sOrgIntTitle3,
                    Duration = p.sOrgIntDuration3,
                    Status = p.sOrgIntStatus3
                    },

                    new
                    {
                    Name = p.sOrgName4,
                    Title = p.sOrgIntTitle4,
                    Duration = p.sOrgIntDuration4,
                    Status = p.sOrgIntStatus4
                    }
                    }
                        .Where(x => Has(x.Name))
                        .ToList();
                    }


                    @if (internships.Any())
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    06
                                </span>

                                <span class="section-title">
                                    Experience
                                </span>

                                <span class="section-line"></span>

                            </div>


                            <div class="timeline">

                                @foreach (var exp in internships)
                                {

                                    <div class="timeline-item">


                                        @if (Has(
                                       GetLookupName(
                                       Model.InternshipTitles,
                                       exp.Title
                                       )
                                       ))
                                        {
                                            <div class="experience-title">

                                                @GetLookupName(
                                                         Model.InternshipTitles,
                                                         exp.Title
                                                         )

                                            </div>
                                        }


                                        <div class="experience-company">

                                            @exp.Name

                                        </div>


                                        <div class="experience-meta">

                                            @GetLookupName(
                                                     Model.InternshipDurations,
                                                     exp.Duration
                                                     )


                                            @if (
                                           Has(
                                           GetLookupName(
                                           Model.InternshipStatuses,
                                           exp.Status
                                           )
                                           )
                                           )
                                            {
                                                <span>

                                                    &nbsp;•&nbsp;

                                                    @GetLookupName(
                                                             Model.InternshipStatuses,
                                                             exp.Status
                                                             )

                                                </span>
                                            }

                                        </div>

                                    </div>

                                }

                            </div>

                        </section>
                    }


                    <!-- EDUCATION -->
                    @if (
                    HasNum(p.PG_Year) ||
                    HasNum(p.Graduation_Year) ||
                    HasNum(p.HSC_DIPLOMA_YEAR) ||
                    HasNum(p.SSC_YEAR)
                    )
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    07
                                </span>

                                <span class="section-title">
                                    Education
                                </span>

                                <span class="section-line"></span>

                            </div>


                            <div class="education-strip">


                                @if (HasNum(p.PG_Year))
                                {
                                    <div class="education-item">

                                        <div class="education-year">
                                            @p.PG_Year
                                        </div>

                                        <div class="education-title">

                                            @GetLookupName(
                                                     Model.Streams,
                                                     p.PG_Stream
                                                     )

                                        </div>

                                        <div class="education-type">
                                            Post Graduation
                                        </div>

                                    </div>
                                }


                                @if (HasNum(p.Graduation_Year))
                                {
                                    <div class="education-item">

                                        <div class="education-year">
                                            @p.Graduation_Year
                                        </div>

                                        <div class="education-title">

                                            @GetLookupName(
                                                     Model.Streams,
                                                     p.Graduation_Stream
                                                     )

                                        </div>

                                        <div class="education-type">
                                            Graduation
                                        </div>

                                    </div>
                                }


                                @if (HasNum(p.HSC_DIPLOMA_YEAR))
                                {
                                    <div class="education-item">

                                        <div class="education-year">
                                            @p.HSC_DIPLOMA_YEAR
                                        </div>

                                        <div class="education-title">
                                            HSC / Diploma
                                        </div>

                                        <div class="education-type">
                                            Academic
                                        </div>

                                    </div>
                                }


                                @if (HasNum(p.SSC_YEAR))
                                {
                                    <div class="education-item">

                                        <div class="education-year">
                                            @p.SSC_YEAR
                                        </div>

                                        <div class="education-title">
                                            SSC
                                        </div>

                                        <div class="education-type">
                                            Academic
                                        </div>

                                    </div>
                                }

                            </div>

                        </section>
                    }


                    <!-- ACHIEVEMENTS -->
                    @{
                        var achievements = new[]
                        {
                    p.Achievements_Certification1,
                    p.Achievements_Certification2,
                    p.Achievements_Certification3
                    }
                        .Where(Has)
                        .ToList();
                    }


                    @if (achievements.Any())
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    08
                                </span>

                                <span class="section-title">
                                    Achievements
                                </span>

                                <span class="section-line"></span>

                            </div>


                            <div class="achievement-grid">

                                @for (
                               int i = 0;
                               i < achievements.Count;
                               i++
                               )
                                {
                                    <div class="achievement">

                                        <div class="achievement-number">
                                            0@(i + 1)
                                        </div>

                                        <div class="achievement-text">
                                            @achievements[i]
                                        </div>

                                    </div>
                                }

                            </div>

                        </section>
                    }


                    <!-- REFERENCES -->
                    @if (Has(p.sRefName1) || Has(p.sRefName2))
                    {
                        <section class="section">

                            <div class="section-heading">

                                <span class="section-number">
                                    09
                                </span>

                                <span class="section-title">
                                    References
                                </span>

                                <span class="section-line"></span>

                            </div>


                            <div class="reference-grid">


                                @if (Has(p.sRefName1))
                                {
                                    <div class="reference">

                                        <div class="reference-name">
                                            @p.sRefName1
                                        </div>


                                        @if (
                                       Has(
                                       GetLookupName(
                                       Model.Relationships,
                                       p.sRefRelationName1
                                       )
                                       )
                                       )
                                        {
                                            <div class="reference-relation">

                                                @GetLookupName(
                                                         Model.Relationships,
                                                         p.sRefRelationName1
                                                         )

                                            </div>
                                        }


                                        @if (Has(p.sMobile1))
                                        {
                                            <div class="reference-phone">

                                                <i class="fa fa-phone"></i>

                                                @p.sMobile1

                                            </div>
                                        }

                                    </div>
                                }


                                @if (Has(p.sRefName2))
                                {
                                    <div class="reference">

                                        <div class="reference-name">
                                            @p.sRefName2
                                        </div>


                                        @if (
                                       Has(
                                       GetLookupName(
                                       Model.Relationships,
                                       p.sRefRelationName2
                                       )
                                       )
                                       )
                                        {
                                            <div class="reference-relation">

                                                @GetLookupName(
                                                         Model.Relationships,
                                                         p.sRefRelationName2
                                                         )

                                            </div>
                                        }


                                        @if (Has(p.sMobile2))
                                        {
                                            <div class="reference-phone">

                                                <i class="fa fa-phone"></i>

                                                @p.sMobile2

                                            </div>
                                        }

                                    </div>
                                }

                            </div>

                        </section>
                    }


                </main>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PDF
    ========================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>


    <script>

        /* =========================================================
           THEME
        ========================================================= */

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const sheet =
                    document.getElementById(
                        "resumeSheet"
                    );


                const swatches =
                    document.querySelectorAll(
                        ".theme-swatch"
                    );


                const savedTheme =
                    localStorage.getItem(
                        "resumeThemeV8"
                    ) || "navy";


                sheet.setAttribute(
                    "data-theme",
                    savedTheme
                );


                swatches.forEach(
                    function (swatch) {

                        swatch.classList.toggle(
                            "active",
                            swatch.dataset.theme ===
                            savedTheme
                        );


                        swatch.addEventListener(
                            "click",
                            function () {

                                const theme =
                                    this.dataset.theme;


                                sheet.setAttribute(
                                    "data-theme",
                                    theme
                                );


                                swatches.forEach(
                                    function (item) {

                                        item.classList.remove(
                                            "active"
                                        );

                                    }
                                );


                                this.classList.add(
                                    "active"
                                );


                                localStorage.setItem(
                                    "resumeThemeV8",
                                    theme
                                );

                            }
                        );

                    }
                );


                /* =================================================
                   ADDRESS
                ================================================= */

                const addressElements =
                    document.querySelectorAll(
                        "[data-country-id]"
                    );


                if (!addressElements.length)
                    return;


                const firstAddress =
                    addressElements[0];


                const countryID =
                    firstAddress.getAttribute(
                        "data-country-id"
                    ) || "";


                const stateID =
                    firstAddress.getAttribute(
                        "data-state-id"
                    ) || "";


                const cityID =
                    firstAddress.getAttribute(
                        "data-city-id"
                    ) || "";


                const pincode =
                    firstAddress.getAttribute(
                        "data-pincode"
                    ) || "";


                function renderAddress(
                    cityName,
                    stateName,
                    countryName
                ) {

                    const parts = [
                        cityName,
                        stateName,
                        countryName,
                        pincode
                    ]
                    .filter(
                        value =>
                            value &&
                            value.trim()
                    );


                    const address =
                        parts.join(", ");


                    addressElements.forEach(
                        function (element) {

                            element.textContent =
                                address;

                        }
                    );

                }


                if (!countryID) {

                    renderAddress(
                        "",
                        "",
                        ""
                    );

                    return;

                }


                fetch("/Location/GetCountries")

                    .then(
                        response =>
                            response.json()
                    )

                    .then(
                        countries => {

                            const country =
                                countries.find(
                                    c =>
                                        String(c.id) ===
                                        String(countryID)
                                );


                            const countryName =
                                country
                                    ? country.name
                                    : "";


                            const countryCode =
                                country
                                    ? country.iso2
                                    : countryID;


                            if (!stateID) {

                                renderAddress(
                                    "",
                                    "",
                                    countryName
                                );

                                return;
                            }


                            return fetch(
                                "/Location/GetStates?countryCode="
                                +
                                encodeURIComponent(
                                    countryCode
                                )
                            )

                            .then(
                                response =>
                                    response.json()
                            )

                            .then(
                                states => {

                                    const state =
                                        states.find(
                                            s =>
                                                String(s.id) ===
                                                String(stateID)
                                        );


                                    const stateName =
                                        state
                                            ? state.name
                                            : "";


                                    const stateCode =
                                        state
                                            ? (
                                                state.stateCode ||
                                                String(
                                                    state.id
                                                ).split(":")[1]
                                            )
                                            : "";


                                    if (!cityID) {

                                        renderAddress(
                                            "",
                                            stateName,
                                            countryName
                                        );

                                        return;
                                    }


                                    return fetch(
                                        "/Location/GetCities?countryCode="
                                        +
                                        encodeURIComponent(
                                            countryCode
                                        )
                                        +
                                        "&stateCode="
                                        +
                                        encodeURIComponent(
                                            stateCode
                                        )
                                    )

                                    .then(
                                        response =>
                                            response.json()
                                    )

                                    .then(
                                        cities => {

                                            const city =
                                                cities.find(
                                                    c =>
                                                        String(c.id) ===
                                                        String(cityID)
                                                );


                                            const cityName =
                                                city
                                                    ? city.name
                                                    : "";


                                            renderAddress(
                                                cityName,
                                                stateName,
                                                countryName
                                            );

                                        }
                                    );

                                }
                            );

                        }
                    )

                    .catch(
                        error =>
                            console.log(
                                "Address resolution error:",
                                error
                            )
                    );

            }
        );


        /* =========================================================
           PDF DOWNLOAD
        ========================================================= */

        async function downloadResumePDF() {

            const sheet =
                document.getElementById(
                    "resumeSheet"
                );


            const button =
                document.querySelector(
                    ".btn-download"
                );


            const original =
                button.innerHTML;


            try {

                button.disabled = true;


                button.innerHTML =
                    '<i class="fa fa-spinner fa-spin"></i>';


                const images =
                    sheet.querySelectorAll(
                        "img"
                    );


                await Promise.all(

                    Array.from(images).map(

                        image =>

                            image.complete

                                ? Promise.resolve()

                                : new Promise(
                                    resolve => {

                                        image.onload =
                                            resolve;

                                        image.onerror =
                                            resolve;

                                    }
                                )

                    )

                );


                const rect =
                    sheet.getBoundingClientRect();


                const canvas =
                    await html2canvas(
                        sheet,
                        {
                            scale: 2,

                            useCORS: true,

                            allowTaint: false,

                            backgroundColor:
                                "#ffffff",

                            logging: false,

                            width:
                                Math.round(
                                    rect.width
                                ),

                            height:
                                Math.round(
                                    rect.height
                                )
                        }
                    );


                const { jsPDF } =
                    window.jspdf;


                const pdf =
                    new jsPDF(
                        {
                            orientation:
                                "landscape",

                            unit: "mm",

                            format: "a4",

                            compress: true
                        }
                    );


                const imgData =
                    canvas.toDataURL(
                        "image/jpeg",
                        .95
                    );


                pdf.addImage(
                    imgData,
                    "JPEG",
                    0,
                    0,
                    297,
                    210
                );


                pdf.save(
                    (window.candidateName ||
                        "Resume")
                    + ".pdf"
                );

            }
            catch (error) {

                console.error(
                    "PDF error:",
                    error
                );


                alert(
                    "Error generating PDF"
                );

            }
            finally {

                button.disabled = false;

                button.innerHTML =
                    original;

            }

        }


        window.candidateName =
        @Html.Raw(
                     System.Text.Json.JsonSerializer.Serialize(
                         candidateName ?? "Resume"
                     )
                 );

    </script>


</body>

</html>