@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Executive Block Layout";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }

        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);

    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @(Has(candidateName)
            ? candidateName + " - Resume"
            : "Resume")
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Libre+Baskerville:wght@400;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

            /* =========================================================
                               ROOT - KEPT EXACTLY AS TEMPLATE 6
                            ========================================================= */

            :root {
                --primary: #263b47;
                --primary-light: #edf2f3;
                --accent: #b4773c;
                --accent-light: #f5ece3;
                --text: #27343c;
                --muted: #718087;
                --border: #dce2e4;
                --soft: #f6f7f7;
                --white: #ffffff;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html,
            body {
                width: 100%;
                min-height: 100%;
            }

            body {
                background: #e9edef;
                color: var(--text);
                font-family: "DM Sans", Arial, sans-serif;
            }

            /* =========================================================
                               TOOLBAR - KEPT EXACTLY AS TEMPLATE 6
                            ========================================================= */

            .resume-toolbar {
                width: 297mm;
                max-width: calc(100% - 30px);
                margin: 14px auto 8px;
                display: flex;
                justify-content: flex-end;
                gap: 8px;
            }

                .resume-toolbar button,
                .resume-toolbar a {
                    border: 0;
                    min-height: 32px;
                    padding: 8px 14px;
                    border-radius: 5px;
                    font-family: "DM Sans";
                    font-size: 10px;
                    font-weight: 700;
                    text-decoration: none;
                    cursor: pointer;
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

            .btn-edit {
                background: #ffffff;
                color: var(--primary);
                border: 1px solid var(--border) !important;
            }

            .btn-print {
                background: var(--primary);
                color: white;
            }

            .btn-download {
                background: var(--accent);
                color: white;
            }

            /* =========================================================
                               THEME SWITCHER - KEPT EXACTLY AS TEMPLATE 6
                            ========================================================= */

            .theme-switcher {
                width: 297mm;
                max-width: calc(100% - 30px);
                margin: 0 auto 10px;
                display: flex;
                justify-content: flex-end;
                align-items: center;
                gap: 8px;
            }

                .theme-switcher span {
                    font-size: 9px;
                    font-weight: 700;
                    color: var(--muted);
                    text-transform: uppercase;
                    letter-spacing: .6px;
                }

            .theme-swatch {
                width: 18px;
                height: 18px;
                border-radius: 50%;
                border: 2px solid white;
                cursor: pointer;
                box-shadow: 0 1px 5px rgba(0,0,0,.15);
            }

                .theme-swatch.active {
                    box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch);
                }

            /* =========================================================
                               RESUME PAGE & THEME VARIABLES (PRESERVED)
                            ========================================================= */

            .resume-page-wrapper {
                display: flex;
                justify-content: center;
                padding: 5px 0 25px;
            }

            .resume-sheet {
                width: 297mm;
                height: 210mm;
                background: white;
                overflow: hidden;
                box-shadow: 0 12px 40px rgba(20,40,50,.14);
                display: flex;
                flex-direction: column;
                --theme: #263b47;
                --theme-soft: #edf2f3;
                --accent-color: #b4773c;
                --accent-soft: #f5ece3;
            }

                .resume-sheet[data-theme="navy"] {
                    --theme: #263b47;
                    --theme-soft: #edf2f3;
                    --accent-color: #b4773c;
                    --accent-soft: #f5ece3;
                }

                .resume-sheet[data-theme="teal"] {
                    --theme: #245f61;
                    --theme-soft: #e8f2f2;
                    --accent-color: #a87842;
                    --accent-soft: #f5eee6;
                }

                .resume-sheet[data-theme="olive"] {
                    --theme: #4f5d45;
                    --theme-soft: #eef2eb;
                    --accent-color: #a4783e;
                    --accent-soft: #f5eee5;
                }

                .resume-sheet[data-theme="blue"] {
                    --theme: #315875;
                    --theme-soft: #eaf0f5;
                    --accent-color: #b4773c;
                    --accent-soft: #f6eee5;
                }

                .resume-sheet[data-theme="brown"] {
                    --theme: #654d3b;
                    --theme-soft: #f3eeea;
                    --accent-color: #9d7040;
                    --accent-soft: #f5eee6;
                }

            /* =========================================================
                               NEW LAYOUT: TEMPLATE 7 (BLOCK STRUCTURE)
                            ========================================================= */

            /* 1. Header Block */
            .t7-header {
                background-color: var(--theme);
                color: #ffffff;
                height: 38mm;
                display: flex;
                align-items: center;
                padding: 0 18mm;
                gap: 15px;
            }

            .t7-photo-wrap {
                width: 25mm;
                height: 25mm;
                border-radius: 50%;
                border: 2px solid var(--accent-color);
                background: #ffffff;
                overflow: hidden;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .t7-photo {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            .t7-photo-placeholder {
                font-size: 24px;
                color: var(--theme);
            }

            .t7-header-text {
                flex-grow: 1;
                display: flex;
                flex-direction: column;
                justify-content: center;
            }

            .t7-name {
                font-family: "Libre Baskerville", Georgia, serif;
                font-size: 32px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 2px;
            }

            .t7-role {
                font-size: 11px;
                font-weight: 700;
                color: var(--accent-color);
                text-transform: uppercase;
                letter-spacing: 2px;
            }

            /* 2. Horizontal Contact Strip */
            .t7-contact-bar {
                background-color: var(--theme-soft);
                height: 10mm;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 18px;
                border-bottom: 1px solid var(--border);
            }

            .t7-contact-item {
                font-size: 9px;
                font-weight: 600;
                color: var(--theme);
                display: flex;
                align-items: center;
                gap: 5px;
            }

                .t7-contact-item i {
                    color: var(--accent-color);
                    font-size: 10px;
                }

            /* 3. Main Body Columns */
            .t7-body {
                display: grid;
                grid-template-columns: 58% 42%;
                height: calc(210mm - 48mm); /* Total minus header and contact strip */
            }

            .t7-col-main {
                padding: 8mm 12mm 8mm 18mm;
                border-right: 1px solid var(--border);
                overflow: hidden;
            }

            .t7-col-side {
                padding: 8mm 18mm 8mm 12mm;
                background-color: #ffffff;
                overflow: hidden;
            }

            /* Sections */
            .t7-section {
                margin-bottom: 14px;
                break-inside: avoid;
            }

            .t7-section-title {
                font-family: "Libre Baskerville", Georgia, serif;
                font-size: 11px;
                font-weight: 700;
                color: var(--theme);
                text-transform: uppercase;
                letter-spacing: 1px;
                border-bottom: 2px solid var(--accent-color);
                padding-bottom: 3px;
                margin-bottom: 8px;
                display: inline-block;
                width: 100%;
            }

            /* Experience & Education Entries */
            .t7-entry {
                margin-bottom: 9px;
            }

            .t7-entry-header {
                display: flex;
                justify-content: space-between;
                align-items: baseline;
                margin-bottom: 2px;
            }

            .t7-entry-title {
                font-size: 10px;
                font-weight: 700;
                color: var(--theme);
            }

            .t7-entry-date {
                font-size: 8.5px;
                font-weight: 700;
                color: var(--accent-color);
                background: var(--theme-soft);
                padding: 2px 5px;
                border-radius: 3px;
            }

            .t7-entry-company {
                font-size: 9px;
                font-weight: 600;
                color: var(--muted);
                margin-bottom: 3px;
            }

            .t7-summary {
                font-size: 9.5px;
                line-height: 1.6;
                color: var(--text);
                text-align: justify;
            }

            /* Skills & Lists */
            .t7-skill-group {
                margin-bottom: 7px;
            }

            .t7-skill-label {
                font-size: 8px;
                font-weight: 800;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: 1px;
                margin-bottom: 2px;
            }

            .t7-skill-tags {
                display: flex;
                flex-wrap: wrap;
                gap: 4px;
            }

            .t7-skill-tag {
                background: var(--theme-soft);
                color: var(--theme);
                padding: 3px 6px;
                border-radius: 3px;
                font-size: 8.5px;
                font-weight: 600;
            }

            .t7-list-item {
                font-size: 9px;
                line-height: 1.5;
                color: var(--text);
                display: flex;
                justify-content: space-between;
                border-bottom: 1px solid var(--border);
                padding-bottom: 3px;
                margin-bottom: 4px;
            }

            /* =========================================================
                               RESPONSIVE & PRINT
                            ========================================================= */

            @@media (max-width: 1200px) {
                .resume-toolbar, .theme-switcher {
                    width: 100%;
                    padding-left: 12px;
                    padding-right: 12px;
                }

                .resume-sheet {
                    transform: scale(.78);
                    transform-origin: top center;
                    margin-bottom: -42mm;
                }
            }

            @@media (max-width: 768px) {
                .resume-sheet {
                    transform: scale(.55);
                    margin-bottom: -95mm;
                }
            }

            @@media print {
                html, body {
                    width: 297mm;
                    height: 210mm;
                    background: white;
                }

                .resume-toolbar, .theme-switcher {
                    display: none !important;
                }

                .resume-page-wrapper {
                    padding: 0;
                }

                .resume-sheet {
                    width: 297mm;
                    height: 210mm;
                    margin: 0;
                    box-shadow: none;
                    transform: none;
                }

                @@page {
                    size: A4 landscape;
                    margin: 0;
                }
            }

    </style>

</head>

<body>

    <!-- =========================================================
         TOOLBAR (PRESERVED)
    ========================================================== -->
    <div class="resume-toolbar">
        <a asp-controller="Candidate" asp-action="Profile" class="btn-edit">
            <i class="fa fa-pen"></i> Edit
        </a>
        <button type="button" class="btn-print" onclick="window.print()">
            <i class="fa fa-print"></i> Print / PDF
        </button>
        <button type="button" class="btn-download" onclick="downloadResumePDF()">
            <i class="fa fa-download"></i> Download
        </button>
    </div>

    <!-- =========================================================
         THEMES (PRESERVED)
    ========================================================== -->
    <div class="theme-switcher">
        <span>Theme</span>
        <div class="theme-swatch active" data-theme="navy" style="background:#263b47;--swatch:#263b47"></div>
        <div class="theme-swatch" data-theme="teal" style="background:#245f61;--swatch:#245f61"></div>
        <div class="theme-swatch" data-theme="olive" style="background:#4f5d45;--swatch:#4f5d45"></div>
        <div class="theme-swatch" data-theme="blue" style="background:#315875;--swatch:#315875"></div>
        <div class="theme-swatch" data-theme="brown" style="background:#654d3b;--swatch:#654d3b"></div>
    </div>

    <!-- =========================================================
         RESUME (NEW LAYOUT)
    ========================================================== -->
    <div class="resume-page-wrapper">
        <div class="resume-sheet" id="resumeSheet" data-theme="navy">

            <!-- 1. FULL WIDTH HEADER -->
            <header class="t7-header">
                <div class="t7-photo-wrap">
                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto" class="t7-photo" alt="Profile" />
                    }
                    else
                    {
                        <div class="t7-photo-placeholder"><i class="fa fa-user"></i></div>
                    }
                </div>

                <div class="t7-header-text">
                    <h1 class="t7-name">@(Has(candidateName) ? candidateName : "Candidate Name")</h1>
                    @if (Has(candidateRole))
                    {
                        <div class="t7-role">@candidateRole</div>
                    }
                </div>
            </header>

            <!-- 2. HORIZONTAL CONTACT STRIP -->
            <div class="t7-contact-bar">
                @if (Has(Model.CandidatePhone))
                {
                    <div class="t7-contact-item">
                        <i class="fa fa-phone"></i> <span>@Model.CandidatePhone</span>
                    </div>
                }
                @if (Has(Model.CandidateEmail))
                {
                    <div class="t7-contact-item">
                        <i class="fa fa-envelope"></i> <span>@Model.CandidateEmail</span>
                    </div>
                }
                @if (Has(p.Pincode))
                {
                    <div class="t7-contact-item">
                        <i class="fa fa-location-dot"></i>
                        <span id="rvAddress" data-country-id="@p.CountryID" data-state-id="@p.StateID" data-city-id="@p.CityID" data-pincode="@p.Pincode">
                            @p.Pincode
                        </span>
                    </div>
                }
                @if (Has(p.Linkedin))
                {
                    <div class="t7-contact-item">
                        <i class="fa-brands fa-linkedin"></i> <span>@p.Linkedin</span>
                    </div>
                }
                @if (Has(p.GitHub))
                {
                    <div class="t7-contact-item">
                        <i class="fa-brands fa-github"></i> <span>@p.GitHub</span>
                    </div>
                }
            </div>

            <!-- 3. BODY TWO-COLUMN SPLIT -->
            <div class="t7-body">

                <!-- LEFT MAIN COLUMN -->
                <div class="t7-col-main">

                    @if (Has(p.Objective))
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Professional Summary</div>
                            <div class="t7-summary">@p.Objective</div>
                        </section>
                    }

                    <!-- EXPERIENCE -->
                    @{
                        var internships = new[]
                        {
                            new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                            new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                            new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                            new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
                        }.Where(x => Has(x.Name)).ToList();
                    }

                    @if (internships.Any())
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Professional Experience</div>

                            @foreach (var exp in internships)
                            {
                                <div class="t7-entry">
                                    <div class="t7-entry-header">
                                        <div class="t7-entry-title">
                                            @(Has(GetLookupName(Model.InternshipTitles, exp.Title)) ? GetLookupName(Model.InternshipTitles, exp.Title) : "")
                                        </div>
                                        <div class="t7-entry-date">
                                            @GetLookupName(Model.InternshipDurations, exp.Duration)
                                        </div>
                                    </div>
                                    <div class="t7-entry-company">
                                        @exp.Name
                                        @if (Has(GetLookupName(Model.InternshipStatuses, exp.Status)))
                                        {
                                            <span style="color: var(--accent-color);">&nbsp;•&nbsp; @GetLookupName(Model.InternshipStatuses, exp.Status)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </section>
                    }

                    <!-- EDUCATION -->
                    @if (HasNum(p.PG_Year) || HasNum(p.Graduation_Year) || HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR))
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Education</div>

                            @if (HasNum(p.PG_Year))
                            {
                                <div class="t7-entry">
                                    <div class="t7-entry-header">
                                        <div class="t7-entry-title">Post Graduation — @GetLookupName(Model.Streams, p.PG_Stream)</div>
                                        <div class="t7-entry-date">@p.PG_Year</div>
                                    </div>
                                    <div class="t7-entry-company">Division: @GetLookupName(Model.Divisions, p.PG_Division)</div>
                                </div>
                            }
                            @if (HasNum(p.Graduation_Year))
                            {
                                <div class="t7-entry">
                                    <div class="t7-entry-header">
                                        <div class="t7-entry-title">Graduation — @GetLookupName(Model.Streams, p.Graduation_Stream)</div>
                                        <div class="t7-entry-date">@p.Graduation_Year</div>
                                    </div>
                                    <div class="t7-entry-company">Division: @GetLookupName(Model.Divisions, p.Graduation_Division)</div>
                                </div>
                            }
                            @if (HasNum(p.HSC_DIPLOMA_YEAR))
                            {
                                <div class="t7-entry">
                                    <div class="t7-entry-header">
                                        <div class="t7-entry-title">HSC / Diploma</div>
                                        <div class="t7-entry-date">@p.HSC_DIPLOMA_YEAR</div>
                                    </div>
                                    <div class="t7-entry-company">Division: @GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION)</div>
                                </div>
                            }
                            @if (HasNum(p.SSC_YEAR))
                            {
                                <div class="t7-entry">
                                    <div class="t7-entry-header">
                                        <div class="t7-entry-title">SSC / 10th</div>
                                        <div class="t7-entry-date">@p.SSC_YEAR</div>
                                    </div>
                                    <div class="t7-entry-company">Division: @GetLookupName(Model.Divisions, p.SSC_DIVISION)</div>
                                </div>
                            }
                        </section>
                    }
                </div>

                <!-- RIGHT SIDE COLUMN -->
                <div class="t7-col-side">

                    <!-- SKILLS -->
                    @{
                        var skillGroups = new[]
                        {
                            ("Technical", p.sTechnicalSkillIDs),
                            ("Medical", p.sMedicalSkillIDs),
                            ("Non-Technical", p.sNonTechnicalSkillIDs)
                        }.Where(x => Has(x.Item2)).ToList();
                    }

                    @if (skillGroups.Any())
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Expertise</div>
                            @foreach (var group in skillGroups)
                            {
                                <div class="t7-skill-group">
                                    <div class="t7-skill-label">@group.Item1</div>
                                    <div class="t7-skill-tags">
                                        @foreach (var skill in group.Item2.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="t7-skill-tag">@skill.Trim()</span>
                                        }
                                    </div>
                                </div>
                            }
                        </section>
                    }

                    <!-- LANGUAGES -->
                    @{
                        var langItems = new List<(string Lang, string Star)>();
                        for (int i = 1; i <= 8; i++)
                        {
                            var lang = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                            var star = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguageStar{i}")?.GetValue(p)?.ToString();
                            if (Has(lang)) { langItems.Add((lang, star)); }
                        }
                    }

                    @if (langItems.Any())
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Languages</div>
                            @foreach (var lang in langItems)
                            {
                                <div class="t7-list-item">
                                    <span style="font-weight: 700; color: var(--theme);">@lang.Lang</span>
                                    @if (Has(lang.Star))
                                    {
                                        <span style="color: var(--accent-color); font-weight: 700;">@lang.Star ★</span>
                                    }
                                </div>
                            }
                        </section>
                    }

                    <!-- ACHIEVEMENTS -->
                    @{
                        var achievements = new[]
                        {
                            p.Achievements_Certification1,
                            p.Achievements_Certification2,
                            p.Achievements_Certification3
                        }.Where(Has).ToList();
                    }

                    @if (achievements.Any())
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Achievements</div>
                            @foreach (var a in achievements)
                            {
                                <div class="t7-list-item" style="display: block;">
                                    <span style="color: var(--accent-color);">■</span> &nbsp;@a
                                </div>
                            }
                        </section>
                    }

                    <!-- INTERESTS -->
                    @if (Has(p.sHobbies))
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">Interests</div>
                            <div class="t7-summary">@p.sHobbies</div>
                        </section>
                    }

                    <!-- REFERENCES -->
                    @if (Has(p.sRefName1) || Has(p.sRefName2))
                    {
                        <section class="t7-section">
                            <div class="t7-section-title">References</div>
                            @if (Has(p.sRefName1))
                            {
                                <div class="t7-skill-group">
                                    <div style="font-weight: 700; font-size: 9.5px; color: var(--theme);">@p.sRefName1</div>
                                    <div style="font-size: 8.5px; color: var(--muted);">
                                        @(Has(GetLookupName(Model.Relationships, p.sRefRelationName1)) ? GetLookupName(Model.Relationships, p.sRefRelationName1) : "")
                                        @(Has(p.sMobile1) ? " | " + p.sMobile1 : "")
                                    </div>
                                </div>
                            }
                            @if (Has(p.sRefName2))
                            {
                                <div class="t7-skill-group">
                                    <div style="font-weight: 700; font-size: 9.5px; color: var(--theme);">@p.sRefName2</div>
                                    <div style="font-size: 8.5px; color: var(--muted);">
                                        @(Has(GetLookupName(Model.Relationships, p.sRefRelationName2)) ? GetLookupName(Model.Relationships, p.sRefRelationName2) : "")
                                        @(Has(p.sMobile2) ? " | " + p.sMobile2 : "")
                                    </div>
                                </div>
                            }
                        </section>
                    }

                </div>
            </div>
        </div>
    </div>


    <!-- =========================================================
         PDF LOGIC (PRESERVED EXACTLY AS PROVIDED)
    ========================================================== -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {
                const sheet = document.getElementById("resumeSheet");
                const swatches = document.querySelectorAll(".theme-swatch");
                const savedTheme = localStorage.getItem("resumeThemeV7_Block") || "navy";

                sheet.setAttribute("data-theme", savedTheme);

                swatches.forEach(function (swatch) {
                    swatch.classList.toggle("active", swatch.dataset.theme === savedTheme);

                    swatch.addEventListener("click", function () {
                        const theme = this.dataset.theme;
                        sheet.setAttribute("data-theme", theme);

                        swatches.forEach(function (item) {
                            item.classList.remove("active");
                        });
                        this.classList.add("active");

                        localStorage.setItem("resumeThemeV7_Block", theme);
                    });
                });

                /* ADDRESS LOGIC */
                const addressElements = document.querySelectorAll("[data-country-id]");
                if (!addressElements.length) return;

                const firstAddress = addressElements[0];
                const countryID = firstAddress.getAttribute("data-country-id") || "";
                const stateID = firstAddress.getAttribute("data-state-id") || "";
                const cityID = firstAddress.getAttribute("data-city-id") || "";
                const pincode = firstAddress.getAttribute("data-pincode") || "";

                function renderAddress(cityName, stateName, countryName) {
                    const parts = [cityName, stateName, countryName, pincode].filter(value => value && value.trim());
                    const address = parts.join(", ");
                    addressElements.forEach(function (element) {
                        element.textContent = address;
                    });
                }

                if (!countryID) {
                    renderAddress("", "", "");
                    return;
                }

                fetch("/Location/GetCountries")
                    .then(response => response.json())
                    .then(countries => {
                        const country = countries.find(c => String(c.id) === String(countryID));
                        const countryName = country ? country.name : "";
                        const countryCode = country ? country.iso2 : countryID;

                        if (!stateID) {
                            renderAddress("", "", countryName);
                            return;
                        }

                        return fetch("/Location/GetStates?countryCode=" + encodeURIComponent(countryCode))
                            .then(response => response.json())
                            .then(states => {
                                const state = states.find(s => String(s.id) === String(stateID));
                                const stateName = state ? state.name : "";
                                const stateCode = state ? (state.stateCode || String(state.id).split(":")[1]) : "";

                                if (!cityID) {
                                    renderAddress("", stateName, countryName);
                                    return;
                                }

                                return fetch("/Location/GetCities?countryCode=" + encodeURIComponent(countryCode) + "&stateCode=" + encodeURIComponent(stateCode))
                                    .then(response => response.json())
                                    .then(cities => {
                                        const city = cities.find(c => String(c.id) === String(cityID));
                                        const cityName = city ? city.name : "";
                                        renderAddress(cityName, stateName, countryName);
                                    });
                            });
                    })
                    .catch(error => console.log("Address resolution error:", error));
            });

            /* PDF LOGIC */
            async function downloadResumePDF() {
                const sheet = document.getElementById("resumeSheet");
                const button = document.querySelector(".btn-download");
                const original = button.innerHTML;

                try {
                    button.disabled = true;
                    button.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

                    const images = sheet.querySelectorAll("img");
                    await Promise.all(
                        Array.from(images).map(image =>
                            image.complete ? Promise.resolve() : new Promise(resolve => {
                                image.onload = resolve;
                                image.onerror = resolve;
                            })
                        )
                    );

                    const rect = sheet.getBoundingClientRect();
                    const canvas = await html2canvas(sheet, {
                        scale: 2,
                        useCORS: true,
                        allowTaint: false,
                        backgroundColor: "#ffffff",
                        logging: false,
                        width: Math.round(rect.width),
                        height: Math.round(rect.height)
                    });

                    const { jsPDF } = window.jspdf;
                    const pdf = new jsPDF({
                        orientation: "landscape",
                        unit: "mm",
                        format: "a4",
                        compress: true
                    });

                    const imgData = canvas.toDataURL("image/jpeg", .95);
                    pdf.addImage(imgData, "JPEG", 0, 0, 297, 210);
                    pdf.save((window.candidateName || "Resume") + ".pdf");
                }
                catch (error) {
                    console.error("PDF error:", error);
                    alert("Error generating PDF");
                }
                finally {
                    button.disabled = false;
                    button.innerHTML = original;
                }
            }

            window.candidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? "Resume"));

    </script>

</body>
</html>