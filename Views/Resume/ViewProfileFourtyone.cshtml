@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Modern Sage (Template 41)";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {
    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();
                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }
        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);
    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Professional Resume for @candidateName" />

    <title>@(Has(candidateName) ? candidateName + " - Resume" : "Resume")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Montserrat:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --primary: #263b47;
            --accent: #b4773c;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; min-height: 100%; }
        
        body {
            background: #e9edef;
            font-family: "DM Sans", Arial, sans-serif;
            color: var(--text);
        }

        /* TOOLBAR */
        .resume-toolbar {
            width: 297mm; max-width: calc(100% - 30px); margin: 14px auto 8px;
            display: flex; justify-content: flex-end; gap: 8px;
        }
        .resume-toolbar button, .resume-toolbar a {
            border: 0; min-height: 32px; padding: 8px 14px; border-radius: 5px;
            font-family: "DM Sans", sans-serif; font-size: 10px; font-weight: 700;
            text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
        }
        .btn-edit { background: #ffffff; color: var(--primary); border: 1px solid var(--border) !important; }
        .btn-print { background: var(--primary); color: white; }
        .btn-download { background: var(--accent); color: white; }

        /* THEME SWITCHER */
        .theme-switcher {
            width: 297mm; max-width: calc(100% - 30px); margin: 0 auto 10px;
            display: flex; justify-content: flex-end; align-items: center; gap: 8px;
        }
        .theme-switcher span { font-size: 9px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; }
        .theme-swatch { width: 18px; height: 18px; border-radius: 50%; border: 2px solid white; cursor: pointer; box-shadow: 0 1px 5px rgba(0,0,0,.15); }
        .theme-swatch.active { box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch); }

        /* RESUME SHEET: HORIZONTAL A4 & CSS GRID */
        .resume-page-wrapper { display: flex; justify-content: center; padding: 5px 0 25px; }

        .resume-sheet {
            width: 297mm; height: 210mm; 
            background: #ffffff; 
            box-shadow: 0 15px 35px rgba(0,0,0,.1); overflow: hidden;
            
            /* L-Shape Grid Layout */
            display: grid;
            grid-template-columns: 33% 67%;
            grid-template-rows: 38mm 1fr;
            
            /* Theme Mappings (Based on Image 41) */
            --theme-primary: #185e58;     /* Dark Teal Text */
            --theme-bg-main: #c0d6b6;     /* Sage Green L-Shape */
            --theme-bg-content: #eff3df;  /* Pale Cream Content Area */
            --theme-text-dark: #222222;
        }

        .resume-sheet[data-theme="sage"] { --theme-primary: #185e58; --theme-bg-main: #c0d6b6; --theme-bg-content: #eff3df; }
        .resume-sheet[data-theme="navy"] { --theme-primary: #1e3a8a; --theme-bg-main: #b0c4de; --theme-bg-content: #f1f5f9; }
        .resume-sheet[data-theme="slate"] { --theme-primary: #0f172a; --theme-bg-main: #cbd5e1; --theme-bg-content: #f8fafc; }
        .resume-sheet[data-theme="rose"] { --theme-primary: #881337; --theme-bg-main: #fecdd3; --theme-bg-content: #fff1f2; }
        .resume-sheet[data-theme="sand"] { --theme-primary: #431407; --theme-bg-main: #fde68a; --theme-bg-content: #fefce8; }

        /* ================= GRID AREAS ================= */
        
        /* 1. LEFT SIDEBAR */
        .col-left {
            grid-area: 1 / 1 / 3 / 2; /* Spans full height */
            background-color: var(--theme-bg-main);
            padding: 16mm 10mm 12mm 10mm; 
            display: flex; flex-direction: column; align-items: center; gap: 20px; 
        }

        .photo-container {
            width: 58mm; height: 58mm; flex-shrink: 0;
            border-radius: 50%; overflow: hidden;
            background: #ffffff; 
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
            display: flex; align-items: center; justify-content: center;
            margin-bottom: 6px;
        }
        .photo { width: 100%; height: 100%; object-fit: cover; }
        .photo-placeholder { font-size: 65px; color: var(--theme-primary); opacity: 0.3; }

        .left-title {
            font-family: "Montserrat", sans-serif; font-size: 22px; font-weight: 800;
            color: var(--theme-primary); margin: 0 0 10px 0; text-align: center;
            letter-spacing: 0.5px;
        }

        .contact-list {
            display: flex; flex-direction: column; gap: 10px; font-style: normal;
            align-items: center; width: 100%; text-align: center;
        }
        .contact-item {
            font-family: "DM Sans", sans-serif; font-size: 10px; font-weight: 600;
            color: var(--theme-primary); word-break: break-word; line-height: 1.4;
        }

        .body-text-left {
            font-size: 10px; line-height: 1.6; color: var(--theme-primary);
            text-align: center; font-weight: 500;
        }

        .left-bullets {
            list-style: none; padding: 0; margin: 0; width: 100%; text-align: center;
        }
        .left-bullets li {
            font-size: 10px; font-weight: 600; color: var(--theme-primary);
            margin-bottom: 6px; line-height: 1.4;
        }

        /* 2. RIGHT HEADER BANNER */
        .col-right-header {
            grid-area: 1 / 2 / 2 / 3;
            background-color: var(--theme-bg-main);
            padding: 10mm 14mm 6mm 14mm; 
            display: flex; flex-direction: column; justify-content: center;
        }
        
        .name {
            font-family: "Montserrat", sans-serif; font-size: 52px; font-weight: 800;
            color: var(--theme-primary); line-height: 1; margin: 0 0 4px 0;
            letter-spacing: -1.5px; word-wrap: break-word;
        }
        .role {
            font-family: "DM Sans", sans-serif; font-size: 20px; font-weight: 400;
            color: var(--theme-primary); margin: 0; letter-spacing: 1px;
        }

        /* 3. RIGHT CONTENT AREA */
        .col-right-content {
            grid-area: 2 / 2 / 3 / 3;
            background-color: var(--theme-bg-content);
            padding: 12mm 14mm 10mm 14mm; 
            display: flex; flex-direction: column; gap: 18px; /* Balanced spacing */
        }

        .section-title {
            font-family: "Montserrat", sans-serif; font-size: 22px; font-weight: 800;
            color: var(--theme-primary); margin: 0 0 10px 0; letter-spacing: -0.5px;
        }

        /* HIGH-DENSITY GRIDS (Fixes Vertical Cut-off for Experience, Education, Skills) */
        .grid-2col {
            display: grid; grid-template-columns: 1fr 1fr; gap: 12px 20px;
        }

        /* TIMELINE ITEMS */
        .timeline-item { break-inside: avoid; }
        .timeline-title {
            font-family: "Montserrat", sans-serif; font-size: 11px; font-weight: 800;
            color: var(--theme-primary); margin: 0 0 2px 0; line-height: 1.2;
        }
        .timeline-meta {
            font-size: 10.5px; font-weight: 700; color: var(--theme-text-dark); margin-bottom: 2px;
        }
        .timeline-desc {
            font-size: 10px; line-height: 1.4; color: #444; font-weight: 500;
        }
        
        .timeline-bullets {
            list-style: none; padding: 0; margin: 4px 0 0 0;
        }
        .timeline-bullets li {
            font-size: 10px; line-height: 1.4; color: #444;
            margin-bottom: 2px; position: relative; padding-left: 10px; font-weight: 500;
        }
        .timeline-bullets li::before {
            content: "•"; position: absolute; left: 0; color: var(--theme-primary);
        }

        /* Skills Progress Bar matching Reference 41 */
        .skill-item {
            display: flex; flex-direction: column; gap: 4px; break-inside: avoid;
        }
        .skill-name {
            font-family: "DM Sans", sans-serif; font-size: 10.5px; font-weight: 600; color: var(--theme-primary);
        }
        .skill-bar-container {
            width: 100%; height: 10px; background-color: transparent;
            border-radius: 12px; display: flex;
        }
        .skill-bar-fill {
            height: 100%; background-color: var(--theme-primary);
            border-radius: 12px; border-top-right-radius: 0; border-bottom-right-radius: 0;
        }
        .skill-bar-tip {
            width: 15px; height: 100%; background-color: #2a2a2a; 
            border-radius: 12px; margin-left: -5px; /* Overlaps slightly to create the pill effect */
            z-index: 2;
        }

        /* RESPONSIVE & PRINT */
        @@media (max-width: 1200px) {
            .resume-toolbar, .theme-switcher { width: 100%; padding: 0 15px; }
            .resume-sheet { transform: scale(0.85); transform-origin: top center; margin-bottom: -30mm; }
        }
        @@media (max-width: 992px) {
            .resume-sheet { transform: scale(0.65); margin-bottom: -70mm; }
        }
        @@media print {
            html, body { width: 297mm; height: 210mm; background: white; }
            .resume-toolbar, .theme-switcher { display: none !important; }
            .resume-page-wrapper { padding: 0; }
            .resume-sheet { width: 297mm; height: 210mm; margin: 0; box-shadow: none; transform: none; }
            @@page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>

<body>

    <div class="resume-toolbar">
        <a asp-controller="Candidate" asp-action="Profile" class="btn-edit">
            <i class="fa fa-pen"></i> Edit
        </a>
        <button type="button" class="btn-print" onclick="window.print()">
            <i class="fa fa-print"></i> Print / PDF
        </button>
        <button type="button" class="btn-download" onclick="downloadResumePDF()">
            <i class="fa fa-download"></i> Download
        </button>
    </div>

    <div class="theme-switcher">
        <span>Theme</span>
        <div class="theme-swatch active" data-theme="sage" style="background:#c0d6b6;--swatch:#c0d6b6" title="Sage"></div>
        <div class="theme-swatch" data-theme="navy" style="background:#b0c4de;--swatch:#b0c4de" title="Navy"></div>
        <div class="theme-swatch" data-theme="slate" style="background:#cbd5e1;--swatch:#cbd5e1" title="Slate"></div>
        <div class="theme-swatch" data-theme="rose" style="background:#fecdd3;--swatch:#fecdd3" title="Rose"></div>
        <div class="theme-swatch" data-theme="sand" style="background:#fde68a;--swatch:#fde68a" title="Sand"></div>
    </div>

    <div class="resume-page-wrapper">
        
        <!-- SEMANTIC HTML WRAPPER -->
        <main class="resume-sheet" id="resumeSheet" data-theme="sage">

            <!-- ================= COLUMN 1: LEFT SIDEBAR ================= -->
            <aside class="col-left">
                
                <div class="photo-container">
                    @if (Has(p.sPhoto))
                    {
                        <img src="@Url.Content(p.sPhoto)" class="photo" alt="Profile Photograph" onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='flex';" />
                        <div class="photo-placeholder" id="fallbackIcon" style="display:none;" aria-hidden="true"><i class="fa fa-user"></i></div>
                    }
                    else
                    {
                        <div class="photo-placeholder" aria-hidden="true"><i class="fa fa-user"></i></div>
                    }
                </div>

                <section style="width: 100%;">
                    <h2 class="left-title">Contact</h2>
                    <address class="contact-list">
                        @if (Has(Model.CandidatePhone)) { 
                            <div class="contact-item">@Model.CandidatePhone</div> 
                        }
                        @if (Has(Model.CandidateEmail)) { 
                            <div class="contact-item">@Model.CandidateEmail</div> 
                        }
                        @if (Has(p.Linkedin)) { 
                            <div class="contact-item">@p.Linkedin</div> 
                        }
                        @if (Has(p.Pincode)) { 
                            <div class="contact-item" id="rvAddressLeft" data-country-id="@p.CountryID" data-state-id="@p.StateID" data-city-id="@p.CityID" data-pincode="@p.Pincode">
                                @p.Pincode
                            </div> 
                        }
                        @if (Has(p.GitHub)) { 
                            <div class="contact-item">@p.GitHub</div> 
                        }
                    </address>
                </section>

                @if (Has(p.Objective))
                {
                    <section style="width: 100%;">
                        <h2 class="left-title">About Me</h2>
                        <div class="body-text-left">@p.Objective</div>
                    </section>
                }

                @{
                    var langItems = new List<string>();
                    for (int i = 1; i <= 8; i++)
                    {
                        var lang = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                        if (Has(lang)) { langItems.Add(lang); }
                    }
                }
                @if (langItems.Any())
                {
                    <section style="width: 100%;">
                        <h2 class="left-title">Languages</h2>
                        <ul class="left-bullets">
                            @foreach (var l in langItems.Take(6))
                            {
                                <li>@l</li>
                            }
                        </ul>
                    </section>
                }

                @if (Has(p.sHobbies))
                {
                    <section style="width: 100%;">
                        <h2 class="left-title">Hobbies</h2>
                        <div class="body-text-left" style="white-space: pre-wrap;">@p.sHobbies</div>
                    </section>
                }

            </aside>

            <!-- ================= RIGHT HEADER ================= -->
            <header class="col-right-header">
                <h1 class="name">@(Has(candidateName) ? candidateName : "")</h1>
                @if (Has(candidateRole)) { <h2 class="role">@candidateRole</h2> }
            </header>

            <!-- ================= RIGHT CONTENT AREA ================= -->
            <div class="col-right-content">
                
                @{
                    var internships = new[]
                    {
                        new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                        new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                        new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                        new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
                    }.Where(x => Has(x.Name)).ToList();
                }

                @if (internships.Any())
                {
                    <section>
                        <h3 class="section-title">Experience</h3>
                        <!-- GRID LAYOUT prevents vertical overflow with max data -->
                        <div class="grid-2col">
                            @foreach (var exp in internships)
                            {
                                <div class="timeline-item">
                                    <h4 class="timeline-title">@exp.Name</h4>
                                    <div class="timeline-meta">
                                        @(Has(GetLookupName(Model.InternshipTitles, exp.Title)) ? GetLookupName(Model.InternshipTitles, exp.Title) : "Role") 
                                        @if(Has(GetLookupName(Model.InternshipDurations, exp.Duration))) { 
                                            <span>( @GetLookupName(Model.InternshipDurations, exp.Duration) )</span> 
                                        }
                                    </div>
                                    @if (Has(GetLookupName(Model.InternshipStatuses, exp.Status)))
                                    {
                                        <div class="timeline-desc">Status: @GetLookupName(Model.InternshipStatuses, exp.Status)</div>
                                    }
                                </div>
                            }
                        </div>
                    </section>
                }

                @{
                    var techSkillsStr = p.sTechnicalSkillIDs;
                    var nonTechSkillsStr = p.sNonTechnicalSkillIDs;
                    var techSkills = Has(techSkillsStr) ? techSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s=>s.Trim()).ToList() : new List<string>();
                    var nonTechSkills = Has(nonTechSkillsStr) ? nonTechSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s=>s.Trim()).ToList() : new List<string>();
                    var allSkills = techSkills.Concat(nonTechSkills).ToList();
                }
                @if (allSkills.Any())
                {
                    <section>
                        <h3 class="section-title">My Skills</h3>
                        <div class="grid-2col">
                            @foreach (var skill in allSkills.Take(8))
                            {
                                <div class="skill-item">
                                    <div class="skill-name">@skill</div>
                                    <div class="skill-bar-container" aria-hidden="true">
                                        <div class="skill-bar-fill" style="width: 80%;"></div>
                                        <div class="skill-bar-tip"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @if (HasNum(p.PG_Year) || HasNum(p.Graduation_Year) || HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR))
                {
                    <section>
                        <h3 class="section-title">Education</h3>
                        <div class="grid-2col">
                            @if (HasNum(p.PG_Year)) {
                                <div class="timeline-item">
                                    <h4 class="timeline-title">@GetLookupName(Model.Streams, p.PG_Stream)</h4>
                                    <div class="timeline-meta">Post Graduation ( @p.PG_Year )</div>
                                    <div class="timeline-desc">Div: @GetLookupName(Model.Divisions, p.PG_Division)</div>
                                </div>
                            }
                            @if (HasNum(p.Graduation_Year)) {
                                <div class="timeline-item">
                                    <h4 class="timeline-title">@GetLookupName(Model.Streams, p.Graduation_Stream)</h4>
                                    <div class="timeline-meta">Graduation ( @p.Graduation_Year )</div>
                                    <div class="timeline-desc">Div: @GetLookupName(Model.Divisions, p.Graduation_Division)</div>
                                </div>
                            }
                            @if (HasNum(p.HSC_DIPLOMA_YEAR)) {
                                <div class="timeline-item">
                                    <h4 class="timeline-title">HSC / Diploma</h4>
                                    <div class="timeline-meta">Higher Secondary ( @p.HSC_DIPLOMA_YEAR )</div>
                                    <div class="timeline-desc">Div: @GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION)</div>
                                </div>
                            }
                            @if (HasNum(p.SSC_YEAR)) {
                                <div class="timeline-item">
                                    <h4 class="timeline-title">SSC / 10th</h4>
                                    <div class="timeline-meta">Secondary ( @p.SSC_YEAR )</div>
                                    <div class="timeline-desc">Div: @GetLookupName(Model.Divisions, p.SSC_DIVISION)</div>
                                </div>
                            }
                        </div>
                    </section>
                }

                @{
                    var achievements = new[] { p.Achievements_Certification1, p.Achievements_Certification2, p.Achievements_Certification3 }.Where(Has).ToList();
                }
                @if (achievements.Any() || Has(p.sRefName1) || Has(p.sRefName2))
                {
                    <div class="grid-2col" style="margin-top: 5px;">
                        
                        @if (achievements.Any())
                        {
                            <section>
                                <h3 class="section-title" style="font-size:16px;">Achievements</h3>
                                <ul class="timeline-bullets">
                                    @foreach (var a in achievements)
                                    {
                                        <li>@a</li>
                                    }
                                </ul>
                            </section>
                        }

                        @if (Has(p.sRefName1) || Has(p.sRefName2))
                        {
                            <section>
                                <h3 class="section-title" style="font-size:16px;">References</h3>
                                <div style="display:flex; flex-direction:column; gap:8px;">
                                    @if (Has(p.sRefName1)) {
                                        <div>
                                            <div class="timeline-title">@p.sRefName1</div>
                                            @if(Has(GetLookupName(Model.Relationships, p.sRefRelationName1))) { <div class="timeline-meta" style="margin-bottom:1px; font-size:10px;">@GetLookupName(Model.Relationships, p.sRefRelationName1)</div> }
                                            @if(Has(p.sMobile1)) { <div class="timeline-desc">@p.sMobile1</div> }
                                        </div>
                                    }
                                    @if (Has(p.sRefName2)) {
                                        <div>
                                            <div class="timeline-title">@p.sRefName2</div>
                                            @if(Has(GetLookupName(Model.Relationships, p.sRefRelationName2))) { <div class="timeline-meta" style="margin-bottom:1px; font-size:10px;">@GetLookupName(Model.Relationships, p.sRefRelationName2)</div> }
                                            @if(Has(p.sMobile2)) { <div class="timeline-desc">@p.sMobile2</div> }
                                        </div>
                                    }
                                </div>
                            </section>
                        }

                    </div>
                }

            </div>
        </main>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sheet = document.getElementById("resumeSheet");
            const swatches = document.querySelectorAll(".theme-swatch");
            const savedTheme = localStorage.getItem("resumeThemeV41") || "sage";

            sheet.setAttribute("data-theme", savedTheme);

            swatches.forEach(function (swatch) {
                swatch.classList.toggle("active", swatch.dataset.theme === savedTheme);

                swatch.addEventListener("click", function () {
                    const theme = this.dataset.theme;
                    sheet.setAttribute("data-theme", theme);
                    
                    swatches.forEach(function (item) { item.classList.remove("active"); });
                    this.classList.add("active");
                    
                    localStorage.setItem("resumeThemeV41", theme);
                });
            });

            /* ADDRESS LOGIC */
            const addressElements = document.querySelectorAll("[data-country-id]");
            if (!addressElements.length) return;

            const firstAddress = addressElements[0];
            const countryID = firstAddress.getAttribute("data-country-id") || "";
            const stateID = firstAddress.getAttribute("data-state-id") || "";
            const cityID = firstAddress.getAttribute("data-city-id") || "";
            const pincode = firstAddress.getAttribute("data-pincode") || "";

            function renderAddress(cityName, stateName, countryName) {
                const parts = [cityName, stateName, countryName, pincode].filter(value => value && value.trim());
                const address = parts.join(", ");
                addressElements.forEach(function (element) { element.textContent = address; });
            }

            if (!countryID) { renderAddress("", "", ""); return; }

            fetch("/Location/GetCountries")
                .then(response => response.json())
                .then(countries => {
                    const country = countries.find(c => String(c.id) === String(countryID));
                    const countryName = country ? country.name : "";
                    const countryCode = country ? country.iso2 : countryID;

                    if (!stateID) { renderAddress("", "", countryName); return; }

                    return fetch("/Location/GetStates?countryCode=" + encodeURIComponent(countryCode))
                        .then(response => response.json())
                        .then(states => {
                            const state = states.find(s => String(s.id) === String(stateID));
                            const stateName = state ? state.name : "";
                            const stateCode = state ? (state.stateCode || String(state.id).split(":")[1]) : "";

                            if (!cityID) { renderAddress("", stateName, countryName); return; }

                            return fetch("/Location/GetCities?countryCode=" + encodeURIComponent(countryCode) + "&stateCode=" + encodeURIComponent(stateCode))
                                .then(response => response.json())
                                .then(cities => {
                                    const city = cities.find(c => String(c.id) === String(cityID));
                                    const cityName = city ? city.name : "";
                                    renderAddress(cityName, stateName, countryName);
                                });
                        });
                })
                .catch(error => console.log("Address resolution error:", error));
        });

        /* PDF LOGIC (Landscape) */
        async function downloadResumePDF() {
            const sheet = document.getElementById("resumeSheet");
            const button = document.querySelector(".btn-download");
            const original = button.innerHTML;

            try {
                button.disabled = true;
                button.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

                const images = sheet.querySelectorAll("img");
                await Promise.all(
                    Array.from(images).map(image =>
                        image.complete ? Promise.resolve() : new Promise(resolve => {
                            image.onload = resolve;
                            image.onerror = resolve;
                        })
                    )
                );

                const rect = sheet.getBoundingClientRect();
                const canvas = await html2canvas(sheet, {
                    scale: 2, useCORS: true, allowTaint: false, backgroundColor: "#ffffff",
                    logging: false, width: Math.round(rect.width), height: Math.round(rect.height)
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4", compress: true });
                const imgData = canvas.toDataURL("image/jpeg", .95);
                pdf.addImage(imgData, "JPEG", 0, 0, 297, 210);
                pdf.save((window.candidateName || "Resume") + ".pdf");
            }
            catch (error) {
                console.error("PDF error:", error);
                alert("Error generating PDF");
            }
            finally {
                button.disabled = false;
                button.innerHTML = original;
            }
        }

        window.candidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? "Resume"));
    </script>
</body>
</html>
