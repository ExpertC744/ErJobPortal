@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Clean Horizontal (Template 13)";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {
    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();
                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }
        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);
    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Professional Resume for @candidateName" />

    <title>@(Has(candidateName) ? candidateName + " - Resume" : "Resume")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;700&family=Inter:wght@300;400;500;600&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --primary: #263b47;
            --accent: #b4773c;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; min-height: 100%; }
        
        body {
            background: #e9edef;
            font-family: "Inter", Arial, sans-serif;
            color: var(--text);
        }

        /* TOOLBAR */
        .resume-toolbar {
            width: 297mm; max-width: calc(100% - 30px); margin: 14px auto 8px;
            display: flex; justify-content: flex-end; gap: 8px;
        }
        .resume-toolbar button, .resume-toolbar a {
            border: 0; min-height: 32px; padding: 8px 14px; border-radius: 5px;
            font-family: "DM Sans", sans-serif; font-size: 10px; font-weight: 700;
            text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
        }
        .btn-edit { background: #ffffff; color: var(--primary); border: 1px solid var(--border) !important; }
        .btn-print { background: var(--primary); color: white; }
        .btn-download { background: var(--accent); color: white; }

        /* THEME SWITCHER */
        .theme-switcher {
            width: 297mm; max-width: calc(100% - 30px); margin: 0 auto 10px;
            display: flex; justify-content: flex-end; align-items: center; gap: 8px;
        }
        .theme-switcher span { font-size: 9px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; }
        .theme-swatch { width: 18px; height: 18px; border-radius: 50%; border: 2px solid white; cursor: pointer; box-shadow: 0 1px 5px rgba(0,0,0,.15); }
        .theme-swatch.active { box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch); }

        /* RESUME SHEET: HORIZONTAL A4 */
        .resume-page-wrapper { display: flex; justify-content: center; padding: 5px 0 25px; }

        .resume-sheet {
            width: 297mm; height: 210mm; background: #ffffff;
            box-shadow: 0 15px 35px rgba(0,0,0,.1); overflow: hidden;
            display: flex; flex-direction: column;
            
            /* Theme Mappings */
            --theme-color: #000000;
            --theme-divider: #e5e7eb;
            --theme-text-header: #111111;
        }

        .resume-sheet[data-theme="mono"] { --theme-color: #000000; --theme-divider: #e5e7eb; --theme-text-header: #111; }
        .resume-sheet[data-theme="navy"] { --theme-color: #2a3b4c; --theme-divider: #e2e8f0; --theme-text-header: #1e293b; }
        .resume-sheet[data-theme="teal"] { --theme-color: #2b6766; --theme-divider: #e0f2f1; --theme-text-header: #004d40; }
        .resume-sheet[data-theme="blue"] { --theme-color: #355e7e; --theme-divider: #e0e7ff; --theme-text-header: #1e3a8a; }
        .resume-sheet[data-theme="brown"] { --theme-color: #8c7365; --theme-divider: #f5ece3; --theme-text-header: #4a3c31; }

        /* ================= TOP HEADER ================= */
        .top-header {
            padding: 16mm 16mm 10mm 16mm; /* Tightened padding for more data space */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header-left { display: flex; align-items: center; gap: 20px; }
        
        .photo-container {
            width: 40mm; height: 40mm; flex-shrink: 0;
            border-radius: 50%; overflow: hidden;
            background: #f1f5f9; display: flex; align-items: center; justify-content: center;
            border: 1px solid #e5e7eb;
        }
        .photo { width: 100%; height: 100%; object-fit: cover; }
        .photo-placeholder { font-size: 40px; color: var(--theme-color); opacity: 0.3; }

        .name-container { display: flex; flex-direction: column; justify-content: center; }
        .name {
            font-family: "DM Sans", sans-serif; font-size: 38px; font-weight: 400;
            color: var(--theme-text-header); line-height: 1.15; text-transform: uppercase; letter-spacing: 2px;
            margin: 0; 
        }
        .name span { display: block; }
        
        .role {
            font-family: "Montserrat", sans-serif; font-size: 12px; font-weight: 600;
            text-transform: uppercase; letter-spacing: 1.5px; color: #444; margin-top: 6px;
            margin-bottom: 0;
        }

        .header-right {
            display: flex; flex-direction: column; gap: 10px; align-items: flex-end;
        }
        .contact-item {
            display: flex; align-items: center; gap: 8px; font-size: 10px; 
            font-family: "Montserrat", sans-serif; color: #333; font-weight: 500;
        }
        .icon-circle {
            width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid #222;
            display: flex; align-items: center; justify-content: center; font-size: 10px;
            color: #222;
        }

        /* THICK DIVIDER */
        .thick-divider {
            width: 100%; height: 5px; background: var(--theme-divider);
            margin-bottom: 4px;
        }

        /* ================= 3 COLUMN BOTTOM ================= */
        .bottom-content {
            padding: 8mm 16mm;
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 15px; /* Tightened grid gap for data density */
            flex-grow: 1;
        }

        .column { display: flex; flex-direction: column; gap: 12px; } /* Tightened section gaps */

        /* SECTION HEADER WITH LINE */
        .section-header {
            display: flex; align-items: center; width: 100%; margin-bottom: 8px;
        }
        .section-title {
            font-family: "Montserrat", sans-serif; font-weight: 700; font-size: 12px;
            color: var(--theme-text-header); text-transform: uppercase; letter-spacing: 1.5px;
            margin: 0;
        }
        .section-line {
            flex-grow: 1; height: 1.5px; background: var(--theme-color); margin-left: 12px;
            opacity: 0.8;
        }

        .body-text { font-size: 10.5px; line-height: 1.5; color: #333; text-align: justify; }

        /* TIMELINE (Experience/Education) */
        .timeline-row { display: flex; gap: 10px; margin-bottom: 10px; break-inside: avoid; }
        .timeline-year { 
            width: 45px; flex-shrink: 0; font-family: "Montserrat", sans-serif; 
            font-weight: 700; font-size: 10px; color: var(--theme-text-header); 
            line-height: 1.2; word-break: break-word;
        }
        .timeline-content { flex: 1; }
        .timeline-title { 
            font-family: "Montserrat", sans-serif; font-weight: 700; font-size: 11px; 
            color: var(--theme-text-header); margin-bottom: 2px; line-height: 1.2;
        }
        .timeline-subtitle { 
            font-size: 10px; font-weight: 500; color: #555; 
            text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; 
        }
        .timeline-bullets { list-style-type: disc; padding-left: 14px; margin-top: 2px; }
        .timeline-bullets li { font-size: 10px; line-height: 1.4; color: #333; margin-bottom: 2px; }

        /* SKILLS (Horizontal Bars) */
        .skill-row { display: grid; grid-template-columns: 85px 1fr; align-items: center; gap: 8px; margin-bottom: 6px; }
        .skill-name { font-size: 10px; color: #333; font-weight: 500; }
        .bar-bg { width: 100%; height: 5px; background: #e5e7eb; border-radius: 0; overflow: hidden; }
        .bar-fill { height: 100%; background: var(--theme-color); border-radius: 0; }

        /* RESPONSIVE & PRINT */
        @@media (max-width: 1200px) {
            .resume-toolbar, .theme-switcher { width: 100%; padding: 0 15px; }
            .resume-sheet { transform: scale(0.85); transform-origin: top center; margin-bottom: -30mm; }
        }
        @@media (max-width: 992px) {
            .resume-sheet { transform: scale(0.65); margin-bottom: -70mm; }
        }
        @@media print {
            html, body { width: 297mm; height: 210mm; background: white; }
            .resume-toolbar, .theme-switcher { display: none !important; }
            .resume-page-wrapper { padding: 0; }
            .resume-sheet { width: 297mm; height: 210mm; margin: 0; box-shadow: none; transform: none; }
            @@page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>

<body>

    <div class="resume-toolbar">
        <a asp-controller="Candidate" asp-action="Profile" class="btn-edit">
            <i class="fa fa-pen"></i> Edit
        </a>
        <button type="button" class="btn-print" onclick="window.print()">
            <i class="fa fa-print"></i> Print / PDF
        </button>
        <button type="button" class="btn-download" onclick="downloadResumePDF()">
            <i class="fa fa-download"></i> Download
        </button>
    </div>

    <div class="theme-switcher">
        <span>Theme</span>
        <div class="theme-swatch active" data-theme="mono" style="background:#000000;--swatch:#000000" title="Mono"></div>
        <div class="theme-swatch" data-theme="navy" style="background:#2a3b4c;--swatch:#2a3b4c" title="Navy"></div>
        <div class="theme-swatch" data-theme="teal" style="background:#2b6766;--swatch:#2b6766" title="Teal"></div>
        <div class="theme-swatch" data-theme="blue" style="background:#355e7e;--swatch:#355e7e" title="Blue"></div>
        <div class="theme-swatch" data-theme="brown" style="background:#8c7365;--swatch:#8c7365" title="Brown"></div>
    </div>

    <div class="resume-page-wrapper">
        <main class="resume-sheet" id="resumeSheet" data-theme="mono">

            <!-- ================= TOP HEADER ================= -->
            <header class="top-header">
                
                <div class="header-left">
                    <div class="photo-container">
                        @if (Has(p.sPhoto))
                        {
                            <img src="@Url.Content(p.sPhoto)" class="photo" alt="Profile Photograph" onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='flex';" />
                            <div class="photo-placeholder" id="fallbackIcon" style="display:none;" aria-hidden="true"><i class="fa fa-user"></i></div>
                        }
                        else
                        {
                            <div class="photo-placeholder" aria-hidden="true"><i class="fa fa-user"></i></div>
                        }
                    </div>

                    <div class="name-container">
                        <h1 class="name">
                            @{
                                var nameParts = candidateName?.Split(' ') ?? new string[0];
                                if (nameParts.Length > 1) {
                                    <span>@nameParts[0]</span>
                                    <span>@string.Join(" ", nameParts.Skip(1))</span>
                                } else {
                                    <span>@candidateName</span>
                                }
                            }
                        </h1>
                        @if (Has(candidateRole)) { <h2 class="role">@candidateRole</h2> }
                    </div>
                </div>

                <address class="header-right" style="font-style: normal;">
                    @if (Has(Model.CandidateEmail)) { 
                        <div class="contact-item">
                            <div class="icon-circle" aria-hidden="true"><i class="fa fa-envelope"></i></div>
                            <div>@Model.CandidateEmail</div>
                        </div> 
                    }
                    @if (Has(p.Linkedin)) { 
                        <div class="contact-item">
                            <div class="icon-circle" aria-hidden="true"><i class="fa-brands fa-linkedin-in"></i></div>
                            <div>@p.Linkedin</div>
                        </div> 
                    }
                    @if (Has(Model.CandidatePhone)) { 
                        <div class="contact-item">
                            <div class="icon-circle" aria-hidden="true"><i class="fa fa-phone"></i></div>
                            <div>@Model.CandidatePhone</div>
                        </div> 
                    }
                    @if (Has(p.Pincode)) { 
                        <div class="contact-item">
                            <div class="icon-circle" aria-hidden="true"><i class="fa fa-map-marker-alt"></i></div>
                            <div id="rvAddressLeft" data-country-id="@p.CountryID" data-state-id="@p.StateID" data-city-id="@p.CityID" data-pincode="@p.Pincode">
                                @p.Pincode
                            </div>
                        </div> 
                    }
                </address>

            </header>

            <div class="thick-divider" aria-hidden="true"></div>

            <!-- ================= 3 COLUMN BOTTOM ================= -->
            <div class="bottom-content">
                
                <!-- COLUMN 1 (LEFT) -->
                <section class="column">
                    @if (Has(p.Objective))
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">About Me</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            <div class="body-text">@p.Objective</div>
                        </div>
                    }

                    @{
                        var achievements = new[] { p.Achievements_Certification1, p.Achievements_Certification2, p.Achievements_Certification3 }.Where(Has).ToList();
                    }
                    @if (achievements.Any())
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">Achievements</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            <ul class="timeline-bullets">
                                @foreach (var a in achievements)
                                {
                                    <li>@a</li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Has(p.sHobbies))
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">Interests</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            <div class="body-text" style="white-space: pre-wrap;">@p.sHobbies</div>
                        </div>
                    }
                    
                    @if (Has(p.sRefName1) || Has(p.sRefName2))
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">References</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            @if (Has(p.sRefName1)) {
                                <div style="margin-bottom: 10px;">
                                    <div style="font-size:11px; font-weight:700; color:var(--theme-text-header);">@p.sRefName1</div>
                                    @if(Has(GetLookupName(Model.Relationships, p.sRefRelationName1))) { <div style="font-size:10px; color:#555; margin-top:2px;">@GetLookupName(Model.Relationships, p.sRefRelationName1)</div> }
                                    @if(Has(p.sMobile1)) { <div style="font-size:10px; color:#555;">@p.sMobile1</div> }
                                </div>
                            }
                            @if (Has(p.sRefName2)) {
                                <div>
                                    <div style="font-size:11px; font-weight:700; color:var(--theme-text-header);">@p.sRefName2</div>
                                    @if(Has(GetLookupName(Model.Relationships, p.sRefRelationName2))) { <div style="font-size:10px; color:#555; margin-top:2px;">@GetLookupName(Model.Relationships, p.sRefRelationName2)</div> }
                                    @if(Has(p.sMobile2)) { <div style="font-size:10px; color:#555;">@p.sMobile2</div> }
                                </div>
                            }
                        </div>
                    }
                </section>

                <!-- COLUMN 2 (MIDDLE) -->
                <section class="column">
                    @{
                        var internships = new[]
                        {
                            new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                            new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                            new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                            new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
                        }.Where(x => Has(x.Name)).ToList();
                    }

                    @if (internships.Any())
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">Experience</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            @foreach (var exp in internships)
                            {
                                <div class="timeline-row">
                                    <div class="timeline-year">@GetLookupName(Model.InternshipDurations, exp.Duration)</div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">@GetLookupName(Model.InternshipTitles, exp.Title)</div>
                                        <div class="timeline-subtitle">@exp.Name</div>
                                        @if (Has(GetLookupName(Model.InternshipStatuses, exp.Status)))
                                        {
                                            <ul class="timeline-bullets">
                                                <li>Status: @GetLookupName(Model.InternshipStatuses, exp.Status)</li>
                                            </ul>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <!-- COLUMN 3 (RIGHT) -->
                <section class="column">
                    @if (HasNum(p.PG_Year) || HasNum(p.Graduation_Year) || HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR))
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">Education</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            
                            @if (HasNum(p.PG_Year)) {
                                <div class="timeline-row">
                                    <div class="timeline-year">@p.PG_Year</div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">@GetLookupName(Model.Streams, p.PG_Stream)</div>
                                        <div class="timeline-subtitle">Post Graduation</div>
                                        <ul class="timeline-bullets">
                                            <li>Division: @GetLookupName(Model.Divisions, p.PG_Division)</li>
                                            @if(Has(p.Other_Specialization)) { <li>@p.Other_Specialization</li> }
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (HasNum(p.Graduation_Year)) {
                                <div class="timeline-row">
                                    <div class="timeline-year">@p.Graduation_Year</div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">@GetLookupName(Model.Streams, p.Graduation_Stream)</div>
                                        <div class="timeline-subtitle">Graduation</div>
                                        <ul class="timeline-bullets">
                                            <li>Division: @GetLookupName(Model.Divisions, p.Graduation_Division)</li>
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (HasNum(p.HSC_DIPLOMA_YEAR)) {
                                <div class="timeline-row">
                                    <div class="timeline-year">@p.HSC_DIPLOMA_YEAR</div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">HSC / Diploma</div>
                                        <ul class="timeline-bullets">
                                            <li>Division: @GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION)</li>
                                        </ul>
                                    </div>
                                </div>
                            }
                            @if (HasNum(p.SSC_YEAR)) {
                                <div class="timeline-row">
                                    <div class="timeline-year">@p.SSC_YEAR</div>
                                    <div class="timeline-content">
                                        <div class="timeline-title">SSC / 10th</div>
                                        <ul class="timeline-bullets">
                                            <li>Division: @GetLookupName(Model.Divisions, p.SSC_DIVISION)</li>
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @{
                        var langItems = new List<(string Lang, int Rating)>();
                        for (int i = 1; i <= 8; i++)
                        {
                            var lang = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                            var starVal = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguageStar{i}")?.GetValue(p);
                            
                            if (Has(lang)) { 
                                int rating = 3; 
                                if (starVal != null && int.TryParse(starVal.ToString(), out int parsed)) rating = parsed;
                                langItems.Add((lang, rating)); 
                            }
                        }

                        var techSkillsStr = p.sTechnicalSkillIDs;
                        var techSkills = Has(techSkillsStr) ? techSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).ToList() : new List<string>();
                    }

                    @if (langItems.Any() || techSkills.Any())
                    {
                        <div>
                            <header class="section-header">
                                <h3 class="section-title">Skills</h3>
                                <div class="section-line" aria-hidden="true"></div>
                            </header>
                            
                            @foreach (var ts in techSkills.Take(7))
                            {
                                <div class="skill-row">
                                    <div class="skill-name">@ts.Trim()</div>
                                    <div class="bar-bg" aria-hidden="true"><div class="bar-fill" style="width: 85%;"></div></div>
                                </div>
                            }

                            @foreach (var l in langItems.Take(4))
                            {
                                <div class="skill-row">
                                    <div class="skill-name">@l.Lang</div>
                                    <div class="bar-bg" aria-hidden="true"><div class="bar-fill" style="width: @(l.Rating * 20)%;"></div></div>
                                </div>
                            }
                        </div>
                    }
                </section>

            </div>
        </main>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sheet = document.getElementById("resumeSheet");
            const swatches = document.querySelectorAll(".theme-swatch");
            const savedTheme = localStorage.getItem("resumeThemeV13") || "mono";

            sheet.setAttribute("data-theme", savedTheme);

            swatches.forEach(function (swatch) {
                swatch.classList.toggle("active", swatch.dataset.theme === savedTheme);

                swatch.addEventListener("click", function () {
                    const theme = this.dataset.theme;
                    sheet.setAttribute("data-theme", theme);
                    
                    swatches.forEach(function (item) { item.classList.remove("active"); });
                    this.classList.add("active");
                    
                    localStorage.setItem("resumeThemeV13", theme);
                });
            });

            /* ADDRESS LOGIC */
            const addressElements = document.querySelectorAll("[data-country-id]");
            if (!addressElements.length) return;

            const firstAddress = addressElements[0];
            const countryID = firstAddress.getAttribute("data-country-id") || "";
            const stateID = firstAddress.getAttribute("data-state-id") || "";
            const cityID = firstAddress.getAttribute("data-city-id") || "";
            const pincode = firstAddress.getAttribute("data-pincode") || "";

            function renderAddress(cityName, stateName, countryName) {
                const parts = [cityName, stateName, countryName, pincode].filter(value => value && value.trim());
                const address = parts.join(", ");
                addressElements.forEach(function (element) { element.textContent = address; });
            }

            if (!countryID) { renderAddress("", "", ""); return; }

            fetch("/Location/GetCountries")
                .then(response => response.json())
                .then(countries => {
                    const country = countries.find(c => String(c.id) === String(countryID));
                    const countryName = country ? country.name : "";
                    const countryCode = country ? country.iso2 : countryID;

                    if (!stateID) { renderAddress("", "", countryName); return; }

                    return fetch("/Location/GetStates?countryCode=" + encodeURIComponent(countryCode))
                        .then(response => response.json())
                        .then(states => {
                            const state = states.find(s => String(s.id) === String(stateID));
                            const stateName = state ? state.name : "";
                            const stateCode = state ? (state.stateCode || String(state.id).split(":")[1]) : "";

                            if (!cityID) { renderAddress("", stateName, countryName); return; }

                            return fetch("/Location/GetCities?countryCode=" + encodeURIComponent(countryCode) + "&stateCode=" + encodeURIComponent(stateCode))
                                .then(response => response.json())
                                .then(cities => {
                                    const city = cities.find(c => String(c.id) === String(cityID));
                                    const cityName = city ? city.name : "";
                                    renderAddress(cityName, stateName, countryName);
                                });
                        });
                })
                .catch(error => console.log("Address resolution error:", error));
        });

        /* PDF LOGIC (Landscape) */
        async function downloadResumePDF() {
            const sheet = document.getElementById("resumeSheet");
            const button = document.querySelector(".btn-download");
            const original = button.innerHTML;

            try {
                button.disabled = true;
                button.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

                const images = sheet.querySelectorAll("img");
                await Promise.all(
                    Array.from(images).map(image =>
                        image.complete ? Promise.resolve() : new Promise(resolve => {
                            image.onload = resolve;
                            image.onerror = resolve;
                        })
                    )
                );

                const rect = sheet.getBoundingClientRect();
                const canvas = await html2canvas(sheet, {
                    scale: 2, useCORS: true, allowTaint: false, backgroundColor: "#ffffff",
                    logging: false, width: Math.round(rect.width), height: Math.round(rect.height)
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4", compress: true });
                const imgData = canvas.toDataURL("image/jpeg", .95);
                pdf.addImage(imgData, "JPEG", 0, 0, 297, 210);
                pdf.save((window.candidateName || "Resume") + ".pdf");
            }
            catch (error) {
                console.error("PDF error:", error);
                alert("Error generating PDF");
            }
            finally {
                button.disabled = false;
                button.innerHTML = original;
            }
        }

        window.candidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? "Resume"));
    </script>
</body>
</html>