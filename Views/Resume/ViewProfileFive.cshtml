@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Modern Corporate";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }

        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);

    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(Has(candidateName)
            ? candidateName + " - Resume"
            : "Resume")
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Playfair+Display:wght@600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

        /* =========================================================
                   ROOT
                ========================================================= */

        :root {
            --primary: #1f4e68;
            --primary-dark: #163b50;
            --primary-soft: #eaf2f6;
            --accent: #c18a45;
            --accent-soft: #f7efe4;
            --text: #263844;
            --text-dark: #1c303c;
            --muted: #687984;
            --border: #dce4e8;
            --border-light: #e9eef1;
            --page-bg: #edf1f3;
            --soft-bg: #f7f9fa;
            --white: #ffffff;
        }


        /* =========================================================
                   RESET
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
        }


        body {
            background: var(--page-bg);
            color: var(--text);
            font-family: "Inter", "Segoe UI", Arial, sans-serif;
        }


        /* =========================================================
                   TOOLBAR
                ========================================================= */

        .resume-toolbar {
            width: 297mm;
            max-width: calc(100% - 30px);
            margin: 14px auto 8px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }


            .resume-toolbar button,
            .resume-toolbar a {
                border: 0;
                padding: 8px 14px;
                min-height: 32px;
                border-radius: 5px;
                font-family: "Inter", sans-serif;
                font-size: 10px;
                font-weight: 700;
                cursor: pointer;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                transition: .2s ease;
            }


                .resume-toolbar button:hover,
                .resume-toolbar a:hover {
                    transform: translateY(-1px);
                }


        .btn-edit {
            background: #ffffff;
            color: var(--text);
            border: 1px solid var(--border) !important;
        }


        .btn-print {
            background: var(--primary);
            color: #ffffff;
        }


        .btn-download {
            background: var(--accent);
            color: #ffffff;
        }


        /* =========================================================
                   THEME SWITCHER
                ========================================================= */

        .theme-switcher {
            width: 297mm;
            max-width: calc(100% - 30px);
            margin: 0 auto 10px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }


            .theme-switcher span {
                font-size: 9px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .6px;
            }


        .theme-swatch {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid #ffffff;
            cursor: pointer;
            box-shadow: 0 1px 5px rgba(0,0,0,.16);
            transition: .2s ease;
        }


            .theme-swatch:hover {
                transform: scale(1.12);
            }


            .theme-swatch.active {
                box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px var(--swatch);
            }


        /* =========================================================
                   PAGE
                ========================================================= */

        .resume-page-wrapper {
            display: flex;
            justify-content: center;
            padding: 5px 0 25px;
        }


        .resume-sheet {
            width: 297mm;
            height: 210mm;
            background: #ffffff;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(24,45,58,.14);
            display: flex;
            flex-direction: column;
            --theme: #1f4e68;
            --theme-dark: #163b50;
            --theme-soft: #eaf2f6;
            --theme-border: #d4e3ea;
        }


            /* =========================================================
                   THEMES
                ========================================================= */

            .resume-sheet[data-theme="blue"] {
                --theme: #1f4e68;
                --theme-dark: #163b50;
                --theme-soft: #eaf2f6;
                --theme-border: #d4e3ea;
            }


            .resume-sheet[data-theme="teal"] {
                --theme: #176b68;
                --theme-dark: #11514f;
                --theme-soft: #e8f4f3;
                --theme-border: #cfe5e3;
            }


            .resume-sheet[data-theme="slate"] {
                --theme: #455a64;
                --theme-dark: #263940;
                --theme-soft: #eef2f3;
                --theme-border: #d8e0e3;
            }


            .resume-sheet[data-theme="brown"] {
                --theme: #765536;
                --theme-dark: #543c28;
                --theme-soft: #f5eee8;
                --theme-border: #e7d9cc;
            }


            .resume-sheet[data-theme="green"] {
                --theme: #3f6f55;
                --theme-dark: #2e513e;
                --theme-soft: #edf5ef;
                --theme-border: #d6e6da;
            }


        /* =========================================================
                   HEADER
                ========================================================= */

        .resume-header {
            height: 40mm;
            display: grid;
            grid-template-columns: 40mm 1fr 75mm;
            align-items: center;
            padding: 6mm 12mm;
            background: #ffffff;
            border-bottom: 1px solid var(--border);
            position: relative;
        }


            .resume-header::before {
                content: "";
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 4px;
                background: var(--theme);
            }


        /* =========================================================
                   PHOTO
                ========================================================= */

        .photo-wrapper {
            display: flex;
            align-items: center;
        }


        .profile-photo {
            width: 31mm;
            height: 31mm;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid var(--theme-soft);
            outline: 2px solid var(--theme-border);
            background: #ffffff;
        }


        .profile-placeholder {
            width: 31mm;
            height: 31mm;
            border-radius: 50%;
            background: var(--theme-soft);
            border: 2px solid var(--theme-border);
            color: var(--theme);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
        }


        /* =========================================================
                   HEADER INFORMATION
                ========================================================= */

        .header-info {
            padding-left: 5mm;
        }


        .candidate-name {
            font-family: "Playfair Display", Georgia, serif;
            font-size: 27px;
            line-height: 1.1;
            font-weight: 700;
            color: var(--text-dark);
            letter-spacing: -.4px;
        }


        .candidate-role {
            margin-top: 5px;
            font-size: 11px;
            font-weight: 800;
            color: var(--theme);
            text-transform: uppercase;
            letter-spacing: 1.4px;
        }


        .header-accent {
            width: 42px;
            height: 3px;
            margin-top: 9px;
            background: var(--accent);
        }


        /* =========================================================
                   HEADER CONTACT
                ========================================================= */

        .header-contact {
            border-left: 1px solid var(--border);
            padding-left: 7mm;
            display: flex;
            flex-direction: column;
            gap: 7px;
        }


        .header-contact-item {
            display: flex;
            align-items: flex-start;
            gap: 7px;
            font-size: 9px;
            line-height: 1.4;
            color: var(--muted);
        }


            .header-contact-item i {
                color: var(--theme);
                width: 13px;
                flex-shrink: 0;
                margin-top: 2px;
            }


        /* =========================================================
                   TWO COLUMN BODY
                ========================================================= */

        .resume-body {
            height: calc(210mm - 52mm);
            display: grid;
            grid-template-columns: 82mm 1fr;
            overflow: hidden;
        }


        /* =========================================================
                   LEFT COLUMN
                ========================================================= */

        .left-column {
            background: #f8fafb;
            border-right: 1px solid var(--border);
            padding: 7mm 8mm;
            overflow: hidden;
        }


        /* =========================================================
                   RIGHT COLUMN
                ========================================================= */

        .right-column {
            padding: 7mm 10mm;
            overflow: hidden;
        }


        /* =========================================================
                   SECTION
                ========================================================= */

        .resume-section {
            margin-bottom: 14px;
            break-inside: avoid;
        }


        .section-heading {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 8px;
        }


        .section-icon {
            width: 23px;
            height: 23px;
            flex-shrink: 0;
            border-radius: 5px;
            background: var(--theme-soft);
            color: var(--theme);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
        }


        .section-title {
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .8px;
            color: var(--text-dark);
        }


        .section-title-line {
            flex: 1;
            height: 1px;
        }




        /* =========================================================
                   SUMMARY
                ========================================================= */

        .summary {
            font-size: 10px;
            line-height: 1.65;
            color: #586a74;
            text-align: justify;
        }


        /* =========================================================
                   LEFT INFO
                ========================================================= */

        .info-item {
            display: flex;
            gap: 9px;
            margin-bottom: 9px;
            font-size: 9.5px;
            line-height: 1.45;
        }


        .info-icon {
            width: 18px;
            flex-shrink: 0;
            color: var(--theme);
            text-align: center;
            margin-top: 1px;
        }


        .info-content {
            color: #596b74;
            word-break: break-word;
        }


        .info-label {
            display: block;
            font-size: 7.5px;
            font-weight: 800;
            color: #87949b;
            text-transform: uppercase;
            letter-spacing: .6px;
            margin-bottom: 1px;
        }


        .info-value {
            font-weight: 600;
            color: #425762;
        }


        /* =========================================================
                   SKILLS
                ========================================================= */

        .skill-group {
            margin-bottom: 10px;
        }


        .skill-group-title {
            font-size: 8px;
            font-weight: 800;
            color: #77858c;
            text-transform: uppercase;
            letter-spacing: .8px;
            margin-bottom: 5px;
        }


        .skill-list {
            display: flex;
            flex-wrap: wrap;
            gap: 5px;
        }


        .skill {
            display: inline-flex;
            align-items: center;
            padding: 5px 8px;
            background: #ffffff;
            border: 1px solid var(--theme-border);
            color: #40545e;
            border-radius: 4px;
            font-size: 8.5px;
            font-weight: 600;
        }


            .skill::before {
                content: "";
                width: 4px;
                height: 4px;
                border-radius: 50%;
                background: var(--theme);
                margin-right: 5px;
            }


        /* =========================================================
                   LANGUAGES
                ========================================================= */

        .language-list {
            border-top: 1px solid var(--border-light);
        }


        .language-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 6px 0;
            border-bottom: 1px solid var(--border-light);
            font-size: 9px;
        }


        .language-name {
            font-weight: 650;
            color: #465a64;
        }


        .language-level {
            color: var(--theme);
            font-weight: 700;
            font-size: 8px;
        }


        /* =========================================================
                   INTERESTS
                ========================================================= */

        .interest-box {
            padding: 9px 10px;
            background: #ffffff;
            border: 1px solid var(--border);
            border-left: 3px solid var(--theme);
            font-size: 9px;
            line-height: 1.55;
            color: #5c6d75;
        }


        /* =========================================================
                   SOCIAL
                ========================================================= */

        .social-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 7px;
            font-size: 8.8px;
            line-height: 1.4;
            color: #5a6b74;
            word-break: break-word;
        }


            .social-item i {
                color: var(--theme);
                width: 14px;
                flex-shrink: 0;
                margin-top: 2px;
            }


        /* =========================================================
                   EXPERIENCE
                ========================================================= */

        .experience {
            position: relative;
            padding-left: 17px;
            margin-bottom: 12px;
        }


            .experience::before {
                content: "";
                position: absolute;
                left: 0;
                top: 4px;
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: var(--theme);
                box-shadow: 0 0 0 3px var(--theme-soft);
            }


            .experience::after {
                content: "";
                position: absolute;
                left: 3px;
                top: 15px;
                width: 1px;
                height: calc(100% + 2px);
                background: #d9e2e6;
            }


            .experience:last-child::after {
                display: none;
            }


        .experience-title {
            font-size: 10.5px;
            font-weight: 800;
            color: #2c4653;
            line-height: 1.35;
        }


        .experience-company {
            margin-top: 2px;
            font-size: 10px;
            font-weight: 700;
            color: var(--theme);
        }


        .experience-meta {
            margin-top: 3px;
            font-size: 8.5px;
            color: #829098;
        }


        /* =========================================================
                   EDUCATION
                ========================================================= */

        .education-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
        }


        .education-card {
            padding: 9px 10px;
            background: var(--theme-soft);
            border: 1px solid var(--theme-border);
            border-left: 3px solid var(--theme);
        }


        .education-title {
            font-size: 9.5px;
            font-weight: 750;
            color: #344c58;
            line-height: 1.35;
        }


        .education-meta {
            margin-top: 3px;
            font-size: 8.3px;
            color: #71818a;
            line-height: 1.4;
        }


        /* =========================================================
                   ACHIEVEMENTS
                ========================================================= */

        .achievement {
            display: flex;
            gap: 8px;
            margin-bottom: 7px;
            font-size: 9.3px;
            line-height: 1.5;
            color: #5c6d75;
        }


            .achievement::before {
                content: "✓";
                width: 16px;
                height: 16px;
                flex-shrink: 0;
                border-radius: 50%;
                background: var(--theme-soft);
                color: var(--theme);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 8px;
                font-weight: 800;
            }


        /* =========================================================
                   REFERENCES
                ========================================================= */

        .reference-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 9px;
        }


        .reference-card {
            padding: 9px 10px;
            border: 1px solid var(--border);
            background: #ffffff;
            border-top: 2px solid var(--theme);
        }


        .reference-name {
            font-size: 9.5px;
            font-weight: 750;
            color: #344c58;
        }


        .reference-relation {
            font-size: 8px;
            color: var(--theme);
            margin-top: 2px;
        }


        .reference-phone {
            font-size: 8.5px;
            color: #74838a;
            margin-top: 3px;
        }


        /* =========================================================
                   RESPONSIVE PREVIEW
                ========================================================= */

        @@media (max-width: 1200px) {

            .resume-toolbar,
            .theme-switcher {
                width: 100%;
                padding-left: 12px;
                padding-right: 12px;
            }


            .resume-sheet {
                transform: scale(.78);
                transform-origin: top center;
                margin-bottom: -42mm;
            }
        }


        @@media (max-width: 768px) {

            .resume-sheet {
                transform: scale(.55);
                margin-bottom: -95mm;
            }
        }


        /* =========================================================
                   PRINT
                ========================================================= */

        @@media print {

            html,
            body {
                width: 297mm;
                height: 210mm;
                margin: 0;
                padding: 0;
                background: #ffffff;
            }


            .resume-toolbar,
            .theme-switcher {
                display: none !important;
            }


            .resume-page-wrapper {
                padding: 0;
            }


            .resume-sheet {
                width: 297mm;
                height: 210mm;
                margin: 0;
                box-shadow: none;
                transform: none;
            }


            @@page {
                size: A4 landscape;
                margin: 0;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         TOOLBAR
    ========================================================== -->

    <div class="resume-toolbar">

        <a asp-controller="Candidate"
           asp-action="Profile"
           class="btn-edit">

            <i class="fa fa-pen"></i>

            Edit

        </a>


        <button type="button"
                class="btn-print"
                onclick="window.print()">

            <i class="fa fa-print"></i>

            Print / PDF

        </button>


        <button type="button"
                class="btn-download"
                onclick="downloadResumePDF()">

            <i class="fa fa-download"></i>

            Download

        </button>

    </div>


    <!-- =========================================================
         THEME SWITCHER
    ========================================================== -->

    <div class="theme-switcher">

        <span>Theme</span>


        <div class="theme-swatch active"
             data-theme="blue"
             style="background:#1f4e68;--swatch:#1f4e68">
        </div>


        <div class="theme-swatch"
             data-theme="teal"
             style="background:#176b68;--swatch:#176b68">
        </div>


        <div class="theme-swatch"
             data-theme="slate"
             style="background:#455a64;--swatch:#455a64">
        </div>


        <div class="theme-swatch"
             data-theme="brown"
             style="background:#765536;--swatch:#765536">
        </div>


        <div class="theme-swatch"
             data-theme="green"
             style="background:#3f6f55;--swatch:#3f6f55">
        </div>

    </div>


    <!-- =========================================================
         RESUME
    ========================================================== -->

    <div class="resume-page-wrapper">

        <div class="resume-sheet"
             id="resumeSheet"
             data-theme="blue">


            <!-- =====================================================
                 HEADER
            ====================================================== -->

            <header class="resume-header">


                <!-- PHOTO -->

                <div class="photo-wrapper">

                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto"
                             class="profile-photo"
                             alt="Profile" />
                    }
                    else
                    {
                        <div class="profile-placeholder">

                            <i class="fa fa-user"></i>

                        </div>
                    }

                </div>


                <!-- NAME -->

                <div class="header-info">

                    @if (Has(candidateName))
                    {
                        <div class="candidate-name">
                            @candidateName
                        </div>
                    }


                    @if (Has(candidateRole))
                    {
                        <div class="candidate-role">
                            @candidateRole
                        </div>
                    }


                    <div class="header-accent"></div>

                </div>


                <!-- CONTACT -->

                <div class="header-contact">


                    @if (Has(Model.CandidatePhone))
                    {
                        <div class="header-contact-item">

                            <i class="fa fa-phone"></i>

                            <span>
                                @Model.CandidatePhone
                            </span>

                        </div>
                    }


                    @if (Has(Model.CandidateEmail))
                    {
                        <div class="header-contact-item">

                            <i class="fa fa-envelope"></i>

                            <span>
                                @Model.CandidateEmail
                            </span>

                        </div>
                    }


                    @if (Has(p.Pincode))
                    {
                        <div class="header-contact-item">

                            <i class="fa fa-location-dot"></i>

                            <span id="rvAddress"
                                  data-country-id="@p.CountryID"
                                  data-state-id="@p.StateID"
                                  data-city-id="@p.CityID"
                                  data-pincode="@p.Pincode">

                                @p.Pincode

                            </span>

                        </div>
                    }


                </div>

            </header>


            <!-- =====================================================
                 BODY
            ====================================================== -->

            <div class="resume-body">


                <!-- =================================================
                     LEFT COLUMN
                ================================================== -->

                <aside class="left-column">


                    <!-- CONTACT / LOCATION -->

                    <section class="resume-section">

                        <div class="section-heading">

                            <div class="section-icon">
                                <i class="fa fa-address-card"></i>
                            </div>

                            <div class="section-title">
                                Contact
                            </div>

                            <div class="section-title-line"></div>

                        </div>


                        @if (Has(Model.CandidatePhone))
                        {
                            <div class="info-item">

                                <div class="info-icon">
                                    <i class="fa fa-phone"></i>
                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Phone
                                    </span>

                                    <span class="info-value">
                                        @Model.CandidatePhone
                                    </span>

                                </div>

                            </div>
                        }


                        @if (Has(Model.CandidateEmail))
                        {
                            <div class="info-item">

                                <div class="info-icon">
                                    <i class="fa fa-envelope"></i>
                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Email
                                    </span>

                                    <span class="info-value">
                                        @Model.CandidateEmail
                                    </span>

                                </div>

                            </div>
                        }


                        @if (Has(p.Pincode))
                        {
                            <div class="info-item">

                                <div class="info-icon">
                                    <i class="fa fa-location-dot"></i>
                                </div>

                                <div class="info-content">

                                    <span class="info-label">
                                        Location
                                    </span>

                                    <span class="info-value">

                                        <span id="rvAddressLeft"
                                              data-country-id="@p.CountryID"
                                              data-state-id="@p.StateID"
                                              data-city-id="@p.CityID"
                                              data-pincode="@p.Pincode">

                                            @p.Pincode

                                        </span>

                                    </span>

                                </div>

                            </div>
                        }

                    </section>


                    <!-- SKILLS -->
                    @{
                        var skillGroups = new[]
                        {
                    ("Technical", p.sTechnicalSkillIDs),
                    ("Medical", p.sMedicalSkillIDs),
                    ("Non-Technical", p.sNonTechnicalSkillIDs)
                    }
                        .Where(x => Has(x.Item2))
                        .ToList();
                    }


                    @if (skillGroups.Any())
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-layer-group"></i>
                                </div>

                                <div class="section-title">
                                    Skills
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            @foreach (var group in skillGroups)
                            {

                                <div class="skill-group">

                                    <div class="skill-group-title">
                                        @group.Item1
                                    </div>


                                    <div class="skill-list">

                                        @foreach (var skill in group.Item2.Split(
                                       new[] { ',', ';', '|' },
                                       StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="skill">
                                                @skill.Trim()
                                            </span>
                                        }

                                    </div>

                                </div>

                            }

                        </section>
                    }


                    <!-- LANGUAGES -->
                    @{
                        var langItems =
                        new List<(string Lang, string Star)>();

                        for (int i = 1; i <= 8; i++)
                        {
                            var lang =
                            typeof(ErJobPortal.Models.CandidateProfileModel)
                            .GetProperty($"sLanguage{i}")
                            ?.GetValue(p)
                            ?.ToString();

                            var star =
                            typeof(ErJobPortal.Models.CandidateProfileModel)
                            .GetProperty($"sLanguageStar{i}")
                            ?.GetValue(p)
                            ?.ToString();

                            if (Has(lang))
                            {
                                langItems.Add((lang, star));
                            }
                        }
                    }


                    @if (langItems.Any())
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-language"></i>
                                </div>

                                <div class="section-title">
                                    Languages
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            <div class="language-list">

                                @foreach (var lang in langItems)
                                {
                                    <div class="language-row">

                                        <span class="language-name">
                                            @lang.Lang
                                        </span>


                                        @if (Has(lang.Star))
                                        {
                                            <span class="language-level">
                                                @lang.Star ★
                                            </span>
                                        }

                                    </div>
                                }

                            </div>

                        </section>
                    }


                    <!-- INTERESTS -->
                    @if (Has(p.sHobbies))
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-heart"></i>
                                </div>

                                <div class="section-title">
                                    Interests
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            <div class="interest-box">
                                @p.sHobbies
                            </div>

                        </section>
                    }


                    <!-- SOCIAL LINKS -->
                    @if (Has(p.GitHub) || Has(p.Linkedin))
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-link"></i>
                                </div>

                                <div class="section-title">
                                    Links
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            @if (Has(p.GitHub))
                            {
                                <div class="social-item">

                                    <i class="fa-brands fa-github"></i>

                                    <span>
                                        @p.GitHub
                                    </span>

                                </div>
                            }


                            @if (Has(p.Linkedin))
                            {
                                <div class="social-item">

                                    <i class="fa-brands fa-linkedin"></i>

                                    <span>
                                        @p.Linkedin
                                    </span>

                                </div>
                            }

                        </section>
                    }


                </aside>


                <!-- =================================================
                     RIGHT COLUMN
                ================================================== -->

                <main class="right-column">


                    <!-- PROFILE -->
                    @if (Has(p.Objective))
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-user-tie"></i>
                                </div>

                                <div class="section-title">
                                    Professional Profile
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            <p class="summary">
                                @p.Objective
                            </p>

                        </section>
                    }


                    <!-- EXPERIENCE -->
                    @{
                        var internships = new[]
                        {
                    new
                    {
                    Name = p.sOrgName1,
                    Title = p.sOrgIntTitle1,
                    Duration = p.sOrgIntDuration1,
                    Status = p.sOrgIntStatus1
                    },

                    new
                    {
                    Name = p.sOrgName2,
                    Title = p.sOrgIntTitle2,
                    Duration = p.sOrgIntDuration2,
                    Status = p.sOrgIntStatus2
                    },

                    new
                    {
                    Name = p.sOrgName3,
                    Title = p.sOrgIntTitle3,
                    Duration = p.sOrgIntDuration3,
                    Status = p.sOrgIntStatus3
                    },

                    new
                    {
                    Name = p.sOrgName4,
                    Title = p.sOrgIntTitle4,
                    Duration = p.sOrgIntDuration4,
                    Status = p.sOrgIntStatus4
                    }
                    }
                        .Where(x => Has(x.Name))
                        .ToList();
                    }


                    @if (internships.Any())
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-briefcase"></i>
                                </div>

                                <div class="section-title">
                                    Experience
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            @foreach (var exp in internships)
                            {
                                <div class="experience">


                                    @if (Has(GetLookupName(
                                   Model.InternshipTitles,
                                   exp.Title)))
                                    {
                                        <div class="experience-title">

                                            @GetLookupName(
                                                     Model.InternshipTitles,
                                                     exp.Title)

                                        </div>
                                    }


                                    <div class="experience-company">
                                        @exp.Name
                                    </div>


                                    <div class="experience-meta">

                                        @GetLookupName(
                                                 Model.InternshipDurations,
                                                 exp.Duration)


                                        @if (Has(GetLookupName(
                                       Model.InternshipStatuses,
                                       exp.Status)))
                                        {
                                            <span>
                                                &nbsp;•&nbsp;

                                                @GetLookupName(
                                                         Model.InternshipStatuses,
                                                         exp.Status)
                                            </span>
                                        }

                                    </div>

                                </div>
                            }

                        </section>
                    }


                    <!-- EDUCATION -->
                    @if (
                    HasNum(p.PG_Year) ||
                    HasNum(p.Graduation_Year) ||
                    HasNum(p.HSC_DIPLOMA_YEAR) ||
                    HasNum(p.SSC_YEAR)
                    )
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-graduation-cap"></i>
                                </div>

                                <div class="section-title">
                                    Education
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            <div class="education-grid">


                                @if (HasNum(p.PG_Year))
                                {
                                    <div class="education-card">

                                        <div class="education-title">

                                            @GetLookupName(
                                                     Model.Streams,
                                                     p.PG_Stream)

                                        </div>

                                        <div class="education-meta">

                                            Post Graduation
                                            •
                                            @p.PG_Year

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.PG_Division)

                                        </div>

                                    </div>
                                }


                                @if (HasNum(p.Graduation_Year))
                                {
                                    <div class="education-card">

                                        <div class="education-title">

                                            @GetLookupName(
                                                     Model.Streams,
                                                     p.Graduation_Stream)

                                        </div>

                                        <div class="education-meta">

                                            Graduation
                                            •
                                            @p.Graduation_Year

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.Graduation_Division)

                                        </div>

                                    </div>
                                }


                                @if (HasNum(p.HSC_DIPLOMA_YEAR))
                                {
                                    <div class="education-card">

                                        <div class="education-title">
                                            HSC / Diploma
                                        </div>

                                        <div class="education-meta">

                                            @p.HSC_DIPLOMA_YEAR

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.HSC_DIPLOMA_DIVISION)

                                        </div>

                                    </div>
                                }


                                @if (HasNum(p.SSC_YEAR))
                                {
                                    <div class="education-card">

                                        <div class="education-title">
                                            SSC
                                        </div>

                                        <div class="education-meta">

                                            @p.SSC_YEAR

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.SSC_DIVISION)

                                        </div>

                                    </div>
                                }


                            </div>

                        </section>
                    }


                    <!-- ACHIEVEMENTS -->
                    @{
                        var achievements = new[]
                        {
                    p.Achievements_Certification1,
                    p.Achievements_Certification2,
                    p.Achievements_Certification3
                    }
                        .Where(Has)
                        .ToList();
                    }


                    @if (achievements.Any())
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-award"></i>
                                </div>

                                <div class="section-title">
                                    Certifications & Awards
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            @foreach (var achievement in achievements)
                            {
                                <div class="achievement">

                                    <span>
                                        @achievement
                                    </span>

                                </div>
                            }

                        </section>
                    }


                    <!-- REFERENCES -->
                    @if (Has(p.sRefName1) || Has(p.sRefName2))
                    {
                        <section class="resume-section">

                            <div class="section-heading">

                                <div class="section-icon">
                                    <i class="fa fa-user-group"></i>
                                </div>

                                <div class="section-title">
                                    References
                                </div>

                                <div class="section-title-line"></div>

                            </div>


                            <div class="reference-grid">


                                @if (Has(p.sRefName1))
                                {
                                    <div class="reference-card">

                                        <div class="reference-name">
                                            @p.sRefName1
                                        </div>


                                        @if (Has(GetLookupName(
                                       Model.Relationships,
                                       p.sRefRelationName1)))
                                        {
                                            <div class="reference-relation">

                                                @GetLookupName(
                                                         Model.Relationships,
                                                         p.sRefRelationName1)

                                            </div>
                                        }


                                        @if (Has(p.sMobile1))
                                        {
                                            <div class="reference-phone">

                                                <i class="fa fa-phone"></i>

                                                @p.sMobile1

                                            </div>
                                        }

                                    </div>
                                }


                                @if (Has(p.sRefName2))
                                {
                                    <div class="reference-card">

                                        <div class="reference-name">
                                            @p.sRefName2
                                        </div>


                                        @if (Has(GetLookupName(
                                       Model.Relationships,
                                       p.sRefRelationName2)))
                                        {
                                            <div class="reference-relation">

                                                @GetLookupName(
                                                         Model.Relationships,
                                                         p.sRefRelationName2)

                                            </div>
                                        }


                                        @if (Has(p.sMobile2))
                                        {
                                            <div class="reference-phone">

                                                <i class="fa fa-phone"></i>

                                                @p.sMobile2

                                            </div>
                                        }

                                    </div>
                                }


                            </div>

                        </section>
                    }


                </main>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PDF LIBRARIES
    ========================================================== -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>


    <!-- =========================================================
         SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sheet =
                document.getElementById("resumeSheet");

            const swatches =
                document.querySelectorAll(".theme-swatch");

            const savedTheme =
                localStorage.getItem("resumeThemeV7") || "blue";


            sheet.setAttribute(
                "data-theme",
                savedTheme
            );


            swatches.forEach(function (swatch) {

                swatch.classList.toggle(
                    "active",
                    swatch.dataset.theme === savedTheme
                );


                swatch.addEventListener(
                    "click",
                    function () {

                        const theme =
                            this.dataset.theme;


                        sheet.setAttribute(
                            "data-theme",
                            theme
                        );


                        swatches.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        this.classList.add(
                            "active"
                        );


                        localStorage.setItem(
                            "resumeThemeV7",
                            theme
                        );

                    }
                );

            });


            /* =====================================================
               ADDRESS
            ====================================================== */

            const addressElements =
                document.querySelectorAll(
                    "[data-country-id]"
                );


            if (!addressElements.length)
                return;


            const firstAddress =
                addressElements[0];


            const countryID =
                firstAddress.getAttribute(
                    "data-country-id"
                ) || "";


            const stateID =
                firstAddress.getAttribute(
                    "data-state-id"
                ) || "";


            const cityID =
                firstAddress.getAttribute(
                    "data-city-id"
                ) || "";


            const pincode =
                firstAddress.getAttribute(
                    "data-pincode"
                ) || "";


            function renderAddress(
                cityName,
                stateName,
                countryName
            ) {

                const parts = [
                    cityName,
                    stateName,
                    countryName,
                    pincode
                ]
                .filter(
                    v => v && v.trim()
                );


                const address =
                    parts.join(", ");


                addressElements.forEach(
                    function (element) {

                        element.textContent =
                            address;

                    }
                );

            }


            if (!countryID) {

                renderAddress(
                    "",
                    "",
                    ""
                );

                return;
            }


            fetch("/Location/GetCountries")

                .then(res => res.json())

                .then(countries => {

                    const country =
                        countries.find(
                            c =>
                                String(c.id) ===
                                String(countryID)
                        );


                    const countryName =
                        country
                            ? country.name
                            : "";


                    const countryCode =
                        country
                            ? country.iso2
                            : countryID;


                    if (!stateID) {

                        renderAddress(
                            "",
                            "",
                            countryName
                        );

                        return;
                    }


                    return fetch(
                        "/Location/GetStates?countryCode="
                        +
                        encodeURIComponent(
                            countryCode
                        )
                    )

                    .then(
                        res => res.json()
                    )

                    .then(states => {

                        const state =
                            states.find(
                                s =>
                                    String(s.id) ===
                                    String(stateID)
                            );


                        const stateName =
                            state
                                ? state.name
                                : "";


                        const stateCode =
                            state
                                ? (
                                    state.stateCode ||
                                    String(
                                        state.id
                                    ).split(":")[1]
                                )
                                : "";


                        if (!cityID) {

                            renderAddress(
                                "",
                                stateName,
                                countryName
                            );

                            return;
                        }


                        return fetch(
                            "/Location/GetCities?countryCode="
                            +
                            encodeURIComponent(
                                countryCode
                            )
                            +
                            "&stateCode="
                            +
                            encodeURIComponent(
                                stateCode
                            )
                        )

                        .then(
                            res => res.json()
                        )

                        .then(cities => {

                            const city =
                                cities.find(
                                    c =>
                                        String(c.id) ===
                                        String(cityID)
                                );


                            const cityName =
                                city
                                    ? city.name
                                    : "";


                            renderAddress(
                                cityName,
                                stateName,
                                countryName
                            );

                        });

                    });

                })

                .catch(
                    error =>
                        console.log(
                            "Address resolution error:",
                            error
                        )
                );

        });


        /* =========================================================
           DOWNLOAD PDF
        ========================================================== */

        async function downloadResumePDF() {

            const sheet =
                document.getElementById(
                    "resumeSheet"
                );


            const button =
                document.querySelector(
                    ".btn-download"
                );


            const original =
                button.innerHTML;


            try {

                button.disabled = true;


                button.innerHTML =
                    '<i class="fa fa-spinner fa-spin"></i>';


                const images =
                    sheet.querySelectorAll(
                        "img"
                    );


                await Promise.all(

                    Array.from(images).map(

                        img =>

                            img.complete

                                ? Promise.resolve()

                                : new Promise(
                                    resolve => {

                                        img.onload =
                                            resolve;

                                        img.onerror =
                                            resolve;

                                    }
                                )

                    )

                );


                const canvas =
                    await html2canvas(
                        sheet,
                        {
                            scale: 2,

                            useCORS: true,

                            allowTaint: false,

                            backgroundColor:
                                "#ffffff",

                            logging: false,

                            width: 1123,

                            height: 794
                        }
                    );


                const { jsPDF } =
                    window.jspdf;


                const pdf =
                    new jsPDF(
                        {
                            orientation:
                                "landscape",

                            unit: "mm",

                            format: "a4",

                            compress: true
                        }
                    );


                const imgData =
                    canvas.toDataURL(
                        "image/jpeg",
                        .95
                    );


                pdf.addImage(
                    imgData,
                    "JPEG",
                    0,
                    0,
                    297,
                    210
                );


                pdf.save(
                    (window.candidateName ||
                        "Resume")
                    + ".pdf"
                );

            }
            catch (error) {

                console.error(
                    "PDF error:",
                    error
                );


                alert(
                    "Error generating PDF"
                );

            }
            finally {

                button.disabled =
                    false;

                button.innerHTML =
                    original;

            }

        }


        window.candidateName =
        @Html.Raw(
                     System.Text.Json.JsonSerializer.Serialize(
                         candidateName ?? "Resume"
                     )
                 );

    </script>

</body>

</html>