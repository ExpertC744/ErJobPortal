@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;

    ViewData["Title"] = "Resume";

    var p = Model.Profile;

    var candidateName = string.IsNullOrWhiteSpace(Model.CandidateName)
        ? "Candidate"
        : Model.CandidateName;
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                    return nameProp.GetValue(item)?.ToString() ?? "";
            }
        }

        return "";
    }

    bool Has(string s)
    {
        return !string.IsNullOrWhiteSpace(s);
    }

    bool HasNum(int? n)
    {
        return n.HasValue && n.Value != 0;
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @candidateName - Resume
    </title>


    <!-- =========================================================
         FONT AWESOME
         ========================================================= -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <!-- =========================================================
         GOOGLE FONTS
         ========================================================= -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet" />


    <!-- =========================================================
         COMMON RESUME FILE NAME
         ========================================================= -->

    <script>

        window.resumeFileName =
            @Html.Raw(
                          System.Text.Json.JsonSerializer.Serialize(
                              candidateName
                          )
                      );

    </script>


    <style>

        /* =========================================================
                                           ROOT VARIABLES
                           ========================================================= */

        :root {
            --side: #3b1f6e;
            --accent: #d6336c;
            --tint: #f6f0ff;
            --ink: #1f1b2a;
            --body: #4a4556;
            --muted: #857f93;
            --hair: #e6e2ee;
        }


        /* =========================================================
                                           GLOBAL
                           ========================================================= */

        * {
            box-sizing: border-box;
        }


        html,
        body {
            margin: 0;
            padding: 0;
            background: #e5e3ec;
            font-family: "Work Sans", "Segoe UI", Arial, sans-serif;
        }


        /* =========================================================
                                           THEME SWITCHER
                           ========================================================= */

        .theme-switcher {
            max-width: 297mm;
            margin: 24px auto 16px auto;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0;
        }


        .theme-switcher-label {
            font-size: 12px;
            color: #6b6478;
            font-weight: 700;
            margin-right: 4px;
            white-space: nowrap;
        }


        .theme-swatch {
            width: 30px;
            height: 30px;
            border-radius: 7px;
            cursor: pointer;
            border: 2px solid #ffffff;
            box-shadow: 0 0 0 1px #d4cee2;
            overflow: hidden;
            transition: transform .18s ease, box-shadow .18s ease;
            flex: 0 0 auto;
        }


            .theme-swatch:hover {
                transform: translateY(-2px);
                box-shadow: 0 0 0 2px #aaa1b7, 0 4px 10px rgba(31, 27, 42, .12);
            }


            .theme-swatch.active {
                box-shadow: 0 0 0 2px var(--ink), 0 3px 8px rgba(31, 27, 42, .15);
                transform: translateY(-1px);
            }


        /* =========================================================
                                           PAGE WRAPPER
                           ========================================================= */

        .resume-page-wrapper {
            background: #e5e3ec;
            padding: 10px 0 60px 0;
        }


        /* =========================================================
                                           A4 LANDSCAPE
                                           297mm × 210mm
                           ========================================================= */

        .resume-sheet {
            width: 297mm;
            min-height: 210mm;
            height: 210mm;
            margin: 0 auto;
            background: #ffffff;
            border-radius: 6px;
            box-shadow: 0 1px 3px rgba(31, 27, 42, 0.12), 0 16px 34px -14px rgba(31, 27, 42, 0.35);
            display: flex;
            align-items: stretch;
            font-family: "Work Sans", "Segoe UI", Arial, sans-serif;
            color: var(--ink);
            position: relative;
            box-sizing: border-box;
            overflow: hidden;
        }


        /* =========================================================
                                           LEFT SIDEBAR
                           ========================================================= */

        .resume-sidebar {
            width: 30%;
            background: var(--side);
            color: #ffffff;
            padding: 26px 24px;
            box-sizing: border-box;
            min-width: 0;
            overflow: hidden;
            border-right: 5px solid var(--accent);
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            gap: 12px;
        }


        /* =========================================================
                                           PHOTO
                           ========================================================= */

        .resume-photo-wrap {
            margin-bottom: 0;
        }


        .resume-photo,
        .resume-photo-placeholder {
            width: 108px;
            height: 108px;
            border-radius: 14px;
            border: 3px solid rgba(255, 255, 255, .9);
            background: rgba(255, 255, 255, .14);
        }


        .resume-photo {
            object-fit: cover;
            display: block;
        }


        .resume-photo-placeholder {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 34px;
            color: rgba(255, 255, 255, .85);
        }


        /* =========================================================
                                           SIDEBAR SECTION
                           ========================================================= */

        .resume-sidebar-section {
            margin-bottom: 0;
        }


        .resume-sidebar-title {
            color: #ffffff;
            font-size: 12.8px;
            font-weight: 700;
            letter-spacing: .3px;
            margin-bottom: 8px;
            padding-bottom: 5px;
            border-bottom: 1px solid rgba(255, 255, 255, .28);
            display: flex;
            align-items: center;
            gap: 7px;
        }


            .resume-sidebar-title i {
                font-size: 10.5px;
                opacity: .75;
                width: 12px;
                text-align: center;
            }


        .resume-sidebar-item {
            font-size: 11.8px;
            line-height: 1.5;
            margin-bottom: 6px;
            word-break: break-word;
            color: rgba(255, 255, 255, .88);
        }


            .resume-sidebar-item strong {
                display: block;
                color: #ffffff;
                font-size: 12.4px;
                font-weight: 600;
            }


        .side-tag {
            display: inline-block;
            border: 1px solid rgba(255, 255, 255, .55);
            border-radius: 5px;
            padding: 2px 8px;
            margin-top: 2px;
            color: #ffffff;
        }


        .resume-sidebar-item.ref {
            padding-left: 8px;
            border-left: 2px solid var(--accent);
        }


        /* =========================================================
                                           MAIN
                           ========================================================= */

        .resume-main {
            flex: 1;
            padding: 24px 28px;
            box-sizing: border-box;
            min-width: 0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                                           HEADER
                           ========================================================= */

        .resume-name {
            font-family: "Fraunces", Georgia, serif;
            font-size: 30px;
            font-weight: 700;
            color: var(--ink);
            margin: 0;
            line-height: 1.1;
            word-break: break-word;
        }


        .resume-role {
            font-size: 13px;
            color: var(--accent);
            font-weight: 600;
            margin: 6px 0 0 0;
        }


        .resume-head {
            padding-bottom: 12px;
            margin-bottom: 14px;
            border-bottom: 1px solid var(--hair);
        }


        /* =========================================================
                                           TWO COLUMNS
                           ========================================================= */

        .resume-cols {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 26px;
            flex: 1;
            min-height: 0;
        }


        .resume-col {
            min-width: 0;
        }


        /* =========================================================
                                           SECTIONS
                           ========================================================= */

        .resume-section {
            margin-bottom: 15px;
            break-inside: avoid;
            page-break-inside: avoid;
        }


        .resume-section-title {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink);
            margin-bottom: 8px;
            padding-left: 9px;
            border-left: 4px solid var(--accent);
            line-height: 1.2;
        }


        .resume-section-body p {
            font-size: 11.6px;
            line-height: 1.55;
            color: var(--body);
            margin: 0 0 4px 0;
            word-break: break-word;
        }


        /* =========================================================
                                           ENTRIES
                           ========================================================= */

        .resume-entry {
            margin-bottom: 8px;
            padding: 2px 0 2px 11px;
            border-left: 1px solid var(--hair);
            break-inside: avoid;
            page-break-inside: avoid;
        }


        .resume-entry-title {
            font-size: 12.2px;
            font-weight: 600;
            color: var(--ink);
        }


        .resume-entry-sub {
            font-size: 11.4px;
            color: var(--accent);
            font-weight: 600;
            margin: 1px 0 2px 0;
        }


        .resume-entry-meta {
            font-size: 10.8px;
            color: var(--muted);
        }


        /* =========================================================
                                           SKILLS
                           ========================================================= */

        .resume-skill-row {
            margin-bottom: 7px;
        }


        .resume-skill-label {
            font-size: 11.4px;
            font-weight: 600;
            color: var(--ink);
            margin-bottom: 4px;
        }


        .resume-skill-row .resume-section-body p {
            display: inline-block;
            border: 1px solid var(--accent);
            color: var(--ink);
            font-weight: 500;
            padding: 3px 10px;
            border-radius: 5px;
            margin: 0 5px 5px 0;
        }


        /* =========================================================
                                           THEME 1
                                           VIOLET + PINK
                           ========================================================= */

        .resume-sheet[data-theme="violet-pink"] {
            --side: #3b1f6e;
            --accent: #d6336c;
            --tint: #f6f0ff;
        }


        /* =========================================================
                                           THEME 2
                                           BLUE + CYAN
                           ========================================================= */

        .resume-sheet[data-theme="blue-cyan"] {
            --side: #0f3b66;
            --accent: #0891b2;
            --tint: #eaf4fb;
        }


        /* =========================================================
                                           THEME 3
                                           ORANGE + ROSE
                           ========================================================= */

        .resume-sheet[data-theme="orange-rose"] {
            --side: #7c2d12;
            --accent: #ea580c;
            --tint: #fff3ec;
        }


        /* =========================================================
                                           THEME 4
                                           GREEN + LIME
                           ========================================================= */

        .resume-sheet[data-theme="green-lime"] {
            --side: #14532d;
            --accent: #65a30d;
            --tint: #eff8e6;
        }


        /* =========================================================
                                           THEME 5
                                           INDIGO + SKY
                           ========================================================= */

        .resume-sheet[data-theme="indigo-sky"] {
            --side: #1e1b4b;
            --accent: #0284c7;
            --tint: #eceefe;
        }


        /* =========================================================
                                           THEME 6
                                           FUCHSIA + AMBER
                           ========================================================= */

        .resume-sheet[data-theme="fuchsia-amber"] {
            --side: #581c87;
            --accent: #d97706;
            --tint: #fbf1fa;
        }


        /* =========================================================
                                           MOBILE
                           ========================================================= */

        @@media (max-width: 1150px) {

            body {
                background: #ffffff;
            }


            .theme-switcher {
                padding: 0 15px;
                justify-content: center;
                flex-wrap: wrap;
            }


            .resume-page-wrapper {
                padding: 10px 0 30px;
                overflow: hidden;
            }


            .resume-sheet {
                transform-origin: top left;
                margin: 0;
            }
        }


        /* =========================================================
                                           PRINT
                           ========================================================= */

        @@media print {

            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }


            html,
            body {
                width: 297mm;
                height: 210mm;
                margin: 0;
                padding: 0;
                background: #ffffff;
            }


                body * {
                    visibility: hidden;
                }


            .resume-sheet,
            .resume-sheet * {
                visibility: visible;
            }


            .resume-page-wrapper {
                padding: 0;
                margin: 0;
                background: #ffffff;
                height: auto !important;
                overflow: visible;
            }


            .resume-sheet {
                width: 297mm;
                height: 210mm;
                min-height: 210mm;
                margin: 0;
                border-radius: 0;
                box-shadow: none;
                display: flex;
                overflow: hidden;
                transform: none !important;
            }


            .theme-switcher {
                display: none !important;
            }


            .resume-section,
            .resume-entry,
            .resume-sidebar-section {
                break-inside: avoid;
                page-break-inside: avoid;
            }


            @@page {
                size: A4 landscape;
                margin: 0;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         THEME SWITCHER
         ========================================================= -->

    <div class="theme-switcher">

        <span class="theme-switcher-label">
            Theme
        </span>


        <!-- VIOLET / PINK -->

        <div class="theme-swatch active"
             data-theme="violet-pink"
             style="background:linear-gradient(135deg,#3b1f6e 50%,#d6336c 50%);"
             title="Violet & Pink">
        </div>


        <!-- BLUE / CYAN -->

        <div class="theme-swatch"
             data-theme="blue-cyan"
             style="background:linear-gradient(135deg,#0f3b66 50%,#0891b2 50%);"
             title="Blue & Cyan">
        </div>


        <!-- ORANGE / ROSE -->

        <div class="theme-swatch"
             data-theme="orange-rose"
             style="background:linear-gradient(135deg,#7c2d12 50%,#ea580c 50%);"
             title="Rust & Orange">
        </div>


        <!-- GREEN / LIME -->

        <div class="theme-swatch"
             data-theme="green-lime"
             style="background:linear-gradient(135deg,#14532d 50%,#65a30d 50%);"
             title="Forest & Lime">
        </div>


        <!-- INDIGO / SKY -->

        <div class="theme-swatch"
             data-theme="indigo-sky"
             style="background:linear-gradient(135deg,#1e1b4b 50%,#0284c7 50%);"
             title="Indigo & Sky">
        </div>


        <!-- FUCHSIA / AMBER -->

        <div class="theme-swatch"
             data-theme="fuchsia-amber"
             style="background:linear-gradient(135deg,#581c87 50%,#d97706 50%);"
             title="Purple & Amber">
        </div>

    </div>


    <!-- =========================================================
         RESUME WRAPPER
         ========================================================= -->

    <div class="resume-page-wrapper"
         id="resumeWrapper">


        <!-- =====================================================
             A4 RESUME SHEET
             ===================================================== -->

        <div class="resume-sheet"
             id="resumeSheet"
             data-theme="violet-pink">


            <!-- =================================================
                 SIDEBAR
                 ================================================= -->

            <div class="resume-sidebar">


                <!-- PHOTO -->

                <div class="resume-photo-wrap">

                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto"
                             class="resume-photo"
                             alt="Candidate Photo" />
                    }
                    else
                    {
                        <div class="resume-photo-placeholder">

                            <i class="fa fa-user"></i>

                        </div>
                    }

                </div>


                <!-- CONTACT -->
                @if (Has(Model.CandidateEmail) ||
                Has(Model.CandidatePhone))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">

                            <i class="fa fa-envelope"></i>

                            Contact

                        </div>


                        @if (Has(Model.CandidateEmail))
                        {

                            <div class="resume-sidebar-item">

                                @Model.CandidateEmail

                            </div>

                        }


                        @if (Has(Model.CandidatePhone))
                        {

                            <div class="resume-sidebar-item">

                                @Model.CandidatePhone

                            </div>

                        }

                    </div>

                }


                <!-- ADDRESS -->
                @if (Has(p.CountryID) ||
                Has(p.StateID) ||
                Has(p.CityID) ||
                Has(p.Pincode))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">

                            <i class="fa fa-map-marker"></i>

                            Address

                        </div>


                        <div class="resume-sidebar-item">

                            <span id="rvAddress"
                                  data-country-id="@p.CountryID"
                                  data-state-id="@p.StateID"
                                  data-city-id="@p.CityID"
                                  data-pincode="@p.Pincode">

                                @if (Has(p.Pincode))
                                {
                                    @p.Pincode
                                }
                                else
                                {
                                    <text>-</text>
                                }

                            </span>

                        </div>

                    </div>

                }


                <!-- SOCIAL LINKS -->
                @if (Has(p.GitHub) ||
                Has(p.Linkedin))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">

                            <i class="fa fa-link"></i>

                            Links

                        </div>


                        @if (Has(p.GitHub))
                        {

                            <div class="resume-sidebar-item">

                                <i class="fa-brands fa-github"
                                   style="margin-right:4px;">
                                </i>

                                @p.GitHub

                            </div>

                        }


                        @if (Has(p.Linkedin))
                        {

                            <div class="resume-sidebar-item">

                                <i class="fa-brands fa-linkedin"
                                   style="margin-right:4px;">
                                </i>

                                @p.Linkedin

                            </div>

                        }

                    </div>

                }


                <!-- LANGUAGES -->
                @{

                    var langItems =
                    new List<(string Lang, string Star)>();


                    for (int i = 1; i <= 8; i++)
                    {

                        var lang =
                        typeof(
                        ErJobPortal.Models.CandidateProfileModel
                        )
                        .GetProperty($"sLanguage{i}")
                        ?.GetValue(p)
                        ?.ToString();


                        var star =
                        typeof(
                        ErJobPortal.Models.CandidateProfileModel
                        )
                        .GetProperty($"sLanguageStar{i}")
                        ?.GetValue(p)
                        ?.ToString();


                        if (Has(lang))
                        {

                            langItems.Add(
                            (lang, star)
                            );

                        }

                    }

                }

                <!-- SKILLS -->
                @{

                    var skillGroups =
                    new[]
                    {
                ("Technical", p.sTechnicalSkillIDs),
                ("Medical", p.sMedicalSkillIDs),
                ("Non-Technical", p.sNonTechnicalSkillIDs)
            }
                    .Where(x => Has(x.Item2))
                    .ToList();

                }


                @if (skillGroups.Any())
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">

                            <i class="fa fa-star"></i>

                            Skills

                        </div>


                        @foreach (var g in skillGroups)
                        {

                            <div class="resume-sidebar-item">

                                <strong>
                                    @g.Item1
                                </strong>


                                <span class="side-tag">
                                    @g.Item2
                                </span>

                            </div>

                        }

                    </div>

                }


                @if (langItems.Any())
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">

                            <i class="fa fa-language"></i>

                            Languages

                        </div>


                        @foreach (var l in langItems)
                        {

                            <div class="resume-sidebar-item">

                                @l.Lang


                                @if (Has(l.Star))
                                {

                                    <span>
                                        — @l.Star&#9733;
                                    </span>

                                }

                            </div>

                        }

                    </div>

                }


                <!-- REFERENCES -->
                @if (Has(p.sRefName1) ||
                Has(p.sRefName2))
                {

                    <div class="resume-sidebar-section">

                        <div class="resume-sidebar-title">

                            <i class="fa fa-users"></i>

                            References

                        </div>


                        @if (Has(p.sRefName1))
                        {

                            <div class="resume-sidebar-item ref">

                                <strong>
                                    @p.sRefName1
                                </strong>


                                @GetLookupName(
                                         Model.Relationships,
                                         p.sRefRelationName1
                                         )


                                @if (Has(p.sLocation1))
                                {

                                    <br />

                                    @p.sLocation1

                                }


                                @if (Has(p.sMobile1))
                                {

                                    <br />

                                    <text>
                                        Tel: @p.sMobile1
                                    </text>

                                }

                            </div>

                        }


                        @if (Has(p.sRefName2))
                        {

                            <div class="resume-sidebar-item ref">

                                <strong>
                                    @p.sRefName2
                                </strong>


                                @GetLookupName(
                                         Model.Relationships,
                                         p.sRefRelationName2
                                         )


                                @if (Has(p.sLocation2))
                                {

                                    <br />

                                    @p.sLocation2

                                }


                                @if (Has(p.sMobile2))
                                {

                                    <br />

                                    <text>
                                        Tel: @p.sMobile2
                                    </text>

                                }

                            </div>

                        }

                    </div>

                }



            </div>


            <!-- =================================================
                 MAIN CONTENT
                 ================================================= -->

            <div class="resume-main">


                <!-- NAME + ROLE -->

                <div class="resume-head">

                    <h1 class="resume-name">

                        @candidateName

                    </h1>


                    <div class="resume-role">

                        @GetLookupName(
                                 Model.InternshipFellowshipType,
                                 p.Internship_FellowshipType
                                 )

                    </div>

                </div>


                <!-- TWO COLUMNS -->

                <div class="resume-cols">


                    <!-- =================================================
                         COLUMN A
                         ================================================= -->

                    <div class="resume-col">


                        <!-- ABOUT -->
                        @if (Has(p.Objective))
                        {

                            <div class="resume-section">

                                <div class="resume-section-title">

                                    About Me

                                </div>


                                <div class="resume-section-body">

                                    <p>
                                        @p.Objective
                                    </p>

                                </div>

                            </div>

                        }


                        <!-- INTERNSHIPS -->
                        @{

                            var internships =
                            new[]
                            {
                        new
                        {
                        Name = p.sOrgName1,
                        Title = p.sOrgIntTitle1,
                        Duration = p.sOrgIntDuration1,
                        Status = p.sOrgIntStatus1
                        },

                        new
                        {
                        Name = p.sOrgName2,
                        Title = p.sOrgIntTitle2,
                        Duration = p.sOrgIntDuration2,
                        Status = p.sOrgIntStatus2
                        },

                        new
                        {
                        Name = p.sOrgName3,
                        Title = p.sOrgIntTitle3,
                        Duration = p.sOrgIntDuration3,
                        Status = p.sOrgIntStatus3
                        },

                        new
                        {
                        Name = p.sOrgName4,
                        Title = p.sOrgIntTitle4,
                        Duration = p.sOrgIntDuration4,
                        Status = p.sOrgIntStatus4
                        }
            }
                            .Where(x => Has(x.Name))
                            .ToList();

                        }


                        @if (internships.Any())
                        {

                            <div class="resume-section">

                                <div class="resume-section-title">

                                    Internship Experience

                                </div>


                                @foreach (var it in internships)
                                {

                                    <div class="resume-entry">

                                        <div class="resume-entry-title">

                                            @GetLookupName(
                                                     Model.InternshipTitles,
                                                     it.Title
                                                     )

                                        </div>


                                        <div class="resume-entry-sub">

                                            @it.Name

                                        </div>


                                        <div class="resume-entry-meta">

                                            @GetLookupName(
                                                     Model.InternshipDurations,
                                                     it.Duration
                                                     )


                                            @if (
                                           Has(
                                           GetLookupName(
                                           Model.InternshipStatuses,
                                           it.Status
                                           )
                                           )
                                           )
                                            {

                                                <span>

                                                    &middot;

                                                    @GetLookupName(
                                                             Model.InternshipStatuses,
                                                             it.Status
                                                             )

                                                </span>

                                            }

                                        </div>

                                    </div>

                                }

                            </div>

                        }


                        <!-- ACHIEVEMENTS -->
                        @{

                            var achievements =
                            new[]
                            {
                        p.Achievements_Certification1,
                        p.Achievements_Certification2,
                        p.Achievements_Certification3
            }
                            .Where(Has)
                            .ToList();

                        }


                        @if (achievements.Any())
                        {

                            <div class="resume-section">

                                <div class="resume-section-title">

                                    Achievements & Certifications

                                </div>


                                <div class="resume-section-body">

                                    @foreach (var a in achievements)
                                    {

                                        <p>

                                            &bull; @a

                                        </p>

                                    }

                                </div>

                            </div>

                        }

                    </div>


                    <!-- =================================================
                         COLUMN B
                         ================================================= -->

                    <div class="resume-col">


                        <!-- EDUCATION -->
                        @if (
                        HasNum(p.Graduation_Year) ||
                        HasNum(p.PG_Year) ||
                        HasNum(p.HSC_DIPLOMA_YEAR) ||
                        HasNum(p.SSC_YEAR)
                        )
                        {

                            <div class="resume-section">

                                <div class="resume-section-title">

                                    Education

                                </div>


                                @if (HasNum(p.PG_Year))
                                {

                                    <div class="resume-entry">

                                        <div class="resume-entry-title">

                                            @GetLookupName(
                                                     Model.Streams,
                                                     p.PG_Stream
                                                     )

                                            — Post Graduation

                                        </div>


                                        <div class="resume-entry-meta">

                                            @p.PG_Year

                                            &middot;

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.PG_Division
                                                     )

                                        </div>

                                    </div>

                                }


                                @if (HasNum(p.Graduation_Year))
                                {

                                    <div class="resume-entry">

                                        <div class="resume-entry-title">

                                            @GetLookupName(
                                                     Model.Streams,
                                                     p.Graduation_Stream
                                                     )

                                            — Graduation

                                        </div>


                                        <div class="resume-entry-meta">

                                            @p.Graduation_Year

                                            &middot;

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.Graduation_Division
                                                     )

                                        </div>

                                    </div>

                                }


                                @if (HasNum(p.HSC_DIPLOMA_YEAR))
                                {

                                    <div class="resume-entry">

                                        <div class="resume-entry-title">

                                            HSC / Diploma

                                        </div>


                                        <div class="resume-entry-meta">

                                            @p.HSC_DIPLOMA_YEAR

                                            &middot;

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.HSC_DIPLOMA_DIVISION
                                                     )

                                        </div>

                                    </div>

                                }


                                @if (HasNum(p.SSC_YEAR))
                                {

                                    <div class="resume-entry">

                                        <div class="resume-entry-title">

                                            SSC / 10th

                                        </div>


                                        <div class="resume-entry-meta">

                                            @p.SSC_YEAR

                                            &middot;

                                            @GetLookupName(
                                                     Model.Divisions,
                                                     p.SSC_DIVISION
                                                     )

                                        </div>

                                    </div>

                                }

                            </div>

                        }


                        <!-- PREFERENCE -->
                        @{

                            var prefType =
                            GetLookupName(
                            Model.InternshipFellowshipType,
                            p.Internship_FellowshipType
                            );

                        }


                        @if (
                        Has(p.Preferred_City) ||
                        Has(p.Preferred_State) ||
                        Has(p.Preferred_Country) ||
                        Has(prefType)
                        )
                        {

                            <div class="resume-section">

                                <div class="resume-section-title">

                                    Internship / Fellowship Preference

                                </div>


                                <div class="resume-section-body">

                                    @if (Has(prefType))
                                    {

                                        <p>
                                            @prefType
                                        </p>

                                    }


                                    @if (
                                   Has(p.Preferred_City) ||
                                   Has(p.Preferred_State) ||
                                   Has(p.Preferred_Country)
                                   )
                                    {

                                        <p>

                                            @string.Join(
                                                     ", ",
                                                     new[]
                                                     {
                                    p.Preferred_City,
                                    p.Preferred_State,
                                    p.Preferred_Country
                                    }
                                                     .Where(Has)
                                                     )

                                        </p>

                                    }

                                </div>

                            </div>

                        }


                        <!-- HOBBIES -->
                        @if (Has(p.sHobbies))
                        {

                            <div class="resume-sidebar-section">

                                <div class="resume-sidebar-title">

                                    <i class="fa fa-heart"></i>

                                    Hobbies

                                </div>


                                <div class="resume-sidebar-item">

                                    @p.sHobbies

                                </div>

                            </div>

                        }



                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ADDRESS RESOLUTION
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var addressEl =
                    document.getElementById(
                        "rvAddress"
                    );


                if (!addressEl)
                    return;


                var countryID =
                    addressEl.getAttribute(
                        "data-country-id"
                    ) || "";


                var stateID =
                    addressEl.getAttribute(
                        "data-state-id"
                    ) || "";


                var cityID =
                    addressEl.getAttribute(
                        "data-city-id"
                    ) || "";


                var pincode =
                    addressEl.getAttribute(
                        "data-pincode"
                    ) || "";


                function renderAddress(
                    cityName,
                    stateName,
                    countryName
                ) {

                    var parts =
                        [
                            cityName,
                            stateName,
                            countryName,
                            pincode
                        ]
                        .filter(function (value) {

                            return value &&
                                   value.trim() !== "";

                        });


                    addressEl.textContent =
                        parts.length
                            ? parts.join(", ")
                            : "-";

                }


                if (!countryID) {

                    return;

                }


                fetch("/Location/GetCountries")

                    .then(function (res) {

                        return res.json();

                    })


                    .then(function (countries) {

                        var country =
                            countries.find(
                                function (c) {

                                    return String(c.id) ===
                                           String(countryID);

                                }
                            );


                        var countryName =
                            country
                                ? country.name
                                : "";


                        var countryCode =
                            country
                                ? country.iso2
                                : countryID;


                        if (!stateID) {

                            renderAddress(
                                "",
                                "",
                                countryName
                            );

                            return;

                        }


                        fetch(
                            "/Location/GetStates?countryCode=" +
                            encodeURIComponent(
                                countryCode
                            )
                        )

                        .then(function (res) {

                            return res.json();

                        })


                        .then(function (states) {

                            var state =
                                states.find(
                                    function (s) {

                                        return String(s.id) ===
                                               String(stateID);

                                    }
                                );


                            var stateName =
                                state
                                    ? state.name
                                    : "";


                            var stateCode =
                                state
                                    ? (
                                        state.stateCode ||
                                        (
                                            String(state.id)
                                                .split(":")[1] ||
                                            state.id
                                        )
                                      )
                                    : "";


                            if (!cityID) {

                                renderAddress(
                                    "",
                                    stateName,
                                    countryName
                                );

                                return;

                            }


                            fetch(
                                "/Location/GetCities?countryCode=" +
                                encodeURIComponent(
                                    countryCode
                                ) +
                                "&stateCode=" +
                                encodeURIComponent(
                                    stateCode
                                )
                            )

                            .then(function (res) {

                                return res.json();

                            })


                            .then(function (cities) {

                                var city =
                                    cities.find(
                                        function (c) {

                                            return String(c.id) ===
                                                   String(cityID);

                                        }
                                    );


                                var cityName =
                                    city
                                        ? city.name
                                        : "";


                                renderAddress(
                                    cityName,
                                    stateName,
                                    countryName
                                );

                            })


                            .catch(function () {

                                renderAddress(
                                    "",
                                    stateName,
                                    countryName
                                );

                            });

                        })


                        .catch(function () {

                            renderAddress(
                                "",
                                "",
                                countryName
                            );

                        });

                    })


                    .catch(function (err) {

                        console.log(
                            "Address resolution error:",
                            err
                        );

                    });

            }

        );

    </script>


    <!-- =========================================================
         MOBILE A4 FIT
         ========================================================= -->

    <script>

        (function () {

            var sheet =
                document.getElementById(
                    "resumeSheet"
                );


            var wrapper =
                document.getElementById(
                    "resumeWrapper"
                );


            if (!sheet || !wrapper)
                return;


            function fitSheet() {

                if (
                    window.matchMedia(
                        "print"
                    ).matches
                ) {

                    return;

                }


                sheet.style.transform = "none";

                wrapper.style.height = "";


                if (window.innerWidth > 1150) {

                    return;

                }


                var sheetW =
                    sheet.offsetWidth;


                var sheetH =
                    sheet.offsetHeight;


                var scale =
                    Math.min(
                        1,
                        window.innerWidth /
                        sheetW
                    );


                sheet.style.transform =
                    "scale(" +
                    scale +
                    ")";


                wrapper.style.height =
                    (
                        sheetH * scale +
                        40
                    ) +
                    "px";

            }


            window.addEventListener(
                "resize",
                fitSheet
            );


            window.addEventListener(
                "load",
                fitSheet
            );


            fitSheet();

        })();

    </script>


    <!-- =========================================================
         THEME SWITCHER SCRIPT
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const resumeSheet =
                    document.getElementById(
                        "resumeSheet"
                    );


                const swatches =
                    document.querySelectorAll(
                        ".theme-swatch"
                    );


                if (!resumeSheet ||
                    !swatches.length) {

                    return;

                }


                /* ================================================
                   LOAD SAVED THEME
                   ================================================ */

                const savedTheme =
                    localStorage.getItem(
                        "resumeTheme"
                    );


                if (savedTheme) {

                    resumeSheet.setAttribute(
                        "data-theme",
                        savedTheme
                    );


                    swatches.forEach(
                        function (swatch) {

                            swatch.classList.remove(
                                "active"
                            );


                            if (
                                swatch.dataset.theme ===
                                savedTheme
                            ) {

                                swatch.classList.add(
                                    "active"
                                );

                            }

                        }
                    );

                }


                /* ================================================
                   THEME CLICK
                   ================================================ */

                swatches.forEach(
                    function (swatch) {

                        swatch.addEventListener(
                            "click",
                            function () {

                                const theme =
                                    this.dataset.theme;


                                if (!theme)
                                    return;


                                /* Change resume */

                                resumeSheet.setAttribute(
                                    "data-theme",
                                    theme
                                );


                                /* Active swatch */

                                swatches.forEach(
                                    function (item) {

                                        item.classList.remove(
                                            "active"
                                        );

                                    }
                                );


                                this.classList.add(
                                    "active"
                                );


                                /* Save theme */

                                localStorage.setItem(
                                    "resumeTheme",
                                    theme
                                );

                            }
                        );

                    }
                );

            }
        );

    </script>


