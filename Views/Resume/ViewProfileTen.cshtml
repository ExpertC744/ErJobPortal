@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Edge-to-Edge Landscape (Template 11)";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {
    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();
                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }
        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);
    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(Has(candidateName) ? candidateName + " - Resume" : "Resume")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --primary: #263b47;
            --accent: #b4773c;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body { width: 100%; min-height: 100%; }

        body {
            background: #e9edef;
            font-family: "DM Sans", Arial, sans-serif;
            color: var(--text);
        }
.btn-edit { background: #ffffff; color: var(--primary); border: 1px solid var(--border) !important; }
        .btn-print { background: var(--primary); color: white; }
        .btn-download { background: var(--accent); color: white; }

        /* THEME SWITCHER */
        .theme-switcher {
            width: 297mm; max-width: calc(100% - 30px); margin: 0 auto 10px;
            display: flex; justify-content: flex-end; align-items: center; gap: 8px;
        }

        .theme-switcher span {
            font-size: 9px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .6px;
        }

        .theme-swatch {
            width: 18px; height: 18px; border-radius: 50%; border: 2px solid white; cursor: pointer; box-shadow: 0 1px 5px rgba(0,0,0,.15);
        }
        .theme-swatch.active { box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch); }

        /* RESUME SHEET: HORIZONTAL A4 */
        .resume-page-wrapper {
            display: flex; justify-content: center; padding: 5px 0 25px;
        }

        .resume-sheet {
            width: 297mm; height: 210mm; background: #ffffff;
            box-shadow: 0 15px 35px rgba(0,0,0,.1); overflow: hidden;
            display: flex;
            
            /* Theme Variables matching the unique Canva style */
            --theme-left-bg: #8c7365; /* Default warm brown */
            --theme-left-text: #ffffff;
            --theme-heading: #8c7365;
            --theme-right-bg: #fdfdfc; /* Very subtle off-white/cream */
            --theme-right-text: #4a4a4a;
        }

        .resume-sheet[data-theme="navy"] { --theme-left-bg: #2a3b4c; --theme-heading: #2a3b4c; }
        .resume-sheet[data-theme="teal"] { --theme-left-bg: #2b6766; --theme-heading: #2b6766; }
        .resume-sheet[data-theme="olive"] { --theme-left-bg: #5f6b55; --theme-heading: #5f6b55; }
        .resume-sheet[data-theme="blue"] { --theme-left-bg: #355e7e; --theme-heading: #355e7e; }
        .resume-sheet[data-theme="brown"] { --theme-left-bg: #8c7365; --theme-heading: #8c7365; } /* Reference Image Color */

        /* LAYOUT COLUMNS */
        .col-left {
            width: 33%;
            display: flex;
            flex-direction: column;
            background: var(--theme-left-bg);
            color: var(--theme-left-text);
        }

        .col-right {
            width: 67%;
            background: var(--theme-right-bg);
            color: var(--theme-right-text);
            padding: 16mm 18mm;
            display: flex;
            flex-direction: column;
            gap: 16px;
            font-family: "Inter", sans-serif;
        }

        /* LEFT COLUMN DETAILS */
        .edge-photo-container {
            width: 100%;
            height: 90mm; /* Fixed height for top block */
            background: rgba(255,255,255,0.1);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .edge-photo { width: 100%; height: 100%; object-fit: cover; }
        .edge-placeholder { font-size: 50px; color: rgba(255,255,255,0.5); }

        .left-content {
            padding: 12mm 12mm;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .left-name {
            font-family: "Montserrat", sans-serif; font-size: 32px; font-weight: 800;
            line-height: 1.1; margin-bottom: 4px;
        }
        .left-role {
            font-family: "Inter", sans-serif; font-size: 11px; font-weight: 400;
            text-transform: uppercase; letter-spacing: 2px; color: rgba(255,255,255,0.85);
        }

        .left-section-title {
            font-family: "Montserrat", sans-serif; font-size: 12px; font-weight: 700;
            letter-spacing: 2px; text-transform: uppercase;
            border-bottom: 1px solid rgba(255,255,255,0.3);
            padding-bottom: 6px; margin-bottom: 10px;
        }

        .contact-list { display: flex; flex-direction: column; gap: 6px; }
        .contact-item { font-size: 10px; font-weight: 300; line-height: 1.4; color: rgba(255,255,255,0.9); word-break: break-word; }

        .lang-list { display: flex; flex-direction: column; gap: 4px; }
        .lang-item { font-size: 10px; font-weight: 300; color: rgba(255,255,255,0.9); }

        /* RIGHT COLUMN DETAILS */
        .right-section { margin-bottom: 2px; }

        .right-title {
            font-family: "Montserrat", sans-serif; font-size: 13.5px; font-weight: 800;
            color: var(--theme-heading); text-transform: uppercase; letter-spacing: 2.5px;
            margin-bottom: 8px;
        }

        .profile-text {
            font-size: 10px; font-weight: 300; line-height: 1.7; color: var(--theme-right-text); text-align: justify;
        }

        .edu-item { margin-bottom: 8px; }
        .edu-degree { font-size: 10.5px; font-weight: 600; color: var(--theme-heading); margin-bottom: 2px; }
        .edu-school { font-size: 10px; font-weight: 400; color: var(--theme-right-text); margin-bottom: 2px; }
        .edu-meta { font-size: 9px; color: #777; font-weight: 300; font-style: italic; }

        .exp-item { margin-bottom: 10px; }
        .exp-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
        .exp-role { font-size: 11px; font-weight: 600; color: var(--theme-heading); }
        .exp-company { font-size: 10px; font-weight: 400; color: var(--theme-right-text); }
        .exp-meta { font-size: 9px; color: #777; font-style: italic; font-weight: 300; }
        
        .exp-bullets { list-style-type: disc; padding-left: 14px; margin-top: 4px; }
        .exp-bullets li { font-size: 10px; font-weight: 300; line-height: 1.5; color: var(--theme-right-text); margin-bottom: 3px; }

        .skill-list { list-style-type: disc; padding-left: 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 15px; }
        .skill-list li { font-size: 10px; font-weight: 300; color: var(--theme-right-text); line-height: 1.4; }

        /* RESPONSIVE & PRINT */
        @@media (max-width: 1200px) {
            .theme-switcher { width: 100%; padding: 0 15px; }
            .resume-sheet { transform: scale(0.85); transform-origin: top center; margin-bottom: -30mm; }
        }

        @@media (max-width: 992px) {
            .resume-sheet { transform: scale(0.65); margin-bottom: -70mm; }
        }

        @@media print {
            html, body { width: 297mm; height: 210mm; background: white; }
            .theme-switcher { display: none !important; }
            .resume-page-wrapper { padding: 0; }
            .resume-sheet { width: 297mm; height: 210mm; margin: 0; box-shadow: none; transform: none; }
            @@page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>

<body>
<div class="theme-switcher">
        <span>Theme</span>
        <div class="theme-swatch active" data-theme="brown" style="background:#8c7365;--swatch:#8c7365" title="Brown"></div>
        <div class="theme-swatch" data-theme="navy" style="background:#2a3b4c;--swatch:#2a3b4c" title="Navy"></div>
        <div class="theme-swatch" data-theme="teal" style="background:#2b6766;--swatch:#2b6766" title="Teal"></div>
        <div class="theme-swatch" data-theme="olive" style="background:#5f6b55;--swatch:#5f6b55" title="Olive"></div>
        <div class="theme-swatch" data-theme="blue" style="background:#355e7e;--swatch:#355e7e" title="Blue"></div>
    </div>

    <div class="resume-page-wrapper">
        <div class="resume-sheet" id="resumeSheet" data-theme="brown">

            <!-- ================= LEFT COLUMN ================= -->
            <div class="col-left">
                
                <!-- Edge to Edge Photo -->
                <div class="edge-photo-container">
                    @if (Has(p.sPhoto))
                    {
<img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=600&q=80" class="edge-photo" alt="Demo Image" />
                        <div class="edge-placeholder" id="fallbackIcon" style="display:none;"><i class="fa fa-user"></i></div>
                    }
                    else
                    {
                        <div class="edge-placeholder"><i class="fa fa-image"></i></div>
                    }
                </div>

                <!-- Left Content Block -->
                <div class="left-content">
                    <div>
                        <div class="left-name">
                            @{
                                var nameParts = candidateName?.Split(' ') ?? new string[0];
                                if (nameParts.Length > 1) {
                                    @Html.Raw(nameParts[0] + "<br/>" + string.Join(" ", nameParts.Skip(1)))
                                } else {
                                    @candidateName
                                }
                            }
                        </div>
                        @if (Has(candidateRole)) { <div class="left-role">@candidateRole</div> }
                    </div>

                    <div style="margin-top: 10px;">
                        <div class="left-section-title">Contact</div>
                        <div class="contact-list">
                            @if (Has(Model.CandidatePhone)) { <div class="contact-item">@Model.CandidatePhone</div> }
                            @if (Has(Model.CandidateEmail)) { <div class="contact-item">@Model.CandidateEmail</div> }
                            @if (Has(p.Pincode)) { 
                                <div class="contact-item" id="rvAddressLeft" data-country-id="@p.CountryID" data-state-id="@p.StateID" data-city-id="@p.CityID" data-pincode="@p.Pincode">
                                    @p.Pincode
                                </div> 
                            }
                            @if (Has(p.Linkedin)) { <div class="contact-item">@p.Linkedin</div> }
                            @if (Has(p.GitHub)) { <div class="contact-item">@p.GitHub</div> }
                        </div>
                    </div>

                    @{
                        var langItems = new List<string>();
                        for (int i = 1; i <= 8; i++)
                        {
                            var lang = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                            if (Has(lang)) { langItems.Add(lang); }
                        }
                    }
                    @if (langItems.Any())
                    {
                        <div style="margin-top: 5px;">
                            <div class="left-section-title">Language</div>
                            <div class="lang-list">
                                @foreach (var l in langItems)
                                {
                                    <div class="lang-item">@l</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- ================= RIGHT COLUMN ================= -->
            <div class="col-right">
                
                <!-- PROFILE -->
                @if (Has(p.Objective))
                {
                    <div class="right-section">
                        <div class="right-title">Profile</div>
                        <div class="profile-text">@p.Objective</div>
                    </div>
                }

                <!-- EDUCATION -->
                @if (HasNum(p.PG_Year) || HasNum(p.Graduation_Year) || HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR))
                {
                    <div class="right-section">
                        <div class="right-title">Education</div>
                        
                        @if (HasNum(p.PG_Year)) {
                            <div class="edu-item">
                                <div class="edu-degree">@GetLookupName(Model.Streams, p.PG_Stream)</div>
                                <div class="edu-school">Post Graduation</div>
                                <div class="edu-meta">@p.PG_Year | Division: @GetLookupName(Model.Divisions, p.PG_Division)</div>
                            </div>
                        }
                        @if (HasNum(p.Graduation_Year)) {
                            <div class="edu-item">
                                <div class="edu-degree">@GetLookupName(Model.Streams, p.Graduation_Stream)</div>
                                <div class="edu-school">Graduation</div>
                                <div class="edu-meta">@p.Graduation_Year | Division: @GetLookupName(Model.Divisions, p.Graduation_Division)</div>
                            </div>
                        }
                        @if (HasNum(p.HSC_DIPLOMA_YEAR)) {
                            <div class="edu-item">
                                <div class="edu-degree">HSC / Diploma</div>
                                <div class="edu-meta">@p.HSC_DIPLOMA_YEAR | Division: @GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION)</div>
                            </div>
                        }
                        @if (HasNum(p.SSC_YEAR)) {
                            <div class="edu-item">
                                <div class="edu-degree">SSC / 10th</div>
                                <div class="edu-meta">@p.SSC_YEAR | Division: @GetLookupName(Model.Divisions, p.SSC_DIVISION)</div>
                            </div>
                        }
                    </div>
                }

                <!-- EXPERIENCE -->
                @{
                    var internships = new[]
                    {
                        new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                        new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                        new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                        new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
                    }.Where(x => Has(x.Name)).ToList();
                }

                @if (internships.Any())
                {
                    <div class="right-section">
                        <div class="right-title">Work Experience</div>
                        @foreach (var exp in internships)
                        {
                            <div class="exp-item">
                                <div class="exp-role">@(Has(GetLookupName(Model.InternshipTitles, exp.Title)) ? GetLookupName(Model.InternshipTitles, exp.Title) : "Role") - @exp.Name</div>
                                <div class="exp-meta">
                                    @if(Has(GetLookupName(Model.InternshipDurations, exp.Duration))) { <span>Duration: @GetLookupName(Model.InternshipDurations, exp.Duration)</span> }
                                    @if (Has(GetLookupName(Model.InternshipStatuses, exp.Status))) { <span> | Status: @GetLookupName(Model.InternshipStatuses, exp.Status)</span> }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SKILLS -->
                @{
                    var techSkillsStr = p.sTechnicalSkillIDs;
                    var nonTechSkillsStr = p.sNonTechnicalSkillIDs;
                    var techSkills = Has(techSkillsStr) ? techSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s=>s.Trim()).ToList() : new List<string>();
                    var nonTechSkills = Has(nonTechSkillsStr) ? nonTechSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).Select(s=>s.Trim()).ToList() : new List<string>();
                    
                    var allSkills = techSkills.Concat(nonTechSkills).Take(8).ToList();
                }

                @if (allSkills.Any())
                {
                    <div class="right-section">
                        <div class="right-title">Skill</div>
                        <ul class="skill-list">
                            @foreach (var skill in allSkills)
                            {
                                <li>@skill</li>
                            }
                        </ul>
                    </div>
                }

                <!-- ACHIEVEMENTS -->
                @{
                    var achievements = new[] { p.Achievements_Certification1, p.Achievements_Certification2, p.Achievements_Certification3 }.Where(Has).ToList();
                }

                @if (achievements.Any())
                {
                    <div class="right-section">
                        <div class="right-title">Achievements</div>
                        <ul class="skill-list" style="display: flex; flex-direction: column;">
                            @foreach (var a in achievements)
                            {
                                <li>@a</li>
                            }
                        </ul>
                    </div>
                }
                
                @if (Has(p.sHobbies))
                {
                    <div class="right-section" style="margin-top: auto;">
                        <div class="right-title">Interests</div>
                        <div class="profile-text">@p.sHobbies</div>
                    </div>
                }

            </div>
        </div>
    </div>


    <!-- SCRIPTS -->
<script>
        document.addEventListener("DOMContentLoaded", function () {
            const sheet = document.getElementById("resumeSheet");
            const swatches = document.querySelectorAll(".theme-swatch");
            const savedTheme = localStorage.getItem("resumeThemeV11") || "brown";

            sheet.setAttribute("data-theme", savedTheme);

            swatches.forEach(function (swatch) {
                swatch.classList.toggle("active", swatch.dataset.theme === savedTheme);

                swatch.addEventListener("click", function () {
                    const theme = this.dataset.theme;
                    sheet.setAttribute("data-theme", theme);
                    
                    swatches.forEach(function (item) { item.classList.remove("active"); });
                    this.classList.add("active");
                    
                    localStorage.setItem("resumeThemeV11", theme);
                });
            });

            /* ADDRESS LOGIC */
            const addressElements = document.querySelectorAll("[data-country-id]");
            if (!addressElements.length) return;

            const firstAddress = addressElements[0];
            const countryID = firstAddress.getAttribute("data-country-id") || "";
            const stateID = firstAddress.getAttribute("data-state-id") || "";
            const cityID = firstAddress.getAttribute("data-city-id") || "";
            const pincode = firstAddress.getAttribute("data-pincode") || "";

            function renderAddress(cityName, stateName, countryName) {
                const parts = [cityName, stateName, countryName, pincode].filter(value => value && value.trim());
                const address = parts.join(", ");
                addressElements.forEach(function (element) { element.textContent = address; });
            }

            if (!countryID) { renderAddress("", "", ""); return; }

            fetch("/Location/GetCountries")
                .then(response => response.json())
                .then(countries => {
                    const country = countries.find(c => String(c.id) === String(countryID));
                    const countryName = country ? country.name : "";
                    const countryCode = country ? country.iso2 : countryID;

                    if (!stateID) { renderAddress("", "", countryName); return; }

                    return fetch("/Location/GetStates?countryCode=" + encodeURIComponent(countryCode))
                        .then(response => response.json())
                        .then(states => {
                            const state = states.find(s => String(s.id) === String(stateID));
                            const stateName = state ? state.name : "";
                            const stateCode = state ? (state.stateCode || String(state.id).split(":")[1]) : "";

                            if (!cityID) { renderAddress("", stateName, countryName); return; }

                            return fetch("/Location/GetCities?countryCode=" + encodeURIComponent(countryCode) + "&stateCode=" + encodeURIComponent(stateCode))
                                .then(response => response.json())
                                .then(cities => {
                                    const city = cities.find(c => String(c.id) === String(cityID));
                                    const cityName = city ? city.name : "";
                                    renderAddress(cityName, stateName, countryName);
                                });
                        });
                })
                .catch(error => console.log("Address resolution error:", error));
        });


        window.candidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? "Resume"));
    </script>
    <script>
        window.resumeFileName =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    candidateName ?? "Resume"
                )
            );
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="~/js/resume-download.js"></script>
</body>
</html>