@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Modern Horizontal (Template 10)";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {
    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();
                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }
        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);
    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(Has(candidateName) ? candidateName + " - Resume" : "Resume")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --primary: #263b47;
            --primary-light: #edf2f3;
            --accent: #b4773c;
            --accent-light: #f5ece3;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
            --soft: #f6f7f7;
            --white: #ffffff;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; min-height: 100%; }

        body {
            background: #e9edef;
            font-family: "DM Sans", Arial, sans-serif;
            color: var(--text);
        }

        /* TOOLBAR - Adjusted for Landscape Width */
        .resume-toolbar {
            width: 297mm; max-width: calc(100% - 30px); margin: 14px auto 8px;
            display: flex; justify-content: flex-end; gap: 8px;
        }

        .resume-toolbar button, .resume-toolbar a {
            border: 0; min-height: 32px; padding: 8px 14px; border-radius: 5px;
            font-family: "DM Sans", sans-serif; font-size: 10px; font-weight: 700;
            text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
        }

        .btn-edit { background: #ffffff; color: var(--primary); border: 1px solid var(--border) !important; }
        .btn-print { background: var(--primary); color: white; }
        .btn-download { background: var(--accent); color: white; }

        .theme-switcher {
            width: 297mm; max-width: calc(100% - 30px); margin: 0 auto 10px;
            display: flex; justify-content: flex-end; align-items: center; gap: 8px;
        }

        .theme-switcher span {
            font-size: 9px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .6px;
        }

        .theme-swatch {
            width: 18px; height: 18px; border-radius: 50%; border: 2px solid white; cursor: pointer; box-shadow: 0 1px 5px rgba(0,0,0,.15);
        }
        .theme-swatch.active { box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch); }

        .resume-page-wrapper {
            display: flex; justify-content: center; padding: 5px 0 25px;
        }

        /* RESUME SHEET - Horizontal (Landscape) */
        .resume-sheet {
            width: 297mm; height: 210mm; /* A4 Landscape */
            background: #ffffff;
            box-shadow: 0 15px 35px rgba(0,0,0,.1); 
            display: flex;
            
            --bg-side: #d9e2e8; 
            --head-main: #263b47; 
            --text-side: #3a4a5a;
            --text-main: #475569;
            --dot-active: #263b47;
            --dot-inactive: #ffffff;
        }

        .resume-sheet[data-theme="navy"] { --head-main: #263b47; --bg-side: #e2e8f0; --dot-active: #263b47; }
        .resume-sheet[data-theme="teal"] { --head-main: #245f61; --bg-side: #e0ecec; --dot-active: #245f61; }
        .resume-sheet[data-theme="olive"] { --head-main: #4f5d45; --bg-side: #e8ede3; --dot-active: #4f5d45; }
        .resume-sheet[data-theme="blue"] { --head-main: #315875; --bg-side: #e3ebf0; --dot-active: #315875; }
        .resume-sheet[data-theme="brown"] { --head-main: #654d3b; --bg-side: #ede7e2; --dot-active: #654d3b; }

        /* Adjusted Column Widths and reduced vertical paddings/gaps for shorter height */
        .col-left {
            width: 32%;
            background: var(--bg-side);
            color: var(--text-side);
            padding: 12mm 10mm;
            display: flex;
            flex-direction: column;
            gap: 15px; /* Reduced gap */
            font-family: "Inter", sans-serif;
        }

        .col-right {
            width: 68%;
            background: #ffffff;
            color: var(--text-main);
            padding: 12mm 15mm;
            display: flex;
            flex-direction: column;
            gap: 15px; /* Reduced gap */
            font-family: "Inter", sans-serif;
        }

        .photo-container {
            width: 45mm; height: 45mm; margin: 0 auto 5px auto;
            border-radius: 50%; overflow: hidden;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            background: #e2e8f0;
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0;
        }
        .photo { width: 100%; height: 100%; object-fit: cover; }
        .photo-placeholder { 
            width: 100%; height: 100%; display: flex; align-items: center; 
            justify-content: center; font-size: 45px; color: var(--head-main); background: rgba(0,0,0,0.05);
        }

        .side-section { margin-bottom: 2px; }
        .side-section.push-bottom { margin-top: auto; }
        
        .side-title {
            font-family: "Montserrat", sans-serif; font-size: 12px; font-weight: 700;
            text-transform: uppercase; letter-spacing: 2px; color: var(--head-main);
            margin-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.1); padding-bottom: 4px;
        }

        .contact-list { display: flex; flex-direction: column; gap: 10px; }
        .contact-item { display: flex; align-items: flex-start; gap: 10px; font-size: 10px; font-weight: 500; line-height: 1.3; word-break: break-word; color: var(--text-side); }
        .contact-item i { font-size: 11px; margin-top: 1px; color: var(--head-main); width: 12px; text-align: center; }

        .skill-list { display: flex; flex-direction: column; gap: 8px; }
        .skill-item { font-size: 10px; font-weight: 500; display: flex; align-items: center; justify-content: space-between; }
        .dots-container { display: flex; gap: 4px; }
        .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--dot-inactive); }
        .dot.filled { background: var(--dot-active); }

        .hobbies-text { font-size: 10px; line-height: 1.5; color: var(--text-side); }

        .header-block { margin-bottom: 2px; }
        .name {
            font-family: "Montserrat", sans-serif; font-size: 34px; font-weight: 800;
            color: var(--head-main); line-height: 1.1; letter-spacing: 2px; text-transform: uppercase;
        }
        .role {
            font-family: "Montserrat", sans-serif; font-size: 11px; font-weight: 600;
            color: var(--head-main); text-transform: uppercase; letter-spacing: 3px; margin-top: 6px;
            line-height: 1.4; word-wrap: break-word;
        }
        .header-divider { width: 100%; height: 2px; background: #e2e8f0; margin-top: 15px; }

        .main-section { margin-top: 2px; }
        .main-section.push-bottom { margin-top: auto; } 

        .main-title {
            font-family: "Montserrat", sans-serif; font-size: 14px; font-weight: 700;
            color: var(--head-main); text-transform: uppercase; letter-spacing: 2px;
            margin-bottom: 10px;
        }

        .summary-text { font-size: 10.5px; line-height: 1.6; color: var(--text-main); text-align: justify; }

        /* Modified for landscape to allow grids if needed, but keeping timeline vertical */
        .timeline-container { display: flex; flex-direction: column; gap: 12px; }
        
        .timeline-item { display: flex; flex-direction: column; gap: 3px; }
        .tl-header { font-size: 11.5px; color: var(--head-main); line-height: 1.4; }
        .tl-title { font-weight: 700; }
        .tl-company { font-weight: 500; color: var(--text-main); border-left: 1px solid #cbd5e1; margin-left: 6px; padding-left: 6px; }
        
        .tl-date { font-size: 9.5px; color: #64748b; font-weight: 500; margin-bottom: 2px; text-transform: uppercase; letter-spacing: 0.5px; }
        
        .tl-desc { font-size: 10.5px; line-height: 1.5; padding-left: 14px; margin: 0; color: var(--text-main); }
        .tl-desc li { margin-bottom: 2px; }

        /* Media Queries for Print and Screen */
        @@media (max-width: 1200px) {
            .resume-toolbar, .theme-switcher { width: 100%; padding: 0 15px; }
            .resume-sheet { transform: scale(0.85); transform-origin: top center; margin-bottom: -30mm; }
        }

        @@media (max-width: 992px) {
            .resume-sheet { transform: scale(0.65); margin-bottom: -70mm; }
        }

        @@media print {
            html, body { width: 297mm; height: 210mm; background: white; }
            .resume-toolbar, .theme-switcher { display: none !important; }
            .resume-page-wrapper { padding: 0; }
            .resume-sheet { width: 297mm; height: 210mm; margin: 0; box-shadow: none; transform: none; }
            @@page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>

<body>
    <!-- TOOLBAR -->
    <div class="resume-toolbar">
        <a asp-controller="Candidate" asp-action="Profile" class="btn-edit">
            <i class="fa fa-pen"></i> Edit
        </a>
        <button type="button" class="btn-print" onclick="window.print()">
            <i class="fa fa-print"></i> Print / PDF
        </button>
        <button type="button" class="btn-download" onclick="downloadResumePDF()">
            <i class="fa fa-download"></i> Download
        </button>
    </div>

    <!-- THEME SWITCHER -->
    <div class="theme-switcher">
        <span>Theme</span>
        <div class="theme-swatch active" data-theme="navy" style="background:#263b47;--swatch:#263b47" title="Navy"></div>
        <div class="theme-swatch" data-theme="teal" style="background:#245f61;--swatch:#245f61" title="Teal"></div>
        <div class="theme-swatch" data-theme="olive" style="background:#4f5d45;--swatch:#4f5d45" title="Olive"></div>
        <div class="theme-swatch" data-theme="blue" style="background:#315875;--swatch:#315875" title="Blue"></div>
        <div class="theme-swatch" data-theme="brown" style="background:#654d3b;--swatch:#654d3b" title="Brown"></div>
    </div>

    <!-- RESUME SHEET -->
    <div class="resume-page-wrapper">
        <div class="resume-sheet" id="resumeSheet" data-theme="navy">

            <!-- 1. LEFT COLUMN -->
            <div class="col-left">
                
                <div class="photo-container">
                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto" class="photo" alt="" onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='flex';" />
                        <div class="photo-placeholder" id="fallbackIcon" style="display:none;"><i class="fa fa-user"></i></div>
                    }
                    else
                    {
                        <div class="photo-placeholder"><i class="fa fa-user"></i></div>
                    }
                </div>

                <div class="side-section">
                    <div class="contact-list">
                        @if (Has(p.Pincode)) { 
                            <div class="contact-item">
                                <i class="fa fa-map-marker-alt"></i> 
                                <span id="rvAddressLeft" data-country-id="@p.CountryID" data-state-id="@p.StateID" data-city-id="@p.CityID" data-pincode="@p.Pincode">@p.Pincode</span>
                            </div> 
                        }
                        @if (Has(Model.CandidatePhone)) { 
                            <div class="contact-item"><i class="fa fa-phone"></i> @Model.CandidatePhone</div> 
                        }
                        @if (Has(Model.CandidateEmail)) { 
                            <div class="contact-item"><i class="fa fa-envelope"></i> @Model.CandidateEmail</div> 
                        }
                        @if (Has(p.Linkedin)) { 
                            <div class="contact-item"><i class="fa-brands fa-linkedin"></i> @p.Linkedin</div> 
                        }
                        @if (Has(p.GitHub)) { 
                            <div class="contact-item"><i class="fa-brands fa-github"></i> @p.GitHub</div> 
                        }
                    </div>
                </div>

                @{
                    var langItems = new List<(string Lang, int Rating)>();
                    for (int i = 1; i <= 8; i++)
                    {
                        var lang = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                        var starVal = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguageStar{i}")?.GetValue(p);
                        
                        if (Has(lang)) { 
                            int rating = 3; 
                            if (starVal != null && int.TryParse(starVal.ToString(), out int parsed)) rating = parsed;
                            langItems.Add((lang, rating)); 
                        }
                    }

                    var techSkillsStr = p.sTechnicalSkillIDs;
                    var techSkills = Has(techSkillsStr) ? techSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).ToList() : new List<string>();
                }

                @if (langItems.Any() || techSkills.Any())
                {
                    <div class="side-section">
                        <div class="side-title">Skills</div>
                        <div class="skill-list">
                            @foreach (var ts in techSkills.Take(5))
                            {
                                <div class="skill-item">
                                    <span>@ts.Trim()</span>
                                    <div class="dots-container">
                                        <span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span><span class="dot filled"></span><span class="dot"></span>
                                    </div>
                                </div>
                            }
                            @foreach (var l in langItems.Take(3))
                            {
                                <div class="skill-item">
                                    <span>@l.Lang</span>
                                    <div class="dots-container">
                                        @for(int d=1; d<=5; d++)
                                        {
                                            <span class="dot @(d <= l.Rating ? "filled" : "")"></span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (Has(p.sHobbies))
                {
                    <div class="side-section push-bottom">
                        <div class="side-title">Hobbies & Interests</div>
                        <div class="hobbies-text">@p.sHobbies</div>
                    </div>
                }
            </div>

            <!-- 2. RIGHT COLUMN -->
            <div class="col-right">
                
                <div class="header-block">
                    <h1 class="name">@(Has(candidateName) ? candidateName : "")</h1>
                    @if (Has(candidateRole)) { <div class="role">@candidateRole</div> }
                    <div class="header-divider"></div>
                </div>

                @if (Has(p.Objective))
                {
                    <div class="main-section">
                        <div class="main-title">Profile</div>
                        <div class="summary-text">@p.Objective</div>
                    </div>
                }

                <!-- EDUCATION -->
                @if (HasNum(p.PG_Year) || HasNum(p.Graduation_Year) || HasNum(p.HSC_DIPLOMA_YEAR))
                {
                    <div class="main-section">
                        <div class="main-title">Education</div>
                        <div class="timeline-container">
                            @if (HasNum(p.PG_Year)) {
                                <div class="timeline-item">
                                    <div class="tl-header">
                                        <span class="tl-title">@GetLookupName(Model.Streams, p.PG_Stream)</span>
                                        <span class="tl-company">Post Graduation</span>
                                    </div>
                                    <div class="tl-date">Graduated @p.PG_Year</div>
                                    <ul class="tl-desc">
                                        @if(Has(GetLookupName(Model.Divisions, p.PG_Division))) { <li>Division: @GetLookupName(Model.Divisions, p.PG_Division)</li> }
                                        @if(Has(p.Other_Specialization)) { <li>Specialization: @p.Other_Specialization</li> }
                                    </ul>
                                </div>
                            }
                            @if (HasNum(p.Graduation_Year)) {
                                <div class="timeline-item">
                                    <div class="tl-header">
                                        <span class="tl-title">@GetLookupName(Model.Streams, p.Graduation_Stream)</span>
                                        <span class="tl-company">Graduation</span>
                                    </div>
                                    <div class="tl-date">Graduated @p.Graduation_Year</div>
                                    <ul class="tl-desc">
                                        @if(Has(GetLookupName(Model.Divisions, p.Graduation_Division))) { <li>Division: @GetLookupName(Model.Divisions, p.Graduation_Division)</li> }
                                    </ul>
                                </div>
                            }
                            @if (HasNum(p.HSC_DIPLOMA_YEAR)) {
                                <div class="timeline-item">
                                    <div class="tl-header">
                                        <span class="tl-title">HSC / Diploma</span>
                                    </div>
                                    <div class="tl-date">Graduated @p.HSC_DIPLOMA_YEAR</div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- EXPERIENCE -->
                @{
                    var internships = new[]
                    {
                        new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                        new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                        new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                        new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
                    }.Where(x => Has(x.Name)).ToList();
                }

                @if (internships.Any())
                {
                    <div class="main-section">
                        <div class="main-title">Experience</div>
                        <div class="timeline-container">
                            @foreach (var exp in internships)
                            {
                                <div class="timeline-item">
                                    <div class="tl-header">
                                        @if(Has(GetLookupName(Model.InternshipTitles, exp.Title))) {
                                            <span class="tl-title">@GetLookupName(Model.InternshipTitles, exp.Title)</span>
                                            <span class="tl-company">@exp.Name</span>
                                        } else {
                                            <span class="tl-title">@exp.Name</span>
                                        }
                                    </div>
                                    
                                    @if(Has(GetLookupName(Model.InternshipDurations, exp.Duration))) {
                                        <div class="tl-date">Duration: @GetLookupName(Model.InternshipDurations, exp.Duration)</div>
                                    }
                                    
                                    @if (Has(GetLookupName(Model.InternshipStatuses, exp.Status))) {
                                        <ul class="tl-desc">
                                            <li>Current Status: @GetLookupName(Model.InternshipStatuses, exp.Status)</li>
                                        </ul>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- ACHIEVEMENTS -->
                @{
                    var achievements = new[] { p.Achievements_Certification1, p.Achievements_Certification2, p.Achievements_Certification3 }.Where(Has).ToList();
                }

                @if (achievements.Any())
                {
                    <div class="main-section push-bottom">
                        <div class="main-title">Achievements</div>
                        <ul class="tl-desc" style="list-style-type: square;">
                            @foreach (var a in achievements)
                            {
                                <li>@a</li>
                            }
                        </ul>
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sheet = document.getElementById("resumeSheet");
            const swatches = document.querySelectorAll(".theme-swatch");
            const savedTheme = localStorage.getItem("resumeThemeV10_Landscape") || "navy";

            sheet.setAttribute("data-theme", savedTheme);

            swatches.forEach(function (swatch) {
                swatch.classList.toggle("active", swatch.dataset.theme === savedTheme);

                swatch.addEventListener("click", function () {
                    const theme = this.dataset.theme;
                    sheet.setAttribute("data-theme", theme);
                    
                    swatches.forEach(function (item) { item.classList.remove("active"); });
                    this.classList.add("active");
                    
                    localStorage.setItem("resumeThemeV10_Landscape", theme);
                });
            });

            /* ADDRESS LOGIC */
            const addressElements = document.querySelectorAll("[data-country-id]");
            if (!addressElements.length) return;

            const firstAddress = addressElements[0];
            const countryID = firstAddress.getAttribute("data-country-id") || "";
            const stateID = firstAddress.getAttribute("data-state-id") || "";
            const cityID = firstAddress.getAttribute("data-city-id") || "";
            const pincode = firstAddress.getAttribute("data-pincode") || "";

            function renderAddress(cityName, stateName, countryName) {
                const parts = [cityName, stateName, countryName, pincode].filter(value => value && value.trim());
                const address = parts.join(", ");
                addressElements.forEach(function (element) { element.textContent = address; });
            }

            if (!countryID) { renderAddress("", "", ""); return; }

            fetch("/Location/GetCountries")
                .then(response => response.json())
                .then(countries => {
                    const country = countries.find(c => String(c.id) === String(countryID));
                    const countryName = country ? country.name : "";
                    const countryCode = country ? country.iso2 : countryID;

                    if (!stateID) { renderAddress("", "", countryName); return; }

                    return fetch("/Location/GetStates?countryCode=" + encodeURIComponent(countryCode))
                        .then(response => response.json())
                        .then(states => {
                            const state = states.find(s => String(s.id) === String(stateID));
                            const stateName = state ? state.name : "";
                            const stateCode = state ? (state.stateCode || String(state.id).split(":")[1]) : "";

                            if (!cityID) { renderAddress("", stateName, countryName); return; }

                            return fetch("/Location/GetCities?countryCode=" + encodeURIComponent(countryCode) + "&stateCode=" + encodeURIComponent(stateCode))
                                .then(response => response.json())
                                .then(cities => {
                                    const city = cities.find(c => String(c.id) === String(cityID));
                                    const cityName = city ? city.name : "";
                                    renderAddress(cityName, stateName, countryName);
                                });
                        });
                })
                .catch(error => console.log("Address resolution error:", error));
        });

        async function downloadResumePDF() {
            const sheet = document.getElementById("resumeSheet");
            const button = document.querySelector(".btn-download");
            const original = button.innerHTML;

            try {
                button.disabled = true;
                button.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

                const images = sheet.querySelectorAll("img");
                await Promise.all(
                    Array.from(images).map(image =>
                        image.complete ? Promise.resolve() : new Promise(resolve => {
                            image.onload = resolve;
                            image.onerror = resolve;
                        })
                    )
                );

                const rect = sheet.getBoundingClientRect();
                const canvas = await html2canvas(sheet, {
                    scale: 2, useCORS: true, allowTaint: false, backgroundColor: "#ffffff",
                    logging: false, width: Math.round(rect.width), height: Math.round(rect.height)
                });

                const { jsPDF } = window.jspdf;
                // CHANGED: PDF formatting uses landscape and 297x210 dimensions
                const pdf = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4", compress: true });
                const imgData = canvas.toDataURL("image/jpeg", .95);
                pdf.addImage(imgData, "JPEG", 0, 0, 297, 210);
                pdf.save((window.candidateName || "Resume") + ".pdf");
            }
            catch (error) {
                console.error("PDF error:", error);
                alert("Error generating PDF");
            }
            finally {
                button.disabled = false;
                button.innerHTML = original;
            }
        }

        window.candidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? "Resume"));
    </script>
</body>
</html>