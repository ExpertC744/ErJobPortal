@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;

    ViewData["Title"] = "Header Cards Resume";

    var p = Model.Profile;

    var candidateName = Model.CandidateName?.Trim();

    var displayName = Has(candidateName) ? candidateName : "Professional Candidate";

    var nameParts = displayName.Split(new[] { ' ' }, 2, StringSplitOptions.RemoveEmptyEntries);
    var firstName = nameParts.Length > 0 ? nameParts[0] : "";
    var lastName = nameParts.Length > 1 ? nameParts[1] : "";

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(
        candidateRole,
        "Paid by Trainee",
        StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }

    var typeName = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    var preferredLocation = string.Join(
        ", ",
        new[]
        {
            p.Preferred_City,
            p.Preferred_State,
            p.Preferred_Country
        }.Where(Has)
    );

    var internships =
        new[]
        {
            new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
            new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
            new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
            new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
        }
        .Where(x => Has(x.Name))
        .ToList();

    var achievements =
        new[]
        {
            p.Achievements_Certification1,
            p.Achievements_Certification2,
            p.Achievements_Certification3
        }
        .Where(Has)
        .ToList();

    var skillGroups =
        new[]
        {
            ("Technical", p.sTechnicalSkillIDs),
            ("Medical", p.sMedicalSkillIDs),
            ("Non-Technical", p.sNonTechnicalSkillIDs)
        }
        .Where(x => Has(x.Item2))
        .ToList();

    var languages = new List<(string Name, string Rating)>();

    for (int i = 1; i <= 8; i++)
    {
        var language =
            typeof(ErJobPortal.Models.CandidateProfileModel)
            .GetProperty($"sLanguage{i}")
            ?.GetValue(p)
            ?.ToString();

        var rating =
            typeof(ErJobPortal.Models.CandidateProfileModel)
            .GetProperty($"sLanguageStar{i}")
            ?.GetValue(p)
            ?.ToString();

        if (Has(language))
        {
            languages.Add((language, rating));
        }
    }

    // section visibility flags (empty sections collapse)
    var hasAbout = Has(p.Objective);
    var hasExp = internships.Any();
    var hasAch = achievements.Any();
    var hasMission = Has(typeName) || Has(preferredLocation);
    var hasLang = languages.Any();
    var hasHobby = Has(p.sHobbies);
    var hasRef = Has(p.sRefName1) || Has(p.sRefName2);
    var hasSkills = skillGroups.Any();
    var hasContact = Has(Model.CandidatePhone) || Has(Model.CandidateEmail) ||
                     Has(p.Linkedin) || Has(p.GitHub) ||
                     Has(p.CountryID) || Has(p.StateID) || Has(p.CityID) || Has(p.Pincode);
    var hasEdu = HasNum(p.PG_Year) || HasNum(p.Graduation_Year) ||
                 HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR);
}

@functions {

    string GetLookupName(
        System.Collections.IEnumerable list,
        object id)
    {
        if (list == null ||
            id == null ||
            string.IsNullOrWhiteSpace(id.ToString()))
        {
            return "";
        }

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }

        return "";
    }

    bool Has(string value)
    {
        return !string.IsNullOrWhiteSpace(value);
    }

    bool HasNum(int? value)
    {
        return value.HasValue && value.Value != 0;
    }

    // 1-5 rating -> bar width percentage (defaults to 80%)
    int RatingPercent(string rating)
    {
        if (int.TryParse(rating?.Trim(), out var n))
        {
            if (n < 0) n = 0;
            if (n > 5) n = 5;
            return n * 20;
        }

        return 80;
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @(Has(candidateName)
            ? candidateName + " | Resume"
            : "Professional Resume")
    </title>

    <!-- apply saved theme before first paint (no flash) -->
    <script>
        (function () {
            try {
                var t = localStorage.getItem("resumeTheme36");
                if (t) {
                    document.documentElement.setAttribute("data-theme", t);
                }
            } catch (e) { }
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700;900&display=swap" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet" href="~/css/ViewProfileThirtySix.css" />

</head>

<body>

    <!-- TOOLBAR -->

    <div class="resume-toolbar">

        <a asp-controller="Candidate"
           asp-action="Profile"
           class="toolbar-btn toolbar-edit">
            <i class="fa-solid fa-pen-to-square"></i>
            Edit Profile
        </a>

        <button type="button"
                class="toolbar-btn toolbar-print"
                onclick="window.print()">
            <i class="fa-solid fa-print"></i>
            Print
        </button>

        <button type="button"
                class="toolbar-btn toolbar-download"
                onclick="downloadResumePDF()">
            <i class="fa-solid fa-file-pdf"></i>
            Download PDF
        </button>

    </div>


    <!-- THEME SWITCHER -->

    <div class="theme-switcher">

        <span>Theme</span>
        <button type="button" class="theme-swatch active" data-theme="navy"
                title="Navy" aria-label="Navy theme" style="background:linear-gradient(135deg,#1f2d45 50%,#f0b429 50%)"></button>

        <button type="button" class="theme-swatch" data-theme="teal"
                title="Teal" aria-label="Teal theme" style="background:linear-gradient(135deg,#12474d 50%,#f2c94c 50%)"></button>

        <button type="button" class="theme-swatch" data-theme="wine"
                title="Wine" aria-label="Wine theme" style="background:linear-gradient(135deg,#4a1d28 50%,#f5b7a5 50%)"></button>

        <button type="button" class="theme-swatch" data-theme="slate"
                title="Slate" aria-label="Slate theme" style="background:linear-gradient(135deg,#2d3036 50%,#5cc8c0 50%)"></button>

    </div>


    <!-- RESUME -->

    <div class="resume-container">

        <div class="resume-sheet" id="resumeSheet">
            <header class="head">
            <div class="photo-frame">
                @if (Has(p.sPhoto))
                {
                    <img src="@p.sPhoto" alt="Profile Photo" class="profile-photo" />
                }
                else
                {
                    <div class="profile-placeholder">
                        <i class="fa-solid fa-user"></i>
                    </div>
                }
            </div>
            <div class="head-name"><div class="name-block">
                <h1 class="profile-name">
                    <span class="name-first">@firstName</span>
                    @if (Has(lastName))
                    {
                        <span class="name-last">@lastName</span>
                    }
                </h1>
                @if (Has(candidateRole))
                {
                    <div class="profile-role">@candidateRole</div>
                }
            </div></div>
            <div class="head-contact">@if (hasContact)
            {
                <section class="block sec-contact">
                    <h2 class="heading">Contact</h2>
                    <div class="contact-list">

                        @if (Has(Model.CandidatePhone))
                        {
                            <div class="contact-row">
                                <i class="fa-solid fa-phone"></i>
                                <span>@Model.CandidatePhone</span>
                            </div>
                        }

                        @if (Has(Model.CandidateEmail))
                        {
                            <div class="contact-row">
                                <i class="fa-solid fa-envelope"></i>
                                <span>@Model.CandidateEmail</span>
                            </div>
                        }

                        @if (Has(p.Linkedin))
                        {
                            <div class="contact-row">
                                <i class="fa-brands fa-linkedin-in"></i>
                                <span>@p.Linkedin</span>
                            </div>
                        }

                        @if (Has(p.GitHub))
                        {
                            <div class="contact-row">
                                <i class="fa-brands fa-github"></i>
                                <span>@p.GitHub</span>
                            </div>
                        }

                        @if (Has(p.CountryID) ||
                        Has(p.StateID) ||
                        Has(p.CityID) ||
                        Has(p.Pincode))
                        {
                            <div class="contact-row">
                                <i class="fa-solid fa-location-dot"></i>
                                <span id="rvAddress"
                                      data-country-id="@p.CountryID"
                                      data-state-id="@p.StateID"
                                      data-city-id="@p.CityID"
                                      data-pincode="@p.Pincode">@p.Pincode</span>
                            </div>
                        }

                    </div>
                </section>
            }</div>
            </header>
            <div class="body">
            @if (hasAbout || hasEdu || hasMission || hasExp || hasRef || hasSkills || hasLang || hasAch || hasHobby)
            {
            <div class="grid2">
            @if (hasAbout || hasEdu || hasMission)
            {
            <div class="gcol">
            @if (hasAbout)
            {
                <section class="block sec-about">
                    <h2 class="heading">Profile</h2>
                    <p class="body-text">@p.Objective</p>
                </section>
            }
            @if (hasEdu)
            {
                <section class="block sec-edu">
                    <h2 class="heading">Education</h2>

                    <div class="edu-list">

                        @if (HasNum(p.PG_Year))
                        {
                            var division = GetLookupName(Model.Divisions, p.PG_Division);

                            <div class="edu-item">
                                <div class="edu-year">@p.PG_Year</div>
                                <div class="edu-body">
                                    <div class="edu-title">@GetLookupName(Model.Streams, p.PG_Stream)</div>
                                    <div class="edu-sub">Post Graduation</div>
                                    @if (Has(division))
                                    {
                                        <div class="edu-note">@division</div>
                                    }
                                </div>
                            </div>
                        }

                        @if (HasNum(p.Graduation_Year))
                        {
                            var division = GetLookupName(Model.Divisions, p.Graduation_Division);

                            <div class="edu-item">
                                <div class="edu-year">@p.Graduation_Year</div>
                                <div class="edu-body">
                                    <div class="edu-title">@GetLookupName(Model.Streams, p.Graduation_Stream)</div>
                                    <div class="edu-sub">Graduation</div>
                                    @if (Has(division))
                                    {
                                        <div class="edu-note">@division</div>
                                    }
                                </div>
                            </div>
                        }

                        @if (HasNum(p.HSC_DIPLOMA_YEAR))
                        {
                            var division = GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION);

                            <div class="edu-item">
                                <div class="edu-year">@p.HSC_DIPLOMA_YEAR</div>
                                <div class="edu-body">
                                    <div class="edu-title">HSC / Diploma</div>
                                    <div class="edu-sub">Higher Secondary</div>
                                    @if (Has(division))
                                    {
                                        <div class="edu-note">@division</div>
                                    }
                                </div>
                            </div>
                        }

                        @if (HasNum(p.SSC_YEAR))
                        {
                            var division = GetLookupName(Model.Divisions, p.SSC_DIVISION);

                            <div class="edu-item">
                                <div class="edu-year">@p.SSC_YEAR</div>
                                <div class="edu-body">
                                    <div class="edu-title">SSC / 10th</div>
                                    <div class="edu-sub">Secondary School</div>
                                    @if (Has(division))
                                    {
                                        <div class="edu-note">@division</div>
                                    }
                                </div>
                            </div>
                        }

                    </div>
                </section>
            }
            @if (hasMission)
            {
                <section class="block sec-mission">
                    <h2 class="heading">My Mission</h2>

                    <div class="pref-list">

                        @if (Has(typeName))
                        {
                            <div>
                                <small>Looking for</small>
                                <strong>@typeName</strong>
                            </div>
                        }

                        @if (Has(preferredLocation))
                        {
                            <div>
                                <small>Preferred Location</small>
                                <strong>@preferredLocation</strong>
                            </div>
                        }

                    </div>
                </section>
            }
            </div>
            }
            @if (hasExp || hasRef)
            {
            <div class="gcol">
            @if (hasExp)
            {
                <section class="block sec-exp">
                    <h2 class="heading">Work Experience</h2>

                    <div class="exp-list">

                        @foreach (var internship in internships)
                        {
                            var duration = GetLookupName(Model.InternshipDurations, internship.Duration);
                            var title = GetLookupName(Model.InternshipTitles, internship.Title);
                            var status = GetLookupName(Model.InternshipStatuses, internship.Status);

                            <div class="exp-item">

                                <div class="exp-body">

                                    @if (Has(title))
                                    {
                                        <div class="exp-title">@title</div>
                                    }

                                    <div class="exp-org">@internship.Name</div>

                                    @if (Has(status))
                                    {
                                        <div class="exp-status">
                                            <i class="fa-solid fa-circle-check"></i>@status
                                        </div>
                                    }

                                </div>

                                <div class="exp-date">@duration</div>

                            </div>
                        }

                    </div>
                </section>
            }
            @if (hasRef)
            {
                <section class="block sec-ref">
                    <h2 class="heading">Reference</h2>

                    <div class="ref-grid">

                        @if (Has(p.sRefName1))
                        {
                            var relation = GetLookupName(Model.Relationships, p.sRefRelationName1);

                            <div class="ref-item">
                                <div class="ref-name">@p.sRefName1</div>
                                <div class="ref-rel">@(Has(relation) ? relation : "Ref 1")</div>
                                <div class="ref-line">@p.sMobile1</div>
                                @if (Has(p.sLocation1))
                                {
                                    <div class="ref-line">@p.sLocation1</div>
                                }
                            </div>
                        }

                        @if (Has(p.sRefName2))
                        {
                            var relation = GetLookupName(Model.Relationships, p.sRefRelationName2);

                            <div class="ref-item">
                                <div class="ref-name">@p.sRefName2</div>
                                <div class="ref-rel">@(Has(relation) ? relation : "Ref 2")</div>
                                <div class="ref-line">@p.sMobile2</div>
                                @if (Has(p.sLocation2))
                                {
                                    <div class="ref-line">@p.sLocation2</div>
                                }
                            </div>
                        }

                    </div>
                </section>
            }
            </div>
            }
            @if (hasSkills || hasLang || hasAch || hasHobby)
            {
            <div class="gcol">
            @if (hasSkills)
            {
                <section class="block sec-skills">
                    <h2 class="heading">Skills</h2>

                    @foreach (var group in skillGroups)
                    {
                        <div class="skill-group">

                            <div class="skill-group-title">@group.Item1</div>

                            <ul class="skill-list">
                                @foreach (var skill in group.Item2.Split(
                               new[] { ',', ';', '|' },
                               StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li>@skill.Trim()</li>
                                }
                            </ul>

                        </div>
                    }
                </section>
            }
            @if (hasLang)
            {
                <section class="block sec-lang">
                    <h2 class="heading">Languages</h2>

                    @foreach (var language in languages)
                    {
                        <div class="lang-row">
                            <div class="lang-name">@language.Name</div>

                            <div class="skill-bar">
                                <span style="width:@(RatingPercent(language.Rating))%"></span>
                            </div>
                        </div>
                    }
                </section>
            }
            @if (hasAch)
            {
                <section class="block sec-ach">
                    <h2 class="heading">Achievements &amp; Certifications</h2>

                    <ul class="achievement-list">
                        @foreach (var achievement in achievements)
                        {
                            <li>
                                <i class="fa-solid fa-award"></i>
                                <span>@achievement</span>
                            </li>
                        }
                    </ul>
                </section>
            }
            @if (hasHobby)
            {
                <section class="block sec-hobby">
                    <h2 class="heading">Interests</h2>

                    <div class="hobby-tags">
                        @foreach (var hobby in p.sHobbies.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            if (Has(hobby))
                            {
                                <span class="hobby-tag">@hobby.Trim()</span>
                            }
                        }
                    </div>
                </section>
            }
            </div>
            }
            </div>
            }
            </div>

        </div>

    </div>


    <!-- PDF -->

    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>


    <script>

        /* =====================================================
           THEME SWITCHER
        ===================================================== */

        document.addEventListener("DOMContentLoaded", function () {

            const swatches = document.querySelectorAll(".theme-swatch");
            const root = document.documentElement;

            function markActive(theme) {
                swatches.forEach(function (swatch) {
                    swatch.classList.toggle("active", swatch.dataset.theme === theme);
                });
            }

            markActive(root.getAttribute("data-theme") || "navy");

            swatches.forEach(function (swatch) {

                swatch.addEventListener("click", function () {

                    const theme = this.dataset.theme;

                    root.setAttribute("data-theme", theme);
                    markActive(theme);

                    try {
                        localStorage.setItem("resumeTheme36", theme);
                    } catch (e) { }

                });

            });

        });


        /* =====================================================
           ADDRESS RESOLUTION
        ===================================================== */

        document.addEventListener("DOMContentLoaded", function () {

            const addressEl = document.getElementById("rvAddress");

            if (!addressEl) {
                return;
            }

            const countryID = addressEl.getAttribute("data-country-id") || "";
            const stateID = addressEl.getAttribute("data-state-id") || "";
            const cityID = addressEl.getAttribute("data-city-id") || "";
            const pincode = addressEl.getAttribute("data-pincode") || "";

            function renderAddress(cityName, stateName, countryName) {

                const parts = [cityName, stateName, countryName, pincode]
                    .filter(value => value && value.trim() !== "");

                addressEl.textContent = parts.join(", ");
            }

            if (!countryID) {

                if (pincode) {
                    addressEl.textContent = pincode;
                }

                return;
            }

            fetch("/Location/GetCountries")

                .then(response => response.json())

                .then(countries => {

                    const country = countries.find(
                        c => String(c.id) === String(countryID)
                    );

                    const countryName = country ? country.name : "";
                    const countryCode = country ? country.iso2 : countryID;

                    if (!stateID) {
                        renderAddress("", "", countryName);
                        return;
                    }

                    return fetch(
                        "/Location/GetStates?countryCode=" +
                        encodeURIComponent(countryCode)
                    )

                    .then(response => response.json())

                    .then(states => {

                        const state = states.find(
                            s => String(s.id) === String(stateID)
                        );

                        const stateName = state ? state.name : "";

                        const stateCode = state
                            ? (state.stateCode || String(state.id).split(":")[1])
                            : "";

                        if (!cityID) {
                            renderAddress("", stateName, countryName);
                            return;
                        }

                        return fetch(
                            "/Location/GetCities?countryCode=" +
                            encodeURIComponent(countryCode) +
                            "&stateCode=" +
                            encodeURIComponent(stateCode)
                        )

                        .then(response => response.json())

                        .then(cities => {

                            const city = cities.find(
                                c => String(c.id) === String(cityID)
                            );

                            renderAddress(
                                city ? city.name : "",
                                stateName,
                                countryName
                            );

                        });

                    });

                })

                .catch(error => console.log("Address resolution error:", error));

        });


        /* =====================================================
           PDF DOWNLOAD  (fits the whole sheet on one A4 page)
        ===================================================== */

        async function downloadResumePDF() {

            const resumeSheet = document.getElementById("resumeSheet");

            if (!resumeSheet) {
                alert("Resume not found.");
                return;
            }

            const button = document.querySelector(".toolbar-download");
            const oldText = button.innerHTML;

            try {

                button.disabled = true;

                button.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Creating PDF...';

                if (document.fonts && document.fonts.ready) {
                    await document.fonts.ready;
                }

                const images = resumeSheet.querySelectorAll("img");

                await Promise.all(
                    Array.from(images).map(image => {

                        if (image.complete) {
                            return Promise.resolve();
                        }

                        return new Promise(resolve => {
                            image.onload = resolve;
                            image.onerror = resolve;
                        });

                    })
                );

                const canvas = await html2canvas(resumeSheet, {
                    scale: 3,
                    useCORS: true,
                    allowTaint: false,
                    backgroundColor: "#ffffff",
                    logging: false
                });

                const { jsPDF } = window.jspdf;

                const pdf = new jsPDF({
                    orientation: "landscape",
                    unit: "mm",
                    format: "a4",
                    compress: true
                });

                const pageWidth = pdf.internal.pageSize.getWidth();
                const pageHeight = pdf.internal.pageSize.getHeight();

                let imageWidth = pageWidth;
                let imageHeight = canvas.height * imageWidth / canvas.width;

                // sheet taller than A4 -> shrink to fit the page height
                if (imageHeight > pageHeight) {
                    imageHeight = pageHeight;
                    imageWidth = canvas.width * imageHeight / canvas.height;
                }

                const x = (pageWidth - imageWidth) / 2;
                const y = (pageHeight - imageHeight) / 2;

                const image = canvas.toDataURL("image/jpeg", 0.95);

                pdf.addImage(image, "JPEG", x, y, imageWidth, imageHeight, undefined, "FAST");

                let candidateName =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? ""));

                candidateName = candidateName
                    .trim()
                    .replace(/[^a-zA-Z0-9-_ ]/g, "")
                    .replace(/\s+/g, "_");

                if (!candidateName) {
                    candidateName = "Resume";
                }

                pdf.save(candidateName + "_ViewProfileThirtySix.pdf");

            }
            catch (error) {

                console.error("PDF generation error:", error);

                alert("Unable to generate PDF. Please try again.");

            }
            finally {

                button.disabled = false;
                button.innerHTML = oldText;

            }

        }

    </script>

</body>

</html>
