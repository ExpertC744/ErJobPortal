@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Three Column Modern (Template 8)";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }

        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);

    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @(Has(candidateName)
            ? candidateName + " - Resume"
            : "Resume")
    </title>

    <!-- =========================================================
         GOOGLE FONTS
    ========================================================== -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;600;700&display=swap"
          rel="stylesheet" />

    <!-- =========================================================
         FONT AWESOME
    ========================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>

        /* =========================================================
                   ROOT
                ========================================================== */

        :root {
            --primary: #263b47;
            --primary-light: #edf2f3;
            --accent: #b4773c;
            --accent-light: #f5ece3;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
            --soft: #f6f7f7;
            --white: #ffffff;
        }


        /* =========================================================
                   RESET
                ========================================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }


        html,
        body {
            width: 100%;
            min-height: 100%;
        }


        body {
            background: #e9edef;
            color: var(--text);
            font-family: "DM Sans", Arial, sans-serif;
        }


        /* =========================================================
                   THEME SWITCHER
                ========================================================== */

        .theme-switcher {
            width: 297mm;
            max-width: calc(100% - 30px);
            margin: 14px auto 10px;
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 8px;
        }


            .theme-switcher span {
                font-size: 9px;
                font-weight: 700;
                color: var(--muted);
                text-transform: uppercase;
                letter-spacing: .6px;
            }


        .theme-swatch {
            width: 18px;
            height: 18px;
            border-radius: 50%;
            border: 2px solid white;
            cursor: pointer;
            box-shadow: 0 1px 5px rgba(0,0,0,.15);
        }


            .theme-swatch.active {
                box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch);
            }


        /* =========================================================
                   RESUME PAGE WRAPPER
                ========================================================== */

        .resume-page-wrapper {
            display: flex;
            justify-content: center;
            padding: 5px 0 25px;
        }


        /* =========================================================
                   RESUME SHEET
                   A4 LANDSCAPE
                   297mm x 210mm
                ========================================================== */

        .resume-sheet {
            width: 297mm;
            height: 210mm;
            background: #ffffff;
            box-shadow: 0 12px 40px rgba(20,40,50,.14);
            overflow: hidden;
            display: grid;
            grid-template-columns: 26% 46% 28%;
            --theme-main: #00796b;
            --theme-dark: #1a1a1a;
            --text-dark: #333333;
            --text-light: #777777;
        }


            /* =========================================================
                   THEMES
                ========================================================== */

            .resume-sheet[data-theme="teal"] {
                --theme-main: #00796b;
                --theme-dark: #1a1a1a;
            }


            .resume-sheet[data-theme="navy"] {
                --theme-main: #1e3a8a;
                --theme-dark: #0f172a;
            }


            .resume-sheet[data-theme="crimson"] {
                --theme-main: #9f1239;
                --theme-dark: #27060e;
            }


            .resume-sheet[data-theme="emerald"] {
                --theme-main: #059669;
                --theme-dark: #064e3b;
            }


            .resume-sheet[data-theme="slate"] {
                --theme-main: #475569;
                --theme-dark: #0f172a;
            }


        /* =========================================================
                   LEFT COLUMN
                ========================================================== */

        .col-left {
            background: #ffffff;
            padding: 12mm 10mm;
            border-right: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            gap: 15px;
        }


        /* =========================================================
                   MIDDLE COLUMN
                ========================================================== */

        .col-mid {
            background: #ffffff;
            padding: 12mm 12mm;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            gap: 12px;
        }


        /* =========================================================
                   RIGHT COLUMN
                ========================================================== */

        .col-right {
            display: flex;
            flex-direction: column;
            background: var(--theme-main);
            color: #ffffff;
            height: 100%;
        }


        .col-right-top {
            padding: 12mm 10mm;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }


        .col-right-bottom {
            background: var(--theme-dark);
            padding: 10mm;
            margin-top: auto;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }


        /* =========================================================
                   PHOTO
                ========================================================== */

        .photo-wrap {
            position: relative;
            width: 40mm;
            height: 40mm;
            min-width: 40mm;
            min-height: 40mm;
            margin: 0 auto;
            border-radius: 50%;
            border: 3px solid var(--theme-main);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f1f5f9;
        }


        .photo {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            object-fit: cover;
        }


        .photo-placeholder {
            font-size: 35px;
            color: #cbd5e1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }


        /* =========================================================
                   LEFT SECTION HEADERS
                ========================================================== */

        .section-header-left {
            font-family: "Montserrat", sans-serif;
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 6px;
            color: #111;
        }


        .profile-text {
            font-size: 10px;
            line-height: 1.5;
            color: var(--text-light);
            text-align: justify;
        }


        /* =========================================================
                   SKILLS
                ========================================================== */

        .skill-list-left {
            list-style: none;
            padding: 0;
            margin-top: 4px;
        }


            .skill-list-left li {
                font-size: 10px;
                font-weight: 600;
                color: var(--text-dark);
                margin-bottom: 4px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }


        .skill-dots {
            color: var(--theme-main);
            font-size: 10px;
            letter-spacing: 1px;
        }


        /* =========================================================
                   MIDDLE INTRO
                ========================================================== */

        .intro-small {
            font-size: 14px;
            font-weight: 400;
            color: var(--text-dark);
            margin-bottom: 2px;
        }


        .intro-large {
            font-family: "Montserrat", sans-serif;
            font-size: 24px;
            font-weight: 700;
            color: #111;
            padding-bottom: 6px;
            border-bottom: 2px solid var(--theme-main);
            margin-bottom: 8px;
            line-height: 1.2;
        }


        .intro-role {
            font-weight: 500;
            font-size: 14px;
            color: var(--text-light);
        }


        /* =========================================================
                   MIDDLE SECTION HEADER
                ========================================================== */

        .section-header-mid {
            font-family: "Montserrat", sans-serif;
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 10px;
            color: #111;
        }


        /* =========================================================
                   EXPERIENCE
                ========================================================== */

        .exp-item {
            margin-bottom: 10px;
            break-inside: avoid;
        }


        .exp-date {
            font-size: 9.5px;
            font-weight: 700;
            color: var(--theme-main);
            margin-bottom: 2px;
        }


        .exp-title {
            font-family: "Montserrat", sans-serif;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #111;
            border-bottom: 1px solid var(--border);
            padding-bottom: 2px;
            margin-bottom: 3px;
            display: inline-block;
        }


        .exp-company {
            font-size: 10.5px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 2px;
        }


        .exp-desc {
            font-size: 9.5px;
            line-height: 1.5;
            color: var(--text-light);
        }


        /* =========================================================
                   RIGHT COLUMN HEADERS
                ========================================================== */

        .section-header-right {
            font-family: "Montserrat", sans-serif;
            font-size: 11.5px;
            font-weight: 800;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 8px;
            color: white;
        }


        /* =========================================================
                   CONTACT
                ========================================================== */

        .contact-item {
            font-size: 9.5px;
            line-height: 1.5;
            margin-bottom: 4px;
            color: rgba(255,255,255,0.95);
            word-break: break-word;
        }


        /* =========================================================
                   EDUCATION
                ========================================================== */

        .edu-item {
            margin-bottom: 8px;
        }


        .edu-date {
            font-size: 9px;
            font-weight: 700;
            color: rgba(255,255,255,0.8);
            margin-bottom: 2px;
        }


        .edu-title {
            font-family: "Montserrat", sans-serif;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            border-bottom: 1px solid rgba(255,255,255,0.3);
            padding-bottom: 2px;
            margin-bottom: 2px;
            display: inline-block;
        }


        .edu-sub {
            font-size: 9px;
            color: rgba(255,255,255,0.95);
        }


        /* =========================================================
                   REFERENCES
                ========================================================== */

        .ref-item {
            margin-bottom: 8px;
        }


        .ref-name {
            font-size: 10.5px;
            font-weight: 700;
            color: white;
        }


        .ref-detail {
            font-size: 9px;
            color: rgba(255,255,255,0.8);
            margin-top: 1px;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================== */

        @@media (max-width: 1200px) {

            .theme-switcher {
                width: 100%;
                padding-left: 12px;
                padding-right: 12px;
            }


            .resume-sheet {
                transform: scale(.75);
                transform-origin: top center;
                margin-bottom: -45mm;
            }
        }


        @@media (max-width: 768px) {

            .resume-sheet {
                transform: scale(.5);
                margin-bottom: -100mm;
            }
        }


        /* =========================================================
                   PRINT
                ========================================================== */

        @@media print {

            html,
            body {
                width: 297mm;
                height: 210mm;
                background: white;
            }


            .theme-switcher {
                display: none !important;
            }


            .resume-page-wrapper {
                padding: 0;
            }


            .resume-sheet {
                width: 297mm;
                height: 210mm;
                margin: 0;
                box-shadow: none;
                transform: none;
            }


            @@page {
                size: A4 landscape;
                margin: 0;
            }


            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         THEME SWITCHER
    ========================================================== -->

    <div class="theme-switcher">

        <span>Theme</span>

        <div class="theme-swatch active"
             data-theme="teal"
             style="background:#00796b;--swatch:#00796b"
             title="Teal">
        </div>

        <div class="theme-swatch"
             data-theme="navy"
             style="background:#1e3a8a;--swatch:#1e3a8a"
             title="Navy">
        </div>

        <div class="theme-swatch"
             data-theme="crimson"
             style="background:#9f1239;--swatch:#9f1239"
             title="Crimson">
        </div>

        <div class="theme-swatch"
             data-theme="emerald"
             style="background:#059669;--swatch:#059669"
             title="Emerald">
        </div>

        <div class="theme-swatch"
             data-theme="slate"
             style="background:#475569;--swatch:#475569"
             title="Slate">
        </div>

    </div>


    <!-- =========================================================
         RESUME WRAPPER
    ========================================================== -->

    <div class="resume-page-wrapper">

        <div class="resume-sheet"
             id="resumeSheet"
             data-theme="teal">


            <!-- =================================================
                 1. LEFT COLUMN
            ================================================== -->

            <div class="col-left">


                <!-- PROFILE PHOTO -->

                <div class="photo-wrap">

                    @if (Has(p.sPhoto))
                    {
                        <img src="@p.sPhoto"
                             class="photo"
                             alt="Profile"
                             onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='flex';" />

                        <div class="photo-placeholder"
                             id="fallbackIcon"
                             style="display:none;">

                            <i class="fa fa-user"></i>

                        </div>
                    }
                    else
                    {
                        <div class="photo-placeholder">

                            <i class="fa fa-user"></i>

                        </div>
                    }

                </div>


                <!-- PROFILE / OBJECTIVE -->
                @if (Has(p.Objective))
                {
                    <div>

                        <div class="section-header-left">
                            Profile
                        </div>

                        <div class="profile-text">
                            @p.Objective
                        </div>

                    </div>
                }


                <!-- =================================================
                     SKILL GROUPS
                ================================================== -->
                @{
                    var skillGroups = new[]
                    {
                ("Technical Skills", p.sTechnicalSkillIDs),
                ("Professional", p.sNonTechnicalSkillIDs),
                ("Medical Skills", p.sMedicalSkillIDs)
                }
                    .Where(x => Has(x.Item2))
                    .ToList();
                }


                @if (skillGroups.Any())
                {
                    <div>

                        <div class="section-header-left">
                            Pro Skills
                        </div>


                        @foreach (var group in skillGroups)
                        {
                            <ul class="skill-list-left">

                                @foreach (var skill in group.Item2.Split(
                               new[] { ',', ';', '|' },
                               StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <li>

                                        @skill.Trim()

                                        <span class="skill-dots">
                                            ••••••
                                        </span>

                                    </li>
                                }

                            </ul>
                        }

                    </div>
                }

            </div>


            <!-- =================================================
                 2. MIDDLE COLUMN
            ================================================== -->

            <div class="col-mid">


                <!-- =================================================
                     INTRO
                ================================================== -->

                <div>

                    <div class="intro-small">
                        Hello, my name is
                    </div>


                    <div class="intro-large">

                        @(Has(candidateName)
                            ? candidateName
                            : "Candidate Name")

                        @if (Has(candidateRole))
                        {
                            <span class="intro-role">
                                <br />
                                and I'm a @candidateRole.
                            </span>
                        }

                    </div>

                </div>


                <!-- =================================================
                     INTERNSHIPS / EXPERIENCE
                ================================================== -->
                @{
                    var internships = new[]
                    {
                new
                {
                Name = p.sOrgName1,
                Title = p.sOrgIntTitle1,
                Duration = p.sOrgIntDuration1,
                Status = p.sOrgIntStatus1
                },

                new
                {
                Name = p.sOrgName2,
                Title = p.sOrgIntTitle2,
                Duration = p.sOrgIntDuration2,
                Status = p.sOrgIntStatus2
                },

                new
                {
                Name = p.sOrgName3,
                Title = p.sOrgIntTitle3,
                Duration = p.sOrgIntDuration3,
                Status = p.sOrgIntStatus3
                },

                new
                {
                Name = p.sOrgName4,
                Title = p.sOrgIntTitle4,
                Duration = p.sOrgIntDuration4,
                Status = p.sOrgIntStatus4
                }

                }
                    .Where(x => Has(x.Name))
                    .ToList();
                }


                @if (internships.Any())
                {
                    <div>

                        <div class="section-header-mid">
                            Work Experience
                        </div>


                        @foreach (var exp in internships)
                        {
                            <div class="exp-item">


                                <div class="exp-date">
                                    @GetLookupName(
                                             Model.InternshipDurations,
                                             exp.Duration
                                             )
                                </div>


                                <div class="exp-title">

                                    @(Has(
                                        GetLookupName(
                                        Model.InternshipTitles,
                                        exp.Title
                                        )
                                        )
                                        ? GetLookupName(
                                        Model.InternshipTitles,
                                        exp.Title
                                        )
                                        : "Role")

                                </div>


                                <div class="exp-company">
                                    @exp.Name
                                </div>


                                @if (Has(
                               GetLookupName(
                               Model.InternshipStatuses,
                               exp.Status
                               )))
                                {
                                    <div class="exp-desc">

                                        Status:
                                        @GetLookupName(
                                                 Model.InternshipStatuses,
                                                 exp.Status
                                                 )

                                    </div>
                                }

                            </div>
                        }

                    </div>
                }


                <!-- =================================================
                     ACHIEVEMENTS
                ================================================== -->
                @{
                    var achievements = new[]
                    {
                p.Achievements_Certification1,
                p.Achievements_Certification2,
                p.Achievements_Certification3
                }
                    .Where(Has)
                    .ToList();
                }


                @if (achievements.Any())
                {
                    <div>

                        <div class="section-header-mid">
                            Achievements
                        </div>


                        @foreach (var a in achievements)
                        {
                            <div class="exp-item"
                                 style="margin-bottom:4px;">

                                <div class="exp-title"
                                     style="border:none;margin-bottom:0;">

                                    @a

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>


            <!-- =================================================
                 3. RIGHT COLUMN
            ================================================== -->

            <div class="col-right">


                <!-- =================================================
                     RIGHT TOP
                ================================================== -->

                <div class="col-right-top">


                    <!-- CONTACT -->

                    <div>

                        <div class="section-header-right">
                            Contact Me
                        </div>


                        @if (Has(Model.CandidateEmail))
                        {
                            <div class="contact-item">
                                @Model.CandidateEmail
                            </div>
                        }


                        @if (Has(Model.CandidatePhone))
                        {
                            <div class="contact-item">
                                @Model.CandidatePhone
                            </div>
                        }


                        @if (Has(p.Pincode))
                        {
                            <div class="contact-item"
                                 id="rvAddress"
                                 data-country-id="@p.CountryID"
                                 data-state-id="@p.StateID"
                                 data-city-id="@p.CityID"
                                 data-pincode="@p.Pincode">

                                @p.Pincode

                            </div>
                        }


                        @if (Has(p.Linkedin))
                        {
                            <div class="contact-item">
                                @p.Linkedin
                            </div>
                        }


                        @if (Has(p.GitHub))
                        {
                            <div class="contact-item">
                                @p.GitHub
                            </div>
                        }

                    </div>


                    <!-- =================================================
                         EDUCATION
                    ================================================== -->
                    @if (
                    HasNum(p.PG_Year) ||
                    HasNum(p.Graduation_Year) ||
                    HasNum(p.HSC_DIPLOMA_YEAR) ||
                    HasNum(p.SSC_YEAR)
                    )
                    {
                        <div style="margin-top:10px;">

                            <div class="section-header-right">
                                Education
                            </div>


                            <!-- PG -->
                            @if (HasNum(p.PG_Year))
                            {
                                <div class="edu-item">

                                    <div class="edu-date">
                                        @p.PG_Year
                                    </div>

                                    <div class="edu-title">
                                        @GetLookupName(
                                                 Model.Streams,
                                                 p.PG_Stream
                                                 )
                                    </div>

                                    <div class="edu-sub">
                                        Division:
                                        @GetLookupName(
                                                 Model.Divisions,
                                                 p.PG_Division
                                                 )
                                    </div>

                                </div>
                            }


                            <!-- GRADUATION -->
                            @if (HasNum(p.Graduation_Year))
                            {
                                <div class="edu-item">

                                    <div class="edu-date">
                                        @p.Graduation_Year
                                    </div>

                                    <div class="edu-title">
                                        @GetLookupName(
                                                 Model.Streams,
                                                 p.Graduation_Stream
                                                 )
                                    </div>

                                    <div class="edu-sub">
                                        Division:
                                        @GetLookupName(
                                                 Model.Divisions,
                                                 p.Graduation_Division
                                                 )
                                    </div>

                                </div>
                            }


                            <!-- HSC / DIPLOMA -->
                            @if (HasNum(p.HSC_DIPLOMA_YEAR))
                            {
                                <div class="edu-item">

                                    <div class="edu-date">
                                        @p.HSC_DIPLOMA_YEAR
                                    </div>

                                    <div class="edu-title">
                                        HSC / Diploma
                                    </div>

                                    <div class="edu-sub">
                                        Division:
                                        @GetLookupName(
                                                 Model.Divisions,
                                                 p.HSC_DIPLOMA_DIVISION
                                                 )
                                    </div>

                                </div>
                            }


                            <!-- SSC -->
                            @if (HasNum(p.SSC_YEAR))
                            {
                                <div class="edu-item">

                                    <div class="edu-date">
                                        @p.SSC_YEAR
                                    </div>

                                    <div class="edu-title">
                                        SSC / 10th
                                    </div>

                                    <div class="edu-sub">
                                        Division:
                                        @GetLookupName(
                                                 Model.Divisions,
                                                 p.SSC_DIVISION
                                                 )
                                    </div>

                                </div>
                            }

                        </div>
                    }


                    <!-- =================================================
                         LANGUAGES
                    ================================================== -->
                    @{
                        var langItems =
                        new List<(string Lang, string Star)>();

                        for (int i = 1; i <= 8; i++)
                        {
                            var lang =
                            typeof(ErJobPortal.Models.CandidateProfileModel)
                            .GetProperty($"sLanguage{i}")
                            ?.GetValue(p)
                            ?.ToString();

                            var star =
                            typeof(ErJobPortal.Models.CandidateProfileModel)
                            .GetProperty($"sLanguageStar{i}")
                            ?.GetValue(p)
                            ?.ToString();

                            if (Has(lang))
                            {
                                langItems.Add((lang, star));
                            }
                        }
                    }


                    @if (langItems.Any())
                    {
                        <div style="margin-top:10px;">

                            <div class="section-header-right">
                                Languages
                            </div>


                            @foreach (var l in langItems)
                            {
                                <div class="contact-item">

                                    @l.Lang

                                    @(Has(l.Star)
                                        ? $" - {l.Star}★"
                                        : "")

                                </div>
                            }

                        </div>
                    }

                </div>


                <!-- =================================================
                     RIGHT BOTTOM
                ================================================== -->

                <div class="col-right-bottom">


                    @if (Has(p.sRefName1) || Has(p.sRefName2))
                    {

                        <div class="section-header-right"
                             style="margin-bottom:8px;">

                            Reference

                        </div>


                        <!-- REFERENCE 1 -->
                        @if (Has(p.sRefName1))
                        {
                            <div class="ref-item">

                                <div class="ref-name">
                                    @p.sRefName1
                                </div>


                                <div class="ref-detail">

                                    @GetLookupName(
                                             Model.Relationships,
                                             p.sRefRelationName1
                                             )

                                </div>


                                @if (Has(p.sMobile1))
                                {
                                    <div class="ref-detail">
                                        @p.sMobile1
                                    </div>
                                }

                            </div>
                        }


                        <!-- REFERENCE 2 -->
                        @if (Has(p.sRefName2))
                        {
                            <div class="ref-item"
                                 style="margin-top:6px;">

                                <div class="ref-name">
                                    @p.sRefName2
                                </div>


                                <div class="ref-detail">

                                    @GetLookupName(
                                             Model.Relationships,
                                             p.sRefRelationName2
                                             )

                                </div>


                                @if (Has(p.sMobile2))
                                {
                                    <div class="ref-detail">
                                        @p.sMobile2
                                    </div>
                                }

                            </div>
                        }

                    }
                    else if (Has(p.sHobbies))
                    {

                        <div class="section-header-right"
                             style="margin-bottom:8px;">

                            Interests

                        </div>


                        <div class="contact-item"
                             style="white-space:pre-wrap;">

                            @p.sHobbies

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         THEME + ADDRESS SCRIPT ONLY

         NO DOWNLOAD SCRIPT
         NO HTML2CANVAS
         NO JSPDF
         NO DOWNLOAD BUTTON
         NO PRINT BUTTON
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sheet =
                document.getElementById("resumeSheet");

            const swatches =
                document.querySelectorAll(".theme-swatch");


            /* =====================================================
               THEME
            ====================================================== */

            const savedTheme =
                localStorage.getItem("resumeThemeV8") || "teal";


            if (sheet) {

                sheet.setAttribute(
                    "data-theme",
                    savedTheme
                );

            }


            swatches.forEach(function (swatch) {

                swatch.classList.toggle(
                    "active",
                    swatch.dataset.theme === savedTheme
                );


                swatch.addEventListener(
                    "click",
                    function () {

                        const theme =
                            this.dataset.theme;


                        if (sheet) {

                            sheet.setAttribute(
                                "data-theme",
                                theme
                            );

                        }


                        swatches.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        this.classList.add(
                            "active"
                        );


                        localStorage.setItem(
                            "resumeThemeV8",
                            theme
                        );

                    }
                );

            });


            /* =====================================================
               ADDRESS RESOLUTION
            ====================================================== */

            const addressElements =
                document.querySelectorAll(
                    "[data-country-id]"
                );


            if (!addressElements.length) {
                return;
            }


            const firstAddress =
                addressElements[0];


            const countryID =
                firstAddress.getAttribute(
                    "data-country-id"
                ) || "";


            const stateID =
                firstAddress.getAttribute(
                    "data-state-id"
                ) || "";


            const cityID =
                firstAddress.getAttribute(
                    "data-city-id"
                ) || "";


            const pincode =
                firstAddress.getAttribute(
                    "data-pincode"
                ) || "";


            /* =====================================================
               RENDER ADDRESS
            ====================================================== */

            function renderAddress(
                cityName,
                stateName,
                countryName
            ) {

                const parts = [
                    cityName,
                    stateName,
                    countryName,
                    pincode
                ]
                .filter(
                    value =>
                        value &&
                        value.trim()
                );


                const address =
                    parts.join(", ");


                addressElements.forEach(
                    function (element) {

                        element.textContent =
                            address;

                    }
                );

            }


            /* =====================================================
               COUNTRY NOT AVAILABLE
            ====================================================== */

            if (!countryID) {

                renderAddress(
                    "",
                    "",
                    ""
                );

                return;
            }


            /* =====================================================
               GET COUNTRY
            ====================================================== */

            fetch("/Location/GetCountries")

                .then(
                    response =>
                        response.json()
                )

                .then(
                    countries => {

                        const country =
                            countries.find(
                                c =>
                                    String(c.id) ===
                                    String(countryID)
                            );


                        const countryName =
                            country
                                ? country.name
                                : "";


                        const countryCode =
                            country
                                ? country.iso2
                                : countryID;


                        /* =================================================
                           NO STATE
                        ================================================== */

                        if (!stateID) {

                            renderAddress(
                                "",
                                "",
                                countryName
                            );

                            return;
                        }


                        /* =================================================
                           GET STATES
                        ================================================== */

                        return fetch(
                            "/Location/GetStates?countryCode=" +
                            encodeURIComponent(
                                countryCode
                            )
                        )

                        .then(
                            response =>
                                response.json()
                        )

                        .then(
                            states => {

                                const state =
                                    states.find(
                                        s =>
                                            String(s.id) ===
                                            String(stateID)
                                    );


                                const stateName =
                                    state
                                        ? state.name
                                        : "";


                                const stateCode =
                                    state
                                        ? (
                                            state.stateCode ||
                                            String(state.id)
                                                .split(":")[1]
                                          )
                                        : "";


                                /* =========================================
                                   NO CITY
                                ========================================== */

                                if (!cityID) {

                                    renderAddress(
                                        "",
                                        stateName,
                                        countryName
                                    );

                                    return;
                                }


                                /* =========================================
                                   GET CITY
                                ========================================== */

                                return fetch(
                                    "/Location/GetCities?countryCode=" +
                                    encodeURIComponent(
                                        countryCode
                                    ) +
                                    "&stateCode=" +
                                    encodeURIComponent(
                                        stateCode
                                    )
                                )

                                .then(
                                    response =>
                                        response.json()
                                )

                                .then(
                                    cities => {

                                        const city =
                                            cities.find(
                                                c =>
                                                    String(c.id) ===
                                                    String(cityID)
                                            );


                                        const cityName =
                                            city
                                                ? city.name
                                                : "";


                                        renderAddress(
                                            cityName,
                                            stateName,
                                            countryName
                                        );

                                    }
                                );

                            }
                        );

                    }
                )

                .catch(
                    error =>
                        console.log(
                            "Address resolution error:",
                            error
                        )
                );

        });

    </script>
    <!-- =========================================================
         COMMON RESUME DOWNLOAD / PRINT LIBRARIES
    ========================================================== -->
    <script>
        window.resumeFileName =
        @Html.Raw(
                     System.Text.Json.JsonSerializer.Serialize(
                         candidateName ?? "Resume"
                     )
                 );
    </script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script src="~/js/resume-download.js"></script>
</body>

</html>