@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;

    ViewData["Title"] = "Resume";

    var p = Model.Profile;

    var candidateName = string.IsNullOrWhiteSpace(Model.CandidateName)
        ? "Candidate"
        : Model.CandidateName;
}

@functions {

    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();

                if (idValue == id.ToString())
                    return nameProp.GetValue(item)?.ToString() ?? "";
            }
        }

        return "";
    }

    bool Has(string s)
    {
        return !string.IsNullOrWhiteSpace(s);
    }

    bool HasNum(int? n)
    {
        return n.HasValue && n.Value != 0;
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@candidateName - Resume</title>


    <!-- =========================================================
         FONTS
         ========================================================= -->

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap"
          rel="stylesheet" />


    <!-- =========================================================
         FONT AWESOME
         ========================================================= -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


    <script>

        window.resumeFileName =
            @Html.Raw(
                     System.Text.Json.JsonSerializer.Serialize(
                         candidateName
                     )
                 );

    </script>


    <style>

        /* =========================================================
                   ROOT
                   ========================================================= */

        :root {
            --primary: #163f3b;
            --accent: #0f766e;
            --accent-soft: #e8f4f1;
            --ink: #111817;
            --text: #343d3b;
            --muted: #697572;
            --line: #dce3e0;
            --soft-line: #edf1ef;
            --paper: #ffffff;
            --outside: #e8ecea;
            --black: #111817;
        }


        /* =========================================================
                   GLOBAL
                   ========================================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            background: var(--outside);
            font-family: "DM Sans", Arial, sans-serif;
            color: var(--text);
        }

        body {
            min-height: 100vh;
        }


        /* =========================================================
                   THEME SWITCHER
                   ========================================================= */

        .theme-switcher {
            width: 297mm;
            max-width: calc(100% - 30px);
            margin: 22px auto 14px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 9px;
        }

        .theme-switcher-label {
            font-size: 11px;
            font-weight: 700;
            color: #68736f;
            margin-right: 3px;
        }

        .theme-swatch {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px #cdd5d1;
            transition: .18s ease;
        }

            .theme-swatch:hover {
                transform: translateY(-2px);
            }

            .theme-swatch.active {
                box-shadow: 0 0 0 2px var(--ink), 0 3px 8px rgba(0,0,0,.12);
            }


        /* =========================================================
                   PAGE
                   ========================================================= */

        .resume-page-wrapper {
            width: 100%;
            padding: 8px 0 60px;
        }

        .resume-sheet {
            width: 297mm;
            height: 210mm;
            min-height: 210mm;
            margin: 0 auto;
            background: var(--paper);
            position: relative;
            overflow: hidden;
            box-shadow: 0 3px 8px rgba(0,0,0,.08), 0 22px 50px rgba(20,35,30,.13);
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                   TOP HEADER
                   ========================================================= */

        .resume-header {
            height: 76mm;
            display: grid;
            grid-template-columns: 58% 42%;
            flex-shrink: 0;
        }


        /* =========================================================
                   HEADER LEFT
                   ========================================================= */

        .header-left {
            padding: 17mm 13mm 11mm 16mm;
            display: flex;
            align-items: center;
            gap: 10mm;
            position: relative;
            
        }

            .header-left::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 6px;
                height: 100%;
                background: var(--accent);
            }


        /* =========================================================
                   PHOTO
                   ========================================================= */

        .photo-box {
            width: 43mm;
            height: 49mm;
            flex: 0 0 43mm;
            overflow: hidden;
            background: #edf2f0;
            border: 1px solid #d6dfdb;
            position: relative;
        }

            .photo-box img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

        .photo-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #87928e;
            font-size: 34px;
        }


        /* =========================================================
                   IDENTITY
                   ========================================================= */

        .identity {
            min-width: 0;
            flex: 1;
        }

        .candidate-name {
            margin: 0;
            font-family: "Manrope", sans-serif;
            font-size: 30px;
            line-height: 1.05;
            font-weight: 800;
            letter-spacing: -1px;
            color: var(--ink);
            word-break: break-word;
        }

        .candidate-role {
            margin-top: 6px;
            color: var(--accent);
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .identity-line {
            width: 46px;
            height: 3px;
            background: var(--accent);
            margin: 10px 0 12px;
        }


        /* =========================================================
                   CONTACT
                   ========================================================= */

        .contact-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .contact-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            font-size: 9.7px;
            line-height: 1.35;
            color: var(--text);
            word-break: break-word;
        }

            .contact-item i {
                width: 15px;
                flex: 0 0 15px;
                color: var(--accent);
                font-size: 10px;
                margin-top: 2px;
            }


        /* =========================================================
                   HEADER RIGHT
                   ========================================================= */

        .header-right {
            padding: 15mm 14mm 11mm 12mm;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .header-label {
            display: inline-flex;
            align-self: flex-start;
            background: var(--primary);
            color: #fff;
            padding: 7px 18px;
            border-radius: 0 18px 18px 0;
            font-family: "Manrope", sans-serif;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: .5px;
            text-transform: uppercase;
            margin-bottom: 13px;
        }

        .header-summary {
            font-size: 10.3px;
            line-height: 1.65;
            color: var(--text);
            margin: 0;
        }


        /* =========================================================
                   MAIN BODY
                   ========================================================= */

        .resume-body {
            flex: 1;
            display: grid;
            grid-template-columns: 58% 42%;
            min-height: 0;
        }


        /* =========================================================
                   LEFT BODY
                   ========================================================= */

        .body-left {
            padding: 8mm 11mm 8mm 16mm;
            min-width: 0;
            overflow: hidden;
        }


        /* =========================================================
                   RIGHT BODY
                   ========================================================= */

        .body-right {
            padding: 0mm 5mm 8mm 11mm;
            min-width: 0;
            overflow: hidden;
        }


        /* =========================================================
                   SECTION
                   ========================================================= */

        .resume-section {
            margin-bottom: 12px;
            break-inside: avoid;
            page-break-inside: avoid;
        }

            .resume-section:last-child {
                margin-bottom: 0;
            }


        /* =========================================================
                   SECTION TITLE
                   ========================================================= */

        .section-title {
            display: inline-flex;
            align-items: center;
            background: var(--primary);
            color: #fff;
            padding: 6px 18px 6px 14px;
            border-radius: 0 18px 18px 0;
            font-family: "Manrope", sans-serif;
            font-size: 10.8px;
            font-weight: 800;
            line-height: 1;
            text-transform: uppercase;
            letter-spacing: .45px;
            margin-bottom: 8px;
        }

            .section-title i {
                font-size: 9px;
                margin-right: 7px;
                color: #b9e3dc;
            }


        /* =========================================================
                   PROFILE
                   ========================================================= */

        .profile-text {
            margin: 0;
            font-size: 10.2px;
            line-height: 1.62;
            color: var(--text);
            max-width: 100%;
        }


        /* =========================================================
                   TWO INNER COLUMNS
                   ========================================================= */

        .inner-two-column {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10mm;
            min-width: 0;
        }


        /* =========================================================
                   EDUCATION
                   ========================================================= */

        .education-item {
            position: relative;
            padding-left: 12px;
            margin-bottom: 9px;
            border-left: 2px solid var(--accent);
            break-inside: avoid;
        }

            .education-item:last-child {
                margin-bottom: 0;
            }

        .education-title {
            font-family: "Manrope", sans-serif;
            font-size: 10px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.3;
        }

        .education-meta {
            font-size: 9.3px;
            color: var(--muted);
            line-height: 1.45;
            margin-top: 2px;
        }


        /* =========================================================
                   INTERNSHIPS
                   ========================================================= */

        .experience-item {
            position: relative;
            padding: 0 0 10px 14px;
            margin-bottom: 9px;
            border-left: 2px solid var(--accent);
            break-inside: avoid;
            page-break-inside: avoid;
        }

            .experience-item:last-child {
                margin-bottom: 0;
                padding-bottom: 0;
            }

        .experience-dot {
            position: absolute;
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--accent);
            left: -4.5px;
            top: 4px;
        }

        .experience-title {
            font-family: "Manrope", sans-serif;
            font-size: 10.4px;
            font-weight: 800;
            color: var(--ink);
            line-height: 1.3;
        }

        .experience-company {
            font-size: 9.8px;
            font-weight: 600;
            color: var(--accent);
            margin-top: 2px;
            line-height: 1.35;
        }

        .experience-meta {
            font-size: 9px;
            color: var(--muted);
            margin-top: 2px;
            line-height: 1.35;
        }


        /* =========================================================
                   SKILLS
                   ========================================================= */

        .skill-group {
            margin-bottom: 8px;
        }

            .skill-group:last-child {
                margin-bottom: 0;
            }

        .skill-name {
            font-family: "Manrope", sans-serif;
            font-size: 9.7px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 4px;
        }

        .skill-value {
            font-size: 9.3px;
            line-height: 1.5;
            color: var(--text);
            padding-bottom: 6px;
            border-bottom: 1px solid var(--soft-line);
        }

        .skill-group:last-child .skill-value {
            border-bottom: 0;
        }


        /* =========================================================
                   ACHIEVEMENTS
                   ========================================================= */

        .achievement-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

            .achievement-list li {
                position: relative;
                padding-left: 13px;
                margin-bottom: 5px;
                font-size: 9.5px;
                line-height: 1.45;
                color: var(--text);
            }

                .achievement-list li:last-child {
                    margin-bottom: 0;
                }

                .achievement-list li::before {
                    content: "";
                    position: absolute;
                    width: 5px;
                    height: 5px;
                    border-radius: 50%;
                    background: var(--accent);
                    left: 0;
                    top: 6px;
                }


        /* =========================================================
                   PREFERENCE
                   ========================================================= */

        .preference-box {
            background: var(--accent-soft);
            border-left: 3px solid var(--accent);
            padding: 8px 10px;
            font-size: 9.5px;
            line-height: 1.55;
            color: var(--text);
        }

        .preference-line {
            margin: 0 0 3px;
        }

            .preference-line:last-child {
                margin-bottom: 0;
            }

        .preference-label {
            font-weight: 800;
            color: var(--primary);
        }


        /* =========================================================
                   LANGUAGES
                   ========================================================= */

        .language-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 5px 15px;
        }

        .language-item {
            font-size: 9.5px;
            color: var(--text);
            padding-bottom: 5px;
            border-bottom: 1px solid var(--soft-line);
        }

        .language-star {
            color: var(--accent);
            font-size: 8.5px;
            margin-left: 2px;
        }


        /* =========================================================
                   HOBBIES
                   ========================================================= */

        .hobbies-text {
            font-size: 9.5px;
            line-height: 1.5;
            color: var(--text);
            margin: 0;
        }


        /* =========================================================
                   LINKS
                   ========================================================= */

        .links-list {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .link-item {
            display: flex;
            gap: 8px;
            align-items: flex-start;
            font-size: 9.2px;
            line-height: 1.4;
            word-break: break-word;
        }

            .link-item i {
                color: var(--accent);
                width: 13px;
                flex: 0 0 13px;
                margin-top: 2px;
            }


        /* =========================================================
                   REFERENCES
                   ========================================================= */

        .references-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }

        .reference-item {
            padding: 7px 8px;
            border: 1px solid var(--line);
            border-top: 2px solid var(--accent);
            min-width: 0;
            break-inside: avoid;
        }

        .reference-name {
            font-family: "Manrope", sans-serif;
            font-size: 9.5px;
            font-weight: 800;
            color: var(--ink);
            margin-bottom: 2px;
        }

        .reference-detail {
            font-size: 8.8px;
            color: var(--text);
            line-height: 1.45;
            word-break: break-word;
        }


        /* =========================================================
                   FOOTER ACCENT
                   ========================================================= */

        .resume-footer-line {
            position: absolute;
            bottom: 0;
            left: 0;
            height: 4px;
            width: 100%;
            background: var(--primary);
        }


        /* =========================================================
                   THEMES
                   ========================================================= */

        .resume-sheet[data-theme="teal"] {
            --primary: #163f3b;
            --accent: #0f766e;
            --accent-soft: #e8f4f1;
        }

        .resume-sheet[data-theme="blue"] {
            --primary: #163b5c;
            --accent: #1976a8;
            --accent-soft: #eaf4fa;
        }

        .resume-sheet[data-theme="burgundy"] {
            --primary: #51252b;
            --accent: #a94450;
            --accent-soft: #f8edef;
        }

        .resume-sheet[data-theme="olive"] {
            --primary: #3e4930;
            --accent: #71833f;
            --accent-soft: #f0f3e8;
        }

        .resume-sheet[data-theme="slate"] {
            --primary: #273640;
            --accent: #527d91;
            --accent-soft: #edf3f5;
        }

        .resume-sheet[data-theme="brown"] {
            --primary: #4b3528;
            --accent: #a56b3d;
            --accent-soft: #f7eee8;
        }


        /* =========================================================
                   MOBILE / FIT
                   ========================================================= */

        @@media (max-width: 1150px) {

            body {
                background: #ffffff;
            }

            .theme-switcher {
                max-width: calc(100% - 20px);
                justify-content: center;
                flex-wrap: wrap;
                margin-top: 12px;
            }

            .resume-page-wrapper {
                padding: 8px 0 30px;
                overflow: hidden;
            }

            .resume-sheet {
                margin: 0;
                transform-origin: top left;
            }
        }


        /* =========================================================
                   SMALL SCREEN
                   ========================================================= */

        @@media (max-width: 700px) {

            .theme-switcher {
                margin-bottom: 8px;
            }

            .theme-switcher-label {
                width: 100%;
                text-align: center;
                margin-bottom: 2px;
            }
        }


        /* =========================================================
                   PRINT
                   ========================================================= */

        @@media print {

            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
                color-adjust: exact !important;
            }

            html,
            body {
                width: 297mm;
                height: 210mm;
                margin: 0;
                padding: 0;
                background: #ffffff;
            }

                body * {
                    visibility: hidden;
                }

            .resume-sheet,
            .resume-sheet * {
                visibility: visible;
            }

            .theme-switcher {
                display: none !important;
            }

            .resume-page-wrapper {
                width: 297mm;
                height: 210mm;
                margin: 0;
                padding: 0;
                background: #ffffff;
                overflow: visible;
            }

            .resume-sheet {
                width: 297mm;
                height: 210mm;
                min-height: 210mm;
                margin: 0;
                border-radius: 0;
                box-shadow: none;
                transform: none !important;
                overflow: hidden;
            }

            .resume-section,
            .experience-item,
            .education-item,
            .reference-item {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            }

            @@page {
                size: A4 landscape;
                margin: 0;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         THEME SWITCHER
         ========================================================= -->

    <div class="theme-switcher">

        <span class="theme-switcher-label">
            Resume Theme
        </span>

        <div class="theme-swatch active"
             data-theme="teal"
             style="background:#0f766e;"
             title="Teal">
        </div>

        <div class="theme-swatch"
             data-theme="blue"
             style="background:#1976a8;"
             title="Blue">
        </div>

        <div class="theme-swatch"
             data-theme="burgundy"
             style="background:#a94450;"
             title="Burgundy">
        </div>

        <div class="theme-swatch"
             data-theme="olive"
             style="background:#71833f;"
             title="Olive">
        </div>

        <div class="theme-swatch"
             data-theme="slate"
             style="background:#527d91;"
             title="Slate">
        </div>

        <div class="theme-swatch"
             data-theme="brown"
             style="background:#a56b3d;"
             title="Brown">
        </div>

    </div>


    <!-- =========================================================
         RESUME
         ========================================================= -->

    <div class="resume-page-wrapper"
         id="resumeWrapper">

        <div class="resume-sheet"
             id="resumeSheet"
             data-theme="teal">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <header class="resume-header">


                <!-- =============================================
                     LEFT HEADER
                     ============================================= -->

                <div class="header-left">


                    <!-- PHOTO -->

                    <div class="photo-box">

                        @if (Has(p.sPhoto))
                        {
                            <img src="@p.sPhoto"
                                 alt="Candidate Photo" />
                        }
                        else
                        {
                            <div class="photo-placeholder">
                                <i class="fa-solid fa-user"></i>
                            </div>
                        }

                    </div>


                    <!-- IDENTITY -->

                    <div class="identity">

                        <h1 class="candidate-name">
                            @candidateName
                        </h1>


                        <div class="candidate-role">

                            @GetLookupName(
                                     Model.InternshipFellowshipType,
                                     p.Internship_FellowshipType
                                     )

                        </div>


                        <div class="identity-line"></div>


                        <!-- CONTACT -->

                        <div class="contact-list">


                            @if (Has(Model.CandidatePhone))
                            {
                                <div class="contact-item">

                                    <i class="fa-solid fa-phone"></i>

                                    <span>
                                        @Model.CandidatePhone
                                    </span>

                                </div>
                            }


                            @if (Has(Model.CandidateEmail))
                            {
                                <div class="contact-item">

                                    <i class="fa-solid fa-envelope"></i>

                                    <span>
                                        @Model.CandidateEmail
                                    </span>

                                </div>
                            }


                            @if (
                            Has(p.CountryID) ||
                            Has(p.StateID) ||
                            Has(p.CityID) ||
                            Has(p.Pincode)
                            )
                            {
                                <div class="contact-item">

                                    <i class="fa-solid fa-location-dot"></i>

                                    <span id="rvAddress"
                                          data-country-id="@p.CountryID"
                                          data-state-id="@p.StateID"
                                          data-city-id="@p.CityID"
                                          data-pincode="@p.Pincode">

                                        @if (Has(p.Pincode))
                                        {
                                            @p.Pincode
                                        }
                                        else
                                        {
                                            <text>-</text>
                                        }

                                    </span>

                                </div>
                            }


                            @if (Has(p.GitHub))
                            {
                                <div class="contact-item">

                                    <i class="fa-brands fa-github"></i>

                                    <span>
                                        @p.GitHub
                                    </span>

                                </div>
                            }


                            @if (Has(p.Linkedin))
                            {
                                <div class="contact-item">

                                    <i class="fa-brands fa-linkedin"></i>

                                    <span>
                                        @p.Linkedin
                                    </span>

                                </div>
                            }

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     RIGHT HEADER
                     ============================================= -->

                <div class="header-right">

                    <div class="header-label">
                        Profile
                    </div>


                    @if (Has(p.Objective))
                    {
                        <p class="header-summary">
                            @p.Objective
                        </p>
                    }

                </div>

            </header>


            <!-- =================================================
                 BODY
                 ================================================= -->

            <main class="resume-body">


                <!-- =================================================
                     LEFT CONTENT
                     ================================================= -->

                <section class="body-left">


                    <!-- =============================================
                         EDUCATION + SKILLS
                         ============================================= -->

                    <div class="inner-two-column">


                        <!-- EDUCATION -->
                        @if (
                        HasNum(p.PG_Year) ||
                        HasNum(p.Graduation_Year) ||
                        HasNum(p.HSC_DIPLOMA_YEAR) ||
                        HasNum(p.SSC_YEAR)
                        )
                        {
                            <div class="resume-section">

                                <div class="section-title">

                                    <i class="fa-solid fa-graduation-cap"></i>

                                    Education

                                </div>


                                @if (HasNum(p.PG_Year))
                                {
                                    <div class="education-item">

                                        <div class="education-title">

                                            @GetLookupName(
                                                     Model.Streams,
