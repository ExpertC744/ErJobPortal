    <!-- =========================================================
         ADDRESS RESOLUTION
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                var addressEl =
                    document.getElementById("rvAddress");


                if (!addressEl)
                    return;


                var countryID =
                    addressEl.getAttribute(
                        "data-country-id"
                    ) || "";


                var stateID =
                    addressEl.getAttribute(
                        "data-state-id"
                    ) || "";


                var cityID =
                    addressEl.getAttribute(
                        "data-city-id"
                    ) || "";


                var pincode =
                    addressEl.getAttribute(
                        "data-pincode"
                    ) || "";


                function renderAddress(
                    cityName,
                    stateName,
                    countryName
                ) {

                    var parts =
                        [
                            cityName,
                            stateName,
                            countryName,
                            pincode
                        ]
                        .filter(function (value) {

                            return value &&
                                value.trim() !== "";

                        });


                    addressEl.textContent =
                        parts.length
                            ? parts.join(", ")
                            : "-";

                }


                if (!countryID) {
                    return;
                }


                fetch("/Location/GetCountries")

                    .then(function (res) {
                        return res.json();
                    })


                    .then(function (countries) {

                        var country =
                            countries.find(
                                function (c) {

                                    return String(c.id) ===
                                        String(countryID);

                                }
                            );


                        var countryName =
                            country
                                ? country.name
                                : "";


                        var countryCode =
                            country
                                ? country.iso2
                                : countryID;


                        if (!stateID) {

                            renderAddress(
                                "",
                                "",
                                countryName
                            );

                            return;

                        }


                        fetch(
                            "/Location/GetStates?countryCode=" +
                            encodeURIComponent(
                                countryCode
                            )
                        )

                        .then(function (res) {
                            return res.json();
                        })


                        .then(function (states) {

                            var state =
                                states.find(
                                    function (s) {

                                        return String(s.id) ===
                                            String(stateID);

                                    }
                                );


                            var stateName =
                                state
                                    ? state.name
                                    : "";


                            var stateCode =
                                state
                                    ? (
                                        state.stateCode ||
                                        (
                                            String(state.id)
                                                .split(":")[1] ||
                                            state.id
                                        )
                                    )
                                    : "";


                            if (!cityID) {

                                renderAddress(
                                    "",
                                    stateName,
                                    countryName
                                );

                                return;

                            }


                            fetch(
                                "/Location/GetCities?countryCode=" +
                                encodeURIComponent(
                                    countryCode
                                ) +
                                "&stateCode=" +
                                encodeURIComponent(
                                    stateCode
                                )
                            )

                            .then(function (res) {
                                return res.json();
                            })


                            .then(function (cities) {

                                var city =
                                    cities.find(
                                        function (c) {

                                            return String(c.id) ===
                                                String(cityID);

                                        }
                                    );


                                var cityName =
                                    city
                                        ? city.name
                                        : "";


                                renderAddress(
                                    cityName,
                                    stateName,
                                    countryName
                                );

                            })


                            .catch(function () {

                                renderAddress(
                                    "",
                                    stateName,
                                    countryName
                                );

                            });

                        })


                        .catch(function () {

                            renderAddress(
                                "",
                                "",
                                countryName
                            );

                        });

                    })


                    .catch(function (err) {

                        console.log(
                            "Address resolution error:",
                            err
                        );

                    });

            }

        );

    </script>


    <!-- =========================================================
         A4 FIT
         ========================================================= -->

    <script>

        (function () {

            var sheet =
                document.getElementById(
                    "resumeSheet"
                );


            var wrapper =
                document.getElementById(
                    "resumeWrapper"
                );


            if (!sheet || !wrapper)
                return;


            function fitSheet() {

                if (
                    window.matchMedia(
                        "print"
                    ).matches
                ) {
                    return;
                }


                sheet.style.transform = "none";

                wrapper.style.height = "";


                if (window.innerWidth > 1150) {
                    return;
                }


                var sheetW =
                    sheet.offsetWidth;


                var sheetH =
                    sheet.offsetHeight;


                var scale =
                    Math.min(
                        1,
                        window.innerWidth /
                        sheetW
                    );


                sheet.style.transform =
                    "scale(" +
                    scale +
                    ")";


                wrapper.style.height =
                    (
                        sheetH * scale +
                        30
                    ) +
                    "px";

            }


            window.addEventListener(
                "resize",
                fitSheet
            );


            window.addEventListener(
                "load",
                fitSheet
            );


            fitSheet();

        })();

    </script>


    <!-- =========================================================
         THEME SWITCHER
         ========================================================= -->

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const resumeSheet =
                    document.getElementById(
                        "resumeSheet"
                    );


                const swatches =
                    document.querySelectorAll(
                        ".theme-swatch"
                    );


                if (
                    !resumeSheet ||
                    !swatches.length
                ) {
                    return;
                }


                const savedTheme =
                    localStorage.getItem(
                        "resumeTheme"
                    );


                if (savedTheme) {

                    resumeSheet.setAttribute(
                        "data-theme",
                        savedTheme
                    );


                    swatches.forEach(
                        function (swatch) {

                            swatch.classList.remove(
                                "active"
                            );


                            if (
                                swatch.dataset.theme ===
                                savedTheme
                            ) {

                                swatch.classList.add(
                                    "active"
                                );

                            }

                        }
                    );

                }


                swatches.forEach(
                    function (swatch) {

                        swatch.addEventListener(
                            "click",
                            function () {

                                const theme =
                                    this.dataset.theme;


                                if (!theme)
                                    return;


                                resumeSheet.setAttribute(
                                    "data-theme",
                                    theme
                                );


                                swatches.forEach(
                                    function (item) {

                                        item.classList.remove(
                                            "active"
                                        );

                                    }
                                );


                                this.classList.add(
                                    "active"
                                );


                                localStorage.setItem(
                                    "resumeTheme",
                                    theme
                                );

                            }
                        );

                    }
                );

            }
        );

    </script>


