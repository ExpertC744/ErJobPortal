@model ErJobPortal.Models.ResumeViewModel

@{
    Layout = null;
    ViewData["Title"] = "Professional Resume - Elegant Three Column (Template 12)";

    var p = Model.Profile;
    var candidateName = Model.CandidateName?.Trim();

    var candidateRole = GetLookupName(
        Model.InternshipFellowshipType,
        p.Internship_FellowshipType
    );

    if (string.Equals(candidateRole, "Paid by Trainee", StringComparison.OrdinalIgnoreCase))
    {
        candidateRole = "";
    }
}

@functions {
    string GetLookupName(System.Collections.IEnumerable list, object id)
    {
        if (list == null || id == null || string.IsNullOrWhiteSpace(id.ToString()))
            return "";

        foreach (var item in list)
        {
            var idProp = item.GetType().GetProperty("ID");
            var nameProp = item.GetType().GetProperty("Name");

            if (idProp != null && nameProp != null)
            {
                var idValue = idProp.GetValue(item)?.ToString();
                if (idValue == id.ToString())
                {
                    return nameProp.GetValue(item)?.ToString() ?? "";
                }
            }
        }
        return "";
    }

    bool Has(string s) => !string.IsNullOrWhiteSpace(s);
    bool HasNum(int? n) => n.HasValue && n.Value != 0;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@(Has(candidateName) ? candidateName + " - Resume" : "Resume")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Montserrat:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <style>
        :root {
            --primary: #263b47;
            --accent: #b4773c;
            --text: #27343c;
            --muted: #718087;
            --border: #dce2e4;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { width: 100%; min-height: 100%; }

        body {
            background: #e9edef;
            font-family: "DM Sans", Arial, sans-serif;
            color: var(--text);
        }

        /* TOOLBAR */
        .resume-toolbar {
            width: 297mm; max-width: calc(100% - 30px); margin: 14px auto 8px;
            display: flex; justify-content: flex-end; gap: 8px;
        }

        .resume-toolbar button, .resume-toolbar a {
            border: 0; min-height: 32px; padding: 8px 14px; border-radius: 5px;
            font-family: "DM Sans", sans-serif; font-size: 10px; font-weight: 700;
            text-decoration: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;
        }

        .btn-edit { background: #ffffff; color: var(--primary); border: 1px solid var(--border) !important; }
        .btn-print { background: var(--primary); color: white; }
        .btn-download { background: var(--accent); color: white; }

        /* THEME SWITCHER */
        .theme-switcher {
            width: 297mm; max-width: calc(100% - 30px); margin: 0 auto 10px;
            display: flex; justify-content: flex-end; align-items: center; gap: 8px;
        }
        .theme-switcher span { font-size: 9px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .6px; }
        .theme-swatch { width: 18px; height: 18px; border-radius: 50%; border: 2px solid white; cursor: pointer; box-shadow: 0 1px 5px rgba(0,0,0,.15); }
        .theme-swatch.active { box-shadow: 0 0 0 2px white, 0 0 0 4px var(--swatch); }

        /* RESUME SHEET: HORIZONTAL A4 */
        .resume-page-wrapper { display: flex; justify-content: center; padding: 5px 0 25px; }

        .resume-sheet {
            width: 297mm; height: 210mm; background: #ffffff;
            box-shadow: 0 15px 35px rgba(0,0,0,.1); overflow: hidden;
            display: flex;
            
            /* Theme Mappings */
            --theme-color: #a27b74; 
            --theme-bg-light: #f4efed;
            --sidebar-bg: #efece8;
            --text-main: #444444;
        }

        .resume-sheet[data-theme="navy"] { --theme-color: #3b5060; --theme-bg-light: #eaeff2; --sidebar-bg: #f0f3f5; }
        .resume-sheet[data-theme="teal"] { --theme-color: #336e6c; --theme-bg-light: #e8f1f1; --sidebar-bg: #f0f6f6; }
        .resume-sheet[data-theme="olive"] { --theme-color: #636e59; --theme-bg-light: #eef1ec; --sidebar-bg: #f4f6f2; }
        .resume-sheet[data-theme="blue"] { --theme-color: #3f6888; --theme-bg-light: #ebf1f5; --sidebar-bg: #f2f6f9; }
        .resume-sheet[data-theme="brown"] { --theme-color: #a27b74; --theme-bg-light: #f4efed; --sidebar-bg: #f6f3f0; }

        /* LAYOUT COLUMNS */
        .col-left {
            width: 26%;
            background: var(--sidebar-bg);
            /* Padding removed here so the image goes flush to the edges */
            display: flex; flex-direction: column; align-items: center;
        }
        .col-mid {
            width: 37%;
            padding: 14mm 10mm;
            display: flex; flex-direction: column; gap: 20px;
        }
        .col-right {
            width: 37%;
            padding: 14mm 10mm;
            border-left: 1px solid #dcdcdc; 
            display: flex; flex-direction: column; gap: 20px;
        }

        /* LEFT COLUMN: UP-FLUSH PROFILE PHOTO */
        .edge-photo-container {
            width: 100%;
            height: 75mm; /* Set specific height for the flush box */
            background: rgba(0,0,0,0.05);
            display: flex; align-items: center; justify-content: center;
            overflow: hidden;
            flex-shrink: 0;
        }
        .edge-photo { width: 100%; height: 100%; object-fit: cover; }
        .photo-placeholder { font-size: 50px; color: var(--theme-color); opacity: 0.5; }

        /* We apply the padding only to the content BELOW the image */
        .left-content {
            width: 100%;
            padding: 10mm 10mm;
            display: flex; flex-direction: column; align-items: center;
        }

        .name {
            font-family: "Playfair Display", serif; font-size: 32px; font-weight: 600;
            color: #111111; line-height: 1.1; text-align: center; margin-bottom: 4px;
            word-wrap: break-word;
        }
        .role {
            font-family: "Montserrat", sans-serif; font-size: 10.5px; font-weight: 600;
            text-transform: uppercase; letter-spacing: 2px; color: #555; text-align: center;
            line-height: 1.4;
        }

        .left-divider {
            width: 80%; height: 1px; background: #dcdcdc; margin: 12px auto;
        }

        .contact-list { display: flex; flex-direction: column; gap: 10px; width: 100%; padding: 0 5px; }
        .contact-item { display: flex; align-items: center; gap: 10px; font-size: 9px; line-height: 1.4; color: #444; word-break: break-word; }
        .icon-circle {
            width: 22px; height: 22px; min-width: 22px; border-radius: 50%;
            border: 1px solid var(--theme-color); color: #222;
            display: flex; align-items: center; justify-content: center; font-size: 10px;
        }

        /* SECTION HEADERS */
        .section-header {
            background-color: var(--theme-bg-light);
            padding: 6px 10px;
            font-family: 'Montserrat', sans-serif;
            font-weight: 700;
            font-size: 11px;
            letter-spacing: 1px;
            color: #111;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        /* BODY TEXT */
        .body-text {
            font-size: 9.5px; line-height: 1.6; color: var(--text-main); text-align: justify;
        }

        /* SKILLS PROGRESS BARS */
        .skill-row { display: grid; grid-template-columns: 80px 1fr; align-items: center; gap: 10px; margin-bottom: 6px; }
        .skill-name { font-size: 9px; color: #333; font-weight: 500; }
        .bar-bg { width: 100%; height: 5px; background: #e0e0e0; border-radius: 3px; overflow: hidden; }
        .bar-fill { height: 100%; background: var(--theme-color); border-radius: 3px; }

        /* TIMELINE (EXPERIENCE & EDUCATION) */
        .timeline-row { display: flex; gap: 12px; margin-bottom: 12px; break-inside: avoid; }
        .timeline-year { width: 45px; flex-shrink: 0; font-family: "Montserrat", sans-serif; font-weight: 700; font-size: 9.5px; color: #111; margin-top: 1px; }
        
        .timeline-content { flex: 1; }
        .timeline-title { font-family: "Montserrat", sans-serif; font-weight: 700; font-size: 10px; color: #111; margin-bottom: 1px; }
        .timeline-subtitle { font-size: 9px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
        
        .timeline-bullets { list-style-type: disc; padding-left: 14px; margin-top: 3px; }
        .timeline-bullets li { font-size: 9px; line-height: 1.5; color: var(--text-main); margin-bottom: 3px; }

        /* REFERENCES */
        .ref-block { margin-bottom: 10px; }
        .ref-title { font-family: "Montserrat", sans-serif; font-weight: 700; font-size: 10px; color: #111; margin-bottom: 1px; }
        .ref-sub { font-size: 9px; font-weight: 600; color: #666; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
        .ref-contact { font-size: 9px; color: var(--text-main); }

        /* RESPONSIVE & PRINT */
        @@media (max-width: 1200px) {
            .resume-toolbar, .theme-switcher { width: 100%; padding: 0 15px; }
            .resume-sheet { transform: scale(0.85); transform-origin: top center; margin-bottom: -30mm; }
        }
        @@media (max-width: 992px) {
            .resume-sheet { transform: scale(0.65); margin-bottom: -70mm; }
        }
        @@media print {
            html, body { width: 297mm; height: 210mm; background: white; }
            .resume-toolbar, .theme-switcher { display: none !important; }
            .resume-page-wrapper { padding: 0; }
            .resume-sheet { width: 297mm; height: 210mm; margin: 0; box-shadow: none; transform: none; }
            @@page { size: A4 landscape; margin: 0; }
        }
    </style>
</head>

<body>

    <div class="resume-toolbar">
        <a asp-controller="Candidate" asp-action="Profile" class="btn-edit">
            <i class="fa fa-pen"></i> Edit
        </a>
        <button type="button" class="btn-print" onclick="window.print()">
            <i class="fa fa-print"></i> Print / PDF
        </button>
        <button type="button" class="btn-download" onclick="downloadResumePDF()">
            <i class="fa fa-download"></i> Download
        </button>
    </div>

    <div class="theme-switcher">
        <span>Theme</span>
        <div class="theme-swatch active" data-theme="brown" style="background:#a27b74;--swatch:#a27b74" title="Brown"></div>
        <div class="theme-swatch" data-theme="navy" style="background:#3b5060;--swatch:#3b5060" title="Navy"></div>
        <div class="theme-swatch" data-theme="teal" style="background:#336e6c;--swatch:#336e6c" title="Teal"></div>
        <div class="theme-swatch" data-theme="olive" style="background:#636e59;--swatch:#636e59" title="Olive"></div>
        <div class="theme-swatch" data-theme="blue" style="background:#3f6888;--swatch:#3f6888" title="Blue"></div>
    </div>

    <div class="resume-page-wrapper">
        <div class="resume-sheet" id="resumeSheet" data-theme="brown">

            <!-- ================= LEFT COLUMN ================= -->
            <div class="col-left">
                
                <!-- UP-FLUSH PHOTO: Spans full width of left column -->
                <div class="edge-photo-container">
                    @if (Has(p.sPhoto))
                    {
                        <img src="@Url.Content(p.sPhoto)" class="edge-photo" alt="" onerror="this.style.display='none'; document.getElementById('fallbackIcon').style.display='flex';" />
                        <div class="photo-placeholder" id="fallbackIcon" style="display:none;"><i class="fa fa-user"></i></div>
                    }
                    else
                    {
                        <div class="photo-placeholder"><i class="fa fa-user"></i></div>
                    }
                </div>

                <!-- Text content wrapper (padded) -->
                <div class="left-content">
                    <div class="name">
                        @{
                            var nameParts = candidateName?.Split(' ') ?? new string[0];
                            if (nameParts.Length > 1) {
                                @Html.Raw(nameParts[0] + "<br/>" + string.Join(" ", nameParts.Skip(1)))
                            } else {
                                @candidateName
                            }
                        }
                    </div>
                    
                    @if (Has(candidateRole)) { <div class="role">@candidateRole</div> }

                    <div class="left-divider"></div>

                    <div class="contact-list">
                        @if (Has(Model.CandidateEmail)) { 
                            <div class="contact-item">
                                <div class="icon-circle"><i class="fa fa-envelope"></i></div>
                                <div>@Model.CandidateEmail</div>
                            </div> 
                        }
                        @if (Has(Model.CandidatePhone)) { 
                            <div class="contact-item">
                                <div class="icon-circle"><i class="fa fa-phone"></i></div>
                                <div>@Model.CandidatePhone</div>
                            </div> 
                        }
                        @if (Has(p.Pincode)) { 
                            <div class="contact-item">
                                <div class="icon-circle"><i class="fa fa-map-marker-alt"></i></div>
                                <div id="rvAddressLeft" data-country-id="@p.CountryID" data-state-id="@p.StateID" data-city-id="@p.CityID" data-pincode="@p.Pincode">
                                    @p.Pincode
                                </div>
                            </div> 
                        }
                        @if (Has(p.Linkedin)) { 
                            <div class="contact-item">
                                <div class="icon-circle"><i class="fa-brands fa-linkedin-in"></i></div>
                                <div>@p.Linkedin</div>
                            </div> 
                        }
                        @if (Has(p.GitHub)) { 
                            <div class="contact-item">
                                <div class="icon-circle"><i class="fa-brands fa-github"></i></div>
                                <div>@p.GitHub</div>
                            </div> 
                        }
                    </div>
                </div>
            </div>

            <!-- ================= MIDDLE COLUMN ================= -->
            <div class="col-mid">
                
                <!-- ABOUT ME -->
                @if (Has(p.Objective))
                {
                    <div>
                        <div class="section-header">About Me</div>
                        <div class="body-text">@p.Objective</div>
                    </div>
                }

                <!-- EXPERIENCE -->
                @{
                    var internships = new[]
                    {
                        new { Name = p.sOrgName1, Title = p.sOrgIntTitle1, Duration = p.sOrgIntDuration1, Status = p.sOrgIntStatus1 },
                        new { Name = p.sOrgName2, Title = p.sOrgIntTitle2, Duration = p.sOrgIntDuration2, Status = p.sOrgIntStatus2 },
                        new { Name = p.sOrgName3, Title = p.sOrgIntTitle3, Duration = p.sOrgIntDuration3, Status = p.sOrgIntStatus3 },
                        new { Name = p.sOrgName4, Title = p.sOrgIntTitle4, Duration = p.sOrgIntDuration4, Status = p.sOrgIntStatus4 }
                    }.Where(x => Has(x.Name)).ToList();
                }

                @if (internships.Any())
                {
                    <div>
                        <div class="section-header">Experience</div>
                        @foreach (var exp in internships)
                        {
                            <div class="timeline-row">
                                <div class="timeline-year">@(Has(GetLookupName(Model.InternshipDurations, exp.Duration)) ? GetLookupName(Model.InternshipDurations, exp.Duration) : "202X")</div>
                                <div class="timeline-content">
                                    <div class="timeline-title">@(Has(GetLookupName(Model.InternshipTitles, exp.Title)) ? GetLookupName(Model.InternshipTitles, exp.Title) : "Role")</div>
                                    <div class="timeline-subtitle">@exp.Name</div>
                                    @if (Has(GetLookupName(Model.InternshipStatuses, exp.Status)))
                                    {
                                        <ul class="timeline-bullets">
                                            <li>Successfully executed duties matching standard organizational guidelines.</li>
                                            <li>Current Status: @GetLookupName(Model.InternshipStatuses, exp.Status)</li>
                                        </ul>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- SKILLS WITH PROGRESS BARS -->
                @{
                    var langItems = new List<(string Lang, int Rating)>();
                    for (int i = 1; i <= 8; i++)
                    {
                        var lang = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguage{i}")?.GetValue(p)?.ToString();
                        var starVal = typeof(ErJobPortal.Models.CandidateProfileModel).GetProperty($"sLanguageStar{i}")?.GetValue(p);
                        
                        if (Has(lang)) { 
                            int rating = 3; // default
                            if (starVal != null && int.TryParse(starVal.ToString(), out int parsed)) rating = parsed;
                            langItems.Add((lang, rating)); 
                        }
                    }

                    var techSkillsStr = p.sTechnicalSkillIDs;
                    var techSkills = Has(techSkillsStr) ? techSkillsStr.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries).ToList() : new List<string>();
                }

                @if (langItems.Any() || techSkills.Any())
                {
                    <div>
                        <div class="section-header">Skills</div>
                        
                        @foreach (var ts in techSkills.Take(6))
                        {
                            <div class="skill-row">
                                <div class="skill-name">@ts.Trim()</div>
                                <div class="bar-bg"><div class="bar-fill" style="width: 85%;"></div></div>
                            </div>
                        }

                        @foreach (var l in langItems.Take(4))
                        {
                            <div class="skill-row">
                                <div class="skill-name">@l.Lang</div>
                                <div class="bar-bg"><div class="bar-fill" style="width: @(l.Rating * 20)%;"></div></div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- ================= RIGHT COLUMN ================= -->
            <div class="col-right">
                
                <!-- EDUCATION -->
                @if (HasNum(p.PG_Year) || HasNum(p.Graduation_Year) || HasNum(p.HSC_DIPLOMA_YEAR) || HasNum(p.SSC_YEAR))
                {
                    <div>
                        <div class="section-header">Education</div>
                        
                        @if (HasNum(p.PG_Year)) {
                            <div class="timeline-row">
                                <div class="timeline-year">@p.PG_Year</div>
                                <div class="timeline-content">
                                    <div class="timeline-title">@GetLookupName(Model.Streams, p.PG_Stream)</div>
                                    <div class="timeline-subtitle">Post Graduation</div>
                                    <ul class="timeline-bullets">
                                        <li>Division: @GetLookupName(Model.Divisions, p.PG_Division)</li>
                                        @if(Has(p.Other_Specialization)) { <li>Specialization: @p.Other_Specialization</li> }
                                    </ul>
                                </div>
                            </div>
                        }
                        @if (HasNum(p.Graduation_Year)) {
                            <div class="timeline-row">
                                <div class="timeline-year">@p.Graduation_Year</div>
                                <div class="timeline-content">
                                    <div class="timeline-title">@GetLookupName(Model.Streams, p.Graduation_Stream)</div>
                                    <div class="timeline-subtitle">Graduation</div>
                                    <ul class="timeline-bullets">
                                        <li>Division: @GetLookupName(Model.Divisions, p.Graduation_Division)</li>
                                    </ul>
                                </div>
                            </div>
                        }
                        @if (HasNum(p.HSC_DIPLOMA_YEAR)) {
                            <div class="timeline-row">
                                <div class="timeline-year">@p.HSC_DIPLOMA_YEAR</div>
                                <div class="timeline-content">
                                    <div class="timeline-title">HSC / Diploma</div>
                                    <div class="timeline-subtitle">Higher Secondary</div>
                                    <ul class="timeline-bullets">
                                        <li>Division: @GetLookupName(Model.Divisions, p.HSC_DIPLOMA_DIVISION)</li>
                                    </ul>
                                </div>
                            </div>
                        }
                        @if (HasNum(p.SSC_YEAR)) {
                            <div class="timeline-row">
                                <div class="timeline-year">@p.SSC_YEAR</div>
                                <div class="timeline-content">
                                    <div class="timeline-title">SSC / 10th</div>
                                    <div class="timeline-subtitle">Secondary</div>
                                </div>
                            </div>
                        }
                    </div>
                }

                <!-- ACHIEVEMENTS -->
                @{
                    var achievements = new[] { p.Achievements_Certification1, p.Achievements_Certification2, p.Achievements_Certification3 }.Where(Has).ToList();
                }
                @if (achievements.Any())
                {
                    <div>
                        <div class="section-header">Achievements</div>
                        <ul class="timeline-bullets">
                            @foreach (var a in achievements)
                            {
                                <li>@a</li>
                            }
                        </ul>
                    </div>
                }

                <!-- HOBBIES & INTERESTS -->
                @if (Has(p.sHobbies))
                {
                    <div>
                        <div class="section-header">Hobbies & Interests</div>
                        <div class="body-text" style="white-space: pre-wrap;">@p.sHobbies</div>
                    </div>
                }

                <!-- REFERENCES -->
                @if (Has(p.sRefName1) || Has(p.sRefName2))
                {
                    <div>
                        <div class="section-header">References</div>
                        @if (Has(p.sRefName1)) {
                            <div class="ref-block">
                                <div class="ref-title">@p.sRefName1</div>
                                <div class="ref-sub">@(Has(GetLookupName(Model.Relationships, p.sRefRelationName1)) ? GetLookupName(Model.Relationships, p.sRefRelationName1) : "Reference")</div>
                                @if(Has(p.sMobile1)) { <div class="ref-contact"><i class="fa fa-phone" style="color: var(--theme-color);"></i> @p.sMobile1</div> }
                            </div>
                        }
                        
                        @if (Has(p.sRefName2)) {
                            <div class="ref-block">
                                <div class="ref-title">@p.sRefName2</div>
                                <div class="ref-sub">@(Has(GetLookupName(Model.Relationships, p.sRefRelationName2)) ? GetLookupName(Model.Relationships, p.sRefRelationName2) : "Reference")</div>
                                @if(Has(p.sMobile2)) { <div class="ref-contact"><i class="fa fa-phone" style="color: var(--theme-color);"></i> @p.sMobile2</div> }
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sheet = document.getElementById("resumeSheet");
            const swatches = document.querySelectorAll(".theme-swatch");
            const savedTheme = localStorage.getItem("resumeThemeV12") || "brown";

            sheet.setAttribute("data-theme", savedTheme);

            swatches.forEach(function (swatch) {
                swatch.classList.toggle("active", swatch.dataset.theme === savedTheme);

                swatch.addEventListener("click", function () {
                    const theme = this.dataset.theme;
                    sheet.setAttribute("data-theme", theme);
                    
                    swatches.forEach(function (item) { item.classList.remove("active"); });
                    this.classList.add("active");
                    
                    localStorage.setItem("resumeThemeV12", theme);
                });
            });

            /* ADDRESS LOGIC */
            const addressElements = document.querySelectorAll("[data-country-id]");
            if (!addressElements.length) return;

            const firstAddress = addressElements[0];
            const countryID = firstAddress.getAttribute("data-country-id") || "";
            const stateID = firstAddress.getAttribute("data-state-id") || "";
            const cityID = firstAddress.getAttribute("data-city-id") || "";
            const pincode = firstAddress.getAttribute("data-pincode") || "";

            function renderAddress(cityName, stateName, countryName) {
                const parts = [cityName, stateName, countryName, pincode].filter(value => value && value.trim());
                const address = parts.join(", ");
                addressElements.forEach(function (element) { element.textContent = address; });
            }

            if (!countryID) { renderAddress("", "", ""); return; }

            fetch("/Location/GetCountries")
                .then(response => response.json())
                .then(countries => {
                    const country = countries.find(c => String(c.id) === String(countryID));
                    const countryName = country ? country.name : "";
                    const countryCode = country ? country.iso2 : countryID;

                    if (!stateID) { renderAddress("", "", countryName); return; }

                    return fetch("/Location/GetStates?countryCode=" + encodeURIComponent(countryCode))
                        .then(response => response.json())
                        .then(states => {
                            const state = states.find(s => String(s.id) === String(stateID));
                            const stateName = state ? state.name : "";
                            const stateCode = state ? (state.stateCode || String(state.id).split(":")[1]) : "";

                            if (!cityID) { renderAddress("", stateName, countryName); return; }

                            return fetch("/Location/GetCities?countryCode=" + encodeURIComponent(countryCode) + "&stateCode=" + encodeURIComponent(stateCode))
                                .then(response => response.json())
                                .then(cities => {
                                    const city = cities.find(c => String(c.id) === String(cityID));
                                    const cityName = city ? city.name : "";
                                    renderAddress(cityName, stateName, countryName);
                                });
                        });
                })
                .catch(error => console.log("Address resolution error:", error));
        });

        /* PDF LOGIC (Landscape) */
        async function downloadResumePDF() {
            const sheet = document.getElementById("resumeSheet");
            const button = document.querySelector(".btn-download");
            const original = button.innerHTML;

            try {
                button.disabled = true;
                button.innerHTML = '<i class="fa fa-spinner fa-spin"></i>';

                const images = sheet.querySelectorAll("img");
                await Promise.all(
                    Array.from(images).map(image =>
                        image.complete ? Promise.resolve() : new Promise(resolve => {
                            image.onload = resolve;
                            image.onerror = resolve;
                        })
                    )
                );

                const rect = sheet.getBoundingClientRect();
                const canvas = await html2canvas(sheet, {
                    scale: 2, useCORS: true, allowTaint: false, backgroundColor: "#ffffff",
                    logging: false, width: Math.round(rect.width), height: Math.round(rect.height)
                });

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({ orientation: "landscape", unit: "mm", format: "a4", compress: true });
                const imgData = canvas.toDataURL("image/jpeg", .95);
                pdf.addImage(imgData, "JPEG", 0, 0, 297, 210);
                pdf.save((window.candidateName || "Resume") + ".pdf");
            }
            catch (error) {
                console.error("PDF error:", error);
                alert("Error generating PDF");
            }
            finally {
                button.disabled = false;
                button.innerHTML = original;
            }
        }

        window.candidateName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(candidateName ?? "Resume"));
    </script>
</body>
</html>