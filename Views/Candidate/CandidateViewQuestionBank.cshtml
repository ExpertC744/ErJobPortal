@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "View Question Bank";
    ViewData["Panel"] = "Candidate";
}

<link rel="stylesheet" href="~/css/CandidateViewQuestionBank.css" asp-append-version="true" />

<div class="qbl-page">

    <div class="qbl-hero">
        <div>
            <div class="qbl-eyebrow">Candidate Panel</div>
            <h2><i class="fas fa-file-alt"></i> View Question Bank</h2>
            <p>Explore question papers and resources for placement preparation.</p>
        </div>
    </div>

    <div class="qbl-body">

        <div class="qbl-stats">
            <div class="qbl-stat qbl-stat-navy">
                <div class="qbl-stat-icon">
                    <i class="fas fa-layer-group"></i>
                </div>
                <div>
                    <span>Total Question Banks</span>
                    <h3 id="totalCount">6</h3>
                </div>
            </div>
        </div>

        <div class="qbl-filter-card">
            <div class="qbl-filter-title">
                <span class="qbl-filter-icon">
                    <i class="fas fa-filter"></i>
                </span>
                Search &amp; Filter
            </div>

            <div class="qbl-filters">

                <div class="qbl-field qbl-search-field">
                    <label for="searchText">Search</label>
                    <input type="text"
                           id="searchText"
                           placeholder="Search title, subject or topics..." />
                </div>

                <div class="qbl-field">
                    <label for="category">Category</label>
                    <select id="category">
                        <option value="">All Categories</option>
                        <option value="Interview Preparation">Interview Preparation</option>
                        <option value="Competitive Exams">Competitive Exams</option>
                        <option value="Academic Questions">Academic Questions</option>
                        <option value="Aptitude & Reasoning">Aptitude &amp; Reasoning</option>
                        <option value="Technical Skills">Technical Skills</option>
                        <option value="Placement Preparation">Placement Preparation</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="qbl-field">
                    <label for="streamDomain">Stream / Domain</label>
                    <select id="streamDomain">
                        <option value="">All Streams</option>
                        <option value="Engineering">Engineering</option>
                        <option value="IT & Computer Science">IT &amp; Computer Science</option>
                        <option value="Commerce & Finance">Commerce &amp; Finance</option>
                        <option value="Management">Management</option>
                        <option value="Science">Science</option>
                        <option value="Medical & Healthcare">Medical &amp; Healthcare</option>
                        <option value="Arts & Humanities">Arts &amp; Humanities</option>
                        <option value="Law">Law</option>
                        <option value="Polytechnic / ITI">Polytechnic / ITI</option>
                        <option value="Hospitality">Hospitality</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div>
                    <button type="button" class="qbl-filter-btn" onclick="filterQuestions()">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>

            </div>

            <button type="button" class="qbl-reset-btn" onclick="clearFilters()">
                <i class="fas fa-undo"></i> Clear Filters
            </button>
        </div>

        <div class="qbl-list-header">
            <h3>Question Banks</h3>
            <span class="qbl-count" id="recordCount">6 records</span>
        </div>

        <div class="qbl-table-wrap">
            <table class="qbl-table">
                <thead>
                    <tr>
                        <th>Question Bank</th>
                        <th>Category</th>
                        <th>Stream / Domain</th>
                        <th>Send Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="questionTableBody">

                    <tr class="question-row"
                        data-category="Technical Skills"
                        data-stream="IT & Computer Science">
                        <td>
                            <div class="qbl-title">C Programming Question Bank</div>
                            <div class="qbl-subtitle">Subject: Programming</div>
                            <div class="qbl-subtitle">Topics: Loops, Arrays, Functions, Pointers</div>
                        </td>
                        <td>Technical Skills</td>
                        <td>IT &amp; Computer Science</td>
                        <td>15 Oct 2026</td>
                        <td>
                            <div class="qbl-actions">
                                <button type="button" class="qbl-action" title="View question paper"
                                        onclick="showMessage('C Programming Question Bank')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="qbl-action" title="Download question paper"
                                        onclick="showMessage('C Programming Question Bank')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="question-row"
                        data-category="Aptitude & Reasoning"
                        data-stream="Engineering">
                        <td>
                            <div class="qbl-title">Aptitude Practice Set</div>
                            <div class="qbl-subtitle">Subject: Quantitative Aptitude</div>
                            <div class="qbl-subtitle">Topics: Percentages, Profit &amp; Loss, Ratios</div>
                        </td>
                        <td>Aptitude &amp; Reasoning</td>
                        <td>Engineering</td>
                        <td>12 Oct 2026</td>
                        <td>
                            <div class="qbl-actions">
                                <button type="button" class="qbl-action" title="View question paper"
                                        onclick="showMessage('Aptitude Practice Set')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="qbl-action" title="Download question paper"
                                        onclick="showMessage('Aptitude Practice Set')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="question-row"
                        data-category="Interview Preparation"
                        data-stream="IT & Computer Science">
                        <td>
                            <div class="qbl-title">HR Interview Questions</div>
                            <div class="qbl-subtitle">Subject: Interview Preparation</div>
                            <div class="qbl-subtitle">Topics: Self Introduction, Strengths, Career Goals</div>
                        </td>
                        <td>Interview Preparation</td>
                        <td>IT &amp; Computer Science</td>
                        <td>10 Oct 2026</td>
                        <td>
                            <div class="qbl-actions">
                                <button type="button" class="qbl-action" title="View question paper"
                                        onclick="showMessage('HR Interview Questions')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="qbl-action" title="Download question paper"
                                        onclick="showMessage('HR Interview Questions')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="question-row"
                        data-category="Competitive Exams"
                        data-stream="Engineering">
                        <td>
                            <div class="qbl-title">Reasoning Practice Set</div>
                            <div class="qbl-subtitle">Subject: Logical Reasoning</div>
                            <div class="qbl-subtitle">Topics: Series, Directions, Coding-Decoding</div>
                        </td>
                        <td>Competitive Exams</td>
                        <td>Engineering</td>
                        <td>08 Oct 2026</td>
                        <td>
                            <div class="qbl-actions">
                                <button type="button" class="qbl-action" title="View question paper"
                                        onclick="showMessage('Reasoning Practice Set')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="qbl-action" title="Download question paper"
                                        onclick="showMessage('Reasoning Practice Set')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="question-row"
                        data-category="Academic Questions"
                        data-stream="Science">
                        <td>
                            <div class="qbl-title">Database Management System</div>
                            <div class="qbl-subtitle">Subject: DBMS</div>
                            <div class="qbl-subtitle">Topics: SQL, Normalization, Keys, Joins</div>
                        </td>
                        <td>Academic Questions</td>
                        <td>Science</td>
                        <td>05 Oct 2026</td>
                        <td>
                            <div class="qbl-actions">
                                <button type="button" class="qbl-action" title="View question paper"
                                        onclick="showMessage('Database Management System')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="qbl-action" title="Download question paper"
                                        onclick="showMessage('Database Management System')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr class="question-row"
                        data-category="Placement Preparation"
                        data-stream="Management">
                        <td>
                            <div class="qbl-title">Placement Preparation Set</div>
                            <div class="qbl-subtitle">Subject: Placement Training</div>
                            <div class="qbl-subtitle">Topics: Aptitude, Reasoning, Verbal Ability</div>
                        </td>
                        <td>Placement Preparation</td>
                        <td>Management</td>
                        <td>01 Oct 2026</td>
                        <td>
                            <div class="qbl-actions">
                                <button type="button" class="qbl-action" title="View question paper"
                                        onclick="showMessage('Placement Preparation Set')">
                                    <i class="fas fa-eye"></i>
                                </button>
                                <button type="button" class="qbl-action" title="Download question paper"
                                        onclick="showMessage('Placement Preparation Set')">
                                    <i class="fas fa-download"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <tr id="noResults" style="display:none;">
                        <td colspan="5">
                            <div class="qbl-empty">
                                <i class="fas fa-folder-open"></i>
                                <h4>No question banks found</h4>
                                <p>Try changing your search text or filters.</p>
                            </div>
                        </td>
                    </tr>

                </tbody>
            </table>
        </div>

    </div>
</div>

<script>
    function filterQuestions() {
        const search = document.getElementById("searchText").value.trim().toLowerCase();
        const category = document.getElementById("category").value;
        const stream = document.getElementById("streamDomain").value;

        const rows = document.querySelectorAll(".question-row");
        let visibleCount = 0;

        rows.forEach(function (row) {
            const rowText = row.innerText.toLowerCase();
            const rowCategory = row.dataset.category;
            const rowStream = row.dataset.stream;

            const matchesSearch = rowText.includes(search);
            const matchesCategory = category === "" || rowCategory === category;
            const matchesStream = stream === "" || rowStream === stream;

            const show = matchesSearch && matchesCategory && matchesStream;
            row.style.display = show ? "" : "none";

            if (show) visibleCount++;
        });

        document.getElementById("noResults").style.display =
            visibleCount === 0 ? "" : "none";

        document.getElementById("recordCount").textContent =
            visibleCount + (visibleCount === 1 ? " record" : " records");
    }

    function clearFilters() {
        document.getElementById("searchText").value = "";
        document.getElementById("category").value = "";
        document.getElementById("streamDomain").value = "";
        filterQuestions();
    }

    function showMessage(title) {
        alert(title + "\\n\\nThis is a static demo. View and download functionality is not connected to actual files.");
    }

    document.getElementById("searchText").addEventListener("input", filterQuestions);
    document.getElementById("category").addEventListener("change", filterQuestions);
    document.getElementById("streamDomain").addEventListener("change", filterQuestions);
</script>
