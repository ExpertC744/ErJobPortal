<link rel="stylesheet" href="~/css/Charts.css" asp-append-version="true" />



@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Charts";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}



<div class="candidate-charts-page">
      <!-- PAGE HEADING -->
    <div class="charts-heading">
        <h1>Charts</h1>
        <p>HN236383503368076</p>
    </div>
    <div class="charts-grid">

      <!-- =====================================================
     MONTHLY ANALYTICS @* Radhika29-09 *@
===================================================== -->

<div class="row">

    <!-- Suitable Openings -->
    <div class="col-lg-6 mb-4">

        <div class="analytics-card">

            <!-- Header -->
            <div class="analytics-header">

                <div class="analytics-header-icon">
                    <i class="fas fa-chart-line"></i>
                </div>

                <h5>No. of suitable openings</h5>

            </div>

            <!-- Chart -->
            <div class="analytics-body">

                <div class="chart-legend">
                    <span class="legend-box"></span>
                    <span>No. of openings</span>
                </div>

                <div class="chart-wrapper">

                    <svg id="suitableOpeningsChart"
                         viewBox="0 0 700 240"
                         preserveAspectRatio="none"
                         aria-label="Suitable openings monthly chart">
                    </svg>

                </div>

            </div>

            <div class="analytics-footer">
                <i class="fas fa-chart-line"></i>
                Monthly suitable-opening trend
            </div>

        </div>

    </div>


    <!-- Internship Posts -->
    <div class="col-lg-6 mb-4">

        <div class="analytics-card">

            <!-- Header -->
            <div class="analytics-header">

                <div class="analytics-header-icon">
                    <i class="fas fa-chart-bar"></i>
                </div>

                <h5>Internship post from organization</h5>

            </div>

            <!-- Chart -->
            <div class="analytics-body">

                <div class="chart-legend">
                    <span class="legend-box-bar"></span>
                    <span>No. of posts</span>
                </div>

                <div class="chart-wrapper">

                    <svg id="internshipPostsChart"
                         viewBox="0 0 700 240"
                         preserveAspectRatio="none"
                         aria-label="Internship posts monthly chart">
                    </svg>

                </div>

            </div>

            <div class="analytics-footer">
                <i class="fas fa-building"></i>
                Monthly organization internship trend
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     CHART.JS @* Radhika29-09 *@
========================================================= -->
 
<script>

    /* =====================================================
       1TRAINEE CHART CONFIGURATION 
    ===================================================== */

    const chartMonths = [
        "Jan", "Feb", "Mar", "Apr",
        "May", "Jun", "Jul", "Aug",
        "Sep", "Oct", "Nov", "Dec"
    ];


    /* =====================================================
       LINE / AREA CHART
    ===================================================== */

    function drawLineChart(svgId, values) {

        const svg = document.getElementById(svgId);

        if (!svg || !values || !values.length)
            return;

        const width = 700;
        const height = 240;

        const left = 48;
        const right = 12;
        const top = 25;
        const bottom = 38;

        const chartWidth = width - left - right;
        const chartHeight = height - top - bottom;

        const maxValue = Math.max(...values, 1);

        const yStep = maxValue <= 10
            ? 2
            : Math.ceil(maxValue / 4);

        const maxY = Math.max(
            yStep * 4,
            Math.ceil(maxValue / yStep) * yStep
        );

        let html = "";


        /* =================================================
           HORIZONTAL GRID + Y AXIS
        ================================================= */

        for (let i = 0; i <= 4; i++) {

            const value = maxY - (i * maxY / 4);

            const y =
                top + (i * chartHeight / 4);

            html += `
                <line
                    x1="${left}"
                    y1="${y}"
                    x2="${width - right}"
                    y2="${y}"
                    class="chart-grid" />

                <text
                    x="${left - 10}"
                    y="${y + 4}"
                    text-anchor="end"
                    class="chart-axis-text">
                    ${Math.round(value)}
                </text>
            `;
        }


        /* =================================================
           VERTICAL GRID
        ================================================= */

        chartMonths.forEach((month, index) => {

            const x =
                left +
                (index * chartWidth / 11);

            html += `
                <line
                    x1="${x}"
                    y1="${top}"
                    x2="${x}"
                    y2="${height - bottom}"
                    class="chart-grid" />
            `;

            html += `
                <text
                    x="${x}"
                    y="${height - 13}"
                    text-anchor="middle"
                    class="chart-axis-text">
                    ${month}
                </text>
            `;
        });


        /* =================================================
           AXIS
        ================================================= */

        html += `
            <line
                x1="${left}"
                y1="${height - bottom}"
                x2="${width - right}"
                y2="${height - bottom}"
                class="chart-axis" />

            <line
                x1="${left}"
                y1="${top}"
                x2="${left}"
                y2="${height - bottom}"
                class="chart-axis" />
        `;


        /* =================================================
           POINTS
        ================================================= */

        const points = values.map((value, index) => {

            const x =
                left +
                (index * chartWidth / 11);

            const y =
                top +
                chartHeight -
                ((value / maxY) * chartHeight);

            return {
                x: x,
                y: y,
                value: value
            };
        });


        const pointString = points
            .map(p => `${p.x},${p.y}`)
            .join(" ");


        /* =================================================
           AREA
        ================================================= */

        const areaPoints =
            `${left},${height - bottom} ` +
            pointString +
            ` ${width - right},${height - bottom}`;


        html += `
            <polygon
                points="${areaPoints}"
                class="chart-area" />
        `;


        /* =================================================
           LINE
        ================================================= */

        html += `
            <polyline
                points="${pointString}"
                class="chart-line" />
        `;


        /* =================================================
           POINTS
        ================================================= */

        points.forEach(point => {

            html += `
                <circle
                    cx="${point.x}"
                    cy="${point.y}"
                    r="3.5"
                    class="chart-point">
                </circle>
            `;

        });


        svg.innerHTML = html;
    }


    /* =====================================================
       BAR CHART
    ===================================================== */

    function drawBarChart(svgId, values) {

        const svg = document.getElementById(svgId);

        if (!svg || !values || !values.length)
            return;

        const width = 700;
        const height = 240;

        const left = 48;
        const right = 12;
        const top = 25;
        const bottom = 38;

        const chartWidth = width - left - right;
        const chartHeight = height - top - bottom;

        const maxValue = Math.max(...values, 1);

        const maxY =
            Math.ceil(maxValue / 10) * 10 ||
            10;

        const barSpace =
            chartWidth / values.length;

        const barWidth =
            barSpace * 0.58;

        let html = "";


        /* =================================================
           Y AXIS + GRID
        ================================================= */

        for (let i = 0; i <= 4; i++) {

            const value =
                maxY - (i * maxY / 4);

            const y =
                top + (i * chartHeight / 4);

            html += `
                <line
                    x1="${left}"
                    y1="${y}"
                    x2="${width - right}"
                    y2="${y}"
                    class="chart-grid" />

                <text
                    x="${left - 10}"
                    y="${y + 4}"
                    text-anchor="end"
                    class="chart-axis-text">
                    ${Math.round(value)}
                </text>
            `;
        }


        /* =================================================
           VERTICAL GRID + MONTHS
        ================================================= */

        chartMonths.forEach((month, index) => {

            const centerX =
                left +
                (index * barSpace) +
                (barSpace / 2);

            html += `
                <line
                    x1="${centerX}"
                    y1="${top}"
                    x2="${centerX}"
                    y2="${height - bottom}"
                    class="chart-grid" />

                <text
                    x="${centerX}"
                    y="${height - 13}"
                    text-anchor="middle"
                    class="chart-axis-text">
                    ${month}
                </text>
            `;
        });


        /* =================================================
           AXIS
        ================================================= */

        html += `
            <line
                x1="${left}"
                y1="${height - bottom}"
                x2="${width - right}"
                y2="${height - bottom}"
                class="chart-axis" />

            <line
                x1="${left}"
                y1="${top}"
                x2="${left}"
                y2="${height - bottom}"
                class="chart-axis" />
        `;


        /* =================================================
           BARS
        ================================================= */

        values.forEach((value, index) => {

            const centerX =
                left +
                (index * barSpace) +
                (barSpace / 2);

            const barHeight =
                (value / maxY) * chartHeight;

            const x =
                centerX -
                (barWidth / 2);

            const y =
                height -
                bottom -
                barHeight;


            html += `
                <rect
                    x="${x}"
                    y="${y}"
                    width="${barWidth}"
                    height="${barHeight}"
                    rx="1"
                    class="chart-bar">

                    <title>
                        ${chartMonths[index]}: ${value} posts
                    </title>

                </rect>
            `;
        });


        svg.innerHTML = html;
    }


    /* =====================================================
       DATA
    ===================================================== */

    const suitableOpeningsMonthly = [
        3, 5, 4, 7, 8, 6,
        9, 11, 10, 13, 12, 15
    ];


    const internshipPostsMonthly = [
        4, 7, 5, 9, 12, 10,
        15, 18, 14, 20, 17, 23
    ];


    /* =====================================================
       DRAW
    ===================================================== */

    drawLineChart(
        "suitableOpeningsChart",
        suitableOpeningsMonthly
    );

    drawBarChart(
        "internshipPostsChart",
        internshipPostsMonthly
    );

</script>

