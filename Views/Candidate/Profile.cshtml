            @{
                // Parses "HTML,CSS" (and old "HTML:4,CSS:3" values, ignoring the rating) into a set of skill names
                HashSet<string> ParseSkills(string raw)
                {
                    return (raw ?? "")
                        .Split(',', StringSplitOptions.RemoveEmptyEntries)
                        .Select(p => p.Split(':')[0].Trim())
                        .Where(n => n != "")
                        .ToHashSet(StringComparer.OrdinalIgnoreCase);
                }

                var skillGroups = new[]
                {
                    new {
                        Title = "Medical Skills", CountId = "medicalCount", BodyId = "medicalSkills",
                        Css = "medical-skill", Open = true,
                        Selected = ParseSkills(Model.Profile?.sMedicalSkillIDs),
                        Skills = new[] { "3D Slicer", "B.Pharm", "Auditory", "Clinical Research",
                                         "Anatomy", "Biochemistry", "Pharmacology", "Medical Coding" }
                    },
                    new {
                        Title = "Technical Skills", CountId = "technicalCount", BodyId = "technicalSkills",
                        Css = "technical-skill", Open = false,
                        Selected = ParseSkills(Model.Profile?.sTechnicalSkillIDs),
                        Skills = new[] { "HTML", "CSS", "JavaScript", "React.js", "Angular", "ASP.NET",
                                         "C#", "Java", "Python", "SQL", "Git", "Bootstrap" }
                    },
                    new {
                        Title = "Non Technical Skills", CountId = "nonTechnicalCount", BodyId = "nonTechnicalSkills",
                        Css = "nontechnical-skill", Open = false,
                        Selected = ParseSkills(Model.Profile?.sNonTechnicalSkillIDs),
                        Skills = new[] { "Communication", "Teamwork", "Leadership", "Problem Solving",
                                         "Time Management", "Presentation", "Adaptability", "Creativity" }
                    }
                };
            }

            <div class="card mb-4 profile-section-card" id="section-skills">

                <div class="card-header">
                    <h5 class="mb-0">Skills</h5>
                </div>

                <div class="card-body">

