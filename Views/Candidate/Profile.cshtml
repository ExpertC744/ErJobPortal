    <script>

        $(document).ready(function () {

            /* =====================================================
               OPEN OBJECTIVE DRAFT
            ===================================================== */

            $('#btnObjectiveDraft').on('click', function () {

                // -------------------------------------------------
                // GET SELECTED GENDER
                // -------------------------------------------------

                const genderID = $('#ObjectiveGender').val();

                if (!genderID) {

                    alert('Please select Gender first.');

                    $('#ObjectiveGender').focus();

                    return;
                }


                // -------------------------------------------------
                // RESET DRAFT MODAL
                // -------------------------------------------------

                $('#objectiveDraftLoading').removeClass('d-none');

                $('#objectiveDraftMessage')
                    .addClass('d-none')
                    .removeClass('alert-danger')
                    .addClass('alert-info')
                    .text('');

                $('#objectiveDraftTableContainer')
                    .addClass('d-none');

                $('#objectiveDraftTableBody').empty();


                // -------------------------------------------------
                // OPEN BOOTSTRAP MODAL
                // -------------------------------------------------

                const modalElement =
                    document.getElementById('objectiveDraftModal');

                const modal =
                    new bootstrap.Modal(modalElement);

                modal.show();


                /* =================================================
                   GET OBJECTIVES BY GENDER
                ================================================= */

                $.ajax({

                    url: '@Url.Action("GetCareerObjectives", "Candidate")',

                    type: 'GET',

                    data: {
                        genderID: genderID
                    },

                    cache: false,

                    success: function (response) {

                        $('#objectiveDraftLoading')
                            .addClass('d-none');


                        // -------------------------------------------------
                        // ERROR / NO RESPONSE
                        // -------------------------------------------------

                        if (!response ||
                            !response.success) {

                            $('#objectiveDraftMessage')
                                .removeClass('d-none')
                                .removeClass('alert-info')
                                .addClass('alert-danger')
                                .text(
                                    response &&
                                    response.message
                                        ? response.message
                                        : 'Unable to load career objective drafts.'
                                );

                            return;
                        }


                        // -------------------------------------------------
                        // NO OBJECTIVES
                        // -------------------------------------------------

                        if (!response.objectives ||
                            response.objectives.length === 0) {

                            $('#objectiveDraftMessage')
                                .removeClass('d-none')
                                .removeClass('alert-danger')
                                .addClass('alert-info')
                                .text(
                                    'No career objective drafts are available for the selected gender.'
                                );

                            return;
                        }


                        // -------------------------------------------------
                        // BUILD TABLE
                        // -------------------------------------------------

                        let html = '';

                        $.each(
                            response.objectives,
                            function (index, item) {

                                const srNo = index + 1;

                                html += `
                                    <tr class="objective-draft-row"
                                        data-objective="${escapeAttribute(item.sObjective)}">

                                        <td class="objective-draft-number text-center">
                                            ${srNo}
                                        </td>

                                        <td class="objective-draft-text">
                                            ${escapeHtml(item.sObjective)}
                                        </td>

                                    </tr>
                                `;

                            }
                        );


                        // -------------------------------------------------
                        // SHOW TABLE
                        // -------------------------------------------------

                        $('#objectiveDraftTableBody')
                            .html(html);

                        $('#objectiveDraftTableContainer')
                            .removeClass('d-none');

                    },


                    /* =================================================
                       AJAX ERROR
                    ================================================= */

                    error: function (xhr) {

                        $('#objectiveDraftLoading')
                            .addClass('d-none');

                        console.log(xhr.responseText);

                        $('#objectiveDraftMessage')
                            .removeClass('d-none')
                            .removeClass('alert-info')
                            .addClass('alert-danger')
                            .text(
                                'Unable to load career objective drafts.'
                            );

                    }

                });

            });


            /* =====================================================
               SELECT OBJECTIVE
            ===================================================== */

            $(document).on(
                'click',
                '.objective-draft-row',
                function () {

                    const objective =
                        $(this).attr('data-objective');


                    // -------------------------------------------------
                    // PUT OBJECTIVE INTO TEXTAREA
                    // -------------------------------------------------

                    $('#CareerObjective')
                        .val(objective)
                        .trigger('input');


                    // -------------------------------------------------
                    // CLOSE MODAL
                    // -------------------------------------------------

                    const modalElement =
                        document.getElementById(
                            'objectiveDraftModal'
                        );

                    const modal =
                        bootstrap.Modal.getInstance(
                            modalElement
                        );

                    if (modal) {

                        modal.hide();

                    }


                    // -------------------------------------------------
                    // FOCUS TEXTAREA
                    // -------------------------------------------------

                    $('#CareerObjective').focus();

                }
            );


            /* =====================================================
               HTML ESCAPE
            ===================================================== */

            function escapeHtml(value) {

                if (value === null ||
                    value === undefined) {

                    return '';

                }

                return $('<div>')
                    .text(value)
                    .html();

            }


            /* =====================================================
               ATTRIBUTE ESCAPE
            ===================================================== */

            function escapeAttribute(value) {

                if (value === null ||
                    value === undefined) {

                    return '';

                }

                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');

            }


            /* =====================================================
               CAREER OBJECTIVE VALIDATION
            ===================================================== */

            $('#objectiveForm').on('submit', function (e) {

                const objective =
                    $('#CareerObjective')
                        .val()
                        .trim();


                if (objective.length < 20) {

                    e.preventDefault();

                    alert(
                        'Career Objective must contain at least 20 characters.'
                    );

                    $('#CareerObjective').focus();

                    return false;

                }

            });

        });

    </script>
