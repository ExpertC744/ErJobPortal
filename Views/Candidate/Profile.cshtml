                               placeholder="Example: 1,3,6,7" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Medical Skill Star IDs</label>

                        <input asp-for="Profile.sMedicalSkillStarIDs"
                               class="form-control"
                               placeholder="Example: 4" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label>Technical Skill IDs</label>

                        <input asp-for="Profile.sTechnicalSkillIDs"
                               class="form-control"
                               placeholder="Example: 1,5,7,9" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Technical Skill Star IDs</label>

                        <input asp-for="Profile.sTechnicalSkillStarIDs"
                               class="form-control"
                               placeholder="Example: 1" />

                    </div>


                    <div class="col-md-6 mb-3">

                        <label>Non Technical Skill IDs</label>

                        <input asp-for="Profile.sNonTechnicalSkillIDs"
                               class="form-control"
                               placeholder="Example: 7,9" />

                    </div>

                    <div class="col-md-6 mb-3">

                        <label>Non Technical Skill Star IDs</label>

