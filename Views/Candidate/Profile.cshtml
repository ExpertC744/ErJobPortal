@model ErJobPortal.Models.CandidateProfileViewModel

<style>
    /* ========================================================= */
    /* SKILLS SECTION */
    /* ========================================================= */

    .skills-section {
        width: 100%;
        margin-top: 25px;
        margin-bottom: 30px;
    }


    /* ========================================================= */
    /* TITLE */
    /* ========================================================= */

    .skills-title {
        margin-bottom: 15px;
    }

        .skills-title label {
            font-size: 16px;
            font-weight: 600;
            color: #102a43;
        }

        .skills-title .required {
            color: #dc3545;
            font-weight: 700;
        }


    /* ========================================================= */
    /* ACCORDION */
    /* ========================================================= */

    .skills-section .skill-accordion {
        width: 100%;
        margin-bottom: 15px;
        background: #ffffff;
        border: 1px solid #dce3eb;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    }


    /* ========================================================= */
    /* ACCORDION HEADER */
    /* ========================================================= */

    .skills-section .skill-header {
        min-height: 70px;
        padding: 0 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        background: #f8fafc;
        list-style: none;
        transition: background 0.2s ease;
    }


        /* Remove default details arrow */

        .skills-section .skill-header::-webkit-details-marker {
            display: none;
        }

        .skills-section .skill-header::marker {
            display: none;
        }


        /* Header hover */

        .skills-section .skill-header:hover {
            background: #f1f5f9;
        }


    /* ========================================================= */
    /* SKILL HEADING */
    /* ========================================================= */

    .skills-section .skill-heading {
        font-size: 16px;
        font-weight: 600;
        color: #102a43;
    }


    /* ========================================================= */
    /* RIGHT SIDE */
    /* ========================================================= */

    .skills-section .skill-header-right {
        display: flex;
        align-items: center;
        gap: 15px;
    }


    /* ========================================================= */
    /* SELECTED COUNT */
    /* ========================================================= */

    .skills-section .selected-count {
        min-width: 90px;
        padding: 8px 14px;
        text-align: center;
        border-radius: 30px;
        background: #e5f5f3;
        color: #0d9488;
        font-size: 13px;
        font-weight: 600;
    }


    /* ========================================================= */
    /* ARROW */
    /* ========================================================= */

    .skills-section .accordion-arrow {
        width: 20px;
        text-align: center;
        color: #718096;
        font-size: 13px;
        transition: transform 0.2s ease;
    }


    /* ========================================================= */
    /* ACCORDION BODY */
    /* ========================================================= */

    .skills-section .skill-body {
        padding: 20px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        border-top: 1px solid #dce3eb;
        background: #ffffff;
    }


    /* ========================================================= */
    /* SKILL ITEM */
    /* ========================================================= */

    .skills-section .skill-item {
        min-height: 58px;
        padding: 0 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        border: 1px solid #dce3eb;
        border-radius: 9px;
        background: #ffffff;
        cursor: pointer;
        font-size: 15px;
        font-weight: 600;
        color: #172b4d;
        transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
    }


        /* ========================================================= */
        /* CHECKBOX */
        /* ========================================================= */

        .skills-section .skill-item input[type="checkbox"] {
            width: 19px;
            height: 19px;
            margin: 0;
            flex-shrink: 0;
            cursor: pointer;
            accent-color: #0d9488;
        }


        /* ========================================================= */
        /* SKILL TEXT */
        /* ========================================================= */

        .skills-section .skill-item span {
            line-height: 1.3;
        }


        /* ========================================================= */
        /* HOVER */
        /* ========================================================= */

        .skills-section .skill-item:hover {
            border-color: #0d9488;
            background: #f8fffe;
            box-shadow: 0 3px 8px rgba(13, 148, 136, 0.08);
            transform: translateY(-1px);
        }


        /* ========================================================= */
        /* SELECTED */
        /* ========================================================= */

        .skills-section .skill-item:has(input[type="checkbox"]:checked) {
            border-color: #0d9488;
            background: #f0fdfa;
            box-shadow: 0 2px 6px rgba(13, 148, 136, 0.10);
        }


        /* ========================================================= */
        /* SELECTED CHECKBOX */
        /* ========================================================= */

        .skills-section
        .skill-item
        input[type="checkbox"]:checked {
            accent-color: #0d9488;
        }


    /* ========================================================= */
    /* OPEN ACCORDION */
    /* ========================================================= */

    .skills-section
    .skill-accordion[open]
    .skill-header {
        background: #f8fafc;
    }


    /* ========================================================= */
    /* RESPONSIVE - TABLET */
    /* ========================================================= */

    @@media (max-width: 992px) {

        .skills-section .skill-body {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    /* ========================================================= */
    /* RESPONSIVE - SMALL TABLET */
    /* ========================================================= */

    @@media (max-width: 768px) {

        .skills-section .skill-body {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .skills-section .skill-header {
            min-height: 65px;
            padding: 0 16px;
        }

        .skills-section .skill-heading {
            font-size: 15px;
        }
    }


    /* ========================================================= */
    /* RESPONSIVE - MOBILE */
    /* ========================================================= */

    @@media (max-width: 576px) {

        .skills-section {
            margin-top: 20px;
        }

            .skills-section .skill-body {
                grid-template-columns: 1fr;
                padding: 14px;
                gap: 10px;
            }

            .skills-section .skill-header {
                min-height: 62px;
                padding: 0 14px;
            }

            .skills-section .skill-header-right {
                gap: 8px;
            }

            .skills-section .selected-count {
                min-width: 75px;
                padding: 7px 9px;
                font-size: 11px;
            }

            .skills-section .skill-heading {
                font-size: 14px;
            }

            .skills-section .skill-item {
                min-height: 54px;
                font-size: 14px;
            }
    }


    /* ========================================================= */
    /* VERY SMALL MOBILE */
    /* ========================================================= */

    @@media (max-width: 400px) {

        .skills-section .skill-header {
            padding: 0 12px;
        }

        .skills-section .skill-heading {
            font-size: 13px;
        }

        .skills-section .selected-count {
            min-width: 65px;
            font-size: 10px;
        }

        .skills-section .accordion-arrow {
            width: 14px;
        }
    }

    /* ========================================================= */
    /* UPDATE SKILLS BUTTON */
    /* ========================================================= */

    #btnUpdateSkills {
        min-width: 150px;
        min-height: 42px;
        font-weight: 600;
        border-radius: 8px;
    }

        #btnUpdateSkills:disabled {
            cursor: not-allowed;
            opacity: 0.75;
        }


    /* ========================================================= */
    /* VALIDATION */
    /* ========================================================= */

    #skillValidationMessage {
        font-size: 14px;
        font-weight: 500;
    }
</style>

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Candidate Profile";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

<div class="container-fluid mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <!-- ================================================= -->
    <!-- PROFILE HEADER -->
    <!-- ================================================= -->

    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">Candidate Profile</h4>
        </div>
    </div>


    <!-- ================================================= -->
    <!-- ADDRESS -->
    <!-- ================================================= -->

    <div class="card mb-4">

        <div class="card-header">
            <h4 class="mb-0">Address</h4>
        </div>

        <div class="card-body">

            <form id="addressForm"
                  asp-action="UpdateAddress"
                  asp-controller="Candidate"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <!-- COUNTRY -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.CountryID"
                               class="form-label">
                            Country <span class="text-danger">*</span>
                        </label>

                        <select asp-for="Profile.CountryID"
                                class="form-control"
                                id="CountryID"
                                required>

                            <option value="">
                                -- Select Country --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.CountryID"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- STATE -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.StateID"
                               class="form-label">
                            State <span class="text-danger">*</span>
                        </label>

                        <select asp-for="Profile.StateID"
                                class="form-control"
                                id="StateID"
                                disabled
                                required>

                            <option value="">
                                -- Select State --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.StateID"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CITY -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.CityID"
                               class="form-label">
                            City <span class="text-danger">*</span>
                        </label>

                        <select asp-for="Profile.CityID"
                                class="form-control"
                                id="CityID"
                                disabled
                                required>

                            <option value="">
                                -- Select City --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.CityID"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- PINCODE -->
                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Pincode"
                               class="form-label">
                            Pincode <span class="text-danger">*</span>
                        </label>

                        <input asp-for="Profile.Pincode"
                               id="Pincode"
                               class="form-control"
                               placeholder="Enter 6 digit Pincode"
                               maxlength="6"
                               minlength="6"
                               pattern="[0-9]{6}"
                               inputmode="numeric"
                               required />

                        <span asp-validation-for="Profile.Pincode"
                              class="text-danger">
                        </span>

                        @*  <small class="text-muted">
                            Enter a valid 6-digit pincode.
                        </small> *@

                    </div>

                </div>


                <div class="text-end">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Address
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- EDUCATION -->
    <!-- ================================================= -->

    <div class="card mb-4">

        <div class="card-header">
            <h4 class="mb-0">Education</h4>
        </div>

        <div class="card-body">

            <form id="educationForm"
                  asp-action="UpdateEducation"
                  asp-controller="Candidate"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- SSC -->

                <h5>SSC / 10th</h5>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.SSC_YEAR"
                               class="form-label">
                            SSC Year
                        </label>

                        <input asp-for="Profile.SSC_YEAR"
                               type="number"
                               class="form-control education-year"
                               min="1950"
                               max="2099"
                               placeholder="YYYY" />

                        <span asp-validation-for="Profile.SSC_YEAR"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.SSC_DIVISION"
                               class="form-label">
                            SSC Division
                        </label>

                        <select asp-for="Profile.SSC_DIVISION"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">

                            <option value="">
                                -- Select Division --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.SSC_DIVISION"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr />


                <!-- HSC -->

                <h5>HSC / Diploma</h5>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.HSC_DIPLOMA_YEAR"
                               class="form-label">
                            HSC / Diploma Year
                        </label>

                        <input asp-for="Profile.HSC_DIPLOMA_YEAR"
                               type="number"
                               class="form-control education-year"
                               min="1950"
                               max="2099"
                               placeholder="YYYY" />

                        <span asp-validation-for="Profile.HSC_DIPLOMA_YEAR"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.HSC_DIPLOMA_DIVISION"
                               class="form-label">
                            HSC / Diploma Division
                        </label>

                        <select asp-for="Profile.HSC_DIPLOMA_DIVISION"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">

                            <option value="">
                                -- Select Division --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.HSC_DIPLOMA_DIVISION"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr />


                <!-- GRADUATION -->

                <h5>Graduation</h5>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Graduation_Year"
                               class="form-label">
                            Graduation Year
                        </label>

                        <input asp-for="Profile.Graduation_Year"
                               type="number"
                               class="form-control education-year"
                               min="1950"
                               max="2099"
                               placeholder="YYYY" />

                        <span asp-validation-for="Profile.Graduation_Year"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Graduation_Division"
                               class="form-label">
                            Graduation Division
                        </label>

                        <select asp-for="Profile.Graduation_Division"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">

                            <option value="">
                                -- Select Division --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.Graduation_Division"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Graduation_Stream"
                               class="form-label">
                            Graduation Stream
                        </label>

                        <select asp-for="Profile.Graduation_Stream"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Streams, "ID", "Name"))">

                            <option value="">
                                -- Select Stream --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.Graduation_Stream"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Other_Stream"
                               class="form-label">
                            Other Stream
                        </label>

                        <input asp-for="Profile.Other_Stream"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Profile.Other_Stream"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr />


                <!-- PG -->

                <h5>Post Graduation</h5>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.PG_Year"
                               class="form-label">
                            PG Year
                        </label>

                        <input asp-for="Profile.PG_Year"
                               type="number"
                               class="form-control education-year"
                               min="1950"
                               max="2099"
                               placeholder="YYYY" />

                        <span asp-validation-for="Profile.PG_Year"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.PG_Division"
                               class="form-label">
                            PG Division
                        </label>

                        <select asp-for="Profile.PG_Division"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">

                            <option value="">
                                -- Select Division --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.PG_Division"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.PG_Stream"
                               class="form-label">
                            PG Stream
                        </label>

                        <select asp-for="Profile.PG_Stream"
                                class="form-control"
                                asp-items="@(new SelectList(Model.Streams, "ID", "Name"))">

                            <option value="">
                                -- Select Stream --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.PG_Stream"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Other_Specialization"
                               class="form-label">
                            Other Specialization
                        </label>

                        <input asp-for="Profile.Other_Specialization"
                               class="form-control"
                               maxlength="150" />

                        <span asp-validation-for="Profile.Other_Specialization"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <hr />


                <!-- PHD -->

                <h5>PhD</h5>

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.PhD_Year"
                               class="form-label">
                            PhD Year
                        </label>

                        <input asp-for="Profile.PhD_Year"
                               type="number"
                               class="form-control education-year"
                               min="1950"
                               max="2099"
                               placeholder="YYYY" />

                        <span asp-validation-for="Profile.PhD_Year"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.PhD_Status"
                               class="form-label">
                            PhD Status
                        </label>

                        <select asp-for="Profile.PhD_Status"
                                class="form-control"
                                asp-items="@(new SelectList(Model.GraduationStatuses, "ID", "Name"))">

                            <option value="">
                                -- Select Status --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.PhD_Status"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.PhD_Topic"
                               class="form-label">
                            PhD Topic
                        </label>

                        <input asp-for="Profile.PhD_Topic"
                               class="form-control"
                               maxlength="200" />

                        <span asp-validation-for="Profile.PhD_Topic"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Previous_PhD_Topic_Year"
                               class="form-label">
                            Previous PhD Topic / Year
                        </label>

                        <input asp-for="Profile.Previous_PhD_Topic_Year"
                               class="form-control"
                               maxlength="200" />

                        <span asp-validation-for="Profile.Previous_PhD_Topic_Year"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="text-end">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Education
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- INTERNSHIP / FELLOWSHIP PREFERENCE -->
    <!-- ================================================= -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Internship / Fellowship Preference
            </h5>
        </div>

        <div class="card-body">

            <form id="preferenceForm"
                  asp-action="UpdateInternshipPreference"
                  asp-controller="Candidate"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row">

                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Internship_FellowshipType"
                               class="form-label">
                            Internship / Fellowship Type
                            <span class="text-danger">*</span>
                        </label>

                        <select asp-for="Profile.Internship_FellowshipType"
                                class="form-control"
                                asp-items="@(new SelectList(Model.InternshipFellowshipType, "ID", "Name"))"
                                required>

                            <option value="">
                                -- Select Type --
                            </option>

                        </select>

                        <span asp-validation-for="Profile.Internship_FellowshipType"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Preferred_Country"
                               class="form-label">
                            Preferred Country
                        </label>

                        <input asp-for="Profile.Preferred_Country"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Profile.Preferred_Country"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Preferred_State"
                               class="form-label">
                            Preferred State
                        </label>

                        <input asp-for="Profile.Preferred_State"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Profile.Preferred_State"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-3 mb-3">

                        <label asp-for="Profile.Preferred_City"
                               class="form-label">
                            Preferred City
                        </label>

                        <input asp-for="Profile.Preferred_City"
                               class="form-control"
                               maxlength="100" />

                        <span asp-validation-for="Profile.Preferred_City"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="text-end">

                    <button type="submit"
                            class="btn btn-primary">
                        Update Preference
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- ================================================= -->
    <!-- DOCUMENTS -->
    <!-- ================================================= -->

    <div class="card mb-4">

        <div class="card-header">
            <h5 class="mb-0">
                Documents & Personal Details
            </h5>
        </div>

        <div class="card-body">

            <form id="documentsForm"
                  asp-controller="Candidate"
                  asp-action="UpdateDocuments"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="row">

                    <!-- Resume -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-bold">
                            Resume
                        </label>

                        <input type="file"
                               name="ResumeFile"
                               id="ResumeFile"
                               class="form-control"
                               accept=".pdf,.doc,.docx" />

                        <small class="text-muted">
                            Allowed: PDF, DOC, DOCX. Maximum 5 MB.
                        </small>

                        <div id="resumeError"
                             class="text-danger">
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Profile?.sResume))
                        {
                            <small class="text-success d-block mt-2">
                                ✓ Resume already uploaded
                            </small>

                            <a href="@Model.Profile.sResume"
                               target="_blank"
                               class="btn btn-sm btn-outline-primary mt-1">
                                View Resume
                            </a>
                        }

                    </div>


                    <!-- Photo -->

                    <div class="col-md-4 mb-3">

                        <label class="form-label fw-bold">
