                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Profile.CandidateID" />

                        <div class="language-grid">

                            @for (int i = 1; i <= 8; i++)
                            {
                                var langValue = Model.Profile?.GetType()
                                .GetProperty($"sLanguage{i}")?
                                .GetValue(Model.Profile)?.ToString() ?? "";

                                var levelValue = Model.Profile?.GetType()
                                .GetProperty($"sLanguageStar{i}")?
                                .GetValue(Model.Profile)?.ToString() ?? "";

                                <div class="language-row language-item">

                                    <label for="Profile_sLanguage@(i)" class="form-label">
                                        Language @i
                                    </label>

                                    <input type="text"
                                           id="Profile_sLanguage@(i)"
                                           name="Profile.sLanguage@(i)"
                                           value="@langValue"
                                           class="form-control language-input mb-2"
                                           placeholder="Enter language"
                                           maxlength="50" />

                                    <span class="text-danger"
                                          data-valmsg-for="Profile.sLanguage@(i)"
                                          data-valmsg-replace="true"></span>

                                    <select id="Profile_sLanguageStar@(i)"
                                            name="Profile.sLanguageStar@(i)"
                                            class="form-select language-level">

                                        <option value="">-- Select Level --</option>

                                        <option value="1" selected="@(levelValue == "1" ? "selected" : null)">
                                            Beginner
                                        </option>

                                        <option value="2" selected="@(levelValue == "2" ? "selected" : null)">
                                            Intermediate
                                        </option>

                                        <option value="3" selected="@(levelValue == "3" ? "selected" : null)">
                                            Advance
                                        </option>

                                        <option value="4" selected="@(levelValue == "4" ? "selected" : null)">
                                            Expert
                                        </option>

                                    </select>

                                    <span class="text-danger"
                                          data-valmsg-for="Profile.sLanguageStar@(i)"
                                          data-valmsg-replace="true"></span>

                                </div>
                            }

                        </div>

