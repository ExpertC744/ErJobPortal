        </div>

    </div>

</div>


@section Scripts {
    <script>

        $('#addressForm').on('submit', function () {

            $('#StateID').prop('disabled', false);

            $('#CityID').prop('disabled', false);

        });

    </script>
    <script>

        $(document).ready(function () {

            var selectedCountryID = '@Model.Profile.CountryID';
            var selectedStateID = '@Model.Profile.StateID';
            var selectedCityID = '@Model.Profile.CityID';


            // ============================================
            // IMPORTANT:
            // Disabled select values are not submitted.
            // Enable them before Address form submit.
            // ============================================

            $('form[action*="UpdateAddress"]').submit(function () {

                $('#StateID').prop('disabled', false);
                $('#CityID').prop('disabled', false);

            });


            // ============================================
            // LOAD COUNTRIES
            // ============================================

            function loadCountries() {

                $.ajax({

                    url: '/Location/GetCountries',

                    type: 'GET',

                    success: function (data) {

                        $('#CountryID').empty();

                        $('#CountryID').append(
                            '<option value="">-- Select Country --</option>'
                        );


                        $.each(data, function (index, item) {

                            $('#CountryID').append(

                                $('<option>', {

                                    value: item.id,
                                    text: item.name

                                }).attr(
                                    'data-code',
                                    item.iso2
                                )

                            );

                        });


                        if (selectedCountryID !== '') {

                            $('#CountryID')
                                .val(selectedCountryID)
                                .trigger('change');

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "Country Error:",
                            xhr.responseText
                        );

                    }

                });

            }


            // ============================================
            // COUNTRY CHANGE
            // ============================================

            $('#CountryID').change(function () {

                var countryID = $(this).val();

                var countryCode =
                    $('#CountryID option:selected')
                        .attr('data-code');


                $('#StateID').empty();

                $('#StateID').append(
                    '<option value="">-- Select State --</option>'
                );


                $('#CityID').empty();

                $('#CityID').append(
                    '<option value="">-- Select City --</option>'
                );

                $('#CityID').prop('disabled', true);


                if (!countryID || !countryCode) {

                    $('#StateID').prop('disabled', true);

                    return;

                }


                $('#StateID').prop('disabled', false);


                $.ajax({

                    url: '/Location/GetStates',

                    type: 'GET',

                    data: {

                        countryCode: countryCode

                    },

                    success: function (data) {

                        $('#StateID').empty();

                        $('#StateID').append(
                            '<option value="">-- Select State --</option>'
                        );


                        $.each(data, function (index, item) {

                            var stateCode = item.stateCode;

                            if (!stateCode && item.id) {

                                var parts =
                                    item.id.split(':');

                                stateCode =
                                    parts.length > 1
                                        ? parts[1]
                                        : item.id;

                            }


                            $('#StateID').append(

                                $('<option>', {

                                    value: item.id,
                                    text: item.name

                                }).attr(
                                    'data-code',
                                    stateCode
                                )

                            );

                        });


                        if (selectedStateID !== '') {

                            $('#StateID')
                                .val(selectedStateID)
                                .trigger('change');

                            selectedStateID = '';

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "State Error:",
                            xhr.responseText
                        );

                    }

                });

            });


            // ============================================
            // STATE CHANGE
            // ============================================

            $('#StateID').change(function () {

                var stateID = $(this).val();

                var stateCode =
                    $('#StateID option:selected')
                        .attr('data-code');

                var countryCode =
                    $('#CountryID option:selected')
                        .attr('data-code');


                $('#CityID').empty();

                $('#CityID').append(
                    '<option value="">-- Select City --</option>'
                );


                if (!stateID ||
                    !stateCode ||
                    !countryCode) {

                    $('#CityID').prop(
                        'disabled',
                        true
                    );

                    return;

                }


                $('#CityID').prop(
                    'disabled',
                    false
                );


                $.ajax({

                    url: '/Location/GetCities',

                    type: 'GET',

                    data: {

                        countryCode: countryCode,
                        stateCode: stateCode

                    },

                    success: function (data) {

                        $('#CityID').empty();

                        $('#CityID').append(
                            '<option value="">-- Select City --</option>'
                        );


                        $.each(data, function (index, item) {

                            $('#CityID').append(

                                $('<option>', {

                                    value: item.id,
                                    text: item.name

                                })

                            );

                        });


                        if (selectedCityID) {

                            $('#CityID')
                                .val(selectedCityID);

                            selectedCityID = '';

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "City Error:",
                            xhr.responseText
                        );

                    }

                });

            });


            // ============================================
            // INITIAL LOAD
            // ============================================

            loadCountries();

        });

    </script>

}