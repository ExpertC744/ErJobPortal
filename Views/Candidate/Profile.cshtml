                    <form id="resumeForm" asp-action="UpdateResumeTemplate" asp-controller="Candidate" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="candidateID" value="@Model.Profile?.CandidateID" />

                        <div class="resume-grid">

                            @for (int i = 1; i <= resumeCount; i++)
                            {
                                var key = $"r{i}";

                                <label class="resume-option @(i > pageSize ? "is-hidden" : "")">

                                    <span class="resume-option-title">
                                        <input type="radio"
       name="resumeTemplate"
       value="@key"
       @(savedResumeProfile == i ? "checked" : "") />
                                        Profile Preview @i
                                    </span>

                                    <img src="@Url.Content("~/Resume/" + FindResume(i))"
                                         alt="Profile Preview @i"
                                         loading="lazy" />

                                </label>
                            }

                        </div>



                        <div id="resumeValidation" class="text-danger mt-3" style="display:none;">
                            Please select a resume profile.
                        </div>

                        <div class="text-end mt-3">
                            @if (resumeCount > pageSize)
                            {

                                <button type="button"
                                        class="btn btn-primary"
                                        id="btnShowMoreResume"
                                        data-page-size="@pageSize">
                                    Show More
                                </button>

                            }
                            <button type="submit" class="btn btn-primary">Update Resume Profile</button>
                        </div>

                    </form>

                </div>

            </div>


            <!-- ============================ SKILLS ============================ -->
            @{
                var selectedMedicalSkillIDs =
                new HashSet<string>(
                (Model.Profile?.sMedicalSkillIDs ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim()),
                StringComparer.OrdinalIgnoreCase
                );

                var selectedTechnicalSkillIDs =
                new HashSet<string>(
                (Model.Profile?.sTechnicalSkillIDs ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim()),
                StringComparer.OrdinalIgnoreCase
                );

                var selectedNonTechnicalSkillIDs =
                new HashSet<string>(
                (Model.Profile?.sNonTechnicalSkillIDs ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim()),
                StringComparer.OrdinalIgnoreCase
                );

                var skillGroups = new[]
                {
            new
            {
            Title = "Medical Skills",
            CountId = "medicalCount",
            BodyId = "medicalSkills",
            Css = "medical-skill",
            Open = false,
            Selected = selectedMedicalSkillIDs,
            Skills = Model.MedicalSkills
            },
            new
            {
            Title = "Technical Skills",
            CountId = "technicalCount",
            BodyId = "technicalSkills",
            Css = "technical-skill",
            Open = false,
            Selected = selectedTechnicalSkillIDs,
            Skills = Model.TechnicalSkills
            },
            new
            {
            Title = "Non Technical Skills",
            CountId = "nonTechnicalCount",
            BodyId = "nonTechnicalSkills",
            Css = "nontechnical-skill",
            Open = false,
            Selected = selectedNonTechnicalSkillIDs,
            Skills = Model.NonTechnicalSkills
            }
            };
            }

            <div class="card mb-4 profile-section-card" id="section-skills">

                <div class="card-header">
                    <h5 class="mb-0">Skills</h5>
                </div>

                <div class="card-body">

                    <form asp-controller="Candidate" asp-action="UpdateSkills" method="post" id="skillsForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="Profile.CandidateID" />

                        <section class="skills-section">

                            <div class="skills-title">
                                <label>Select Skill Type <span class="text-danger">*</span></label>
                                <small class="text-muted d-block mt-1">
                                    Select skills from one category.
                                </small>
                            </div>

                            @foreach (var group in skillGroups)
                            {
                                <details class="skill-accordion" @(group.Open ? "open" : "")>

                                    <summary class="skill-header">
                                        <span class="skill-heading">@group.Title</span>
                                        <span class="skill-header-right">
                                            <span class="selected-count" id="@group.CountId">0 selected</span>
                                            <span class="accordion-arrow">@(group.Open ? "▴" : "▾")</span>
                                        </span>
                                    </summary>

                                    <div class="skill-body" id="@group.BodyId">

                                        @foreach (var skill in group.Skills)
                                        {
                                            string skillID = skill.ID.ToString();
                                            bool isChecked = group.Selected.Contains(skillID);

                                            <label class="skill-item">
                                                <input type="checkbox"
                                                       class="@group.Css"
                                                       value="@skill.ID"
                                                @(isChecked ? "checked" : "") />
                                                <span>@skill.Name</span>
                                            </label>
                                        }

                                    </div>
                                </details>
                            }

                            <!-- HIDDEN FIELDS -->
                            <input type="hidden" asp-for="Profile.sMedicalSkillIDs" id="sMedicalSkillIDs" />
                            <input type="hidden" asp-for="Profile.sTechnicalSkillIDs" id="sTechnicalSkillIDs" />
                            <input type="hidden" asp-for="Profile.sNonTechnicalSkillIDs" id="sNonTechnicalSkillIDs" />

                            <div id="skillValidationMessage" class="text-danger mt-3" style="display:none;">
                                Please select at least one skill.
                            </div>

                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary px-4" id="btnUpdateSkills">
                                    <span id="updateSkillsText">Update Skills</span>
                                    <span id="updateSkillsLoader"
                                          class="spinner-border spinner-border-sm ms-2"
                                          style="display:none;"
                                          role="status"></span>
                                </button>
                            </div>

                        </section>

                    </form>

                </div>

            </div>

        </main>
    </div>
</div>


<!-- ===================== SIDEBAR NAVIGATION SCRIPT ===================== -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const navItems = Array.from(document.querySelectorAll(".profile-nav-item"));
        const sections = navItems.map(item => document.getElementById(item.dataset.section)).filter(Boolean);
        if (!navItems.length || !sections.length) return;

        const isMobile = () => window.matchMedia("(max-width: 680px)").matches;

        function setActive(id) {
            navItems.forEach(item => {
                const active = item.dataset.section === id;
                item.classList.toggle("active", active);
                item.setAttribute("aria-current", active ? "true" : "false");
            });
        }

        function getOffset() {
            if (!isMobile()) return 24;
            const sidebar = document.querySelector(".profile-section-sidebar");
            return (sidebar ? sidebar.getBoundingClientRect().height : 0) + 16;
        }

        function scrollToSection(section, updateHash) {
            if (!section) return;
            const top = Math.max(0, window.scrollY + section.getBoundingClientRect().top - getOffset());
            window.scrollTo({ top, behavior: "smooth" });
            setActive(section.id);
            if (updateHash) history.replaceState(null, "", "#" + section.id);
        }

        navItems.forEach(item => {
            item.addEventListener("click", function (event) {
                event.preventDefault();
                scrollToSection(document.getElementById(item.dataset.section), true);
            });
        });

        let ticking = false;
        function updateActive() {
            const trigger = getOffset() + 35;
            let current = sections[0];
            let best = Infinity;
            sections.forEach(section => {
                const top = section.getBoundingClientRect().top;
                const distance = Math.abs(top - trigger);
                if (top <= trigger + 100 && distance < best) {
                    best = distance;
                    current = section;
                }
            });
            if (current) setActive(current.id);
            ticking = false;
        }

        window.addEventListener("scroll", function () {
            if (!ticking) {
                window.requestAnimationFrame(updateActive);
                ticking = true;
            }
        }, { passive: true });

        window.addEventListener("resize", updateActive);

        const hash = window.location.hash.substring(1);
        const initialSection = document.getElementById(hash);
        if (initialSection) {
            setActive(initialSection.id);
            setTimeout(() => scrollToSection(initialSection, false), 100);
        } else {
            updateActive();
        }
    });
</script>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

                $(document).ready(function () {

                    /* =====================================================
                       ADDRESS
                       ===================================================== */

                    var selectedCountryID = '@(Model.Profile?.CountryID ?? "")';
                    var selectedStateID   = '@(Model.Profile?.StateID ?? "")';
                    var selectedCityID    = '@(Model.Profile?.CityID ?? "")';

                    function loadCountries() {

                        $.ajax({
                            url: '/Location/GetCountries',
                            type: 'GET',

                            success: function (data) {

                                $('#CountryID').empty();
                                $('#CountryID').append('<option value="">-- Select Country --</option>');

                                $.each(data, function (index, item) {
                                    $('#CountryID').append(
                                        $('<option>', { value: item.id, text: item.name })
                                            .attr('data-code', item.iso2)
                                    );
                                });

                                if (selectedCountryID !== '') {
                                    $('#CountryID').val(selectedCountryID).trigger('change');
                                }
                            },

                            error: function (xhr) {
                                console.log("Country Error:", xhr.responseText);
                            }
                        });
                    }

                    $('#CountryID').change(function () {

                        var countryID   = $(this).val();
                        var countryCode = $('#CountryID option:selected').attr('data-code');

                        $('#StateID').empty().append('<option value="">-- Select State --</option>');
                        $('#CityID').empty().append('<option value="">-- Select City --</option>');
                        $('#CityID').prop('disabled', true);

                        if (!countryID || !countryCode) {
                            $('#StateID').prop('disabled', true);
                            return;
                        }

                        $('#StateID').prop('disabled', false);

                        $.ajax({
                            url: '/Location/GetStates',
                            type: 'GET',
                            data: { countryCode: countryCode },

                            success: function (data) {

                                $('#StateID').empty().append('<option value="">-- Select State --</option>');

                                $.each(data, function (index, item) {

                                    var stateCode = item.stateCode;

                                    if (!stateCode && item.id) {
                                        var parts = item.id.split(':');
                                        stateCode = parts.length > 1 ? parts[1] : item.id;
                                    }

                                    $('#StateID').append(
                                        $('<option>', { value: item.id, text: item.name })
                                            .attr('data-code', stateCode)
                                    );
                                });

                                if (selectedStateID !== '') {
                                    $('#StateID').val(selectedStateID).trigger('change');
                                    selectedStateID = '';
                                }
                            },

                            error: function (xhr) {
                                console.log("State Error:", xhr.responseText);
                            }
                        });
                    });

                    $('#StateID').change(function () {

                        var stateID     = $(this).val();
                        var stateCode   = $('#StateID option:selected').attr('data-code');
                        var countryCode = $('#CountryID option:selected').attr('data-code');

                        $('#CityID').empty().append('<option value="">-- Select City --</option>');

                        if (!stateID || !stateCode || !countryCode) {
                            $('#CityID').prop('disabled', true);
                            return;
                        }

                        $('#CityID').prop('disabled', false);

                        $.ajax({
                            url: '/Location/GetCities',
                            type: 'GET',
                            data: { countryCode: countryCode, stateCode: stateCode },

                            success: function (data) {

                                $('#CityID').empty().append('<option value="">-- Select City --</option>');

                                $.each(data, function (index, item) {
                                    $('#CityID').append($('<option>', { value: item.id, text: item.name }));
                                });

                                if (selectedCityID !== '') {
                                    $('#CityID').val(selectedCityID);
                                    selectedCityID = '';
                                }
                            },

                            error: function (xhr) {
                                console.log("City Error:", xhr.responseText);
                            }
                        });
                    });

                    $('#addressForm').on('submit', function (e) {

                        // Disabled select controls are not posted. Enable them before validation/submission.
                        $('#StateID').prop('disabled', false);
                        $('#CityID').prop('disabled', false);

                        if (!this.checkValidity()) {
                            e.preventDefault();
                            this.reportValidity();
                            return false;
                        }
                    });

                    loadCountries();


                    /* =====================================================
                       PINCODE / MOBILE / EDUCATION YEAR
                       ===================================================== */

                    $('#Pincode').on('input', function () {
                        this.value = this.value.replace(/\D/g, '').substring(0, 6);
                    });

                    $('.reference-mobile').on('input', function () {
                        this.value = this.value.replace(/\D/g, '').substring(0, 10);
                    });

                    $('.education-year').on('input', function () {
                        this.value = this.value.replace(/\D/g, '').substring(0, 4);
                    });


                    /* =====================================================
                       DOCUMENT VALIDATION
                       ===================================================== */

                    function validateFile(inputId, errorId, allowedExtensions) {

                        const input = document.getElementById(inputId);
                        const error = document.getElementById(errorId);

                        if (!input || !error) { return true; }

                        error.innerText = '';

                        if (!input.files || input.files.length === 0) { return true; }

                        const file = input.files[0];
                        const maxSize = 5 * 1024 * 1024;
                        const extension = '.' + file.name.split('.').pop().toLowerCase();

                        if (!allowedExtensions.includes(extension)) {
                            error.innerText = 'Invalid file type.';
                            input.value = '';
                            return false;
                        }

                        if (file.size > maxSize) {
                            error.innerText = 'File size must not exceed 5 MB.';
                            input.value = '';
                            return false;
                        }

                        return true;
                    }

                    $('#ResumeFile').on('change', function () {
                        validateFile('ResumeFile', 'resumeError', ['.pdf', '.doc', '.docx']);
                    });

                    $('#PhotoFile').on('change', function () {
                        validateFile('PhotoFile', 'photoError', ['.jpg', '.jpeg', '.png']);
                    });

                    $('#SignatureFile').on('change', function () {
                        validateFile('SignatureFile', 'signatureError', ['.jpg', '.jpeg', '.png']);
                    });

                    $('#documentsForm').on('submit', function (e) {

                        const resumeValid    = validateFile('ResumeFile', 'resumeError', ['.pdf', '.doc', '.docx']);
                        const photoValid     = validateFile('PhotoFile', 'photoError', ['.jpg', '.jpeg', '.png']);
                        const signatureValid = validateFile('SignatureFile', 'signatureError', ['.jpg', '.jpeg', '.png']);

                        if (!resumeValid || !photoValid || !signatureValid) {
                            e.preventDefault();
                            return false;
                        }
                    });


                    /* =====================================================
                       LANGUAGES (level dropdown)
                       ===================================================== */

                    $('#languagesForm').on('submit', function (e) {

                        let valid = true;
                        let hasLanguage = false;

                        $('.language-row').each(function () {

                            const language = $(this).find('.language-input').val().trim();
                            const level    = $(this).find('.language-level').val();

                            if (language !== '') {
                                hasLanguage = true;
                                if (level === '') valid = false;   // language without a level
                            }

                            if (language === '' && level !== '') {
                                valid = false;                     // level without a language
                            }
                        });

                        if (!hasLanguage || !valid) {
                            e.preventDefault();
                            $('#languageValidation').show().get(0)
                                .scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return false;
                        }

                        $('#languageValidation').hide();
                    });


                    /* =====================================================
                       SOCIAL URL VALIDATION
                       ===================================================== */

                    $('#socialForm').on('submit', function (e) {

                        let valid = true;

                        $('#socialForm input[type="url"]').each(function () {

                            const value = $(this).val().trim();

                            if (value !== '') {
                                try {
                                    new URL(value);
                                }
                                catch {
                                    valid = false;
                                    $(this).addClass('is-invalid');
                                }
                            }
                        });

                        if (!valid) {
                            e.preventDefault();
                            alert('Please enter valid social profile URLs.');
                            return false;
                        }
                    });


                    /* =====================================================
                       RESUME PROFILE
                       ===================================================== */

                    $('#resumeForm').on('submit', function (e) {

                        if ($('input[name="resumeTemplate"]:checked').length === 0) {
                            e.preventDefault();
                            $('#resumeValidation').show().get(0)
                                .scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return false;
                        }

                        $('#resumeValidation').hide();
                    });


                    /* =====================================================
                       SKILLS (no ratings)
                       ===================================================== */

                    const skillGroups = [
                        { css: '.medical-skill',      count: '#medicalCount',      hidden: '#sMedicalSkillIDs' },
                        { css: '.technical-skill',    count: '#technicalCount',    hidden: '#sTechnicalSkillIDs' },
                        { css: '.nontechnical-skill', count: '#nonTechnicalCount', hidden: '#sNonTechnicalSkillIDs' }
                    ];

                    // Writes comma-separated Skill IDs into each hidden field and updates the counters
                    function updateHiddenFields() {
                        skillGroups.forEach(function (g) {
                            const values = $(g.css + ':checked')
                                .map(function () { return $(this).val(); })
                                .get();

                            $(g.hidden).val(values.join(','));
                            $(g.count).text(values.length + ' selected');
                        });
                    }

                    // Only one category can be used at a time
                    function updateSkillCategoryState() {
                        const used = skillGroups.map(g => $(g.css + ':checked').length > 0);
                        const usedIndex = used.indexOf(true);

                        skillGroups.forEach(function (g, i) {
                            $(g.css).prop('disabled', usedIndex !== -1 && usedIndex !== i);
                        });
                    }

                    $('.medical-skill, .technical-skill, .nontechnical-skill').on('change', function () {
                        updateHiddenFields();
                        updateSkillCategoryState();
                    });

                    $('#skillsForm').on('submit', function (e) {

                        updateHiddenFields();

                        const counts = skillGroups.map(g => $(g.css + ':checked').length);
                        const total = counts.reduce((a, b) => a + b, 0);
                        const categories = counts.filter(c => c > 0).length;

                        let message = '';

                        if (total === 0) {
                            message = 'Please select at least one skill.';
                        } else if (categories > 1) {
                            message = 'You can select skills from only one skill category: Medical, Technical, or Non Technical.';
                        }

                        if (message) {
                            e.preventDefault();
                            $('#skillValidationMessage').text(message).show()
                                .get(0).scrollIntoView({ behavior: 'smooth', block: 'center' });
                            return false;
                        }

                        $('#skillValidationMessage').hide();
                        $('#btnUpdateSkills').prop('disabled', true);
                        $('#updateSkillsText').text('Updating...');
                        $('#updateSkillsLoader').show();
                    });

                    document.querySelectorAll('.skill-accordion').forEach(function (acc) {
                        acc.addEventListener('toggle', function () {
                            const arrow = acc.querySelector('.accordion-arrow');
                            if (arrow) arrow.innerHTML = acc.open ? '▴' : '▾';
                        });
                    });

                    // Initialise on page load (saved skills)
                    updateHiddenFields();
                    updateSkillCategoryState();

                });

                /* =====================================================
           RESUME PROFILE - SHOW MORE
           ===================================================== */

        function updateShowMoreButton() {
            if ($('.resume-option.is-hidden').length === 0) {
                $('#btnShowMoreResume').hide();
            }
        }

        $('#btnShowMoreResume').on('click', function () {

            const pageSize = parseInt($(this).data('page-size')) || 8;

            $('.resume-option.is-hidden').slice(0, pageSize).removeClass('is-hidden');

            updateShowMoreButton();
        });

        // If the saved choice is in a hidden group (e.g. r10), reveal it on load
        $('.resume-option.is-hidden').has('input:checked').each(function () {

            const pageSize = parseInt($('#btnShowMoreResume').data('page-size')) || 8;

            while ($('.resume-option.is-hidden').has('input:checked').length > 0) {
                $('.resume-option.is-hidden').slice(0, pageSize).removeClass('is-hidden');
            }
        });

        updateShowMoreButton();

    </script>

    <script>

        $(document).ready(function () {

            // Move the modal out of the layout wrapper (its position/z-index traps
            // the modal underneath Bootstrap's backdrop).
            $('#objectiveDraftModal').appendTo('body');

            function getDraftModal() {
                return bootstrap.Modal.getOrCreateInstance(
                    document.getElementById('objectiveDraftModal')
                );
            }

            function escapeHtml(value) {
                if (value === null || value === undefined) { return ''; }
                return $('<div>').text(value).html();
            }

            function escapeAttribute(value) {
                if (value === null || value === undefined) { return ''; }
                return String(value)
                    .replace(/&/g, '&amp;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;');
            }

            function showDraftMessage(type, text) {
                $('#objectiveDraftMessage')
                    .removeClass('d-none alert-info alert-danger')
                    .addClass(type === 'error' ? 'alert-danger' : 'alert-info')
                    .text(text);
            }


            /* =====================================================
               OPEN OBJECTIVE DRAFT (filtered by gender)
               ===================================================== */

            $('#btnObjectiveDraft').on('click', function () {

                const genderID = $('#ObjectiveGender').val();

                if (!genderID) {
                    alert('Please select Gender first.');
                    $('#ObjectiveGender').focus();
                    return;
                }

                // Reset modal
                $('#objectiveDraftLoading').removeClass('d-none');
                $('#objectiveDraftMessage').addClass('d-none').text('');
                $('#objectiveDraftHint').addClass('d-none');
                $('#objectiveDraftTableContainer').addClass('d-none');
                $('#objectiveDraftTableBody').empty();

                getDraftModal().show();

                $.ajax({
                    url: '@Url.Action("GetCareerObjectives", "Candidate")',
                    type: 'GET',
                    data: { genderID: genderID },
                    cache: false,

                    success: function (response) {

                        $('#objectiveDraftLoading').addClass('d-none');

                        if (!response || !response.success) {
                            showDraftMessage('error',
                                response && response.message
                                    ? response.message
                                    : 'Unable to load career objective drafts.');
                            return;
                        }

                        if (!response.objectives || response.objectives.length === 0) {
                            showDraftMessage('info',
                                'No career objective drafts are available for the selected gender.');
                            return;
                        }

                        let html = '';

                        $.each(response.objectives, function (index, item) {

                            const text = item.sObjective || item.SObjective || item.objective || '';

                            html += `
                                <tr class="objective-draft-row"
                                    data-objective="${escapeAttribute(text)}">
                                    <td class="objective-draft-number text-center">${index + 1}</td>
                                    <td class="objective-draft-text">${escapeHtml(text)}</td>
                                </tr>
                            `;
                        });

                        $('#objectiveDraftTableBody').html(html);
                        $('#objectiveDraftTableContainer').removeClass('d-none');
                        $('#objectiveDraftHint').removeClass('d-none');
                    },

                    error: function (xhr) {
                        console.log('GetCareerObjectives error:', xhr.status, xhr.responseText);
                        $('#objectiveDraftLoading').addClass('d-none');
                        showDraftMessage('error', 'Unable to load career objective drafts.');
                    }
                });
            });


            /* =====================================================
               SELECT OBJECTIVE (click a row)
               ===================================================== */

            $(document).on('click', '.objective-draft-row', function () {

                const objective = $(this).attr('data-objective') || '';

                $('#CareerObjective').val(objective).trigger('input');

                getDraftModal().hide();

                $('#CareerObjective').focus();
            });


            /* =====================================================
               CAREER OBJECTIVE VALIDATION
               ===================================================== */

            $('#objectiveForm').on('submit', function (e) {

                const objective = $('#CareerObjective').val().trim();

                if (objective.length < 20) {
                    e.preventDefault();
                    alert('Career Objective must contain at least 20 characters.');
                    $('#CareerObjective').focus();
                    return false;
                }
            });

        });

    </script>

}
