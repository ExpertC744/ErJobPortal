@model ErJobPortal.Models.CandidateProfileViewModel

@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/Profile.css" asp-append-version="true" />

@using Microsoft.AspNetCore.Mvc.Rendering

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Candidate Profile";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

<div class="candidate-profile-page">

    <!-- ========================= PROFILE HERO ========================= -->
    <div class="candidate-profile-hero">
        <div class="candidate-profile-brand">
            <div class="brand-mark">IT</div>
            <span>1Trainee</span>
        </div>

        <div class="hero-profile-chip">
            <span class="hero-avatar">JD</span>
            <span>Edit Candidate Profile</span>
        </div>

        <div class="hero-content">
            <div class="hero-kicker">CANDIDATE PROFILE</div>
            <h1>Edit your profile</h1>
            <p>
                Keep your profile complete and up to date so employers can understand
                your education, skills, experience and career interests.
            </p>
        </div>
    </div>

    <div class="candidate-profile-layout">

        <!-- ===================== LEFT SECTION NAVIGATION ===================== -->
        <aside class="profile-section-sidebar">

            <nav class="profile-section-nav" aria-label="Candidate profile sections">

                <a href="#section-candidate-profile" class="profile-nav-item active" data-section="section-candidate-profile">
                    <span class="nav-number">01</span><span>Candidate Profile</span>
                </a>
                <a href="#section-address" class="profile-nav-item" data-section="section-address">
                    <span class="nav-number">02</span><span>Address</span>
                </a>
                <a href="#section-education" class="profile-nav-item" data-section="section-education">
                    <span class="nav-number">03</span><span>Education</span>
                </a>
                <a href="#section-preference" class="profile-nav-item" data-section="section-preference">
                    <span class="nav-number">04</span><span>Internship / Fellowship Preference</span>
                </a>
                <a href="#section-documents" class="profile-nav-item" data-section="section-documents">
                    <span class="nav-number">05</span><span>Documents &amp; Personal Details</span>
                </a>
                <a href="#section-internship-details" class="profile-nav-item" data-section="section-internship-details">
                    <span class="nav-number">06</span><span>Internship Details</span>
                </a>
                <a href="#section-languages" class="profile-nav-item" data-section="section-languages">
                    <span class="nav-number">07</span><span>Languages Known</span>
                </a>
                <a href="#section-references" class="profile-nav-item" data-section="section-references">
                    <span class="nav-number">08</span><span>References</span>
                </a>
                <a href="#section-achievements" class="profile-nav-item" data-section="section-achievements">
                    <span class="nav-number">09</span><span>Achievements / Certifications</span>
                </a>
                <a href="#section-social" class="profile-nav-item" data-section="section-social">
                    <span class="nav-number">10</span><span>Social Links</span>
                </a>
                <a href="#section-objective" class="profile-nav-item" data-section="section-objective">
                    <span class="nav-number">11</span><span>Career Objective</span>
                </a>
                <a href="#section-resume" class="profile-nav-item" data-section="section-resume">
                    <span class="nav-number">12</span><span>Resume Profile</span>
                </a>
                <a href="#section-skills" class="profile-nav-item" data-section="section-skills">
                    <span class="nav-number">13</span><span>Skills</span>
                </a>

            </nav>

            <div class="profile-required-note">
                Fields marked <strong>*</strong> are required.
            </div>
        </aside>

        <!-- ========================== RIGHT CONTENT ========================== -->
        <main class="profile-sections-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- ======================= PROFILE HEADER ======================= -->
            <div class="card mb-4 profile-section-card" id="section-candidate-profile">
                <div class="card-header">
                    <h4 class="mb-0">Candidate Profile</h4>
                </div>
            </div>


            <!-- ========================== ADDRESS ========================== -->
            <div class="card mb-4 profile-section-card" id="section-address">

                <div class="card-header">
                    <h4 class="mb-0">Address</h4>
                </div>

                <div class="card-body">

                    <form id="addressForm" asp-action="UpdateAddress" asp-controller="Candidate" method="post">

                        @Html.AntiForgeryToken()

                        <div class="row">

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.CountryID" class="form-label">
                                    Country <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Profile.CountryID" class="form-control" id="CountryID" required>
                                    <option value="">-- Select Country --</option>
                                </select>
                                <span asp-validation-for="Profile.CountryID" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.StateID" class="form-label">
                                    State <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Profile.StateID" class="form-control" id="StateID" disabled required>
                                    <option value="">-- Select State --</option>
                                </select>
                                <span asp-validation-for="Profile.StateID" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.CityID" class="form-label">
                                    City <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Profile.CityID" class="form-control" id="CityID" disabled required>
                                    <option value="">-- Select City --</option>
                                </select>
                                <span asp-validation-for="Profile.CityID" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Pincode" class="form-label">
                                    Pincode <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Profile.Pincode"
                                       id="Pincode"
                                       class="form-control"
                                       placeholder="Enter 6 digit Pincode"
                                       maxlength="6"
                                       minlength="6"
                                       pattern="[0-9]{6}"
                                       inputmode="numeric"
                                       required />
                                <span asp-validation-for="Profile.Pincode" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Update Address</button>
                        </div>

                    </form>

                </div>

            </div>


            <!-- ========================= EDUCATION ========================= -->
            <div class="card mb-4 profile-section-card" id="section-education">

                <div class="card-header">
                    <h4 class="mb-0">Education</h4>
                </div>

                <div class="card-body">

                    <form id="educationForm" asp-action="UpdateEducation" asp-controller="Candidate" method="post">

                        @Html.AntiForgeryToken()

                        <!-- SSC -->
                        <h5>SSC / 10th</h5>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.SSC_YEAR" class="form-label">SSC Year</label>
                                <input asp-for="Profile.SSC_YEAR" type="number" class="form-control education-year" min="1950" max="2099" placeholder="YYYY" />
                                <span asp-validation-for="Profile.SSC_YEAR" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.SSC_DIVISION" class="form-label">SSC Division</label>
                                <select asp-for="Profile.SSC_DIVISION" class="form-control"
                                        asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">
                                    <option value="">-- Select Division --</option>
                                </select>
                                <span asp-validation-for="Profile.SSC_DIVISION" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <!-- HSC -->
                        <h5>HSC / Diploma</h5>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.HSC_DIPLOMA_YEAR" class="form-label">HSC / Diploma Year</label>
                                <input asp-for="Profile.HSC_DIPLOMA_YEAR" type="number" class="form-control education-year" min="1950" max="2099" placeholder="YYYY" />
                                <span asp-validation-for="Profile.HSC_DIPLOMA_YEAR" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.HSC_DIPLOMA_DIVISION" class="form-label">HSC / Diploma Division</label>
                                <select asp-for="Profile.HSC_DIPLOMA_DIVISION" class="form-control"
                                        asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">
                                    <option value="">-- Select Division --</option>
                                </select>
                                <span asp-validation-for="Profile.HSC_DIPLOMA_DIVISION" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <!-- GRADUATION -->
                        <h5>Graduation</h5>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Graduation_Year" class="form-label">Graduation Year</label>
                                <input asp-for="Profile.Graduation_Year" type="number" class="form-control education-year" min="1950" max="2099" placeholder="YYYY" />
                                <span asp-validation-for="Profile.Graduation_Year" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Graduation_Division" class="form-label">Graduation Division</label>
                                <select asp-for="Profile.Graduation_Division" class="form-control"
                                        asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">
                                    <option value="">-- Select Division --</option>
                                </select>
                                <span asp-validation-for="Profile.Graduation_Division" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Graduation_Stream" class="form-label">Graduation Stream</label>
                                <select asp-for="Profile.Graduation_Stream" class="form-control"
                                        asp-items="@(new SelectList(Model.Streams, "ID", "Name"))">
                                    <option value="">-- Select Stream --</option>
                                </select>
                                <span asp-validation-for="Profile.Graduation_Stream" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Other_Stream" class="form-label">Other Stream</label>
                                <input asp-for="Profile.Other_Stream" class="form-control" maxlength="100" />
                                <span asp-validation-for="Profile.Other_Stream" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <!-- PG -->
                        <h5>Post Graduation</h5>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.PG_Year" class="form-label">PG Year</label>
                                <input asp-for="Profile.PG_Year" type="number" class="form-control education-year" min="1950" max="2099" placeholder="YYYY" />
                                <span asp-validation-for="Profile.PG_Year" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.PG_Division" class="form-label">PG Division</label>
                                <select asp-for="Profile.PG_Division" class="form-control"
                                        asp-items="@(new SelectList(Model.Divisions, "ID", "Name"))">
                                    <option value="">-- Select Division --</option>
                                </select>
                                <span asp-validation-for="Profile.PG_Division" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.PG_Stream" class="form-label">PG Stream</label>
                                <select asp-for="Profile.PG_Stream" class="form-control"
                                        asp-items="@(new SelectList(Model.Streams, "ID", "Name"))">
                                    <option value="">-- Select Stream --</option>
                                </select>
                                <span asp-validation-for="Profile.PG_Stream" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Other_Specialization" class="form-label">Other Specialization</label>
                                <input asp-for="Profile.Other_Specialization" class="form-control" maxlength="150" />
                                <span asp-validation-for="Profile.Other_Specialization" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />

                        <!-- PHD -->
                        <h5>PhD</h5>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.PhD_Year" class="form-label">PhD Year</label>
                                <input asp-for="Profile.PhD_Year" type="number" class="form-control education-year" min="1950" max="2099" placeholder="YYYY" />
                                <span asp-validation-for="Profile.PhD_Year" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.PhD_Status" class="form-label">PhD Status</label>
                                <select asp-for="Profile.PhD_Status" class="form-control"
                                        asp-items="@(new SelectList(Model.GraduationStatuses, "ID", "Name"))">
                                    <option value="">-- Select Status --</option>
                                </select>
                                <span asp-validation-for="Profile.PhD_Status" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.PhD_Topic" class="form-label">PhD Topic</label>
                                <input asp-for="Profile.PhD_Topic" class="form-control" maxlength="200" />
                                <span asp-validation-for="Profile.PhD_Topic" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Previous_PhD_Topic_Year" class="form-label">Previous PhD Topic / Year</label>
                                <input asp-for="Profile.Previous_PhD_Topic_Year" class="form-control" maxlength="200" />
                                <span asp-validation-for="Profile.Previous_PhD_Topic_Year" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Update Education</button>
                        </div>

                    </form>

                </div>

            </div>


            <!-- ============ INTERNSHIP / FELLOWSHIP PREFERENCE ============ -->
            <div class="card mb-4 profile-section-card" id="section-preference">

                <div class="card-header">
                    <h5 class="mb-0">Internship / Fellowship Preference</h5>
                </div>

                <div class="card-body">

                    <form id="preferenceForm" asp-action="UpdateInternshipPreference" asp-controller="Candidate" method="post">

                        @Html.AntiForgeryToken()

                        <div class="row">

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Internship_FellowshipType" class="form-label">
                                    Internship / Fellowship Type <span class="text-danger">*</span>
                                </label>
                                <select asp-for="Profile.Internship_FellowshipType"
                                        class="form-control"
                                        asp-items="@(new SelectList(Model.InternshipFellowshipType, "ID", "Name"))"
                                        required>
                                    <option value="">-- Select Type --</option>
                                </select>
                                <span asp-validation-for="Profile.Internship_FellowshipType" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Preferred_Country" class="form-label">Preferred Country</label>
                                <input asp-for="Profile.Preferred_Country" class="form-control" maxlength="100" />
                                <span asp-validation-for="Profile.Preferred_Country" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Preferred_State" class="form-label">Preferred State</label>
                                <input asp-for="Profile.Preferred_State" class="form-control" maxlength="100" />
                                <span asp-validation-for="Profile.Preferred_State" class="text-danger"></span>
                            </div>

                            <div class="col-md-3 mb-3">
                                <label asp-for="Profile.Preferred_City" class="form-label">Preferred City</label>
                                <input asp-for="Profile.Preferred_City" class="form-control" maxlength="100" />
                                <span asp-validation-for="Profile.Preferred_City" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="text-end">
                            <button type="submit" class="btn btn-primary">Update Preference</button>
                        </div>

                    </form>

                </div>

            </div>


            <!-- ============== DOCUMENTS & PERSONAL DETAILS ============== -->
            <div class="card mb-4 profile-section-card" id="section-documents">

                <div class="card-header">
                    <h5 class="mb-0">Documents &amp; Personal Details</h5>
                </div>

                <div class="card-body">

                    <form id="documentsForm"
                          asp-controller="Candidate"
                          asp-action="UpdateDocuments"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div class="row">

                            <!-- RESUME -->
                            <div class="col-md-4 mb-4">

                                <label for="ResumeFile" class="form-label fw-bold">Resume</label>

                                <input type="file" name="ResumeFile" id="ResumeFile" class="form-control" accept=".pdf,.doc,.docx" />

                                <small class="text-muted d-block mt-1">
                                    Allowed: PDF, DOC, DOCX. Maximum 5 MB.
                                </small>

                                <div id="resumeError" class="text-danger mt-1"></div>

                                @if (!string.IsNullOrEmpty(Model.Profile?.sResume))
                                {
                                    <div class="mt-3">
                                        <small class="text-success d-block">
                                            <i class="fas fa-check-circle"></i>
                                            Resume already uploaded
                                        </small>

                                        <a href="@Model.Profile.sResume" target="_blank" class="btn btn-sm btn-outline-primary mt-2">
                                            <i class="fas fa-eye me-1"></i>
                                            View Resume
                                        </a>
                                    </div>
                                }

                            </div>

                            <!-- PHOTO -->
                            <div class="col-md-4 mb-4">

                                <label for="PhotoFile" class="form-label fw-bold">Photo</label>

                                <input type="file" name="PhotoFile" id="PhotoFile" class="form-control" accept=".jpg,.jpeg,.png" />

                                <small class="text-muted d-block mt-1">
                                    Allowed: JPG, JPEG, PNG. Maximum 5 MB.
                                </small>

                                <div id="photoError" class="text-danger mt-1"></div>

                                <div id="photoPreviewContainer" class="mt-3 d-none">
                                    <label class="form-label fw-bold mb-2">New Photo Preview</label>
                                    <div>
                                        <img id="photoPreview" src="" alt="New Photo Preview"
                                             style="width:120px; height:120px; object-fit:cover; border:1px solid #dee2e6; border-radius:6px; padding:3px; background:#fff;" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Profile?.sPhoto))
                                {
                                    <div class="mt-3">
                                        <small class="text-success d-block">
                                            <i class="fas fa-check-circle"></i>
                                            Photo already uploaded
                                        </small>

                                        <img src="@Model.Profile.sPhoto" alt="Existing Photo" class="mt-2"
                                             style="width:120px; height:120px; object-fit:cover; border:1px solid #dee2e6; border-radius:6px; padding:3px; background:#fff;" />
                                    </div>
                                }

                            </div>

                            <!-- SIGNATURE -->
                            <div class="col-md-4 mb-4">

                                <label for="SignatureFile" class="form-label fw-bold">Signature</label>

                                <input type="file" name="SignatureFile" id="SignatureFile" class="form-control" accept=".jpg,.jpeg,.png" />

                                <small class="text-muted d-block mt-1">
                                    Allowed: JPG, JPEG, PNG. Maximum 5 MB.
                                </small>

                                <div id="signatureError" class="text-danger mt-1"></div>

                                <div id="signaturePreviewContainer" class="mt-3 d-none">
                                    <label class="form-label fw-bold mb-2">New Signature Preview</label>
                                    <div>
                                        <img id="signaturePreview" src="" alt="New Signature Preview"
                                             style="width:200px; height:80px; object-fit:contain; border:1px solid #dee2e6; border-radius:6px; padding:5px; background:#fff;" />
                                    </div>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Profile?.sSignature))
                                {
                                    <div class="mt-3">
                                        <small class="text-success d-block">
                                            <i class="fas fa-check-circle"></i>
                                            Signature already uploaded
                                        </small>

                                        <img src="@Model.Profile.sSignature" alt="Existing Signature" class="mt-2"
                                             style="width:200px; height:80px; object-fit:contain; border:1px solid #dee2e6; border-radius:6px; padding:5px; background:#fff;" />
                                    </div>
                                }

                            </div>

                        </div>

                        <!-- PERSONAL DETAILS -->
                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Profile.sDivyang" class="form-label fw-bold">
                                    Divyang <span class="text-danger">*</span>
                                </label>

                                <select asp-for="Profile.sDivyang" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="Yes">Yes</option>
                                    <option value="No">No</option>
                                </select>

                                <span asp-validation-for="Profile.sDivyang" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Profile.sHobbies" class="form-label fw-bold">Hobbies</label>

                                <input asp-for="Profile.sHobbies" class="form-control" maxlength="300" placeholder="Enter your hobbies" />

                                <span asp-validation-for="Profile.sHobbies" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-primary" id="btnUpdateDocuments">
                                <i class="fas fa-save me-1"></i>
                                Update Personal Details
                            </button>
                        </div>

                    </form>

                </div>

            </div>

            <!-- ========== DOCUMENT VALIDATION & PREVIEW SCRIPT ========== -->
            <script>

                $(document).ready(function () {

                    const MAX_FILE_SIZE = 5 * 1024 * 1024;

                    // RESUME VALIDATION
                    $('#ResumeFile').on('change', function () {

                        const file = this.files[0];

                        $('#resumeError').text('');

                        if (!file) { return; }

                        if (file.size > MAX_FILE_SIZE) {
                            $('#resumeError').text('Resume size must not exceed 5 MB.');
                            this.value = '';
                            return;
                        }

                        const fileName = file.name.toLowerCase();
                        const allowedExtensions = ['.pdf', '.doc', '.docx'];

                        const isValid = allowedExtensions.some(function (extension) {
                            return fileName.endsWith(extension);
                        });

                        if (!isValid) {
                            $('#resumeError').text('Only PDF, DOC and DOCX files are allowed.');
                            this.value = '';
                            return;
                        }
                    });


                    // IMAGE VALIDATION + PREVIEW (shared by photo and signature)
                    function bindImagePreview(inputId, errorId, containerId, previewId, label) {

                        $('#' + inputId).on('change', function () {

                            const file = this.files[0];

                            $('#' + errorId).text('');

                            if (!file) {
                                $('#' + containerId).addClass('d-none');
                                $('#' + previewId).attr('src', '');
                                return;
                            }

                            if (file.size > MAX_FILE_SIZE) {
                                $('#' + errorId).text(label + ' size must not exceed 5 MB.');
                                this.value = '';
                                $('#' + containerId).addClass('d-none');
                                $('#' + previewId).attr('src', '');
                                return;
                            }

                            const allowedTypes = ['image/jpeg', 'image/png'];

                            if (!allowedTypes.includes(file.type)) {
                                $('#' + errorId).text('Only JPG, JPEG and PNG files are allowed.');
                                this.value = '';
                                $('#' + containerId).addClass('d-none');
                                $('#' + previewId).attr('src', '');
                                return;
                            }

                            const reader = new FileReader();

                            reader.onload = function (event) {
                                $('#' + previewId).attr('src', event.target.result);
                                $('#' + containerId).removeClass('d-none');
                            };

                            reader.onerror = function () {
                                $('#' + errorId).text('Unable to preview the selected ' + label.toLowerCase() + '.');
                                $('#' + containerId).addClass('d-none');
                            };

                            reader.readAsDataURL(file);
                        });
                    }

                    bindImagePreview('PhotoFile', 'photoError', 'photoPreviewContainer', 'photoPreview', 'Photo');
                    bindImagePreview('SignatureFile', 'signatureError', 'signaturePreviewContainer', 'signaturePreview', 'Signature');


                    // FORM SUBMIT VALIDATION
                    $('#documentsForm').on('submit', function (e) {

                        let isValid = true;

                        $('#resumeError').text('');
                        $('#photoError').text('');
                        $('#signatureError').text('');

                        // RESUME
                        const resumeFile = $('#ResumeFile')[0].files[0];

                        if (resumeFile) {

                            if (resumeFile.size > MAX_FILE_SIZE) {
                                $('#resumeError').text('Resume size must not exceed 5 MB.');
                                isValid = false;
                            }

                            const resumeName = resumeFile.name.toLowerCase();
                            const validResume = ['.pdf', '.doc', '.docx'].some(function (extension) {
                                return resumeName.endsWith(extension);
                            });

                            if (!validResume) {
                                $('#resumeError').text('Only PDF, DOC and DOCX files are allowed.');
                                isValid = false;
                            }
                        }

                        // PHOTO
                        const photoFile = $('#PhotoFile')[0].files[0];

                        if (photoFile) {

                            if (photoFile.size > MAX_FILE_SIZE) {
                                $('#photoError').text('Photo size must not exceed 5 MB.');
                                isValid = false;
                            }

                            if (!['image/jpeg', 'image/png'].includes(photoFile.type)) {
                                $('#photoError').text('Only JPG, JPEG and PNG files are allowed.');
                                isValid = false;
                            }
                        }

                        // SIGNATURE
                        const signatureFile = $('#SignatureFile')[0].files[0];

                        if (signatureFile) {

                            if (signatureFile.size > MAX_FILE_SIZE) {
                                $('#signatureError').text('Signature size must not exceed 5 MB.');
                                isValid = false;
                            }

                            if (!['image/jpeg', 'image/png'].includes(signatureFile.type)) {
                                $('#signatureError').text('Only JPG, JPEG and PNG files are allowed.');
                                isValid = false;
                            }
                        }

                        if (!isValid) {
                            e.preventDefault();
                            return false;
                        }

                        $('#btnUpdateDocuments')
                            .prop('disabled', true)
                            .html('<i class="fas fa-spinner fa-spin me-1"></i> Updating...');
                    });

                });

            </script>


