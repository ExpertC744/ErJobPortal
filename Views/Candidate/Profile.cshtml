    var resumeExts = new[] { "jpeg", "jpg", "png", "webp" };

    // =========================================================
    // GET SAVED DEFAULT RESUME PROFILE
    // Resume_Profile contains 1, 2, 3...
    // =========================================================

    int savedResumeProfile =
        Model.Profile?.Resume_Profile ?? 1;

    // Finds the actual image file
    string FindResume(int n)
    {
        foreach (var ext in resumeExts)
        {
            var path = System.IO.Path.Combine(
                Env.WebRootPath,
                "Resume",
                $"r{n}.{ext}");

            if (System.IO.File.Exists(path))
                return $"r{n}.{ext}";
        }

        return $"r{n}.jpeg";
    }
}

