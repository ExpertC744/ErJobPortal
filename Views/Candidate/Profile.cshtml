<!-- ===================== SIDEBAR NAVIGATION SCRIPT ===================== -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const navItems = Array.from(document.querySelectorAll(".profile-nav-item"));
        const sections = navItems.map(item => document.getElementById(item.dataset.section)).filter(Boolean);
        if (!navItems.length || !sections.length) return;

        const isMobile = () => window.matchMedia("(max-width: 680px)").matches;

        function setActive(id) {
            navItems.forEach(item => {
                const active = item.dataset.section === id;
                item.classList.toggle("active", active);
                item.setAttribute("aria-current", active ? "true" : "false");
            });
        }

        function getOffset() {
            if (!isMobile()) return 24;
            const sidebar = document.querySelector(".profile-section-sidebar");
            return (sidebar ? sidebar.getBoundingClientRect().height : 0) + 16;
        }

        function scrollToSection(section, updateHash) {
            if (!section) return;
            const top = Math.max(0, window.scrollY + section.getBoundingClientRect().top - getOffset());
            window.scrollTo({ top, behavior: "smooth" });
            setActive(section.id);
            if (updateHash) history.replaceState(null, "", "#" + section.id);
        }

        navItems.forEach(item => {
            item.addEventListener("click", function (event) {
                event.preventDefault();
                scrollToSection(document.getElementById(item.dataset.section), true);
            });
        });

        let ticking = false;
        function updateActive() {
            const trigger = getOffset() + 35;
            let current = sections[0];
            let best = Infinity;
            sections.forEach(section => {
                const top = section.getBoundingClientRect().top;
                const distance = Math.abs(top - trigger);
                if (top <= trigger + 100 && distance < best) {
                    best = distance;
                    current = section;
                }
            });
            if (current) setActive(current.id);
            ticking = false;
        }

        window.addEventListener("scroll", function () {
            if (!ticking) {
                window.requestAnimationFrame(updateActive);
                ticking = true;
            }
        }, { passive: true });

        window.addEventListener("resize", updateActive);

        const hash = window.location.hash.substring(1);
        const initialSection = document.getElementById(hash);
        if (initialSection) {
            setActive(initialSection.id);
            setTimeout(() => scrollToSection(initialSection, false), 100);
        } else {
            updateActive();
        }
    });
</script>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function () {

            /* =====================================================
               ADDRESS
               ===================================================== */

            var selectedCountryID = '@(Model.Profile?.CountryID ?? "")';
            var selectedStateID   = '@(Model.Profile?.StateID ?? "")';
            var selectedCityID    = '@(Model.Profile?.CityID ?? "")';

            function loadCountries() {

                $.ajax({
                    url: '/Location/GetCountries',
                    type: 'GET',

                    success: function (data) {

                        $('#CountryID').empty();
                        $('#CountryID').append('<option value="">-- Select Country --</option>');

                        $.each(data, function (index, item) {
                            $('#CountryID').append(
                                $('<option>', { value: item.id, text: item.name })
                                    .attr('data-code', item.iso2)
                            );
                        });

                        if (selectedCountryID !== '') {
                            $('#CountryID').val(selectedCountryID).trigger('change');
                        }
                    },

                    error: function (xhr) {
                        console.log("Country Error:", xhr.responseText);
                    }
                });
            }

            $('#CountryID').change(function () {

                var countryID   = $(this).val();
                var countryCode = $('#CountryID option:selected').attr('data-code');

                $('#StateID').empty().append('<option value="">-- Select State --</option>');
                $('#CityID').empty().append('<option value="">-- Select City --</option>');
                $('#CityID').prop('disabled', true);

                if (!countryID || !countryCode) {
                    $('#StateID').prop('disabled', true);
                    return;
                }

                $('#StateID').prop('disabled', false);

                $.ajax({
                    url: '/Location/GetStates',
                    type: 'GET',
                    data: { countryCode: countryCode },

                    success: function (data) {

                        $('#StateID').empty().append('<option value="">-- Select State --</option>');

                        $.each(data, function (index, item) {

                            var stateCode = item.stateCode;

                            if (!stateCode && item.id) {
                                var parts = item.id.split(':');
                                stateCode = parts.length > 1 ? parts[1] : item.id;
                            }

                            $('#StateID').append(
                                $('<option>', { value: item.id, text: item.name })
                                    .attr('data-code', stateCode)
                            );
                        });

                        if (selectedStateID !== '') {
                            $('#StateID').val(selectedStateID).trigger('change');
                            selectedStateID = '';
                        }
                    },

                    error: function (xhr) {
                        console.log("State Error:", xhr.responseText);
                    }
                });
            });

            $('#StateID').change(function () {

                var stateID     = $(this).val();
                var stateCode   = $('#StateID option:selected').attr('data-code');
                var countryCode = $('#CountryID option:selected').attr('data-code');

                $('#CityID').empty().append('<option value="">-- Select City --</option>');

                if (!stateID || !stateCode || !countryCode) {
                    $('#CityID').prop('disabled', true);
                    return;
                }

                $('#CityID').prop('disabled', false);

                $.ajax({
                    url: '/Location/GetCities',
                    type: 'GET',
                    data: { countryCode: countryCode, stateCode: stateCode },

                    success: function (data) {

                        $('#CityID').empty().append('<option value="">-- Select City --</option>');

                        $.each(data, function (index, item) {
                            $('#CityID').append($('<option>', { value: item.id, text: item.name }));
                        });

                        if (selectedCityID !== '') {
                            $('#CityID').val(selectedCityID);
                            selectedCityID = '';
                        }
                    },

                    error: function (xhr) {
                        console.log("City Error:", xhr.responseText);
                    }
                });
            });

            $('#addressForm').on('submit', function (e) {

                // Disabled select controls are not posted. Enable them before validation/submission.
                $('#StateID').prop('disabled', false);
                $('#CityID').prop('disabled', false);

                if (!this.checkValidity()) {
                    e.preventDefault();
                    this.reportValidity();
                    return false;
                }
            });

            loadCountries();


            /* =====================================================
               PINCODE / MOBILE / EDUCATION YEAR
               ===================================================== */

            $('#Pincode').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 6);
            });

            $('.reference-mobile').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 10);
            });

            $('.education-year').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 4);
            });


            /* =====================================================
               DOCUMENT VALIDATION
               ===================================================== */

            function validateFile(inputId, errorId, allowedExtensions) {

                const input = document.getElementById(inputId);
                const error = document.getElementById(errorId);

                if (!input || !error) { return true; }

                error.innerText = '';

                if (!input.files || input.files.length === 0) { return true; }

                const file = input.files[0];
                const maxSize = 5 * 1024 * 1024;
                const extension = '.' + file.name.split('.').pop().toLowerCase();

                if (!allowedExtensions.includes(extension)) {
                    error.innerText = 'Invalid file type.';
                    input.value = '';
                    return false;
                }

                if (file.size > maxSize) {
                    error.innerText = 'File size must not exceed 5 MB.';
                    input.value = '';
                    return false;
                }

                return true;
            }

