@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function () {

            /* =====================================================
               ADDRESS
               ===================================================== */

            var selectedCountryID =
                '@(Model.Profile?.CountryID ?? "")';

            var selectedStateID =
                '@(Model.Profile?.StateID ?? "")';

            var selectedCityID =
                '@(Model.Profile?.CityID ?? "")';


            function loadCountries() {

                $.ajax({

                    url: '/Location/GetCountries',
                    type: 'GET',

                    success: function (data) {

                        $('#CountryID').empty();

                        $('#CountryID').append(
                            '<option value="">-- Select Country --</option>'
                        );

                        $.each(data, function (index, item) {

                            $('#CountryID').append(

                                $('<option>', {
                                    value: item.id,
                                    text: item.name
                                }).attr(
                                    'data-code',
                                    item.iso2
                                )

                            );

                        });


                        if (selectedCountryID !== '') {

                            $('#CountryID')
                                .val(selectedCountryID)
                                .trigger('change');

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "Country Error:",
                            xhr.responseText
                        );

                    }

                });

            }


            $('#CountryID').change(function () {

                var countryID =
                    $(this).val();

                var countryCode =
                    $('#CountryID option:selected')
                        .attr('data-code');


                $('#StateID')
                    .empty()
                    .append(
                        '<option value="">-- Select State --</option>'
                    );

                $('#CityID')
                    .empty()
                    .append(
                        '<option value="">-- Select City --</option>'
                    );

                $('#CityID')
                    .prop('disabled', true);


                if (!countryID || !countryCode) {

                    $('#StateID')
                        .prop('disabled', true);

                    return;
                }


                $('#StateID')
                    .prop('disabled', false);


                $.ajax({

                    url: '/Location/GetStates',
                    type: 'GET',

                    data: {
                        countryCode: countryCode
                    },

                    success: function (data) {

                        $('#StateID')
                            .empty()
                            .append(
                                '<option value="">-- Select State --</option>'
                            );


                        $.each(data, function (index, item) {

                            var stateCode =
                                item.stateCode;

                            if (!stateCode && item.id) {

                                var parts =
                                    item.id.split(':');

                                stateCode =
                                    parts.length > 1
                                        ? parts[1]
                                        : item.id;
                            }


                            $('#StateID').append(

                                $('<option>', {
                                    value: item.id,
                                    text: item.name
                                }).attr(
                                    'data-code',
                                    stateCode
                                )

                            );

                        });


                        if (selectedStateID !== '') {

                            $('#StateID')
                                .val(selectedStateID)
                                .trigger('change');

                            selectedStateID = '';

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "State Error:",
                            xhr.responseText
                        );

                    }

                });

            });


            $('#StateID').change(function () {

                var stateID =
                    $(this).val();

                var stateCode =
                    $('#StateID option:selected')
                        .attr('data-code');

                var countryCode =
                    $('#CountryID option:selected')
                        .attr('data-code');


                $('#CityID')
                    .empty()
                    .append(
                        '<option value="">-- Select City --</option>'
                    );


                if (!stateID ||
                    !stateCode ||
                    !countryCode) {

                    $('#CityID')
                        .prop('disabled', true);

                    return;
                }


                $('#CityID')
                    .prop('disabled', false);


                $.ajax({

                    url: '/Location/GetCities',
                    type: 'GET',

                    data: {

                        countryCode: countryCode,
                        stateCode: stateCode

                    },

                    success: function (data) {

                        $('#CityID')
                            .empty()
                            .append(
                                '<option value="">-- Select City --</option>'
                            );


                        $.each(data, function (index, item) {

                            $('#CityID').append(

                                $('<option>', {
                                    value: item.id,
                                    text: item.name
                                })

                            );

                        });


                        if (selectedCityID !== '') {

                            $('#CityID')
                                .val(selectedCityID);

                            selectedCityID = '';

                        }

                    },

                    error: function (xhr) {

                        console.log(
                            "City Error:",
                            xhr.responseText
                        );

                    }

                });

            });


            $('#addressForm').on('submit', function (e) {

                /*
                 * Disabled select controls are not posted.
                 * Enable them before validation/submission.
                 */

                $('#StateID')
                    .prop('disabled', false);

                $('#CityID')
                    .prop('disabled', false);


                if (!this.checkValidity()) {

                    e.preventDefault();

                    this.reportValidity();

                    return false;
                }

            });


            loadCountries();


            /* =====================================================
               PINCODE
               ===================================================== */

            $('#Pincode').on('input', function () {

                this.value =
                    this.value
                        .replace(/\D/g, '')
                        .substring(0, 6);

            });


            /* =====================================================
               REFERENCE MOBILE
               ===================================================== */

            $('.reference-mobile').on('input', function () {

                this.value =
                    this.value
                        .replace(/\D/g, '')
                        .substring(0, 10);

            });


            /* =====================================================
               EDUCATION YEAR
               ===================================================== */

            $('.education-year').on('input', function () {

                this.value =
                    this.value
                        .replace(/\D/g, '')
                        .substring(0, 4);

            });


            /* =====================================================
               DOCUMENT VALIDATION
               ===================================================== */

            function validateFile(
                inputId,
                errorId,
                allowedExtensions) {

                const input =
                    document.getElementById(inputId);

                const error =
                    document.getElementById(errorId);

                if (!input || !error) {
                    return true;
                }

                error.innerText = '';

                if (!input.files ||
                    input.files.length === 0) {

                    return true;
                }

                const file =
                    input.files[0];

                const maxSize =
                    5 * 1024 * 1024;

                const extension =
                    '.' +
                    file.name
                        .split('.')
                        .pop()
                        .toLowerCase();


                if (!allowedExtensions
                    .includes(extension)) {

                    error.innerText =
                        'Invalid file type.';

                    input.value = '';

                    return false;
                }


                if (file.size > maxSize) {

                    error.innerText =
                        'File size must not exceed 5 MB.';

                    input.value = '';

                    return false;
                }


                return true;
            }


            $('#ResumeFile').on('change', function () {

                validateFile(
                    'ResumeFile',
                    'resumeError',
                    ['.pdf', '.doc', '.docx']
                );

            });


            $('#PhotoFile').on('change', function () {

                validateFile(
                    'PhotoFile',
                    'photoError',
                    ['.jpg', '.jpeg', '.png']
                );

            });


            $('#SignatureFile').on('change', function () {

                validateFile(
                    'SignatureFile',
                    'signatureError',
                    ['.jpg', '.jpeg', '.png']
                );

            });


            $('#documentsForm').on('submit', function (e) {

                const resumeValid =
                    validateFile(
                        'ResumeFile',
                        'resumeError',
                        ['.pdf', '.doc', '.docx']
                    );

                const photoValid =
                    validateFile(
                        'PhotoFile',
                        'photoError',
                        ['.jpg', '.jpeg', '.png']
                    );

                const signatureValid =
                    validateFile(
                        'SignatureFile',
                        'signatureError',
                        ['.jpg', '.jpeg', '.png']
                    );


                if (!resumeValid ||
                    !photoValid ||
                    !signatureValid) {

                    e.preventDefault();

                    return false;
                }

            });


            /* =====================================================
               LANGUAGES
               ===================================================== */

            $('#languagesForm').on('submit', function (e) {

                let valid = true;
                let hasLanguage = false;


                $('.language-row').each(function () {

                    const language =
                        $(this)
                            .find('.language-input')
                            .val()
                            .trim();

                    const rating =
                        $(this)
                            .find('.language-rating')
                            .val();


                    if (language !== '') {

                        hasLanguage = true;

                        if (rating === '') {

                            valid = false;

                        }

                    }

                    if (rating !== '' &&
                        language === '') {

                        valid = false;

                    }

                });


                if (!hasLanguage || !valid) {

                    e.preventDefault();

                    $('#languageValidation')
                        .show();

                    $('#languageValidation')
                        .get(0)
                        .scrollIntoView({
                            behavior: 'smooth',
                            block: 'center'
                        });

                    return false;

                }


                $('#languageValidation')
                    .hide();

            });


            /* =====================================================
               SOCIAL URL VALIDATION
               ===================================================== */

            $('#socialForm').on('submit', function (e) {

                let valid = true;


                $('#socialForm input[type="url"]')
                    .each(function () {

                        const value =
                            $(this).val().trim();

                        if (value !== '') {

                            try {

                                new URL(value);

                            }
                            catch {

                                valid = false;

                                $(this).addClass(
                                    'is-invalid'
                                );

                            }

                        }

                    });


                if (!valid) {

                    e.preventDefault();

                    alert(
                        'Please enter valid social profile URLs.'
                    );

                    return false;

                }

            });


            /* =====================================================
               CAREER OBJECTIVE
               ===================================================== */

            $('#objectiveForm').on('submit', function (e) {

                const objective =
                    $('#CareerObjective')
                        .val()
                        .trim();


                if (objective.length < 20) {

                    e.preventDefault();

                    alert(
                        'Career Objective must contain at least 20 characters.'
                    );

                    $('#CareerObjective')
                        .focus();

                    return false;

                }

            });


            /* =====================================================
               SKILLS
               ===================================================== */

            function updateSkillCount(type) {

                let selector = "";
                let countElement = "";
                let hiddenField = "";


                if (type === "medical") {

                    selector =
                        ".medical-skill:checked";

                    countElement =
                        "medicalCount";

                    hiddenField =
                        "sMedicalSkillIDs";

                }
                else if (type === "technical") {

                    selector =
                        ".technical-skill:checked";

                    countElement =
                        "technicalCount";

                    hiddenField =
                        "sTechnicalSkillIDs";

                }
                else if (type === "nonTechnical") {

                    selector =
                        ".nontechnical-skill:checked";

                    countElement =
                        "nonTechnicalCount";

                    hiddenField =
                        "sNonTechnicalSkillIDs";
                }


                const selected =
                    document.querySelectorAll(selector);


                document.getElementById(
                    countElement
                ).innerText =
                    selected.length + " selected";


                const values = [];


                selected.forEach(function (checkbox) {

                    values.push(
                        checkbox.value
                    );

                });


                document.getElementById(
                    hiddenField
                ).value =
                    values.join(",");

            }


            function updateAllSkillCounts() {

                updateSkillCount("medical");
                updateSkillCount("technical");
                updateSkillCount("nonTechnical");

            }


            document.addEventListener(
                "change",
                function (event) {

                    if (
                        event.target.classList
                            .contains("medical-skill")
                    ) {

                        updateSkillCount("medical");

                    }


                    if (
                        event.target.classList
                            .contains("technical-skill")
                    ) {

                        updateSkillCount("technical");

                    }


                    if (
                        event.target.classList
                            .contains("nontechnical-skill")
                    ) {

                        updateSkillCount("nonTechnical");

                    }

                }
            );


            $('#skillsForm').on('submit', function (event) {

                updateAllSkillCounts();


                const total =
                    $('.medical-skill:checked').length +
                    $('.technical-skill:checked').length +
                    $('.nontechnical-skill:checked').length;


                if (total === 0) {

                    event.preventDefault();


                    $('#skillValidationMessage')
                        .show();


                    $('#skillValidationMessage')
                        .get(0)
                        .scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });


                    return false;

                }


                $('#skillValidationMessage')
                    .hide();


                const button =
                    $('#btnUpdateSkills');

                const text =
                    $('#updateSkillsText');

                const loader =
                    $('#updateSkillsLoader');


                button.prop(
                    'disabled',
                    true
                );

                text.text(
                    'Updating...'
                );

                loader.show();

            });


            /* =====================================================
               ACCORDION ARROW
               ===================================================== */

            document.querySelectorAll(
                ".skill-accordion"
            ).forEach(function (accordion) {

                accordion.addEventListener(
                    "toggle",
                    function () {

                        const arrow =
                            accordion.querySelector(
                                ".accordion-arrow"
                            );


                        if (!arrow) {
                            return;
                        }


                        arrow.innerHTML =
                            accordion.open
                                ? "▴"
                                : "▾";

                    }
                );

            });


            updateAllSkillCounts();

        });

    </script>
}

