                            <div class="skills-title">
                                <label>Select Skill Type <span class="text-danger">*</span></label>
                                <small class="text-muted d-block mt-1">
                                    Select skills from one category.
                                </small>
                            </div>

                            @foreach (var group in skillGroups)
                            {
                                <details class="skill-accordion" @(group.Open ? "open" : "")>

                                    <summary class="skill-header">
                                        <span class="skill-heading">@group.Title</span>
                                        <span class="skill-header-right">
                                            <span class="selected-count" id="@group.CountId">0 selected</span>
                                            <span class="accordion-arrow">@(group.Open ? "▴" : "▾")</span>
                                        </span>
                                    </summary>

                                    <div class="skill-body" id="@group.BodyId">

                                        @foreach (var skill in group.Skills)
