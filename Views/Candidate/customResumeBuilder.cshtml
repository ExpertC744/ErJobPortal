    <!-- JAVASCRIPT LOGIC -->
    <script>
        (() => {
            "use strict";

            /* DOM ELEMENTS */
            const canvas = document.getElementById("resumeCanvas");
            const canvasWrapper = document.getElementById("canvasWrapper");
            const propertiesEmpty = document.getElementById("propertiesEmpty");
            const propertyPanel = document.getElementById("propertyPanel");
            const selectedLabel = document.getElementById("selectedLabel");
            const zoomValue = document.getElementById("zoomValue");
            const orientationText = document.getElementById("orientationText");
            const toast = document.getElementById("toast");
            const previewOverlay = document.getElementById("previewOverlay");
            const previewContainer = document.getElementById("previewContainer");

            /* CONFIG & STATE */
            const A4 = {
                portrait: { width: 794, height: 1123 },
                landscape: { width: 1123, height: 794 }
            };

            const CONFIG = { grid: 2, minWidth: 2, minHeight: 2, zoom: 0.70 };

            let state = {
                selectedId: null,
                zoom: CONFIG.zoom,
                orientation: "portrait",
                template: "classic",
                snap: true,
                showGrid: false
            };

            let history = [];
            let historyIndex = -1;

            /* INIT */
            function init() {
                setOrientation(state.orientation, false);
                setZoom(state.zoom);
                applyTemplate(state.template);
                initializeSections();
                saveHistory();
                updatePropertyPanel();
            }

            function initializeSections() {
                canvas.querySelectorAll(".resume-section").forEach(section => {
                    ensureSectionDefaults(section);
                    attachSectionEvents(section);
                });
            }

            function ensureSectionDefaults(section) {
                if (!section.dataset.id) section.dataset.id = "section_" + Date.now();
                if (!section.dataset.type) section.dataset.type = "custom";
            }

            /* ATTACH EVENTS */
            function attachSectionEvents(section) {
                section.addEventListener("pointerdown", sectionPointerDown);
                section.querySelectorAll(".resize-handle").forEach(handle => {
                    handle.addEventListener("pointerdown", resizePointerDown);
                });
                section.querySelectorAll("[data-action]").forEach(button => {
                    button.addEventListener("click", sectionAction);
                });
            }

            /* SELECT SECTION */
            function selectSection(section) {
                document.querySelectorAll(".resume-section.selected").forEach(item => item.classList.remove("selected"));
                if (!section) {
                    state.selectedId = null;
                    updatePropertyPanel();
                    return;
                }
                section.classList.add("selected");
                state.selectedId = section.dataset.id;
                updatePropertyPanel();
            }

            /* DRAG & RESIZE ENGINE */
            let dragData = null;
            let resizeData = null;
            let pointerMoveBound = false;

            function getCanvasPercentDelta(clientX, clientY, startX, startY) {
                const rect = canvas.getBoundingClientRect();
                return {
                    x: ((clientX - startX) / rect.width) * 100,
                    y: ((clientY - startY) / rect.height) * 100
                };
            }

            function bindGlobalPointerEvents() {
                if (pointerMoveBound) return;
                document.addEventListener("pointermove", globalPointerMove);
                document.addEventListener("pointerup", globalPointerUp);
                document.addEventListener("pointercancel", globalPointerUp);
                pointerMoveBound = true;
            }

            function globalPointerMove(event) {
                if (dragData) moveSectionWithPointer(event);
                else if (resizeData) resizeSectionWithPointer(event);
            }

            function globalPointerUp() {
                if (dragData) finishDrag();
                if (resizeData) finishResize();
            }

            function sectionPointerDown(event) {
                if (event.button !== undefined && event.button !== 0) return;
                if (event.target.closest(".section-controls") || event.target.closest(".resize-handle")) return;

                const section = event.currentTarget;
                if (!section) return;
                event.preventDefault();
                selectSection(section);

                dragData = {
                    section,
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    initialLeft: parseFloat(section.style.left) || 0,
                    initialTop: parseFloat(section.style.top) || 0,
                    width: parseFloat(section.style.width) || 0,
                    height: parseFloat(section.style.height) || 0,
                    moved: false
                };
                section.classList.add("dragging");
                bindGlobalPointerEvents();
            }

            function moveSectionWithPointer(event) {
                if (!dragData) return;
                const delta = getCanvasPercentDelta(event.clientX, event.clientY, dragData.startX, dragData.startY);
                if (Math.abs(delta.x) < 0.1 && Math.abs(delta.y) < 0.1) return;

                dragData.moved = true;
                let left = dragData.initialLeft + delta.x;
                let top = dragData.initialTop + delta.y;

                if (state.snap) {
                    left = snapPercent(left);
                    top = snapPercent(top);
                }

                left = clamp(left, 0, 100 - dragData.width);
                top = clamp(top, 0, 100 - dragData.height);

                dragData.section.style.left = left + "%";
                dragData.section.style.top = top + "%";
                updatePropertyPanel();
                showAlignmentGuides(dragData.section);
            }

            function finishDrag() {
                if (!dragData) return;
                dragData.section.classList.remove("dragging");
                hideAlignmentGuides();
                if (dragData.moved) saveHistory();
                dragData = null;
            }

            function resizePointerDown(event) {
                if (event.button !== undefined && event.button !== 0) return;
                event.preventDefault();
                event.stopPropagation();

                const handle = event.currentTarget;
                const section = handle.closest(".resume-section");
                if (!section) return;
                selectSection(section);

                resizeData = {
                    section,
                    handle: [...handle.classList].find(c => ["nw", "n", "ne", "e", "se", "s", "sw", "w"].includes(c)) || "se",
                    pointerId: event.pointerId,
                    startX: event.clientX,
                    startY: event.clientY,
                    left: parseFloat(section.style.left) || 0,
                    top: parseFloat(section.style.top) || 0,
                    width: parseFloat(section.style.width) || 0,
                    height: parseFloat(section.style.height) || 0,
                    moved: false
                };
                section.classList.add("resizing");
                bindGlobalPointerEvents();
            }

            function resizeSectionWithPointer(event) {
                if (!resizeData) return;
                const delta = getCanvasPercentDelta(event.clientX, event.clientY, resizeData.startX, resizeData.startY);
                if (Math.abs(delta.x) < 0.05 && Math.abs(delta.y) < 0.05) return;

                resizeData.moved = true;
                let { left, top, width, height, handle } = resizeData;
                let right = left + width;
                let bottom = top + height;

                if (handle.includes("e")) right += delta.x;
                if (handle.includes("w")) left += delta.x;
                if (handle.includes("s")) bottom += delta.y;
                if (handle.includes("n")) top += delta.y;

                if (state.snap) {
                    left = snapPercent(left);
                    top = snapPercent(top);
                    right = snapPercent(right);
                    bottom = snapPercent(bottom);
                }

                left = clamp(left, 0, 95);
                top = clamp(top, 0, 95);
                right = clamp(right, left + CONFIG.minWidth, 100);
                bottom = clamp(bottom, top + CONFIG.minHeight, 100);

                resizeData.section.style.left = left + "%";
                resizeData.section.style.top = top + "%";
                resizeData.section.style.width = (right - left) + "%";
                resizeData.section.style.height = (bottom - top) + "%";

                updatePropertyPanel();
                showAlignmentGuides(resizeData.section);
            }

            function finishResize() {
                if (!resizeData) return;
                resizeData.section.classList.remove("resizing");
                hideAlignmentGuides();
                if (resizeData.moved) saveHistory();
                resizeData = null;
            }

            function snapPercent(val) {
                return Math.round(val / CONFIG.grid) * CONFIG.grid;
            }

            function clamp(val, min, max) {
                return Math.max(min, Math.min(max, val));
            }

            /* GUIDES */
            function showAlignmentGuides(section) {
                const x = parseFloat(section.style.left);
                const y = parseFloat(section.style.top);
                const width = parseFloat(section.style.width);
                const height = parseFloat(section.style.height);

                const vGuide = document.getElementById("verticalGuide");
                const hGuide = document.getElementById("horizontalGuide");

                vGuide.style.display = Math.abs((x + width / 2) - 50) <= 1.5 ? "block" : "none";
                if (vGuide.style.display === "block") vGuide.style.left = "50%";

                hGuide.style.display = Math.abs((y + height / 2) - 50) <= 1.5 ? "block" : "none";
                if (hGuide.style.display === "block") hGuide.style.top = "50%";
            }

            function hideAlignmentGuides() {
                document.getElementById("verticalGuide").style.display = "none";
                document.getElementById("horizontalGuide").style.display = "none";
            }

            /* =========================================================
               TEXT STYLES & TYPOGRAPHY ENGINE (DEEP PROPAGATION)
            ========================================================= */

            function applySectionTextStyle(section, prop, value) {
                if (!section) return;

                section.style[prop] = value;
                const content = section.querySelector('.section-content');

                if (content) {
                    content.style[prop] = value;
                    const children = content.querySelectorAll('*');
                    children.forEach(child => {
                        child.style[prop] = value;

                        // Align adjustments for flex layouts inside
                        if (prop === 'textAlign') {
                            const display = window.getComputedStyle(child).display;
                            if (display.includes('flex')) {
                                if (value === 'center') child.style.justifyContent = 'center';
                                else if (value === 'right') child.style.justifyContent = 'flex-end';
                                else if (value === 'justify') child.style.justifyContent = 'space-between';
                                else child.style.justifyContent = 'flex-start';
                            }
                        }
                    });
                }
            }

            function getSelectedSection() {
                return state.selectedId ? canvas.querySelector(`[data-id="${CSS.escape(state.selectedId)}"]`) : null;
            }

            function formatSectionName(type) {
                return type ? type.replace(/([A-Z])/g, " $1").replace(/^./, c => c.toUpperCase()) : "Section";
            }

            function updatePropertyPanel() {
                const section = getSelectedSection();
                if (!section) {
                    propertiesEmpty.style.display = "block";
                    propertyPanel.style.display = "none";
                    selectedLabel.textContent = "No selection";
                    return;
                }

                propertiesEmpty.style.display = "none";
                propertyPanel.style.display = "block";
                selectedLabel.textContent = formatSectionName(section.dataset.type);

                // Read position & dimensions
                setValue("propX", parseFloat(section.style.left) || 0);
                setValue("propY", parseFloat(section.style.top) || 0);
                setValue("propWidth", parseFloat(section.style.width) || 0);
                setValue("propHeight", parseFloat(section.style.height) || 0);
                setValue("propPadding", parseFloat(section.style.padding) || 0);
                setValue("propMargin", parseFloat(section.style.margin) || 0);

                // Computed and explicit styles
                const content = section.querySelector(".section-content") || section;
                const computed = getComputedStyle(content);

                const fontSize = section.style.fontSize ? parseFloat(section.style.fontSize) : parseFloat(computed.fontSize);
                setValue("propFontSize", fontSize || 11);

                const fontWeight = section.style.fontWeight || computed.fontWeight || "400";
                setValue("propFontWeight", fontWeight);

                const lineHeight = section.style.lineHeight || computed.lineHeight;
                setValue("propLineHeight", isNaN(parseFloat(lineHeight)) ? "" : parseFloat(lineHeight));

                const letterSpacing = section.style.letterSpacing ? parseFloat(section.style.letterSpacing) : 0;
                setValue("propLetterSpacing", letterSpacing);

                // Colors
                const colorHex = rgbToHex(section.style.color || computed.color);
                setValue("propColor", colorHex);
                setText("propColorHex", colorHex);

                const bgHex = rgbToHex(section.style.backgroundColor || computed.backgroundColor);
                setValue("propBackground", bgHex);
                setText("propBgHex", bgHex);

                // Border
                const borderWidth = parseFloat(section.style.borderWidth || computed.borderWidth) || 0;
                setValue("propBorderWidth", borderWidth);

                const radius = parseFloat(section.style.borderRadius || computed.borderRadius) || 0;
                setValue("propRadius", radius);

                const borderHex = rgbToHex(section.style.borderColor || computed.borderColor);
                setValue("propBorderColor", borderHex);
                setText("propBorderHex", borderHex);

                // Options
                document.getElementById("propSnap").checked = state.snap;
                document.getElementById("propVisible").checked = !section.classList.contains("hidden-section");

                // Update text decoration & formatting button active states
                updateTextFormatButtons(section, computed);
                updateAlignmentButtons(section.style.textAlign || computed.textAlign);
            }

            function setValue(id, val) {
                const el = document.getElementById(id);
                if (el) el.value = val ?? "";
            }

            function setText(id, text) {
                const el = document.getElementById(id);
                if (el) el.textContent = text ?? "";
            }

            /* TEXT FORMATTING BUTTON STATES */
            function updateTextFormatButtons(section, computed) {
                const weight = section.style.fontWeight || computed.fontWeight;
                const isBold = weight === "bold" || parseInt(weight) >= 700;
                document.getElementById("btnBold")?.classList.toggle("active", isBold);

                const fontStyle = section.style.fontStyle || computed.fontStyle;
                const isItalic = fontStyle === "italic";
                document.getElementById("btnItalic")?.classList.toggle("active", isItalic);

                const textDeco = section.style.textDecoration || computed.textDecoration;
                const isUnderline = textDeco.includes("underline");
                document.getElementById("btnUnderline")?.classList.toggle("active", isUnderline);

                const transform = section.style.textTransform || computed.textTransform;
                const isUppercase = transform === "uppercase";
                document.getElementById("btnUppercase")?.classList.toggle("active", isUppercase);
            }

            function updateAlignmentButtons(align) {
                document.querySelectorAll(".align-btn").forEach(b => {
                    b.classList.toggle("active", b.dataset.align === align);
                });
            }

            /* EVENT BINDINGS FOR INPUTS */

            // 1. Position & Dimensions
            bindInput("propX", (s, v) => s.style.left = clamp(parseFloat(v) || 0, 0, 100 - parseFloat(s.style.width)) + "%");
            bindInput("propY", (s, v) => s.style.top = clamp(parseFloat(v) || 0, 0, 100 - parseFloat(s.style.height)) + "%");
            bindInput("propWidth", (s, v) => s.style.width = clamp(parseFloat(v) || 2, 2, 100 - parseFloat(s.style.left)) + "%");
            bindInput("propHeight", (s, v) => s.style.height = clamp(parseFloat(v) || 2, 2, 100 - parseFloat(s.style.top)) + "%");

            // 2. Spacing
            bindInput("propPadding", (s, v) => s.style.padding = Math.max(0, parseFloat(v) || 0) + "px");
            bindInput("propMargin", (s, v) => s.style.margin = Math.max(0, parseFloat(v) || 0) + "px");

            // 3. Typography
            bindInput("propFontSize", (s, v) => applySectionTextStyle(s, "fontSize", Math.max(6, parseFloat(v) || 11) + "px"));
            bindInput("propFontWeight", (s, v) => applySectionTextStyle(s, "fontWeight", v));
            bindInput("propLineHeight", (s, v) => applySectionTextStyle(s, "lineHeight", v ? parseFloat(v) : ""));
            bindInput("propLetterSpacing", (s, v) => applySectionTextStyle(s, "letterSpacing", (parseFloat(v) || 0) + "px"));

            // 4. Colors & Appearance
            bindInput("propColor", (s, v) => {
                applySectionTextStyle(s, "color", v);
                setText("propColorHex", v.toUpperCase());
            });

            bindInput("propBackground", (s, v) => {
                s.style.backgroundColor = v;
                setText("propBgHex", v.toUpperCase());
            });

            // 5. Border & Radius
            bindInput("propBorderWidth", (s, v) => {
                const width = Math.max(0, parseFloat(v) || 0);
                s.style.borderWidth = width + "px";
                s.style.borderStyle = width > 0 ? "solid" : "none";
            });

            bindInput("propRadius", (s, v) => s.style.borderRadius = Math.max(0, parseFloat(v) || 0) + "px");

            bindInput("propBorderColor", (s, v) => {
                s.style.borderColor = v;
                setText("propBorderHex", v.toUpperCase());
            });

            function bindInput(id, callback) {
                const el = document.getElementById(id);
                if (!el) return;
                const handler = () => {
                    const section = getSelectedSection();
                    if (!section) return;
                    callback(section, el.value);
                    saveHistory();
                };
                el.addEventListener("input", handler);
                el.addEventListener("change", handler);
            }

            /* FORMATTING BUTTON TOGGLES */
            document.getElementById("btnBold")?.addEventListener("click", () => {
                const section = getSelectedSection();
                if (!section) return;
                const current = section.style.fontWeight || getComputedStyle(section).fontWeight;
                const next = (current === "bold" || parseInt(current) >= 700) ? "400" : "700";
                applySectionTextStyle(section, "fontWeight", next);
                setValue("propFontWeight", next);
                updatePropertyPanel();
                saveHistory();
            });

            document.getElementById("btnItalic")?.addEventListener("click", () => {
                const section = getSelectedSection();
                if (!section) return;
                const current = section.style.fontStyle || getComputedStyle(section).fontStyle;
                const next = current === "italic" ? "normal" : "italic";
                applySectionTextStyle(section, "fontStyle", next);
                updatePropertyPanel();
                saveHistory();
            });

            document.getElementById("btnUnderline")?.addEventListener("click", () => {
                const section = getSelectedSection();
                if (!section) return;
                const current = section.style.textDecoration || getComputedStyle(section).textDecoration;
                const next = current.includes("underline") ? "none" : "underline";
                applySectionTextStyle(section, "textDecoration", next);
                updatePropertyPanel();
                saveHistory();
            });

            document.getElementById("btnUppercase")?.addEventListener("click", () => {
                const section = getSelectedSection();
                if (!section) return;
                const current = section.style.textTransform || getComputedStyle(section).textTransform;
                const next = current === "uppercase" ? "none" : "uppercase";
                applySectionTextStyle(section, "textTransform", next);
                updatePropertyPanel();
                saveHistory();
            });

            /* ALIGNMENT BUTTONS */
            document.querySelectorAll(".align-btn").forEach(btn => {
                btn.addEventListener("click", () => {
                    const section = getSelectedSection();
                    if (!section) return;
                    const align = btn.dataset.align;
                    applySectionTextStyle(section, "textAlign", align);
                    updateAlignmentButtons(align);
                    saveHistory();
                });
            });

            /* TOGGLES */
            document.getElementById("propSnap").addEventListener("change", e => state.snap = e.target.checked);
            document.getElementById("propVisible").addEventListener("change", e => {
                const section = getSelectedSection();
                if (section) {
                    section.classList.toggle("hidden-section", !e.target.checked);
                    saveHistory();
                }
            });

            /* ACTIONS */
            function sectionAction(event) {
                event.stopPropagation();
                const action = event.currentTarget.dataset.action;
                const section = event.currentTarget.closest(".resume-section");
                if (!section) return;

                if (action === "duplicate") duplicateSection(section);
                else if (action === "hide") { section.classList.toggle("hidden-section"); updatePropertyPanel(); saveHistory(); }
                else if (action === "delete") deleteSection(section);
            }

            function duplicateSection(original) {
                const clone = original.cloneNode(true);
                clone.dataset.id = original.dataset.type + "_" + Date.now();
                clone.style.left = Math.min(parseFloat(original.style.left) + 2, 90) + "%";
                clone.style.top = Math.min(parseFloat(original.style.top) + 2, 90) + "%";
                original.after(clone);
                attachSectionEvents(clone);
                selectSection(clone);
                saveHistory();
            }

            function deleteSection(section) {
                if (confirm("Delete this section from the layout?")) {
                    section.remove();
                    state.selectedId = null;
                    updatePropertyPanel();
                    saveHistory();
                }
            }

            /* ADD SECTION */
            document.querySelectorAll(".section-item").forEach(button => {
                button.addEventListener("click", () => addSection(button.dataset.section));
            });

            function addSection(type) {
                const existing = canvas.querySelector(`.resume-section[data-type="${type}"]`);
                if (existing) {
                    selectSection(existing);
                    showToast("Section already exists on canvas.");
                    return;
                }

                const section = document.createElement("div");
                section.className = "resume-section classic-section";
                section.dataset.id = type + "_" + Date.now();
                section.dataset.type = type;
                section.style.left = "38%";
                section.style.top = "40%";
                section.style.width = "58%";
                section.style.height = "12%";
                section.style.padding = "8px";

                section.innerHTML = `
                    <div class="section-controls">
                        <button data-action="moveUp">↑</button>
                        <button data-action="moveDown">↓</button>
                        <button data-action="duplicate">⧉</button>
                        <button data-action="hide">◉</button>
                        <button data-action="delete">×</button>
                    </div>
                    <div class="section-content">
                        <div class="classic-heading">${formatSectionName(type)}</div>
                        <div class="classic-text">New ${type} details...</div>
                    </div>
                    <span class="resize-handle nw"></span><span class="resize-handle n"></span>
                    <span class="resize-handle ne"></span><span class="resize-handle e"></span>
                    <span class="resize-handle se"></span><span class="resize-handle s"></span>
                    <span class="resize-handle sw"></span><span class="resize-handle w"></span>
                `;

                canvas.appendChild(section);
                attachSectionEvents(section);
                selectSection(section);
                saveHistory();
            }

            /* ZOOM CONTROLS */
            function setZoom(z) {
                state.zoom = Math.max(0.3, Math.min(1.8, z));
                canvasWrapper.style.transform = `scale(${state.zoom})`;
                zoomValue.textContent = Math.round(state.zoom * 100) + "%";
            }

            document.getElementById("zoomIn").addEventListener("click", () => setZoom(state.zoom + 0.05));
            document.getElementById("zoomOut").addEventListener("click", () => setZoom(state.zoom - 0.05));

            /* ORIENTATION */
            document.getElementById("orientationBtn").addEventListener("click", () => {
                const next = state.orientation === "portrait" ? "landscape" : "portrait";
                setOrientation(next, true);
            });

            function setOrientation(orientation, recordHistory) {
                state.orientation = orientation;
                const dims = A4[orientation];
                canvas.style.width = dims.width + "px";
                canvas.style.height = dims.height + "px";
                document.documentElement.style.setProperty("--canvas-width", dims.width + "px");
                document.documentElement.style.setProperty("--canvas-height", dims.height + "px");
                orientationText.textContent = orientation === "portrait" ? "Portrait" : "Landscape";
                if (recordHistory) saveHistory();
            }

            /* GRID TOGGLE */
            document.getElementById("gridBtn").addEventListener("click", () => {
                state.showGrid = !state.showGrid;
                canvas.classList.toggle("show-grid", state.showGrid);
                document.getElementById("gridBtn").classList.toggle("primary", state.showGrid);
            });

            /* TEMPLATES */
            document.getElementById("templateSelect").addEventListener("change", (e) => applyTemplate(e.target.value));

            function applyTemplate(tplName) {
                state.template = tplName;
                canvas.querySelectorAll(".resume-section").forEach(s => {
                    s.classList.remove("classic-section", "modern-section", "minimal-section");
                    s.classList.add(tplName + "-section");
                });
            }

            /* SEARCH FILTER */
            document.getElementById("sectionSearch").addEventListener("input", (e) => {
                const query = e.target.value.toLowerCase().trim();
                document.querySelectorAll(".section-item").forEach(item => {
                    item.style.display = item.textContent.toLowerCase().includes(query) ? "flex" : "none";
                });
            });

            /* PREVIEW MODAL */
            document.getElementById("previewBtn").addEventListener("click", () => {
                previewContainer.innerHTML = "";
                const clone = canvas.cloneNode(true);
                clone.querySelectorAll(".section-controls, .resize-handle, .canvas-grid, .alignment-guide").forEach(el => el.remove());
                clone.querySelectorAll(".resume-section").forEach(el => {
                    el.style.outline = "none";
                    el.style.cursor = "default";
                    el.classList.remove("selected", "dragging", "resizing");
                });
                previewContainer.appendChild(clone);
                previewOverlay.classList.add("active");
            });

            document.getElementById("previewClose").addEventListener("click", () => previewOverlay.classList.remove("active"));

            /* SAVE & TOAST */
            document.getElementById("saveBtn").addEventListener("click", () => {
                const layout = [];
                canvas.querySelectorAll(".resume-section").forEach(s => {
                    layout.push({
                        id: s.dataset.id,
                        type: s.dataset.type,
                        left: s.style.left,
                        top: s.style.top,
                        width: s.style.width,
                        height: s.style.height,
                        visible: !s.classList.contains("hidden-section")
                    });
                });
                localStorage.setItem("resume_layout", JSON.stringify(layout));
                showToast("Layout saved successfully.");
            });

            function showToast(msg) {
                toast.textContent = msg;
                toast.classList.add("show");
                setTimeout(() => toast.classList.remove("show"), 2500);
            }

            /* HISTORY (UNDO / REDO) */
            function saveHistory() {
                if (historyIndex < history.length - 1) {
                    history = history.slice(0, historyIndex + 1);
                }
                const snap = [];
                canvas.querySelectorAll(".resume-section").forEach(s => {
                    snap.push({
                        id: s.dataset.id,
                        type: s.dataset.type,
                        style: s.getAttribute("style"),
                        class: s.className,
                        html: s.innerHTML
                    });
                });
                history.push({ snap, orientation: state.orientation, template: state.template });
                historyIndex = history.length - 1;
            }

            document.getElementById("undoBtn").addEventListener("click", () => {
                if (historyIndex > 0) {
                    historyIndex--;
                    restoreState(history[historyIndex]);
                }
            });

            document.getElementById("redoBtn").addEventListener("click", () => {
                if (historyIndex < history.length - 1) {
                    historyIndex++;
                    restoreState(history[historyIndex]);
                }
            });

            function restoreState(stateObj) {
                if (!stateObj) return;
                setOrientation(stateObj.orientation, false);
                applyTemplate(stateObj.template);
                selectSection(null);

                const existingMap = new Map();
                canvas.querySelectorAll(".resume-section").forEach(s => existingMap.set(s.dataset.id, s));

                stateObj.snap.forEach(item => {
                    let sec = existingMap.get(item.id);
                    if (!sec) {
                        sec = document.createElement("div");
                        canvas.appendChild(sec);
                    }
                    sec.dataset.id = item.id;
                    sec.dataset.type = item.type;
                    sec.className = item.class;
                    sec.setAttribute("style", item.style);
                    sec.innerHTML = item.html;
                    attachSectionEvents(sec);
                    existingMap.delete(item.id);
                });

                existingMap.forEach(sec => sec.remove());
                updatePropertyPanel();
            }

            /* UTILS */
            function rgbToHex(color) {
                if (!color || color === "transparent" || color === "rgba(0, 0, 0, 0)") return "#FFFFFF";
                if (color.startsWith("#")) {
                    return color.length === 4
                        ? "#" + color[1] + color[1] + color[2] + color[2] + color[3] + color[3]
                        : color;
                }
                const matches = color.match(/\d+/g);
                if (!matches || matches.length < 3) return "#000000";
                const r = parseInt(matches[0], 10).toString(16).padStart(2, "0");
                const g = parseInt(matches[1], 10).toString(16).padStart(2, "0");
                const b = parseInt(matches[2], 10).toString(16).padStart(2, "0");
                return `#${r}${g}${b}`.toUpperCase();
            }

            /* START */
            init();
        })();
    </script>
</body>
</html>