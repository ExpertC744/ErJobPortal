@model List<OrganizationInterestedViewModel>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Interested";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

<div class="container-fluid">

    <div class="master-table-container">

        <!-- PAGE HEADING -->
        <div class="mb-4">

            <h1 class="mb-2">
                Organization Interested
            </h1>

            <p class="mb-0 text-muted">
                @ViewBag.CandidateCode
            </p>

        </div>

        <!-- TABLE -->
        <div class="table-responsive">

            <table id="candidateTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>
                            Sr. No
                        </th>

                        <th>
                            Organization Name
                        </th>

                        <th>
                            Organization Url
                        </th>

                        <th>
                            Contact Person Name
                        </th>

                        <th>
                            Designation
                        </th>

                        <th>
                            Apply Status
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        int srNo = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- SR NO -->
                                <td class="master-id">
                                    @srNo
                                </td>

                                <!-- ORGANIZATION NAME -->
                                <td>
                                    @item.OrganizationName
                                </td>

                                <!-- ORGANIZATION URL -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                item.OrganizationUrl))
                                    {
                                        string organizationUrl =
                                        item.OrganizationUrl;

                                        if (!organizationUrl.StartsWith("http://") &&
                                        !organizationUrl.StartsWith("https://"))
                                        {
                                            organizationUrl =
                                            "https://" + organizationUrl;
                                        }

                                        <a href="@organizationUrl"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="master-link">

                                            Visit

                                        </a>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                        </td>

                        <!-- CONTACT PERSON -->
                        <td>
                            @(!string.IsNullOrWhiteSpace(
                                                        item.ContactPersonName)
                                                        ? item.ContactPersonName
                                                        : "-")
                                </td>

                                <!-- DESIGNATION -->
                                <td>
                                    @(!string.IsNullOrWhiteSpace(
                                                                item.Designation)
                                                                ? item.Designation
                                                                : "-")
                                </td>

                                <!-- APPLY STATUS -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                item.ApplyStatus))
                                    {
                                        <span class="master-status">
                                            @item.ApplyStatus
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }

                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="6"
                                class="text-center">

                                No organization has shown interest yet.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGE INFO -->
        <div id="candidatePageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>