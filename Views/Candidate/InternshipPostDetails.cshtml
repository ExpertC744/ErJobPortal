@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Internship Post Details";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "1Trainee";

    var internshipCode = ViewBag.InternshipCode ?? "HN236383503368076";
}

<div class="container-fluid internship-details-page">

    <!-- Page Header -->
    <div class="internship-page-header">

      @*  

        <!-- Back Button -->
        <a asp-controller="Candidate"
           asp-action="InternshipPost"
           class="internship-back-btn"
           title="Back">
            <i class="fas fa-arrow-left"></i>
        </a> *@

    </div>


    <!-- Master Table -->
    <div class="master-table-container ">

        
           <div class="master-table-title">

                <div>
                    <h2>
                        <i class="fas fa-briefcase me-2"></i>
                      Internship Post Details
                    </h2>

                    
                </div>

            </div>

        <div class="table-responsive">

            <table id="internshipPostDetailsTable"
                   class="master-data-table">

                <thead>
                    <tr>

                        <th>Sr. No</th>

                        <th>
                            Organization Name
                        </th>

                        <th>
                            Position
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Internship / Fellowship Type
                        </th>

                        <th>
                            Facilities
                        </th>

                        <th>
                            Apply Status
                        </th>

                    </tr>
                </thead>

               <tbody>
</tbody>

            </table>

        </div>

    </div>

</div>


<style>

    /* ==========================================
       INTERNSHIP POST DETAILS
    ========================================== */

    .internship-details-page {
        padding-bottom: 40px;
    }


    /* ==========================================
       PAGE HEADER
    ========================================== */

    .internship-page-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .internship-page-header h1 {
        margin: 0;
        color: #0f172a;
        font-size: 36px;
        line-height: 1.2;
        font-weight: 700;
    }

    .internship-page-header p {
        margin: 12px 0 0;
        color: #64748b;
        font-size: 18px;
        font-weight: 400;
    }


    /* ==========================================
       BACK BUTTON
    ========================================== */

    .internship-back-btn {
        width: 66px;
        height: 54px;
        flex-shrink: 0;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        margin-top: 5px;

        background: #4267d9;
        color: #ffffff;

        border-radius: 8px;
        text-decoration: none;

        font-size: 20px;

        transition: all .2s ease;
    }

    .internship-back-btn:hover {
        background: #3156c7;
        color: #ffffff;
        transform: translateY(-1px);
    }


    /* ==========================================
       MASTER TABLE CARD
    ========================================== */

    .internship-master-card {
        width: 100%;
        overflow: hidden;
    }


    /* ==========================================
       TABLE HEADER
    ========================================== */

    .internship-master-card .master-table-title {
        min-height: 50px;
        display: flex;
        align-items: center;
    }

    .internship-master-card .master-table-title h2 {
        margin: 0;
        font-size: 18px;
    }


    /* ==========================================
       EMPTY STATE
    ========================================== */

    .internship-empty-state {
        height: 50px;
        padding: 15px !important;

        text-align: center !important;
        vertical-align: middle !important;

        color: #1e293b !important;
        font-size: 16px !important;
        font-weight: 400;
    }


    /* ==========================================
       TABLE COLUMN SIZING
    ========================================== */

    #internshipPostDetailsTable th:nth-child(1) {
        width: 8%;
    }

    #internshipPostDetailsTable th:nth-child(2) {
        width: 21%;
    }

    #internshipPostDetailsTable th:nth-child(3) {
        width: 10%;
    }

    #internshipPostDetailsTable th:nth-child(4) {
        width: 10%;
    }

    #internshipPostDetailsTable th:nth-child(5) {
        width: 28%;
    }

    #internshipPostDetailsTable th:nth-child(6) {
        width: 10%;
    }

    #internshipPostDetailsTable th:nth-child(7) {
        width: 13%;
    }


    /* ==========================================
       RESPONSIVE
    ========================================== */

    @@media (max-width: 768px) {

        .internship-page-header {
            align-items: center;
        }

        .internship-page-header h1 {
            font-size: 28px;
        }

        .internship-page-header p {
            font-size: 15px;
        }

        .internship-back-btn {
            width: 52px;
            height: 48px;
        }

    }


    @@media (max-width: 480px) {

        .internship-page-header {
            margin-bottom: 20px;
        }

        .internship-page-header h1 {
            font-size: 23px;
        }

        .internship-page-header p {
            margin-top: 7px;
            font-size: 14px;
        }

        .internship-back-btn {
            width: 45px;
            height: 42px;
            font-size: 16px;
        }

    }

</style>