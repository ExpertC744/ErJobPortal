@using ErJobPortal.Models
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Trainee Applied";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";

    var traineeAppliedPosts = ViewBag.TraineeAppliedPosts as List<OrgPostM> ?? new List<OrgPostM>();

    string candidateCode = ViewBag.CandidateCode?.ToString() ?? "";
}

<style>
    .trainee-applied-container {
        padding: 15px;
    }

    .trainee-applied-title {
        font-size: 36px;
        font-weight: 500;
        color: #111827;
        margin-bottom: 8px;
    }

    .candidate-code {
        font-size: 18px;
        color: #718096;
        margin-bottom: 32px;
    }

    .trainee-card {
        border: 1px solid #d1d5db;
        border-radius: 7px;
        background: #fff;
        overflow: hidden;
    }

    .trainee-card-header {
        background: #f8f8f8;
        border-bottom: 1px solid #d1d5db;
        padding: 14px 20px;
        font-size: 20px;
        color: #17395f;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .table-container {
        padding: 20px;
    }

    .applied-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 17px;
    }

        .applied-table th {
            background: #fafafa;
            border: 1px solid #d8dee6;
            padding: 14px 12px;
            text-align: center;
            font-weight: 700;
            color: #111827;
            white-space: nowrap;
        }

        .applied-table td {
            border: 1px solid #d8dee6;
            padding: 14px 12px;
            text-align: center;
            vertical-align: middle;
            color: #1f2937;
        }

    .organization-link {
        color: #1683e8;
        text-decoration: underline;
        font-weight: 400;
    }

        .organization-link:hover {
            color: #0056b3;
        }

    .location-text {
        line-height: 1.6;
    }

    .facility-icon {
        font-size: 28px;
        color: #111;
    }

    .status-applied {
        display: inline-block;
        background: #159447;
        color: white;
        padding: 10px 17px;
        border-radius: 6px;
        font-size: 17px;
    }

    .status-not-applied {
        display: inline-block;
        background: #dc3545;
        color: white;
        padding: 10px 17px;
        border-radius: 6px;
        font-size: 17px;
    }

    .empty-message {
        text-align: center;
        padding: 35px;
        color: #6b7280;
        font-size: 17px;
    }

    /* DataTables controls */
    .dataTables_wrapper {
        width: 100%;
    }

        .dataTables_wrapper .dataTables_length {
            float: left;
            margin-bottom: 20px;
        }

        .dataTables_wrapper .dataTables_filter {
            float: right;
            margin-bottom: 20px;
        }

        .dataTables_wrapper .dataTables_length select {
            min-width: 125px;
            height: 46px;
            padding: 6px 30px 6px 10px;
            border: 1px solid #bfc7d1;
            border-radius: 4px;
            font-size: 17px;
            background: white;
        }

        .dataTables_wrapper .dataTables_filter input {
            width: 260px;
            height: 48px;
            padding: 8px 15px;
            border: 1px solid #bfc7d1;
            border-radius: 8px;
            font-size: 17px;
            margin-left: 8px;
        }

        .dataTables_wrapper .dataTables_info {
            float: left;
            margin-top: 25px;
            font-size: 17px;
            color: #111827;
        }

        .dataTables_wrapper .dataTables_paginate {
            float: right;
            margin-top: 20px;
        }

        .dataTables_wrapper::after {
            content: "";
            display: block;
            clear: both;
        }

    @@media (max-width: 1200px) {
        .table-responsive {
            overflow-x: auto;
        }

        .applied-table {
            min-width: 1100px;
        }
    }
</style>

<div class="trainee-applied-container">

    <!-- PAGE TITLE -->
    <div class="trainee-applied-title">
        Trainee Applied
    </div>

    <!-- CANDIDATE CODE -->
    <div class="candidate-code">
        @candidateCode
    </div>

    <!-- MAIN CARD -->
    <div class="trainee-card">

        <!-- CARD HEADER -->
        <div class="trainee-card-header">
            <span style="font-size:22px;">▣</span>
            <span>Trainee Applied Details</span>
        </div>

        <!-- TABLE -->
        <div class="table-container">

            <div class="table-responsive">

                <table id="traineeAppliedTable"
                       class="applied-table">

                    <thead>
                        <tr>
                            <th>Sr. No</th>

                            <th>
                                Organization Name
                            </th>

                            <th>
                                Position
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Internship / Fellowship Type
                            </th>

                            <th>
                                Facilities
                            </th>

                            <th>
                                Apply Status
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (traineeAppliedPosts.Any())
                        {
                            int srNo = 1;

                            foreach (var post in traineeAppliedPosts)
                            {
                                <tr>

                                    <!-- SR NO -->
                                    <td>
                                        @srNo
                                    </td>

                                    <!-- ORGANIZATION -->
                                    <td>
                                        <a href="javascript:void(0);"
                                           class="organization-link">
                                            @post.sName
                                        </a>
                                    </td>

                                    <!-- POSITION -->
                                    <td>
                                        @post.sPositionName
                                    </td>

                                    <!-- LOCATION -->
                                    <td>
                                        <div class="location-text">
                                            @post.sCountryName
                                            <br />

                                            @post.sStateName
                                            <br />

                                            @post.nCityName
                                        </div>
                                    </td>

                                    <!-- INTERNSHIP / FELLOWSHIP -->
                                    <td>
                                        @post.sInternshipFellowshipTypeName
                                    </td>

                                    <!-- FACILITIES -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(post.sFacilities))
                                        {
                                            <span class="facility-icon"
                                                  title="@post.sFacilities">
                                                🏢
                                            </span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    <!-- APPLY STATUS -->
                                    <td>
                                        @if (post.IsApplied)
                                        {
                                            <span class="status-applied">
                                                Applied
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-not-applied">
                                                Not Applied
                                            </span>
                                        }
                                    </td>

                                </tr>

                                srNo++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7"
                                    class="empty-message">
                                    No trainee applied records found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    <script>
        $(document).ready(function () {

            $('#traineeAppliedTable').DataTable({

                pageLength: 25,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                searching: true,

                ordering: true,

                paging: true,

                info: true,

                language: {
                    search: "",
                    searchPlaceholder: "Search..."
                },

                columnDefs: [
                    {
                        orderable: false,
                        targets: [0, 5, 6]
                    }
                ]

            });

        });
    </script>
}
