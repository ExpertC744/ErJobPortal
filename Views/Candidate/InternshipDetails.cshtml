@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/InternshipDetails.css" asp-append-version="true" />

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Internship Post";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

<div class="container-fluid">
    <!-- =====================================================
         MASTER TABLE CARD
    ====================================================== -->

    <div class="master-table-container">
        <!-- =================================================
             TABLE
        ================================================== -->

        <div class="table-responsive">
             <!-- =====================================================
         PAGE HEADING
    ====================================================== -->

    <div class="mb-4">

        <h1 class="mb-2">
            Internship Post
        </h1>

        <p class="mb-0 text-muted">
            HN236383503368076
        </p>

    </div>
            <table class="master-data-table">

                <thead>

                    <tr>

                        <th>
                            Sr. No
                        </th>

                        <th>
                            Organization Name
                        </th>

                        <th>
                            Position
                        </th>

                        <th>
                            Location
                        </th>

                        <th>
                            Internship / Fellowship Type
                        </th>

                        <th>
                            Facilities
                        </th>

                        <th>
                            Apply Status
                        </th>

                    </tr>

                </thead>


                <tbody>
                    @{
                        var internshipPosts =
                        ViewBag.InternshipPosts as List<ErJobPortal.Models.OrgPostM>
                        ?? new List<ErJobPortal.Models.OrgPostM>();

                        int srNo = 1;
                    }

                    @foreach (var post in internshipPosts)
                    {
                        <tr>

                            <!-- Sr No -->
                            <td class="master-id">
                                @srNo
                            </td>

                            <!-- Organization -->
                            <td>
                                <a href="#"
                                   class="text-primary fw-semibold text-decoration-underline">
                                    @post.sName
                                </a>
                            </td>

                            <!-- Position -->
                            <td>
                                @post.sPositionName
                            </td>

                            <!-- Location -->
                            <td>
                                @post.sCountryName<br />
                                @post.sStateName<br />
                                @post.nCityName
                            </td>

                            <!-- Internship / Fellowship -->
                            <td>
                                @post.sInternshipFellowshipTypeName
                            </td>

                            <!-- Facilities -->
                            <td>
                                @if (!string.IsNullOrWhiteSpace(post.sFacilities))
                                {
                                    @post.sFacilities
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>

                            <!-- Apply Status -->
                            <td>

                                @if (post.IsApplied)
                                {
                                    <span class="master-action-btn">
                                        Applied
                                    </span>
                                }
                                else
                                {
                                    <form asp-controller="Candidate"
                                          asp-action="ApplyToPost"
                                          method="post"
                                          style="display:inline;">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="postId"
                                               value="@post.nID" />

                                        <input type="hidden"
                                               name="orgId"
                                               value="@post.nOrgID" />

                                        <button type="submit"
                                                class="master-action-btn"
                                                style="border:none; cursor:pointer;">
                                            Apply Now
                                        </button>

                                    </form>
                                }

                            </td>

                        </tr>

                        srNo++;
                    }

                </tbody>

            </table>

        </div>


        <!-- =================================================
             EXTRA POST BUTTON
        ================================================== -->

        <div class="mt-4">

            <button type="button"
                    class="submit-button">

                Extra Post

            </button>

        </div>

    </div>

</div>