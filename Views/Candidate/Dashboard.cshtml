@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Candidate Dashboard";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}

<style>
    .candidate-dashboard {
        padding: 10px 5px 30px;
        background: #f7f9fc;
        min-height: calc(100vh - 70px);
    }

    /* Welcome Banner */
    .welcome-banner {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        padding: 30px 35px;
        margin-bottom: 28px;
        background: linear-gradient(135deg, #1e7b67 0%, #269b80 55%, #52b99f 100%);
        color: #fff;
        box-shadow: 0 12px 30px rgba(30, 123, 103, 0.18);
    }

        .welcome-banner::before {
            content: "";
            position: absolute;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
            right: 80px;
            top: -100px;
        }

        .welcome-banner::after {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(255,255,255,.06);
            right: -30px;
            bottom: -70px;
        }

    .welcome-content {
        position: relative;
        z-index: 2;
    }

    .welcome-banner h2 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .welcome-banner p {
        margin: 0;
        opacity: .88;
        font-size: 15px;
    }

    .profile-btn {
        position: relative;
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        color: #1e7b67;
        padding: 11px 18px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: .3s;
    }

        .profile-btn:hover {
            background: #f1f8f6;
            color: #155d4e;
            transform: translateY(-2px);
        }

    /* Statistics */
    .stat-card {
        position: relative;
        background: #fff;
        border-radius: 18px;
        padding: 22px;
        border: 1px solid #edf0f4;
        height: 100%;
        overflow: hidden;
        transition: all .3s ease;
        box-shadow: 0 5px 18px rgba(31, 45, 61, .05);
    }

        .stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 30px rgba(31, 45, 61, .10);
        }

    .stat-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 21px;
        margin-bottom: 18px;
    }

    .icon-green {
        background: #e7f6f1;
        color: #1e7b67;
    }

    .icon-blue {
        background: #eaf2ff;
        color: #3478db;
    }

    .icon-orange {
        background: #fff3e5;
        color: #ed922f;
    }

    .icon-purple {
        background: #f1ebff;
        color: #805ad5;
    }

    .stat-title {
        color: #7a8494;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .stat-number {
        color: #1d2939;
        font-size: 29px;
        font-weight: 750;
        line-height: 1;
    }

    .stat-bottom {
        margin-top: 15px;
        font-size: 12px;
        color: #7a8494;
    }

        .stat-bottom span {
            color: #1e7b67;
            font-weight: 600;
        }

    /* Section */
    .dashboard-section {
        background: #fff;
        border-radius: 18px;
        border: 1px solid #edf0f4;
        padding: 23px;
        box-shadow: 0 5px 18px rgba(31,45,61,.04);
        height: 100%;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }

        .section-header h5 {
            margin: 0;
            font-size: 17px;
            font-weight: 700;
            color: #202939;
        }

    .view-all {
        color: #1e7b67;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
    }

        .view-all:hover {
            color: #155d4e;
        }

    /* Progress */
    .progress-wrapper {
        margin-bottom: 22px;
    }

    .progress-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 9px;
        font-size: 13px;
    }

        .progress-info strong {
            color: #344054;
        }

        .progress-info span {
            color: #1e7b67;
            font-weight: 700;
        }

    .custom-progress {
        height: 9px;
        background: #edf1f4;
        border-radius: 20px;
        overflow: hidden;
    }

    .custom-progress-bar {
        height: 100%;
        width: 72%;
        background: linear-gradient(90deg, #1e7b67, #48b397);
        border-radius: 20px;
    }

    /* Quick Actions */
    .quick-action {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px;
        border-radius: 13px;
        text-decoration: none;
        color: #344054;
        margin-bottom: 10px;
        transition: .25s;
        border: 1px solid transparent;
    }

        .quick-action:hover {
            background: #f5faf8;
            border-color: #dcefe9;
            color: #1e7b67;
            transform: translateX(3px);
        }

    .quick-action-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf6f2;
        color: #1e7b67;
        flex-shrink: 0;
    }

    .quick-action-text strong {
        display: block;
        font-size: 14px;
        margin-bottom: 2px;
    }

    .quick-action-text small {
        color: #98a2b3;
        font-size: 11px;
    }

    /* Applications */
    .application-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 0;
        border-bottom: 1px solid #edf0f4;
    }

        .application-item:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

    .company-avatar {
        width: 43px;
        height: 43px;
        border-radius: 12px;
        background: #edf7f4;
        color: #1e7b67;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
    }

    .application-info {
        flex: 1;
        margin-left: 12px;
    }

        .application-info strong {
            display: block;
            color: #344054;
            font-size: 14px;
        }

        .application-info small {
            color: #98a2b3;
            font-size: 11px;
        }

    .status {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

    .status-success {
        background: #e8f7f0;
        color: #16855f;
    }

    .status-warning {
        background: #fff5df;
        color: #c57a11;
    }

    .status-info {
        background: #eaf2ff;
        color: #3478db;
    }

    /* Recommended Jobs */
    .job-card {
        border: 1px solid #edf0f4;
        border-radius: 14px;
        padding: 17px;
        margin-bottom: 12px;
        transition: .3s;
    }

        .job-card:hover {
            border-color: #cfe8e1;
            box-shadow: 0 8px 20px rgba(30,123,103,.07);
        }

    .job-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .job-icon {
        width: 42px;
        height: 42px;
        border-radius: 11px;
        background: #f1f7f5;
        color: #1e7b67;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .job-card h6 {
        margin: 0 0 3px;
        font-size: 14px;
        font-weight: 700;
        color: #344054;
    }

    .job-card p {
        margin: 0;
        color: #98a2b3;
        font-size: 11px;
    }

    .job-meta {
        margin-top: 13px;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        color: #667085;
        font-size: 11px;
    }

        .job-meta i {
            color: #1e7b67;
            margin-right: 4px;
        }

    .apply-btn {
        border: 1px solid #1e7b67;
        color: #1e7b67;
        background: #fff;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        transition: .25s;
    }

        .apply-btn:hover {
            background: #1e7b67;
            color: #fff;
        }

    /* =====================================================
           1TRAINEE MONTHLY ANALYTICS @* Radhika29-09 *@
    ===================================================== */

    .analytics-card {
        background: #ffffff;
        border: 1px solid #dfe5e8;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        transition: all .25s ease;
    }

    .analytics-card:hover {
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }

    /* Chart Header */
    .analytics-header {
        min-height: 52px;
        padding: 0 18px;
        display: flex;
        align-items: center;
        gap: 11px;
        border-bottom: 1px solid #dfe5e8;
        background: #ffffff;
    }

    .analytics-header-icon {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1e7b67;
        font-size: 17px;
    }

    .analytics-header h5 {
        margin: 0;
        color: #16324f;
        font-size: 17px;
        font-weight: 500;
        letter-spacing: .1px;
    }

    /* Chart Body */
    .analytics-body {
        padding: 18px 16px 14px;
    }

    .chart-wrapper {
        position: relative;
        width: 100%;
        height: 235px;
    }

        .chart-wrapper svg {
            width: 100%;
            height: 100%;
            display: block;
        }

    /* Legend */
    .chart-legend {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        color: #667085;
        font-size: 12px;
    }

    .legend-box {
        width: 50px;
        height: 16px;
        border: 2px solid #1e7b67;
        background: rgba(30, 123, 103, .14);
    }

    .legend-box-bar {
        width: 50px;
        height: 16px;
        background: #1e7b67;
    }

    /* Axis text */
    .chart-axis-text {
        fill: #667085;
        font-size: 11px;
        font-family: Arial, sans-serif;
    }

    /* Grid */
    .chart-grid {
        stroke: #e6eaed;
        stroke-width: 1;
    }

    .chart-axis {
        stroke: #cfd6da;
        stroke-width: 1;
    }

    /* Line chart */
    .chart-line {
        fill: none;
        stroke: #1e7b67;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .chart-area {
        fill: rgba(30, 123, 103, .14);
    }

    .chart-point {
        fill: #ffffff;
        stroke: #1e7b67;
        stroke-width: 2;
    }

    /* Bar chart */
    .chart-bar {
        fill: #1e7b67;
        transition: opacity .2s ease;
    }

        .chart-bar:hover {
            opacity: .78;
        }

    /* Current value */
    .analytics-value {
        text-align: center;
        margin-top: 5px;
        color: #667085;
        font-size: 11px;
    }

    /* Footer */
    .analytics-footer {
        border-top: 1px solid #edf0f2;
        padding: 10px 16px;
        color: #7a8494;
        font-size: 11px;
    }

        .analytics-footer i {
            color: #1e7b67;
            margin-right: 5px;
        }

    @@media (max-width: 767px) {

        .analytics-header {
            min-height: 48px;
            padding: 0 14px;
        }

            .analytics-header h5 {
                font-size: 15px;
            }

        .analytics-body {
            padding: 15px 10px 10px;
        }

        .chart-wrapper {
            height: 210px;
        }

        .chart-axis-text {
            font-size: 9px;
        }
    }

    /* =========================================================
           VIEW BUTTON
        ========================================================= */

    .sa-view-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #e8f5f1;
        color: #1e7b67;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        transition: all .2s ease;
    }

        .sa-view-btn:hover {
            background: #1e7b67;
            color: #ffffff;
            text-decoration: none;
        }

        .sa-view-btn i {
            font-size: 9px;
        }
</style>
@if (TempData["ApplyMessage"] != null)
{
    var message =
        TempData["ApplyMessage"]?.ToString();

    var messageType =
        TempData["ApplyMessageType"]?.ToString();

    <div class="alert alert-@(messageType == "success" ? "success" : "info") alert-dismissible fade show"
         role="alert">

        <i class="fas fa-check-circle me-2"></i>

        @message

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}
<div class="candidate-dashboard">

    <!-- Welcome -->
    <div class="welcome-banner">
        <div class="row align-items-center">
            <div class="col-md-8 welcome-content">
                <h2>Welcome back, Candidate 👋</h2>
                <p>
                    Track your applications, discover new opportunities
                    and take the next step in your career.
                </p>
            </div>

            <div class="col-md-4 text-md-end">
                <a href="#" class="profile-btn">
                    <i class="fas fa-user-edit"></i>
                    Complete Profile
                </a>
            </div>
        </div>
    </div>


    <!-- Statistics -->
    <div class="row">

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-green">
                    <i class="fas fa-building"></i>
                </div>

                <div class="stat-title">
                    Total Organizations
                </div>

                <div class="stat-number">

                    @ViewBag.OrganizationRegistrationCount

                </div>

                @* radhika02-10 *@
                <div class="stat-bottom">
                    <a asp-controller="Candidate"
                       asp-action="OrgList"
                       class="sa-view-btn">

                        View Details
                        <i class="fas fa-arrow-right"></i>

                    </a>
                </div>

            </div>
        </div>


        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-blue">
                    <i class="fas fa-briefcase"></i>
                </div>

                <div class="stat-title">
                    Open Job Openings
                </div>

                <div class="stat-number">
                    8
                </div>

                <div class="stat-bottom">
                    <span>+2</span> new opportunities
                </div>

            </div>
        </div>


        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-orange">
                    <i class="fas fa-search"></i>
                </div>

                <div class="stat-title">
                    Top Searches
                </div>

                <div class="stat-number">
                    3
                </div>

                <div class="stat-bottom">
                    <span>+1</span> from last week
                </div>

            </div>
        </div>


        @* radhika02-09 *@
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card">

                <div class="stat-icon icon-purple">
                    <i class="fas fa-paper-plane"></i>
                </div>

                @{
                    var traineeAppliedPosts = ViewBag.TraineeAppliedPosts;
                    int applicationsSentCount = traineeAppliedPosts == null
                    ? 0
                    : ((System.Collections.ICollection)traineeAppliedPosts).Count;
                }

                <div class="stat-title">
                    Applications Sent
                </div>

                <div class="stat-number">
                    @applicationsSentCount
                </div>

                <div class="stat-bottom">

                    <a asp-controller="Candidate"
                       asp-action="TraineeApplied"
                       asp-route-id="@ViewBag.CandidateCode"
                       class="sa-view-btn">

                        View Details


                        <i class="fas fa-arrow-right"></i>

                    </a>
                </div>

            </div>
        </div>
    </div>




    <!-- =====================================================
         MONTHLY ANALYTICS @* Radhika29-09 *@
    ===================================================== -->
    <!-- =====================================================
         MONTHLY ANALYTICS @* Radhika29-09 *@
    ===================================================== -->

