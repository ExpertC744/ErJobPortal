<div class="row">

    <div class="col-12 mb-4">

        <div class="master-table-container">



            <!-- Master Table -->
            <div class="table-responsive">
                <!-- Master Table Header -->
                <div class="master-table-title">

                    <div>
                        <h2>
                            <i class="fas fa-briefcase me-2"></i>
                            Internship Post
                        </h2>


                    </div>

                </div>
                <table id="recommendedOpportunitiesTable" class="master-data-table">

                    <thead>
                        <tr>

                            <th>Sr. No</th>

                            <th>
                                Organization Name
                            </th>

                            <th>
                                Position
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Internship / Fellowship Type
                            </th>

                            <th>
                                Facilities
                            </th>

                            <th>
                                Apply Status
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @{
                            var internshipPosts =
                            ViewBag.InternshipPosts as List<ErJobPortal.Models.OrgPostM>
                            ?? new List<ErJobPortal.Models.OrgPostM>();

                            int srNo = 1;
                        }

                        @foreach (var post in internshipPosts)
                        {
                            <tr>

                                <!-- Sr No -->
                                <td class="master-id">
                                    @srNo
                                </td>

                                <!-- Organization -->
                                <td>
                                    <a href="#"
                                       class="text-primary fw-semibold text-decoration-underline">
                                        @post.sName
                                    </a>
                                </td>

                                <!-- Position -->
                                <td>
                                    @post.sPositionName
                                </td>

                                <!-- Location -->
                                <td>
                                    @post.sCountryName<br />
                                    @post.sStateName<br />
                                    @post.nCityName
                                </td>

                                <!-- Internship / Fellowship Type -->
                                <td>
                                    @post.sInternshipFellowshipTypeName
                                </td>

                                <!-- Facilities -->
                                <td>
                                    <div class="master-icon">
                                        <i class="fas fa-building"></i>
                                    </div>
                                </td>

                                <!-- Apply Status -->
                                <td>

                                    @if (post.IsApplied)
                                    {
                                        <span class="master-action-btn">
                                            Applied
                                        </span>
                                    }
                                    else
                                    {
                                        <form asp-controller="Candidate" asp-action="ApplyToPost" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="postId" value="@post.nID" />
                                            <input type="hidden" name="orgId" value="@post.nOrgID" />
                                            <button type="submit" class="master-action-btn" style="border:none; cursor:pointer;">
                                                Apply Now
                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>

                            srNo++;
                        }

                    </tbody>

                </table>

            </div>

            <!-- Master Table Page Information -->
            <div class="master-page-info d-none">
                Showing 1 to 1 of 1 entries
            </div>

            <!-- Extra Post -->
            <div class="mt-3">

                <a href="#"
                   class="btn btn-success px-4 py-2">
                    <i class="fas fa-plus me-2"></i>
                    Extra Post
                </a>

            </div>

        </div>

    </div>

</div>

