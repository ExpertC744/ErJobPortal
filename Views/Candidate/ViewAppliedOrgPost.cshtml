@model ErJobPortal.Models.ViewAppliedOrgPostViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Applied Internship Details";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";

    var post = Model?.Post;
    var org = Model?.Organization;
}

<div class="container-fluid">

    <div class="master-table-container">

        <!-- ==========================================
             PAGE HEADER
        =========================================== -->

        <div class="mb-4">

            <h1 class="mb-2">
                Applied Internship Details
            </h1>

            <p class="mb-0 text-muted">
                Candidate Code:
                @ViewBag.CandidateCode
            </p>

        </div>


        <!-- ==========================================
             ORGANIZATION DETAILS
        =========================================== -->

        <div class="card mb-4">

            <div class="card-header">
                <h4 class="mb-0">
                    Organization Details
                </h4>
            </div>

            <div class="card-body">

                <div class="row">

                    <!-- LOGO -->

                    <div class="col-md-3 text-center mb-3">

                        @if (!string.IsNullOrWhiteSpace(
                        org?.sCompanyLogo))
                        {
                            <img src="~/uploads/organization/@org.sCompanyLogo"
                                 alt="Organization Logo"
                                 class="img-fluid"
                                 style="
                                     max-height:150px;
                                     max-width:200px;
                                     object-fit:contain;
                                     " />
                        }
                        else
                        {
                            <div class="text-muted">
                                No Logo Available
                            </div>
                        }

                    </div>


                    <!-- ORGANIZATION INFORMATION -->

                    <div class="col-md-9">

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <strong>
                                    Organization Name
                                </strong>

                                <div>
                                    @org?.sOrganizationName
                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    Email
                                </strong>

                                <div>
                                    @org?.sOrganizationEmail
                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    Mobile
                                </strong>

                                <div>
                                    @org?.sMobile
                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    Designation
                                </strong>

                                <div>
                                    @org?.sDesignation
                                </div>

                            </div>


                            <div class="col-md-12 mb-3">

                                <strong>
                                    Organization Address
                                </strong>

                                <div>
                                    @org?.sCompanyAddress
                                </div>

                            </div>


                            <div class="col-md-4 mb-3">

                                <strong>
                                    Establishment Year
                                </strong>

                                <div>
                                    @(org?.nEstablishmentYear > 0
                                        ? org.nEstablishmentYear.ToString()
                                        : "-")
                                </div>

                            </div>


                            <div class="col-md-4 mb-3">

                                <strong>
                                    Employee Strength
                                </strong>

                                <div>
                                    @(string.IsNullOrWhiteSpace(
                                        org?.nEmployeeStrength)
                                        ? "-"
                                        : org.nEmployeeStrength)
                                </div>

                            </div>


                            <div class="col-md-4 mb-3">

                                <strong>
                                    GST No.
                                </strong>

                                <div>
                                    @(string.IsNullOrWhiteSpace(
                                        org?.sGSTNo)
                                        ? "-"
                                        : org.sGSTNo)
                                </div>

                            </div>


                            <div class="col-md-6 mb-3">

                                <strong>
                                    CIN No.
                                </strong>

                                <div>
                                    @(string.IsNullOrWhiteSpace(
                                        org?.sCINNo)
                                        ? "-"
                                        : org.sCINNo)
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================================
             INTERNSHIP DETAILS
        =========================================== -->

        <div class="card mb-4">

            <div class="card-header">

                <h4 class="mb-0">
                    Internship Details
                </h4>

            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <strong>
                            Position
                        </strong>

                        <div>
                            @post?.sPositionName
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Required Trainees
                        </strong>

                        <div>
                            @post?.nRequiredTrainees
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Gender
                        </strong>

                        <div>
                            @post?.sGenderName
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Minimum Qualification
                        </strong>

                        <div>
                            @post?.sMinimumQualificationName
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <strong>
                            Country
                        </strong>

                        <div>
                            @post?.sCountryName
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <strong>
                            State
                        </strong>

                        <div>
                            @post?.sStateName
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <strong>
                            City
                        </strong>

                        <div>
                            @post?.nCityName
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <strong>
                            Working Hours
                        </strong>

                        <div>
                            @post?.sWorkingHours
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <strong>
                            Working Shift
                        </strong>

                        <div>
                            @post?.sWorkingShift
                        </div>

                    </div>


                    <div class="col-md-4 mb-3">

                        <strong>
                            Internship Type
                        </strong>

                        <div>
                            @post?.sInternshipTypeName
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Internship / Fellowship Type
                        </strong>

                        <div>
                            @post?.sInternshipFellowshipTypeName
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Training Involved
                        </strong>

                        <div>
                            @post?.sTrainingInvolvedName
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Internship Duration
                        </strong>

                        <div>
                            @post?.sInternshipDurationName
                        </div>

                    </div>


                    <div class="col-md-3 mb-3">

                        <strong>
                            Start Date
                        </strong>

                        <div>
                            @(post == null
                                ? "-"
                                : Convert.ToDateTime(post.dStartDate)
                                .ToString("dd-MM-yyyy"))
                        </div>

                    </div>


                    <div class="col-md-3 mb-3">

                        <strong>
                            Completion Date
                        </strong>

                        <div>
                            @(post == null
                                ? "-"
                                : Convert.ToDateTime(post.dCompletionDate)
                                .ToString("dd-MM-yyyy"))
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Internship Mode
                        </strong>

                        <div>
                            @post?.sInternshipModeName
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Language Known
                        </strong>

                        <div>
                            @post?.sLanguageKnown
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Working Days
                        </strong>

                        <div>
                            @post?.sWorkingDays
                        </div>

                    </div>


                    <div class="col-md-6 mb-3">

                        <strong>
                            Facilities
                        </strong>

                        <div>
                            @post?.sFacilities
                        </div>

                    </div>


                    <div class="col-md-12 mb-3">

                        <strong>
                            Application Status
                        </strong>

                        <div>

                            <span class="master-status">
                                Applied
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ==========================================
             BACK BUTTON
        =========================================== -->

        <div class="mt-3">

            <a asp-controller="Candidate"
               asp-action="MyInternship"
               asp-route-id="@ViewBag.CandidateCode"
               class="btn btn-secondary">

                Back to My Internship

            </a>

        </div>

    </div>

</div>