@model ErJobPortal.Models.ViewAppliedOrgPostViewModel

@{
    Layout = null;

    ViewData["Title"] = "Internship Post Details";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";

    var post = Model?.Post;
}
 
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <title>Internship Post Details - 1Trainee</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

     <link href="~/css/ViewAppliedOrgPost.css" rel="stylesheet" />

</head>

<body>

<main class="internship-page">

    <article class="internship-card">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="internship-cover">

            <div class="cover-left">

                <div class="cover-icon">
                    <i class="fa-solid fa-briefcase"></i>
                </div>

                <div>
                    <span class="cover-label">
                        1Trainee Internship
                    </span>

                    <h1>
                        Internship Post Details
                    </h1>

                    <p>
                        Complete internship opportunity information
                    </p>
                </div>

            </div>


            <div class="profile-actions">

                <button type="button"
                        class="profile-action-btn"
                        title="Home"
                        aria-label="Home"
                        onclick="goHome()">

                    <i class="fa-solid fa-house"></i>

                </button>

                <button type="button"
                        class="profile-action-btn"
                        title="Print"
                        aria-label="Print"
                        onclick="printProfile()">

                    <i class="fa-solid fa-print"></i>

                </button>

                <button type="button"
                        class="profile-action-btn"
                        title="Download as PDF"
                        aria-label="Download as PDF"
                        onclick="downloadProfile()">

                    <i class="fa-solid fa-download"></i>

                </button>

            </div>

        </header>


        <!-- =====================================================
             CANDIDATE / POST HEADER
        ====================================================== -->

        <section class="post-identity">

            <div class="post-identity-icon">

                <i class="fa-solid fa-building"></i>

            </div>


            <div class="post-identity-content">

                <div class="post-title-row">

                    <h2>
                        @post?.sName
                    </h2>

                    <span class="verified-tick">
                        <i class="fa-solid fa-check"></i>
                    </span>

                </div>

                <div class="post-position">

                    <i class="fa-solid fa-user-tie"></i>

                    @post?.sPositionName

                </div>

                <div class="post-pills">

                    <span class="post-pill post-pill-teal">
                        <i class="fa-solid fa-briefcase"></i>
                        Internship
                    </span>

                    <span class="post-pill post-pill-blue">
                        <i class="fa-solid fa-location-dot"></i>
                        @post?.nCityName
                    </span>

                    <span class="post-pill post-pill-green">
                        <i class="fa-solid fa-laptop-house"></i>
                        @post?.sInternshipModeName
                    </span>

                </div>

            </div>


            <div class="candidate-code-box">

                <span>Candidate Code</span>

                <strong>
                    @ViewBag.CandidateCode
                </strong>

            </div>

        </section>


        <!-- =====================================================
             ORIGINAL CONTENT
             Dynamic code preserved
        ====================================================== -->

        <section class="post-body">

            <!-- =====================================================
                 ORGANIZATION
            ====================================================== -->

            <div class="detail-section">

                <div class="detail-section-header">

                    <div class="detail-section-icon">
                        <i class="fa-solid fa-building"></i>
                    </div>

                    <div>
                        <h3>Organization Details</h3>
                        <p>Organization information</p>
                    </div>

                </div>


                <div class="detail-section-body">

                    <div class="information-grid">

                        <div class="information-card information-card-wide tone-teal">

                            <div class="information-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Organization Name
                                </div>

                                <div class="information-value"
                                     title="@post?.sName">

                                    @post?.sName

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 INTERNSHIP DETAILS
            ====================================================== -->

            <div class="detail-section">

                <div class="detail-section-header">

                    <div class="detail-section-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>

                    <div>
                        <h3>Internship Details</h3>
                        <p>Complete internship opportunity information</p>
                    </div>

                </div>


                <div class="detail-section-body">

                    <div class="information-grid">


                        <!-- Position -->

                        <div class="information-card tone-teal">

                            <div class="information-icon">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Position
                                </div>

                                <div class="information-value">
                                    @post?.sPositionName
                                </div>

                            </div>

                        </div>


                        <!-- Required Trainees -->

                        <div class="information-card tone-blue">

                            <div class="information-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Required Trainees
                                </div>

                                <div class="information-value">
                                    @post?.nRequiredTrainees
                                </div>

                            </div>

                        </div>


                        <!-- Gender -->

                        <div class="information-card tone-violet">

                            <div class="information-icon">
                                <i class="fa-solid fa-venus-mars"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Gender
                                </div>

                                <div class="information-value">
                                    @post?.sGenderName
                                </div>

                            </div>

                        </div>


                        <!-- Qualification -->

                        <div class="information-card tone-green">

                            <div class="information-icon">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Minimum Qualification
                                </div>

                                <div class="information-value">
                                    @post?.sMinimumQualificationName
                                </div>

                            </div>

                        </div>


                        <!-- Country -->

                        <div class="information-card tone-red">

                            <div class="information-icon">
                                <i class="fa-solid fa-globe"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Country
                                </div>

                                <div class="information-value">
                                    @post?.sCountryName
                                </div>

                            </div>

                        </div>


                        <!-- State -->

                        <div class="information-card tone-amber">

                            <div class="information-icon">
                                <i class="fa-solid fa-map"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    State
                                </div>

                                <div class="information-value">
                                    @post?.sStateName
                                </div>

                            </div>

                        </div>


                        <!-- City -->

                        <div class="information-card tone-sky">

                            <div class="information-icon">
                                <i class="fa-solid fa-city"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    City
                                </div>

                                <div class="information-value">
                                    @post?.nCityName
                                </div>

                            </div>

                        </div>


                        <!-- Working Hours -->

                        <div class="information-card tone-purple">

                            <div class="information-icon">
                                <i class="fa-solid fa-clock"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Working Hours
                                </div>

                                <div class="information-value">
                                    @post?.sWorkingHours
                                </div>

                            </div>

                        </div>


                        <!-- Working Shift -->

                        <div class="information-card tone-teal">

                            <div class="information-icon">
                                <i class="fa-solid fa-business-time"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Working Shift
                                </div>

                                <div class="information-value">
                                    @post?.sWorkingShift
                                </div>

                            </div>

                        </div>


                        <!-- Internship Type -->

                        <div class="information-card tone-blue">

                            <div class="information-icon">
                                <i class="fa-solid fa-layer-group"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Internship Type
                                </div>

                                <div class="information-value">
                                    @post?.sInternshipTypeName
                                </div>

                            </div>

                        </div>


                        <!-- Fellowship -->

                        <div class="information-card tone-violet">

                            <div class="information-icon">
                                <i class="fa-solid fa-certificate"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Internship / Fellowship Type
                                </div>

                                <div class="information-value">
                                    @post?.sInternshipFellowshipTypeName
                                </div>

                            </div>

                        </div>


                        <!-- Training -->

                        <div class="information-card tone-green">

                            <div class="information-icon">
                                <i class="fa-solid fa-chalkboard-teacher"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Training Involved
                                </div>

                                <div class="information-value">
                                    @post?.sTrainingInvolvedName
                                </div>

                            </div>

                        </div>


                        <!-- Duration -->

                        <div class="information-card tone-purple">

                            <div class="information-icon">
                                <i class="fa-solid fa-hourglass-half"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Internship Duration
                                </div>

                                <div class="information-value">
                                    @post?.sInternshipDurationName
                                </div>

                            </div>

                        </div>


                        <!-- Start Date -->

                        <div class="information-card tone-teal">

                            <div class="information-icon">
                                <i class="fa-solid fa-calendar-plus"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Start Date
                                </div>

                                <div class="information-value">

                                    @(post != null &&
                                      post.dStartDate != DateTime.MinValue
                                        ? Convert.ToDateTime(
                                            post.dStartDate
                                          ).ToString("dd-MM-yyyy")
                                        : "-")

                                </div>

                            </div>

                        </div>


                        <!-- Completion Date -->

                        <div class="information-card tone-blue">

                            <div class="information-icon">
                                <i class="fa-solid fa-calendar-check"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Completion Date
                                </div>

                                <div class="information-value">

                                    @(post != null &&
                                      post.dCompletionDate != DateTime.MinValue
                                        ? Convert.ToDateTime(
                                            post.dCompletionDate
                                          ).ToString("dd-MM-yyyy")
                                        : "-")

                                </div>

                            </div>

                        </div>


                        <!-- Mode -->

                        <div class="information-card tone-green">

                            <div class="information-icon">
                                <i class="fa-solid fa-laptop-house"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Internship Mode
                                </div>

                                <div class="information-value">
                                    @post?.sInternshipModeName
                                </div>

                            </div>

                        </div>


                        <!-- Language -->

                        <div class="information-card tone-violet">

                            <div class="information-icon">
                                <i class="fa-solid fa-language"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Language Known
                                </div>

                                <div class="information-value">
                                    @post?.sLanguageKnown
                                </div>

                            </div>

                        </div>


                        <!-- Working Days -->

                        <div class="information-card tone-teal">

                            <div class="information-icon">
                                <i class="fa-solid fa-calendar-week"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Working Days
                                </div>

                                <div class="information-value">
                                    @post?.sWorkingDays
                                </div>

                            </div>

                        </div>


                        <!-- Facilities -->

                        <div class="information-card information-card-wide tone-red">

                            <div class="information-icon">
                                <i class="fa-solid fa-gift"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Facilities
                                </div>

                                <div class="information-value">

                                    @if (!string.IsNullOrWhiteSpace(
                                        post?.sFacilities))
                                    {
                                        @post.sFacilities
                                    }
                                    else
                                    {
                                        <span class="empty-value">
                                            N/A
                                        </span>
                                    }

                                </div>

                            </div>

                        </div>


                        <!-- Divyang -->

                        <div class="information-card tone-amber">

                            <div class="information-icon">
                                <i class="fa-solid fa-universal-access"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Divyang
                                </div>

                                <div class="information-value">
                                    @post?.sDivyang
                                </div>

                            </div>

                        </div>


                        <!-- Total Charges -->

                        <div class="information-card tone-green">

                            <div class="information-icon">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>

                            <div class="information-text">

                                <div class="information-label">
                                    Total Charges
                                </div>

                                <div class="information-value">

                                    @post?.sTotalCharges
                                    @post?.sCurrency

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         SKILLS
                    ================================================== -->

                    <div class="skills-wrapper">

                        <div class="skills-title">

                            <i class="fa-solid fa-code"></i>

                            <span>
                                Required Skills
                            </span>

                        </div>


                        <div class="skills-grid">


                            <!-- Medical -->

                            <div class="skill-card skill-medical">

                                <div class="skill-card-header">

                                    <div class="skill-icon">
                                        <i class="fa-solid fa-heart-pulse"></i>
                                    </div>

                                    <div>
                                        <strong>Medical Skills</strong>
                                        <small>Required expertise</small>
                                    </div>

                                </div>

                                <div class="skill-card-body">
                                    @post?.sMedicalSkills
                                </div>

                            </div>


                            <!-- Technical -->

                            <div class="skill-card skill-technical">

                                <div class="skill-card-header">

                                    <div class="skill-icon">
                                        <i class="fa-solid fa-laptop-code"></i>
                                    </div>

                                    <div>
                                        <strong>Technical Skills</strong>
                                        <small>Required expertise</small>
                                    </div>

                                </div>

                                <div class="skill-card-body">
                                    @post?.sTechnicalSkills
                                </div>

                            </div>


                            <!-- Non Technical -->

                            <div class="skill-card skill-nontechnical">

                                <div class="skill-card-header">

                                    <div class="skill-icon">
                                        <i class="fa-solid fa-people-group"></i>
                                    </div>

                                    <div>
                                        <strong>Non-Technical Skills</strong>
                                        <small>Required expertise</small>
                                    </div>

                                </div>

                                <div class="skill-card-body">
                                    @post?.sNonTechnicalSkills
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- =====================================================
             PREVIOUS / NEXT NAVIGATION
             ORIGINAL DYNAMIC CODE PRESERVED
        ====================================================== -->

        <section class="post-navigation">

            <!-- PREVIOUS -->

            <div class="navigation-side">

                @if (ViewBag.HasPrevious == true)
                {
                    <a asp-controller="Candidate"
                       asp-action="ViewMyOrgPost"
                       asp-route-id="@ViewBag.PreviousPostID"
                       class="navigation-btn navigation-light">

                        <i class="fa-solid fa-arrow-left"></i>

                        <span>Previous</span>

                    </a>
                }
                else
                {
                    <button type="button"
                            class="navigation-btn navigation-light"
                            disabled>

                        <i class="fa-solid fa-arrow-left"></i>

                        <span>Previous</span>

                    </button>
                }

            </div>


            <!-- BACK -->

            <div class="navigation-center">

                <a asp-controller="Candidate"
                   asp-action="MyInternship"
                   asp-route-id="@ViewBag.CandidateCode"
                   class="navigation-btn navigation-back">

                    <i class="fa-solid fa-list"></i>

                    <span>Back to My Internship</span>

                </a>

            </div>


            <!-- NEXT -->

            <div class="navigation-side navigation-next">

                @if (ViewBag.HasNext == true)
                {
                    <a asp-controller="Candidate"
                       asp-action="ViewMyOrgPost"
                       asp-route-id="@ViewBag.NextPostID"
                       class="navigation-btn navigation-primary">

                        <span>Next</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>
                }
                else
                {
                    <button type="button"
                            class="navigation-btn navigation-primary"
                            disabled>

                        <span>Next</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </button>
                }

            </div>

        </section>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <footer class="profile-footer">

            <span class="footer-brand">
                Powered by <strong>1Trainee</strong>
            </span>

            <span class="footer-info">
                Internship Details
                <i class="footer-separator"></i>
                Candidate
                <strong>@ViewBag.CandidateCode</strong>
            </span>

        </footer>

    </article>

</main>


<script>

    function goHome() {
        window.location.href = "/";
    }

    function printProfile() {
        window.print();
    }

    function downloadProfile() {
        window.print();
    }

</script>

</body>
</html>