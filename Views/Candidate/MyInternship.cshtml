@model List<MyInternshipViewModel>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "My Internship";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";

}
<style>
    .organization-name-link {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }

        .organization-name-link:hover {
            text-decoration: underline;
        }</style>
<div class="container-fluid">




    <!-- MASTER TABLE CARD -->
    <div class="master-table-container">




        <!-- TABLE -->
        <div class="table-responsive">
            <!-- PAGE HEADING -->
            <div class="mb-4">

                <h1 class="mb-2">
                    My Internship
                </h1>

                <p class="mb-0 text-muted">
                    @ViewBag.CandidateCode
                </p>

            </div>
            <table id="candidateTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>Sr. No</th>

                        <th>Organization Name</th>

                        <th>Position</th>

                        <th>Location</th>

                        <th>Internship / Fellowship Type</th>

                        <th>Facilities</th>

                        <th>Apply Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        int srNo = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- SR NO -->
                                <td class="master-id">
                                    @srNo
                                </td>

                                <!-- ORGANIZATION NAME -->
                                <td>
                                    @if (item.PostID > 0)
                                    {
                                        <a asp-controller="Candidate"
                                           asp-action="ViewAppliedOrgPost"
                                           asp-route-id="@item.PostID"
                                           class="organization-name-link">
                                            @item.OrganizationName
                                        </a>
                                    }
                                    else
                                    {
                                        @item.OrganizationName
                                    }
                                </td>

                                <!-- POSITION -->
                                <td>
                                    @item.Position
                                </td>

                                <!-- LOCATION -->
                                <td>
                                    @item.Location
                                </td>

                                <!-- INTERNSHIP / FELLOWSHIP TYPE -->
                                <td>
                                    @item.InternshipFellowshipType
                                </td>

                                <!-- FACILITIES -->
                                <td>
                                    @item.Facilities
                                </td>

                                <!-- APPLY STATUS -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.ApplyStatus))
                                    {
                                        <span class="master-status">
                                            @item.ApplyStatus
                                        </span>
                                    }

                                </td>

                            </tr>

                            srNo++;
                        }
                    }

                </tbody>

            </table>

        </div>


        <!-- PAGE INFO -->
        <div id="candidatePageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>