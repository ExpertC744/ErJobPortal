@model ErJobPortal.Models.OrgPostM

@{
     Layout = null;

    ViewData["Title"] = "Internship Post Details";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";

    var post = Model;
}

  <link href="~/css/ViewAppliedOrgPost.css" rel="stylesheet" />

<!-- Font Awesome (remove if already loaded in _DashboardLayout) -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />


<!-- =====================================================
     TOP RIGHT ACTION BUTTONS
====================================================== -->

<div class="profile-actions">

     <!-- PREVIOUS -->
    @if (ViewBag.HasPrevious == true)
    {
        <a asp-controller="Candidate"
           asp-action="ViewMyOrgPost"
           asp-route-id="@ViewBag.PreviousPostID"
           class="profile-action-btn"
           title="Previous Post">
            <i class="fa-solid fa-chevron-left"></i>
        </a>
    }
    else
    {
        <button type="button"
                class="profile-action-btn"
                title="Previous Post"
                disabled>
            <i class="fa-solid fa-chevron-left"></i>
        </button>
    }

    <!-- NEXT -->
    @if (ViewBag.HasNext == true)
    {
        <a asp-controller="Candidate"
           asp-action="ViewMyOrgPost"
           asp-route-id="@ViewBag.NextPostID"
           class="profile-action-btn"
           title="Next Post">
            <i class="fa-solid fa-chevron-right"></i>
        </a>
    }
    else
    {
        <button type="button"
                class="profile-action-btn"
                title="Next Post"
                disabled>
            <i class="fa-solid fa-chevron-right"></i>
        </button>
    }


    <a asp-controller="Candidate"
       asp-action="InternshipDetails"
       asp-route-id="@ViewBag.CandidateCode"
       class="profile-action-btn"
       title="Back to Internship Posts">
        <i class="fa-solid fa-house"></i>
    </a>

    <button type="button"
            class="profile-action-btn"
            title="Print"
            onclick="window.print()">
        <i class="fa-solid fa-print"></i>
    </button>

    <button type="button"
            class="profile-action-btn"
            title="Download"
            onclick="window.print()">
        <i class="fa-solid fa-download"></i>
    </button>

</div>


<div class="internship-page">

    <div class="internship-card">

        <!-- =====================================================
             COVER
        ====================================================== -->

        <div class="internship-cover">

            <div class="cover-left">

                <span class="cover-label">
                    Organization Post
                </span>

                <h1>Organization Post</h1>

                <p>Internship and trainee opportunity details</p>

            </div>

        </div>


        <!-- =====================================================
             IDENTITY (LOGO BOX + CANDIDATE CODE)
        ====================================================== -->

        <div class="post-identity">

            <!-- Logo: set your own src (or remove this img) -->
            <img src="@ViewBag.OrgLogo"
                 
                 class="post-identity-logo" />

            <div class="candidate-code-box">
                Candidate Code: @ViewBag.CandidateCode
            </div>

        </div>


        <!-- =====================================================
             BODY
        ====================================================== -->

        <div class="post-body">

            <div class="detail-section">

                <div class="detail-section-header">

                    <div class="detail-section-icon">
                        <i class="fa-solid fa-list"></i>
                    </div>

                    <h3>Post Information</h3>

                </div>

                <div class="detail-section-body">

                    <div class="information-grid">

                        <!-- Organization Name -->
                        <div class="information-card information-card-wide">
                            <div class="information-icon"><i class="fa-solid fa-building"></i></div>
                            <div class="information-text">
                                <div class="information-label">Organization Name</div>
                                <div class="information-value">@post?.sName</div>
                            </div>
                        </div>

                        <!-- Position -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-briefcase"></i></div>
                            <div class="information-text">
                                <div class="information-label">Position</div>
                                <div class="information-value">@post?.sPositionName</div>
                            </div>
                        </div>

                        <!-- Required Trainees -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-users"></i></div>
                            <div class="information-text">
                                <div class="information-label">Required Trainees</div>
                                <div class="information-value">@post?.nRequiredTrainees</div>
                            </div>
                        </div>

                        <!-- Gender -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-user"></i></div>
                            <div class="information-text">
                                <div class="information-label">Gender</div>
                                <div class="information-value">@post?.sGenderName</div>
                            </div>
                        </div>

                        <!-- Minimum Qualification -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-graduation-cap"></i></div>
                            <div class="information-text">
                                <div class="information-label">Minimum Qualification</div>
                                <div class="information-value">@post?.sMinimumQualificationName</div>
                            </div>
                        </div>

                        <!-- Country -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-globe"></i></div>
                            <div class="information-text">
                                <div class="information-label">Country</div>
                                <div class="information-value">@post?.sCountryName</div>
                            </div>
                        </div>

                        <!-- State -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-map"></i></div>
                            <div class="information-text">
                                <div class="information-label">State</div>
                                <div class="information-value">@post?.sStateName</div>
                            </div>
                        </div>

                        <!-- City -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-location-dot"></i></div>
                            <div class="information-text">
                                <div class="information-label">City</div>
                                <div class="information-value">@post?.nCityName</div>
                            </div>
                        </div>

                        <!-- Working Hours -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-clock"></i></div>
                            <div class="information-text">
                                <div class="information-label">Working Hours</div>
                                <div class="information-value">@post?.sWorkingHours</div>
                            </div>
                        </div>

                        <!-- Working Shift -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-business-time"></i></div>
                            <div class="information-text">
                                <div class="information-label">Working Shift</div>
                                <div class="information-value">@post?.sWorkingShift</div>
                            </div>
                        </div>

                        <!-- Internship Type -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-tag"></i></div>
                            <div class="information-text">
                                <div class="information-label">Internship Type</div>
                                <div class="information-value">@post?.sInternshipTypeName</div>
                            </div>
                        </div>

                        <!-- Internship / Fellowship Type -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-book-open"></i></div>
                            <div class="information-text">
                                <div class="information-label">Internship / Fellowship Type</div>
                                <div class="information-value">@post?.sInternshipFellowshipTypeName</div>
                            </div>
                        </div>

                        <!-- Training Involved -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
                            <div class="information-text">
                                <div class="information-label">Training Involved</div>
                                <div class="information-value">@post?.sTrainingInvolvedName</div>
                            </div>
                        </div>

                        <!-- Internship Duration -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                            <div class="information-text">
                                <div class="information-label">Internship Duration</div>
                                <div class="information-value">@post?.sInternshipDurationName</div>
                            </div>
                        </div>

                        <!-- Start Date -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-calendar-check"></i></div>
                            <div class="information-text">
                                <div class="information-label">Start Date</div>
                                <div class="information-value">
                                    @(post != null &&
                                        post.dStartDate != DateTime.MinValue
                                        ? Convert.ToDateTime(
                                        post.dStartDate)
                                        .ToString("dd-MM-yyyy")
                                        : "-")
                                </div>
                            </div>
                        </div>

                        <!-- Completion Date -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-calendar-days"></i></div>
                            <div class="information-text">
                                <div class="information-label">Completion Date</div>
                                <div class="information-value">
                                    @(post != null &&
                                        post.dCompletionDate != DateTime.MinValue
                                        ? Convert.ToDateTime(
                                        post.dCompletionDate)
                                        .ToString("dd-MM-yyyy")
                                        : "-")
                                </div>
                            </div>
                        </div>

                        <!-- Internship Mode -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-laptop-house"></i></div>
                            <div class="information-text">
                                <div class="information-label">Internship Mode</div>
                                <div class="information-value">@post?.sInternshipModeName</div>
                            </div>
                        </div>

                        <!-- Language Known -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-language"></i></div>
                            <div class="information-text">
                                <div class="information-label">Language Known</div>
                                <div class="information-value">@post?.sLanguageKnown</div>
                            </div>
                        </div>

                        <!-- Divyang -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-wheelchair"></i></div>
                            <div class="information-text">
                                <div class="information-label">Divyang (Allowed)</div>
                                <div class="information-value">@post?.sDivyang</div>
                            </div>
                        </div>

                        <!-- Total Charges -->
                        <div class="information-card">
                            <div class="information-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                            <div class="information-text">
                                <div class="information-label">Total Charges</div>
                                <div class="information-value">
                                    @post?.sTotalCharges
                                    @post?.sCurrency
                                </div>
                            </div>
                        </div>

                        <!-- Working Days -->
                        <div class="information-card information-card-wide">
                            <div class="information-icon"><i class="fa-solid fa-calendar-week"></i></div>
                            <div class="information-text">
                                <div class="information-label">Weekly Working Days</div>
                                <div class="information-value">@post?.sWorkingDays</div>
                            </div>
                        </div>

                        <!-- Facilities -->
                        <div class="information-card information-card-wide">
                            <div class="information-icon"><i class="fa-solid fa-gear"></i></div>
                            <div class="information-text">
                                <div class="information-label">Facilities Available</div>
                                <div class="information-value">
                                    @if (!string.IsNullOrWhiteSpace(
                                    post?.sFacilities))
                                    {
                                        @post.sFacilities
                                    }
                                    else
                                    {
                                        <span class="empty-value">
                                            N/A
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Medical Skills -->
                        <div class="information-card information-card-wide">
                            <div class="information-icon"><i class="fa-solid fa-briefcase-medical"></i></div>
                            <div class="information-text">
                                <div class="information-label">Medical Skills</div>
                                <div class="information-value">@post?.sMedicalSkills</div>
                            </div>
                        </div>

                        <!-- Technical Skills -->
                        <div class="information-card information-card-wide">
                            <div class="information-icon"><i class="fa-solid fa-code"></i></div>
                            <div class="information-text">
                                <div class="information-label">Technical Skills Required</div>
                                <div class="information-value">@post?.sTechnicalSkills</div>
                            </div>
                        </div>

                        <!-- Non Technical Skills -->
                        <div class="information-card information-card-wide">
                            <div class="information-icon"><i class="fa-solid fa-people-group"></i></div>
                            <div class="information-text">
                                <div class="information-label">Non-Technical Skills</div>
                                <div class="information-value">@post?.sNonTechnicalSkills</div>
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             PREVIOUS / NEXT NAVIGATION
             (hidden by .post-navigation { display:none } in CSS,
              remove that rule if you want it visible)
        ====================================================== -->

        <div class="post-navigation">

            @if (ViewBag.HasPrevious == true)
            {
                <a asp-controller="Candidate"
                   asp-action="ViewMyOrgPost"
                   asp-route-id="@ViewBag.PreviousPostID"
                   class="btn btn-secondary">← Previous</a>
            }
            else
            {
                <button type="button" class="btn btn-secondary" disabled>← Previous</button>
            }

            <a asp-controller="Candidate"
               asp-action="InternshipDetails"
               asp-route-id="@ViewBag.CandidateCode"
               class="btn btn-outline-secondary">Back to Internship Posts</a>

            @if (ViewBag.HasNext == true)
            {
                <a asp-controller="Candidate"
                   asp-action="ViewMyOrgPost"
                   asp-route-id="@ViewBag.NextPostID"
                   class="btn btn-primary">Next →</a>
            }
            else
            {
                <button type="button" class="btn btn-primary" disabled>Next →</button>
            }

        </div>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="profile-footer">

            <div class="footer-brand"></div>

            <div class="footer-info">
                Powered by <strong>www.1trainee.com</strong>
            </div>

        </div>

    </div>

</div>
