@model ErJobPortal.Models.CandidateFeedbackViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Add Feedback";
    ViewData["Panel"] = "Candidate";
    ViewData["UserName"] = "Candidate";
}
<link href="~/css/createfeedback.css" rel="stylesheet" />

<div class="feedback-page">

    <div class="feedback-container">

        <h1 class="feedback-title">
            Add Feedback
        </h1>


        @if (TempData["Success"] != null)
        {
            <div class="success-message">
                @TempData["Success"]
            </div>
        }


        @if (TempData["Error"] != null)
        {
            <div class="error-message">
                @TempData["Error"]
            </div>
        }


        <form asp-controller="Candidate"
              asp-action="CreateFeedback"
              method="post">

            @Html.AntiForgeryToken()


            <!-- =========================================
                 QUESTION 1
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        1.
                    </span>

                    @Model.Que1

                </div>


                <div class="radio-options">

                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue1"
                               value="True" />

                        <span>True</span>

                    </label>


                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue1"
                               value="False" />

                        <span>False</span>

                    </label>

                </div>

                <span asp-validation-for="sQue1"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 2 - STAR RATING
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        2.
                    </span>

                    @Model.Que2

                </div>


                <div class="star-options">

                    <input type="radio"
                           asp-for="sQue2"
                           value="1"
                           id="star1"
                           class="star-input" />

                    <label for="star1"
                           class="star"
                           data-value="1">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="2"
                           id="star2"
                           class="star-input" />

                    <label for="star2"
                           class="star"
                           data-value="2">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="3"
                           id="star3"
                           class="star-input" />

                    <label for="star3"
                           class="star"
                           data-value="3">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="4"
                           id="star4"
                           class="star-input" />

                    <label for="star4"
                           class="star"
                           data-value="4">
                        ☆
                    </label>


                    <input type="radio"
                           asp-for="sQue2"
                           value="5"
                           id="star5"
                           class="star-input" />

                    <label for="star5"
                           class="star"
                           data-value="5">
                        ☆
                    </label>

                </div>

                <span asp-validation-for="sQue2"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 3
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        3.
                    </span>

                    @Model.Que3

                </div>


                <div class="radio-options">

                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue3"
                               value="Yes" />

                        <span>Yes</span>

                    </label>


                    <label class="radio-option">

                        <input type="radio"
                               asp-for="sQue3"
                               value="No" />

                        <span>No</span>

                    </label>

                </div>

                <span asp-validation-for="sQue3"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 4 - EMOJI
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        4.
                    </span>

                    @Model.Que4

                </div>


                <div class="emoji-options">

                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="1" />

                        <span class="emoji">
                            😡
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="2" />

                        <span class="emoji">
                            😟
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="3" />

                        <span class="emoji">
                            😐
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="4" />

                        <span class="emoji">
                            🙂
                        </span>

                    </label>


                    <label class="emoji-option">

                        <input type="radio"
                               asp-for="sQue4"
                               value="5" />

                        <span class="emoji">
                            😍
                        </span>

                    </label>

                </div>

                <span asp-validation-for="sQue4"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 QUESTION 5
                 ========================================= -->

            <div class="feedback-question-box">

                <div class="question-text">

                    <span class="question-number">
                        5.
                    </span>

                    @Model.Que5

                </div>


                <textarea asp-for="sQue5"
                          class="feedback-textarea"
                          placeholder="Enter your feedback..."></textarea>

                <span asp-validation-for="sQue5"
                      class="field-validation">
                </span>

            </div>


            <!-- =========================================
                 SUBMIT
                 ========================================= -->

            <div class="submit-area">

                <button type="submit"
                        class="submit-button">
                    Submit
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const stars =
                    document.querySelectorAll(".star");

                const inputs =
                    document.querySelectorAll(".star-input");


                function updateStars(selectedValue) {

                    stars.forEach(function (star) {

                        const value =
                            parseInt(
                                star.getAttribute("data-value")
                            );

                        if (value <= selectedValue) {
                            star.textContent = "★";
                        }
                        else {
                            star.textContent = "☆";
                        }

                    });
                }


                stars.forEach(function (star) {

                    star.addEventListener(
                        "click",
                        function () {

                            const selectedValue =
                                parseInt(
                                    this.getAttribute(
                                        "data-value"
                                    )
                                );

                            updateStars(selectedValue);
                        }
                    );

                });


                // Restore selected stars
                inputs.forEach(function (input) {

                    if (input.checked) {

                        updateStars(
                            parseInt(input.value)
                        );

                    }

                });

            }
        );

    </script>
}
