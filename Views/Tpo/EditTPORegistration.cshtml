@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "Edit TPO Registration";
    ViewData["Panel"] = "TPO";
}

<link rel="stylesheet" href="~/css/TPORegister.css" asp-append-version="true" />

<div class="candidate-register-page">

    <div class="candidate-register-card">

        <!-- HEADER -->
        <div class="register-icon">
            <i class="fa-solid fa-user-pen"></i>
        </div>

        <div class="register-heading">
            <h2>Edit TPO Profile</h2>
            <p>Update your Training &amp; Placement Officer details</p>
        </div>

        <!-- SUCCESS / ERROR MESSAGE -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success register-alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger register-alert">
                @TempData["Error"]
            </div>
        }

        <!-- EDIT FORM -->
        <form asp-controller="Account"
              asp-action="EditTPORegistration"
              method="post"
              enctype="multipart/form-data"
              id="editTPOForm">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="text-danger register-summary">
            </div>

            <!-- PERSONAL INFORMATION -->
            <div class="register-form-row">

                <div class="register-form-group">
                    <label asp-for="FullName" class="register-label">
                        Full Name
                    </label>

                    <input asp-for="FullName"
                           type="text"
                           class="register-input"
                           placeholder="full name"
                           autocomplete="name" />

                    <span asp-validation-for="FullName"
                          class="text-danger register-validation"></span>
                </div>

                <div class="register-form-group">
                    <label asp-for="MobileNo" class="register-label">
                        Mobile Number
                    </label>

                    <input asp-for="MobileNo"
                           type="tel"
                           class="register-input"
                           placeholder="10 digit mobile number"
                           maxlength="10"
                           inputmode="numeric"
                           autocomplete="tel" />

                    <span asp-validation-for="MobileNo"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">
                    <label asp-for="CollegeMailID" class="register-label">
                        College Mail ID
                    </label>

                    <input asp-for="CollegeMailID"
                           type="email"
                           class="register-input"
                           placeholder="official college email"
                           autocomplete="email" />

                    <span asp-validation-for="CollegeMailID"
                          class="text-danger register-validation"></span>
                </div>

                <div class="register-form-group">
                    <label asp-for="CollegeEmployeeID" class="register-label">
                        College Employee ID
                    </label>

                    <input asp-for="CollegeEmployeeID"
                           type="text"
                           class="register-input"
                           placeholder="employee ID"
                           autocomplete="off" />

                    <span asp-validation-for="CollegeEmployeeID"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <!-- COLLEGE INFORMATION -->
            <div class="register-form-row">

                <div class="register-form-group">
                    <label asp-for="CollegeName" class="register-label">
                        College Name
                    </label>

                    <div class="register-input-box">
                        <select asp-for="CollegeName"
                                id="CollegeName"
                                class="register-select">
                            <option value="0">-- Select College Name --</option>
                        </select>
                    </div>

                    <span asp-validation-for="CollegeName"
                          class="text-danger register-validation"></span>
                </div>

                <div class="register-form-group">
                    <label asp-for="CollegeCode" class="register-label">
                        College Code
                    </label>

                    <div class="register-input-box">
                        <select asp-for="CollegeCode"
                                id="CollegeCode"
                                class="register-select">
                            <option value="0">-- Select College Code --</option>
                        </select>
                    </div>

                    <span asp-validation-for="CollegeCode"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">
                    <label asp-for="Designation" class="register-label">
                        Designation
                    </label>

                    <input asp-for="Designation"
                           type="text"
                           class="register-input"
                           placeholder="e.g. Training &amp; Placement Officer" />

                    <span asp-validation-for="Designation"
                          class="text-danger register-validation"></span>
                </div>

                <div class="register-form-group">
                    <label asp-for="nDepartment" class="register-label">
                        Department
                    </label>

                    <div class="register-input-box">
                        <select asp-for="nDepartment"
                                id="departmentSelect"
                                class="register-select">
                            <option value="0">-- Select Department --</option>
                        </select>
                    </div>

                    <span asp-validation-for="nDepartment"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <div class="register-form-row">

                <div class="register-form-group">
                    <label asp-for="OrganizationWebsiteURL" class="register-label">
                        College Website URL
                    </label>

                    <input asp-for="OrganizationWebsiteURL"
                           type="url"
                           class="register-input"
                           placeholder="https://www.examplecollege.ac.in"
                           autocomplete="url" />

                    <span asp-validation-for="OrganizationWebsiteURL"
                          class="text-danger register-validation"></span>
                </div>

                <div class="register-form-group">
                    <label asp-for="ProfilePhotoFile" class="register-label">
                        Change Profile Photo
                    </label>

                    <input asp-for="ProfilePhotoFile"
                           type="file"
                           accept=".jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <small style="display:block; margin-top:4px; color:#98a2b3; font-size:11px;">
                        Leave empty to keep the existing photo.
                    </small>

                    <span asp-validation-for="ProfilePhotoFile"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <!-- ADDRESS -->
            <div class="register-form-row full">

                <div class="register-form-group">
                    <label asp-for="CollegeAddress" class="register-label">
                        College Address
                    </label>

                    <textarea asp-for="CollegeAddress"
                              class="register-input"
                              rows="3"
                              placeholder="complete college address"></textarea>

                    <span asp-validation-for="CollegeAddress"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <!-- SUPPORTING DOCUMENTS -->
            <div class="register-form-row">

                <div class="register-form-group">
                    <label asp-for="SupportingDocument1File" class="register-label">
                        Update Supporting Document 1
                        <small>(ID Card / Appointment Letter)</small>
                    </label>

                    <input asp-for="SupportingDocument1File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <small style="display:block; margin-top:4px; color:#98a2b3; font-size:11px;">
                        Leave empty to keep the existing document.
                    </small>

                    <span asp-validation-for="SupportingDocument1File"
                          class="text-danger register-validation"></span>
                </div>

                <div class="register-form-group">
                    <label asp-for="SupportingDocument2File" class="register-label">
                        Update Supporting Document 2
                        <small>(Authorization / Other Proof)</small>
                    </label>

                    <input asp-for="SupportingDocument2File"
                           type="file"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file" />

                    <small style="display:block; margin-top:4px; color:#98a2b3; font-size:11px;">
                        Leave empty to keep the existing document.
                    </small>

                    <span asp-validation-for="SupportingDocument2File"
                          class="text-danger register-validation"></span>
                </div>

            </div>

            <!-- INFORMATION NOTICE -->
            <div class="alert alert-info">
                <i class="fa-solid fa-circle-info"></i>
                Only select new files if you want to replace your existing photo or documents.
                Your account approval status should remain unchanged when editing your profile.
            </div>

            <!-- ACTION BUTTONS -->
            <div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-top:17px;">

                <button type="submit" class="register-main-btn" style="margin:0;">
                    <i class="fa-solid fa-floppy-disk"></i>
                    Update Profile
                </button>

                <button type="reset"
                        class="register-main-btn"
                        style="margin:0; background:#64748b; box-shadow:none;"
                        id="resetEditTPO">
                    <i class="fa-solid fa-rotate-left"></i>
                    Reset Changes
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            const collegeNameSelect = $('#CollegeName');
            const collegeCodeSelect = $('#CollegeCode');
            const departmentSelect = $('#departmentSelect');

            // Current values from the model, used to preselect saved data.
            const savedCollegeName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CollegeName));
            const savedCollegeCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.CollegeCode));
            const savedDepartment = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model?.nDepartment));

            // Trim leading spaces and clean up text inputs.
            $('#editTPOForm')
                .find('input[type="text"], input[type="email"], input[type="url"], input[type="tel"], textarea')
                .on('keydown', function (e) {
                    if (e.key === ' ' && this.selectionStart === 0 && this.value.length === 0) {
                        e.preventDefault();
                    }
                })
                .on('input', function () {
                    this.value = this.value.replace(/^\s+/, '');
                })
                .on('blur', function () {
                    this.value = this.value.trim();
                });

            // Mobile number: digits only, maximum 10 digits.
            $('#MobileNo').on('input', function () {
                this.value = this.value.replace(/\D/g, '').substring(0, 10);
            });

            // Load colleges and select the saved college.
            $.ajax({
                url: '@Url.Action("GetColleges", "Account")',
                type: 'GET',
                success: function (data) {

                    collegeNameSelect.empty().append(
                        $('<option>', {
                            value: '0',
                            text: '-- Select College Name --'
                        })
                    );

                    $.each(data || [], function (index, college) {
                        collegeNameSelect.append(
                            $('<option>', {
                                value: college.nID,
                                text: college.sCollegeName
                            })
                        );
                    });

                    if (savedCollegeName !== null && savedCollegeName !== undefined) {
                        collegeNameSelect.val(String(savedCollegeName));
                    }

                    // Load the corresponding college codes after setting the college.
                    loadCollegeCodes(collegeNameSelect.val(), savedCollegeCode);
                },
                error: function (xhr, status, error) {
                    console.error('College loading failed:', error);
                }
            });

            // Load departments and select the saved department.
            $.ajax({
                url: '@Url.Action("GetDepartments", "Account")',
                type: 'GET',
                success: function (data) {

                    departmentSelect.empty().append(
                        $('<option>', {
                            value: '0',
                            text: '-- Select Department --'
                        })
                    );

                    $.each(data || [], function (index, item) {
                        departmentSelect.append(
                            $('<option>', {
                                value: item.nID,
                                text: item.sDepartment
                            })
                        );
                    });

                    if (savedDepartment !== null && savedDepartment !== undefined) {
                        departmentSelect.val(String(savedDepartment));
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Department loading failed:', error);
                }
            });

            // Load college codes for the selected college.
            function loadCollegeCodes(collegeId, selectedCode) {

                collegeCodeSelect.empty().append(
                    $('<option>', {
                        value: '0',
                        text: '-- Select College Code --'
                    })
                );

                if (!collegeId || collegeId === '0') {
                    return;
                }

                $.ajax({
                    url: '@Url.Action("GetCollegeCodes", "Account")',
                    type: 'GET',
                    data: { collegeId: collegeId },
                    success: function (data) {

                        $.each(data || [], function (index, code) {
                            collegeCodeSelect.append(
                                $('<option>', {
                                    value: code.nCode,
                                    text: code.nCode
                                })
                            );
                        });

                        if (selectedCode !== null && selectedCode !== undefined) {
                            collegeCodeSelect.val(String(selectedCode));
                        }
                    },
                    error: function (xhr, status, error) {
                        console.error('College code loading failed:', error);
                    }
                });
            }

            // Changing college reloads its codes.
            collegeNameSelect.on('change', function () {
                loadCollegeCodes($(this).val(), null);
            });

            // Reset saved model values rather than clearing the form.
            $('#resetEditTPO').on('click', function (e) {
                e.preventDefault();

                const form = document.getElementById('editTPOForm');
                form.reset();

                collegeNameSelect.val(savedCollegeName == null ? '0' : String(savedCollegeName));
                departmentSelect.val(savedDepartment == null ? '0' : String(savedDepartment));

                loadCollegeCodes(
                    collegeNameSelect.val(),
                    savedCollegeCode
                );
            });

        });
    </script>
}