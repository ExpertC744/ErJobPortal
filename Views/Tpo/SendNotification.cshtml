@using ErJobPortal.Models
@model TPOSendNotificationM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Send Notification";
    ViewData["Panel"] = "TPO";

    ViewData["UserName"] =
        Context.Session.GetString("TPOName") ?? "TPO";

    List<TPONotificationListM> notifications =
        ViewBag.Notifications as List<TPONotificationListM>
        ?? new List<TPONotificationListM>();

    List<DepartmentM> departments =
        ViewBag.Departments as List<DepartmentM>
        ?? new List<DepartmentM>();

    List<BranchM> branches =
        ViewBag.Branches as List<BranchM>
        ?? new List<BranchM>();

    int? selectedDepartment =
        ViewBag.DepartmentId as int?;

    int? selectedBranch =
        ViewBag.BranchId as int?;

    string searchText =
        ViewBag.SearchText?.ToString() ?? "";

    int traineeCount =
        ViewBag.TraineeCount != null
            ? Convert.ToInt32(ViewBag.TraineeCount)
            : 0;
}

<style>

    /* =========================================================
       MAIN
    ========================================================= */

    .send-notification-wrapper {
        padding: 20px 0 40px;
    }

    .notification-card {
        background: #ffffff;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 8px 30px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .notification-card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #e5e7eb;
        background: #ffffff;
    }

    .notification-card-header h4 {
        margin: 0;
        font-weight: 700;
        color: #1f2937;
    }

    .notification-card-header p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    /* =========================================================
       FORM
    ========================================================= */

    .form-section {
        padding: 25px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #374151;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.12);
    }

    .notification-select-row {
        display: flex;
        gap: 10px;
        align-items: flex-end;
    }

    .notification-select-wrapper {
        flex: 1;
    }

    .create-new-btn {
        min-height: 44px;
        white-space: nowrap;
        border-radius: 8px;
    }

    /* =========================================================
       COLLEGE
    ========================================================= */

    .college-info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 13px 16px;
        margin-bottom: 20px;
    }

    .college-info-label {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 2px;
    }

    .college-info-value {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
    }

    /* =========================================================
       STUDENTS
    ========================================================= */

    .student-section {
        border-top: 1px solid #e5e7eb;
        padding: 25px;
    }

    .student-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }

    .student-section-title {
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .student-count {
        background: #eef2ff;
        color: #4338ca;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .student-table-wrapper {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow-x: auto;
    }

    .student-table {
        margin: 0;
        min-width: 900px;
    }

    .student-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 13px;
        font-weight: 700;
        padding: 13px 12px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .student-table tbody td {
        padding: 13px 12px;
        vertical-align: middle;
        font-size: 14px;
        color: #374151;
    }

    .student-table tbody tr:hover {
        background: #f8fafc;
    }

    .student-name {
        font-weight: 600;
        color: #1f2937;
    }

    .student-email {
        color: #64748b;
        font-size: 13px;
    }

    .student-mobile {
        white-space: nowrap;
    }

    .empty-student {
        padding: 45px !important;
        text-align: center;
        color: #94a3b8;
    }

    /* =========================================================
       CHECKBOX
    ========================================================= */

    .student-checkbox,
    #selectAllStudents {
        width: 17px;
        height: 17px;
        cursor: pointer;
    }

    /* =========================================================
       PREVIEW
    ========================================================= */

    .preview-section {
        border-top: 1px solid #e5e7eb;
        padding: 25px;
    }

    .preview-box {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
        padding: 20px;
    }

    .preview-title {
        font-size: 17px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 12px;
    }

    .preview-content {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        min-height: 100px;
        color: #374151;
        white-space: pre-wrap;
    }

    .attachment-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #475569;
        font-size: 13px;
        margin: 3px;
    }

    /* =========================================================
       ACTION
    ========================================================= */

    .action-section {
        border-top: 1px solid #e5e7eb;
        padding: 20px 25px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: #fafafa;
    }

    .send-btn {
        min-width: 150px;
        min-height: 44px;
        border-radius: 8px;
        font-weight: 600;
    }

    .filter-btn {
        min-height: 44px;
        border-radius: 8px;
        font-weight: 600;
    }

    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 768px) {

        .form-section,
        .student-section,
        .preview-section {
            padding: 18px;
        }

        .notification-card-header {
            padding: 18px;
        }

        .notification-select-row {
            flex-direction: column;
            align-items: stretch;
        }

        .create-new-btn {
            width: 100%;
        }

        .action-section {
            padding: 18px;
            flex-direction: column;
        }

        .send-btn,
        .filter-btn {
            width: 100%;
        }
    }

</style>


<div class="container-fluid send-notification-wrapper">

    <div class="notification-card">

        @Html.AntiForgeryToken()

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="notification-card-header">

            <h4>
                <i class="fas fa-paper-plane me-2"></i>
                Send Notification
            </h4>

            <p>
                Select a notification and choose the students who
                should receive it.
            </p>

        </div>


        <!-- =====================================================
             FORM SECTION
        ====================================================== -->

        <div class="form-section">

            <form method="get"
                  asp-controller="TPO"
                  asp-action="SendNotification">

                <!-- =================================================
                     NOTIFICATION
                ================================================== -->

                <div class="mb-4">

                    <label class="form-label-custom">
                        Select Notification
                        <span class="text-danger">*</span>
                    </label>

                    <div class="notification-select-row">

                        <div class="notification-select-wrapper">

                            <select name="notificationId"
                                    id="notificationId"
                                    class="form-select">

                                <option value="">
                                    -- Select Notification --
                                </option>

                                @foreach (var notification in notifications)
                                {
                                    bool isSelected =
                                        Model.NotificationID ==
                                        notification.NotificationID;

                                    <option value="@notification.NotificationID"
                                            selected="@isSelected">

                                        @notification.Title

                                        @if (!string.IsNullOrWhiteSpace(notification.Type))
                                        {
                                            @: (@notification.Type)
                                        }

                                    </option>
                                }

                            </select>

                        </div>

                        <a asp-controller="TPO"
                           asp-action="CreateNotification"
                           class="btn btn-outline-primary create-new-btn">

                            <i class="fas fa-plus me-1"></i>
                            Create New

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     COLLEGE INFORMATION
                ================================================== -->

                <div class="college-info-box">

                    <div class="row">

                        <div class="col-md-6 mb-2 mb-md-0">

                            <div class="college-info-label">
                                College
                            </div>

                            <div class="college-info-value">
                                @ViewBag.CollegeName
                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="college-info-label">
                                College Code
                            </div>

                            <div class="college-info-value">
                                @ViewBag.CollegeCode
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FILTERS
                ================================================== -->

                <div class="row g-3">

                    <!-- Department -->

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label-custom">
                            Department
                        </label>

                        <select id="departmentId"
                                name="departmentId"
                                class="form-select">

                            <option value="">
                                All Departments
                            </option>

                            @foreach (var department in departments)
                            {
                                <option value="@department.nID"
                                        selected="@(selectedDepartment == department.nID)">

                                    @department.sDepartment

                                </option>
                            }

                        </select>

                    </div>


                    <!-- Branch -->

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label-custom">
                            Branch
                        </label>

                        <select id="branchId"
                                name="branchId"
                                class="form-select">

                            <option value="">
                                All Branches
                            </option>

                            @foreach (var branch in branches)
                            {
                                <option value="@branch.nID"
                                        selected="@(selectedBranch == branch.nID)">

                                    @branch.sBranch

                                </option>
                            }

                        </select>

                    </div>


                    <!-- Search -->

                    <div class="col-lg-4 col-md-12">

                        <label class="form-label-custom">
                            Search Students
                        </label>

                        <input type="text"
                               name="searchText"
                               id="searchText"
                               class="form-control"
                               value="@searchText"
                               placeholder="Name / Email / Mobile / DOB" />

                    </div>

                </div>


                <!-- =================================================
                     FILTER BUTTON
                ================================================== -->

                <div class="mt-3">

                    <button type="submit"
                            class="btn btn-primary filter-btn">

                        <i class="fas fa-search me-1"></i>
                        Search Students

                    </button>

                    <a asp-controller="TPO"
                       asp-action="SendNotification"
                       class="btn btn-outline-secondary filter-btn ms-1">

                        <i class="fas fa-sync-alt me-1"></i>
                        Reset

                    </a>

                </div>

            </form>

        </div>


        <!-- =====================================================
             STUDENTS
        ====================================================== -->

        <div class="student-section">

            <div class="student-section-header">

                <div>

                    <h5 class="student-section-title">
                        Select Students
                    </h5>

                    <div class="text-muted small mt-1">
                        Only students belonging to your college
                        are displayed.
                    </div>

                </div>

                <div class="student-count">

                    Total Students:
                    <span id="totalStudentCount">
                        @traineeCount
                    </span>

                    &nbsp; | &nbsp;

                    Selected:
                    <span id="selectedStudentCount">
                        0
                    </span>

                </div>

            </div>


            <!-- =================================================
                 SELECT ALL
            ================================================== -->

            <div class="mb-3">

                <div class="form-check">

                    <input type="checkbox"
                           class="form-check-input"
                           id="selectAllStudents" />

                    <label class="form-check-label fw-semibold"
                           for="selectAllStudents">

                        Select All Students

                    </label>

                </div>

            </div>


            <!-- =================================================
                 STUDENT TABLE
            ================================================== -->

            <div class="student-table-wrapper">

                <table class="table student-table">

                    <thead>

                        <tr>

                            <th style="width:50px;">
                                #
                            </th>

                            <th style="width:50px;">
                                <i class="fas fa-check"></i>
                            </th>

                            <th>
                                Student
                            </th>

                            <th>
                                Email
                            </th>

                            <th>
                                Mobile
                            </th>

                            <th>
                                Branch
                            </th>

                            <th>
                                Current Year
                            </th>

                            <th>
                                Passout Year
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Students != null &&
                             Model.Students.Count > 0)
                        {
                            int rowNumber = 1;

                            foreach (var student in Model.Students)
                            {
                                <tr>

                                    <td>
                                        @rowNumber
                                    </td>

                                    <td>

                                        <input type="checkbox"
                                               class="form-check-input student-checkbox"
                                               name="selectedCandidateIds"
                                               value="@student.nID" />

                                    </td>

                                    <td>

                                        <div class="student-name">

                                            @student.PrefixName
                                            @student.FullName

                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(student.CandidateCode))
                                        {
                                            <div class="text-muted small">
                                                @student.CandidateCode
                                            </div>
                                        }

                                    </td>

                                    <td>

                                        <div class="student-email">

                                            @(string.IsNullOrWhiteSpace(student.sEmail)
                                                ? "-"
                                                : student.sEmail)

                                        </div>

                                    </td>

                                    <td>

                                        <div class="student-mobile">

                                            @(string.IsNullOrWhiteSpace(student.sMobile)
                                                ? "-"
                                                : student.sMobile)

                                        </div>

                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(student.BranchName))
                                        {
                                            @student.BranchName
                                        }
                                        else
                                        {
                                            @:-
                                        }

                                    </td>

                                    <td>

                                        @(student.nCurrentYear?.ToString() ?? "-")

                                    </td>

                                    <td>

                                        @(student.nPassoutYear?.ToString() ?? "-")

                                    </td>

                                </tr>

                                rowNumber++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="empty-student">

                                    <i class="fas fa-users fa-2x mb-3"></i>

                                    <div class="fw-semibold">
                                        No students found
                                    </div>

                                    <div class="small mt-1">
                                        Try changing the department,
                                        branch or search criteria.
                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- =====================================================
             PREVIEW
        ====================================================== -->

        <div class="preview-section">

            <div class="preview-box">

                <div class="preview-title">

                    <i class="fas fa-eye me-2"></i>
                    Notification Preview

                </div>


                @if (Model.NotificationID > 0)
                {
                    <div class="mb-3">

                        <div class="fw-semibold text-dark">
                            @Model.Title
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Type))
                        {
                            <span class="badge bg-primary mt-2">
                                @Model.Type
                            </span>
                        }

                    </div>


                    <div class="preview-content">

                        @Html.Raw(Model.Content)

                    </div>


                    <!-- ATTACHMENTS -->

                    @if (!string.IsNullOrWhiteSpace(Model.Attachment1OriginalName)
                        ||
                        !string.IsNullOrWhiteSpace(Model.Attachment2OriginalName))
                    {
                        <div class="mt-3">

                            <div class="fw-semibold mb-2">
                                Attachments
                            </div>

                            @if (!string.IsNullOrWhiteSpace(Model.Attachment1OriginalName))
                            {
                                <span class="attachment-item">

                                    <i class="fas fa-paperclip"></i>

                                    @Model.Attachment1OriginalName

                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Attachment2OriginalName))
                            {
                                <span class="attachment-item">

                                    <i class="fas fa-paperclip"></i>

                                    @Model.Attachment2OriginalName

                                </span>
                            }

                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">

                        <i class="fas fa-info-circle me-2"></i>

                        Select a notification above to preview
                        its content.

                    </div>
                }

            </div>

        </div>


        <!-- =====================================================
             SEND ACTION
        ====================================================== -->

        <div class="action-section">

            <div class="me-auto text-muted small"
                 id="sendMessage">

                Select students to enable Send Now.

            </div>

            <button type="button"
                    id="sendNowButton"
                    class="btn btn-primary send-btn"
                    disabled>

                <i class="fas fa-paper-plane me-2"></i>
                Send Now

            </button>

        </div>

    </div>

</div>





<!-- =========================================================
     SEND CONFIRMATION MODAL
========================================================== -->

<div class="modal fade"
     id="sendNotificationModal"
     tabindex="-1"
     aria-labelledby="sendNotificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="sendNotificationModalLabel">
                    <i class="fas fa-paper-plane me-2"></i>
                    Confirm Send
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body">
                <p class="mb-2">
                    Are you sure you want to send this notification
                    to the selected students?
                </p>

                <div class="alert alert-info mb-0">
                    <strong id="modalSelectedCount">0</strong>
                    student(s) selected.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="confirmSendButton"
                        class="btn btn-primary">
                    <i class="fas fa-paper-plane me-1"></i>
                    Confirm Send
                </button>
            </div>

        </div>
    </div>
</div>

<!-- Schedule popup -->


<script>

    // =========================================================
    // SEND NOTIFICATION PAGE
    // =========================================================

    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // ELEMENTS
        // =====================================================

        const selectAllCheckbox =
            document.getElementById("selectAllStudents");

        const sendNowButton =
            document.getElementById("sendNowButton");

        const confirmSendButton =
            document.getElementById("confirmSendButton");

        const departmentDropdown =
            document.getElementById("departmentId");

        const branchDropdown =
            document.getElementById("branchId");

        // IMPORTANT:
        // Always get notification from the actual dropdown.
        // Do NOT use @Model.NotificationID for client-side
        // validation because the page is not submitted yet.

        const notificationDropdown =
            document.getElementById("notificationId");


        // =====================================================
        // GET SELECTED STUDENTS
        // =====================================================

        function getSelectedStudents() {

            return Array.from(
                document.querySelectorAll(
                    ".student-checkbox:checked"
                )
            );

        }


        // =====================================================
        // UPDATE SELECTED COUNT
        // =====================================================

        function updateSelectedCount() {

            const selected =
                getSelectedStudents();

            const count =
                selected.length;


            // Selected count

            const selectedCountElement =
                document.getElementById(
                    "selectedStudentCount"
                );

            if (selectedCountElement) {

                selectedCountElement.innerText =
                    count;

            }


            // Send button

            if (sendNowButton) {

                sendNowButton.disabled =
                    count === 0;

            }


            // Message

            const message =
                document.getElementById(
                    "sendMessage"
                );

            if (message) {

                if (count === 0) {

                    message.innerText =
                        "Select students to enable Send Now.";

                }
                else {

                    message.innerText =
                        count +
                        " student(s) selected.";

                }

            }


            // Select all state

            const allCheckboxes =
                document.querySelectorAll(
                    ".student-checkbox"
                );

            if (!selectAllCheckbox) {
                return;
            }


            if (allCheckboxes.length === 0) {

                selectAllCheckbox.checked =
                    false;

                selectAllCheckbox.indeterminate =
                    false;

                return;
            }


            const checkedCount =
                document.querySelectorAll(
                    ".student-checkbox:checked"
                ).length;


            if (checkedCount === 0) {

                selectAllCheckbox.checked =
                    false;

                selectAllCheckbox.indeterminate =
                    false;

            }
            else if (
                checkedCount ===
                allCheckboxes.length
            ) {

                selectAllCheckbox.checked =
                    true;

                selectAllCheckbox.indeterminate =
                    false;

            }
            else {

                selectAllCheckbox.checked =
                    false;

                selectAllCheckbox.indeterminate =
                    false;

            }

        }


        // =====================================================
        // SELECT ALL
        // =====================================================

        if (selectAllCheckbox) {

            selectAllCheckbox.addEventListener(
                "change",
                function () {

                    const checked =
                        this.checked;

                    document
                        .querySelectorAll(
                            ".student-checkbox"
                        )
                        .forEach(
                            function (checkbox) {

                                checkbox.checked =
                                    checked;

                            }
                        );

                    updateSelectedCount();

                }
            );

        }


        // =====================================================
        // INDIVIDUAL CHECKBOXES
        // =====================================================

        document
            .querySelectorAll(
                ".student-checkbox"
            )
            .forEach(
                function (checkbox) {

                    checkbox.addEventListener(
                        "change",
                        function () {

                            updateSelectedCount();

                        }
                    );

                }
            );


        // =====================================================
        // SEND NOW
        // =====================================================

        if (sendNowButton) {

            sendNowButton.addEventListener(
                "click",
                function () {

                    const selected =
                        getSelectedStudents();


                    // -----------------------------------------
                    // STUDENT VALIDATION
                    // -----------------------------------------

                    if (selected.length === 0) {

                        alert(
                            "Please select at least one student."
                        );

                        return;

                    }


                    // -----------------------------------------
                    // GET NOTIFICATION FROM DROPDOWN
                    // -----------------------------------------

                    const notificationId =
                        notificationDropdown
                            ? notificationDropdown.value
                            : "";


                    // -----------------------------------------
                    // NOTIFICATION VALIDATION
                    // -----------------------------------------

                    if (!notificationId) {

                        alert(
                            "Please select a notification first."
                        );

                        return;

                    }


                    // -----------------------------------------
                    // MODAL COUNT
                    // -----------------------------------------

                    const modalSelectedCount =
                        document.getElementById(
                            "modalSelectedCount"
                        );

                    if (modalSelectedCount) {

                        modalSelectedCount.innerText =
                            selected.length;

                    }


                    // -----------------------------------------
                    // MODAL
                    // -----------------------------------------

                    const modalElement =
                        document.getElementById(
                            "sendNotificationModal"
                        );

                    if (!modalElement) {

                        alert(
                            "Send notification confirmation modal was not found."
                        );

                        return;

                    }


                    const modal =
                        bootstrap.Modal.getOrCreateInstance(
                            modalElement
                        );

                    modal.show();

                }
            );

        }


        // =====================================================
        // CONFIRM SEND
        // =====================================================

        if (confirmSendButton) {

            confirmSendButton.addEventListener(
                "click",
                function () {

                    const selected =
                        getSelectedStudents();


                    // -----------------------------------------
                    // STUDENT VALIDATION
                    // -----------------------------------------

                    if (selected.length === 0) {

                        alert(
                            "Please select at least one student."
                        );

                        return;

                    }


                    // -----------------------------------------
                    // GET NOTIFICATION FROM DROPDOWN
                    // -----------------------------------------

                    const notificationId =
                        notificationDropdown
                            ? notificationDropdown.value
                            : "";


                    // -----------------------------------------
                    // NOTIFICATION VALIDATION
                    // -----------------------------------------

                    if (!notificationId) {

                        alert(
                            "Please select a notification first."
                        );

                        return;

                    }


                    // =================================================
                    // CREATE POST FORM
                    // =================================================

                    const form =
                        document.createElement("form");

                    form.method =
                        "POST";

                    form.action =
                        "/TPO/SendNotification";


                    // =================================================
                    // ANTI FORGERY TOKEN
                    // =================================================

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        );

                    if (token) {

                        const tokenInput =
                            document.createElement("input");

                        tokenInput.type =
                            "hidden";

                        tokenInput.name =
                            "__RequestVerificationToken";

                        tokenInput.value =
                            token.value;

                        form.appendChild(
                            tokenInput
                        );

                    }


                    // =================================================
                    // NOTIFICATION ID
                    // =================================================

                    const notificationInput =
                        document.createElement("input");

                    notificationInput.type =
                        "hidden";

                    notificationInput.name =
                        "NotificationID";

                    // IMPORTANT:
                    // Send the selected dropdown value,
                    // NOT @Model.NotificationID.

                    notificationInput.value =
                        notificationId;

                    form.appendChild(
                        notificationInput
                    );


                    // =================================================
                    // SELECTED CANDIDATE IDS
                    // =================================================

                    selected.forEach(
                        function (checkbox) {

                            const input =
                                document.createElement(
                                    "input"
                                );

                            input.type =
                                "hidden";

                            input.name =
                                "SelectedCandidateIDs";

                            input.value =
                                checkbox.value;

                            form.appendChild(
                                input
                            );

                        }
                    );


                    // =================================================
                    // ADD FORM TO PAGE
                    // =================================================

                    document.body.appendChild(
                        form
                    );


                    // =================================================
                    // DISABLE BUTTON
                    // =================================================

                    confirmSendButton.disabled =
                        true;

                    confirmSendButton.innerHTML =
                        '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';


                    // =================================================
                    // SUBMIT
                    // =================================================

                    form.submit();

                }
            );

        }


        // =========================================================
        // LOAD BRANCHES WHEN DEPARTMENT CHANGES
        // =========================================================

        if (
            departmentDropdown &&
            branchDropdown
        ) {

            departmentDropdown.addEventListener(
                "change",
                function () {

                    const departmentId =
                        this.value;


                    // ---------------------------------------------
                    // RESET BRANCH
                    // ---------------------------------------------

                    branchDropdown.innerHTML =
                        '<option value="">All Branches</option>';


                    // ---------------------------------------------
                    // NO DEPARTMENT
                    // ---------------------------------------------

                    if (!departmentId) {

                        return;

                    }


                    // ---------------------------------------------
                    // LOADING
                    // ---------------------------------------------

                    branchDropdown.innerHTML =
                        '<option value="">Loading branches...</option>';


                    // ---------------------------------------------
                    // AJAX
                    // ---------------------------------------------

                    fetch(
                        '/TPO/GetBranchesByDepartment?departmentId='
                        + encodeURIComponent(
                            departmentId
                        )
                    )
                    .then(
                        function (response) {

                            if (!response.ok) {

                                throw new Error(
                                    "Unable to load branches."
                                );

                            }

                            return response.json();

                        }
                    )
                    .then(
                        function (branches) {

                            branchDropdown.innerHTML =
                                '<option value="">All Branches</option>';


                            if (
                                !branches ||
                                branches.length === 0
                            ) {

                                branchDropdown.innerHTML =
                                    '<option value="">No branches found</option>';

                                return;

                            }


                            branches.forEach(
                                function (branch) {

                                    const option =
                                        document.createElement(
                                            "option"
                                        );

                                    option.value =
                                        branch.id;

                                    option.textContent =
                                        branch.name;

                                    branchDropdown.appendChild(
                                        option
                                    );

                                }
                            );

                        }
                    )
                    .catch(
                        function (error) {

                            console.error(
                                "Branch loading error:",
                                error
                            );

                            branchDropdown.innerHTML =
                                '<option value="">Unable to load branches</option>';

                        }
                    );

                }
            );

        }


        // =========================================================
        // INITIAL COUNT
        // =========================================================

        updateSelectedCount();

    });


    document.addEventListener("DOMContentLoaded", function () {

        const form         = document.getElementById("sendNotificationForm");
        const notif        = document.getElementById("NotificationId");
        const audience     = document.getElementById("Audience");
        const previewTitle = document.getElementById("previewTitle");
        const previewText  = document.getElementById("previewText");
        const previewBody  = document.getElementById("previewBody");
        const messageField = document.getElementById("MessageContent");
        const editBtn      = document.getElementById("editPreview");
        const infoText     = document.getElementById("infoText");
        const btnNow       = document.getElementById("btnSendNow");
        const btnSchedule  = document.getElementById("btnSchedule");

        const modal        = document.getElementById("scheduleModal");
        const popupDate    = document.getElementById("PopupDate");
        const popupTime    = document.getElementById("PopupTime");
        const scheduleErr  = document.getElementById("scheduleError");

        /* ---------- Preview ---------- */
        function updatePreview() {
            const opt = notif.options[notif.selectedIndex];

            if (opt && opt.value) {
                previewTitle.textContent = opt.dataset.title || opt.text;
                previewText.textContent  = opt.dataset.content || "";
            } else {
                previewTitle.textContent = "Select a notification to preview";
                previewText.textContent  = "Your notification message will appear here.";
            }
            messageField.value = previewBody.innerHTML;
        }

        notif.addEventListener("change", function () {
            updatePreview();
            this.classList.remove("error");
            document.getElementById("notificationError").textContent = "";
        });

        /* ---------- Edit preview ---------- */
        editBtn.addEventListener("click", function () {
            const editing = previewBody.getAttribute("contenteditable") === "true";

            previewBody.setAttribute("contenteditable", editing ? "false" : "true");
            previewBody.classList.toggle("editing", !editing);

            this.innerHTML = editing
                ? '<i class="fas fa-pen"></i> Edit'
                : '<i class="fas fa-check"></i> Done';

            if (!editing) previewBody.focus();
            messageField.value = previewBody.innerHTML;
        });

        previewBody.addEventListener("input", function () {
            messageField.value = previewBody.innerHTML;
        });

        /* ---------- Audience count ---------- */
        function updateAudience() {
            const opt = audience.options[audience.selectedIndex];

            if (opt && opt.value) {
                infoText.textContent =
                    "This notification will be sent to " + opt.dataset.count + " " +
                    opt.text.toLowerCase() + ".";
            } else {
                infoText.textContent =
                    "Select an audience to see how many will receive this notification.";
            }
        }

        audience.addEventListener("change", function () {
            updateAudience();
            this.classList.remove("error");
            document.getElementById("audienceError").textContent = "";
        });

        /* ---------- Send Via ---------- */
        document.querySelectorAll(".via-check").forEach(function (c) {
            c.addEventListener("change", function () {
                document.getElementById("viaError").textContent = "";
            });
        });

        /* ---------- Validation ---------- */
        function validate() {
            let valid = true;

            if (!notif.value) {
                notif.classList.add("error");
                document.getElementById("notificationError").textContent = "Please select a notification.";
                valid = false;
            }

            if (!audience.value) {
                audience.classList.add("error");
                document.getElementById("audienceError").textContent = "Please select an audience.";
                valid = false;
            }

            if (!document.querySelector(".via-check:checked")) {
                document.getElementById("viaError").textContent = "Select at least one delivery method.";
                valid = false;
            }

            return valid;
        }

        /* ---------- Send Now ---------- */
        btnNow.addEventListener("click", function (e) {
            document.getElementById("ScheduleDate").value = "";
            document.getElementById("ScheduleTime").value = "";
            if (!validate()) e.preventDefault();
        });

        /* ---------- Schedule Later popup ---------- */
        function closeModal() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");
        }

        btnSchedule.addEventListener("click", function () {
            if (!validate()) return;

            // no past dates
            popupDate.min = new Date().toISOString().split("T")[0];
            scheduleErr.textContent = "";
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
        });

        document.getElementById("cancelSchedule").addEventListener("click", closeModal);

        modal.addEventListener("click", function (e) {
            if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeModal();
        });

        document.getElementById("confirmSchedule").addEventListener("click", function () {
            if (!popupDate.value || !popupTime.value) {
                popupDate.classList.toggle("error", !popupDate.value);
                popupTime.classList.toggle("error", !popupTime.value);
                scheduleErr.textContent = "Please choose a date and time.";
                return;
            }

            document.getElementById("ScheduleDate").value = popupDate.value;
            document.getElementById("ScheduleTime").value = popupTime.value;

            // submit with SendMode = Schedule
            const mode = document.createElement("input");
            mode.type  = "hidden";
            mode.name  = "SendMode";
            mode.value = "Schedule";
            form.appendChild(mode);

            messageField.value = previewBody.innerHTML;
            form.submit();
        });

        form.addEventListener("submit", function () {
            messageField.value = previewBody.innerHTML;
        });

        updatePreview();
        updateAudience();
    });
</script>
