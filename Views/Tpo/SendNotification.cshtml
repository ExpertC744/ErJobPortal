@{
    ViewData["Title"] = "Send Notification";
}

@* Font Awesome (remove if your _Layout already loads it) *@
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

      <link rel="stylesheet" href="~/css/TPOSendNotification.css" />

<div class="notification-page">

    <div class="notification-card">

        <!-- Header -->
        <div class="notification-header">
            <div class="notification-header-icon">
                <i class="fas fa-paper-plane"></i>
            </div>
            <div>
                <h1>Send Notification</h1>
                <p>Send a notification to selected students, TPO team or all users.</p>
            </div>
        </div>

        <form method="post" id="sendNotificationForm" novalidate>

            @Html.AntiForgeryToken()

            <!-- Select Notification + Create New -->
            <div class="form-group">
                <label for="NotificationId">Select Notification <span>*</span></label>

                <div class="select-row">
                    <div class="input-box">
                        <i class="fas fa-bell"></i>
                        <select id="NotificationId" name="NotificationId" required>
                            <option value="">Select Notification</option>

                            @* Replace with your model loop. Keep data-title and data-content. *@
                            <option value="1" selected
                                    data-title="Campus Drive - Infosys"
                                    data-content="We are happy to inform you that Infosys will be conducting a campus drive on 10th Oct 2026. Interested candidates are requested to register at the earliest.">
                                Campus Drive - Infosys (06/10/2026)
                            </option>
                        </select>
                    </div>

                    <a href="@Url.Action("CreateNotification", "TPO")" class="btn-outline">
                        <i class="fas fa-plus"></i> Create New
                    </a>
                </div>

                <small class="validation-message" id="notificationError"></small>
            </div>

            <!-- Audience -->
            <div class="form-group">
                <label for="Audience">Audience <span>*</span></label>

                <div class="input-box">
                    <i class="fas fa-users"></i>
                    <select id="Audience" name="Audience" required>
                        <option value="">Select Audience</option>
                        <option value="AllStudents" data-count="245" selected>All Students</option>
                        <option value="TPOTeam" data-count="8">TPO Team</option>
                        <option value="AllUsers" data-count="260">All Users</option>
                    </select>
                </div>

                <small class="validation-message" id="audienceError"></small>
            </div>

            <!-- Send Via -->
            <div class="form-group">
                <span class="field-label">Send Via <span>*</span></span>

                <div class="via-grid">

                    <label class="checkbox-label">
                        <input type="checkbox" name="SendViaEmail" value="true" class="via-check" checked />
                        <span class="checkmark"><i class="fas fa-check"></i></span>
                        <span class="checkbox-text"><strong>Email</strong></span>
                    </label>

                    <label class="checkbox-label">
                        <input type="checkbox" name="SendViaInApp" value="true" class="via-check" checked />
                        <span class="checkmark"><i class="fas fa-check"></i></span>
                        <span class="checkbox-text"><strong>In-App Notification</strong></span>
                    </label>

                    <label class="checkbox-label">
                        <input type="checkbox" name="SendViaSms" value="true" class="via-check" />
                        <span class="checkmark"><i class="fas fa-check"></i></span>
                        <span class="checkbox-text"><strong>SMS</strong></span>
                    </label>

                </div>

                <small class="validation-message" id="viaError"></small>
            </div>

            <!-- Preview Message -->
            <div class="form-group">
                <span class="field-label">Preview Message</span>

                <div class="preview-box">

                    <div class="preview-top">
                        <h3 id="previewTitle">Select a notification to preview</h3>

                        <button type="button" class="preview-edit" id="editPreview">
                            <i class="fas fa-pen"></i> Edit
                        </button>
                    </div>

                    <div class="preview-body" id="previewBody" contenteditable="false">
                        <p>Dear Students,</p>
                        <p id="previewText">Your notification message will appear here.</p>
                        <p>Regards,<br />TPO Team</p>
                    </div>

                </div>

                <textarea id="MessageContent" name="MessageContent" hidden></textarea>
            </div>

            <!-- Info bar -->
            <div class="info-bar">
                <i class="fas fa-circle-info"></i>
                <span id="infoText">Select an audience to see how many will receive this notification.</span>
            </div>

            <!-- Hidden fields filled by the Schedule popup -->
            <input type="hidden" id="ScheduleDate" name="ScheduleDate" />
            <input type="hidden" id="ScheduleTime" name="ScheduleTime" />

            <!-- Buttons -->
            <div class="form-actions">

                <button type="submit" name="SendMode" value="Now" class="btn-save" id="btnSendNow">
                    <i class="fas fa-paper-plane"></i> Send Now
                </button>

                <button type="button" class="btn-reset" id="btnSchedule">
                    <i class="fas fa-calendar-days"></i> Schedule Later
                </button>

            </div>

        </form>
    </div>


    <!-- Schedule popup -->
    <div class="schedule-modal" id="scheduleModal" aria-hidden="true">
        <div class="schedule-dialog" role="dialog" aria-labelledby="scheduleTitle">

            <h3 id="scheduleTitle">Schedule Notification</h3>
            <p>Choose when this notification should be sent.</p>

            <div class="form-group">
                <label for="PopupDate">Date <span>*</span></label>
                <div class="input-box">
                    <i class="fas fa-calendar-days"></i>
                    <input type="date" id="PopupDate" />
                </div>
            </div>

            <div class="form-group">
                <label for="PopupTime">Time <span>*</span></label>
                <div class="input-box">
                    <i class="fas fa-clock"></i>
                    <input type="time" id="PopupTime" />
                </div>
            </div>

            <small class="validation-message" id="scheduleError"></small>

            <div class="form-actions">
                <button type="button" class="btn-reset" id="cancelSchedule">Cancel</button>
                <button type="button" class="btn-save" id="confirmSchedule">
                    <i class="fas fa-calendar-check"></i> Schedule
                </button>
            </div>

        </div>
    </div>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form         = document.getElementById("sendNotificationForm");
        const notif        = document.getElementById("NotificationId");
        const audience     = document.getElementById("Audience");
        const previewTitle = document.getElementById("previewTitle");
        const previewText  = document.getElementById("previewText");
        const previewBody  = document.getElementById("previewBody");
        const messageField = document.getElementById("MessageContent");
        const editBtn      = document.getElementById("editPreview");
        const infoText     = document.getElementById("infoText");
        const btnNow       = document.getElementById("btnSendNow");
        const btnSchedule  = document.getElementById("btnSchedule");

        const modal        = document.getElementById("scheduleModal");
        const popupDate    = document.getElementById("PopupDate");
        const popupTime    = document.getElementById("PopupTime");
        const scheduleErr  = document.getElementById("scheduleError");

        /* ---------- Preview ---------- */
        function updatePreview() {
            const opt = notif.options[notif.selectedIndex];

            if (opt && opt.value) {
                previewTitle.textContent = opt.dataset.title || opt.text;
                previewText.textContent  = opt.dataset.content || "";
            } else {
                previewTitle.textContent = "Select a notification to preview";
                previewText.textContent  = "Your notification message will appear here.";
            }
            messageField.value = previewBody.innerHTML;
        }

        notif.addEventListener("change", function () {
            updatePreview();
            this.classList.remove("error");
            document.getElementById("notificationError").textContent = "";
        });

        /* ---------- Edit preview ---------- */
        editBtn.addEventListener("click", function () {
            const editing = previewBody.getAttribute("contenteditable") === "true";

            previewBody.setAttribute("contenteditable", editing ? "false" : "true");
            previewBody.classList.toggle("editing", !editing);

            this.innerHTML = editing
                ? '<i class="fas fa-pen"></i> Edit'
                : '<i class="fas fa-check"></i> Done';

            if (!editing) previewBody.focus();
            messageField.value = previewBody.innerHTML;
        });

        previewBody.addEventListener("input", function () {
            messageField.value = previewBody.innerHTML;
        });

        /* ---------- Audience count ---------- */
        function updateAudience() {
            const opt = audience.options[audience.selectedIndex];

            if (opt && opt.value) {
                infoText.textContent =
                    "This notification will be sent to " + opt.dataset.count + " " +
                    opt.text.toLowerCase() + ".";
            } else {
                infoText.textContent =
                    "Select an audience to see how many will receive this notification.";
            }
        }

        audience.addEventListener("change", function () {
            updateAudience();
            this.classList.remove("error");
            document.getElementById("audienceError").textContent = "";
        });

        /* ---------- Send Via ---------- */
        document.querySelectorAll(".via-check").forEach(function (c) {
            c.addEventListener("change", function () {
                document.getElementById("viaError").textContent = "";
            });
        });

        /* ---------- Validation ---------- */
        function validate() {
            let valid = true;

            if (!notif.value) {
                notif.classList.add("error");
                document.getElementById("notificationError").textContent = "Please select a notification.";
                valid = false;
            }

            if (!audience.value) {
                audience.classList.add("error");
                document.getElementById("audienceError").textContent = "Please select an audience.";
                valid = false;
            }

            if (!document.querySelector(".via-check:checked")) {
                document.getElementById("viaError").textContent = "Select at least one delivery method.";
                valid = false;
            }

            return valid;
        }

        /* ---------- Send Now ---------- */
        btnNow.addEventListener("click", function (e) {
            document.getElementById("ScheduleDate").value = "";
            document.getElementById("ScheduleTime").value = "";
            if (!validate()) e.preventDefault();
        });

        /* ---------- Schedule Later popup ---------- */
        function closeModal() {
            modal.classList.remove("open");
            modal.setAttribute("aria-hidden", "true");
        }

        btnSchedule.addEventListener("click", function () {
            if (!validate()) return;

            // no past dates
            popupDate.min = new Date().toISOString().split("T")[0];
            scheduleErr.textContent = "";
            modal.classList.add("open");
            modal.setAttribute("aria-hidden", "false");
        });

        document.getElementById("cancelSchedule").addEventListener("click", closeModal);

        modal.addEventListener("click", function (e) {
            if (e.target === modal) closeModal();
        });

        document.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeModal();
        });

        document.getElementById("confirmSchedule").addEventListener("click", function () {
            if (!popupDate.value || !popupTime.value) {
                popupDate.classList.toggle("error", !popupDate.value);
                popupTime.classList.toggle("error", !popupTime.value);
                scheduleErr.textContent = "Please choose a date and time.";
                return;
            }

            document.getElementById("ScheduleDate").value = popupDate.value;
            document.getElementById("ScheduleTime").value = popupTime.value;

            // submit with SendMode = Schedule
            const mode = document.createElement("input");
            mode.type  = "hidden";
            mode.name  = "SendMode";
            mode.value = "Schedule";
            form.appendChild(mode);

            messageField.value = previewBody.innerHTML;
            form.submit();
        });

        form.addEventListener("submit", function () {
            messageField.value = previewBody.innerHTML;
        });

        updatePreview();
        updateAudience();
    });
</script>
