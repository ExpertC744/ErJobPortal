@model ErJobPortal.Models.TPORegistration

<link rel="stylesheet" href="~/css/InternshipDetails.css" asp-append-version="true" />

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "TPO Details";
    ViewData["Panel"] = "TPO";
    ViewData["UserName"] = Model.FullName;
}

<div class="container-fluid">

    <div class="master-table-container">

        <div class="mb-4">
            <h1 class="mb-2">
                TPO Details
            </h1>
            <p class="mb-0 text-muted">
                Registered TPO Information
            </p>
        </div>

        <!-- HORIZONTAL SCROLL ONLY -->
        <div class="tpo-table-scroll">

            <table class="master-data-table">

                <thead>
                    <tr>
                        <th>Sr. No</th>
                        <th>Full Name</th>
                        <th>College Email ID</th>
                        <th>Mobile No</th>
                        <th>College Name</th>
                        <th>College Code</th>
                        <th>College Address</th>
                        <th>Website</th>
                        <th>Designation</th>
                        <th>Department</th>
                        <th>Employee ID</th>
                        <th>Status</th>
                        <th>Approved</th>
                        <th>Active</th>
                        <th>Created Date</th>
                        <th>Updated Date</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>

                        <td class="master-id">
                            1
                        </td>

                        <td>
                            @Model.FullName
                        </td>

                        <td>
                            @Model.CollegeMailID
                        </td>

                        <td>
                            @Model.MobileNo
                        </td>

                        <td>
                            @Model.CollegeName
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(Model.CollegeCode))
                            {
                                @Model.CollegeCode
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>

                        <td>
                            @Model.CollegeAddress
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(Model.OrganizationWebsiteURL))
                            {
                                <a href="@Model.OrganizationWebsiteURL"
                                   target="_blank"
                                   class="text-primary fw-semibold">
                                    Visit Website
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </td>

                        <td>
                            @Model.Designation
                        </td>

                        <td>
                            @Model.DepartmentName
                        </td>

                        <td>
                            @Model.CollegeEmployeeID
                        </td>

                        <td>
                            @if (!string.IsNullOrWhiteSpace(Model.Status))
                            {
                                @Model.Status
                            }
                            else
                            {
                                <span class="text-muted">Pending</span>
                            }
                        </td>

                        <td>
                            @if (Model.IsApproved)
                            {
                                <span class="master-action-btn">
                                    Approved
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Not Approved
                                </span>
                            }
                        </td>

                        <td>
                            @if (Model.IsActive)
                            {
                                <span class="master-action-btn">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="text-muted">
                                    Inactive
                                </span>
                            }
                        </td>

                        <td>
                            @(Model.CreatedDate?.ToString("dd-MM-yyyy hh:mm tt") ?? "N/A")
                        </td>

                        <td>
                            @(Model.UpdatedDate?.ToString("dd-MM-yyyy hh:mm tt") ?? "N/A")
                        </td>

                    </tr>
                </tbody>

            </table>

        </div>

    </div>

</div>

<style>
    /* Horizontal scrolling only */
    .tpo-table-scroll {
        width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        border: 1px solid #e5e5e5;
        border-radius: 4px;
    }

        /* Force table to be wider than screen */
        .tpo-table-scroll .master-data-table {
            width: 100%;
            min-width: 1600px;
            margin-bottom: 0;
        }

            .tpo-table-scroll .master-data-table th,
            .tpo-table-scroll .master-data-table td {
                white-space: nowrap;
            }
</style>

