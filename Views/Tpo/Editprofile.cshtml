@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "Edit TPO Profile";
    ViewData["Panel"] = "TPO";
    ViewData["UserName"] = "TPO";

    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link rel="stylesheet"
      href="~/css/TPOEditProfile.css"
      asp-append-version="true" />


<div class="tpo-edit-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="tpo-page-header">

        <div>
            <h1>
                Edit Profile
            </h1>

            <p>
                Update your Training & Placement Officer profile information
            </p>
        </div>

        <div class="tpo-header-icon">
            <i class="fas fa-user-tie"></i>
        </div>

    </div>


    <!-- =====================================================
         SUCCESS MESSAGE
    ====================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="success-message">

            <i class="fas fa-check-circle"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }


    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="error-message">

            <strong>
                <i class="fas fa-exclamation-circle"></i>
                Error
            </strong>

            <div>
                @TempData["Error"]
            </div>

        </div>
    }


    <!-- =====================================================
         MODEL VALIDATION
    ====================================================== -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">

            <strong>
                <i class="fas fa-exclamation-triangle"></i>
                Please correct the following errors:
            </strong>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- =====================================================
         MAIN CARD
    ====================================================== -->

    <div class="tpo-form-card">


        <!-- =================================================
             FORM
        ================================================== -->

        <form asp-controller="Account"
              asp-action="TPOEditProfile"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- =================================================
                 PERSONAL DETAILS
            ================================================== -->

            <div class="tpo-section-title">

                <div class="section-icon">
                    <i class="fas fa-user"></i>
                </div>

                <div>
                    <h2>Personal Details</h2>

                    <p>
                        Update your basic personal and contact information
                    </p>
                </div>

            </div>


            <div class="tpo-form-grid">


                <!-- FULL NAME -->

                <div class="tpo-field">

                    <label asp-for="FullName">
                        Full Name
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-user"></i>

                        <input asp-for="FullName"
                               class="form-control"
                               type="text"
                               placeholder="Enter full name"
                               autocomplete="name" />

                    </div>

                    <span asp-validation-for="FullName"
                          class="validation-message">
                    </span>

                </div>


                <!-- MOBILE -->

                <div class="tpo-field">

                    <label asp-for="MobileNo">
                        Mobile Number
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-phone"></i>

                        <input asp-for="MobileNo"
                               class="form-control"
                               type="tel"
                               maxlength="10"
                               placeholder="Enter mobile number"
                               autocomplete="tel" />

                    </div>

                    <span asp-validation-for="MobileNo"
                          class="validation-message">
                    </span>

                </div>


                <!-- COLLEGE EMAIL -->

                <div class="tpo-field">

                    <label asp-for="CollegeMailID">
                        College Mail ID
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-envelope"></i>

                        <input asp-for="CollegeMailID"
                               class="form-control"
                               type="email"
                               placeholder="Enter official college email"
                               autocomplete="email" />

                    </div>

                    <span asp-validation-for="CollegeMailID"
                          class="validation-message">
                    </span>

                </div>


                <!-- EMPLOYEE ID -->

                <div class="tpo-field">

                    <label asp-for="CollegeEmployeeID">
                        College Employee ID
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-id-card"></i>

                        <input asp-for="CollegeEmployeeID"
                               class="form-control"
                               type="text"
                               placeholder="Enter employee ID"
                               autocomplete="off" />

                    </div>

                    <span asp-validation-for="CollegeEmployeeID"
                          class="validation-message">
                    </span>

                </div>


            </div>


            <!-- =================================================
                 COLLEGE / ORGANIZATION DETAILS
            ================================================== -->

            <div class="tpo-section-title section-spacing">

                <div class="section-icon">
                    <i class="fas fa-building-columns"></i>
                </div>

                <div>
                    <h2>College / Organization Details</h2>

                    <p>
                        Update your institution information
                    </p>
                </div>

            </div>


            <div class="tpo-form-grid">


                <!-- COLLEGE NAME -->

               <!-- COLLEGE NAME DROPDOWN -->
<div class="tpo-field">
    <label asp-for="CollegeName">College Name</label>

    <div class="input-wrapper">
        <i class="fas fa-building"></i>

        <select asp-for="CollegeName"
                id="CollegeName"
                class="form-control">
            <option value="">-- Select College Name --</option>
        </select>
    </div>

    <span asp-validation-for="CollegeName"
          class="validation-message"></span>
</div>


                <!-- COLLEGE CODE -->

               <!-- COLLEGE CODE DROPDOWN -->
                <div class="tpo-field">
    <label asp-for="CollegeCode">College Code</label>

    <div class="input-wrapper">
        <i class="fas fa-hashtag"></i>

        <select asp-for="CollegeCode"
                id="CollegeCode"
                class="form-control">
            <option value="">-- Select College Code --</option>
        </select>
    </div>

    <span asp-validation-for="CollegeCode"
          class="validation-message"></span>
</div>


                <!-- COLLEGE ADDRESS -->

                <div class="tpo-field field-full">

                    <label asp-for="CollegeAddress">
                        College Address
                    </label>

                    <div class="input-wrapper textarea-wrapper">

                        <i class="fas fa-map-marker-alt"></i>

                        <textarea asp-for="CollegeAddress"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Enter complete college address"></textarea>

                    </div>

                    <span asp-validation-for="CollegeAddress"
                          class="validation-message">
                    </span>

                </div>


                <!-- WEBSITE -->

                <div class="tpo-field field-full">

                    <label asp-for="OrganizationWebsiteURL">
                        College / Organization Website URL
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-globe"></i>

                        <input asp-for="OrganizationWebsiteURL"
                               class="form-control"
                               type="url"
                               placeholder="https://www.examplecollege.ac.in"
                               autocomplete="url" />

                    </div>

                    <span asp-validation-for="OrganizationWebsiteURL"
                          class="validation-message">
                    </span>

                </div>


            </div>


            <!-- =================================================
                 PROFESSIONAL DETAILS
            ================================================== -->

            <div class="tpo-section-title section-spacing">

                <div class="section-icon">
                    <i class="fas fa-briefcase"></i>
                </div>

                <div>
                    <h2>Professional Details</h2>

                    <p>
                        Update your professional designation and department
                    </p>
                </div>

            </div>


            <div class="tpo-form-grid">


                <!-- DESIGNATION -->

                <div class="tpo-field">

                    <label asp-for="Designation">
                        Designation
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-user-tie"></i>

                        <input asp-for="Designation"
                               class="form-control"
                               type="text"
                               placeholder="e.g. Training & Placement Officer" />

                    </div>

                    <span asp-validation-for="Designation"
                          class="validation-message">
                    </span>

                </div>


                <!-- DEPARTMENT -->

                <div class="tpo-field">

                    <label asp-for="DepartmentName">
                        Department Name
                    </label>

                    <div class="input-wrapper">

                        <i class="fas fa-sitemap"></i>

                        <input asp-for="DepartmentName"
                               class="form-control"
                               type="text"
                               placeholder="e.g. Training & Placement" />

                    </div>

                    <span asp-validation-for="DepartmentName"
                          class="validation-message">
                    </span>

                </div>


            </div>


            <!-- =================================================
                 VERIFICATION DOCUMENTS
            ================================================== -->

            <div class="tpo-section-title section-spacing">

                <div class="section-icon">
                    <i class="fas fa-file-shield"></i>
                </div>

                <div>
                    <h2>Verification Documents</h2>

                    <p>
                        Upload supporting documents for your TPO profile
                    </p>
                </div>

            </div>


            <div class="tpo-form-grid">


                <!-- SUPPORTING DOCUMENT 1 -->

                <div class="tpo-field">

                    <label asp-for="SupportingDocument1File">

                        Supporting Document 1

                        <small>
                            (ID Card / Appointment Letter)
                        </small>

                    </label>

                    <div class="file-wrapper">

                        <i class="fas fa-file-upload"></i>

                        <input asp-for="SupportingDocument1File"
                               type="file"
                               accept=".pdf,.jpg,.jpeg,.png"
                               class="file-input" />

                    </div>

                    <div class="field-note">
                        PDF, JPG, JPEG or PNG
                    </div>

                    <span asp-validation-for="SupportingDocument1File"
                          class="validation-message">
                    </span>

                </div>


                <!-- SUPPORTING DOCUMENT 2 -->

                <div class="tpo-field">

                    <label asp-for="SupportingDocument2File">

                        Supporting Document 2

                        <small>
                            (Authorization / Other Proof)
                        </small>

                    </label>

                    <div class="file-wrapper">

                        <i class="fas fa-file-upload"></i>

                        <input asp-for="SupportingDocument2File"
                               type="file"
                               accept=".pdf,.jpg,.jpeg,.png"
                               class="file-input" />

                    </div>

                    <div class="field-note">
                        PDF, JPG, JPEG or PNG
                    </div>

                    <span asp-validation-for="SupportingDocument2File"
                          class="validation-message">
                    </span>

                </div>


                <!-- PROFILE PHOTO -->

                <div class="tpo-field field-full">

                    <label asp-for="ProfilePhotoFile">
                        Profile Photo
                    </label>

                    <div class="file-wrapper profile-file">

                        <i class="fas fa-camera"></i>

                        <input asp-for="ProfilePhotoFile"
                               type="file"
                               accept=".jpg,.jpeg,.png"
                               class="file-input" />

                    </div>

                    <div class="field-note">
                        JPG, JPEG or PNG
                    </div>

                    <span asp-validation-for="ProfilePhotoFile"
                          class="validation-message">
                    </span>

                </div>


            </div>


            <!-- =================================================
                 FORM FOOTER
            ================================================== -->

            <div class="tpo-form-footer">

                <a asp-controller="Account"
                   asp-action="TPOProfile"
                   class="cancel-btn">

                    <i class="fas fa-times"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="save-btn">

                    <i class="fas fa-save"></i>

                    Save Changes

                </button>

            </div>


        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================================
               MOBILE NUMBER
            ====================================================== */

            const mobileInput =
                document.getElementById("MobileNo");

            if (mobileInput) {

                mobileInput.addEventListener("input", function () {

                    this.value =
                        this.value.replace(/\D/g, "");

                    if (this.value.length > 10) {

                        this.value =
                            this.value.substring(0, 10);

                    }

                });

            }


            /* =====================================================
               REMOVE LEADING SPACES
            ====================================================== */

            const textInputs =
                document.querySelectorAll(
                    'input[type="text"], input[type="email"], textarea'
                );

            textInputs.forEach(function (input) {

                input.addEventListener("input", function () {

                    this.value =
                        this.value.replace(/^\s+/, "");

                });

                input.addEventListener("blur", function () {

                    this.value =
                        this.value.trim();

                });

            });

        });

    </script>

    <script>
    $(document).ready(function () {

        const collegeNameSelect = $('#CollegeName');
        const collegeCodeSelect = $('#CollegeCode');

        // Existing values loaded from the TPO profile.
        const savedCollegeId = '@Model.CollegeName';
        const savedCollegeCode = '@Model.CollegeCode';

        function getArrayResponse(data) {
            if (Array.isArray(data)) return data;
            if (data && Array.isArray(data.data)) return data.data;
            return [];
        }

        function getProperty(object, names) {
            for (const name of names) {
                if (object && object[name] !== undefined &&
                    object[name] !== null) {
                    return object[name];
                }
            }
            return '';
        }

        function resetDropdown(dropdown, placeholder) {
            dropdown.empty().append(
                $('<option>', { value: '', text: placeholder })
            );
        }

        function loadCollegeCodes(collegeId, selectedCode) {

            resetDropdown(
                collegeCodeSelect,
                '-- Select College Code --'
            );

            if (!collegeId) return;

            $.ajax({
                url: '@Url.Action("GetCollegeCodes", "Account")',
                type: 'GET',
                dataType: 'json',
                data: { collegeId: collegeId },

                success: function (response) {
                    const codes = getArrayResponse(response);

                    $.each(codes, function (_, item) {
                        const code = getProperty(item, [
                            'nCode',
                            'ncode',
                            'collegeCode',
                            'CollegeCode',
                            'code'
                        ]);

                        if (code === '') return;

                        collegeCodeSelect.append(
                            $('<option>', {
                                value: String(code),
                                text: String(code)
                            })
                        );
                    });

                    // Restore the existing college code.
                    if (selectedCode) {
                        collegeCodeSelect.val(String(selectedCode));
                    }
                },

                error: function (xhr) {
                    console.error(
                        'Failed to load college codes:',
                        xhr.responseText
                    );
                }
            });
        }

        function loadColleges() {

            resetDropdown(
                collegeNameSelect,
                '-- Select College Name --'
            );

            $.ajax({
                url: '@Url.Action("GetColleges", "Account")',
                type: 'GET',
                dataType: 'json',
                cache: false,

                success: function (response) {
                    const colleges = getArrayResponse(response);

                    $.each(colleges, function (_, college) {
                        const id = getProperty(college, [
                            'nID', 'nId', 'id',
                            'collegeId', 'CollegeID'
                        ]);

                        const name = getProperty(college, [
                            'sCollegeName',
                            'collegeName',
                            'CollegeName'
                        ]);

                        if (id === '' || name === '') return;

                        collegeNameSelect.append(
                            $('<option>', {
                                value: String(id),
                                text: String(name)
                            })
                        );
                    });

                    // Select the TPO's existing college.
                    if (savedCollegeId) {
                        collegeNameSelect.val(String(savedCollegeId));
                    }

                    // Load codes for the selected college.
                    loadCollegeCodes(
                        collegeNameSelect.val(),
                        savedCollegeCode
                    );
                },


                error: function (xhr) {
                    console.error(
                        'Failed to load colleges:',
                        xhr.responseText
                    );
                }
            });
        }

        // Reload college codes whenever the college changes.
        collegeNameSelect.on('change', function () {
            loadCollegeCodes($(this).val(), '');
        });

        // Initial load.
        loadColleges();
    });
</script>

}