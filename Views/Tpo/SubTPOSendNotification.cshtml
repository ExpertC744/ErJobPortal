
@using ErJobPortal.Models
@using Microsoft.AspNetCore.Http
@model TPOSendNotificationM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Sub-TPO Send Notification";
    ViewData["Panel"] = "TPO";
    ViewData["UserName"] = Context.Session.GetString("TPOName") ?? "Sub-TPO";

    var notifications =
        ViewBag.Notifications as List<TPONotificationListM>
        ?? new List<TPONotificationListM>();

    var departments =
        ViewBag.Departments as List<DepartmentM>
        ?? new List<DepartmentM>();

    var branches =
        ViewBag.Branches as List<BranchM>
        ?? new List<BranchM>();

    int? selectedDepartment = ViewBag.DepartmentId as int?;
    int? selectedBranch = ViewBag.BranchId as int?;

    string searchText = ViewBag.SearchText?.ToString() ?? "";
    string collegeName = ViewBag.CollegeName?.ToString() ?? "";
    string collegeCode = ViewBag.CollegeCode?.ToString() ?? "";

    int traineeCount = ViewBag.TraineeCount != null
        ? Convert.ToInt32(ViewBag.TraineeCount)
        : (Model.Students?.Count ?? 0);
}

<style>
    .send-notification-wrapper {
        padding: 20px 0 40px;
    }

    .notification-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        box-shadow: 0 8px 30px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .notification-card-header {
        padding: 22px 25px;
        border-bottom: 1px solid #e5e7eb;
    }

    .notification-card-header h4 {
        margin: 0;
        font-weight: 700;
        color: #1f2937;
    }

    .notification-card-header p {
        margin: 5px 0 0;
        color: #6b7280;
        font-size: 14px;
    }

    .form-section,
    .student-section,
    .preview-section {
        padding: 25px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #374151;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        min-height: 44px;
        border-radius: 8px;
        border: 1px solid #d1d5db;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99,102,241,.12);
    }

    .notification-select-row {
        display: flex;
        align-items: flex-end;
        gap: 10px;
    }

    .notification-select-wrapper {
        flex: 1;
    }

    .create-new-btn,
    .filter-btn {
        min-height: 44px;
        border-radius: 8px;
        white-space: nowrap;
    }

    .college-info-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 13px 16px;
        margin-bottom: 20px;
    }

    .college-info-label {
        font-size: 12px;
        color: #64748b;
        margin-bottom: 2px;
    }

    .college-info-value {
        font-size: 15px;
        font-weight: 600;
        color: #1e293b;
        overflow-wrap: anywhere;
    }

    .student-section,
    .preview-section {
        border-top: 1px solid #e5e7eb;
    }

    .student-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }

    .student-section-title {
        font-size: 18px;
        font-weight: 700;
        color: #1f2937;
        margin: 0;
    }

    .student-count {
        background: #eef2ff;
        color: #4338ca;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .student-table-wrapper {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow-x: auto;
    }

    .student-table {
        margin: 0;
        min-width: 900px;
    }

    .student-table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: 13px;
        font-weight: 700;
        padding: 13px 12px;
        white-space: nowrap;
        border-bottom: 1px solid #e5e7eb;
    }

    .student-table tbody td {
        padding: 13px 12px;
        vertical-align: middle;
        font-size: 14px;
        color: #374151;
    }

    .student-table tbody tr:hover {
        background: #f8fafc;
    }

    .student-name {
        font-weight: 600;
        color: #1f2937;
    }

    .student-email {
        color: #64748b;
        font-size: 13px;
    }

    .student-checkbox,
    #selectAllStudents {
        width: 17px;
        height: 17px;
        cursor: pointer;
    }

    .empty-student {
        padding: 45px !important;
        text-align: center;
        color: #94a3b8;
    }

    .preview-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 20px;
    }

    .preview-title {
        font-size: 17px;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 12px;
    }

    .preview-content {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 16px;
        min-height: 100px;
        color: #374151;
        overflow-wrap: anywhere;
    }

    .attachment-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 7px;
        background: #f1f5f9;
        color: #475569;
        font-size: 13px;
        margin: 3px;
    }

    .action-section {
        border-top: 1px solid #e5e7eb;
        padding: 20px 25px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: #fafafa;
    }

    .send-btn {
        min-width: 150px;
        min-height: 44px;
        border-radius: 8px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .form-section,
        .student-section,
        .preview-section {
            padding: 18px;
        }

        .notification-card-header {
            padding: 18px;
        }

        .notification-select-row {
            flex-direction: column;
            align-items: stretch;
        }

        .create-new-btn {
            width: 100%;
        }

        .action-section {
            padding: 18px;
            flex-direction: column;
            align-items: stretch;
        }

        .send-btn {
            width: 100%;
        }
    }
</style>

<div class="container-fluid send-notification-wrapper">

    <div class="notification-card">

        @Html.AntiForgeryToken()

        <!-- HEADER -->
        <div class="notification-card-header">
            <h4>
                <i class="fas fa-paper-plane me-2"></i>
                Sub-TPO Send Notification
            </h4>

            <p>
                Select an approved notification and choose candidates
                from your college.
            </p>
        </div>

        <!-- STATUS MESSAGES -->
        <div class="px-4 pt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">
                    @TempData["Info"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["Error"]
                </div>
            }
        </div>

        <!-- FILTER AND NOTIFICATION SECTION -->
        <div class="form-section">

            <form method="get"
                  asp-controller="TPO"
                  asp-action="SubTPOSendNotification">

                <div class="mb-4">
                    <label for="notificationId" class="form-label-custom">
                        Select Approved Notification
                        <span class="text-danger">*</span>
                    </label>

                    <div class="notification-select-row">
                        <div class="notification-select-wrapper">
                            <select name="notificationId"
                                    id="notificationId"
                                    class="form-select">

                                <option value="">-- Select Notification --</option>

                                @foreach (var notification in notifications)
                                {
                                    <option value="@notification.NotificationID"
                                            selected="@(Model.NotificationID == notification.NotificationID)">
                                        @notification.Title
                                        @if (!string.IsNullOrWhiteSpace(notification.Type))
                                        {
                                            @: (@notification.Type)
                                        }
                                    </option>
                                }
                            </select>
                        </div>

                        <a asp-controller="TPO"
                           asp-action="CreateNotification"
                           class="btn btn-outline-primary create-new-btn">
                            <i class="fas fa-plus me-1"></i>
                            Create New
                        </a>
                    </div>

                    <small class="text-muted">
                        Only notifications available to this Sub-TPO should
                        appear in this list.
                    </small>
                </div>

                <!-- COLLEGE INFORMATION -->
                <div class="college-info-box">
                    <div class="row">
                        <div class="col-md-6 mb-2 mb-md-0">
                            <div class="college-info-label">College</div>
                            <div class="college-info-value">
                                @(string.IsNullOrWhiteSpace(collegeName)
                                    ? "College not available"
                                    : collegeName)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="college-info-label">College Code</div>
                            <div class="college-info-value">
                                @(string.IsNullOrWhiteSpace(collegeCode)
                                    ? "-"
                                    : collegeCode)
                            </div>
                        </div>
                    </div>
                </div>

                <!-- FILTERS -->
                <div class="row g-3">

                    <div class="col-lg-4 col-md-6">
                        <label for="departmentId" class="form-label-custom">
                            Department
                        </label>

                        <select id="departmentId"
                                name="departmentId"
                                class="form-select">
                            <option value="">All Departments</option>

                            @foreach (var department in departments)
                            {
                                <option value="@department.nID"
                                        selected="@(selectedDepartment == department.nID)">
                                    @department.sDepartment
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-6">
                        <label for="branchId" class="form-label-custom">
                            Branch
                        </label>

                        <select id="branchId"
                                name="branchId"
                                class="form-select">
                            <option value="">All Branches</option>

                            @foreach (var branch in branches)
                            {
                                <option value="@branch.nID"
                                        selected="@(selectedBranch == branch.nID)">
                                    @branch.sBranch
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <label for="searchText" class="form-label-custom">
                            Search Candidates
                        </label>

                        <input type="text"
                               name="searchText"
                               id="searchText"
                               class="form-control"
                               value="@searchText"
                               placeholder="Name / Email / Mobile / DOB" />
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary filter-btn">
                        <i class="fas fa-search me-1"></i>
                        Search Candidates
                    </button>

                    <a asp-controller="TPO"
                       asp-action="SubTPOSendNotification"
                       class="btn btn-outline-secondary filter-btn ms-1">
                        <i class="fas fa-sync-alt me-1"></i>
                        Reset
                    </a>
                </div>
            </form>
        </div>

        <!-- CANDIDATE TABLE: VISIBLE EVEN WITHOUT NOTIFICATION SELECTION -->
        <div class="student-section">

            <div class="student-section-header">
                <div>
                    <h5 class="student-section-title">Select Candidates</h5>
                    <div class="text-muted small mt-1">
                        Candidates are filtered to your college by the server.
                    </div>
                </div>

                <div class="student-count">
                    Total Candidates:
                    <span id="totalStudentCount">@traineeCount</span>
                    &nbsp; | &nbsp;
                    Selected:
                    <span id="selectedStudentCount">0</span>
                </div>
            </div>

            <div class="mb-3">
                <div class="form-check">
                    <input type="checkbox"
                           class="form-check-input"
                           id="selectAllStudents" />

                    <label class="form-check-label fw-semibold"
                           for="selectAllStudents">
                        Select All Candidates
                    </label>
                </div>
            </div>

            <div class="student-table-wrapper">
                <table class="table student-table">
                    <thead>
                        <tr>
                            <th style="width:50px;">#</th>
                            <th style="width:50px;">
                                <i class="fas fa-check"></i>
                            </th>
                            <th>Candidate</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Branch</th>
                            <th>Current Year</th>
                            <th>Passout Year</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Students != null && Model.Students.Any())
                        {
                            int rowNumber = 1;

                            foreach (var student in Model.Students)
                            {
                                <tr>
                                    <td>@rowNumber</td>

                                    <td>
                                        <input type="checkbox"
                                               class="form-check-input student-checkbox"
                                               value="@student.nID" />
                                    </td>

                                    <td>
                                        <div class="student-name">
                                            @student.PrefixName @student.FullName
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(student.CandidateCode))
                                        {
                                            <div class="text-muted small">
                                                @student.CandidateCode
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        <div class="student-email">
                                            @(string.IsNullOrWhiteSpace(student.sEmail)
                                                ? "-"
                                                : student.sEmail)
                                        </div>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(student.sMobile)
                                            ? "-"
                                            : student.sMobile)
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(student.BranchName)
                                            ? "-"
                                            : student.BranchName)
                                    </td>

                                    <td>
                                        @(student.nCurrentYear?.ToString() ?? "-")
                                    </td>

                                    <td>
                                        @(student.nPassoutYear?.ToString() ?? "-")
                                    </td>
                                </tr>

                                rowNumber++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="empty-student">
                                    <i class="fas fa-users fa-2x mb-3"></i>
                                    <div class="fw-semibold">No candidates found</div>
                                    <div class="small mt-1">
                                        Try changing the filters or search criteria.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- NOTIFICATION PREVIEW -->
        <div class="preview-section">
            <div class="preview-box">
                <div class="preview-title">
                    <i class="fas fa-eye me-2"></i>
                    Notification Preview
                </div>

                @if (Model.NotificationID > 0)
                {
                    <div class="mb-3">
                        <div class="fw-semibold text-dark">@Model.Title</div>

                        @if (!string.IsNullOrWhiteSpace(Model.Type))
                        {
                            <span class="badge bg-primary mt-2">@Model.Type</span>
                        }
                    </div>

                    <div class="mb-3">
                        <strong>Audience:</strong>
                        @(string.IsNullOrWhiteSpace(Model.Audience)
                            ? "-"
                            : Model.Audience)
                    </div>

                    <div class="preview-content">
                        @Html.Raw(Model.Content)
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Attachment1Path) ||
                         !string.IsNullOrWhiteSpace(Model.Attachment2Path))
                    {
                        <div class="mt-3">
                            <div class="fw-semibold mb-2">Attachments</div>

                            @if (!string.IsNullOrWhiteSpace(Model.Attachment1Path))
                            {
                                <a class="attachment-item"
                                   href="@Model.Attachment1Path"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    <i class="fas fa-paperclip"></i>
                                    @(string.IsNullOrWhiteSpace(Model.Attachment1OriginalName)
                                        ? "Attachment 1"
                                        : Model.Attachment1OriginalName)
                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(Model.Attachment2Path))
                            {
                                <a class="attachment-item"
                                   href="@Model.Attachment2Path"
                                   target="_blank"
                                   rel="noopener noreferrer">
                                    <i class="fas fa-paperclip"></i>
                                    @(string.IsNullOrWhiteSpace(Model.Attachment2OriginalName)
                                        ? "Attachment 2"
                                        : Model.Attachment2OriginalName)
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-muted">
                        <i class="fas fa-info-circle me-2"></i>
                        Select an approved notification above to preview its
                        content. The candidate list is available without selecting one.
                    </div>
                }
            </div>
        </div>

        <!-- SEND ACTION -->
        <div class="action-section">
            <div class="me-auto text-muted small" id="sendMessage">
                Select a notification and at least one candidate to enable sending.
            </div>

            <button type="button"
                    id="sendNowButton"
                    class="btn btn-primary send-btn"
                    disabled>
                <i class="fas fa-paper-plane me-2"></i>
                Send Now
            </button>
        </div>
    </div>
</div>

<!-- SEND CONFIRMATION MODAL -->
<div class="modal fade"
     id="sendNotificationModal"
     tabindex="-1"
     aria-labelledby="sendNotificationModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="sendNotificationModalLabel">
                    <i class="fas fa-paper-plane me-2"></i>
                    Confirm Send
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <p>Send this approved notification to the selected candidates?</p>

                <div class="alert alert-info mb-0">
                    <strong id="modalSelectedCount">0</strong>
                    candidate(s) selected.
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="confirmSendButton"
                        class="btn btn-primary">
                    <i class="fas fa-paper-plane me-1"></i>
                    Confirm Send
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const selectAll = document.getElementById("selectAllStudents");
    const sendButton = document.getElementById("sendNowButton");
    const confirmButton = document.getElementById("confirmSendButton");
    const notificationDropdown = document.getElementById("notificationId");

    function getSelectedCandidates() {
        return Array.from(
            document.querySelectorAll(".student-checkbox:checked")
        );
    }

    function updateSelection() {
    const all = Array.from(
        document.querySelectorAll(".student-checkbox")
    );

    const selected = getSelectedCandidates();

    document.getElementById("selectedStudentCount").textContent =
        selected.length;

    // Check Select All only when every candidate is selected.
    // If only one candidate is selected out of several, it stays unchecked.
    selectAll.checked =
        all.length > 0 && selected.length === all.length;

    // Show partial selection using the indeterminate state.
    selectAll.indeterminate =
        selected.length > 0 && selected.length < all.length;

    const notificationSelected = !!notificationDropdown.value;

    sendButton.disabled =
        selected.length === 0 || !notificationSelected;

    const message = document.getElementById("sendMessage");

    if (!notificationSelected) {
        message.textContent =
            "Select an approved notification and candidates to enable sending.";
    } else if (selected.length === 0) {
        message.textContent =
            "Select at least one candidate to enable sending.";
    } else {
        message.textContent =
            selected.length + " candidate(s) selected.";
    }
}

    selectAll.addEventListener("change", function () {
        document.querySelectorAll(".student-checkbox").forEach(function (cb) {
            cb.checked = selectAll.checked;
        });

        updateSelection();
    });

    document.querySelectorAll(".student-checkbox").forEach(function (cb) {
        cb.addEventListener("change", updateSelection);
    });

    notificationDropdown.addEventListener("change", updateSelection);

    sendButton.addEventListener("click", function () {
        if (!notificationDropdown.value) {
            alert("Please select an approved notification first.");
            return;
        }

        const selected = getSelectedCandidates();

        if (selected.length === 0) {
            alert("Please select at least one candidate.");
            return;
        }

        document.getElementById("modalSelectedCount").textContent =
            selected.length;

        bootstrap.Modal.getOrCreateInstance(
            document.getElementById("sendNotificationModal")
        ).show();
    });

    confirmButton.addEventListener("click", function () {
        const selected = getSelectedCandidates();
        const notificationId = notificationDropdown.value;

        if (!notificationId || selected.length === 0) {
            alert("Select an approved notification and at least one candidate.");
            return;
        }

        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]'
        );

        if (!token) {
            alert("Security token not found. Refresh the page and try again.");
            return;
        }

        const form = document.createElement("form");
        form.method = "POST";
        form.action = '@Url.Action("SubTPOSendNotification", "TPO")';

        const tokenInput = document.createElement("input");
        tokenInput.type = "hidden";
        tokenInput.name = "__RequestVerificationToken";
        tokenInput.value = token.value;
        form.appendChild(tokenInput);

        const notificationInput = document.createElement("input");
        notificationInput.type = "hidden";
        notificationInput.name = "NotificationID";
        notificationInput.value = notificationId;
        form.appendChild(notificationInput);

        selected.forEach(function (checkbox) {
            const input = document.createElement("input");
            input.type = "hidden";
            input.name = "SelectedCandidateIDs";
            input.value = checkbox.value;
            form.appendChild(input);
        });

        document.body.appendChild(form);
        confirmButton.disabled = true;
        confirmButton.innerHTML =
            '<i class="fas fa-spinner fa-spin me-2"></i>Sending...';
        form.submit();
    });

    // Load branches when the department changes.
    // This endpoint must return { id, name } objects.
    const departmentDropdown = document.getElementById("departmentId");
    const branchDropdown = document.getElementById("branchId");

    departmentDropdown.addEventListener("change", function () {
        const departmentId = this.value;
        branchDropdown.innerHTML = '<option value="">All Branches</option>';

        if (!departmentId) {
            return;
        }

        branchDropdown.innerHTML =
            '<option value="">Loading branches...</option>';

        fetch('@Url.Action("GetBranchesByDepartment", "TPO")' +
              '?departmentId=' + encodeURIComponent(departmentId))
            .then(function (response) {
                if (!response.ok) {
                    throw new Error("Unable to load branches.");
                }
                return response.json();
            })
            .then(function (items) {
                branchDropdown.innerHTML =
                    '<option value="">All Branches</option>';

                items.forEach(function (item) {
                    const option = document.createElement("option");
                    option.value = item.id;
                    option.textContent = item.name;
                    branchDropdown.appendChild(option);
                });
            })
            .catch(function (error) {
                console.error(error);
                branchDropdown.innerHTML =
                    '<option value="">Unable to load branches</option>';
            });
    });

    updateSelection();
});
</script>
