@using ErJobPortal.Models
@using Microsoft.AspNetCore.Http

@model List<TPOViewNotificationM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "View Notifications / Events";
    ViewData["Panel"] = "TPO";

    string userName = Context.Session.GetString("TPOName") ?? "TPO";

    string selectedType = ViewBag.SelectedType?.ToString() ?? "All";
    string selectedAudience = ViewBag.SelectedAudience?.ToString() ?? "All";
    string fromDate = ViewBag.FromDate?.ToString() ?? "";
    string toDate = ViewBag.ToDate?.ToString() ?? "";

    int totalNotifications = ViewBag.TotalNotifications ?? 0;
}

<link rel="stylesheet"
      href="~/css/TPOViewNotificationEvent.css"
      asp-append-version="true" />

<div class="notification-list-page">

    <!-- PAGE HEADER -->
    <header class="notification-page-header">
        <div class="page-header-left">
            <div class="page-header-icon">
                <i class="fas fa-bell"></i>
            </div>

            <div class="page-header-content">
                <h1>Notifications / Events</h1>
                <p>View and manage notifications and events created by you.</p>
            </div>
        </div>

        <a href="@Url.Action("CreateNotification", "TPO")"
           class="create-btn">
            <i class="fas fa-plus"></i>
            <span>Create Notification</span>
        </a>
    </header>

    <!-- FILTER CARD -->
    <section class="filter-card">
        <div class="filter-card-heading">
            <div class="filter-heading-icon">
                <i class="fas fa-sliders-h"></i>
            </div>
            <div>
                <h2>Filter Notifications</h2>
                <p>Choose the criteria to narrow down your results.</p>
            </div>
        </div>

        <form method="get"
              action="@Url.Action("ViewNotificationEvent", "TPO")"
              class="filter-form">

            <div class="filter-group">
                <label for="notificationType">Type</label>
                <div class="filter-input-wrap">
                    <i class="fas fa-bell"></i>
                    <select id="notificationType"
                            name="type"
                            class="filter-control">
                        <option value="All"
                                selected="@(selectedType == "All")">
                            All Types
                        </option>
                        <option value="Notification"
                                selected="@(selectedType == "Notification")">
                            Notification
                        </option>
                    </select>
                </div>
            </div>

            <div class="filter-group">
                <label for="notificationAudience">Audience</label>
                <div class="filter-input-wrap">
                    <i class="fas fa-users"></i>
                    <select id="notificationAudience"
                            name="audience"
                            class="filter-control">
                        <option value="All"
                                selected="@(selectedAudience == "All")">
                            All Audiences
                        </option>
                        <option value="AllStudents"
                                selected="@(selectedAudience == "AllStudents")">
                            All Students
                        </option>
                    </select>
                </div>
            </div>

            <div class="filter-group">
                <label for="fromDate">From Date</label>
                <div class="filter-input-wrap">
                    <i class="far fa-calendar-alt"></i>
                    <input id="fromDate"
                           type="date"
                           name="fromDate"
                           value="@fromDate"
                           class="filter-control" />
                </div>
            </div>

            <div class="filter-group">
                <label for="toDate">To Date</label>
                <div class="filter-input-wrap">
                    <i class="far fa-calendar-alt"></i>
                    <input id="toDate"
                           type="date"
                           name="toDate"
                           value="@toDate"
                           class="filter-control" />
                </div>
            </div>

            <div class="filter-actions">
                <button type="submit" class="filter-btn">
                    <i class="fas fa-search"></i>
                    Search
                </button>

                <a href="@Url.Action("ViewNotificationEvent", "TPO")"
                   class="reset-filter">
                    <i class="fas fa-rotate-left"></i>
                    Reset
                </a>
            </div>
        </form>
    </section>

    <!-- NOTIFICATION LIST -->
    <section class="notification-list-card">
        <div class="notification-list-header">
            <div class="list-heading">
                <div class="list-heading-icon">
                    <i class="fas fa-list-ul"></i>
                </div>
                <div>
                    <h2>Notification / Event List</h2>
                    <p>Review delivery, readership, and status details.</p>
                </div>
            </div>

            <div class="notification-count">
                <span class="count-number">@totalNotifications</span>
                <span>record(s) found</span>
            </div>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-wrapper">
                <table class="notification-table">
                    <thead>
                        <tr>
                            <th class="serial-column">#</th>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Audience</th>
                            <th>Date &amp; Time</th>
                            <th>Total Sent</th>
                            <th>Read</th>
                            <th>Not Read</th>
                            <th>Status</th>
                            <th class="action-column">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int serialNo = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="serial-number">@serialNo</td>

                                <td>
                                    <div class="notification-title">
                                        <div class="notification-icon">
                                            <i class="fas fa-bell"></i>
                                        </div>
                                        <div class="notification-title-content">
                                            <div class="title-text">
                                                @item.Title
                                            </div>
                                            <div class="created-info">
                                                <i class="fas fa-user-edit"></i>
                                                Created by:
                                                @(string.IsNullOrWhiteSpace(item.CreatedByName)
                                                    ? userName
                                                    : item.CreatedByName)
                                            </div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @if (item.Type == "Notification")
                                    {
                                        <span class="type-badge notification-badge">
                                            <i class="fas fa-bell"></i>
                                            Notification
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="type-badge event-badge">
                                            <i class="fas fa-calendar-check"></i>
                                            @(string.IsNullOrWhiteSpace(item.Type)
                                                ? "Event"
                                                : item.Type)
                                        </span>
                                    }
                                </td>

                                <td>
                                    <span class="audience-text">
                                        <i class="fas fa-users"></i>
                                        @(item.Audience == "AllStudents"
                                            ? "All Students"
                                            : item.Audience)
                                    </span>
                                </td>

                                <td>
                                    <div class="date-time">
                                        <span class="date-text">
                                            <i class="far fa-calendar"></i>
                                            @(item.NotificationDate.HasValue
                                                ? item.NotificationDate.Value.ToString("dd MMM yyyy")
                                                : "No Date")
                                        </span>

                                        <span class="time-text">
                                            <i class="far fa-clock"></i>
                                            @(item.NotificationTime.HasValue
                                                ? DateTime.Today.Add(item.NotificationTime.Value).ToString("hh:mm tt")
                                                : "No Time")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="tracking-badge tracking-sent">
                                        <i class="fas fa-paper-plane"></i>
                                        @item.TotalSent
                                    </span>
                                </td>

                                <td>
                                    <span class="tracking-badge tracking-read">
                                        <i class="fas fa-check-circle"></i>
                                        @item.TotalRead
                                    </span>
                                </td>

                                <td>
                                    <span class="tracking-badge tracking-unread">
                                        <i class="fas fa-eye-slash"></i>
                                        @item.TotalUnread
                                    </span>
                                </td>

                                <td>
                                    @if (item.Status == "Active")
                                    {
                                        <span class="status-badge status-active">
                                            <span class="status-dot"></span>
                                            Active
                                        </span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="status-badge status-completed">
                                            <span class="status-dot"></span>
                                            Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <span class="status-dot"></span>
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    <div class="action-buttons">
                                        <button type="button"
                                                class="action-btn view-btn"
                                                title="View Notification"
                                                aria-label="View Notification"
                                                onclick="viewNotification(@item.NotificationID)">
                                            <i class="fas fa-eye"></i>
                                        </button>

                                        <button type="button"
                                                class="action-btn more-btn"
                                                title="More Options"
                                                aria-label="More Options"
                                                onclick="showNotificationInfo(@item.NotificationID)">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>

                            serialNo++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-notification">
                <div class="empty-icon">
                    <i class="fas fa-bell-slash"></i>
                </div>

                <h3>No Notifications / Events Found</h3>
                <p>
                    No notification or event matches the selected filters.
                    Try changing your filters or create a new notification.
                </p>

                <a href="@Url.Action("CreateNotification", "TPO")"
                   class="create-btn empty-create-btn">
                    <i class="fas fa-plus"></i>
                    Create Notification
                </a>
            </div>
        }
    </section>
</div>

<!-- NOTIFICATION DETAILS MODAL -->
<div class="modal fade"
     id="notificationViewModal"
     tabindex="-1"
     aria-labelledby="notificationViewModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content notification-modal-content">

            <div class="modal-header notification-modal-header">
                <div class="modal-title-wrap">
                    <div class="modal-title-icon">
                        <i class="fas fa-bell"></i>
                    </div>
                    <div>
                        <h5 class="modal-title" id="notificationViewModalLabel">
                            Notification Details
                        </h5>
                        <p>View the selected notification information.</p>
                    </div>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>
            </div>

            <div class="modal-body" id="notificationDetails">
                <div class="modal-loading">
                    <i class="fas fa-spinner fa-spin"></i>
                    <span>Loading notification details...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function viewNotification(notificationId) {
        const detailsContainer =
            document.getElementById("notificationDetails");

        const modalElement =
            document.getElementById("notificationViewModal");

        if (!detailsContainer || !modalElement) {
            return;
        }

        detailsContainer.innerHTML = `
            <div class="modal-loading">
                <i class="fas fa-spinner fa-spin"></i>
                <span>Loading notification details...</span>
            </div>`;

        const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
        modal.show();

        try {
            const response = await fetch(
                '/TPO/ViewNotificationDetails/' + encodeURIComponent(notificationId)
            );

            if (!response.ok) {
                throw new Error("Unable to load notification.");
            }

            const html = await response.text();
            detailsContainer.innerHTML = html;
        }
        catch (error) {
            detailsContainer.innerHTML = `
                <div class="notification-load-error">
                    <i class="fas fa-circle-exclamation"></i>
                    <div>
                        <strong>Unable to load notification details.</strong>
                        <p>Please try again in a moment.</p>
                    </div>
                </div>`;

            console.error(error);
        }
    }

    function showNotificationInfo(notificationId) {
        viewNotification(notificationId);
    }
</script>