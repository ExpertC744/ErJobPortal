
@model ErJobPortal.Models.TPOSchedulerActivityM

@{
    ViewData["Title"] = "General Activity Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>General Activity Details</h2>
    <hr />

    <dl class="row">
        <dt class="col-sm-3">Title</dt>
        <dd class="col-sm-9">@Model.Title</dd>

        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@Model.Category</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Start Date</dt>
        <dd class="col-sm-9">@Model.StartDate.ToString("dd-MMM-yyyy")</dd>

        <dt class="col-sm-3">End Date</dt>
        <dd class="col-sm-9">@Model.EndDate.ToString("dd-MMM-yyyy")</dd>

        <dt class="col-sm-3">Start Time</dt>
        <dd class="col-sm-9">@Model.StartTime</dd>

        <dt class="col-sm-3">End Time</dt>
        <dd class="col-sm-9">@Model.EndTime</dd>

        <dt class="col-sm-3">Location</dt>
        <dd class="col-sm-9">@Model.Location</dd>

        <dt class="col-sm-3">Participants</dt>
        <dd class="col-sm-9">@Model.Participants</dd>

        <dt class="col-sm-3">Reminder</dt>
        <dd class="col-sm-9">@Model.Reminder</dd>

        <dt class="col-sm-3">Reminder Channel</dt>
        <dd class="col-sm-9">@Model.ReminderChannel</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">
            @(Model.IsCancelled ? "Cancelled" : Model.Status)
        </dd>
    </dl>

    <a asp-controller="TPO"
       asp-action="Scheduler"
       class="btn btn-secondary">
        Back to Scheduler
    </a>
</div>
