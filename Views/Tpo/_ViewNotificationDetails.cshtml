@using ErJobPortal.Models

@model TPOViewNotificationM

<div class="notification-details">

    <!-- =========================================================
         TITLE
    ========================================================== -->

    <div class="notification-detail-header">

        <div class="notification-detail-icon">
            <i class="fas fa-bell"></i>
        </div>

        <div>

            <h4 class="notification-detail-title">
                @Model.Title
            </h4>

            <div class="notification-detail-created">

                Created by:

                <strong>
                    @(string.IsNullOrWhiteSpace(Model.CreatedByName)
                        ? "TPO"
                        : Model.CreatedByName)
                </strong>

                <span class="mx-1">|</span>

                @(Model.CreatedDate.ToString("dd MMM yyyy hh:mm tt"))

            </div>

        </div>

    </div>


    <hr />


    <!-- =========================================================
         BASIC INFORMATION
    ========================================================== -->

    <div class="row g-3 mb-4">

        <!-- TYPE -->

        <div class="col-md-4">

            <div class="detail-label">
                Type
            </div>

            <div class="detail-value">

                <span class="badge bg-primary">

                    <i class="fas fa-bell me-1"></i>

                    @Model.Type

                </span>

            </div>

        </div>


        <!-- AUDIENCE -->

        <div class="col-md-4">

            <div class="detail-label">
                Audience
            </div>

            <div class="detail-value">

                @if (Model.Audience == "AllStudents")
                {
                    <span class="badge bg-secondary">

                        <i class="fas fa-users me-1"></i>

                        All Students

                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        @Model.Audience
                    </span>
                }

            </div>

        </div>


        <!-- STATUS -->

        <div class="col-md-4">

            <div class="detail-label">
                Status
            </div>

            <div class="detail-value">

                @if (Model.Status == "Active")
                {
                    <span class="badge bg-success">
                        Active
                    </span>
                }
                else if (Model.Status == "Completed")
                {
                    <span class="badge bg-dark">
                        Completed
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark">
                        Inactive
                    </span>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         DATE / TIME / EMAIL
    ========================================================== -->

    <div class="row g-3 mb-4">

        <!-- DATE -->

        <div class="col-md-4">

            <div class="detail-box">

                <div class="detail-label">

                    <i class="far fa-calendar me-1"></i>

                    Event Date

                </div>

                <div class="detail-value">

                    @if (Model.NotificationDate.HasValue)
                    {
                        @(Model.NotificationDate.Value.ToString(
                            "dd MMM yyyy"))
                    }
                    else
                    {
                        <span class="text-muted">
                            Not specified
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- TIME -->

        <div class="col-md-4">

            <div class="detail-box">

                <div class="detail-label">

                    <i class="far fa-clock me-1"></i>

                    Event Time

                </div>

                <div class="detail-value">

                    @if (Model.NotificationTime.HasValue)
                    {
                        @(DateTime.Today
                            .Add(Model.NotificationTime.Value)
                            .ToString("hh:mm tt"))
                    }
                    else
                    {
                        <span class="text-muted">
                            Not specified
                        </span>
                    }

                </div>

            </div>

        </div>


        <!-- EMAIL -->

        <div class="col-md-4">

            <div class="detail-box">

                <div class="detail-label">

                    <i class="fas fa-envelope me-1"></i>

                    Email Notification

                </div>

                <div class="detail-value">

                    @if (Model.SendEmailNotification)
                    {
                        <span class="badge bg-success">

                            <i class="fas fa-check me-1"></i>

                            Enabled

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">

                            Disabled

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CONTENT
    ========================================================== -->

    <div class="mb-4">

        <div class="detail-section-title">

            <i class="fas fa-align-left me-2"></i>

            Notification Content

        </div>

        <div class="notification-content-box">

            @Html.Raw(Model.Content)

        </div>

    </div>


    <!-- =========================================================
         ATTACHMENTS
    ========================================================== -->

    @if (!string.IsNullOrWhiteSpace(Model.Attachment1Path) ||
         !string.IsNullOrWhiteSpace(Model.Attachment2Path))
    {
        <div class="mb-3">

            <div class="detail-section-title">

                <i class="fas fa-paperclip me-2"></i>

                Attachments

            </div>


            <div class="attachment-list">

                <!-- ATTACHMENT 1 -->

                @if (!string.IsNullOrWhiteSpace(
                    Model.Attachment1Path))
                {
                    <a href="@Model.Attachment1Path"
                       target="_blank"
                       class="attachment-item">

                        <i class="fas fa-file"></i>

                        <span>

                            @(Model.Attachment1OriginalName
                                ?? "Attachment 1")

                        </span>

                        <i class="fas fa-external-link-alt ms-auto"></i>

                    </a>
                }


                <!-- ATTACHMENT 2 -->

                @if (!string.IsNullOrWhiteSpace(
                    Model.Attachment2Path))
                {
                    <a href="@Model.Attachment2Path"
                       target="_blank"
                       class="attachment-item">

                        <i class="fas fa-file"></i>

                        <span>

                            @(Model.Attachment2OriginalName
                                ?? "Attachment 2")

                        </span>

                        <i class="fas fa-external-link-alt ms-auto"></i>

                    </a>
                }

            </div>

        </div>
    }


    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <div class="notification-detail-footer">

        Notification ID:

        <strong>
            #@Model.NotificationID
        </strong>

    </div>

</div>


<style>

    .notification-detail-header {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .notification-detail-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eef5ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .notification-detail-title {
        margin: 0;
        font-size: 21px;
        font-weight: 700;
        color: #1f2937;
    }

    .notification-detail-created {
        font-size: 12px;
        color: #6b7280;
        margin-top: 4px;
    }

    .detail-label {
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        margin-bottom: 6px;
    }

    .detail-value {
        font-size: 14px;
        font-weight: 600;
        color: #374151;
    }

    .detail-box {
        background: #f8fafc;
        border: 1px solid #e5e7eb;
        border-radius: 9px;
        padding: 13px;
        height: 100%;
    }

    .detail-section-title {
        font-weight: 700;
        color: #374151;
        margin-bottom: 10px;
    }

    .notification-content-box {
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        background: #f8fafc;
        padding: 16px;
        line-height: 1.7;
        min-height: 80px;
        overflow-wrap: break-word;
    }

    .notification-content-box img {
        max-width: 100%;
        height: auto;
    }

    .attachment-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .attachment-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 13px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        text-decoration: none;
        color: #374151;
        background: #fff;
    }

    .attachment-item:hover {
        background: #f8fbff;
        border-color: #b8d4ff;
        color: #0d6efd;
    }

    .attachment-item > i:first-child {
        color: #0d6efd;
    }

    .notification-detail-footer {
        border-top: 1px solid #e5e7eb;
        margin-top: 18px;
        padding-top: 12px;
        font-size: 12px;
        color: #9ca3af;
    }

</style>