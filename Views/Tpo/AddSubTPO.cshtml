@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Add Sub TPO";
    ViewData["Panel"] = "TPO";
    ViewData["UserName"] =
        Context.Session.GetString("TPOName") ?? "TPO";
}

<link rel="stylesheet"
      href="~/css/CandidateRegister.css"
      asp-append-version="true" />

<div class="candidate-register-page">

    <div class="candidate-register-card">

        <div class="register-icon">
            <i class="fa-solid fa-user-plus"></i>
        </div>

        <div class="register-heading">

            <h2>Add Sub TPO</h2>

            <p>
                Register a Sub Training & Placement Officer
            </p>

        </div>


        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["Error"]
            </div>
        }


        <form asp-controller="TPO"
              asp-action="AddSubTPO"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- =====================================================
                 PERSONAL DETAILS
            ====================================================== -->

            <div class="section-title mt-3 mb-3">

                <i class="fa-solid fa-user"></i>

                Personal Details

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        Full Name
                    </label>

                    <input type="text"
                           name="FullName"
                           class="register-input"
                           placeholder="Enter full name"
                           required />

                </div>


                <div class="register-form-group">

                    <label class="register-label">
                        Mobile Number
                    </label>

                    <input type="tel"
                           name="MobileNo"
                           class="register-input"
                           placeholder="Enter mobile number"
                           maxlength="10"
                           required />

                </div>

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        College Mail ID
                    </label>

                    <input type="email"
                           name="CollegeMailID"
                           class="register-input"
                           placeholder="Enter official college email"
                           required />

                </div>


                <div class="register-form-group">

                    <label class="register-label">
                        College Employee ID
                    </label>

                    <input type="text"
                           name="CollegeEmployeeID"
                           class="register-input"
                           placeholder="Enter employee ID"
                           required />

                </div>

            </div>


            <!-- =====================================================
                 COLLEGE DETAILS
            ====================================================== -->

            <div class="section-title mt-4 mb-3">

                <i class="fa-solid fa-building-columns"></i>

                College / Organization Details

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        College Name
                    </label>

                    <input type="text"
                           name="CollegeName"
                           class="register-input"
                           placeholder="Enter college name"
                           required />

                </div>


                <div class="register-form-group">

                    <label class="register-label">
                        College Code
                    </label>

                    <input type="text"
                           name="CollegeCode"
                           class="register-input"
                           placeholder="Enter college code"
                           required />

                </div>

            </div>


            <div class="register-form-row">

                <div class="register-form-group"
                     style="width:100%;">

                    <label class="register-label">
                        College Address
                    </label>

                    <textarea name="CollegeAddress"
                              class="register-input"
                              rows="3"
                              placeholder="Enter complete college address"
                              required></textarea>

                </div>

            </div>


            <div class="register-form-row">

                <div class="register-form-group"
                     style="width:100%;">

                    <label class="register-label">
                        College / Organization Website URL
                    </label>

                    <input type="url"
                           name="OrganizationWebsiteURL"
                           class="register-input"
                           placeholder="https://www.examplecollege.ac.in" />

                </div>

            </div>


            <!-- =====================================================
                 PROFESSIONAL DETAILS
            ====================================================== -->

            <div class="section-title mt-4 mb-3">

                <i class="fa-solid fa-briefcase"></i>

                Professional Details

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        Designation
                    </label>

                    <input type="text"
                           name="Designation"
                           class="register-input"
                           placeholder="e.g. Assistant Training & Placement Officer"
                           required />

                </div>


                <div class="register-form-group">

                    <label class="register-label">
                        Department Name
                    </label>

                    <input type="text"
                           name="DepartmentName"
                           class="register-input"
                           placeholder="e.g. Training & Placement"
                           required />

                </div>

            </div>


            <!-- =====================================================
                 DOCUMENTS
            ====================================================== -->

            <div class="section-title mt-4 mb-3">

                <i class="fa-solid fa-file-shield"></i>

                Verification Documents

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        Supporting Document 1
                        <small>
                            (ID Card / Appointment Letter)
                        </small>
                    </label>

                    <input type="file"
                           name="SupportingDocument1"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file"
                           required />

                </div>


                <div class="register-form-group">

                    <label class="register-label">
                        Supporting Document 2
                        <small>
                            (Authorization / Other Proof)
                        </small>
                    </label>

                    <input type="file"
                           name="SupportingDocument2"
                           accept=".pdf,.jpg,.jpeg,.png"
                           class="register-input register-file"
                           required />

                </div>

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        Profile Photo
                    </label>

                    <input type="file"
                           name="ProfilePhoto"
                           accept=".jpg,.jpeg,.png"
                           class="register-input register-file"
                           required />

                </div>

            </div>


            <!-- =====================================================
                 OTP
            ====================================================== -->

            <div class="section-title mt-4 mb-3">

                <i class="fa-solid fa-shield-halved"></i>

                Email / Mobile Verification

            </div>


            <div class="otp-section">

                <label class="otp-label">
                    OTP Verification
                </label>

                <div class="otp-content">

                    <div class="otp-options">

                        <label class="radio-option">

                            <input type="radio"
                                   name="OTPType"
                                   value="Mobile"
                                   checked />

                            <span>
                                Mobile No.
                            </span>

                        </label>


                        <label class="radio-option">

                            <input type="radio"
                                   name="OTPType"
                                   value="Email" />

                            <span>
                                College Email
                            </span>

                        </label>


                        <button type="button"
                                class="send-otp-btn">

                            Send OTP

                        </button>

                    </div>


                    <div class="otp-input-container">

                        <input type="text"
                               name="OTP"
                               class="otp-input"
                               placeholder="Enter OTP"
                               maxlength="6"
                               autocomplete="off"
                               required />

                    </div>

                </div>

            </div>


            <!-- =====================================================
                 LOGIN
            ====================================================== -->

            <div class="section-title mt-4 mb-3">

                <i class="fa-solid fa-lock"></i>

                Login Details

            </div>


            <div class="register-form-row">

                <div class="register-form-group">

                    <label class="register-label">
                        Password
                    </label>

                    <input type="password"
                           name="Password"
                           class="register-input"
                           placeholder="Create password"
                           required />

                </div>


                <div class="register-form-group">

                    <label class="register-label">
                        Confirm Password
                    </label>

                    <input type="password"
                           name="ConfirmPassword"
                           class="register-input"
                           placeholder="Confirm password"
                           required />

                </div>

            </div>


            <!-- =====================================================
                 SUBMIT
            ====================================================== -->

            <button type="submit"
                    class="register-main-btn">

                <i class="fa-solid fa-user-plus"></i>

                Add Sub TPO

            </button>

        </form>


        <!-- =====================================================
             BACK
        ====================================================== -->

        <div class="register-bottom-text">

            <a asp-controller="TPO"
               asp-action="Dashboard">

                Back to Dashboard

            </a>

        </div>

    </div>

</div>