@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "View TPO Profile";
    Layout = null;

    var tpo = Model ?? new ErJobPortal.Models.TPORegistration();

    string DisplayValue(object? value)
    {
        var text = Convert.ToString(value);
        return string.IsNullOrWhiteSpace(text) ? "Not Available" : text.Trim();
    }

    bool HasValue(object? value)
    {
        return !string.IsNullOrWhiteSpace(Convert.ToString(value));
    }

    string DocumentUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path))
            return string.Empty;

        path = path.Trim();

        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return path;
        }

        if (path.StartsWith("~/", StringComparison.Ordinal) ||
            path.StartsWith("/", StringComparison.Ordinal))
        {
            return Url.Content(path);
        }

        if (path.Contains('/') || path.Contains('\\'))
        {
            return Url.Content("~/" + path.Replace("\\", "/").TrimStart('/'));
        }

        return Url.Content("~/Uploads/TPO/" + path);
    }

    string profilePhotoUrl = HasValue(tpo.ProfilePhoto)
        ? Url.Content(tpo.ProfilePhoto!)
        : string.Empty;

    string document1Url = DocumentUrl(tpo.SupportingDocument1);
    string document2Url = DocumentUrl(tpo.SupportingDocument2);

    string websiteUrl = string.Empty;

    if (HasValue(tpo.OrganizationWebsiteURL))
    {
        websiteUrl = Convert.ToString(tpo.OrganizationWebsiteURL)!.Trim();

        if (!websiteUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase) &&
            !websiteUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            websiteUrl = "https://" + websiteUrl;
        }
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>View TPO Profile - 1Trainee</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/TPOViewProfile.css"
          asp-append-version="true" />
</head>

<body>
    <main class="tpo-profile-page">

        <article class="tpo-profile-card" id="tpoProfile">

            <!-- Header -->
            <header class="tpo-profile-cover">
                <div class="tpo-cover-content">

                    <a href="/"
                       class="tpo-cover-brand"
                       aria-label="Go to 1Trainee home">
                        <span class="tpo-brand-icon">
                            <i class="fa-solid fa-user-tie"></i>
                        </span>

                        <span class="tpo-brand-details">
                            <span class="tpo-brand-title">1Trainee</span>
                            <span class="tpo-brand-subtitle">Training &amp; Placement Portal</span>
                        </span>
                    </a>

                    <div class="tpo-profile-actions">
                        <button type="button"
                                class="tpo-action-btn"
                                title="Home"
                                aria-label="Home"
                                onclick="goHome()">
                            <i class="fa-solid fa-house"></i>
                            <span class="tpo-action-label">Home</span>
                        </button>

                        <button type="button"
                                class="tpo-action-btn"
                                title="Print profile"
                                aria-label="Print profile"
                                onclick="printProfile()">
                            <i class="fa-solid fa-print"></i>
                            <span class="tpo-action-label">Print</span>
                        </button>

                        <button type="button"
                                class="tpo-action-btn"
                                title="Download as PDF"
                                aria-label="Download as PDF"
                                onclick="downloadProfile()">
                            <i class="fa-solid fa-download"></i>
                            <span class="tpo-action-label">Save PDF</span>
                        </button>
                    </div>
                </div>

                <div class="tpo-cover-decoration tpo-cover-decoration-one"></div>
                <div class="tpo-cover-decoration tpo-cover-decoration-two"></div>
            </header>

            <!-- Identity -->
            <section class="tpo-identity-section">

                <div class="tpo-profile-photo">
                    @if (!string.IsNullOrWhiteSpace(profilePhotoUrl))
                    {
                        <img src="@profilePhotoUrl"
                             alt="TPO Profile Photo"
                             class="tpo-profile-photo-image"
                             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />

                        <div class="tpo-photo-placeholder" style="display:none">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                    }
                    else
                    {
                        <div class="tpo-photo-placeholder">
                            <i class="fa-solid fa-user-tie"></i>
                        </div>
                    }
                </div>

                <div class="tpo-identity-details">
                    <span class="tpo-identity-eyebrow">TPO PROFILE</span>

                    <h1 class="tpo-profile-name">
                        @DisplayValue(tpo.FullName)
                    </h1>

                    <div class="tpo-profile-meta">
                        <span class="tpo-verified-badge">
                            <i class="fa-solid fa-circle-check"></i>
                            Training &amp; Placement Officer
                        </span>

                        @if (HasValue(tpo.Designation))
                        {
                            <span class="tpo-meta-item">
                                <i class="fa-solid fa-briefcase"></i>
                                @tpo.Designation
                            </span>
                        }

                        @if (HasValue(tpo.DepartmentName))
                        {
                            <span class="tpo-meta-item">
                                <i class="fa-solid fa-building"></i>
                                @tpo.DepartmentName
                            </span>
                        }
                    </div>
                </div>

                <div class="tpo-identity-tag">
                    <i class="fa-solid fa-shield-halved"></i>
                    Profile Details
                </div>
            </section>

            <!-- Profile content -->
            <section class="tpo-profile-body">

                <!-- Personal information -->
                <section class="tpo-profile-section">
                    <div class="tpo-section-heading">
                        <div class="tpo-section-icon">
                            <i class="fa-solid fa-address-card"></i>
                        </div>
                        <div>
                            <h2>Personal Information</h2>
                            <p>TPO contact and identification details</p>
                        </div>
                    </div>

                    <div class="tpo-information-grid">

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">Full Name</span>
                                <span class="tpo-information-value">@DisplayValue(tpo.FullName)</span>
                            </div>
                        </div>

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">Mobile Number</span>
                                @if (HasValue(tpo.MobileNo))
                                {
                                    <a class="tpo-information-value tpo-value-link"
                                       href="tel:@tpo.MobileNo">
                                        @tpo.MobileNo
                                    </a>
                                }
                                else
                                {
                                    <span class="tpo-information-value">Not Available</span>
                                }
                            </div>
                        </div>

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-envelope"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">College Mail ID</span>
                                @if (HasValue(tpo.CollegeMailID))
                                {
                                    <a class="tpo-information-value tpo-value-link"
                                       href="mailto:@tpo.CollegeMailID">
                                        @tpo.CollegeMailID
                                    </a>
                                }
                                else
                                {
                                    <span class="tpo-information-value">Not Available</span>
                                }
                            </div>
                        </div>

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-id-card"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">College Employee ID</span>
                                <span class="tpo-information-value">@DisplayValue(tpo.CollegeEmployeeID)</span>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- College information -->
                <section class="tpo-profile-section">
                    <div class="tpo-section-heading">
                        <div class="tpo-section-icon">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                        <div>
                            <h2>College / Organization Information</h2>
                            <p>Institution and organization details</p>
                        </div>
                    </div>

                    <div class="tpo-information-grid">

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-building"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">College Name</span>
                                <span class="tpo-information-value">@DisplayValue(tpo.CollegeName)</span>
                            </div>
                        </div>

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-hashtag"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">College Code</span>
                                <span class="tpo-information-value">@DisplayValue(tpo.CollegeCode)</span>
                            </div>
                        </div>

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-globe"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">Organization Website</span>

                                @if (HasValue(tpo.OrganizationWebsiteURL))
                                {
                                    <a href="@websiteUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="tpo-information-value tpo-website-link">
                                        Visit Website
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="tpo-information-value">Not Available</span>
                                }
                            </div>
                        </div>

                        <div class="tpo-information-card tpo-card-wide">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">College Address</span>
                                <span class="tpo-information-value tpo-address">
                                    @DisplayValue(tpo.CollegeAddress)
                                </span>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- Professional information -->
                <section class="tpo-profile-section">
                    <div class="tpo-section-heading">
                        <div class="tpo-section-icon">
                            <i class="fa-solid fa-briefcase"></i>
                        </div>
                        <div>
                            <h2>Professional Information</h2>
                            <p>Current designation and department</p>
                        </div>
                    </div>

                    <div class="tpo-information-grid">

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">Designation</span>
                                <span class="tpo-information-value">@DisplayValue(tpo.Designation)</span>
                            </div>
                        </div>

                        <div class="tpo-information-card">
                            <div class="tpo-information-icon">
                                <i class="fa-solid fa-sitemap"></i>
                            </div>
                            <div class="tpo-information-text">
                                <span class="tpo-information-label">Department Name</span>
                                <span class="tpo-information-value">@DisplayValue(tpo.DepartmentName)</span>
                            </div>
                        </div>

                    </div>
                </section>

                <!-- Verification documents -->
                <section class="tpo-profile-section">
                    <div class="tpo-section-heading">
                        <div class="tpo-section-icon">
                            <i class="fa-solid fa-file-shield"></i>
                        </div>
                        <div>
                            <h2>Verification Documents</h2>
                            <p>Supporting documents associated with this profile</p>
                        </div>
                    </div>

                    <div class="tpo-information-grid tpo-document-grid">

                        <!-- Document 1 -->
                        <div class="tpo-document-card">
                            <div class="tpo-document-icon">
                                <i class="fa-solid fa-file-lines"></i>
                            </div>

                            <div class="tpo-document-content">
                                <span class="tpo-information-label">Supporting Document 1</span>
                                <span class="tpo-document-description">ID Card / Appointment Letter</span>

                                @if (!string.IsNullOrWhiteSpace(document1Url))
                                {
                                    <span class="tpo-status uploaded">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Document Available
                                    </span>

                                    <a href="@document1Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="tpo-document-link">
                                        <i class="fa-solid fa-eye"></i>
                                        View Document
                                    </a>
                                }
                                else
                                {
                                    <span class="tpo-status not-uploaded">
                                        <i class="fa-solid fa-circle-minus"></i>
                                        Not Available
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Document 2 -->
                        <div class="tpo-document-card">
                            <div class="tpo-document-icon tpo-document-icon-alt">
                                <i class="fa-solid fa-file-circle-check"></i>
                            </div>

                            <div class="tpo-document-content">
                                <span class="tpo-information-label">Supporting Document 2</span>
                                <span class="tpo-document-description">Authorization / Other Proof</span>

                                @if (!string.IsNullOrWhiteSpace(document2Url))
                                {
                                    <span class="tpo-status uploaded">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Document Available
                                    </span>

                                    <a href="@document2Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="tpo-document-link">
                                        <i class="fa-solid fa-eye"></i>
                                        View Document
                                    </a>
                                }
                                else
                                {
                                    <span class="tpo-status not-uploaded">
                                        <i class="fa-solid fa-circle-minus"></i>
                                        Not Available
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Profile photo -->
                        <div class="tpo-document-card">
                            <div class="tpo-document-icon tpo-photo-document-icon">
                                <i class="fa-solid fa-camera"></i>
                            </div>

                            <div class="tpo-document-content">
                                <span class="tpo-information-label">Profile Photo</span>
                                <span class="tpo-document-description">TPO profile photograph</span>

                                @if (!string.IsNullOrWhiteSpace(profilePhotoUrl))
                                {
                                    <span class="tpo-status uploaded">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Photo Available
                                    </span>

                                    <a href="@profilePhotoUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="tpo-document-link">
                                        <i class="fa-solid fa-eye"></i>
                                        View Photo
                                    </a>
                                }
                                else
                                {
                                    <span class="tpo-status not-uploaded">
                                        <i class="fa-solid fa-circle-minus"></i>
                                        Not Available
                                    </span>
                                }
                            </div>
                        </div>

                    </div>
                </section>

            </section>

            <!-- Footer -->
            <footer class="tpo-profile-footer">
                <div class="tpo-footer-brand">
                    <span class="tpo-footer-logo">1</span>
                    <span>Powered by <strong>1Trainee</strong></span>
                </div>
                <span class="tpo-footer-caption">Training &amp; Placement Portal</span>
            </footer>

        </article>
    </main>

    <script>
        function goHome() {
            window.location.href = "/";
        }

        function printProfile() {
            window.print();
        }

        function downloadProfile() {
            // Opens the browser print dialog. Select "Save as PDF".
            window.print();
        }
    </script>
</body>
</html>
