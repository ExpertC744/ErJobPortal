@model ErJobPortal.Models.TPORegistration

@{
    ViewData["Title"] = "View TPO Profile";
    Layout = null;

    var tpo = Model ?? new ErJobPortal.Models.TPORegistration();

    string DisplayValue(object? value)
    {
        var text = Convert.ToString(value);

        return string.IsNullOrWhiteSpace(text)
            ? "Not Available"
            : text;
    }

    bool HasValue(object? value)
    {
        return !string.IsNullOrWhiteSpace(
            Convert.ToString(value));
    }
}

<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        View TPO Profile - 1Trainee
    </title>


    <!-- =====================================================
         FONT AWESOME
    ====================================================== -->

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <!-- =====================================================
         TPO VIEW PROFILE CSS
    ====================================================== -->

    <link rel="stylesheet"
          href="~/css/TPOViewProfile.css"
          asp-append-version="true" />

</head>


<body>


    <main class="tpo-profile-page">


        <!-- =================================================
             MAIN PROFILE CARD
        ================================================== -->

        <article class="tpo-profile-card"
                 id="tpoProfile">


            <!-- =================================================
                 COVER
            ================================================== -->

            <header class="tpo-profile-cover">

                <div class="tpo-cover-content">


                    <!-- BRAND -->

                    <div class="tpo-cover-brand">

                        <div class="tpo-brand-icon">

                            <i class="fa-solid fa-user-tie"></i>

                        </div>


                        <div class="tpo-brand-details">

                            <span class="tpo-brand-title">
                                1Trainee
                            </span>

                            <span class="tpo-brand-subtitle">
                                Training & Placement Portal
                            </span>

                        </div>

                    </div>


                    <!-- ACTION BUTTONS -->

                    <div class="tpo-profile-actions">


                        <!-- HOME -->

                        <button type="button"
                                class="tpo-action-btn"
                                title="Home"
                                aria-label="Home"
                                onclick="goHome()">

                            <i class="fa-solid fa-house"></i>

                        </button>


                        <!-- PRINT -->

                        <button type="button"
                                class="tpo-action-btn"
                                title="Print"
                                aria-label="Print"
                                onclick="printProfile()">

                            <i class="fa-solid fa-print"></i>

                        </button>


                        <!-- DOWNLOAD -->

                        <button type="button"
                                class="tpo-action-btn"
                                title="Download PDF"
                                aria-label="Download PDF"
                                onclick="downloadProfile()">

                            <i class="fa-solid fa-download"></i>

                        </button>


                    </div>

                </div>

            </header>


            <!-- =================================================
                 PROFILE IDENTITY
            ================================================== -->

            <section class="tpo-identity-section">


                <!-- PROFILE PHOTO -->

                <div class="tpo-profile-photo">

                    @if (!string.IsNullOrWhiteSpace(tpo.ProfilePhoto))
                    {
                        <img src="@Url.Content(tpo.ProfilePhoto)"
                             alt="TPO Profile Photo"
                             class="tpo-profile-photo-image" />
                    }
                    else
                    {
                        <div class="tpo-photo-placeholder">

                            <i class="fa-solid fa-user-tie"></i>

                        </div>
                    }

                </div>


                <!-- NAME -->

                <h1 class="tpo-profile-name">

                    @DisplayValue(tpo.FullName)

                </h1>


                <!-- META -->

                <div class="tpo-profile-meta">


                    <!-- TPO BADGE -->

                    <span class="tpo-verified-badge">

                        <i class="fa-solid fa-circle-check"></i>

                        TPO

                    </span>


                    <!-- DESIGNATION -->

                    @if (HasValue(tpo.Designation))
                    {
                        <span class="tpo-meta-item">

                            <i class="fa-solid fa-briefcase"></i>

                            @tpo.Designation

                        </span>
                    }


                    <!-- DEPARTMENT -->

                    @if (HasValue(tpo.DepartmentName))
                    {
                        <span class="tpo-meta-item">

                            <i class="fa-solid fa-building"></i>

                            @tpo.DepartmentName

                        </span>
                    }


                </div>

            </section>


            <!-- =================================================
                 PROFILE BODY
            ================================================== -->

            <section class="tpo-profile-body">


                <!-- =================================================
                     PERSONAL INFORMATION
                ================================================== -->

                <div class="tpo-section-heading">

                    <div class="tpo-section-icon">

                        <i class="fa-solid fa-user"></i>

                    </div>


                    <div>

                        <h2>
                            Personal Information
                        </h2>

                        <p>
                            TPO contact and identification details
                        </p>

                    </div>

                </div>


                <div class="tpo-information-grid">


                    <!-- FULL NAME -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-user"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                Full Name
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.FullName)
                            </span>

                        </div>

                    </div>


                    <!-- MOBILE -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-phone"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                Mobile Number
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.MobileNo)
                            </span>

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-envelope"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                College Mail ID
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.CollegeMailID)
                            </span>

                        </div>

                    </div>


                    <!-- EMPLOYEE ID -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-id-card"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                College Employee ID
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.CollegeEmployeeID)
                            </span>

                        </div>

                    </div>


                </div>


                <!-- =================================================
                     COLLEGE / ORGANIZATION INFORMATION
                ================================================== -->

                <div class="tpo-section-heading tpo-section-spacing">

                    <div class="tpo-section-icon">

                        <i class="fa-solid fa-building-columns"></i>

                    </div>


                    <div>

                        <h2>
                            College / Organization Information
                        </h2>

                        <p>
                            Institution and organization details
                        </p>

                    </div>

                </div>


                <div class="tpo-information-grid">


                    <!-- COLLEGE NAME -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-building"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                College Name
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.CollegeName)
                            </span>

                        </div>

                    </div>


                    <!-- COLLEGE CODE -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-hashtag"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                College Code
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.CollegeCode)
                            </span>

                        </div>

                    </div>


                    <!-- WEBSITE -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-globe"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                Organization Website
                            </span>


                            <span class="tpo-information-value">

                                @if (HasValue(tpo.OrganizationWebsiteURL))
                                {
                                    var website =
                                        Convert.ToString(
                                            tpo.OrganizationWebsiteURL);

                                    if (!website!.StartsWith(
                                        "http://",
                                        StringComparison.OrdinalIgnoreCase)
                                        &&
                                        !website.StartsWith(
                                        "https://",
                                        StringComparison.OrdinalIgnoreCase))
                                    {
                                        website =
                                            "https://" + website;
                                    }


                                    <a href="@website"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="tpo-website-link">

                                        @tpo.OrganizationWebsiteURL

                                    </a>
                                }
                                else
                                {
                                    <span>
                                        Not Available
                                    </span>
                                }

                            </span>

                        </div>

                    </div>


                    <!-- ADDRESS -->

                    <div class="tpo-information-card tpo-card-wide">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-location-dot"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                College Address
                            </span>

                            <span class="tpo-information-value tpo-address">
                                @DisplayValue(tpo.CollegeAddress)
                            </span>

                        </div>

                    </div>


                </div>


                <!-- =================================================
                     PROFESSIONAL INFORMATION
                ================================================== -->

                <div class="tpo-section-heading tpo-section-spacing">

                    <div class="tpo-section-icon">

                        <i class="fa-solid fa-briefcase"></i>

                    </div>


                    <div>

                        <h2>
                            Professional Information
                        </h2>

                        <p>
                            Current professional designation and department
                        </p>

                    </div>

                </div>


                <div class="tpo-information-grid">


                    <!-- DESIGNATION -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-user-tie"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                Designation
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.Designation)
                            </span>

                        </div>

                    </div>


                    <!-- DEPARTMENT -->

                    <div class="tpo-information-card">

                        <div class="tpo-information-icon">

                            <i class="fa-solid fa-sitemap"></i>

                        </div>


                        <div class="tpo-information-text">

                            <span class="tpo-information-label">
                                Department Name
                            </span>

                            <span class="tpo-information-value">
                                @DisplayValue(tpo.DepartmentName)
                            </span>

                        </div>

                    </div>


                </div>


                <!-- =================================================
                     VERIFICATION DOCUMENTS
                ================================================== -->

                <div class="tpo-section-heading tpo-section-spacing">

                    <div class="tpo-section-icon">

                        <i class="fa-solid fa-file-shield"></i>

                    </div>


                    <div>

                        <h2>
                            Verification Documents
                        </h2>

                        <p>
                            Supporting documents associated with this TPO profile
                        </p>

                    </div>

                </div>


                <div class="tpo-information-grid">


                    <!-- =================================================
                         DOCUMENT 1
                    ================================================== -->

                    <div class="tpo-document-card">


                        <div class="tpo-document-icon">

                            <i class="fa-solid fa-file-circle-check"></i>

                        </div>


                        <div class="tpo-document-content">

                            <span class="tpo-information-label">

                                Supporting Document 1

                            </span>


                            <span class="tpo-document-description">

                                ID Card / Appointment Letter

                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                tpo.SupportingDocument1))
                            {
                                <span class="tpo-status uploaded">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Document Available

                                </span>


                                <a href="@Url.Content(
    tpo.SupportingDocument1.StartsWith("/")
        ? tpo.SupportingDocument1
        : "/Uploads/TPO/" + tpo.SupportingDocument1)"
   target="_blank" 
   rel="noopener noreferrer"
   class="tpo-document-link">

                                    <i class="fa-solid fa-eye"></i>

                                    View Document

                                </a>
                            }
                            else
                            {
                                <span class="tpo-status not-uploaded">

                                    <i class="fa-solid fa-circle-xmark"></i>

                                    Not Available

                                </span>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         DOCUMENT 2
                    ================================================== -->

                    <div class="tpo-document-card">


                        <div class="tpo-document-icon">

                            <i class="fa-solid fa-file-circle-check"></i>

                        </div>


                        <div class="tpo-document-content">

                            <span class="tpo-information-label">

                                Supporting Document 2

                            </span>


                            <span class="tpo-document-description">

                                Authorization / Other Proof

                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                tpo.SupportingDocument2))
                            {
                                <span class="tpo-status uploaded">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Document Available

                                </span>


                                <a href="@Url.Content(tpo.SupportingDocument2)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="tpo-document-link">

                                    <i class="fa-solid fa-eye"></i>

                                    View Document

                                </a>
                            }
                            else
                            {
                                <span class="tpo-status not-uploaded">

                                    <i class="fa-solid fa-circle-xmark"></i>

                                    Not Available

                                </span>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         PROFILE PHOTO
                    ================================================== -->

                    <div class="tpo-document-card">


                        <div class="tpo-document-icon">

                            <i class="fa-solid fa-camera"></i>

                        </div>


                        <div class="tpo-document-content">

                            <span class="tpo-information-label">

                                Profile Photo

                            </span>


                            <span class="tpo-document-description">

                                TPO profile photograph

                            </span>


                            @if (!string.IsNullOrWhiteSpace(
                                tpo.ProfilePhoto))
                            {
                                <span class="tpo-status uploaded">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Photo Available

                                </span>


                                <a href="@Url.Content(tpo.ProfilePhoto)"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="tpo-document-link">

                                    <i class="fa-solid fa-eye"></i>

                                    View Photo

                                </a>
                            }
                            else
                            {
                                <span class="tpo-status not-uploaded">

                                    <i class="fa-solid fa-circle-xmark"></i>

                                    Not Available

                                </span>
                            }

                        </div>

                    </div>


                </div>


            </section>


            <!-- =================================================
                 FOOTER
            ================================================== -->

            <footer class="tpo-profile-footer">

                <span>
                    Powered by
                </span>

                <strong>
                    1Trainee
                </strong>

            </footer>


        </article>

    </main>


    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script>


        /* =====================================================
           HOME
        ====================================================== */

        function goHome()
        {
            window.location.href = "/";
        }


        /* =====================================================
           PRINT PROFILE
        ====================================================== */

        function printProfile()
        {
            window.print();
        }


        /* =====================================================
           DOWNLOAD / PRINT
        ====================================================== */

        function downloadProfile()
        {
            window.print();
        }


    </script>


</body>

</html>