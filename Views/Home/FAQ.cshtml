<!-- ACCORDION + SCROLL REVEAL -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const faqPage = document.querySelector(".faq-page");

        if (!faqPage) {
            return;
        }

        /* =========================================
           FAQ ACCORDION
           Allows multiple answers to remain open.
        ========================================= */
        const faqQuestions = faqPage.querySelectorAll(".faq-question");

        faqQuestions.forEach(function (button) {

            button.addEventListener("click", function () {

                const answerId = button.getAttribute("aria-controls");
                const answer = document.getElementById(answerId);
                const isExpanded =
                    button.getAttribute("aria-expanded") === "true";

                if (!answer) {
                    return;
                }

                button.setAttribute(
                    "aria-expanded",
                    String(!isExpanded)
                );

                answer.hidden = isExpanded;

                const icon = button.querySelector(".faq-toggle i");

                if (icon) {
                    icon.classList.toggle("fa-plus", isExpanded);
                    icon.classList.toggle("fa-minus", !isExpanded);
                }

                const faqItem = button.closest(".faq-item");

                if (faqItem) {
                    faqItem.classList.toggle("is-open", !isExpanded);
                }

            });

        });


        /* =========================================
           SCROLL REVEAL
        ========================================= */
        const revealElements = faqPage.querySelectorAll(
            ".scroll-reveal, .scroll-right"
        );

        if ("IntersectionObserver" in window) {

            const observer = new IntersectionObserver(
                function (entries) {

                    entries.forEach(function (entry) {

                        if (entry.isIntersecting) {
                            entry.target.classList.add("show");
                        } else {
                            entry.target.classList.remove("show");
                        }

                    });

                },
                {
                    threshold: 0.08,
                    rootMargin: "0px 0px -25px 0px"
                }
            );

            revealElements.forEach(function (element) {
                observer.observe(element);
            });

        } else {

            revealElements.forEach(function (element) {
                element.classList.add("show");
            });

        }

    });
</script>