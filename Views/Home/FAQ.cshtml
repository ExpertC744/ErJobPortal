@{
    ViewData["Title"] = "FAQs";
}

<link rel="stylesheet"
      href="~/css/FAQs.css"
      asp-append-version="true" />

<div class="faq-page">

    <!-- HERO SECTION -->
    <section class="faq-hero">

        <div class="faq-shape faq-shape-one"></div>
        <div class="faq-shape faq-shape-two"></div>

        <div class="faq-particles" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
        </div>

        <div class="faq-top-space"></div>

        <div class="container faq-hero-container">
            <div class="faq-title-wrapper">

                <span class="faq-small-title">
                    <i class="fas fa-circle-question"></i>
                    HELP CENTER
                </span>

                <h1 class="faq-title">
                    Frequently Asked <span>Questions</span>
                </h1>

                <div class="faq-title-line"></div>

                <p class="faq-subtitle">
                    Find helpful answers about 1Trainee, trainee registration,
                    internship applications, organization accounts, and
                    international opportunities.
                </p>

                <nav class="faq-breadcrumb" aria-label="Breadcrumb">
                    <a asp-controller="Home" asp-action="Index">
                        <i class="fas fa-house"></i>
                        Home
                    </a>

                    <i class="fas fa-chevron-right faq-breadcrumb-arrow"
                       aria-hidden="true"></i>

                    <span class="faq-current-page">FAQs</span>
                </nav>

            </div>
        </div>

        <div class="faq-hero-bottom"></div>
    </section>


    <!-- MAIN CONTENT -->
    <section class="faq-content">

        <div class="container">
            <div class="faq-main-row">

                <!-- LEFT FAQ CONTENT -->
                <main class="faq-left-content">

                    <div class="faq-intro-card scroll-reveal">
                        <div class="faq-intro-icon">
                            <i class="fas fa-comments"></i>
                        </div>

                        <div>
                            <span class="faq-section-label">
                                HOW CAN WE HELP?
                            </span>

                            <h2>Everything you need to know</h2>

                            <p>
                                Browse the questions below and select any
                                question to view its answer. Whether you are
                                a trainee or an organization, this guide will
                                help you get started with 1Trainee.
                            </p>
                        </div>
                    </div>


                    <!-- =================================================
                         SECTION 1: TRAINEES
                    ================================================== -->
                    <section class="faq-section scroll-reveal">

                        <div class="faq-section-heading">

                            <div class="faq-heading-icon">
                                <i class="fas fa-user-graduate"></i>
                            </div>

                            <div class="faq-heading-copy">
                                <span class="faq-section-label">
                                    FOR CANDIDATES
                                </span>

                                <h2>Trainees</h2>

                                <p>
                                    Registration, profiles, applications,
                                    and trainee accounts.
                                </p>
                            </div>

                            <span class="faq-count">06 QUESTIONS</span>

                        </div>


                        <div class="faq-accordion">

                            <!-- Q1 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-trainee-1"
                                            id="faq-question-trainee-1">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">01</span>
                                            What is 1Trainee?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-trainee-1"
                                     role="region"
                                     aria-labelledby="faq-question-trainee-1"
                                     hidden>

                                    <p>
                                        1Trainee is a career and internship
                                        portal designed to connect trainees
                                        with organizations offering internship,
                                        fellowship, and trainee opportunities.
                                        It helps candidates explore opportunities
                                        and enables organizations to share
                                        their requirements through one platform.
                                    </p>

                                </div>

                            </article>


                            <!-- Q2 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-trainee-2"
                                            id="faq-question-trainee-2">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">02</span>
                                            How can I register as a trainee?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-trainee-2"
                                     role="region"
                                     aria-labelledby="faq-question-trainee-2"
                                     hidden>

                                    <p>
                                        Open the trainee or candidate
                                        registration page and enter the
                                        information requested in the form.
                                        Review your details carefully before
                                        submitting your registration. After
                                        registration, sign in using the
                                        credentials and process provided by
                                        the portal.
                                    </p>

                                </div>

                            </article>


                            <!-- Q3 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-trainee-3"
                                            id="faq-question-trainee-3">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">03</span>
                                            How can I find internship opportunities?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-trainee-3"
                                     role="region"
                                     aria-labelledby="faq-question-trainee-3"
                                     hidden>

                                    <p>
                                        Sign in to your candidate account,
                                        complete your profile, and browse the
                                        available opportunities. Review the
                                        eligibility criteria, required skills,
                                        location, duration, schedule, and other
                                        conditions before applying for a role.
                                    </p>

                                </div>

                            </article>


                            <!-- Q4 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-trainee-4"
                                            id="faq-question-trainee-4">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">04</span>
                                            Why should I complete my profile?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-trainee-4"
                                     role="region"
                                     aria-labelledby="faq-question-trainee-4"
                                     hidden>

                                    <p>
                                        A complete and accurate profile helps
                                        organizations understand your education,
                                        qualifications, skills, interests, and
                                        experience. Keep your contact details,
                                        resume, and other profile information
                                        up to date so recruiters can review
                                        your application more effectively.
                                    </p>

                                </div>

                            </article>


                            <!-- Q5 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-trainee-5"
                                            id="faq-question-trainee-5">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">05</span>
                                            How can I track my applications?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-trainee-5"
                                     role="region"
                                     aria-labelledby="faq-question-trainee-5"
                                     hidden>

                                    <p>
                                        Sign in to your candidate dashboard
                                        and open the applications or application
                                        history section, where available.
                                        You can review your submitted
                                        applications and check the status
                                        displayed by the portal. Status
                                        information may depend on updates
                                        made by the organization.
                                    </p>

                                </div>

                            </article>


                            <!-- Q6 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-trainee-6"
                                            id="faq-question-trainee-6">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">06</span>
                                            What should I do if I cannot access my account?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-trainee-6"
                                     role="region"
                                     aria-labelledby="faq-question-trainee-6"
                                     hidden>

                                    <p>
                                        Check that you are using the correct
                                        registered credentials. If you have
                                        forgotten your password, use the
                                        available password-recovery option.
                                        If the issue continues, contact portal
                                        support and provide a description of
                                        the problem without sharing your password.
                                    </p>

                                </div>

                            </article>

                        </div>
                    </section>


                    <!-- =================================================
                         SECTION 2: ORGANIZATIONS
                    ================================================== -->
                    <section class="faq-section scroll-reveal">

                        <div class="faq-section-heading">

                            <div class="faq-heading-icon">
                                <i class="fas fa-building"></i>
                            </div>

                            <div class="faq-heading-copy">
                                <span class="faq-section-label">
                                    FOR EMPLOYERS
                                </span>

                                <h2>Organizations</h2>

                                <p>
                                    Organization registration, posting
                                    requirements, and trainee selection.
                                </p>
                            </div>

                            <span class="faq-count">06 QUESTIONS</span>

                        </div>


                        <div class="faq-accordion">

                            <!-- Q1 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-org-1"
                                            id="faq-question-org-1">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">01</span>
                                            How can an organization register?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-org-1"
                                     role="region"
                                     aria-labelledby="faq-question-org-1"
                                     hidden>

                                    <p>
                                        Open the organization registration
                                        page and provide the requested
                                        organization and contact information.
                                        Review the details for accuracy and
                                        complete the registration process.
                                        Once your account is available, sign
                                        in to access the organization dashboard.
                                    </p>

                                </div>

                            </article>


                            <!-- Q2 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-org-2"
                                            id="faq-question-org-2">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">02</span>
                                            Can organizations post opportunities for free?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-org-2"
                                     role="region"
                                     aria-labelledby="faq-question-org-2"
                                     hidden>

                                    <p>
                                        Yes. Organizations can post internship,
                                        fellowship, and trainee requirements
                                        free of charge through the 1Trainee
                                        portal. Provide accurate role details
                                        and clearly describe the qualifications,
                                        skills, duration, schedule, and conditions
                                        for the opportunity.
                                    </p>

                                </div>

                            </article>


                            <!-- Q3 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-org-3"
                                            id="faq-question-org-3">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">03</span>
                                            What types of opportunities can organizations post?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-org-3"
                                     role="region"
                                     aria-labelledby="faq-question-org-3"
                                     hidden>

                                    <p>
                                        Organizations can post relevant
                                        internship, fellowship, and trainee
                                        requirements. Each post should explain
                                        the role, number of openings, required
                                        qualifications, preferred skills,
                                        location, working schedule, duration,
                                        and any applicable compensation
                                        or other conditions.
                                    </p>

                                </div>

                            </article>


                            <!-- Q4 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-org-4"
                                            id="faq-question-org-4">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">04</span>
                                            How long does an opportunity remain active?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-org-4"
                                     role="region"
                                     aria-labelledby="faq-question-org-4"
                                     hidden>

                                    <p>
                                        Opportunity posts remain open for
                                        90 days. Organizations can repost
                                        their requirements when needed,
                                        subject to the portal's posting
                                        process and applicable conditions.
                                    </p>

                                </div>

                            </article>


                            <!-- Q5 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-org-5"
                                            id="faq-question-org-5">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">05</span>
                                            How can organizations review applicants?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-org-5"
                                     role="region"
                                     aria-labelledby="faq-question-org-5"
                                     hidden>

                                    <p>
                                        Sign in to the organization dashboard
                                        and open the relevant post or eligible
                                        trainee section. Review candidate
                                        profiles and the information provided
                                        in applications, then follow your
                                        organization's selection process to
                                        contact and evaluate suitable candidates.
                                    </p>

                                </div>

                            </article>


                            <!-- Q6 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-org-6"
                                            id="faq-question-org-6">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">06</span>
                                            Can an organization update or repost a requirement?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-org-6"
                                     role="region"
                                     aria-labelledby="faq-question-org-6"
                                     hidden>

                                    <p>
                                        Organizations should use the options
                                        available in their dashboard to manage
                                        posted requirements. Review a post's
                                        current status before editing or
                                        reposting it, and ensure that all
                                        updated role information and
                                        requirements are accurate.
                                    </p>

                                </div>

                            </article>

                        </div>
                    </section>


                    <!-- =================================================
                         SECTION 3: INTERNATIONAL INTERNSHIPS
                    ================================================== -->
                    <section class="faq-section scroll-reveal">

                        <div class="faq-section-heading">

                            <div class="faq-heading-icon">
                                <i class="fas fa-earth-americas"></i>
                            </div>

                            <div class="faq-heading-copy">
                                <span class="faq-section-label">
                                    GLOBAL OPPORTUNITIES
                                </span>

                                <h2>International Internships</h2>

                                <p>
                                    Eligibility, preparation, travel,
                                    and international experience.
                                </p>
                            </div>

                            <span class="faq-count">05 QUESTIONS</span>

                        </div>


                        <div class="faq-accordion">

                            <!-- Q1 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-global-1"
                                            id="faq-question-global-1">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">01</span>
                                            What are international internships?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-global-1"
                                     role="region"
                                     aria-labelledby="faq-question-global-1"
                                     hidden>

                                    <p>
                                        International internships provide
                                        opportunities to gain professional
                                        exposure with organizations operating
                                        in another country. Depending on the
                                        role, they may help trainees develop
                                        practical skills, understand different
                                        work environments, and build a broader
                                        professional perspective.
                                    </p>

                                </div>

                            </article>


                            <!-- Q2 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-global-2"
                                            id="faq-question-global-2">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">02</span>
                                            What should I check before applying?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-global-2"
                                     role="region"
                                     aria-labelledby="faq-question-global-2"
                                     hidden>

                                    <p>
                                        Carefully review the opportunity
                                        details before submitting an
                                        application. Check the following:
                                    </p>

                                    <ul class="faq-list">
                                        <li>
                                            <strong>Eligibility:</strong>
                                            Required education, qualifications,
                                            experience, and skills.
                                        </li>

                                        <li>
                                            <strong>Location:</strong>
                                            Country, city, work arrangement,
                                            and relocation expectations.
                                        </li>

                                        <li>
                                            <strong>Duration:</strong>
                                            Start date, end date, working
                                            hours, and schedule.
                                        </li>

                                        <li>
                                            <strong>Financial conditions:</strong>
                                            Compensation, charges, living
                                            expenses, and other costs.
                                        </li>

                                        <li>
                                            <strong>Travel requirements:</strong>
                                            Visa, work authorization, travel,
                                            and insurance requirements, where
                                            applicable.
                                        </li>
                                    </ul>

                                </div>

                            </article>


                            <!-- Q3 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-global-3"
                                            id="faq-question-global-3">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">03</span>
                                            How can I prepare for an international opportunity?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-global-3"
                                     role="region"
                                     aria-labelledby="faq-question-global-3"
                                     hidden>

                                    <p>
                                        Keep your profile and resume updated,
                                        prepare a clear summary of your
                                        relevant skills, and collect any
                                        documents requested by the organization.
                                        Research the destination and review
                                        eligibility, costs, travel requirements,
                                        and the opportunity's terms before
                                        making a commitment.
                                    </p>

                                </div>

                            </article>


                            <!-- Q4 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-global-4"
                                            id="faq-question-global-4">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">04</span>
                                            Are visa and travel arrangements included?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-global-4"
                                     role="region"
                                     aria-labelledby="faq-question-global-4"
                                     hidden>

                                    <p>
                                        Visa, travel, accommodation, insurance,
                                        and relocation arrangements depend on
                                        the specific opportunity and the
                                        organization. Do not assume these
                                        expenses are included. Confirm the
                                        details directly with the organization
                                        and check the applicable official
                                        immigration requirements before
                                        travelling.
                                    </p>

                                </div>

                            </article>


                            <!-- Q5 -->
                            <article class="faq-item">

                                <h3 class="faq-question-heading">
                                    <button class="faq-question"
                                            type="button"
                                            aria-expanded="false"
                                            aria-controls="faq-global-5"
                                            id="faq-question-global-5">

                                        <span class="faq-question-text">
                                            <span class="faq-question-number">05</span>
                                            How can I verify an opportunity before accepting it?
                                        </span>

                                        <span class="faq-toggle"
                                              aria-hidden="true">
                                            <i class="fas fa-plus"></i>
                                        </span>

                                    </button>
                                </h3>

                                <div class="faq-answer"
                                     id="faq-global-5"
                                     role="region"
                                     aria-labelledby="faq-question-global-5"
                                     hidden>

                                    <p>
                                        Review the organization's identity,
                                        role description, contact information,
                                        selection process, and written terms.
                                        Ask for clarification about any
                                        compensation, fees, travel, or
                                        accommodation arrangements. Avoid
                                        sharing sensitive information or
                                        making payments until you have
                                        independently verified the legitimacy
                                        of the opportunity.
                                    </p>

                                </div>

                            </article>

                        </div>
                    </section>


                    <!-- CLOSING SUPPORT CARD -->
                    <section class="faq-support-card scroll-reveal">

                        <div class="faq-support-icon">
