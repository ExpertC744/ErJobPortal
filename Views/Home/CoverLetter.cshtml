@{
    ViewData["Title"] = "Cover Letter Guidance";
}

<link rel="stylesheet" href="~/css/cover-letter-guidance.css" />

<div class="cover-letter-page" id="coverLetterPage">

    <!-- SCROLL PROGRESS -->
    <div class="cover-progress" id="coverProgress"></div>

    <!-- HERO -->
    <section class="cover-hero">

        <span class="cover-shape cover-shape-one"></span>
        <span class="cover-shape cover-shape-two"></span>

        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-7 text-center text-md-start">

                    <span class="cover-eyebrow">
                        Career Guidance
                    </span>

                    <h1 class="cover-hero-title">
                        Cover Letter Guidance
                    </h1>

                    <div class="cover-title-line"></div>

                    <p class="cover-hero-subtitle">
                        Create professional, industry-focused cover letters
                        that highlight your strengths and make a lasting
                        impression on employers.
                    </p>

                </div>

                <div class="col-md-5 text-center text-md-end mt-4 mt-md-0">

                    <nav class="cover-breadcrumb" aria-label="Breadcrumb">

                        <a href="@Url.Content("~/Home/Index")"
                           class="cover-breadcrumb-link">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>

                        <span class="cover-breadcrumb-arrow">
                            <i class="fas fa-angle-double-right"></i>
                        </span>

                        <span class="cover-breadcrumb-current">
                            Cover Letter Guidance
                        </span>

                    </nav>

                </div>

            </div>
        </div>

    </section>


    <!-- MAIN CONTENT -->
    <section class="cover-content">

        <div class="container">

            <div class="row g-4 align-items-start">

                <!-- LEFT CONTENT -->
                <div class="col-lg-8">

                    <!-- INTRODUCTION -->
                    <section class="cover-section cover-intro scroll-reveal">

                        <h2 class="cover-heading">
                            <span class="cover-heading-icon">
                                <i class="fas fa-envelope-open-text"></i>
                            </span>
                            Writing an Effective Cover Letter
                        </h2>

                        <p>
                            Tailoring your cover letter to the industry and
                            the specific role can significantly enhance your
                            chances of making a strong impression.
                        </p>

                        <p>
                            Make sure to personalize each letter and highlight
                            how your skills and experiences align with the job
                            you’re applying for.
                        </p>

                        <p>
                            Crafting an effective cover letter tailored to a
                            specific industry involves understanding both the
                            industry’s unique characteristics and the
                            expectations of the hiring organization.
                        </p>

                    </section>


                    <!-- GENERAL TIPS -->
                    <section class="cover-section scroll-reveal">

                        <h2 class="cover-heading">
                            <span class="cover-heading-icon">
                                <i class="fas fa-lightbulb"></i>
                            </span>
                            General Tips for Tailoring a Cover Letter
                        </h2>

                        <div class="cover-tip-list">

                            <article class="cover-tip-item">
                                <span class="cover-number">1</span>
                                <div>
                                    <h3>Research the Industry</h3>
                                    <p>
                                        Understand the industry’s norms,
                                        trends, and key skills. This will help
                                        you align your cover letter with
                                        what’s important in that field.
                                    </p>
                                </div>
                            </article>

                            <article class="cover-tip-item">
                                <span class="cover-number">2</span>
                                <div>
                                    <h3>Use Industry-Specific Language</h3>
                                    <p>
                                        Incorporate terminology and jargon
                                        relevant to the industry to show that
                                        you’re familiar with its standards
                                        and practices.
                                    </p>
                                </div>
                            </article>

                            <article class="cover-tip-item">
                                <span class="cover-number">3</span>
                                <div>
                                    <h3>Highlight Relevant Skills and Experience</h3>
                                    <p>
                                        Focus on experiences and skills that
                                        directly relate to the job and industry.
                                    </p>
                                </div>
                            </article>

                            <article class="cover-tip-item">
                                <span class="cover-number">4</span>
                                <div>
                                    <h3>Show Enthusiasm for the Industry</h3>
                                    <p>
                                        Demonstrate your passion and
                                        understanding of the field. Employers
                                        value trainees who are genuinely
                                        interested in their work.
                                    </p>
                                </div>
                            </article>

                            <article class="cover-tip-item">
                                <span class="cover-number">5</span>
                                <div>
                                    <h3>Align with Company Values</h3>
                                    <p>
                                        Research the company’s values and
                                        mission statement. Tailor your cover
                                        letter to show how your personal
                                        values and career goals align with
                                        those of the company.
                                    </p>
                                </div>
                            </article>

                            <article class="cover-tip-item">
                                <span class="cover-number">6</span>
                                <div>
                                    <h3>Be Specific</h3>
                                    <p>
                                        Use specific examples of your
                                        achievements that are relevant to
                                        the industry and the role you’re
                                        applying for.
                                    </p>
                                </div>
                            </article>

                        </div>

                    </section>


