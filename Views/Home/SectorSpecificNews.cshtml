@{
    ViewData["Title"] = "Sector-Specific News";

    var sectorSlots = new[]
    {
        (Src: (string)null, Alt: "Best Exam Preparation Solution", Title: "Important Information", Text: "Stay updated on the latest interview tips and resources!"),
        (Src: (string)null, Alt: "Professional Training Assessment", Title: "Important Information", Text: "Stay updated on the latest interview tips and resources!"),
        (Src: (string)null, Alt: "Best Job Search Site", Title: "Important Information", Text: "Stay updated on the latest interview tips and resources!")
    };
}

<link rel="stylesheet" href="~/css/sector-specific-news.css" />

<div class="sector-news-page">

    <!-- Scroll progress -->
    <div class="sector-news-progress" id="sectorNewsProgress"></div>

    <!-- Hero -->
    <section class="sector-news-hero">
        <span class="sector-news-shape sector-news-shape-1"></span>
        <span class="sector-news-shape sector-news-shape-2"></span>

        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 text-center text-md-start">
                    <span class="sector-news-small-title animated-badge">Industry Updates</span>
                    <h1 class="sector-news-title">SECTOR-SPECIFIC NEWS</h1>
                    <div class="sector-news-title-line"></div>
                    <p class="sector-news-subtitle">
                        Stay ahead of the curve with the latest updates and trends tailored to your industry.
                    </p>
                </div>

                <div class="col-md-5 text-center text-md-end mt-4 mt-md-0">
                    <nav class="sector-news-breadcrumb" aria-label="Breadcrumb">
                        <a class="sector-news-btn" href="~/Home/Index">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <span class="sector-news-arrow"><i class="fas fa-angle-double-right"></i></span>
                        <span class="sector-news-current-page">Sector-Specific News</span>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="sector-news-content">
        <div class="container">
            <div class="row g-4">

                <!-- LEFT CONTENT -->
                <div class="col-lg-8">

                    <!-- Intro -->
                    <div class="sector-news-section sector-news-intro">
                        <p class="sector-lead-text">
                            Stay ahead of the curve with the latest updates and trends in your industry. Our <strong>Sector-Specific News</strong> section provides curated content tailored to various fields, helping you stay informed and prepared as you navigate your career path. Whether you're interested in technology, finance, healthcare, or creative industries, we've got you covered.
                        </p>
                    </div>

                    <!-- Why Sector-Specific News Matters -->
                    <div class="sector-news-section scroll-reveal">
                        <h2 class="sector-news-heading">Why Sector-Specific News Matters:</h2>
                        <ul class="sector-news-list" data-stagger>
                            <li>
                                <b>Industry Insights:</b> Get the latest news and updates on industry trends, emerging technologies, and market shifts that could impact your career opportunities.
                            </li>
                            <li>
                                <b>Company News:</b> Stay informed about key developments, product launches, and strategic moves by leading companies in your sector.
                            </li>
                            <li>
                                <b>Career Opportunities:</b> Learn about new job openings, internship programs, and professional growth opportunities specific to your field of interest.
                            </li>
                            <li>
                                <b>Expert Opinions:</b> Access insights and analyses from industry experts, providing valuable perspectives on current trends and future outlooks.
                            </li>
                        </ul>
                    </div>

                    <!-- Featured Sector-Specific News -->
                    <div class="sector-news-section scroll-reveal">
                        <h2 class="sector-news-heading">Featured Sector-Specific News:</h2>
                        <ul class="sector-news-list" data-stagger>
                            <li>
                                <b>Technology:</b> Explore innovations in AI, cybersecurity, and software development. Stay updated on tech conferences, startups, and breakthrough research.
                            </li>
                            <li>
                                <b>Finance:</b> Get the latest updates on market trends, investment strategies, and financial regulations. Learn about new fintech solutions and industry forecasts.
                            </li>
                            <li>
                                <b>Healthcare:</b> Read about advancements in medical research, healthcare policies, and wellness trends. Discover new roles and opportunities in healthcare settings.
                            </li>
                            <li>
                                <b>Creative Industries:</b> Find news on design trends, media updates, and artistic innovations. Learn about upcoming events, exhibitions, and creative job openings.
                            </li>
                        </ul>
                    </div>

                    <!-- Related Links -->
                    <div class="sector-news-section scroll-reveal">
                        <h2 class="sector-news-heading">Related Links:</h2>
                        <ul class="sector-news-list" data-stagger>
                            <li>
                                <b>TechCrunch:</b> For updates on technology trends, startups, and industry news.
                            </li>
                            <li>
                                <b>Bloomberg:</b> Comprehensive news on finance, economics, and market analysis.
                            </li>
                            <li>
                                <b>Healthcare News:</b> Latest news and insights on healthcare technology and industry developments.
                            </li>
                            <li>
                                <b>CreativeBlog:</b> News and trends in design, graphic arts, and creative technology.
                            </li>
                        </ul>
                    </div>

                    <!-- Conclusion Box -->
                    <div class="sector-news-important-box scroll-reveal">
                        <div class="sector-news-important-content">
                            <h2>Stay Informed and Ahead:</h2>
                            <p>
                                Regularly visiting the Sector-Specific News section will keep you informed about key developments in your field, enhance your industry knowledge, and help you make strategic career decisions. Visit 1trainee.com for the latest updates and expert analyses tailored to your interests.
                            </p>
                        </div>
                    </div>

                </div>

                <!-- RIGHT SIDEBAR -->
                <aside class="col-lg-4">
                    <div class="sector-news-sticky">
                        @foreach (var slot in sectorSlots)
                        {
                            <div class="sector-news-side-item scroll-right">
                                <div class="sector-news-image-box no-image">
                                    <div class="sector-news-placeholder">
                                        <i class="far fa-image"></i>
                                        <span class="sector-news-placeholder-title">Advertisement Space</span>
                                        <span class="sector-news-placeholder-note">Image will appear here</span>
                                    </div>
                                </div>

                                <div class="sector-news-info-card">
                                    <h3>@slot.Title</h3>
                                    <p>@slot.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </aside>

            </div>
        </div>
    </section>

    <!-- Back to top -->
    <a href="#" class="sector-news-back-to-top" aria-label="Back to top">
        <i class="fa fa-angle-double-up"></i>
    </a>
</div>

