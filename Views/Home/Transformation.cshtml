@{
    ViewData["Title"] = "Transformation";
}


<link rel="stylesheet"
      href="~/css/Transformation.css"
      asp-append-version="true">
<!-- =========================================================
     TRANSFORMATION PAGE
========================================================= -->

<div class="transformation-page">

    <!-- HERO -->
    <section class="transformation-hero">

        <div class="transformation-hero-content">

            <div class="transformation-badge">
                <i class="fa-solid fa-arrow-up-right-dots"></i>
                Career Transformation
            </div>

            <h1>Transformation</h1>

            <p>
                Becoming industry-ready involves a mix of technical skills,
                soft skills, and real-world experience. Here are some tips for
                students to prepare for a successful transition into the
                professional world:
            </p>

        </div>

    </section>


    <!-- CONTENT -->
    <div class="transformation-content">

        <div class="transformation-grid">


            <!-- 01 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        01
                    </div>

                    <h2>Build a Strong Foundation</h2>

                </div>

                <div class="transformation-point">
                    <strong>Master the Basics:</strong>
                    <span>
                        Ensure a solid understanding of core concepts in 
                        field, whether it's programming, design, engineering, etc.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Stay Updated:</strong>
                    <span>
                        Follow industry trends and advancements to keep 
                        knowledge current.
                    </span>
                </div>

            </article>


            <!-- 02 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        02
                    </div>

                    <h2>Gain Practical Experience</h2>

                </div>

                <div class="transformation-point">
                    <strong>Internships:</strong>
                    <span>
                        Apply for internships to gain hands-on experience and
                        understand industry workflows.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Projects:</strong>
                    <span>
                        Work on personal or academic projects that showcase
                         skills and creativity.
                    </span>
                </div>

            </article>


            <!-- 03 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        03
                    </div>

                    <h2>Develop Technical Skills</h2>

                </div>

                <div class="transformation-point">
                    <strong>Communication:</strong>
                    <span>
                        Develop strong written and verbal communication skills
                        for clear and effective interactions.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Teamwork:</strong>
                    <span>
                        Collaborate on group projects to build  ability
                        to work well in a team.
                    </span>
                </div>

            </article>


            <!-- 04 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        04
                    </div>

                    <h2>Network Actively</h2>

                </div>

                <div class="transformation-point">
                    <strong>Professional Networking:</strong>
                    <span>
                        Attend industry events, webinars, and conferences to
                        meet professionals and peers.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>LinkedIn:</strong>
                    <span>
                        Create and maintain a polished LinkedIn profile to
                        connect with industry professionals and potential employers.
                    </span>
                </div>

            </article>


            <!-- 05 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        05
                    </div>

                    <h2>Build a Strong Resume and Portfolio</h2>

                </div>

                <div class="transformation-point">
                    <strong>Resume:</strong>
                    <span>
                        Craft a resume that highlights  skills,
                        experiences, and accomplishments.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Portfolio:</strong>
                    <span>
                        Create an online portfolio to showcase  projects,
                        skills, and achievements.
                    </span>
                </div>

            </article>


            <!-- 06 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        06
                    </div>

                    <h2>Prepare for Interviews</h2>

                </div>

                <div class="transformation-point">
                    <strong>Mock Interviews:</strong>
                    <span>
                        Practice with mock interviews to improve  responses
                        and gain confidence.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Research:</strong>
                    <span>
                        Research common interview questions and prepare
                        thoughtful answers.
                    </span>
                </div>

            </article>


            <!-- 07 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        07
                    </div>

                    <h2>Develop Problem-Solving Skills</h2>

                </div>

                <div class="transformation-point">
                    <strong>Critical Thinking:</strong>
                    <span>
                        Work on developing analytical and problem-solving skills
                        that are highly valued in any industry.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Challenge Yourself:</strong>
                    <span>
                        Engage in activities that push you to think creatively
                        and solve complex problems.
                    </span>
                </div>

            </article>


            <!-- 08 -->
            <article class="transformation-card">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        08
                    </div>

                    <h2>Seek Feedback</h2>

                </div>

                <div class="transformation-point">
                    <strong>Mentors:</strong>
                    <span>
                        Find mentors who can provide guidance and constructive
                        feedback on  progress.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Peer Reviews:</strong>
                    <span>
                        Participate in peer reviews to learn from others and
                        improve  work.
                    </span>
                </div>

            </article>


            <!-- 09 -->
            <article class="transformation-card full-width">

                <div class="transformation-card-top">

                    <div class="transformation-number">
                        09
                    </div>

                    <h2>Stay Adaptable and Curious</h2>

                </div>

                <div class="transformation-point">
                    <strong>Continuous Learning:</strong>
                    <span>
                        Embrace lifelong learning to adapt to new technologies
                        and methods.
                    </span>
                </div>

                <div class="transformation-point">
                    <strong>Flexibility:</strong>
                    <span>
                        Be open to different roles and responsibilities as you
                        navigate  career path.
                    </span>
                </div>

            </article>

        </div>


        <!-- CONCLUSION -->
        <div class="transformation-conclusion">

            <h2>
                Your Professional Transformation
            </h2>

            <p>
                By focusing on these areas, students can better position
                themselves to enter the workforce with confidence and competence.
            </p>

        </div>

    </div>

</div>