@{
    ViewData["Title"] = "Interview Preparation";

    var ads = new string[]
    {
        ViewBag.ImagePathA as string,
        ViewBag.ImagePathB as string,
        ViewBag.ImagePathC as string,
        ViewBag.ImagePathD as string,
        ViewBag.ImagePathE as string,
        ViewBag.ImagePathF as string
    };
}

<link rel="stylesheet" href="~/css/interview-preparation.css" />

<div class="interview-page">

    <!-- Hero -->
    <section class="interview-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 text-center text-md-start">
                    <span class="hero-small-title">Career Guidance</span>
                    <h1 class="hero-title">Interview Preparation</h1>
                    <div class="hero-title-line"></div>
                    <p class="hero-subtitle">
                        Prepare with confidence and make your next interview successful.
                    </p>
                </div>

                <div class="col-md-5 text-center text-md-end mt-4 mt-md-0">
                    <nav class="hero-breadcrumb" aria-label="Breadcrumb">
                        <a class="hero-btn" asp-controller="Home" asp-action="Index">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <span class="breadcrumb-arrow"><i class="fas fa-angle-double-right"></i></span>
                        <span class="hero-current-page">Interview Preparation</span>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Layout -->
    <div class="container interview-main">
        <div class="row g-4">

            <!-- LEFT CONTENT -->
            <div class="col-lg-8">

                <div class="interview-card intro-card">
                    <h2 class="card-heading">Tips for Interview Preparation</h2>
                    <p class="content-text">
                        Preparing for interviews can be an essential step in landing a job. Here are some resources, tips, and strategies to help you prepare effectively, along with commonly asked questions and how to tackle them:
                    </p>
                </div>

                <!-- Resources -->
                <div class="section-title scroll-reveal">
                    <span class="section-title-bar"></span>
                    <h3>Resources</h3>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">1</span>Company Research</h4>
                    <ul class="interview-list">
                        <li><b>Company Website:</b> Understand the company's mission, values, recent news, and key projects.</li>
                        <li><b>Glassdoor:</b> Check out company reviews, salary information, and interview experiences from past trainees.</li>
                        <li><b>LinkedIn:</b> Look at the company’s updates and check profiles of employees in the role you're applying for.</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">2</span>Industry Trends</h4>
                    <ul class="interview-list">
                        <li><b>Industry Publications:</b> Stay updated on trends, challenges, and news related to your industry.</li>
                        <li><b>Professional Associations:</b> Join relevant associations to access resources, networking opportunities, and industry insights.</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">3</span>Mock Interviews</h4>
                    <ul class="interview-list">
                        <li><b>Interview Coaching Services:</b> Consider platforms like The Muse or career coaches who can provide personalized feedback.</li>
                        <li><b>Practice with Friends or Family:</b> Conduct mock interviews to get comfortable with speaking about your experiences.</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">4</span>Books and Online Courses</h4>
                    <ul class="interview-list">
                        <li><b>Books:</b> “Cracking the Coding Interview” by Gayle Laakmann McDowell for technical roles, and “Interviewing: The Job Seeker’s Guide” for general advice.</li>
                        <li><b>Online Courses:</b> Platforms like Coursera, Udemy, or LinkedIn Learning offer courses on interview skills.</li>
                    </ul>
                </div>

                <!-- Strategies -->
                <div class="section-title scroll-reveal">
                    <span class="section-title-bar"></span>
                    <h3>Strategies for Answering Common Interview Questions</h3>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">1</span>Tell Me About Yourself</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> Provide a brief summary of your professional background, highlighting key achievements and how they relate to the position.</li>
                        <li class="example-item"><b>Example:</b> “I have over five years of experience in digital marketing, where I’ve led successful campaigns that increased engagement by 30%. My background in data analysis and content creation aligns well with your needs for a digital marketing manager.”</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">2</span>Why Do You Want to Work Here?</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> Show that you’ve researched the company and explain how its values, mission, or projects resonate with your career goals.</li>
                        <li class="example-item"><b>Example:</b> “I’m impressed by [Company Name]’s commitment to sustainability. My previous work in green energy aligns with your mission, and I’m excited about the opportunity to contribute to your innovative projects.”</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">3</span>What Are Your Strengths and Weaknesses?</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> For strengths, choose qualities that are relevant to the job and provide examples. For weaknesses, mention an area for improvement and what you’re doing to address it.</li>
                        <li class="example-item"><b>Example:</b> “One of my strengths is my ability to manage multiple projects efficiently. For example, I successfully juggled three major projects simultaneously at my previous job. As for weaknesses, I’ve been working on improving my public speaking skills by attending workshops and seeking feedback.”</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">4</span>Describe a Challenge You’ve Faced at Work</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> Use the STAR method (Situation, Task, Action, Result) to structure your response.</li>
                        <li class="example-item"><b>Example:</b> “In my previous role, we faced a significant drop in customer satisfaction (Situation). My task was to identify the cause and improve our service (Task). I implemented a new feedback system and worked with the team to address key issues (Action). As a result, customer satisfaction scores improved by 20% within three months (Result).”</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">5</span>Where Do You See Yourself in Five Years?</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> Demonstrate your long-term vision and how it aligns with the company's growth. Show ambition while being realistic.</li>
                        <li class="example-item"><b>Example:</b> “In five years, I see myself in a leadership position, leading a team to achieve significant milestones. I’m particularly interested in developing my skills in project management, which aligns with [Company Name]’s growth strategy and opportunities for advancement.”</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">6</span>Why Should We Hire You?</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> Highlight your unique skills and experiences that make you the ideal trainee for the job.</li>
                        <li class="example-item"><b>Example:</b> “My background in [specific skill or experience] and my track record of [specific achievement] uniquely position me to contribute to your team. I’m excited about the opportunity to bring my expertise to [Company Name] and help drive [specific goal or project].”</li>
                    </ul>
                </div>

                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading"><span class="card-number">7</span>Behavioral Questions</h4>
                    <ul class="interview-list">
                        <li><b>Strategy:</b> Prepare for questions about teamwork, conflict resolution, and problem-solving using the STAR method.</li>
                        <li class="example-item"><b>Example:</b> “Tell me about a time you had a conflict with a colleague.” Use the STAR method to describe the situation, your role, actions taken, and the outcome.</li>
                    </ul>
                </div>

                <!-- Additional Tips -->
                <div class="interview-card scroll-reveal">
                    <h4 class="card-heading">Additional Tips for Interview Preparation</h4>
                    <ul class="interview-list">
                        <li><b>Prepare Questions:</b> Have thoughtful questions ready for the interviewer to show your interest and enthusiasm.</li>
                        <li><b>Practice Good Body Language:</b> Maintain eye contact, offer a firm handshake, and sit up straight to convey confidence.</li>
                        <li><b>Dress Appropriately:</b> Research the company’s dress code and choose an outfit that fits the company culture.</li>
                        <li><b>Bring Necessary Materials:</b> Bring extra copies of your resume, a list of references, and a notebook for taking notes.</li>
                        <li><b>Follow Up:</b> Send a thank-you email within 24 hours of the interview to reiterate your interest and appreciation.</li>
                    </ul>
                </div>

                <!-- Conclusion -->
                <div class="interview-card conclusion-card scroll-reveal">
                    <p class="content-text mb-0">
                        By leveraging these resources and strategies, you'll be well-prepared to handle your interviews with confidence and make a positive impression on your potential employers.
                    </p>
                </div>
            </div>

            <!-- RIGHT SIDEBAR -->
            <aside class="col-lg-4">
                <div class="sidebar-sticky">
                    @for (int i = 0; i < ads.Length; i++)
                    {
                        <div class="right-item scroll-right">
                            <div class="advertisement-box">
                                @if (!string.IsNullOrEmpty(ads[i]))
                                {
                                    <div class="advertisement-image">
                                        <img src="@Url.Content(ads[i])" alt="Advertisement" loading="lazy" />
                                    </div>
                                }
                                else
                                {
                                    <!-- Placeholder: shown until an image is uploaded for this slot -->
                                    <div class="ad-placeholder">
                                        <i class="far fa-image"></i>
                                        <span class="ad-placeholder-title">Advertisement Space</span>
                                        <span class="ad-placeholder-note">Image will appear here</span>
                                    </div>
                                }
                            </div>

                            @if (i < ads.Length - 1)
                            {
                                <div class="important-text">
                                    <h2>Important Information</h2>
                                    <p>Stay updated on the latest interview tips and resources!</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </aside>

        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var page = document.querySelector(".interview-page");
        var items = document.querySelectorAll(".scroll-reveal, .scroll-right");

        if (!("IntersectionObserver" in window)) { return; }

        page.classList.add("js-reveal");

        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add("show");
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.08, rootMargin: "0px 0px -40px 0px" });

        items.forEach(function (el) { observer.observe(el); });
    });
</script>

