@*
    Organization / Companies Page
*@
@{
	ViewData["Title"] = "Organizations & Companies";

	// Esteemed clients - add or remove rows here
	var clients = new[]
	{
		new { Name = "Kavin India Pvt Ltd",             Location = "Laxmi Nagar",         Logo = "~/images/clients/kavin-india.png" },
		new { Name = "IT-NetworkZ Infosystems Pvt Ltd", Location = "Laxmi Nagar, Nagpur", Logo = "~/images/clients/it-networkz.png" }
	};

	// Organization feedback - leave empty to show the "no recent" message.
	// Example: feedbacks.Add(("Company Name", "HR Department", "Feedback text"));
	var feedbacks = new List<(string Name, string Role, string Message)>();
}

<link rel="stylesheet"
	  href="~/css/Organization.css"
	  asp-append-version="true">
<link rel="stylesheet"
	  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<section class="organization-page">

	<!-- ================= ESTEEMED CLIENTS ================= -->
	<section class="org-clients">
		<div class="container">
			<div class="row align-items-center g-5">

				<div class="col-lg-5">
					<span class="org-eyebrow">ESTEEMED CLIENTS</span>
					<h2 class="org-title">Org / Companies</h2>
					<p class="clients-text">
						1trainee.com is an open platform for Trainees &amp;
						Organizations (Recruiters / Company / Institution) to
						fulfill their academic and professional search. Here
						Organizations are an important user and have free access
						to post their Internship / Fellowship / Trainee
						requirements in multiple numbers. Internship posts from
						Organizations will collect the data of respective
						Trainees based on the required skill sets; every post
						will remain open for 90 days so that the Organizations
						can fulfill the requirement.
					</p>
				</div>

				<div class="col-lg-7">
					<div class="clients-slider">

						<button type="button" class="clients-arrow" id="clientsPrev" aria-label="Previous clients">
							<i class="bi bi-chevron-left"></i>
						</button>

						<div class="clients-track" id="clientsTrack">
							@foreach (var c in clients)
							{
								<div class="client-card">
									<div class="client-logo">
										<img src="@Url.Content(c.Logo)" alt="@c.Name" loading="lazy" />
									</div>
									<h3>@c.Name</h3>
									<span><i class="bi bi-geo-alt-fill"></i> @c.Location</span>
								</div>
							}
						</div>

						<button type="button" class="clients-arrow" id="clientsNext" aria-label="Next clients">
							<i class="bi bi-chevron-right"></i>
						</button>

					</div>
				</div>

			</div>
		</div>
	</section>


	<!-- ================= TO OUR ESTEEMED CLIENTS ================= -->
	<section class="org-about">
		<div class="container">
			<div class="row align-items-center g-5">

				<div class="col-lg-7">

					<span class="org-eyebrow">TO OUR ESTEEMED CLIENTS</span>
					<h2 class="org-title">Org / Companies</h2>

					<div class="org-about-text">
						<p>
							1trainee.com is an open platform for Trainees and
							Organizations (Recruiters / Company / Institution)
							to fulfill their academic and professional search.
							Here Organization is an important user and has free
							access to post their Internship / Fellowship /
							Trainee requirements in multiple numbers.
						</p>

						<p>
							Internship posts from Organizations will collect the
							data of respective Trainees based on the required
							skill sets; every post will remain open for
							<strong>90 days</strong> so that the Organization can
							fulfill the requirement. Even if it's not fulfilled
							within a given period, the same post can be reposted
							with a single click and will remain open for the same
							duration.
						</p>

						<p>
							Organization has access to view internship records,
							Trainee resumes &amp; history as per the post.
							Trainees who have applied &amp; eligible will be
							shown there.
						</p>

						<p>
							Organizations those who are looking for Interns /
							Trainees will be benefited by posting their
							requirement. 1trainee.com prefer Organizations those
							who are providing stipend to Trainees / Interns on
							monthly basis, or are neutral i.e. just providing
							internships without any cost. Organizations that are
							charging any cost for their internships must
							highlight and mention it clearly.
						</p>

						<p>
							Organization can offer a full time / part time job
							to Trainee after successful completion of respective
							internship; this offer and joining must be carried in
							mutual way in between Organization and Trainee.
						</p>

						<p>
							1trainee.com will always assist Organizations to
							fulfill their internship related search in a quick
							time &amp; less efforts.
						</p>
					</div>

					<span class="org-eyebrow org-eyebrow-sm">HOW TO USE</span>

					<ol class="org-steps">
						<li>Register if new : Sign in</li>
						<li>Create Profile</li>
						<li>Edit &amp; View Profile</li>
						<li>Create Post</li>
						<li>View Post</li>
						<li>Edit Post (If required)</li>
						<li>Check eligible Trainee details</li>
						<li>Download required resumes</li>
						<li>Complete the selection process by contacting Trainees</li>
						<li>Keep Post Enable / Disable as per the need</li>
					</ol>

				</div>

				<div class="col-lg-5">
					<!-- IMAGE SPACE: put your image inside the box, e.g.
						 <img src="~/images/org/organization-team.jpg" alt="Organization team" /> -->
					<div class="org-image-slot">
						<div class="org-image-placeholder">
							<i class="bi bi-image"></i>
							<span>Image Space</span>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>


	<!-- ================= ORGANIZATION FEEDBACK ================= -->
	<section class="org-feedback">
		<div class="container">
			<div class="row align-items-center g-5">

				<div class="col-lg-7">

					<span class="org-eyebrow">ORGANIZATION FEEDBACK</span>
					<h2 class="org-title">What Our Organizations Say</h2>

					@if (feedbacks.Count == 0)
					{
						<p class="org-empty">No recent images found.</p>
					}
					else
					{
						<div class="feedback-list">
							@foreach (var f in feedbacks)
							{
								<div class="feedback-card">
									<p>"@f.Message"</p>
									<div class="feedback-user">
										<div class="feedback-avatar">@f.Name.Substring(0, 1)</div>
										<div>
											<strong>@f.Name</strong>
											<span>@f.Role</span>
										</div>
									</div>
								</div>
							}
						</div>
					}

				</div>

				<div class="col-lg-5">
					<!-- IMAGE SPACE: put your image inside the box, e.g.
						 <img src="~/images/org/feedback.jpg" alt="Organization feedback" /> -->
					<div class="org-image-slot">
						<div class="org-image-placeholder">
							<i class="bi bi-image"></i>
							<span>Image Space</span>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

</section>

<script>
	(function () {
		var track = document.getElementById('clientsTrack');
		var prev = document.getElementById('clientsPrev');
		var next = document.getElementById('clientsNext');
		if (!track || !prev || !next) return;

		function step() {
			var card = track.querySelector('.client-card');
			return card ? card.offsetWidth + 16 : 260;
		}

		prev.addEventListener('click', function () {
			track.scrollBy({ left: -step(), behavior: 'smooth' });
		});

		next.addEventListener('click', function () {
			track.scrollBy({ left: step(), behavior: 'smooth' });
		});
	})();
</script>
