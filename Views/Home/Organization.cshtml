
@*
    Organization / Companies Page
*@
@{
	ViewData["Title"] = "Organizations & Companies";
}

<link rel="stylesheet"
	  href="~/css/Organization.css"
	  asp-append-version="true">
<link rel="stylesheet"
	  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<section class="organization-page">

	<!-- ================= HERO ================= -->
	<section class="org-hero">
		<div class="container">
			<div class="row align-items-center g-5">

				<div class="col-lg-7">
					<div class="org-badge">
						<i class="bi bi-buildings"></i>
						For Organizations & Companies
					</div>

					<h1>
						Connect With the
						<span>Right Trainees</span>
						Faster
					</h1>

					<p class="org-hero-text">
						1trainee.com is an open platform for Trainees and
						Organizations such as Recruiters, Companies and
						Institutions to fulfill their academic and professional
						requirements.
					</p>

					<div class="org-hero-actions">
						<a href="#" class="org-btn-primary">
							<i class="bi bi-person-plus"></i>
							Create Organization Profile
						</a>

						<a href="#" class="org-btn-outline">
							<i class="bi bi-box-arrow-in-right"></i>
							Sign In
						</a>
					</div>
				</div>

				<div class="col-lg-5">
					<div class="org-hero-visual">

						<div class="org-floating-card org-card-top">
							<div class="org-floating-icon">
								<i class="bi bi-people"></i>
							</div>
							<div>
								<strong>Find Trainees</strong>
								<small>Based on required skills</small>
							</div>
						</div>

						<div class="org-main-visual">
							<div class="org-visual-icon">
								<i class="bi bi-buildings"></i>
							</div>

							<h3>Organization Hub</h3>

							<p>
								Post requirements, find eligible trainees
								and manage  internship opportunities.
							</p>

							<div class="org-visual-stats">
								<div>
									<strong>90</strong>
									<span>Days Post</span>
								</div>

								<div>
									<strong>Free</strong>
									<span>Posting</span>
								</div>

								<div>
									<strong>Easy</strong>
									<span>Repost</span>
								</div>
							</div>
						</div>

						<div class="org-floating-card org-card-bottom">
							<div class="org-floating-icon">
								<i class="bi bi-file-earmark-person"></i>
							</div>
							<div>
								<strong>View Resumes</strong>
								<small>Check eligible candidates</small>
							</div>
						</div>

					</div>
				</div>

			</div>
		</div>
	</section>


	<!-- ================= INTRODUCTION ================= -->
	<section class="org-intro section-padding">
		<div class="container">

			<div class="section-heading text-center">
				<span>ESTEEMED CLIENTS</span>
				<h2>Built for Organizations That Hire & Train</h2>
				<p>
					A simple platform to help organizations discover,
					connect and work with the right trainees.
				</p>
			</div>

			<div class="row justify-content-center">
				<div class="col-lg-10">

					<div class="org-content-card">

						<div class="org-content-icon">
							<i class="bi bi-buildings"></i>
						</div>

						<div>
							<h3>Organizations / Companies</h3>

							<p>
								1trainee.com is an open platform for Trainees
								and Organizations (Recruiters / Company /
								Institution) to fulfill their academic and
								professional search.
							</p>

							<p>
								Organizations are an important part of the
								platform and have free access to post their
								Internship, Fellowship and Trainee requirements
								in multiple numbers.
							</p>

							<p>
								Internship posts from Organizations collect
								relevant trainee data based on the required
								skill sets. Every post remains open for
								<strong>90 days</strong>, allowing
								Organizations enough time to fulfill their
								requirements.
							</p>
						</div>

					</div>

				</div>
			</div>

		</div>
	</section>


	<!-- ================= BENEFITS ================= -->
	<section class="org-benefits">
		<div class="container">

			<div class="section-heading text-center">
				<span>WHY ORGANIZATIONS CHOOSE US</span>
				<h2>Everything You Need to Find the Right Trainee</h2>
				<p>
					Manage  internship requirements with less effort
					and better visibility.
				</p>
			</div>

			<div class="row g-4">

				<div class="col-lg-4 col-md-6">
					<div class="org-benefit-card">
						<div class="benefit-icon">
							<i class="bi bi-megaphone"></i>
						</div>

						<h3>Post Requirements</h3>

						<p>
							Publish Internship, Fellowship and Trainee
							requirements based on  organization's
							requirements.
						</p>

						<div class="benefit-number">01</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="org-benefit-card">
						<div class="benefit-icon">
							<i class="bi bi-person-check"></i>
						</div>

						<h3>Find Eligible Trainees</h3>

						<p>
							View trainee information based on the skills
							and eligibility criteria mentioned in  post.
						</p>

						<div class="benefit-number">02</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="org-benefit-card">
						<div class="benefit-icon">
							<i class="bi bi-file-earmark-text"></i>
						</div>

						<h3>Access Resumes</h3>

						<p>
							Review trainee resumes and history and download
							the required resumes for  selection process.
						</p>

						<div class="benefit-number">03</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="org-benefit-card">
						<div class="benefit-icon">
							<i class="bi bi-arrow-repeat"></i>
						</div>

						<h3>Easy Reposting</h3>

						<p>
							If  requirement is not fulfilled within
							90 days, repost the same requirement with
							a single click.
						</p>

						<div class="benefit-number">04</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="org-benefit-card">
						<div class="benefit-icon">
							<i class="bi bi-bar-chart"></i>
						</div>

						<h3>Manage Posts</h3>

						<p>
							View and manage  internship records and
							keep  posts enabled or disabled according
							to  requirements.
						</p>

						<div class="benefit-number">05</div>
					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="org-benefit-card">
						<div class="benefit-icon">
							<i class="bi bi-lightning-charge"></i>
						</div>

						<h3>Save Time & Effort</h3>

						<p>
							Connect with relevant trainees quickly and
							simplify  internship recruitment process.
						</p>

						<div class="benefit-number">06</div>
					</div>
				</div>

			</div>

		</div>
	</section>


	<!-- ================= 90 DAYS ================= -->
	<section class="org-highlight">
		<div class="container">

			<div class="org-highlight-box">

				<div class="row align-items-center g-4">

					<div class="col-lg-8">

						<div class="highlight-label">
							<i class="bi bi-clock-history"></i>
							FLEXIBLE REQUIREMENT MANAGEMENT
						</div>

						<h2>
							Your Internship Post Stays Open for
							<span>90 Days</span>
						</h2>

						<p>
							Every internship requirement remains active
							for 90 days. If the requirement is not fulfilled
							during this period, organizations can repost
							the same requirement with a single click.
						</p>

					</div>

					<div class="col-lg-4">
						<div class="days-card">
							<strong>90</strong>
							<span>Days</span>
							<small>Post Availability</small>
						</div>
					</div>

				</div>

			</div>

		</div>
	</section>


	<!-- ================= ORGANIZATION RESPONSIBILITY ================= -->
	<section class="org-responsibility section-padding">
		<div class="container">

			<div class="section-heading text-center">
				<span>OUR ORGANIZATION GUIDELINES</span>
				<h2>A Transparent & Responsible Hiring Environment</h2>
				<p>
					We encourage organizations to provide clear and
					transparent internship opportunities.
				</p>
			</div>

			<div class="row g-4">

				<div class="col-lg-6">
					<div class="org-guideline-card">
						<div class="guideline-icon">
							<i class="bi bi-cash-coin"></i>
						</div>

						<div>
							<h3>Stipend-Friendly Opportunities</h3>
							<p>
								1trainee.com prefers organizations that
								provide a monthly stipend to trainees or
								offer internships without any cost.
							</p>
						</div>
					</div>
				</div>

				<div class="col-lg-6">
					<div class="org-guideline-card">
						<div class="guideline-icon">
							<i class="bi bi-info-circle"></i>
						</div>

						<div>
							<h3>Clear Internship Charges</h3>
							<p>
								Organizations charging any cost for their
								internship must clearly highlight and
								mention the charges in their requirement.
							</p>
						</div>
					</div>
				</div>

				<div class="col-lg-6">
					<div class="org-guideline-card">
						<div class="guideline-icon">
							<i class="bi bi-briefcase"></i>
						</div>

						<div>
							<h3>Full-Time / Part-Time Opportunities</h3>
							<p>
								Organizations can offer full-time or
								part-time employment to trainees after
								successful completion of their internship.
							</p>
						</div>
					</div>
				</div>

				<div class="col-lg-6">
					<div class="org-guideline-card">
						<div class="guideline-icon">
							<i class="bi bi-handshake"></i>
						</div>

						<div>
							<h3>Mutual Agreement</h3>
							<p>
								Any employment offer and joining after
								internship completion should be carried
								out mutually between the Organization
								and the Trainee.
							</p>
						</div>
					</div>
				</div>

			</div>

		</div>
	</section>


	<!-- ================= HOW TO USE ================= -->
	<section class="org-how section-padding">
		<div class="container">

			<div class="section-heading text-center">
				<span>HOW TO USE</span>
				<h2>Start Recruiting in Simple Steps</h2>
				<p>
					Follow a simple process to create  organization
					profile and connect with eligible trainees.
				</p>
			</div>

			<div class="org-process">

				<div class="process-item">
					<div class="process-number">01</div>
					<div class="process-content">
						<h3>Register</h3>
						<p>
							New organizations can register and create
							their organization account.
						</p>
					</div>
				</div>

				<div class="process-item">
					<div class="process-number">02</div>
					<div class="process-content">
						<h3>Create Profile</h3>
						<p>
							Add  organization details and create
							professional profile.
						</p>
					</div>
				</div>

				<div class="process-item">
					<div class="process-number">03</div>
					<div class="process-content">
						<h3>Create Post</h3>
						<p>
							Publish  Internship, Fellowship or
							Trainee requirement.
						</p>
					</div>
				</div>

				<div class="process-item">
					<div class="process-number">04</div>
					<div class="process-content">
						<h3>Check Eligible Trainees</h3>
						<p>
							Review trainee details, applications,
							eligibility and available resumes.
						</p>
					</div>
				</div>

				<div class="process-item">
					<div class="process-number">05</div>
					<div class="process-content">
						<h3>Download Resumes</h3>
						<p>
							Download required resumes and shortlist
							suitable trainees.
						</p>
					</div>
				</div>

				<div class="process-item">
					<div class="process-number">06</div>
					<div class="process-content">
						<h3>Complete Selection</h3>
						<p>
							Contact trainees directly and complete
							selection process.
						</p>
					</div>
				</div>

				<div class="process-item">
					<div class="process-number">07</div>
					<div class="process-content">
						<h3>Manage Your Post</h3>
						<p>
							Keep  post enabled or disabled according
							to  organization's requirement.
						</p>
					</div>
				</div>

			</div>

		</div>
	</section>


	<!-- ================= CTA ================= -->
	<section class="org-cta">
		<div class="container">

			<div class="org-cta-box">

				<div class="org-cta-content">

					<span>
						<i class="bi bi-stars"></i>
						FOR RECRUITERS & ORGANIZATIONS
					</span>

					<h2>
						Find the Right Trainees
						With Less Effort
					</h2>

					<p>
						1trainee.com will always assist organizations
						in fulfilling their internship-related search
						quickly and efficiently.
					</p>

					<div class="org-hero-actions">

						<a href="#" class="org-btn-white">
							<i class="bi bi-person-plus"></i>
							Register Your Organization
						</a>

						<a href="#" class="org-btn-transparent">
							Sign In
							<i class="bi bi-arrow-right"></i>
						</a>

					</div>

				</div>

				<div class="org-cta-icon">
					<i class="bi bi-buildings"></i>
				</div>

			</div>

		</div>
	</section>


	<!-- ================= FEEDBACK ================= -->
	<section class="org-feedback section-padding">
		<div class="container">

			<div class="section-heading text-center">
				<span>ORGANIZATION FEEDBACK</span>
				<h2>What Our Organizations Say</h2>
				<p>
					We value the organizations that use our platform
					to connect with the next generation of talent.
				</p>
			</div>

			<div class="row justify-content-center g-4">

				<div class="col-lg-4 col-md-6">
					<div class="feedback-card">

						<div class="quote-icon">
							<i class="bi bi-quote"></i>
						</div>

						<p>
							"1trainee.com makes it easier for us to
							connect with trainees based on the skills
							we actually need."
						</p>

						<div class="feedback-user">
							<div class="feedback-avatar">
								O
							</div>

							<div>
								<strong>Organization Partner</strong>
								<span>Recruitment Team</span>
							</div>
						</div>

					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="feedback-card">

						<div class="quote-icon">
							<i class="bi bi-quote"></i>
						</div>

						<p>
							"The ability to manage internship posts and
							review eligible trainee profiles helps us
							save considerable time."
						</p>

						<div class="feedback-user">
							<div class="feedback-avatar">
								C
							</div>

							<div>
								<strong>Company Partner</strong>
								<span>HR Department</span>
							</div>
						</div>

					</div>
				</div>

				<div class="col-lg-4 col-md-6">
					<div class="feedback-card">

						<div class="quote-icon">
							<i class="bi bi-quote"></i>
						</div>

						<p>
							"A simple and useful platform for organizations
							looking to find interns and trainees with
							relevant skills."
						</p>

						<div class="feedback-user">
							<div class="feedback-avatar">
								I
							</div>

							<div>
								<strong>Institution Partner</strong>
								<span>Placement Team</span>
							</div>
						</div>

					</div>
				</div>

			</div>

		</div>
	</section>

</section>

