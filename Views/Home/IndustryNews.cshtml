@{
    ViewData["Title"] = "Industry News & Trends";

    // Sidebar slots: set Src = null to show the placeholder until you have an image
    var slots = new[]
    {
        (Src: "~/img/5.jpg", Alt: "Financial News", Title: "Financial News",
         Text: "Explore financial news, market updates and analysis from leading information sources."),
        (Src: "~/img/2 (1).jpg", Alt: "Market Data", Title: "Market Data",
         Text: "Understand market data, financial analytics, research and economic trends."),
        (Src: "~/img/2 (2).jpg", Alt: "Industry Research", Title: "Industry Research",
         Text: "Discover industry-specific research, reports, statistics and professional insights."),
        (Src: (string)null, Alt: "Stay Updated", Title: "Stay Updated",
         Text: "Follow reliable sources and regularly monitor financial, economic and industry developments.")
    };
}

<link rel="stylesheet" href="~/css/industry-news.css" />

<div class="industry-news-page">

    <!-- Hero -->
    <section class="industry-news-hero">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 text-center text-md-start text-md-left">
                    <span class="industry-news-small-title">1Trainee.com</span>
                    <h1 class="industry-news-title">Industry News &amp; Trends</h1>
                    <div class="industry-news-title-line"></div>
                    <p class="industry-news-subtitle">
                        Explore reliable financial news, market data, professional research platforms and industry resources to stay informed about business trends and market developments.
                    </p>
                </div>

                <div class="col-md-5 text-center text-md-end text-md-right mt-4 mt-md-0">
                    <nav class="industry-news-breadcrumb" aria-label="Breadcrumb">
                        <a class="industry-news-btn" href="~/Home/Index">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <span class="industry-news-arrow"><i class="fas fa-angle-double-right"></i></span>
                        <span class="industry-news-current-page">Industry News &amp; Trends</span>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="industry-news-content">
        <div class="container">
            <div class="row g-4 industry-news-main-row">

                <!-- LEFT CONTENT -->
                <div class="col-lg-8 industry-news-left-content">

                    <div class="industry-news-section industry-news-intro">
                        <h2 class="industry-news-heading">Industry News &amp; Market Insights</h2>
                        <p>Discover in-depth analyses and reports on the latest trends shaping your industry.</p>
                        <p>
                            When it comes to getting market insights online, there are several excellent resources and platforms you can consider. Your choice will depend on whether you need real-time data, in-depth analysis, or specific industry insights. 1trainee.com suggests some of the top options for you.
                        </p>
                    </div>

                    <!-- 1 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">1</span>Financial News Websites</h3>
                        <p>
                            Financial news websites provide information about global markets, economic developments, financial events and business activities. They are useful for professionals, students and investors who want to understand current market conditions.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>Bloomberg:</b> Offers comprehensive coverage of financial markets, including news, data and analysis.</li>
                            <li><b>Reuters:</b> Provides real-time financial information and market analysis.</li>
                            <li><b>CNBC:</b> Delivers news and analysis on global markets and economic events.</li>
                        </ul>
                    </div>

                    <!-- 2 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">2</span>Market Data Providers</h3>
                        <p>
                            Market data platforms provide stock information, financial trends, portfolio tools and investment research. These resources can help users monitor markets and understand financial developments.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>Yahoo Finance:</b> Offers stock quotes, market news and portfolio management tools.</li>
                            <li><b>Google Finance:</b> Provides stock market news and trends, along with a portfolio tracker.</li>
                            <li><b>Morningstar:</b> Known for its investment research and analysis on mutual funds, stocks and ETFs.</li>
                        </ul>
                    </div>

                    <!-- 3 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">3</span>Professional Research Platforms</h3>
                        <p>
                            Professional research platforms provide detailed financial information, analytics and research tools for businesses and investment professionals.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>S&amp;P Capital IQ:</b> Provides detailed financial data, analytics and research.</li>
                            <li><b>FactSet:</b> Offers financial data and analytics, as well as research tools for investment professionals.</li>
                            <li><b>Thomson Reuters Eikon:</b> Delivers real-time market data and analysis.</li>
                        </ul>
                    </div>

                    <!-- 4 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">4</span>Market Analytics and Data Aggregators</h3>
                        <p>
                            Market analytics platforms combine financial information, market data, charts and research tools to help users analyze market movements and investment opportunities.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>TradingView:</b> Provides advanced charting tools and market analysis, with a strong community of traders.</li>
                            <li><b>Seeking Alpha:</b> Offers investment research, analysis and a community-driven approach to market insights.</li>
                            <li><b>MarketWatch:</b> Provides financial news, analysis and market data.</li>
                        </ul>
                    </div>

                    <!-- 5 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">5</span>Industry-Specific Research</h3>
                        <p>
                            Industry-specific research platforms provide reports, statistics and specialized insights across different business sectors. These resources are useful for understanding market size, competition and industry developments.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>IBISWorld:</b> Delivers industry reports and market research across various sectors.</li>
                            <li><b>Statista:</b> Provides statistical data and market insights across multiple industries.</li>
                            <li><b>Gartner:</b> Known for its technology-related research and market analysis.</li>
                        </ul>
                    </div>

                    <!-- 6 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">6</span>Economic and Government Data</h3>
                        <p>
                            Government and economic data sources provide information about economic indicators, GDP, consumer spending, employment and other important economic activities.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>Federal Reserve Economic Data (FRED):</b> Offers access to economic data and indicators from the Federal Reserve.</li>
                            <li><b>Bureau of Economic Analysis (BEA):</b> Provides economic statistics and data related to GDP, consumer spending and more.</li>
                        </ul>
                    </div>

                    <!-- 7 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">7</span>Online Communities and Forums</h3>
                        <p>
                            Online communities and forums allow users to discuss market trends, financial topics, investment ideas and industry developments. Community discussions can provide different perspectives on current events.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>Reddit:</b> Communities such as r/finance and r/investing provide community-driven insights and discussions on market trends.</li>
                            <li><b>StockTwits:</b> A social media platform focused on stock market discussions and insights.</li>
                        </ul>
                    </div>

                    <!-- 8 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">8</span>Social Media and Blogs</h3>
                        <p>
                            Social media platforms and blogs can provide timely commentary, professional opinions and educational content. Users should evaluate sources carefully before relying on information for financial decisions.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>Twitter:</b> Follow financial analysts, economists and market experts for real-time updates and insights.</li>
                            <li><b>Medium:</b> Look for finance and investment blogs for in-depth articles and personal insights.</li>
                        </ul>
                    </div>

                    <!-- 9 -->
                    <div class="industry-news-section scroll-reveal">
                        <h3 class="industry-news-heading"><span class="industry-news-number">9</span>Financial Advisory Services</h3>
                        <p>
                            Financial advisory services and digital wealth management platforms can provide investment information, planning tools and personalized financial guidance.
                        </p>
                        <ul class="industry-news-list">
                            <li><b>Robo-Advisors:</b> Platforms such as Betterment and Wealthfront offer personalized investment advice and insights.</li>
                            <li><b>Personal Capital:</b> Provides financial planning tools and market insights, focusing on wealth management.</li>
                        </ul>
                    </div>

                    <!-- Highlight -->
                    <div class="industry-news-important-box scroll-reveal">
                        <div class="industry-news-important-content">
                            <h2>Stay Industry Informed</h2>
                            <p>
                                Choosing the right platform depends on your specific needs, whether it's real-time updates, in-depth analysis or industry-specific data.
                            </p>
                        </div>
                    </div>

                    <!-- Conclusion -->
                    <div class="industry-news-section industry-news-final-section scroll-reveal">
                        <h3 class="industry-news-heading">Choosing the Right Industry News Source</h3>
                        <p>
                            Different platforms provide different types of information, so it is useful to compare their features and coverage.
                        </p>
                        <p class="mb-0">
                            Many of these platforms offer free tiers, while some may require a subscription for access to more advanced features and data. Students and professionals should select resources according to their learning, research and professional requirements.
                        </p>
                    </div>
                </div>

                <!-- RIGHT SIDEBAR -->
                <aside class="col-lg-4 industry-news-right-content">
                    <div class="industry-news-sticky">
                        @foreach (var slot in slots)
                        {
                            <div class="industry-news-side-item scroll-right">
                                <div class="industry-news-image-box @(string.IsNullOrEmpty(slot.Src) ? "no-image" : "")">
                                    @if (!string.IsNullOrEmpty(slot.Src))
                                    {
                                        <img src="@Url.Content(slot.Src)"
                                             alt="@slot.Alt"
                                             loading="lazy"
                                             onerror="this.closest('.industry-news-image-box').classList.add('no-image');" />
                                    }
                                    <div class="industry-news-placeholder">
                                        <i class="far fa-image"></i>
                                        <span class="industry-news-placeholder-title">Image Space</span>
                                        <span class="industry-news-placeholder-note">Image will appear here</span>
                                    </div>
                                </div>

                                <div class="industry-news-side-text">
                                    <h2>@slot.Title</h2>
                                    <p>@slot.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </aside>

            </div>
        </div>
    </section>

    <!-- Back to top -->
    <a href="#" class="industry-news-back-to-top" aria-label="Back to top">
        <i class="fa fa-angle-double-up"></i>
    </a>
</div>
