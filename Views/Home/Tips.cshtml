@{
    ViewData["Title"] = "Trainee - Important Tips";
}


<link rel="stylesheet"
      href="~/css/Tips.css"
      asp-append-version="true">
<!-- =========================================================
     TRAINEE IMPORTANT TIPS PAGE
     ========================================================= -->

<div class="trainee-tips-page">

    <!-- =====================================================
         HERO
         ====================================================== -->

    <section class="tips-hero">

        <div class="tips-container">

            <div class="tips-hero-content">

                <div class="tips-badge">
                    <i class="fa-solid fa-lightbulb"></i>
                    Trainee Guide
                </div>

                <h1>
                    Important <span>Tips</span>
                    for Trainees
                </h1>

                <p class="tips-hero-description">
                    Starting an internship is an exciting opportunity to gain
                    practical experience, build valuable skills, and connect
                    with professionals. Make  internship experience count
                    with these essential tips.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         INTRODUCTION
         ====================================================== -->

    <section class="tips-intro-section">

        <div class="tips-container">

            <div class="tips-section-heading">

                <h2>
                    Make the Most of Your
                    <span>Internship</span>
                </h2>

                <p>
                    An internship is more than just completing assigned tasks.
                    It is an opportunity to learn, contribute, build relationships,
                    and prepare self for  future career.
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         TIPS
         ====================================================== -->

    <section class="tips-grid-section">

        <div class="tips-grid">


            <!-- 01 -->

            <article class="tip-card">

                <span class="tip-number">01</span>

                <div class="tip-icon">
                    <i class="fa-solid fa-bullseye"></i>
                </div>

                <h3>
                    Set Clear Goals
                </h3>

                <p>
                    Before you begin, identify what you hope to achieve.
                    Whether it is learning a specific skill, understanding
                    industry dynamics, or building  professional network,
                    clear goals will help you stay focused and motivated.
                </p>

            </article>


            <!-- 02 -->

            <article class="tip-card">

                <span class="tip-number">02</span>

                <div class="tip-icon">
                    <i class="fa-solid fa-rocket"></i>
                </div>

                <h3>
                    Be Proactive
                </h3>

                <p>
                    Do not wait for tasks to be assigned to you. Look for ways
                    to contribute and offer to help with projects. Showing
                    initiative demonstrates  enthusiasm and commitment
                    to  role.
                </p>

            </article>


            <!-- 03 -->

            <article class="tip-card">

                <span class="tip-number">03</span>

                <div class="tip-icon">
                    <i class="fa-solid fa-comments"></i>
                </div>

                <h3>
                    Seek Feedback
                </h3>

                <p>
                    Regularly ask for feedback from  supervisor and
                    colleagues. Constructive feedback is a valuable tool for
                    growth and will help you improve  performance and
                    adapt to the workplace.
                </p>

            </article>


            <!-- 04 -->

            <article class="tip-card">

                <span class="tip-number">04</span>

                <div class="tip-icon">
                    <i class="fa-solid fa-people-group"></i>
                </div>

                <h3>
                    Build Relationships
                </h3>

                <p>
                    Take the time to connect with  colleagues and mentors.
                    Strong professional relationships can provide valuable
                    insights, career advice, and future opportunities.
                </p>

            </article>


            <!-- 05 -->

            <article class="tip-card">

                <span class="tip-number">05</span>

                <div class="tip-icon">
                    <i class="fa-solid fa-arrows-rotate"></i>
                </div>

                <h3>
                    Reflect on Your Experience
                </h3>

                <p>
                    Periodically reflect on what you have learned and how it
                    aligns with  career goals. This will help you assess
                     progress and make necessary adjustments to 
                    approach.
                </p>

            </article>


            <!-- 06 -->

            <article class="tip-card">

                <span class="tip-number">06</span>

                <div class="tip-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>

                <h3>
                    Focus on Growth
                </h3>

                <p>
                    Every task is an opportunity to learn something new.
                    Stay curious, accept challenges, and continuously work
                    on improving  skills throughout  internship.
                </p>

            </article>

        </div>

    </section>


    <!-- =====================================================
         SUCCESS / BLOG SECTION
         ====================================================== -->

    <section class="tips-success-section">

        <div class="tips-success-box">


            <div class="success-icon-wrap">

                <div class="success-icon">

                    <i class="fa-solid fa-graduation-cap"></i>

                </div>

            </div>


            <div class="success-content">

                <h2>
                    Turn Your Internship Into
                    a Career Opportunity
                </h2>

                <p>
                    By following these tips, you can make the most of 
                    internship experience and build a strong foundation
                    for future success. Stay curious, be proactive, learn
                    from others, and make every opportunity count.
                </p>

                <a href="#" class="success-link">

                    Explore 1Trainee Blog

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FINAL MESSAGE
         ====================================================== -->

    <section class="tips-bottom">

        <div class="tips-bottom-inner">

            <i class="fa-solid fa-star"></i>

            <h2>
                Your Growth Starts Here
            </h2>

            <p>
                Your internship is the beginning of  professional journey.
                Learn continuously, build meaningful connections, and take
                every experience as a step toward  future goals.
            </p>

        </div>

    </section>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const cards = document.querySelectorAll(".tip-card");

        if (!cards.length) {
            return;
        }

        const observer = new IntersectionObserver(
            function (entries) {

                entries.forEach(function (entry) {

                    if (entry.isIntersecting) {

                        entry.target.classList.add("show");

                        observer.unobserve(entry.target);
                    }

                });

            },
            {
                threshold: 0.12
            }
        );


        cards.forEach(function (card, index) {

            card.style.transitionDelay =
                (index * 80) + "ms";

            observer.observe(card);

        });

    });

</script>