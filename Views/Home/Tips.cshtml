@{
    ViewData["Title"] = "Essential Internship Tips";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet"
      href="~/css/Tips.css"
      asp-append-version="true" />

<div class="tips-page">
    <div class="tips-container">
        <div class="tips-layout">

            <!-- MAIN ARTICLE -->
            <main class="tips-article">

                <header class="tips-header">
                    <span class="tips-eyebrow">
                        <i class="bi bi-mortarboard-fill"></i>
                        INTERNSHIP GUIDANCE
                    </span>

                    <h1>Essential Tips for a Successful Internship</h1>

                    <p class="tips-subtitle">
                        Make the Most of Your Internship Experience
                    </p>

                    <div class="tips-title-line"></div>

                    <p class="tips-intro">
                        Starting an internship is an exciting opportunity to gain
                        practical experience, build skills, and network with
                        professionals. To ensure you get the most out of your
                        internship, here are some essential tips.
                    </p>
                </header>

                <!-- TIP 1 -->
                <section class="tips-section" id="clear-goals">
                    <div class="tips-section-heading">
                        <span class="tips-icon">
                            <i class="bi bi-bullseye"></i>
                        </span>
                        <div>
                            <span class="tips-label">TIP 01</span>
                            <h2>Set Clear Goals</h2>
                        </div>
                    </div>

                    <p>
                        Before you begin, identify what you hope to achieve.
                        Whether it’s learning a specific skill, understanding
                        industry dynamics, or building your professional network,
                        setting clear goals will help you stay focused and motivated.
                    </p>

                    <div class="tips-highlight">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>
                            Define what you want to learn and track your progress
                            throughout your internship.
                        </span>
                    </div>
                </section>

                <!-- TIP 2 -->
                <section class="tips-section" id="be-proactive">
                    <div class="tips-section-heading">
                        <span class="tips-icon">
                            <i class="bi bi-lightning-charge-fill"></i>
                        </span>
                        <div>
                            <span class="tips-label">TIP 02</span>
                            <h2>Be Proactive</h2>
                        </div>
                    </div>

                    <p>
                        Don’t wait for tasks to be assigned to you. Look for ways
                        to contribute and offer to help with projects. Showing
                        initiative demonstrates your enthusiasm and commitment
                        to your role.
                    </p>

                    <div class="tips-highlight">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>
                            Take initiative, volunteer for suitable tasks, and
                            look for opportunities to contribute to your team.
                        </span>
                    </div>
                </section>

                <!-- TIP 3 -->
                <section class="tips-section" id="seek-feedback">
                    <div class="tips-section-heading">
                        <span class="tips-icon">
                            <i class="bi bi-chat-square-text-fill"></i>
                        </span>
                        <div>
                            <span class="tips-label">TIP 03</span>
                            <h2>Seek Feedback</h2>
                        </div>
                    </div>

                    <p>
                        Regularly ask for feedback from your supervisor and
                        colleagues. Constructive feedback is a valuable tool
                        for growth and will help you improve your performance
                        and adapt to the workplace.
                    </p>

                    <div class="tips-highlight">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>
                            Listen carefully to suggestions, learn from them,
                            and apply the feedback to your next task.
                        </span>
                    </div>
                </section>

                <!-- TIP 4 -->
                <section class="tips-section" id="build-relationships">
                    <div class="tips-section-heading">
                        <span class="tips-icon">
                            <i class="bi bi-people-fill"></i>
                        </span>
                        <div>
                            <span class="tips-label">TIP 04</span>
                            <h2>Build Relationships</h2>
                        </div>
                    </div>

                    <p>
                        Take the time to connect with your colleagues and mentors.
                        Building strong professional relationships can provide
                        you with valuable insights, career advice, and future
                        opportunities.
                    </p>

                    <div class="tips-highlight">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>
                            Communicate respectfully, learn from experienced
                            professionals, and maintain meaningful connections.
                        </span>
                    </div>
                </section>

                <!-- SUMMARY -->
                <section class="tips-summary">
                    <div class="tips-summary-icon">
                        <i class="bi bi-stars"></i>
                    </div>

                    <div>
                        <span class="tips-label">YOUR NEXT STEP</span>
                        <h2>Make Every Internship Opportunity Count</h2>
                        <p>
                            Set meaningful goals, take initiative, welcome
                            constructive feedback, and build strong professional
                            relationships. These habits can help you gain valuable
                            experience and make your internship a strong foundation
                            for your future career.
                        </p>
                    </div>
                </section>

                <!-- CALL TO ACTION -->
                <section class="tips-cta">
                    <div class="tips-cta-icon">
                        <i class="bi bi-rocket-takeoff-fill"></i>
                    </div>

                    <div class="tips-cta-content">
                        <h2>Ready to Take the Next Step in Your Career?</h2>
                        <p>
                            Explore internship opportunities and put your skills
                            into practice.
                        </p>
                    </div>

                    <a href="https://www.1trainee.com/"
                       class="tips-cta-button">
                        Explore 1Trainee
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </section>

            </main>

            <!-- RIGHT SIDEBAR -->
            <aside class="tips-sidebar">

                <div class="tips-sidebar-heading">
                    <span class="tips-sidebar-heading-icon">
                        <i class="bi bi-journal-check"></i>
                    </span>
                    <div>
                        <h2>Internship Guide</h2>
                        <p>Small steps, lasting impact</p>
                    </div>
                </div>

                <!-- SIDEBAR NAVIGATION -->
                <nav class="tips-quick-nav" aria-label="Internship article sections">
                    <h3>In This Article</h3>

                    <a href="#clear-goals" aria-current="location">
                        <span class="tips-nav-number">01</span>
                        <span class="tips-nav-text">Set Clear Goals</span>
                        <i class="bi bi-arrow-up-right"></i>
                    </a>

                    <a href="#be-proactive">
                        <span class="tips-nav-number">02</span>
                        <span class="tips-nav-text">Be Proactive</span>
                        <i class="bi bi-arrow-up-right"></i>
                    </a>

                    <a href="#seek-feedback">
                        <span class="tips-nav-number">03</span>
                        <span class="tips-nav-text">Seek Feedback</span>
                        <i class="bi bi-arrow-up-right"></i>
                    </a>

                    <a href="#build-relationships">
                        <span class="tips-nav-number">04</span>
                        <span class="tips-nav-text">Build Relationships</span>
                        <i class="bi bi-arrow-up-right"></i>
                    </a>
                </nav>

                <!-- SIDEBAR TIP -->
                <div class="tips-sidebar-note">
                    <span class="tips-note-icon">
                        <i class="bi bi-lightbulb-fill"></i>
                    </span>
                    <h3>Keep Learning</h3>
                    <p>
                        Every task is an opportunity to learn something new.
                        Stay curious, ask questions, and make the most of
                        your experience.
                    </p>
                </div>

                <!-- SIDEBAR CTA -->
                <div class="tips-sidebar-cta">
                    <span class="tips-sidebar-cta-icon">
                        <i class="bi bi-briefcase-fill"></i>
                    </span>
                    <h3>Your Career Starts Here</h3>
                    <p>
                        Discover opportunities to develop your skills and
                        gain practical experience.
                    </p>
                    <a href="https://www.1trainee.com/">
                        Visit 1trainee.com
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

            </aside>
        </div>
    </div>
</div>

<script src="~/js/Tips.js" asp-append-version="true"></script>
