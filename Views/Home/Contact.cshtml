@{
	ViewData["Title"] = "Contact Us";
}

<link rel="stylesheet" href="~/css/contact.css" />

<div class="contact-page">

	<!-- HERO -->
	<section class="contact-hero">
		<div class="contact-hero-inner">

			<div class="contact-hero-tag">
				<i class="ti-email"></i>
				CONTACT US
			</div>

			<h1>Get in <span>Touch</span></h1>

			<p>
				Have a question or need assistance?
				Send us a message and our team will get back to you.
			</p>

		</div>
	</section>


	<!-- MAIN -->
	<main class="contact-wrapper">

		<section class="contact-card">

			<!-- ================= INFO PANEL ================= -->
			<aside class="contact-information">

				<div class="contact-heading">
					<span>Contact Information</span>
					<h2>We’re here to help.</h2>
					<p class="contact-info-lead">
						Reach us through any of the channels below or fill in the form.
					</p>
				</div>

				<div class="contact-info-grid">

					<!-- OFFICE -->
					<div class="contact-info-item">
						<div class="contact-info-icon"><i class="ti-location-pin"></i></div>
						<div class="contact-info-content">
							<span>Office</span>0
							<p>
								<strong>Kavin India Pvt.Ltd</strong>
								4th Floor, West Tower,<br />
								Nelson Mandela Square,<br />
								Sandton City, Johannesburg – 2157,<br />
								South Africa
							</p>
						</div>
					</div>

					<!-- EMAIL -->
					<div class="contact-info-item">
						<div class="contact-info-icon"><i class="ti-email"></i></div>
						<div class="contact-info-content">
							<span>Phone</span>
							<a href="tel:+27111002598">+0027-11-1002598 (SA)</a>
							<a href="tel:+919309117317">+91-93091-17317 (IN)</a>

						</div>
					</div>

					<!-- PHONE -->
					<div class="contact-info-item">
						<div class="contact-info-icon"><i class="ti-mobile"></i></div>
						<div class="contact-info-content">
							<span>Email</span>
							<a href="mailto:contact@kavin.com">contact@kavin.com</a>
						</div>
					</div>

					<!-- FAX -->
					<div class="contact-info-item">
						<div class="contact-info-icon"><i class="ti-printer"></i></div>
						<div class="contact-info-content">
							<span>Fax</span>
							<p>+086-6880750</p>
						</div>
					</div>

				</div>

			</aside>


			<!-- ================= FORM ================= -->
			<div class="contact-form-section">

				<div class="contact-heading">
					<span>Send Message</span>
					<h2>How can we help?</h2>
				</div>

				<form id="contactForm"
					  method="post"
					  asp-controller="Home"
					  asp-action="ContactUs"
					  novalidate>

					@Html.AntiForgeryToken()

					<div class="contact-form-grid">

						<!-- FULL NAME -->
						<div class="contact-field">
							<label for="FullName">Full Name</label>
							<div class="contact-input">
								<i class="ti-user"></i>
								<input type="text"
									   id="FullName"
									   name="FullName"
									   placeholder="Enter your full name"
									   maxlength="50"
									   autocomplete="name"
									   required />
							</div>
							<span id="fullNameError" class="contact-error"></span>
						</div>

						<!-- EMAIL -->
						<div class="contact-field">
							<label for="Email">Email Address</label>
							<div class="contact-input">
								<i class="ti-email"></i>
								<input type="email"
									   id="Email"
									   name="Email"
									   placeholder="Enter your email"
									   maxlength="100"
									   autocomplete="email"
									   required />
							</div>
							<span id="emailError" class="contact-error"></span>
						</div>

						<!-- PHONE -->
						<div class="contact-field">
							<label for="MobileNo">Phone Number</label>
							<div class="contact-input">
								<i class="ti-mobile"></i>
								<input type="tel"
									   id="MobileNo"
									   name="MobileNo"
									   placeholder="Enter phone number"
									   maxlength="20"
									   inputmode="numeric"
									   autocomplete="tel" />
							</div>
							<span id="mobileError" class="contact-error"></span>
						</div>

						<!-- SUBJECT -->
						<div class="contact-field">
							<label for="Subject">Subject</label>
							<div class="contact-input">
								<i class="ti-bookmark"></i>
								<input type="text"
									   id="Subject"
									   name="Subject"
									   placeholder="Enter subject"
									   maxlength="50"
									   required />
							</div>
							<span id="subjectError" class="contact-error"></span>
						</div>

						<!-- MESSAGE -->
						<div class="contact-field contact-field-full">
							<div class="contact-message-header">
								<label for="Description">Message</label>
								<span id="messageCounter">0 / 200</span>
							</div>
							<div class="contact-textarea">
								<i class="ti-comment-alt"></i>
								<textarea id="Description"
										  name="Description"
										  placeholder="Write your message..."
										  maxlength="200"
										  required></textarea>
							</div>
							<span id="descriptionError" class="contact-error"></span>
						</div>

					</div>

					<!-- FOOTER -->
					<div class="contact-form-footer">

						<span class="contact-form-note">
							<i class="ti-lock"></i>
							Your information is secure.
						</span>

						<button type="submit" class="contact-submit">
							Send Message
							<i class="ti-arrow-right"></i>
						</button>

					</div>

				</form>

			</div>

		</section>

	</main>

</div>


<script>
	document.addEventListener("DOMContentLoaded", function () {

		const form = document.getElementById("contactForm");
		const fullName = document.getElementById("FullName");
		const email = document.getElementById("Email");
		const mobile = document.getElementById("MobileNo");
		const subject = document.getElementById("Subject");
		const description = document.getElementById("Description");

		const fullNameError = document.getElementById("fullNameError");
		const emailError = document.getElementById("emailError");
		const mobileError = document.getElementById("mobileError");
		const subjectError = document.getElementById("subjectError");
		const descriptionError = document.getElementById("descriptionError");
		const messageCounter = document.getElementById("messageCounter");

		const emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;


		/* NAME */
		fullName.addEventListener("input", function () {
			let value = this.value
				.replace(/^\s+/, "")
				.replace(/[^a-zA-Z ]/g, "")
				.replace(/\s{2,}/g, " ");

			if (value.length > 50) value = value.substring(0, 50);

			this.value = value;
			fullNameError.textContent = "";
		});


		/* EMAIL */
		email.addEventListener("input", function () {
			this.value = this.value.toLowerCase().replace(/^\s+/, "");

			if (this.value === "") {
				emailError.textContent = "Email is required.";
			}
			else if (!emailPattern.test(this.value)) {
				emailError.textContent = "Please enter a valid email.";
			}
			else {
				emailError.textContent = "";
			}
		});


		/* MOBILE */
		mobile.addEventListener("input", function () {
			this.value = this.value.replace(/\D/g, "");

			if (this.value.length > 20) this.value = this.value.substring(0, 20);

			if (this.value !== "" && (this.value.length < 6 || this.value.length > 20)) {
				mobileError.textContent = "Phone number must contain 6 to 20 digits.";
			}
			else {
				mobileError.textContent = "";
			}
		});


		/* SUBJECT */
		subject.addEventListener("input", function () {
			let value = this.value
				.replace(/^\s+/, "")
				.replace(/\s{2,}/g, " ");

			if (value.length > 50) value = value.substring(0, 50);

			if (value.length > 0) {
				value = value.charAt(0).toUpperCase() + value.slice(1);
			}

			this.value = value;
			subjectError.textContent = "";
		});


		/* MESSAGE */
		description.addEventListener("input", function () {
			let value = this.value.replace(/^\s+/, "");

			if (value.length > 200) value = value.substring(0, 200);

			this.value = value;
			messageCounter.textContent = value.length + " / 200";

			if (value.length > 0 && value.length < 15) {
				descriptionError.textContent = "Message must be at least 15 characters.";
			}
			else {
				descriptionError.textContent = "";
			}
		});


		/* SUBMIT */
		form.addEventListener("submit", function (event) {

			let valid = true;

			const nameValue = fullName.value.trim();

			if (nameValue === "") {
				fullNameError.textContent = "Full Name is required.";
				valid = false;
			}
			else if (nameValue.length < 2) {
				fullNameError.textContent = "Please enter a valid name.";
				valid = false;
			}

			const emailValue = email.value.trim();

			if (emailValue === "") {
				emailError.textContent = "Email is required.";
				valid = false;
			}
			else if (!emailPattern.test(emailValue)) {
				emailError.textContent = "Please enter a valid email.";
				valid = false;
			}

			const mobileValue = mobile.value.trim();

			if (mobileValue !== "" && (mobileValue.length < 6 || mobileValue.length > 20)) {
				mobileError.textContent = "Phone number must contain 6 to 20 digits.";
				valid = false;
			}

			if (subject.value.trim() === "") {
				subjectError.textContent = "Subject is required.";
				valid = false;
			}

			const messageValue = description.value.trim();

			if (messageValue === "") {
				descriptionError.textContent = "Message is required.";
				valid = false;
			}
			else if (messageValue.length < 15) {
				descriptionError.textContent = "Message must be at least 15 characters.";
				valid = false;
			}

			if (!valid) {
				event.preventDefault();

				const firstError = form.querySelector(".contact-error:not(:empty)");
				if (firstError) {
					firstError.scrollIntoView({ behavior: "smooth", block: "center" });
				}

				return false;
			}

			const button = form.querySelector("button[type='submit']");

			if (button) {
				button.disabled = true;
				button.innerHTML = "Sending...";
			}

		});

	});
</script>
