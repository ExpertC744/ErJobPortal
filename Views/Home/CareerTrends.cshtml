@{
    ViewData["Title"] = "Career Trends";

    var careerSlots = new[]
    {
        (Src: (string)null, Alt: "Best Internship Solution", Title: "Best Internship Solution", Text: "Gain hands-on experience and build professional skills with top internships."),
        (Src: (string)null, Alt: "Free Job Portal", Title: "Free Job Portal", Text: "Explore open roles and connect directly with hiring companies."),
        (Src: (string)null, Alt: "Professional Growth", Title: "Professional Growth", Text: "Stay ahead in your career with expert advice and market insights.")
    };
}

<link rel="stylesheet" href="~/css/career-trends.css" />

<div class="career-trends-page">

    <!-- Scroll progress -->
    <div class="career-trends-progress" id="careerTrendsProgress"></div>

    <!-- Hero -->
    <section class="career-trends-hero">
        <span class="career-trends-shape career-trends-shape-1"></span>
        <span class="career-trends-shape career-trends-shape-2"></span>

        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 text-center text-md-start">
                    <span class="career-trends-small-title">Career Guidance</span>
                    <h1 class="career-trends-title">Career Trends</h1>
                    <div class="career-trends-title-line"></div>
                    <p class="career-trends-subtitle">
                        Stay informed about evolving job market dynamics and position yourself for long-term professional success.
                    </p>
                </div>

                <div class="col-md-5 text-center text-md-end mt-4 mt-md-0">
                    <nav class="career-trends-breadcrumb" aria-label="Breadcrumb">
                        <a class="career-trends-btn" href="~/Home/Index">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <span class="career-trends-arrow"><i class="fas fa-angle-double-right"></i></span>
                        <span class="career-trends-current-page">Career Trends</span>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="career-trends-content">
        <div class="container">
            <div class="row g-4">

                <!-- LEFT CONTENT -->
                <div class="col-lg-8">

                    <!-- Intro -->
                    <div class="career-trends-section career-trends-intro">
                        <h2 class="career-trends-heading">Navigating the Future of Work</h2>
                        <p>
                            In today's rapidly evolving job market, staying informed about career trends is essential for choosing a successful and fulfilling professional journey. As you embark on your internship search, understanding these trends can help you make informed decisions and position yourself for future success. 1trainee.com suggests looking at some of the key career trends influencing the workforce today:
                        </p>
                    </div>

                    <!-- 1 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">1</span>The Rise of Remote Work</h3>
                        <p>
                            Remote work has transitioned from a temporary solution to a long-term norm for many industries. Companies are increasingly offering flexible work arrangements, and remote internships are becoming more common. Embracing opportunities to develop skills like clear written communication and self-reliance, as there will be reliable access in a remote or hybrid work environment.
                        </p>
                    </div>

                    <!-- 2 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">2</span>Emphasis on Digital Skills</h3>
                        <p>
                            In a world driven by technology, digital literacy is more important than ever. Internships that allow you to gain experience with data analytics, coding, and digital marketing can significantly enhance your employability. Familiarize yourself with trending technologies and platforms relevant to your chosen field of the future.
                        </p>
                    </div>

                    <!-- 3 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">3</span>The Growth of Interdisciplinary Roles</h3>
                        <p>
                            The boundaries between traditional job roles are blurring. Employers are seeking candidates who can blend skills from different disciplines to tackle complex challenges. Consider internships that allow you to work on projects across various sectors that combine technical and soft skills to broaden your expertise and adaptability.
                        </p>
                    </div>

                    <!-- 4 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">4</span>Increased Focus on Soft Skills</h3>
                        <p>
                            While technical skills are crucial, soft skills such as communication, teamwork, and problem-solving are increasingly valued by employers. Seek internships that provide opportunities to develop and demonstrate these interpersonal skills. Effective soft skills can set you apart and contribute significantly to your overall career success.
                        </p>
                    </div>

                    <!-- 5 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">5</span>The Importance of Networking</h3>
                        <p>
                            Building a professional network is essential for career advancement. Internships offer valuable opportunities to connect with industry professionals, mentors, and peers. Actively engage in networking activities during your internship, and leverage these connections for future career growth and opportunities.
                        </p>
                    </div>

                    <!-- 6 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">6</span>Growing Interest in Sustainability and Social Impact</h3>
                        <p>
                            Many organizations are prioritizing sustainability and social responsibility in their operations. Internships in companies that focus on environmental and social initiatives can provide you with insights into these important areas and align your career with your values.
                        </p>
                    </div>

                    <!-- 7 -->
                    <div class="career-trends-section scroll-reveal">
                        <h3 class="career-trends-heading"><span class="career-trends-number">7</span>The Demand for Lifelong Learning</h3>
                        <p>
                            Continuous learning and professional development are critical in a fast-changing job market. Look for internships that offer training, mentorship, or projects that challenge you to learn and grow. Developing a mindset of lifelong learning will help you adapt to new trends and technology rather than ignore your career.
                        </p>
                    </div>

                    <!-- Conclusion -->
                    <div class="career-trends-important-box scroll-reveal">
                        <div class="career-trends-important-content">
                            <h2>Conclusion</h2>
                            <p>
                                Staying ahead of career trends can significantly influence your path and opportunities in the professional world. As you explore internship-like project or fellowship options, consider how these trends align with your career goals and personal interests. By understanding and embracing these trends, you can make strategic decisions that enhance your skills, expand your reach, and prepare you for a successful future.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT SIDEBAR -->
                <aside class="col-lg-4">
                    <div class="career-trends-sticky">
                        @foreach (var slot in careerSlots)
                        {
                            <div class="career-trends-side-item scroll-right">
                                <div class="career-trends-image-box @(string.IsNullOrEmpty(slot.Src) ? "no-image" : "")">
                                    @if (!string.IsNullOrEmpty(slot.Src))
                                    {
                                        <img src="@Url.Content(slot.Src)" alt="@slot.Alt" loading="lazy" />
                                    }
                                    <div class="career-trends-placeholder">
                                        <i class="far fa-image"></i>
                                        <span class="career-trends-placeholder-title">Image Space</span>
                                        <span class="career-trends-placeholder-note">Image will appear here</span>
                                    </div>
                                </div>

                                <div class="career-trends-side-text">
                                    <h2>@slot.Title</h2>
                                    <p>@slot.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </aside>

            </div>
        </div>
    </section>

    <!-- Back to top -->
    <a href="#" class="career-trends-back-to-top" aria-label="Back to top">
        <i class="fa fa-angle-double-up"></i>
    </a>
</div>

