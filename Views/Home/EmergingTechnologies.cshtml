@{
    ViewData["Title"] = "Emerging Technologies";

    // Sidebar image slots: set Src to e.g. "~/img/your-image.jpg" when ready (null = placeholder)
    var emergingSlots = new[]
    {
        (Src: (string)null, Alt: "Latest Technology", Title: "Latest Technology",
         Text: "Follow technology news, research and innovation from trusted sources."),
        (Src: (string)null, Alt: "Learn and Upskill", Title: "Learn & Upskill",
         Text: "Build new skills with online courses, webinars and virtual conferences."),
        (Src: (string)null, Alt: "Stay Updated", Title: "Stay Updated",
         Text: "Engage regularly with these resources to stay informed about emerging technologies.")
    };
}

<link rel="stylesheet" href="~/css/emerging-technologies.css" />

<div class="emerging-tech-page">

    <!-- Scroll progress -->
    <div class="emerging-tech-progress" id="emergingProgress"></div>

    <!-- Hero -->
    <section class="emerging-tech-hero">
        <span class="emerging-tech-shape emerging-tech-shape-1"></span>
        <span class="emerging-tech-shape emerging-tech-shape-2"></span>

        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 text-center text-md-start text-md-left">
                    <span class="emerging-tech-small-title">Technology Updates</span>
                    <h1 class="emerging-tech-title">Emerging Technologies</h1>
                    <div class="emerging-tech-title-line"></div>
                    <p class="emerging-tech-subtitle">
                        Discover trusted platforms, communities and learning resources to keep up with the latest technology trends and innovations.
                    </p>
                </div>

                <div class="col-md-5 text-center text-md-end text-md-right mt-4 mt-md-0">
                    <nav class="emerging-tech-breadcrumb" aria-label="Breadcrumb">
                        <a class="emerging-tech-btn" href="~/Home/Index">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <span class="emerging-tech-arrow"><i class="fas fa-angle-double-right"></i></span>
                        <span class="emerging-tech-current-page">Emerging Technologies</span>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="emerging-tech-content">
        <div class="container">
            <div class="row g-4">

                <!-- LEFT CONTENT -->
                <div class="col-lg-8">

                    <!-- Intro -->
                    <div class="emerging-tech-section emerging-tech-intro">
                        <h2 class="emerging-tech-heading">Stay Updated on Emerging Technologies</h2>
                        <p>
                            To stay updated on emerging technologies, 1trainee.com suggests you can explore a variety of online resources and platforms. Here are some options to consider:
                        </p>
                    </div>

                    <!-- 1 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">1</span>Tech News Websites and Blogs</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>TechCrunch:</b> Covers the latest in technology startups, gadgets, and industry news.</li>
                            <li><b>Wired:</b> Offers in-depth articles on technology trends and innovations.</li>
                            <li><b>Ars Technica:</b> Provides detailed coverage on technology and science.</li>
                        </ul>
                    </div>

                    <!-- 2 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">2</span>Industry Reports and Market Research</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Gartner:</b> Offers research reports and insights on emerging technologies and IT trends.</li>
                            <li><b>Forrester:</b> Provides market research and analysis on technology trends and their impact.</li>
                        </ul>
                    </div>

                    <!-- 3 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">3</span>Technology Forums and Communities</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Reddit:</b> Subreddits like r/technology, r/Futurology, and r/programming often discuss emerging tech trends.</li>
                            <li><b>Hacker News:</b> A community where tech enthusiasts and professionals share news and articles about the latest technology.</li>
                        </ul>
                    </div>

                    <!-- 4 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">4</span>Online Courses and Webinars</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Coursera and Udemy:</b> Platforms offering courses on cutting-edge technologies and industry trends.</li>
                            <li><b>Webinars and Virtual Conferences:</b> Look for industry-specific webinars and online events hosted by tech companies or industry groups.</li>
                        </ul>
                    </div>

                    <!-- 5 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">5</span>Social Media and Professional Networks</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>LinkedIn:</b> Follow technology influencers, companies, and groups to get updates on emerging technologies.</li>
                            <li><b>Twitter:</b> Follow tech leaders and organizations for real-time updates and discussions.</li>
                        </ul>
                    </div>

                    <!-- 6 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">6</span>Technology News Aggregators</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Techmeme:</b> Aggregates the latest tech news from various sources.</li>
                            <li><b>Flipboard:</b> Customize your feed to include topics on emerging technologies.</li>
                        </ul>
                    </div>

                    <!-- 7 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">7</span>Academic and Research Journals</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Google Scholar:</b> Search for recent papers and research on new technologies.</li>
                            <li><b>IEEE Xplore:</b> Access research papers and articles on cutting-edge technology.</li>
                        </ul>
                    </div>

                    <!-- 8 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">8</span>Podcasts and YouTube Channels</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Tech Podcasts:</b> Shows like "The Vergecast," "Reply All," and "StartUp" offer discussions on technology trends.</li>
                            <li><b>YouTube Channels:</b> Channels like "Marques Brownlee" and "Linus Tech Tips" provide reviews and insights on the latest tech.</li>
                        </ul>
                    </div>

                    <!-- 9 -->
                    <div class="emerging-tech-section scroll-reveal">
                        <h3 class="emerging-tech-heading"><span class="emerging-tech-number">9</span>Innovation Hubs and Technology Accelerators</h3>
                        <ul class="emerging-tech-list" data-stagger>
                            <li><b>Y Combinator:</b> Follow the latest startups and technologies coming out of one of the top accelerators.</li>
                            <li><b>Techstars:</b> Provides insights into new technologies and innovative startups.</li>
                        </ul>
                    </div>

                    <!-- Closing -->
                    <div class="emerging-tech-important-box scroll-reveal">
                        <div class="emerging-tech-important-content">
                            <h2>Keep Learning, Keep Growing</h2>
                            <p>
                                By regularly engaging with these resources, you can stay informed about emerging technologies.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT SIDEBAR -->
                <aside class="col-lg-4">
                    <div class="emerging-tech-sticky">
                        @foreach (var slot in emergingSlots)
                        {
                            <div class="emerging-tech-side-item scroll-right">
                                <div class="emerging-tech-image-box @(string.IsNullOrEmpty(slot.Src) ? "no-image" : "")">
                                    @if (!string.IsNullOrEmpty(slot.Src))
                                    {
                                        <img src="@Url.Content(slot.Src)"
                                             alt="@slot.Alt"
                                             loading="lazy"
                                             onerror="this.closest('.emerging-tech-image-box').classList.add('no-image');" />
                                    }
                                    <div class="emerging-tech-placeholder">
                                        <i class="far fa-image"></i>
                                        <span class="emerging-tech-placeholder-title">Image Space</span>
                                        <span class="emerging-tech-placeholder-note">Image will appear here</span>
                                    </div>
                                </div>

                                <div class="emerging-tech-side-text">
                                    <h2>@slot.Title</h2>
                                    <p>@slot.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </aside>

            </div>
        </div>
    </section>

    <!-- Back to top -->
    <a href="#" class="emerging-tech-back-to-top" aria-label="Back to top">
        <i class="fa fa-angle-double-up"></i>
    </a>
</div>

