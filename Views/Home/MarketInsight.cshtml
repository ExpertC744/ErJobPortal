@{
    ViewData["Title"] = "Market Insights";

    // Sidebar image slots: set Src to e.g. "~/img/your-image.jpg" when ready (null = placeholder)
    var slots = new[]
    {
        (Src: (string)null, Alt: "Market Intelligence", Title: "Market Intelligence",
         Text: "Stay informed with industry reports, trend analysis and expert insights."),
        (Src: (string)null, Alt: "Stay Ahead", Title: "Stay Ahead",
         Text: "Use market knowledge to plan your career path with confidence.")
    };
}

<link rel="stylesheet" href="~/css/market-insight.css" />

<div class="market-insight-page">

    <!-- Scroll progress -->
    <div class="market-insight-progress" id="marketProgress"></div>

    <!-- Hero -->
    <section class="market-insight-hero">
        <span class="market-insight-shape market-insight-shape-1"></span>
        <span class="market-insight-shape market-insight-shape-2"></span>

        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-7 text-center text-md-start text-md-left">
                    <span class="market-insight-small-title">Career Intelligence</span>
                    <h1 class="market-insight-title">Market Insights</h1>
                    <div class="market-insight-title-line"></div>
                    <p class="market-insight-subtitle">
                        Understand industry trends, emerging opportunities and expert perspectives to make confident career decisions.
                    </p>
                </div>

                <div class="col-md-5 text-center text-md-end text-md-right mt-4 mt-md-0">
                    <nav class="market-insight-breadcrumb" aria-label="Breadcrumb">
                        <a class="market-insight-btn" href="~/Home/Index">
                            <i class="fas fa-home"></i>
                            <span>Home</span>
                        </a>
                        <span class="market-insight-arrow"><i class="fas fa-angle-double-right"></i></span>
                        <span class="market-insight-current-page">Market Insights</span>
                    </nav>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <section class="market-insight-content">
        <div class="container">
            <div class="row g-4">

                <!-- LEFT CONTENT -->
                <div class="col-lg-8">

                    <!-- Intro -->
                    <div class="market-insight-section market-insight-intro">
                        <h2 class="market-insight-heading">Uncover Industry Trends</h2>
                        <p>
                            Dive deep into comprehensive analyses and detailed reports on the latest trends shaping your industry. 1trainee.com’s Market Insights section offers valuable intelligence to help you stay ahead of the curve, make informed decisions, and discover emerging opportunities. Whether you’re seeking to understand market dynamics or gain a competitive edge, our expert insights provide the information you need to navigate your career path with confidence.
                        </p>
                        <p>
                            Explore comprehensive Market Insights to gain a deeper understanding of the trends and forces shaping your industry. Create in-depth analyses and reports which will design to provide you with actionable intelligence, helping you make informed decisions and seize emerging opportunities.
                        </p>
                    </div>

                    <!-- Get -->
                    <div class="market-insight-section scroll-reveal">
                        <h3 class="market-insight-heading"><span class="market-insight-icon"><i class="fas fa-layer-group"></i></span>Get</h3>

                        <div class="market-insight-tiles" data-stagger>
                            <div class="market-insight-tile">
                                <span class="market-insight-tile-icon"><i class="fas fa-file-alt"></i></span>
                                <div>
                                    <h4>Detailed Industry Reports</h4>
                                    <p>Access thorough reports that cover market dynamics, competitive landscapes, and growth forecasts.</p>
                                </div>
                            </div>

                            <div class="market-insight-tile">
                                <span class="market-insight-tile-icon"><i class="fas fa-chart-line"></i></span>
                                <div>
                                    <h4>Trend Analysis</h4>
                                    <p>Stay updated with the latest trends influencing your field, from technological advancements to shifts in consumer behavior.</p>
                                </div>
                            </div>

                            <div class="market-insight-tile">
                                <span class="market-insight-tile-icon"><i class="fas fa-user-tie"></i></span>
                                <div>
                                    <h4>Expert Opinions</h4>
                                    <p>Read insights from industry leaders and analysts who offer their perspectives on future developments and strategic moves.</p>
                                </div>
                            </div>

                            <div class="market-insight-tile">
                                <span class="market-insight-tile-icon"><i class="fas fa-chart-pie"></i></span>
                                <div>
                                    <h4>Data-Driven Insights</h4>
                                    <p>Utilize data visualizations and analytics to grasp complex industry changes and their implications.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Why It Matters -->
                    <div class="market-insight-section scroll-reveal">
                        <h3 class="market-insight-heading"><span class="market-insight-icon"><i class="fas fa-lightbulb"></i></span>Why It Matters</h3>
                        <p class="market-insight-lead">Understanding market trends can help you:</p>

                        <ul class="market-insight-list market-insight-check-list" data-stagger>
                            <li>Identify new career opportunities and industries on the rise.</li>
                            <li>Make strategic decisions based on current and projected market conditions.</li>
                            <li>Position yourself as a knowledgeable candidate with a forward-thinking approach.</li>
                        </ul>
                    </div>

                    <!-- Explore More -->
                    <div class="market-insight-section scroll-reveal">
                        <h3 class="market-insight-heading"><span class="market-insight-icon"><i class="fas fa-compass"></i></span>Explore More</h3>

                        <ul class="market-insight-list" data-stagger>
                            <li><b>Industry Reports:</b> Access detailed reports tailored to various sectors.</li>
                            <li><b>Trend Analysis Articles:</b> Read the latest articles on emerging trends and their impact.</li>
                            <li><b>Expert Interviews:</b> Gain insights from thought leaders and industry experts.</li>
                            <li><b>Data Visualizations:</b> Utilize interactive charts and graphs to understand market shifts.</li>
                        </ul>
                    </div>

                    <!-- Closing -->
                    <div class="market-insight-important-box scroll-reveal">
                        <div class="market-insight-important-content">
                            <h2>Stay Ahead in Your Career Journey</h2>
                            <p>
                                Stay ahead in your career journey by leveraging these insights to navigate your professional path with confidence and strategic foresight.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- RIGHT SIDEBAR -->
                <aside class="col-lg-4">
                    <div class="market-insight-sticky">
                        @foreach (var slot in slots)
                        {
                            <div class="market-insight-side-item scroll-right">
                                <div class="market-insight-image-box @(string.IsNullOrEmpty(slot.Src) ? "no-image" : "")">
                                    @if (!string.IsNullOrEmpty(slot.Src))
                                    {
                                        <img src="@Url.Content(slot.Src)"
                                             alt="@slot.Alt"
                                             loading="lazy"
                                             onerror="this.closest('.market-insight-image-box').classList.add('no-image');" />
                                    }
                                    <div class="market-insight-placeholder">
                                        <i class="far fa-image"></i>
                                        <span class="market-insight-placeholder-title">Image Space</span>
                                        <span class="market-insight-placeholder-note">Image will appear here</span>
                                    </div>
                                </div>

                                <div class="market-insight-side-text">
                                    <h2>@slot.Title</h2>
                                    <p>@slot.Text</p>
                                </div>
                            </div>
                        }
                    </div>
                </aside>

            </div>
        </div>
    </section>

    <!-- Back to top -->
    <a href="#" class="market-insight-back-to-top" aria-label="Back to top">
        <i class="fa fa-angle-double-up"></i>
    </a>
</div>
