<!-- START PLATFORM STATS -->
<section class="platform-dashboard reveal" data-reveal="up" aria-label="Platform statistics">
	<div class="platform-stats">
		@for (int i = 0; i < platformStats.Length; i++)
		{
			var stat = platformStats[i];

			<div class="platform-stat reveal" data-reveal="up" style="--d:@((0.12 * i).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))s">
				<div class="platform-stat-card @stat.Item1">
					<div class="platform-stat-icon" aria-hidden="true"><i class="fas @stat.Item2"></i></div>
					<div class="platform-stat-label">@stat.Item3</div>
					<div class="platform-stat-value counter" data-target="@stat.Item4">0</div>
					<div class="platform-stat-progress"><span></span></div>
				</div>
			</div>
		}
	</div>
</section>
<!-- END PLATFORM STATS -->

<script src="~/js/home.js" asp-append-version="true" defer></script>
