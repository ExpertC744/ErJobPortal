@model List<ErJobPortal.Models.HomeTraineeCardM>

@{
	ViewData["Title"] = "Home";
	ViewData["BodyClass"] = "home-page";

	var feedbacks = ViewBag.Feedbacks as List<HomeFeedbackCardM> ?? new List<HomeFeedbackCardM>();
	bool hasTrainees = Model != null && Model.Any();

	int traineeCount = Convert.ToInt32(ViewBag.TraineeCount ?? 0);
	int organizationCount = Convert.ToInt32(ViewBag.OrganizationCount ?? 0);
	int postCount = Convert.ToInt32(ViewBag.PostCount ?? 0);
	int stateCount = Convert.ToInt32(ViewBag.StateCount ?? 0);
	int countryCount = Convert.ToInt32(ViewBag.CountryCount ?? 0);

	// Hero slides (data-driven so the markup is written once)
	// Set CtaUrl to your registration / apply route.
	var slides = new[]
	{
		new {
			Image = "background.jpg", Alt = "Interns working together at a desk",
			Title = "Discover Your Next Big Opportunity with 1 Trainee.com!",
			Text = "Are you ready to take the next step in your career journey? 1trainee.com is here to connect you with exciting internships that match your skills, interests, and career goals.",
			Cta = "Apply now", CtaUrl = "#"
		},
		new {
			Image = "background2.jpg", Alt = "Colleagues discussing at a laptop",
			Title = "Not sure where to start?",
			Text = "1trainee.com offers helpful resources such as resume tips, interview advice, and networking opportunities to help you secure your dream internship.",
			Cta = (string)null, CtaUrl = (string)null
		},
		new {
			Image = "background3.jpg", Alt = "Company recruiter reviewing candidates",
			Title = "Company Recruiter",
			Text = "1trainee.com is the perfect platform to find the next generation of innovators and leaders who are eager to contribute & learn. Recruiters (Org) can connect with the brightest, most driven students & recent graduates.",
			Cta = (string)null, CtaUrl = (string)null
		}
	};

	var categories = new[]
	{
		("e1.png", "Digital Marketing"), ("e2.png", "UI/UX Design"), ("e3.png", "3D Visual Design"),
		("e4.png", "Content Marketing"), ("e5.png", "Photography"), ("e6.png", "Photo Lifestyle"),
		("e7.png", "Art & Design"), ("e8.png", "Finance & Banking"), ("e9.png", "Graphic Design"),
		("e2.png", "Interior Design"), ("e3.png", "3D Visual Design"), ("e7.png", "Art & Design")
	};

	var partnerLogos = new[] { "1", "2", "3", "4", "5", "2", "1", "3", "4" };

	var steps = new[]
	{
		("01", "sc_one", "Expert <br />Teacher"),
		("02", "sc_two", "Quality <br />Education"),
		("03", "sc_three", "Remote <br />Learning"),
		("04", "sc_four", "Life Time <br />Support")
	};

	var platformStats = new[]
	{
		("platform-orange", "fa-venus-mars", "Trainees", traineeCount),
		("platform-green", "fa-building", "Organizations", organizationCount),
		("platform-blue", "fa-briefcase", "No. Of Posts", postCount),
		("platform-purple", "fa-map-marker-alt", "States", stateCount),
		("platform-pink", "fa-plane", "Countries", countryCount)
	};
}

<link rel="stylesheet" href="~/css/home-modern.css" asp-append-version="true" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;700&family=Oswald:wght@500;600&display=swap" />

<!-- START PRELOADER -->
<div class="preloaders">
	<div class="trainee-loader">
		<div class="trainee-orbit orbit-one"></div>
		<div class="trainee-orbit orbit-two"></div>

		<!-- CENTER BRAND NAME -->
		<div class="trainee-core"><span>1Trainee</span></div>

		<div class="trainee-dot dot-one"></div>
		<div class="trainee-dot dot-two"></div>
		<div class="trainee-dot dot-three"></div>
		<div class="trainee-dot dot-four"></div>
	</div>
</div>
<!-- END PRELOADER -->
<!-- START HOME -->
<section class="modern-hero-slider" id="home" aria-roledescription="carousel" aria-label="Featured highlights">

	<div class="hero-slides">
		@for (int s = 0; s < slides.Length; s++)
		{
			var slide = slides[s];

			<div class="hero-slide@(s == 0 ? " active" : "")" aria-hidden="@(s == 0 ? "false" : "true")">

				<div class="hero-slide-image">
					<img src="~/images/@slide.Image"
						 alt="@slide.Alt"
						 loading="@(s == 0 ? "eager" : "lazy")" fetchpriority="@(s == 0 ? "high" : "auto")"
						 decoding="async" />
				</div>

				<div class="hero-overlay"></div>

				<div class="hero-content-wrap">
					<div class="container">
						<div class="hero-content">
							<div class="hero-card">

								@if (s == 0)
								{
									<h1 class="hero-title">@slide.Title</h1>
								}
								else
								{
									<h2 class="hero-title">@slide.Title</h2>
								}

								<p>@slide.Text</p>

								@if (!string.IsNullOrEmpty(slide.Cta))
								{
									<a class="hero-cta" href="@slide.CtaUrl">
										@slide.Cta
										<i class="fa fa-arrow-right" aria-hidden="true"></i>
									</a>
								}

							</div>
						</div>
					</div>
				</div>
			</div>
		}
	</div>

	<!-- SLIDER CONTROLS -->
	<button class="hero-arrow hero-prev" type="button" aria-label="Previous slide">
		<i class="fa fa-angle-left" aria-hidden="true"></i>
	</button>
	<button class="hero-arrow hero-next" type="button" aria-label="Next slide">
		<i class="fa fa-angle-right" aria-hidden="true"></i>
	</button>

	<!-- DOTS -->
	<div class="hero-dots">
		@for (int d = 0; d < slides.Length; d++)
		{
			<button class="hero-dot@(d == 0 ? " active" : "")" type="button" data-slide="@d" aria-label="Go to slide @(d + 1)">
				<span></span>
			</button>
		}
	</div>

	<!-- SLIDE NUMBER -->
	<div class="hero-counter" aria-hidden="true">
		<span class="hero-current">01</span>
		<div class="hero-counter-line"></div>
		<span>@slides.Length.ToString("00")</span>
	</div>
</section>
<!-- END HOME -->
<!-- START COUNTER -->
