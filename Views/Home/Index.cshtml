	<div class="container">
		<div class="modern-about-wrapper">

			<!-- LEFT EXPERIENCE PANEL -->
			<div class="experience-panel reveal" data-reveal="left">
				<div class="experience-icon" aria-hidden="true"><i class="ti-medall-alt"></i></div>
				<h2>18<sup>+</sup></h2>
				<h3>Years Experience</h3>
			</div>

			<!-- RIGHT CONTENT -->
			<div class="about-content">

				<span class="about-label reveal" data-reveal="up">LEARN ABOUT US</span>

				<p class="about-description reveal" data-reveal="up" style="--d:.1s">
					www.1trainee.com is designed to bridge the gap between
					internship seekers and organizations, fostering a more
					efficient, user-friendly experience for both parties.
					By addressing the unique needs of each user group, we aim
					to create a more dynamic and effective internship
					ecosystem. We are committed to supporting your career
					growth and organizational goals through this innovative
					platform.
				</p>

				<!-- FEATURES -->
				<div class="about-features">
					<div class="about-feature reveal" data-reveal="up" style="--d:.2s">
						<span class="feature-icon"><i class="ti-home" aria-hidden="true"></i></span>
						<h4>Internship Seekers</h4>
					</div>

					<div class="about-feature reveal" data-reveal="up" style="--d:.3s">
						<span class="feature-icon"><i class="ti-briefcase" aria-hidden="true"></i></span>
						<h4>Org / Companies</h4>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- END COUNTER -->
<!-- START CATEGORY (journey) -->
<section class="top_cat__area section-padding section-bg-shape">
	<div class="container">
		<div class="section-title text-center reveal" data-reveal="up">
			<h2>Start  journey With us</h2>
			<p>We offer a brand new approach to the most basic learning paradigms. Choose from a wide range of learning options and gain new skills! Our school is know.</p>
		</div>
		<div class="row">
			@for (int i = 0; i < steps.Length; i++)
			{
				<div class="col-lg-3 col-sm-6 col-xs-12 reveal" data-reveal="up" style="--d:@((0.1 * (i + 1)).ToString("0.0", System.Globalization.CultureInfo.InvariantCulture))s">
					<div class="single_tp">
						<span class="@steps[i].Item2">@steps[i].Item1</span>
						<h3>@Html.Raw(steps[i].Item3)</h3>
						<p>Lorem ipsum dolor sit amet, consectetur notted adipisicing elit ut labore.</p>
					</div>
				</div>

				<!-- END COL -->
			}
		</div><!-- END ROW -->
	</div><!-- END CONTAINER -->
</section>
<!-- END CATEGORY -->
<!-- START ABOUT US -->
<section class="ab_area section-padding trainee-about">
	<div class="container">
		<div class="row align-items-center">

			<!-- LEFT CONTENT -->
			<div class="col-lg-7 col-md-7 col-sm-12 reveal" data-reveal="left">
				<div class="ab_content">

					<span class="about-kicker">TRANSFORMATION</span>

					<h2 class="about-title">
						<span class="title-line" aria-hidden="true"></span>
						Trainee
					</h2>

					<p>
						At 1trainee.com, Trainees (Interns / Research Fellows)
						play an important role with an academic and professional
						POV, it is imperative for every individual to match the
						industry requirements to be in competition. Internship
						has immense value for Trainees because of its assistance
						in practical skill enhancement.
					</p>

					<p>
						Internship helps Trainees to learn and understand new
						industry based problem definitions. New technologies
						and related practical work at internship increases the
						knowledge and help Trainees to prove their metal. At
						1trainee.com by updating their profile info, Trainees
						can simply download and view resumes in different
						formats.
					</p>

					<p>
						As per their choice they can change the resume format
						which has been provided on a single click. Internship
						posts from Organizations are shown as per the Trainees
						skill set; Trainees can apply to multiple internships
						and can join the best suitable option.
					</p>

					<p>
						Here at 1trainee.com, registration, resume building and
						internship view facility is kept free i.e. without any
						charge. If Organizations charging for their respective
						internships and Trainees are comfortable with the same
						then it’s up to them whether to opt in or opt out.
					</p>

					<p>
						We suggest Trainees to attend a single internship as
						per their choice at one time and also to complete in
						proper manner, kindly proper cross check all the
						facilities and details of Organization before you
						finalize it. 1trainee.com will always assist Trainees
						to fulfill their internship related search in a quick
						time and less effort.
					</p>
				</div>
			</div>

			<!-- RIGHT IMAGE -->
			<div class="col-lg-5 col-md-5 col-sm-12 reveal" data-reveal="right" style="--d:.15s">
				<div class="ab_img trainee-about-image">
					<div class="image-decoration" aria-hidden="true"></div>
					<img src="~/assets/img/about1.png" class="img-fluid" alt="Trainee" loading="lazy" decoding="async" />
				</div>
			</div>

		</div>
	</div>
</section>
<!-- END ABOUT US -->
<!-- START CATEGORY (popular) -->
<section class="top_cat__area section-padding section-bg-cover">
	<div class="container">
		<div class="section-title text-center reveal" data-reveal="up">
			<h2>Find out by popular Categories</h2>
			<p>We offer a brand new approach to the most basic learning paradigms. Choose from a wide range of learning options and gain new skills! Our school is know.</p>
		</div>
		<div class="row">
			<div class="col-lg-12 col-sm-12 col-xs-12">
				<div class="cat_list">
					<ul>
						@for (int i = 0; i < categories.Length; i++)
						{
							<li class="reveal" data-reveal="zoom" style="--d:@((0.05 * i).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))s">
								<a href="#">
									<img src="~/assets/img/@categories[i].Item1" alt="@categories[i].Item2" loading="lazy" />
									@categories[i].Item2
								</a>
							</li>
						}
					</ul>
				</div>
			</div><!-- END COL -->
		</div><!-- END ROW -->
	</div><!-- END CONTAINER -->
</section>
<!-- END CATEGORY -->
<!-- START COMPANY PARTNER LOGO  -->
<div class="partner-logo section-padding">
	<div class="container">
		<div class="row part_bg reveal" data-reveal="up">
			<div class="col-lg-4 col-sm-4 col-xs-12">
				<div class="partner_title">
					<h3>Helping <span>86,000+</span> global companies take the gloves off </h3>
				</div>
			</div><!-- END COL  -->
			<div class="col-lg-8 col-sm-8 col-xs-12 text-center">
				<div class="partner">
					@foreach (var logo in partnerLogos)
					{
						<a href="#"><img src="~/assets/img/clients/@(logo).png" alt="Partner logo" loading="lazy" /></a>
					}
				</div>
			</div><!-- END COL  -->
		</div><!--END ROW -->
	</div><!-- END CONTAINER  -->
</div>

<!-- START TRAINEE SECTION -->
<section class="team_area" id="trainees">
	<div class="container">

		<div class="section-title text-center reveal" data-reveal="up">
			<span class="team-subtitle">OUR TRAINEES</span>
			<h2>Meet Our Trainees</h2>
			<p>
				Meet our talented trainees who are developing their skills,
				gaining experience and building their careers.
			</p>
		</div>

		<div class="trainee-slider-wrapper reveal" data-reveal="fade">
			<div class="trainee-slider-track@(hasTrainees ? "" : " is-empty")">

				@if (hasTrainees)
				{
					@* Rendered twice: the second pass is required for the seamless infinite loop *@
					@for (int pass = 0; pass < 2; pass++)
					{
						foreach (var trainee in Model)
						{
							<div class="trainee-slide" aria-hidden="@(pass == 1 ? "true" : null)">
								<div class="our-team">

									<div class="team-content">
										<a href="javascript:void(0);" tabindex="-1">
											@if (!string.IsNullOrWhiteSpace(trainee.ProfileImage))
											{
												<img src="~/uploads/candidates/@trainee.ProfileImage"
													 alt="@trainee.TraineeName"
													 class="trainee-profile-image" loading="lazy" decoding="async" />
											}
											else
											{
												<img src="~/assets/img/team/default-profile.png"
													 alt="Profile"
													 class="trainee-profile-image" loading="lazy" decoding="async" />
											}
										</a>
									</div>

									<div class="team-prof">
										<h3>@trainee.TraineeName</h3>
										<span>@(string.IsNullOrWhiteSpace(trainee.Designation) ? "Trainee" : trainee.Designation)</span>
									</div>

									<div class="sth_det2">
										<span class="ti-location-pin" aria-hidden="true"></span>
										<u>@(string.IsNullOrWhiteSpace(trainee.Location) ? "Location not available" : trainee.Location)</u>
									</div>

								</div>
							</div>
						}
					}
				}
				else
				{
					<div class="no-trainee">
						<div class="no-trainee-icon"><i class="ti-user" aria-hidden="true"></i></div>
						<h4>No Trainees Available</h4>
						<p>Trainee profiles will appear here once available.</p>
					</div>
				}

			</div>
		</div>

	</div>
</section>
<!-- END TRAINEE SECTION -->
<!-- START CANDIDATE FEEDBACK SECTION -->
<section class="team_area feedback_area" id="feedback">
	<div class="container">

		<div class="section-title text-center reveal" data-reveal="up">
			<span class="team-subtitle">CANDIDATE FEEDBACK</span>
			<h2>What Our Trainees Say</h2>
			<p>
				Hear from our trainees about their learning experience,
				career journey and experience with us.
			</p>
		</div>

		<div class="trainee-slider-wrapper feedback-slider-wrapper reveal" data-reveal="fade">
			<div class="trainee-slider-track feedback-slider-track@(feedbacks.Any() ? "" : " is-empty")">

				@if (feedbacks.Any())
				{
					@for (int pass = 0; pass < 2; pass++)
					{
						foreach (var feedback in feedbacks)
						{
							<div class="trainee-slide feedback-slide" aria-hidden="@(pass == 1 ? "true" : null)">
								<div class="our-team feedback-card">

									<div class="feedback-quote-icon" aria-hidden="true">
										<i class="fa-solid fa-quote-left"></i>
									</div>

									<div class="feedback-rating" role="img" aria-label="Rated @feedback.Rating out of 5">
										@for (int i = 1; i <= 5; i++)
										{
											if (i <= feedback.Rating)
											{
												<i class="fa-solid fa-star"></i>
											}
											else
											{
												<i class="fa-regular fa-star"></i>
											}
										}
									</div>

									<div class="feedback-content">
										<p>"@feedback.Feedback"</p>
									</div>

									<div class="feedback-profile">
										@if (!string.IsNullOrWhiteSpace(feedback.ProfileImage))
										{
											<img src="~/uploads/candidates/@feedback.ProfileImage"
												 alt="@feedback.TraineeName"
												 class="trainee-profile-image" loading="lazy" decoding="async" />
										}
										else
										{
											<img src="~/assets/img/team/default-profile.png"
												 alt="Profile"
												 class="trainee-profile-image" loading="lazy" decoding="async" />
										}
									</div>

									<div class="team-prof feedback-team-prof">
										<h3>@feedback.TraineeName</h3>
										<span>@(string.IsNullOrWhiteSpace(feedback.Designation) ? "Trainee" : feedback.Designation)</span>
									</div>

									<div class="sth_det2">
										<span class="ti-location-pin" aria-hidden="true"></span>
										<u>@(string.IsNullOrWhiteSpace(feedback.Location) ? "Location not available" : feedback.Location)</u>
									</div>

								</div>
							</div>
						}
					}
				}
				else
				{
					<div class="no-trainee">
						<div class="no-trainee-icon"><i class="ti-comment-alt" aria-hidden="true"></i></div>
						<h4>No Feedback Available</h4>
						<p>Candidate feedback will appear here once available.</p>
					</div>
				}

			</div>
		</div>

	</div>
</section>
<!-- END CANDIDATE FEEDBACK SECTION -->
<!-- START PROMO -->
