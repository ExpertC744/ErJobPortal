@model ErJobPortal.Models.OrganizationStatisticsVM

@* Radhika30-09 *@

<link rel="stylesheet"
      href="~/css/OrgTopSearch.css"
      asp-append-version="true" />

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Charts";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<div class="organization-charts-page">

    <!-- PAGE HEADER -->
    <div class="master-table-title">

        <div>
            <h1>Charts &amp; Statistics</h1>
            <p>At738034692839</p>
        </div>

        <!-- BACK TO DASHBOARD -->
        <a asp-controller="Organization"
           asp-action="Dashboard"
           class="master-back-btn"
           title="Back to Dashboard">
            <i class="fas fa-arrow-left"></i>
        </a>

    </div>

    <!-- ================= TOP ROW ================= -->

    <div class="charts-grid">


        <!-- TOP SKILLS -->
        <div class="chart-card">

            <div class="chart-card-header">

                <div class="chart-icon">
                    <i class="fas fa-code"></i>
                </div>

                <div>
                    <h3>Top Skills</h3>
                    <p>Most preferred trainee skills</p>
                </div>

            </div>

            <div class="chart-list">

                @if (Model.TopSkills != null && Model.TopSkills.Any())
                {
                    int rank = 1;

                    foreach (var skill in Model.TopSkills)
                    {
                        <div class="chart-item">

                            <div class="chart-item-top">
                                <span class="rank">@rank.ToString("00")</span>
                                <span class="item-name">@skill.Name</span>
                                <span class="percentage">@skill.Percentage.ToString("0.00")%</span>
                            </div>

                            <div class="progress-track">
                                <div class="progress-fill"
                                     style="width:@skill.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                                </div>
                            </div>

                        </div>

                        rank++;
                    }
                }
                else
                {
                    <p>No skill data available.</p>
                }

            </div>

        </div>


        <!-- TOP CITIES -->
        <div class="chart-card">

            <div class="chart-card-header">

                <div class="chart-icon">
                    <i class="fas fa-location-dot"></i>
                </div>

                <div>
                    <h3>Top Cities</h3>
                    <p>Locations with maximum trainees</p>
                </div>

            </div>

            <div class="chart-list">

                @if (Model.TopCities != null && Model.TopCities.Any())
                {
                    int rank = 1;

                    foreach (var city in Model.TopCities)
                    {
                        <div class="chart-item">

                            <div class="chart-item-top">
                                <span class="rank">@rank.ToString("00")</span>
                                <span class="item-name">@city.Name</span>
                                <span class="percentage">@city.Percentage.ToString("0.00")%</span>
                            </div>

                            <div class="progress-track">
                                <div class="progress-fill"
                                     style="width:@city.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                                </div>
                            </div>

                        </div>

                        rank++;
                    }
                }
                else
                {
                    <p>No city data available.</p>
                }

            </div>

        </div>



        <!-- ================= BOTTOM CARD ================= -->

        <div class="fields-wrapper">

            <div class="chart-card fields-card">

                <div class="chart-card-header">

                    <div class="chart-icon">
                        <i class="fas fa-layer-group"></i>
                    </div>

                    <div>
                        <h3>Top Fields</h3>
                        <p>Most selected candidate skill categories</p>
                    </div>

                </div>


                <div class="chart-list">

                    <div class="chart-list">

                        @if (Model.TopFields != null && Model.TopFields.Any())
                        {
                            int rank = 1;

                            foreach (var field in Model.TopFields)
                            {
                                <div class="chart-item">

                                    <div class="chart-item-top">
                                        <span class="rank">@rank.ToString("00")</span>
                                        <span class="item-name">@field.Name</span>
                                        <span class="percentage">@field.Percentage.ToString("0.00")%</span>
                                    </div>

                                    <div class="progress-track">
                                        <div class="progress-fill"
                                             style="width:@field.Percentage.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%;">
                                        </div>
                                    </div>

                                </div>

                                rank++;
                            }
                        }
                        else
                        {
                            <p>No field data available.</p>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


