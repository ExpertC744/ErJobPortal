@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Charts";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<div class="organization-charts-page">

    <!-- PAGE HEADER -->
    <div class="charts-header">
        <div>
            <h1>Charts & Statistics</h1>
            <p>At738034692839</p>
        </div>
    </div>


    <!-- ================= TOP ROW ================= -->

    <div class="charts-grid">


        <!-- TOP SKILLS -->
        <div class="chart-card">

            <div class="chart-card-header">

                <div class="chart-icon">
                    <i class="fas fa-code"></i>
                </div>

                <div>
                    <h3>Top Skills</h3>
                    <p>Most preferred trainee skills</p>
                </div>

            </div>


            <div class="chart-list">

                <!-- SKILL 1 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">01</span>
                        <span class="item-name">C / C++</span>
                        <span class="percentage">39.26%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:39.26%;">
                        </div>
                    </div>

                </div>


                <!-- SKILL 2 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">02</span>
                        <span class="item-name">HTML</span>
                        <span class="percentage">33.73%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:33.73%;">
                        </div>
                    </div>

                </div>


                <!-- SKILL 3 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">03</span>
                        <span class="item-name">JAVA</span>
                        <span class="percentage">27.01%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:27.01%;">
                        </div>
                    </div>

                </div>

            </div>

        </div>



        <!-- TOP CITIES -->
        <div class="chart-card">

            <div class="chart-card-header">

                <div class="chart-icon">
                    <i class="fas fa-location-dot"></i>
                </div>

                <div>
                    <h3>Top Cities</h3>
                    <p>Locations with maximum trainees</p>
                </div>

            </div>


            <div class="chart-list">

                <!-- CITY 1 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">01</span>
                        <span class="item-name">Nagpur</span>
                        <span class="percentage">63%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:63%;">
                        </div>
                    </div>

                </div>


                <!-- CITY 2 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">02</span>
                        <span class="item-name">Mumbai</span>
                        <span class="percentage">48%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:48%;">
                        </div>
                    </div>

                </div>


                <!-- CITY 3 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">03</span>
                        <span class="item-name">Pune</span>
                        <span class="percentage">36%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:36%;">
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- ================= BOTTOM CARD ================= -->

    <div class="fields-wrapper">

        <div class="chart-card fields-card">

            <div class="chart-card-header">

                <div class="chart-icon">
                    <i class="fas fa-layer-group"></i>
                </div>

                <div>
                    <h3>Top Fields</h3>
                    <p>Most selected candidate skill categories</p>
                </div>

            </div>


            <div class="chart-list">

                <!-- FIELD 1 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">01</span>
                        <span class="item-name">Technical Skill</span>
                        <span class="percentage">71.82%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:71.82%;">
                        </div>
                    </div>

                </div>


                <!-- FIELD 2 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">02</span>
                        <span class="item-name">Non-Technical Skill</span>
                        <span class="percentage">14.62%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:14.62%;">
                        </div>
                    </div>

                </div>


                <!-- FIELD 3 -->
                <div class="chart-item">

                    <div class="chart-item-top">
                        <span class="rank">03</span>
                        <span class="item-name">Medical Skill</span>
                        <span class="percentage">13.56%</span>
                    </div>

                    <div class="progress-track">
                        <div class="progress-fill"
                             style="width:13.56%;">
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>



<style>

    /* =========================================
       MAIN PAGE
    ========================================= */

    .organization-charts-page {
        padding: 10px 4px 40px;
        background: #f7faf9;
        min-height: calc(100vh - 80px);
    }


    /* =========================================
       HEADER
    ========================================= */

    .charts-header {
        margin-bottom: 24px;
    }

    .charts-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: #0f172a;
    }

    .charts-header p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 16px;
    }


    /* =========================================
       GRID
    ========================================= */

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 24px;
    }


    /* =========================================
       CARD
    ========================================= */

    .chart-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        padding: 26px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.06);
    }


    /* =========================================
       CARD HEADER
    ========================================= */

    .chart-card-header {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 28px;
    }

    .chart-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        background: #ccfbf1;
        color: #0d9488;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        flex-shrink: 0;
    }

    .chart-card-header h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        color: #0f172a;
    }

    .chart-card-header p {
        margin: 4px 0 0;
        font-size: 13px;
        color: #64748b;
    }


    /* =========================================
       CHART ITEM
    ========================================= */

    .chart-item {
        margin-bottom: 23px;
    }

    .chart-item:last-child {
        margin-bottom: 0;
    }


    .chart-item-top {
        display: grid;
        grid-template-columns: 42px 1fr auto;
        align-items: center;
        gap: 8px;
        margin-bottom: 9px;
    }


    .rank {
        font-size: 13px;
        font-weight: 700;
        color: #0d9488;
    }


    .item-name {
        font-size: 15px;
        font-weight: 600;
        color: #334155;
    }


    .percentage {
        font-size: 13px;
        font-weight: 700;
        color: #0f766e;
    }


    /* =========================================
       PROGRESS
    ========================================= */

    .progress-track {
        width: 100%;
        height: 10px;
        background: #e2e8f0;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(
            90deg,
            #0d9488,
            #14b8a6
        );
        border-radius: 20px;
    }


    /* =========================================
       BOTTOM CARD
    ========================================= */

    .fields-wrapper {
        width: 70%;
        margin: 24px auto 0;
    }

    .fields-card {
        width: 100%;
    }


    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 992px) {

        .charts-grid {
            grid-template-columns: 1fr;
        }

        .fields-wrapper {
            width: 100%;
        }
    }


    @@media (max-width: 576px) {

        .organization-charts-page {
            padding: 10px 0 30px;
        }

        .charts-header h1 {
            font-size: 24px;
        }

        .chart-card {
            padding: 20px 16px;
            border-radius: 16px;
        }

        .chart-card-header h3 {
            font-size: 18px;
        }

        .chart-item-top {
            grid-template-columns: 35px 1fr auto;
        }

        .item-name {
            font-size: 14px;
        }

        .percentage {
            font-size: 12px;
        }
    }

</style>