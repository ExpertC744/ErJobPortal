    <!-- Recruitment Drive Details -->
    <section class="drive-panel drive-create-section" id="driveDetails">
        <h3>Recruitment Drive Details</h3>
        <p>Enter the drive details before proceeding with your selected candidates.</p>

        <form id="createDriveForm" method="post" asp-controller="Organization" asp-action="CreateDrive">
            @Html.AntiForgeryToken()

            <div class="drive-form-grid">
                <div class="drive-field">
                    <label for="DriveTitle">Drive Title *</label>
                    <input type="text" class="drive-control" id="DriveTitle" name="DriveTitle"
                           placeholder="e.g. Graduate Trainee Recruitment 2027" required>
                </div>

                <div class="drive-field">
                    <label for="JobRole">Job Role *</label>
                    <input type="text" class="drive-control" id="JobRole" name="JobRole"
                           placeholder="e.g. Software Developer" required>
                </div>

                <div class="drive-field">
                    <label for="Package">Annual Package (LPA)</label>
                    <input type="number" class="drive-control" id="Package" name="Package"
                           min="0" step="0.01" placeholder="e.g. 4.5">
                </div>

                <div class="drive-field">
                    <label for="DriveDate">Drive Date *</label>
                    <input type="date" class="drive-control" id="DriveDate" name="DriveDate" required>
                </div>

                <div class="drive-field">
                    <label for="ApplicationDeadline">Application Deadline *</label>
                    <input type="date" class="drive-control" id="ApplicationDeadline"
                           name="ApplicationDeadline" required>
                </div>

                <div class="drive-field">
                    <label for="WorkLocation">Job Location *</label>
                    <input type="text" class="drive-control" id="WorkLocation" name="WorkLocation"
                           placeholder="e.g. Nagpur / Pune / Remote" required>
                </div>

                <div class="drive-field">
                    <label for="JobType">Employment Type *</label>
                    <select class="drive-control" id="JobType" name="JobType" required>
                        <option value="">Select type</option>
                        <option value="FullTime">Full Time</option>
                        <option value="Internship">Internship</option>
                        <option value="Trainee">Trainee</option>
                        <option value="Fellowship">Fellowship</option>
                    </select>
                </div>

                <div class="drive-field">
                    <label for="WorkMode">Work Mode *</label>
                    <select class="drive-control" id="WorkMode" name="WorkMode" required>
                        <option value="">Select mode</option>
                        <option value="Onsite">On-site</option>
                        <option value="Hybrid">Hybrid</option>
                        <option value="Remote">Remote</option>
                    </select>
                </div>

                <div class="drive-field">
                    <label for="Vacancies">Number of Vacancies</label>
                    <input type="number" class="drive-control" id="Vacancies" name="Vacancies"
                           min="1" placeholder="e.g. 10">
                </div>
            </div>

            <input type="hidden" name="SelectedCandidateIds" id="SelectedCandidateIds">

            <div class="drive-notice" id="driveNotice" role="status"></div>

            <div class="drive-form-actions">
                <button type="reset" class="drive-btn drive-btn-outline" id="resetDriveForm">
                    Clear Details
                </button>
                <button type="submit" class="drive-btn drive-btn-primary">
                    Create Recruitment Drive →
                </button>
            </div>
        </form>
    </section>
</div>

<script>
    (function () {
        const root = document.querySelector(".drive-page");
        if (!root) return;

        const rows = Array.from(root.querySelectorAll(".candidate-row"));
        const filters = Array.from(root.querySelectorAll(".drive-filter"));
        const searchInput = root.querySelector("#candidateSearch");
        const selectAll = root.querySelector("#selectAll");
        const pageSize = root.querySelector("#pageSize");
        const emptyState = root.querySelector("#emptyState");

        let filteredRows = [...rows];
        let visibleRows = [...rows];
        let currentPage = 1;

        const getChecked = (filterName) =>
            filters
                .filter(x => x.dataset.filter === filterName && x.checked)
                .map(x => x.value);

        const checkedCriteria = () =>
            filters.filter(x => x.dataset.filter === "criteria" && x.checked);

        const num = (value) => {
            const result = Number(value);
            return Number.isFinite(result) ? result : null;
        };

        function matches(row) {
            const data = row.dataset;

            const levels = getChecked("level");
            const courses = getChecked("course");
            const branches = getChecked("branch");
            const years = getChecked("year");
            const backlogRules = getChecked("backlog");

            if (levels.length && !levels.includes(data.level)) return false;
            if (courses.length && !courses.includes(data.course)) return false;
            if (branches.length && data.branch !== branches[0]) return false;
            if (years.length && data.year !== years[0]) return false;

            const criteria = getChecked("criteria");

            if (criteria.includes("tenth")) {
                const minimum = num(root.querySelector("#minTenth").value);
                const score = num(data.tenth);
                if (minimum === null || score === null || score < minimum) return false;
            }

            if (criteria.includes("twelfth")) {
                const minimum = num(root.querySelector("#minTwelfth").value);
                const score = num(data.twelfth);
                if (minimum === null || score === null || score < minimum) return false;
            }

            const selectedSemesters = checkedCriteria()
                .filter(x => x.classList.contains("drive-sem-check"));

            if (selectedSemesters.length) {
                const minimum = num(root.querySelector("#minCgpa").value);
                if (minimum === null || minimum < 0 || minimum > 10) return false;

                for (const semester of selectedSemesters) {
                    const score = num(data["sem" + semester.dataset.sem]);
                    if (score === null || score < minimum) return false;
                }
            }

            if (backlogRules.includes("zero") && num(data.backlogs) !== 0) {
                return false;
            }

            const query = searchInput.value.trim().toLowerCase();
            if (query && !(data.search || "").toLowerCase().includes(query)) {
                return false;
            }

            return true;
        }

        function updateSelection() {
            const selected = rows.filter(row =>
                row.querySelector(".candidate-select").checked
            );

            root.querySelector("#statSelected").textContent = selected.length;
            root.querySelector("#selectedCount").textContent = selected.length;
            root.querySelector("#SelectedCandidateIds").value =
                selected.map(row => row.dataset.id).join(",");

            selectAll.checked = visibleRows.length > 0 &&
                visibleRows.every(row => row.querySelector(".candidate-select").checked);

            selectAll.indeterminate = visibleRows.some(row =>
                row.querySelector(".candidate-select").checked
            ) && !selectAll.checked;
        }

        function updateFilters() {
            filteredRows = rows.filter(matches);

            const limit = Number(pageSize.value) || 10;
            const pages = Math.max(1, Math.ceil(filteredRows.length / limit));
            currentPage = Math.min(currentPage, pages);

            const start = (currentPage - 1) * limit;
            visibleRows = filteredRows.slice(start, start + limit);

            rows.forEach(row => {
                row.style.display = "none";
            });

            visibleRows.forEach(row => {
                row.style.display = "";
            });

            emptyState.style.display = filteredRows.length ? "none" : "block";
            root.querySelector("#candidateTable").style.display =
                filteredRows.length ? "table" : "none";

            root.querySelector("#visibleCount").textContent = filteredRows.length;
            root.querySelector("#statMatching").textContent = filteredRows.length;

            const active = filters.filter(x => x.checked).length;
            root.querySelector("#activeFilterCount").textContent = active + " active";
            root.querySelector("#statCriteria").textContent =
                checkedCriteria().length + " Active";

            updateSelection();
        }

        // Enable or disable minimum score fields based on selected criteria.
        function updateThresholds() {
            const tenth = root.querySelector('[value="tenth"]');
            const twelfth = root.querySelector('[value="twelfth"]');
            const sems = root.querySelectorAll(".drive-sem-check");

            root.querySelector("#minTenth").disabled = !tenth.checked;
            root.querySelector("#minTwelfth").disabled = !twelfth.checked;
            root.querySelector("#minCgpa").disabled =
                !Array.from(sems).some(x => x.checked);
        }

        filters.forEach(filter => {
            filter.addEventListener("change", () => {
                updateThresholds();
                currentPage = 1;
                updateFilters();
            });
        });

        [ "minTenth", "minTwelfth", "minCgpa" ].forEach(id => {
            root.querySelector("#" + id).addEventListener("input", updateFilters);
        });

        searchInput.addEventListener("input", () => {
            currentPage = 1;
            updateFilters();
        });

        pageSize.addEventListener("change", () => {
            currentPage = 1;
            updateFilters();
        });

        root.querySelector("#applyFilters").addEventListener("click", updateFilters);

        root.querySelector("#resetFilters").addEventListener("click", () => {
            filters.forEach(x => x.checked = false);
            root.querySelector("#filterBranch").value = "";
            root.querySelector("#filterYear").value = "";
            root.querySelector("#minTenth").value = 60;
            root.querySelector("#minTwelfth").value = 60;
            root.querySelector("#minCgpa").value = 6.5;
            searchInput.value = "";
            updateThresholds();
            currentPage = 1;
            updateFilters();
        });

        selectAll.addEventListener("change", () => {
            visibleRows.forEach(row => {
                row.querySelector(".candidate-select").checked = selectAll.checked;
            });
            updateSelection();
        });

        rows.forEach(row => {
            row.querySelector(".candidate-select").addEventListener("change", updateSelection);
        });

        root.querySelector("#clearSelection").addEventListener("click", () => {
            rows.forEach(row => row.querySelector(".candidate-select").checked = false);
            updateSelection();
        });

        root.querySelector("#continueDrive").addEventListener("click", () => {
            const selected = rows.filter(row =>
                row.querySelector(".candidate-select").checked
            );

            if (!selected.length) {
                alert("Please select at least one candidate before continuing.");
                return;
            }

            root.querySelector("#driveDetails").scrollIntoView({
                behavior: "smooth",
                block: "start"
            });

            root.querySelector("#DriveTitle").focus({ preventScroll: true });
        });

        const dateFields = [
            root.querySelector("#DriveDate"),
            root.querySelector("#ApplicationDeadline")
        ];

        const today = new Date();
        const localToday = [
            today.getFullYear(),
            String(today.getMonth() + 1).padStart(2, "0"),
            String(today.getDate()).padStart(2, "0")
        ].join("-");

        dateFields.forEach(field => field.min = localToday);

        root.querySelector("#DriveDate").addEventListener("change", function () {
            const deadline = root.querySelector("#ApplicationDeadline");
            deadline.min = this.value || localToday;
            if (deadline.value && this.value && deadline.value < this.value) {
                deadline.value = "";
            }
        });

        root.querySelector("#createDriveForm").addEventListener("submit", function (event) {
            const selected = rows.filter(row =>
                row.querySelector(".candidate-select").checked
            );

            const notice = root.querySelector("#driveNotice");

            if (!selected.length) {
                event.preventDefault();
                notice.textContent = "Select at least one candidate before creating the drive.";
                notice.style.display = "block";
                notice.scrollIntoView({ behavior: "smooth", block: "center" });
                return;
            }

            const driveDate = root.querySelector("#DriveDate").value;
            const deadline = root.querySelector("#ApplicationDeadline").value;

            if (driveDate && deadline && deadline > driveDate) {
                event.preventDefault();
                notice.textContent = "The application deadline must be on or before the drive date.";
                notice.style.display = "block";
                return;
            }

            root.querySelector("#SelectedCandidateIds").value =
                selected.map(row => row.dataset.id).join(",");
            notice.style.display = "none";

            // Form submission requires a matching server-side POST action.
        });

        root.querySelector("#resetDriveForm").addEventListener("click", () => {
            root.querySelector("#driveNotice").style.display = "none";
        });

        updateThresholds();
        updateFilters();
    })();
</script>