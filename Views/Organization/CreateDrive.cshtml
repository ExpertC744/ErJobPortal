	@@media (max-width: 1200px) {
		.drive-main-grid {
			grid-template-columns: 235px minmax(0, 1fr);
		}
	}

	/* filters become a toggle panel above the table; table becomes cards */
	@@media (max-width: 900px) {
		.drive-main-grid {
			grid-template-columns: 1fr;
		}

		.drive-stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.drive-filters {
			display: none;
			position: static;
		}

			.drive-filters.open {
				display: block;
			}

		.drive-filter-body {
			max-height: none;
			overflow: visible;
		}

			.drive-filter-body .drive-fs-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				column-gap: 18px;
			}

		#toggleFilters {
			display: inline-flex;
		}

		.drive-table-wrap {
			overflow: visible;
		}

		.drive-table {
			min-width: 0;
			display: block;
		}

			.drive-table thead {
				display: none;
			}

			.drive-table tbody {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 10px;
				padding: 10px;
			}

				.drive-table tbody tr {
					position: relative;
					display: block;
					padding: 10px 12px;
					background: #fff;
					border: 1px solid var(--drive-border-soft);
					border-radius: 10px;
					box-shadow: 0 2px 8px rgba(15, 23, 42, .04);
				}

					.drive-table tbody tr.is-selected {
						border-color: var(--drive-primary);
						background: #effaf8;
					}

			.drive-table td {
				display: flex;
				justify-content: space-between;
				gap: 12px;
				padding: 4px 0;
				border-bottom: 1px dashed var(--drive-border-soft);
				text-align: right;
			}

				.drive-table td:last-child {
					border-bottom: 0;
				}

				.drive-table td::before {
					content: attr(data-label);
					flex-shrink: 0;
					color: var(--drive-muted);
					font-size: 11px;
					font-weight: 600;
					text-align: left;
				}

				.drive-table td.td-select {
					position: absolute;
					top: 10px;
					right: 12px;
					padding: 0;
					border: 0;
				}

					.drive-table td.td-select::before {
						display: none;
					}

				.drive-table td.td-cand {
					padding-bottom: 8px;
					padding-right: 30px;
					text-align: left;
				}

					.drive-table td.td-cand::before {
						display: none;
					}
	}

	@@media (max-width: 760px) {
		.drive-g4 {
			grid-template-columns: repeat(2, minmax(0, 1fr));
