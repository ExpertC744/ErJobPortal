<script>
	(function () {

		const root = document.querySelector(".drive-page");
		if (!root) return;

		const $ = function (sel) { return root.querySelector(sel); };

		/* =====================================================
		   CANDIDATE FILTERS + TABLE
		===================================================== */

		const rows = Array.from(root.querySelectorAll(".candidate-row"));
		const checkFilters = Array.from(root.querySelectorAll('input.drive-filter[type="checkbox"]'));
		const searchInput = $("#candidateSearch");
		const selectAll = $("#selectAll");
		const pageSize = $("#pageSize");
		const emptyState = $("#emptyState");
		const tableWrap = $("#tableWrap");

		// search text is built once from the visible row content
		rows.forEach(function (row) {
			row.dataset.search = (row.dataset.id + " " + row.textContent + " " +
				row.dataset.course + " " + row.dataset.branch).replace(/\s+/g, " ").toLowerCase();
		});

		let filteredRows = rows.slice();
		let visibleRows = rows.slice();
		let currentPage = 1;

		function checkedValues(name) {
			return checkFilters
				.filter(function (x) { return x.dataset.filter === name && x.checked; })
				.map(function (x) { return x.value; });
		}

		function num(value) {
			const n = Number(value);
			return value !== "" && Number.isFinite(n) ? n : null;
		}

		function matches(row) {

			const d = row.dataset;

			const levels = checkedValues("level");
			const courses = checkedValues("course");
			const criteria = checkedValues("criteria");
			const branch = $("#filterBranch").value;
			const year = $("#filterYear").value;

			if (levels.length && levels.indexOf(d.level) < 0) return false;
			if (courses.length && courses.indexOf(d.course) < 0) return false;
			if (branch && d.branch !== branch) return false;
			if (year && d.year !== year) return false;

			if (criteria.indexOf("tenth") >= 0) {
				const min = num($("#minTenth").value), score = num(d.tenth);
				if (min === null || score === null || score < min) return false;
			}

			if (criteria.indexOf("twelfth") >= 0) {
				const min = num($("#minTwelfth").value), score = num(d.twelfth);
				if (min === null || score === null || score < min) return false;
			}

			const sems = checkFilters.filter(function (x) {
				return x.classList.contains("drive-sem-check") && x.checked;
			});

			if (sems.length) {
				const min = num($("#minCgpa").value);
				if (min === null || min < 0 || min > 10) return false;

				for (let i = 0; i < sems.length; i++) {
					const score = num(d["sem" + sems[i].dataset.sem]);
					if (score === null || score < min) return false;
				}
			}

			if (checkedValues("backlog").indexOf("zero") >= 0 && num(d.backlogs) !== 0) return false;

			const q = searchInput.value.trim().toLowerCase();
			if (q && d.search.indexOf(q) < 0) return false;

			return true;
		}

		function selectedRows() {
			return rows.filter(function (r) { return r.querySelector(".candidate-select").checked; });
		}

		function updateSelection() {

			const selected = selectedRows();

			rows.forEach(function (r) {
				r.classList.toggle("is-selected", r.querySelector(".candidate-select").checked);
			});

			$("#statSelected").textContent = selected.length;
			$("#selectedCount").textContent = selected.length;
			$("#formSelectedCount").textContent = selected.length;
			$("#SelectedCandidateIds").value = selected.map(function (r) { return r.dataset.id; }).join(",");

			const allChecked = visibleRows.length > 0 && visibleRows.every(function (r) {
				return r.querySelector(".candidate-select").checked;
			});
			const anyChecked = visibleRows.some(function (r) {
				return r.querySelector(".candidate-select").checked;
			});

			selectAll.checked = allChecked;
			selectAll.indeterminate = anyChecked && !allChecked;
		}

		function renderPager(pages) {

			let html = '<button type="button" data-p="' + (currentPage - 1) + '"' +
				(currentPage === 1 ? " disabled" : "") + '><i class="fa-solid fa-chevron-left"></i></button>';

			for (let p = 1; p <= pages; p++) {
				if (p === 1 || p === pages || Math.abs(p - currentPage) <= 1) {
					html += '<button type="button" data-p="' + p + '"' +
						(p === currentPage ? ' class="active"' : "") + ">" + p + "</button>";
				} else if (Math.abs(p - currentPage) === 2) {
					html += '<button type="button" disabled>...</button>';
				}
			}

			html += '<button type="button" data-p="' + (currentPage + 1) + '"' +
				(currentPage === pages ? " disabled" : "") + '><i class="fa-solid fa-chevron-right"></i></button>';

			$("#pager").innerHTML = html;
		}

		function activeFilterTotal() {
			return checkFilters.filter(function (x) { return x.checked; }).length +
				($("#filterBranch").value ? 1 : 0) +
				($("#filterYear").value ? 1 : 0);
		}

		function updateFilters() {

			filteredRows = rows.filter(matches);

			const limit = Number(pageSize.value) || 10;
			const pages = Math.max(1, Math.ceil(filteredRows.length / limit));
			if (currentPage > pages) currentPage = pages;

			const start = (currentPage - 1) * limit;
			visibleRows = filteredRows.slice(start, start + limit);

			rows.forEach(function (r) { r.style.display = "none"; });
			visibleRows.forEach(function (r) { r.style.display = ""; });

			emptyState.style.display = filteredRows.length ? "none" : "block";
			tableWrap.style.display = filteredRows.length ? "" : "none";

			$("#visibleCount").textContent = filteredRows.length;
			$("#statMatching").textContent = filteredRows.length;

			const active = activeFilterTotal();
			$("#activeFilterCount").textContent = active + " active";
			$("#activeFilterCountMobile").textContent = active;
			$("#statCriteria").textContent = checkedValues("criteria").length + " Active";

			renderPager(pages);
			updateSelection();
		}

		// enable / disable the minimum score inputs
		function updateThresholds() {
			const crit = checkedValues("criteria");
			$("#minTenth").disabled = crit.indexOf("tenth") < 0;
			$("#minTwelfth").disabled = crit.indexOf("twelfth") < 0;
			$("#minCgpa").disabled = !checkFilters.some(function (x) {
				return x.classList.contains("drive-sem-check") && x.checked;
			});
		}

		function refresh(resetPage) {
			if (resetPage) currentPage = 1;
			updateThresholds();
			updateFilters();
		}

		checkFilters.forEach(function (f) { f.addEventListener("change", function () { refresh(true); }); });
		["filterBranch", "filterYear"].forEach(function (id) {
			$("#" + id).addEventListener("change", function () { refresh(true); });
		});
		["minTenth", "minTwelfth", "minCgpa"].forEach(function (id) {
			$("#" + id).addEventListener("input", function () { refresh(true); });
		});

		searchInput.addEventListener("input", function () { refresh(true); });
		pageSize.addEventListener("change", function () { refresh(true); });

		$("#pager").addEventListener("click", function (e) {
			const b = e.target.closest("button[data-p]");
			if (!b || b.disabled) return;
			currentPage = parseInt(b.getAttribute("data-p"), 10);
			updateFilters();
		});

		$("#applyFilters").addEventListener("click", function () {
			refresh(true);
			$("#filterPanel").classList.remove("open");
		});

		$("#resetFilters").addEventListener("click", function () {
			checkFilters.forEach(function (x) { x.checked = false; });
			$("#filterBranch").value = "";
			$("#filterYear").value = "";
			$("#minTenth").value = 60;
			$("#minTwelfth").value = 60;
			$("#minCgpa").value = 6.5;
			searchInput.value = "";
			refresh(true);
		});

		$("#toggleFilters").addEventListener("click", function () {
			$("#filterPanel").classList.toggle("open");
		});

		selectAll.addEventListener("change", function () {
			visibleRows.forEach(function (r) { r.querySelector(".candidate-select").checked = selectAll.checked; });
			updateSelection();
		});

		rows.forEach(function (r) {
			r.querySelector(".candidate-select").addEventListener("change", updateSelection);
		});

		$("#clearSelection").addEventListener("click", function () {
			rows.forEach(function (r) { r.querySelector(".candidate-select").checked = false; });
			updateSelection();
		});

		$("#continueDrive").addEventListener("click", function () {

			if (!selectedRows().length) {
				showNotice("Please select at least one candidate before continuing.");
				return;
			}

			$("#driveDetails").scrollIntoView({ behavior: "smooth", block: "start" });
			$("#CompanyName").focus({ preventScroll: true });
		});


		/* =====================================================
		   DRIVE DETAILS FORM
		===================================================== */

		const form = $("#createDriveForm");
		const notice = $("#driveNotice");
		const venueList = $("#venueList");
		const MAX_VENUES = 10;

		function setError(el, message) {
			const field = el.closest(".drive-field");
			const msg = field ? field.querySelector(".drive-error") : null;
			if (message) {
				el.classList.add("invalid");
				if (msg) msg.textContent = message;
			} else {
				el.classList.remove("invalid");
				if (msg) msg.textContent = "";
			}
		}

		function showNotice(message) {
			notice.innerHTML = '<i class="fa-solid fa-circle-exclamation"></i>';
			notice.appendChild(document.createTextNode(message));
			notice.style.display = "block";
			notice.scrollIntoView({ behavior: "smooth", block: "center" });
		}

		function hideNotice() { notice.style.display = "none"; }

		// ---------- venues ----------

		function venueInputs() {
			return Array.from(venueList.querySelectorAll(".venue-input"));
		}

		function refreshVenues() {
			const list = venueList.querySelectorAll(".drive-venue-row");

			list.forEach(function (row, i) {
				row.querySelector(".drive-venue-no").textContent = i + 1;
				row.querySelector(".drive-icon-btn").disabled = list.length === 1;
			});

			$("#btnAddVenue").disabled = list.length >= MAX_VENUES;
		}

		function addVenue(value) {

			if (venueList.children.length >= MAX_VENUES) return null;

			const row = document.createElement("div");
			row.className = "drive-venue-row";

			row.innerHTML =
				'<span class="drive-venue-no"></span>' +
				'<div class="drive-input-icon">' +
				'<i class="fa-solid fa-map-pin"></i>' +
				'<input type="text" name="Venues" class="drive-control venue-input" ' +
				'placeholder="Enter venue / hall / address" maxlength="200" />' +
				'</div>' +
				'<button type="button" class="drive-icon-btn" title="Remove venue" aria-label="Remove venue">' +
				'<i class="fa-solid fa-trash-can"></i></button>';

			const input = row.querySelector("input");
			input.value = value || "";

			input.addEventListener("input", function () {
				input.classList.remove("invalid");
				$("#venueError").textContent = "";
			});

			row.querySelector(".drive-icon-btn").addEventListener("click", function () {
				if (venueList.children.length > 1) {
					row.remove();
					refreshVenues();
				}
			});

			venueList.appendChild(row);
			refreshVenues();
			return input;
		}

		$("#btnAddVenue").addEventListener("click", function () {
			const input = addVenue("");
			if (input) input.focus();
		});

		addVenue("");

		// ---------- rounds ----------

		let roundOrder = [];
		const roundBoxes = Array.from(form.querySelectorAll('input[name="Rounds"]'));

		function refreshRounds() {

			roundBoxes.forEach(function (box) {
				const badge = box.nextElementSibling.querySelector(".drive-order");
				const index = roundOrder.indexOf(box.value);
				badge.textContent = index >= 0 ? index + 1 : "";
			});

			$("#roundsCount").textContent = roundOrder.length;
			$("#NoOfRounds").value = roundOrder.length;
			$("#RoundSequence").value = roundOrder.join(",");
			$("#roundsError").textContent = "";
		}

		roundBoxes.forEach(function (box) {
			box.addEventListener("change", function () {
				if (box.checked) {
					roundOrder.push(box.value);
				} else {
					roundOrder = roundOrder.filter(function (v) { return v !== box.value; });
				}
				refreshRounds();
			});
		});

		// ---------- input rules + date limits ----------

		$("#ContactNo").addEventListener("input", function () {
			this.value = this.value.replace(/\D/g, "").substring(0, 10);
		});

		const now = new Date();
		const localToday = [
			now.getFullYear(),
			String(now.getMonth() + 1).padStart(2, "0"),
			String(now.getDate()).padStart(2, "0")
		].join("-");

		["DateFrom", "DateTo", "ExpectedJoining"].forEach(function (id) { $("#" + id).min = localToday; });

		$("#DateFrom").addEventListener("change", function () {
			$("#DateTo").min = this.value || localToday;
			if ($("#DateTo").value && this.value && $("#DateTo").value < this.value) $("#DateTo").value = "";
		});

		$("#DateTo").addEventListener("change", function () {
			$("#ExpectedJoining").min = this.value || localToday;
			if ($("#ExpectedJoining").value && this.value && $("#ExpectedJoining").value < this.value) {
				$("#ExpectedJoining").value = "";
			}
		});

		form.addEventListener("input", function (e) {
			if (e.target.classList && e.target.classList.contains("drive-control")) setError(e.target, "");
		});

		// ---------- validation + submit ----------

		form.addEventListener("submit", function (e) {

			hideNotice();

			let valid = true;
			let firstInvalid = null;

			function fail(el, message) {
				setError(el, message);
				valid = false;
				if (!firstInvalid) firstInvalid = el;
			}

			Array.from(form.querySelectorAll(".drive-field .drive-control")).forEach(function (el) {

				const value = el.value.trim();

				if (el.required && !value) { fail(el, "This field is required."); return; }
				if (el.type === "email" && value && !el.checkValidity()) { fail(el, "Enter a valid email address."); return; }
				if (el.id === "ContactNo" && value && !/^\d{10}$/.test(value)) { fail(el, "Enter a valid 10 digit number."); return; }
				if (el.id === "Package" && value && Number(value) <= 0) { fail(el, "Package must be greater than 0."); return; }

				setError(el, "");
			});

			const from = $("#DateFrom").value;
			const to = $("#DateTo").value;
			const join = $("#ExpectedJoining").value;

			if (from && to && to < from) fail($("#DateTo"), "Must be on or after Date From.");
			if (to && join && join < to) fail($("#ExpectedJoining"), "Must be on or after Date To.");

			if ($("#TimeFrom").value && $("#TimeTo").value && $("#TimeTo").value <= $("#TimeFrom").value) {
				fail($("#TimeTo"), "Must be after start time.");
			}

			const filledVenues = venueInputs().filter(function (v) { return v.value.trim() !== ""; });

			if (!filledVenues.length) {
				valid = false;
				$("#venueError").textContent = "Add at least one venue.";
				const firstVenue = venueInputs()[0];
				firstVenue.classList.add("invalid");
				if (!firstInvalid) firstInvalid = firstVenue;
			}

			if (!roundOrder.length) {
				valid = false;
				$("#roundsError").textContent = "Select at least one round.";
			}

			const selected = selectedRows();
			if (!selected.length) valid = false;

			if (!valid) {
				e.preventDefault();
				showNotice(!selected.length
					? "Select at least one candidate from the table, then complete the highlighted fields."
					: "Please correct the highlighted fields and try again.");
				if (firstInvalid) firstInvalid.focus({ preventScroll: true });
				return;
			}

			$("#SelectedCandidateIds").value = selected.map(function (r) { return r.dataset.id; }).join(",");

			// remove empty venue rows before posting
			venueInputs().forEach(function (v) {
				if (v.value.trim() === "") v.closest(".drive-venue-row").remove();
			});
			refreshVenues();

			// Posting requires a matching server-side [HttpPost] CreateDrive action.
		});

		$("#resetDriveForm").addEventListener("click", function () {

			setTimeout(function () {
				hideNotice();

				form.querySelectorAll(".drive-control").forEach(function (el) { el.classList.remove("invalid"); });
				form.querySelectorAll(".drive-error").forEach(function (el) { el.textContent = ""; });

				venueList.innerHTML = "";
				addVenue("");

				roundOrder = [];
				refreshRounds();
				updateSelection();
			}, 0);
		});

		refresh(true);

	})();
</script>
