@model ErJobPortal.Models.OrgProfile

@{
    ViewData["Title"] = "View Organization Profile";
    Layout = null;

    // ============================================================
    // HELPER
    // ============================================================
    string Safe(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value.Trim();

    // ============================================================
    // ORGANIZATION DATA
    // ============================================================
    string organizationName = Safe(Model?.sOrganizationName);
    string contactName = Safe(Model?.sOrganizationName);   // swap to your contact-person property if available
    string designation = Safe(Model?.sDesignation);
    string email = Safe(Model?.sOrganizationEmail);
    string mobile = Safe(Model?.sMobile);
    string companyAddress = Safe(Model?.sCompanyAddress);
    string gstNo = Safe(Model?.sGSTNo);
    string cinNo = Safe(Model?.sCINNo);
    string employeeStrength = Safe(Model?.nEmployeeStrength);

    string establishmentYear =
        Model?.nEstablishmentYear > 0 ? Model.nEstablishmentYear.ToString() : "-";

    // ============================================================
    // SYSTEM DATA
    // ============================================================
    string createdDate =
        Model != null && Model.dCreatedDate != DateTime.MinValue
            ? Model.dCreatedDate.ToString("dd-MM-yyyy") : "-";

    string modifiedDate =
        Model?.dModifiedDate.HasValue == true
            ? Model.dModifiedDate.Value.ToString("dd-MM-yyyy") : "-";

    string organizationId = Model?.nOrgID > 0 ? Model.nOrgID.ToString() : "-";
    string profileId = Model?.nID > 0 ? Model.nID.ToString() : "-";

    bool isActive = Model?.nBit == true;
    bool isApproved = Model?.nSABit == true;

    // ============================================================
    // LOGO
    // ============================================================
    string defaultLogo = Url.Content("~/images/it-networkz-logo.png");
    string logoPath =
        !string.IsNullOrWhiteSpace(Model?.sCompanyLogo)
            ? Url.Content("~/uploads/organization/" + Model.sCompanyLogo)
            : defaultLogo;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>View Organization Profile - 1Trainee</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link href="~/css/vieworgprofile.css" rel="stylesheet" />
</head>

<body>

    <main class="profile-page">
        <article class="profile-card" id="organizationProfile">

            <!-- ================= COVER ================= -->
            <header class="profile-cover">

                <div class="cover-label">
                    <i class="fa-solid fa-building"></i>
                    <span>Organization Profile</span>
                </div>

                <div class="profile-actions">
                    <button type="button" class="profile-action-btn" title="Home" aria-label="Home" onclick="goHome()">
                        <i class="fa-solid fa-house"></i>
                    </button>
                    <button type="button" class="profile-action-btn" title="Print" aria-label="Print" onclick="printProfile()">
                        <i class="fa-solid fa-print"></i>
                    </button>
                    <button type="button" class="profile-action-btn" title="Download as PDF" aria-label="Download as PDF" onclick="downloadProfile()">
                        <i class="fa-solid fa-download"></i>
                    </button>
                </div>

            </header>

            <!-- ================= IDENTITY ================= -->
            <section class="organization-section">

                <div class="organization-logo">
                    <img src="@logoPath"
                         alt="@organizationName logo"
                         onerror="this.onerror=null;this.src='@defaultLogo';" />
                </div>

                <h1 class="organization-name" title="@organizationName">
                    <span class="organization-title">@organizationName</span>
                    <span class="verified-tick" title="Verified Organization"><i class="fa-solid fa-check"></i></span>
                </h1>

                <div class="organization-meta">
                    <span class="pill pill-verified">
                        <i class="fa-solid fa-circle-check"></i> Verified Organization
                    </span>
                    <span class="pill @(isActive ? "pill-ok" : "pill-off")">
                        <span class="pill-dot"></span> @(isActive ? "Active" : "Inactive")
                    </span>
                    <span class="pill @(isApproved ? "pill-ok" : "pill-warn")">
                        <i class="fa-solid @(isApproved ? "fa-shield-halved" : "fa-clock")"></i>
                        @(isApproved ? "Approved" : "Not Approved")
                    </span>
                </div>

            </section>

            <!-- ================= DETAILS ================= -->
            <section class="profile-body">

                <div class="information-grid">

                    <div class="information-card tone-teal">
                        <div class="information-icon"><i class="fa-solid fa-user"></i></div>
                        <div class="information-text">
                            <div class="information-label">Contact Person</div>
                            <div class="information-value" title="@contactName">@contactName</div>
                        </div>
                    </div>

                    <div class="information-card tone-blue">
                        <div class="information-icon"><i class="fa-solid fa-briefcase"></i></div>
                        <div class="information-text">
                            <div class="information-label">Designation</div>
                            <div class="information-value" title="@designation">@designation</div>
                        </div>
                    </div>

                    <div class="information-card tone-violet">
                        <div class="information-icon"><i class="fa-solid fa-envelope"></i></div>
                        <div class="information-text">
                            <div class="information-label">Verification Email</div>
                            <div class="information-value" title="@email">@email</div>
                        </div>
                    </div>

                    <div class="information-card tone-green">
                        <div class="information-icon"><i class="fa-solid fa-phone"></i></div>
                        <div class="information-text">
                            <div class="information-label">Mobile</div>
                            <div class="information-value" title="@mobile">@mobile</div>
                        </div>
                    </div>

                    <div class="information-card information-card-wide tone-red">
                        <div class="information-icon"><i class="fa-solid fa-location-dot"></i></div>
                        <div class="information-text">
                            <div class="information-label">Company Address</div>
                            <div class="information-value" title="@companyAddress">@companyAddress</div>
                        </div>
                    </div>

                    <div class="information-card tone-amber">
                        <div class="information-icon"><i class="fa-solid fa-calendar-days"></i></div>
                        <div class="information-text">
                            <div class="information-label">Established</div>
                            <div class="information-value" title="@establishmentYear">@establishmentYear</div>
                        </div>
                    </div>

                    <div class="information-card tone-sky">
                        <div class="information-icon"><i class="fa-solid fa-users"></i></div>
                        <div class="information-text">
                            <div class="information-label">Employee Strength</div>
                            <div class="information-value" title="@employeeStrength">@employeeStrength</div>
                        </div>
                    </div>

                    <div class="information-card tone-purple">
                        <div class="information-icon"><i class="fa-solid fa-file-invoice"></i></div>
                        <div class="information-text">
                            <div class="information-label">GST No.</div>
                            <div class="information-value" title="@gstNo">@gstNo</div>
                        </div>
                    </div>

                    <div class="information-card tone-slate">
                        <div class="information-icon"><i class="fa-solid fa-file-lines"></i></div>
                        <div class="information-text">
                            <div class="information-label">CIN No.</div>
                            <div class="information-value" title="@cinNo">@cinNo</div>
                        </div>
                    </div>

                    <div class="information-card tone-teal">
                        <div class="information-icon"><i class="fa-solid fa-calendar-plus"></i></div>
                        <div class="information-text">
                            <div class="information-label">Created On</div>
                            <div class="information-value" title="@createdDate">@createdDate</div>
                        </div>
                    </div>

                    <div class="information-card tone-blue">
                        <div class="information-icon"><i class="fa-solid fa-calendar-check"></i></div>
                        <div class="information-text">
                            <div class="information-label">Last Modified</div>
                            <div class="information-value" title="@modifiedDate">@modifiedDate</div>
                        </div>
                    </div>

                </div>

            </section>

            <!-- ================= FOOTER ================= -->
            <footer class="profile-footer">
                <span class="footer-brand">Powered by <strong>1Trainee</strong></span>
                <span class="footer-ids">Org ID <strong>@organizationId</strong> <i class="footer-sep"></i> Profile ID <strong>@profileId</strong></span>
            </footer>

        </article>
    </main>

    <script>
        function goHome() { window.location.href = "/"; }
        function printProfile() { window.print(); }
        function downloadProfile() { window.print(); } // choose "Save as PDF" in the print dialog
    </script>

</body>
</html>
