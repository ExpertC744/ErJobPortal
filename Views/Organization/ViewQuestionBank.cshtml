
@model List<ErJobPortal.Models.OrgQuestionBank>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "View Question Bank";
    ViewData["Panel"] = "Organization";

    string searchText = ViewBag.SearchText as string ?? "";
    string selectedCategory = ViewBag.SelectedCategory as string ?? "";
    string selectedStreamDomain = ViewBag.SelectedStreamDomain as string ?? "";
    string selectedStatus = ViewBag.SelectedStatus as string ?? "All";
}

<style>
    .qb-page {
        padding: 24px;
    }

    .qb-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        flex-wrap: wrap;
        margin-bottom: 24px;
    }

    .qb-header h2 {
        font-size: 26px;
        font-weight: 700;
        margin: 0 0 6px;
        color: #172554;
    }

    .qb-header p {
        color: #64748b;
        margin: 0;
    }

    .qb-add-btn {
        background: #2563eb;
        color: white;
        padding: 11px 17px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .qb-add-btn:hover {
        background: #1d4ed8;
        color: white;
    }

    .qb-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .qb-stat {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 20px;
    }

    .qb-stat span {
        color: #64748b;
        font-size: 13px;
    }

    .qb-stat h3 {
        margin: 8px 0 0;
        font-size: 28px;
        font-weight: 700;
        color: #0f172a;
    }

    .qb-filter-card {
        background: white;
        padding: 20px;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        margin-bottom: 22px;
    }

    .qb-filters {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr 1fr auto;
        gap: 12px;
        align-items: end;
    }

    .qb-field label {
        display: block;
        font-weight: 600;
        font-size: 13px;
        margin-bottom: 7px;
        color: #334155;
    }

    .qb-field input,
    .qb-field select {
        width: 100%;
        min-width: 0;
        padding: 10px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 7px;
        background: white;
        color: #0f172a;
    }

    .qb-filter-btn {
        padding: 10px 16px;
        border: none;
        border-radius: 7px;
        background: #0f172a;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

    .qb-reset-btn {
        display: inline-block;
        margin-top: 14px;
        color: #2563eb;
        text-decoration: none;
        font-size: 14px;
    }

    .qb-list-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 14px;
    }

    .qb-list-header h3 {
        margin: 0;
        font-size: 19px;
        font-weight: 700;
        color: #172554;
    }

    .qb-count {
        color: #64748b;
        font-size: 13px;
    }

    .qb-table-wrap {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow-x: auto;
    }

    .qb-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
    }

    .qb-table th {
        background: #f8fafc;
        color: #475569;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .4px;
        padding: 15px;
        text-align: left;
        white-space: nowrap;
    }

    .qb-table td {
        padding: 15px;
        border-top: 1px solid #e2e8f0;
        color: #334155;
        vertical-align: middle;
    }

    .qb-title {
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 5px;
    }

    .qb-subtitle {
        color: #64748b;
        font-size: 12px;
    }

    .qb-badge {
        display: inline-block;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .qb-published {
        color: #166534;
        background: #dcfce7;
    }

    .qb-draft {
        color: #92400e;
        background: #fef3c7;
    }

    .qb-actions {
        display: flex;
        gap: 7px;
        align-items: center;
    }

    .qb-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border: 1px solid #e2e8f0;
        border-radius: 7px;
        color: #334155;
        background: white;
        text-decoration: none;
        cursor: pointer;
    }

    .qb-action:hover {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .qb-empty {
        text-align: center;
        padding: 55px 20px;
        color: #64748b;
    }

    .qb-empty i {
        font-size: 35px;
        margin-bottom: 12px;
        color: #94a3b8;
    }

    @@media (max-width: 1100px) {
        .qb-filters {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .qb-filters .qb-search-field {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 650px) {
        .qb-page {
            padding: 14px;
        }

        .qb-stats {
            grid-template-columns: 1fr;
        }

        .qb-filters {
            grid-template-columns: 1fr;
        }

        .qb-filters .qb-search-field {
            grid-column: auto;
        }

        .qb-header h2 {
            font-size: 22px;
        }
    }
</style>

<div class="qb-page">

    <div class="qb-header">
        <div>
            <h2><i class="fas fa-file-alt"></i> View Question Bank</h2>
            <p>Manage your uploaded question papers and publication status.</p>
        </div>

        <a asp-controller="Organization"
           asp-action="UploadQuestionBank"
           class="qb-add-btn">
            <i class="fas fa-plus"></i> Upload Question Bank
        </a>
    </div>

    <div class="qb-stats">
        <div class="qb-stat">
            <span>Total Question Banks</span>
            <h3>@ViewBag.TotalCount</h3>
        </div>

        <div class="qb-stat">
            <span>Published</span>
            <h3>@ViewBag.PublishedCount</h3>
        </div>

        <div class="qb-stat">
            <span>Drafts</span>
            <h3>@ViewBag.DraftCount</h3>
        </div>
    </div>

    <div class="qb-filter-card">
        <form asp-controller="Organization"
              asp-action="ViewQuestionBank"
              method="get">

            <div class="qb-filters">

                <div class="qb-field qb-search-field">
                    <label for="searchText">Search</label>
                    <input type="text"
                           id="searchText"
                           name="searchText"
                           value="@searchText"
                           placeholder="Search title, subject or topics..." />
                </div>

                <div class="qb-field">
                    <label for="category">Category</label>
                    <select id="category" name="category">
                        <option value="">All Categories</option>
                        <option value="1" selected="@(selectedCategory == "1")">Interview Preparation</option>
                        <option value="2" selected="@(selectedCategory == "2")">Competitive Exams</option>
                        <option value="3" selected="@(selectedCategory == "3")">Academic Questions</option>
                        <option value="4" selected="@(selectedCategory == "4")">Aptitude &amp; Reasoning</option>
                        <option value="5" selected="@(selectedCategory == "5")">Technical Skills</option>
                        <option value="6" selected="@(selectedCategory == "6")">Placement Preparation</option>
                        <option value="7" selected="@(selectedCategory == "7")">Other</option>
                    </select>
                </div>

                <div class="qb-field">
                    <label for="streamDomain">Stream / Domain</label>
                    <select id="streamDomain" name="streamDomain">
                        <option value="">All Streams</option>
                        <option value="1" selected="@(selectedStreamDomain == "1")">Engineering</option>
                        <option value="2" selected="@(selectedStreamDomain == "2")">IT &amp; Computer Science</option>
                        <option value="3" selected="@(selectedStreamDomain == "3")">Commerce &amp; Finance</option>
                        <option value="4" selected="@(selectedStreamDomain == "4")">Management</option>
                        <option value="5" selected="@(selectedStreamDomain == "5")">Science</option>
                        <option value="6" selected="@(selectedStreamDomain == "6")">Medical &amp; Healthcare</option>
                        <option value="7" selected="@(selectedStreamDomain == "7")">Arts &amp; Humanities</option>
                        <option value="8" selected="@(selectedStreamDomain == "8")">Law</option>
                        <option value="9" selected="@(selectedStreamDomain == "9")">Polytechnic / ITI</option>
                        <option value="10" selected="@(selectedStreamDomain == "10")">Hospitality</option>
                        <option value="11" selected="@(selectedStreamDomain == "11")">Other</option>
                    </select>
                </div>

                <div class="qb-field">
                    <label for="status">Status</label>
                    <select id="status" name="status">
                        <option value="All" selected="@(selectedStatus == "All")">All Statuses</option>
                        <option value="Published" selected="@(selectedStatus == "Published")">Published</option>
                        <option value="Draft" selected="@(selectedStatus == "Draft")">Draft</option>
                    </select>
                </div>

                <div>
                    <button type="submit" class="qb-filter-btn">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>

            </div>

            <a asp-controller="Organization"
               asp-action="ViewQuestionBank"
               class="qb-reset-btn">
                <i class="fas fa-undo"></i> Clear Filters
            </a>
        </form>
    </div>

    <div class="qb-list-header">
        <h3>My Question Banks</h3>
        <span class="qb-count">@Model.Count record(s)</span>
    </div>

    <div class="qb-table-wrap">
        <table class="qb-table">
            <thead>
                <tr>
                    <th>Question Bank</th>
                    <th>Category</th>
                    <th>Stream / Domain</th>
                    <th>File</th>
                    <th>Created Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <div class="qb-title">@item.Title</div>
                                <div class="qb-subtitle">
                                    Subject: @item.Subject
                                </div>
                                <div class="qb-subtitle">
                                    Topics: @item.Topics
                                </div>
                            </td>

                            <td>@item.Category</td>
                            <td>@item.StreamDomain</td>

                            <td>
                                <div>@item.OriginalFileName</div>
                                <div class="qb-subtitle">
                                    @item.FileExtension.ToUpperInvariant()
                                    · @(item.FileSizeBytes / 1024) KB
                                </div>
                            </td>

                            <td>
                                @item.CreatedDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @if (item.IsPublished)
                                {
                                    <span class="qb-badge qb-published">Published</span>
                                }
                                else
                                {
                                    <span class="qb-badge qb-draft">Draft</span>
                                }
                            </td>

                            <td>
                                <div class="qb-actions">

                                    <a asp-controller="Organization"
                                       asp-action="ViewQuestionFile"
                                       asp-route-id="@item.QuestionBankID"
                                       class="qb-action"
                                       title="View question paper"
                                       aria-label="View question paper">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    <a asp-controller="Organization"
                                       asp-action="DownloadQuestionFile"
                                       asp-route-id="@item.QuestionBankID"
                                       class="qb-action"
                                       title="Download question paper"
                                       aria-label="Download question paper">
                                        <i class="fas fa-download"></i>
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7">
                            <div class="qb-empty">
                                <i class="fas fa-folder-open"></i>
                                <h4>No question banks found</h4>
                                <p>Upload a question paper or change your search filters.</p>

                                <a asp-controller="Organization"
                                   asp-action="UploadQuestionBank"
                                   class="qb-add-btn">
                                    Upload Question Bank
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>
