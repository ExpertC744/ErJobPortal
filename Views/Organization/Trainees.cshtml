@model List<ErJobPortal.Models.TraineeProfileListM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Trainee Profiles List";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<div class="container-fluid trainee-profiles-page">

    <!-- MASTER TABLE -->
    <div class="master-table-container">

        <div class="table-responsive">

            <!-- PAGE HEADER -->
            <div class="page-header mb-4">
                <h1>Trainee Profiles List</h1>
                <p>Total Trainees : @Model.Count</p>
            </div>

            <!-- TABLE -->
            <table id="traineeProfilesTable"
                   class="master-data-table">

                <thead>
                    <tr>

                        <th>
                            Sr.<br />No
                        </th>

                        <th>
                            Name
                        </th>

                        <th>
                            Photo
                        </th>

                        <th>
                            Technical Skill
                        </th>

                        <th>
                            Non-Technical Skill
                        </th>

                        <th>
                            Medical Skill
                        </th>

                        <th>
                            Location
                        </th>

                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var trainee in Model)
                        {
                            <tr>

                                <!-- SR NO -->
                                <td class="master-id text-center">
                                    @trainee.SrNo
                                </td>

                                <!-- NAME -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(trainee.CandidateName)
                                                                ? "NA"
                                                                : trainee.CandidateName)
                                </td>

                                <!-- PHOTO -->
                                <td class="text-center">

                                    @{
                                        string photoPath;

                                        if (string.IsNullOrWhiteSpace(trainee.Photo))
                                        {
                                            photoPath =
                                            Url.Content("~/images/default-profile.png");
                                        }
                                        else
                                        {
                                            photoPath =
                                            Url.Content(trainee.Photo);
                                        }
                                    }

                            <img src="@photoPath"
                                 alt="Trainee Image"
                                 class="trainee-profile-image"
                                 onerror="this.onerror=null;this.src='@Url.Content("~/images/default-profile.png")';" />

                        </td>

                        <!-- TECHNICAL SKILL -->
                        <td>
                            @(string.IsNullOrWhiteSpace(trainee.TechnicalSkill)
                                                        ? "NA"
                                                        : trainee.TechnicalSkill)
                                </td>

                                <!-- NON TECHNICAL SKILL -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(trainee.NonTechnicalSkill)
                                                                ? "NA"
                                                                : trainee.NonTechnicalSkill)
                                </td>

                                <!-- MEDICAL SKILL -->
                                <td>
                                    @(string.IsNullOrWhiteSpace(trainee.MedicalSkill)
                                                                ? "NA"
                                                                : trainee.MedicalSkill)
                                </td>

                                <!-- LOCATION -->
                                <td>

                                    @if (!string.IsNullOrWhiteSpace(trainee.Country))
                                    {
                                        @trainee.Country
                                    }

                                    @if (!string.IsNullOrWhiteSpace(trainee.State))
                                    {
                                        <br />
                                        @trainee.State
                                    }

                                    @if (!string.IsNullOrWhiteSpace(trainee.City))
                                    {
                                        <br />
                                        @trainee.City
                                    }

                                    @if (string.IsNullOrWhiteSpace(trainee.Country)
                                                                && string.IsNullOrWhiteSpace(trainee.State)
                                                                && string.IsNullOrWhiteSpace(trainee.City))
                                    {
                                        @:NA
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center">
                                No trainee profiles found.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGE INFORMATION -->
        <div id="traineeProfilesPageInfo"
             class="master-page-info d-none">
        </div>

    </div>

</div>


<script>

    $(document).ready(function () {

        $('#traineeProfilesTable').DataTable({

            pageLength: 25,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            searching: true,

            ordering: true,

            paging: true,

            info: true,

            autoWidth: false,

            responsive: false,

            columnDefs: [

                {
                    targets: 0,
                    className: "text-center"
                },

                {
                    targets: 2,
                    className: "text-center",
                    orderable: false
                }

            ],

            language: {

                search: "",

                searchPlaceholder: "Search...",

                lengthMenu: "_MENU_ entries per page",

                emptyTable: "No entries found",

                zeroRecords: "No matching records found",

                info: "Showing _START_ to _END_ of _TOTAL_ entries",

                infoEmpty: "Showing 0 to 0 of 0 entries"

            }

        });

    });

</script>

