@model List<ErJobPortal.Models.OrgFinalSelectionM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Selected Trainees";
    ViewData["Panel"] = "Organization";

    string orgCode = ViewBag.OrgCode?.ToString() ?? "";
}

<!-- FONT AWESOME -->
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<!-- DATATABLE CSS -->
<link rel="stylesheet"
      href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />


<div class="container-fluid selected-trainees-page">

    <div class="master-table-container">

        <!-- =================================
             PAGE HEADER
        ================================== -->

        <div class="master-table-title">

            <div>

                <h1>
                    Selected Trainees
                </h1>

                <p>
                    @orgCode
                </p>

            </div>

            <a asp-controller="Organization"
               asp-action="Dashboard"
               class="master-back-btn"
               title="Back to Dashboard">

                <i class="fas fa-arrow-left"></i>

            </a>

        </div>


        <!-- =================================
             TABLE WRAPPER
        ================================== -->

        <div class="selected-trainees-table-wrapper">

            <table id="selectedTraineesTable"
                   class="master-data-table"
                   style="width:100%;">

                <!-- TABLE HEADER -->
                <thead>

                    <tr>

                        <th>Sr. No</th>

                        <th>Post Date</th>

                        <th>Position</th>

                        <th>Name</th>

                        <th>Email ID</th>

                        <th>Skills</th>

                        <th>View Resume</th>

                    </tr>

                </thead>


                <!-- TABLE BODY -->
                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- SR NO -->
                                <td class="master-id text-center">

                                    @item.SrNo

                                </td>


                                <!-- POST DATE -->
                                <td>

                                    @(item.PostDate.HasValue
                                                                ? item.PostDate.Value.ToString("dd-MM-yyyy")
                                                                : "NA")

                                </td>


                                <!-- POSITION -->
                                <td>

                                    @(string.IsNullOrWhiteSpace(item.PositionName)
                                                                ? "NA"
                                                                : item.PositionName)

                                </td>


                                <!-- CANDIDATE NAME -->
                                <td>

                                    @(string.IsNullOrWhiteSpace(item.TraineeName)
                                                                ? "NA"
                                                                : item.TraineeName)

                                </td>


                                <!-- EMAIL -->
                                <td>

                                    @(string.IsNullOrWhiteSpace(item.EmailID)
                                                                ? "NA"
                                                                : item.EmailID)

                                </td>


                                <!-- SKILLS -->
                                <td>

                                    @(string.IsNullOrWhiteSpace(item.TraineeSkills)
                                                                ? "NA"
                                                                : item.TraineeSkills)

                        </td>


                                <!-- VIEW RESUME -->
                                <td class="resume-column text-center">

                            @if (item.ResumeCandidateID > 0)
                                    {
                                        <a asp-controller="Resume"
                                           asp-action="Resume"
                                           asp-route-id="@item.ResumeCandidateID"
                                           class="resume-view-btn"
                                           title="View Resume"
                                           target="_blank"
                                           rel="noopener noreferrer">

                                            <i class="fas fa-eye"></i>

                                        </a>
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        <!-- =================================
             PAGE INFORMATION
        ================================== -->

        <div id="selectedTraineesPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>


<!-- ==========================================
     CUSTOM CSS
========================================== -->

<style>

    /* MAIN CONTAINER */
    .selected-trainees-page {
        width: 100%;
    }

    /* TABLE WRAPPER */
    .selected-trainees-table-wrapper {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
    }

    /* DATATABLE MAIN WRAPPER */
    #selectedTraineesTable_wrapper {
        width: 100%;
        max-width: 100%;
    }

    /* TABLE */
    #selectedTraineesTable {
        width: 100% !important;
        border-collapse: separate !important;
        border-spacing: 0 8px !important;
        table-layout: auto;
    }

        /* TABLE HEADER */
        #selectedTraineesTable thead th {
            text-align: center;
            vertical-align: middle;
            white-space: nowrap;
            padding: 15px 12px;
        }

        /* TABLE BODY */
        #selectedTraineesTable tbody td {
            text-align: center;
            vertical-align: middle;
            padding: 15px 12px;
        }

            /* EMPTY TABLE MESSAGE */
            #selectedTraineesTable tbody td.dataTables_empty {
                background: #f1f7f5 !important;
                color: #333 !important;
                text-align: center !important;
                padding: 25px !important;
                border: none !important;
                font-size: 16px;
                border-radius: 0 0 8px 8px;
            }

        /* EMPTY ROW */
        #selectedTraineesTable tbody tr:has(td.dataTables_empty) {
            background: transparent !important;
            box-shadow: none !important;
        }

            /* REMOVE EXTRA ROW BACKGROUND */
            #selectedTraineesTable tbody tr:has(td.dataTables_empty):hover {
                background: transparent !important;
            }

    /* RESUME BUTTON */
    .resume-view-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 6px;
        color: #197d68;
        text-decoration: none;
        transition: 0.2s ease;
    }

        .resume-view-btn:hover {
            background: #e5f4ef;
            color: #116653;
        }

    /* SEARCH BOX */
    #selectedTraineesTable_wrapper .dataTables_filter input {
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 9px 12px;
        outline: none;
        margin-left: 8px;
    }

        #selectedTraineesTable_wrapper .dataTables_filter input:focus {
            border-color: #197d68;
        }

    /* ENTRIES DROPDOWN */
    #selectedTraineesTable_wrapper .dataTables_length select {
        border: 1px solid #ddd;
        border-radius: 7px;
        padding: 7px;
    }

    /* PAGINATION */
    #selectedTraineesTable_wrapper .dataTables_paginate {
        margin-top: 10px;
    }

    /* PAGE INFO */
    #selectedTraineesTable_wrapper .dataTables_info {
        padding-top: 15px;
    }

    @@media (max-width: 768px) {

        .selected-trainees-table-wrapper {
            overflow-x: auto;
        }

        #selectedTraineesTable {
            min-width: 850px !important;
        }

        #selectedTraineesTable_wrapper .dataTables_filter {
            float: none;
            text-align: left;
            margin-bottom: 12px;
        }

        #selectedTraineesTable_wrapper .dataTables_length {
            float: none;
            margin-bottom: 12px;
        }
    }
  </style>


<!-- ==========================================
     DATATABLE JAVASCRIPT
========================================== -->
@section Scripts {

    <!--
       IMPORTANT:
       jQuery should already be loaded in _DashboardLayout.cshtml.
       Do not load jQuery again here.
    -->

    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>


    <script>

        $(document).ready(function () {

            // CHECK JQUERY
            if (typeof jQuery === "undefined") {

                console.error("jQuery is not loaded.");

                return;
            }


            // CHECK DATATABLE
            if (!$.fn.DataTable) {

                console.error("DataTables is not loaded.");

                return;
            }


            // PREVENT DUPLICATE INITIALIZATION
            if ($.fn.DataTable.isDataTable('#selectedTraineesTable')) {

                $('#selectedTraineesTable')
                    .DataTable()
                    .destroy();

            }


            // INITIALIZE DATATABLE
            $('#selectedTraineesTable').DataTable({

                // BASIC SETTINGS
                paging: true,

                searching: true,

                ordering: true,

                info: true,

                autoWidth: false,

                // NO DUPLICATE HEADER
                scrollX: false,

                responsive: false,

                // PAGINATION
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100],
                    [10, 25, 50, 100]
                ],

                // DEFAULT ORDER
                order: [],

                // COLUMN SETTINGS
                columnDefs: [

                    {
                        targets: 0,
                        orderable: false,
                        className: "text-center"
                    },

                    {
                        targets: 6,
                        orderable: false,
                        searchable: false,
                        className: "text-center"
                    }

                ],

                // LANGUAGE
                language: {

                    search: "",

                    searchPlaceholder: "Search...",

                    lengthMenu: "_MENU_ entries per page",

                    emptyTable: "No selected trainees found.",

                    zeroRecords: "No matching trainees found.",

                    info: "Showing _START_ to _END_ of _TOTAL_ entries",

                    infoEmpty: "Showing 0 to 0 of 0 entries",

                    paginate: {

                        previous: "<",

                        next: ">"

                    }

                },

                // INITIALIZATION
                initComplete: function () {

                    this.api().columns.adjust();

                },

                // AFTER EACH DRAW
                drawCallback: function () {

                    this.api().columns.adjust();

                }

            });


        });

    </script>

}
