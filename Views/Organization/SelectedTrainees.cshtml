@model List<ErJobPortal.Models.OrgFinalSelectionM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Selected Trainees";
    ViewData["Panel"] = "Organization";

    string orgCode = ViewBag.OrgCode?.ToString() ?? "";
}

<div class="container-fluid selected-trainees-page">

    <div class="master-table-container">

        <!-- TABLE AREA -->
        <div class="table-responsive">

            <!-- PAGE TITLE -->
            <div class="page-header">

                <h1>
                    Selected Trainees
                </h1>

                <p>
                    @orgCode
                </p>

            </div>


            <!-- TABLE -->
            <table id="selectedTraineesTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>
                            Sr. No
                        </th>

                        <th>
                            Post Date
                        </th>

                        <th>
                            Position
                        </th>

                        <th>
                            Name
                        </th>

                        <th>
                            Email ID
                        </th>

                        <th>
                            Skills
                        </th>

                        <th>
                            View Resume
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Sr. No -->
                                <td class="master-id text-center">
                                    @item.SrNo
                                </td>


                                <!-- Post Date -->
                                <td>
                                    @if (item.PostDate.HasValue)
                                    {
                                        @item.PostDate.Value.ToString("dd-MM-yyyy")
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }
                                </td>


                                <!-- Position -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.PositionName))
                                    {
                                        @item.PositionName
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }
                                </td>


                                <!-- Candidate Name -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.TraineeName))
                                    {
                                        @item.TraineeName
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }
                                </td>


                                <!-- Email -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.EmailID))
                                    {
                                        @item.EmailID
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }
                                </td>


                                <!-- Skills -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.TraineeSkills))
                                    {
                                        @item.TraineeSkills
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }
                                </td>


                                <!-- View Resume -->
                                <td class="resume-column text-center">

                                    @if (item.ResumeCandidateID > 0)
                                    {
                                        <a asp-controller="Resume"
                                           asp-action="Resume"
                                           asp-route-id="@item.ResumeCandidateID"
                                           class="resume-view-btn"
                                           title="View Resume">

                                            <i class="fas fa-eye"></i>

                                        </a>
                                    }
                                    else
                                    {
                                        <span>NA</span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7"
                                class="text-center">

                                No selected trainees found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- PAGE INFORMATION -->
        <div id="selectedTraineesPageInfo"
             class="master-page-info d-none">
        </div>

    </div>

</div>


<script>

    $(document).ready(function () {

        $('#selectedTraineesTable').DataTable({

            pageLength: 25,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            searching: true,

            ordering: true,

            paging: true,

            info: true,

            autoWidth: false,

            responsive: true,

            columnDefs: [

                {
                    targets: 0,
                    className: "text-center"
                },

                {
                    targets: 6,
                    className: "text-center",
                    orderable: false
                }

            ],

            language: {

                search: "",

                searchPlaceholder: "Search...",

                lengthMenu: "_MENU_ entries per page",

                emptyTable: "No selected trainees found",

                zeroRecords: "No matching records found",

                info: "Showing _START_ to _END_ of _TOTAL_ entries",

                infoEmpty: "Showing 0 to 0 of 0 entries"

            }

        });

    });

</script>