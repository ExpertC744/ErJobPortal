@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Previous Post";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Atharv Infotech";
}

<div class="container-fluid">




    <!-- =====================================================
         MASTER TABLE
    ====================================================== -->

    <div class="master-table-container">




        <div class="table-responsive">
            <h1>
                Previous Post
            </h1>

            <p>
                @Model?.nID
            </p>
            <table id="previousPostTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>Sr. No</th>

                        <th>Position</th>

                        <th>Action</th>

                        <th>No. of Trainee</th>

                        <th>Gender</th>

                        <th>Minimum Qualification</th>

                        <th>Location</th>

                        <th>Working Hrs / Day</th>

                        <th>Weekly Working Days</th>

                        <th>Internship Type</th>

                        <th>Internship / Fellowship Type</th>

                        <th>Total Charges</th>

                        <th>Training Involved</th>

                        <th>Duration</th>

                        <th>Facilities Available</th>

                        <th>Internship Mode</th>

                        <th>Divyang (Allowed)</th>

                        <th>Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null)
                    {
                        <tr>

                            <td class="master-id">
                                1
                            </td>

                            <td>
                                @Model.sPositionName
                            </td>

                            <td class="master-action">

                                <!-- View -->
                                <a asp-controller="Organization"
                                   asp-action="ViewOrgPost"
                                   asp-route-id="@Model.nID"
                                   class="resume-view-btn"
                                   title="View Post">
                                    <i class="fas fa-eye"></i>
                                </a>

                                <!-- Edit -->
                                <a asp-controller="Organization"
                                   asp-action="EditPost"
                                   asp-route-id="@Model.nID"
                                   class="resume-edit-btn"
                                   title="Edit Post">
                                    <i class="fas fa-edit"></i>
                                </a>

                                <!-- Repost -->
                                <a asp-controller="Organization"
                                   asp-action="RepostOrgPost"
                                   asp-route-id="@Model.nID"
                                   class="resume-repost-btn"
                                   title="Repost">
                                    <i class="fas fa-redo"></i>
                                </a>

                            </td>

                            <td>
                                @Model.nRequiredTrainees
                            </td>

                            <td>
                                @Model.sGenderName
                            </td>

                            <td>
                                @Model.sMinimumQualificationName
                            </td>

                            <td>
                                @Model.sCountryName<br />
                                @Model.sStateName<br />
                                @Model.sCityName
                            </td>

                            <td>
                                @Model.sWorkingHours
                            </td>

                            <td>
                                @Model.sWorkingDays
                            </td>

                            <td>
                                @Model.sInternshipTypeName
                            </td>

                            <td>
                                @Model.sInternshipFellowshipTypeName
                            </td>

                            <td>
                                @if (Model.sTotalCharges > 0)
                                {
                                    @Model.sCurrency @Model.sTotalCharges
                                }
                                else
                                {
                                    @:NA
                                }
                            </td>

                            <td>
                                @Model.sTrainingInvolvedName
                            </td>

                            <td>
                                @Model.sInternshipDurationName
                            </td>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(Model.sFacilities))
                                {
                                    <i class="fas fa-wifi"
                                       title="@Model.sFacilities"></i>
                                }
                                else
                                {
                                    @:NA
                                }

                            </td>

                            <td>
                                @Model.sInternshipModeName
                            </td>

                            <td>
                                @Model.sDivyang
                            </td>

                            <td>

                                <span class="master-status">
                                    @(Model.nBit ? "Enabled" : "Disabled")
                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- =====================================================
             PAGE INFO
        ====================================================== -->

        <div id="previousPostPageInfo"
             class="master-page-info text-center d-none">
        </div>

    </div>

</div>


<!-- =========================================================
     DATATABLE
========================================================= -->

<script>

    $(document).ready(function () {

        $('#previousPostTable').DataTable({

            pageLength: 25,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            searching: true,

            ordering: true,

            paging: true,

            info: true,

            autoWidth: false,

            responsive: false,

            scrollX: true,

            language: {

                search: "",

                searchPlaceholder: "Search...",

                lengthMenu: "_MENU_ entries per page",

                emptyTable: "No entries found",

                zeroRecords: "No matching records found",

                info: "Showing _START_ to _END_ of _TOTAL_ entries",

                infoEmpty: "Showing 0 to 0 of 0 entries"

            },

            columnDefs: [

                {
                    targets: 0,
                    className: "text-center"
                },

                {
                    targets: 2,
                    className: "text-center",
                    orderable: false
                },

                {
                    targets: 3,
                    className: "text-center"
                },

                {
                    targets: 4,
                    className: "text-center"
                },

                {
                    targets: 11,
                    className: "text-center"
                },

                {
                    targets: 12,
                    className: "text-center"
                },

                {
                    targets: 13,
                    className: "text-center"
                },

                {
                    targets: 14,
                    className: "text-center"
                },

                {
                    targets: 15,
                    className: "text-center"
                },

                {
                    targets: 16,
                    className: "text-center"
                },

                {
                    targets: 17,
                    className: "text-center"
                }

            ]

        });

    });

</script>