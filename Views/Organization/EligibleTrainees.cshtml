@model List<EligibleTraineeM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Eligible Trainees";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";

    int postID = ViewBag.PostID ?? 0;
    string orgCode = ViewBag.OrgCode?.ToString() ?? "";
}

<div class="container-fluid eligible-trainees-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="eligible-page-header">

        <div>
            <h1>Eligible Trainees</h1>

            <p>
                @orgCode
            </p>
        </div>

        <!-- Back -->
        <a asp-controller="Organization"
           asp-action="Dashboard"
           asp-route-id="@orgCode"
           class="master-back-btn"
           title="Back to Dashboard">

            <i class="fas fa-arrow-left"></i>

        </a>

    </div>


    <!-- =====================================================
         MASTER TABLE
    ====================================================== -->

    <div class="master-table-container">

        <!-- =================================================
             TABLE HEADER
        ================================================== -->

        <div class="master-table-title">

            <div>

                <h2>
                    <i class="fas fa-table me-2"></i>
                    Eligible Trainees
                </h2>

            </div>

        </div>


        <!-- =================================================
             TABLE
        ================================================== -->

        <div class="table-responsive">

            <table id="eligibleTraineesTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>Sr. No</th>

                        <th>Name</th>

                        <th>View Resume</th>

                        <th>Email</th>

                        <th>Gender</th>

                        <th>DOB</th>

                        <th>Skills</th>

                        <th>Apply Status</th>

                        <th>Status</th>

                        <th>Final Result</th>

                        <th>Comment</th>

                        <th>Update Status</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        int srNo = 1;

                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- =================================================
                                     SR NO
                                ================================================== -->

                                <td class="master-id">

                                    @srNo

                                </td>


                                <!-- =================================================
                                     NAME
                                ================================================== -->

                                <td>

                                    @item.Name

                                </td>


                                <!-- =================================================
                                     VIEW RESUME
                                ================================================== -->

                                <td>

                                    <a asp-controller="Candidate"
                                       asp-action="Resume"
                                       asp-route-id="@item.CandidateID"
                                       class="resume-view-btn"
                                       title="View Resume">

                                        <i class="fas fa-eye"></i>

                                    </a>

                                </td>


                                <!-- =================================================
                                     EMAIL
                                ================================================== -->

                                <td>

                                    @item.EmailID

                                </td>


                                <!-- =================================================
                                     GENDER
                                ================================================== -->

                                <td>

                                    @item.Gender

                                </td>


                                <!-- =================================================
                                     DOB
                                ================================================== -->

                                <td>

                                    @(item.DateOfBirth.HasValue
                                                                ? item.DateOfBirth.Value.ToString("dd-MM-yyyy")
                                                                : "")

                                </td>


                                <!-- =================================================
                                     SKILLS
                                ================================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.MedicalSkillNames))
                                    {
                                        <strong>Medical:</strong>
                                        @item.MedicalSkillNames
                                        <br />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.TechnicalSkillNames))
                                    {
                                        <strong>Technical:</strong>
                                        @item.TechnicalSkillNames
                                        <br />
                                    }

                                    @if (!string.IsNullOrWhiteSpace(item.NonTechnicalSkillNames))
                                    {
                                        <strong>Non-Technical:</strong>
                                        @item.NonTechnicalSkillNames
                                    }

                                </td>


                                <!-- =================================================
                                     APPLY STATUS
                                ================================================== -->

                                <td>

                                    @if (item.CApply.HasValue)
                                    {
                                        @(item.CApply.Value == 1
                                                                    ? "Applied"
                                                                    : "Yet To Apply")
                                    }
                                    else
                                    {
                                        <span>Yet To Applied</span>
                                    }

                                </td>


                                <!-- =================================================
                                     STATUS
                                     Existing Status

                                     0 / NULL = Select Status
                                     1 = Shortlisted
                                     2 = Rejected
                                ================================================== -->

                                <td>

                                    <form asp-controller="Organization"
                                          asp-action="UpdateCandidateStatus"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="candidateId"
                                               value="@item.CandidateID" />

                                        <input type="hidden"
                                               name="postId"
                                               value="@item.PostID" />


                                        <select name="status"
                                                class="form-select candidate-status"
                                                onchange="if(this.value != '0') this.form.submit();">

                                            @if (string.IsNullOrEmpty(item.Status)
                                                                                || item.Status == "0")
                                            {
                                                <option value="0" selected>
                                                    Select Status
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="0">
                                                    Select Status
                                                </option>
                                            }


                                            @if (item.Status == "1")
                                            {
                                                <option value="1" selected>
                                                    Shortlisted
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="1">
                                                    Shortlisted
                                                </option>
                                            }


                                            @if (item.Status == "2")
                                            {
                                                <option value="2" selected>
                                                    Rejected
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="2">
                                                    Rejected
                                                </option>
                                            }

                                        </select>

                                    </form>

                                </td>


                                <!-- =================================================
                                     FINAL RESULT

                                     0 = Select a Final Result
                                     1 = Hold
                                     2 = Rejected
                                     3 = Shortlisted
                                ================================================== -->

                                <td>

                                    <select class="form-select final-result-select"
                                            data-candidate="@item.CandidateID"
                                            data-post="@item.PostID">

                                        @if (string.IsNullOrEmpty(item.FinalStatus)
                                                                        || item.FinalStatus == "0")
                                        {
                                            <option value="0" selected>
                                                Select a Final Result
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="0">
                                                Select a Final Result
                                            </option>
                                        }


                                        @if (item.FinalStatus == "1")
                                        {
                                            <option value="1" selected>
                                                Hold
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="1">
                                                Hold
                                            </option>
                                        }


                                        @if (item.FinalStatus == "2")
                                        {
                                            <option value="2" selected>
                                                Rejected
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="2">
                                                Rejected
                                            </option>
                                        }


                                        @if (item.FinalStatus == "3")
                                        {
                                            <option value="3" selected>
                                                Shortlisted
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="3">
                                                Shortlisted
                                            </option>
                                        }

                                    </select>

                                </td>


                                <!-- =================================================
                                     COMMENT

                                     Options are loaded dynamically according
                                     to Final Result
                                ================================================== -->

                                <td>

                                    <select class="form-select comment-select"
                                            data-current-comment="@item.Comment">

                                        <option value="0">
                                            Select a Comment
                                        </option>

                                    </select>

                                </td>


                                <!-- =================================================
                                     UPDATE STATUS

                                     This form submits:

                                     CandidateID
                                     PostID
                                     FinalStatus
                                     Comment

                                     OrganizationID comes from SESSION
                                ================================================== -->

                                <td>

                                    <form asp-controller="Organization"
                                          asp-action="UpdateCandidateFinalStatus"
                                          method="post"
                                          class="final-status-form">

                                        @Html.AntiForgeryToken()


                                        <!-- Candidate ID -->

                                        <input type="hidden"
                                               name="candidateId"
                                               value="@item.CandidateID" />


                                        <!-- Post ID -->

                                        <input type="hidden"
                                               name="postId"
                                               value="@item.PostID" />


                                        <!-- Final Status -->

                                        <input type="hidden"
                                               name="finalStatus"
                                               class="final-status-hidden"
                                               value="0" />


                                        <!-- Comment -->

                                        <input type="hidden"
                                               name="comment"
                                               class="comment-hidden"
                                               value="0" />


                                        <button type="submit"
                                                class="master-action-btn"
                                                onclick="return prepareFinalUpdate(this);">

                                            Update

                                        </button>

                                    </form>

                                </td>

                            </tr>

                            srNo++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="12"
                                class="text-center">

                                No eligible trainees found.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


<!-- =========================================================
     JAVASCRIPT
========================================================= -->

<script>

    // =========================================================
    // GET COMMENT OPTIONS BASED ON FINAL RESULT
    // =========================================================

    function getCommentOptions(finalStatus) {

        let options = [];


        // =====================================================
        // DEFAULT
        // =====================================================

        options.push({
            value: "0",
            text: "Select a Comment"
        });


        // =====================================================
        // HOLD
        //
        // Final Result = 1
        //
        // Comment:
        // 1 = On Hold May Consider
        // =====================================================

        if (finalStatus === "1") {

            options.push({
                value: "1",
                text: "On Hold May Consider"
            });

        }


        // =====================================================
        // REJECTED
        //
        // Final Result = 2
        //
        // Comment:
        // 0 = Select a Comment
        // 1 = Skills not Up to the mark
        // 2 = High Expectations
        // 3 = Other
        // =====================================================

        else if (finalStatus === "2") {

            options.push({
                value: "1",
                text: "Skills not Up to the mark"
            });

            options.push({
                value: "2",
                text: "High Expectations"
            });

            options.push({
                value: "3",
                text: "Other"
            });

        }


        // =====================================================
        // SHORTLISTED
        //
        // Final Result = 3
        //
        // Comment:
        // 0 = Select a Comment
        // 1 = OL under Process
        // =====================================================

        else if (finalStatus === "3") {

            options.push({
                value: "1",
                text: "OL under Process"
            });

        }


        return options;

    }


    // =========================================================
    // LOAD COMMENT DROPDOWN
    // =========================================================

    function loadCommentOptions(finalSelect) {

        const row = finalSelect.closest("tr");

        if (!row) {
            return;
        }


        const commentSelect =
            row.querySelector(".comment-select");


        if (!commentSelect) {
            return;
        }


        const finalStatus =
            finalSelect.value;


        // Existing saved comment from database

        const currentComment =
            commentSelect.getAttribute(
                "data-current-comment"
            ) || "0";


        // Clear existing options

        commentSelect.innerHTML = "";


        // Get new options

        const options =
            getCommentOptions(finalStatus);


        // Add options

        options.forEach(function (option) {

            const opt =
                document.createElement("option");


            opt.value =
                option.value;


            opt.text =
                option.text;


            // Select existing database value

            if (option.value === currentComment) {

                opt.selected = true;

            }


            commentSelect.appendChild(opt);

        });

    }


    // =========================================================
    // FINAL RESULT CHANGE
    // =========================================================

    document.addEventListener(
        "change",
        function (event) {

            if (
                event.target.classList.contains(
                    "final-result-select"
                )
            ) {

                loadCommentOptions(
                    event.target
                );

            }

        }
    );


    // =========================================================
    // PAGE LOAD
    //
    // Load comment options according to
    // existing FinalStatus from database.
    // =========================================================

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            document
                .querySelectorAll(
                    ".final-result-select"
                )
                .forEach(function (select) {

                    loadCommentOptions(
                        select
                    );

                });

        }
    );


    // =========================================================
    // UPDATE BUTTON
    // =========================================================

    function prepareFinalUpdate(button) {

        const row =
            button.closest("tr");


        if (!row) {

            alert(
                "Unable to find trainee record."
            );

            return false;

        }


        // =====================================================
        // GET FINAL RESULT
        // =====================================================

        const finalSelect =
            row.querySelector(
                ".final-result-select"
            );


        // =====================================================
        // GET COMMENT
        // =====================================================

        const commentSelect =
            row.querySelector(
                ".comment-select"
            );


        // =====================================================
        // GET FORM
        // =====================================================

        const form =
            button.closest(
                ".final-status-form"
            );


        if (!finalSelect ||
            !commentSelect ||
            !form) {

            alert(
                "Unable to process the update."
            );

            return false;

        }


        const finalStatus =
            finalSelect.value;


        const comment =
            commentSelect.value;


        // =====================================================
        // FINAL RESULT REQUIRED
        // =====================================================

        if (finalStatus === "0") {

            alert(
                "Please select a Final Result."
            );

            return false;

        }


        // =====================================================
        // COMMENT REQUIRED
        // =====================================================

        if (comment === "0") {

            alert(
                "Please select a Comment."
            );

            return false;

        }


        // =====================================================
        // SET HIDDEN FINAL STATUS
        // =====================================================

        const finalStatusHidden =
            form.querySelector(
                ".final-status-hidden"
            );


        finalStatusHidden.value =
            finalStatus;


        // =====================================================
        // SET HIDDEN COMMENT
        // =====================================================

        const commentHidden =
            form.querySelector(
                ".comment-hidden"
            );


        commentHidden.value =
            comment;


        // =====================================================
        // SUBMIT
        // =====================================================

        return true;

    }

</script>