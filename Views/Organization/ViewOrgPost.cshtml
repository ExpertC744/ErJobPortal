@model JobPortalTrainee.Models.OrgPostM

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "View Organization Post";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}
<link href="~/css/vieworgpost.css" rel="stylesheet" />
 
<!-- =========================================================
     MAIN PAGE
     ========================================================= -->

<div class="view-post-wrapper">

    <div class="post-card">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="post-header">

            <div class="company-logo">

                @if (!string.IsNullOrWhiteSpace(ViewBag.CompanyLogo))
                {
                    <img src="@Url.Content("~/uploads/organization/" + ViewBag.CompanyLogo)"
                         alt="Organization Logo" />
                }
                else
                {
                    <img src="~/images/HUNTCV.png"
                         alt="HUNTCV" />
                }

            </div>

            <div class="company-name">
                Organization Post
            </div>

        </div>


        <!-- =====================================================
             POST DETAILS
             ===================================================== -->

        <div class="post-details">


            <!-- =================================================
                 POST CREATED
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Post Created
                </div>

                <div class="detail-value">

                    @if (Model.dRegisterDate.HasValue)
                    {
                        @Model.dRegisterDate.Value.ToString("dd-MM-yyyy")
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 POST VALIDITY
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Post Validity
                </div>

                <div class="detail-value">

                    @Model.dCompletionDate.ToString("dd-MM-yyyy")

                </div>

            </div>


            <!-- =================================================
                 POSITION
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Position
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sPositionName))
                    {
                        @Model.sPositionName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 REQUIRED TRAINEES
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Required Trainees
                </div>

                <div class="detail-value">

                    @Model.nRequiredTrainees

                </div>

            </div>


            <!-- =================================================
                 GENDER
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Gender
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sGenderName))
                    {
                        @Model.sGenderName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 MINIMUM QUALIFICATION
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Minimum Qualification
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.sMinimumQualificationName))
                    {
                        @Model.sMinimumQualificationName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 COUNTRY
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Country
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sCountryName))
                    {
                        @Model.sCountryName
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.sCountryCode))
                    {
                        @Model.sCountryCode
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 STATE
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    State
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sStateName))
                    {
                        @Model.sStateName
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.sStateCode))
                    {
                        @Model.sStateCode
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 CITY
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    City
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sCityName))
                    {
                        @Model.sCityName
                    }
                    else if (Model.nCityID > 0)
                    {
                        @Model.nCityID
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 WORKING HOURS
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Working Hrs / Day
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sWorkingHours))
                    {
                        @Model.sWorkingHours
                        @:Hrs
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 INTERNSHIP TYPE
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Internship Type
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.sInternshipTypeName))
                    {
                        @Model.sInternshipTypeName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 WORKING SHIFT
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Working Shift
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sWorkingShift))
                    {
                        @Model.sWorkingShift
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 INTERNSHIP / FELLOWSHIP TYPE
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Internship / Fellowship Type
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.sInternshipFellowshipTypeName))
                    {
                        @Model.sInternshipFellowshipTypeName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 TOTAL CHARGES
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Total Charges
                </div>

                <div class="detail-value">

                    @if (Model.sTotalCharges.HasValue)
                    {
                        @Model.sTotalCharges.Value.ToString("0.00")

                        @if (!string.IsNullOrWhiteSpace(Model.sCurrency))
                        {
                            @: @Model.sCurrency
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 TRAINING INVOLVED
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Training Involved
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.sTrainingInvolvedName))
                    {
                        @Model.sTrainingInvolvedName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 INTERNSHIP DURATION
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Internship Duration
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.sInternshipDurationName))
                    {
                        @Model.sInternshipDurationName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 START DATE
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Start Date
                </div>

                <div class="detail-value">

                    @Model.dStartDate.ToString("dd-MM-yyyy")

                </div>

            </div>


            <!-- =================================================
                 COMPLETION DATE
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Completion Date
                </div>

                <div class="detail-value">

                    @Model.dCompletionDate.ToString("dd-MM-yyyy")

                </div>

            </div>


            <!-- =================================================
                 INTERNSHIP MODE
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Internship Mode
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.sInternshipModeName))
                    {
                        @Model.sInternshipModeName
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 DIVYANG
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Divyang (Allowed)
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sDivyang))
                    {
                        @Model.sDivyang
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 LANGUAGE KNOWN
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Language Known
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sLanguageKnown))
                    {
                        @Model.sLanguageKnown
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 WEEKLY WORKING DAYS
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Weekly Working Days
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sWorkingDays))
                    {
                        @Model.sWorkingDays
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>


            <!-- =================================================
                 FACILITIES
                 ================================================= -->

            <div class="detail-item">

                <div class="detail-label">
                    Facilities Available
                </div>

                <div class="detail-value">

                    @if (!string.IsNullOrWhiteSpace(Model.sFacilities))
                    {
                        @Model.sFacilities
                    }
                    else
                    {
                        <span>-</span>
                    }

                </div>

            </div>

            <!-- =================================================
            MEDICAL SKILLS
            ================================================= -->
            @if (!string.IsNullOrWhiteSpace(Model.sMedicalSkills))
            {
                <div class="detail-item">

                    <div class="detail-label">
                        Medical Skills Required
                    </div>

                    <div class="detail-value skill-value">
                        @Model.sMedicalSkills
                    </div>

                </div>
            }


            <!-- =================================================
            TECHNICAL SKILLS
            ================================================= -->
            @if (!string.IsNullOrWhiteSpace(Model.sTechnicalSkills))
            {
                <div class="detail-item">

                    <div class="detail-label">
                        Technical Skills Required
                    </div>

                    <div class="detail-value skill-value">
                        @Model.sTechnicalSkills
                    </div>

                </div>
            }


            <!-- =================================================
            NON-TECHNICAL SKILLS
            ================================================= -->
            @if (!string.IsNullOrWhiteSpace(Model.sNonTechnicalSkills))
            {
                <div class="detail-item">

                    <div class="detail-label">
                        Non-Technical Skills Required
                    </div>

                    <div class="detail-value skill-value">
                        @Model.sNonTechnicalSkills
                    </div>

                </div>
            }

        </div>


        <!-- =================================================
             POST ID
             ================================================= -->
        @*  <div class="detail-item">

                <div class="detail-label">
                    Post ID
                </div>

                <div class="detail-value">
                    @Model.nID
                </div>

            </div> *@


        <!-- =================================================
             ORGANIZATION ID
             ================================================= -->
        @* 
            <div class="detail-item">

                <div class="detail-label">
                    Organization ID
                </div>

                <div class="detail-value">
                    @Model.nOrgID
                </div>

            </div> *@


    </div>


    <!-- =====================================================
         POWERED BY
         ===================================================== -->

    <div class="powered-by">
        Powered by www.1trainee.com
    </div>

</div>

</div>


<!-- =========================================================
     RIGHT SIDE BUTTONS
     ========================================================= -->

<div class="right-buttons">

    <!-- HOME -->

    <a href="@Url.Action("Dashboard", "Organization")"
       class="right-button"
       title="Home">

        <i class="fa fa-home"></i>

    </a>


    <!-- PRINT -->

    <a href="javascript:window.print();"
       class="right-button"
       title="Print">

        <i class="fa fa-print"></i>

    </a>


    <!-- DOWNLOAD -->

    <a href="javascript:window.print();"
       class="right-button"
       title="Download">

        <i class="fa fa-download"></i>

    </a>

</div>


<!-- =========================================================
     ARROW
     ========================================================= -->

<div class="right-arrow">
    &gt;
</div>


<!-- =========================================================
     COPYRIGHT
     ========================================================= -->

<div class="copyright">

    Copyright © 2026 - All Rights Reserved with

    <a href="#">
        IPL
    </a>

</div>