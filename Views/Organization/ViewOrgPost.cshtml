@model ErJobPortal.Models.OrgPostM

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/ViewViewOrgPost.css" asp-append-version="true" />
@{
    Layout = null;
    ViewData["Title"] = "View Organization Post";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="view-post-page">

    <div class="post-card" id="postCard">

        <!-- HEADER -->
        <div class="post-header">
            <div class="header-content">
                <div class="header-badge">
                    <i class="fa-solid fa-building"></i>
                    ORGANIZATION POST
                </div>
                <h1 class="post-title">Organization Post</h1>
                <div class="post-subtitle">Internship and trainee opportunity details</div>
            </div>
        </div>

        <!-- PROFILE IMAGE -->
        <div class="profile-image-area">
            <div class="company-logo">
                @if (!string.IsNullOrWhiteSpace(ViewBag.CompanyLogo))
                {
                    <img src="@Url.Content("~/uploads/organization/" + ViewBag.CompanyLogo)" alt="Organization Logo" />
                }
                else
                {
                    <img src="@Url.Content("~/images/HUNTCV.png")" alt="HUNTCV" />
                }
            </div>
        </div>

        <!-- CONTENT -->
        <div class="post-content">

            <div class="section-title">
                <span class="section-icon"><i class="fa-solid fa-list"></i></span>
                <span>Post Information</span>
            </div>

            <div class="post-details">

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-calendar-days"></i></div>
                    <div class="detail-label">Post Created</div>
                    <div class="detail-value">@(Model.dRegisterDate?.ToString("dd-MM-yyyy") ?? "-")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-calendar-check"></i></div>
                    <div class="detail-label">Post Validity</div>
                    <div class="detail-value">@Model.dCompletionDate.ToString("dd-MM-yyyy")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-briefcase"></i></div>
                    <div class="detail-label">Position</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sPositionName) ? "-" : Model.sPositionName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-users"></i></div>
                    <div class="detail-label">Required Trainees</div>
                    <div class="detail-value">@Model.nRequiredTrainees</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-user"></i></div>
                    <div class="detail-label">Gender</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sGenderName) ? "-" : Model.sGenderName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-graduation-cap"></i></div>
                    <div class="detail-label">Minimum Qualification</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sMinimumQualificationName) ? "-" : Model.sMinimumQualificationName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-globe"></i></div>
                    <div class="detail-label">Country</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sCountryName) ? "-" : Model.sCountryName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-map"></i></div>
                    <div class="detail-label">State</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sStateName) ? "-" : Model.sStateName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div class="detail-label">City</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.nCityName) ? "-" : Model.nCityName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-clock"></i></div>
                    <div class="detail-label">Working Hrs / Day</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sWorkingHours) ? "-" : Model.sWorkingHours + " Hrs")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-tag"></i></div>
                    <div class="detail-label">Internship Type</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sInternshipTypeName) ? "-" : Model.sInternshipTypeName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-business-time"></i></div>
                    <div class="detail-label">Working Shift</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sWorkingShift) ? "-" : Model.sWorkingShift)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-book-open"></i></div>
                    <div class="detail-label">Internship / Fellowship Type</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sInternshipFellowshipTypeName) ? "-" : Model.sInternshipFellowshipTypeName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
                    <div class="detail-label">Total Charges</div>
                    <div class="detail-value">@(Model.sTotalCharges.HasValue ? Model.sTotalCharges.Value.ToString("0.00") + (string.IsNullOrWhiteSpace(Model.sCurrency) ? "" : " " + Model.sCurrency) : "-")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-chalkboard-user"></i></div>
                    <div class="detail-label">Training Involved</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sTrainingInvolvedName) ? "-" : Model.sTrainingInvolvedName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-hourglass-half"></i></div>
                    <div class="detail-label">Internship Duration</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sInternshipDurationName) ? "-" : Model.sInternshipDurationName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-calendar-plus"></i></div>
                    <div class="detail-label">Start Date</div>
                    <div class="detail-value">@(Model.dStartDate?.ToString("dd-MM-yyyy") ?? "-")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-calendar-xmark"></i></div>
                    <div class="detail-label">Completion Date</div>
                    <div class="detail-value">@Model.dCompletionDate.ToString("dd-MM-yyyy")</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-laptop-house"></i></div>
                    <div class="detail-label">Internship Mode</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sInternshipModeName) ? "-" : Model.sInternshipModeName)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-wheelchair"></i></div>
                    <div class="detail-label">Divyang (Allowed)</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sDivyang) ? "-" : Model.sDivyang)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-language"></i></div>
                    <div class="detail-label">Language Known</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sLanguageKnown) ? "-" : Model.sLanguageKnown)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-calendar-week"></i></div>
                    <div class="detail-label">Weekly Working Days</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sWorkingDays) ? "-" : Model.sWorkingDays)</div>
                </div>

                <div class="detail-item">
                    <div class="detail-icon"><i class="fa-solid fa-certificate"></i></div>
                    <div class="detail-label">Facilities Available</div>
                    <div class="detail-value">@(string.IsNullOrWhiteSpace(Model.sFacilities) ? "-" : Model.sFacilities)</div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.sMedicalSkills))
                {
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fa-solid fa-notes-medical"></i></div>
                        <div class="detail-label">Medical Skills Required</div>
                        <div class="detail-value skill-value">@Model.sMedicalSkills</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.sTechnicalSkills))
                {
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fa-solid fa-code"></i></div>
                        <div class="detail-label">Technical Skills Required</div>
                        <div class="detail-value skill-value">@Model.sTechnicalSkills</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.sNonTechnicalSkills))
                {
                    <div class="detail-item">
                        <div class="detail-icon"><i class="fa-solid fa-comments"></i></div>
                        <div class="detail-label">Non-Technical Skills Required</div>
                        <div class="detail-value skill-value">@Model.sNonTechnicalSkills</div>
                    </div>
                }

            </div>
        </div>

        <!-- PREVIOUS / NEXT -->
        <div class="post-navigation">
            @if (ViewBag.PreviousPostId != null)
            {
                <a asp-controller="Organization"
                   asp-action="ViewOrgPost"
                   asp-route-id="@ViewBag.PreviousPostId"
                   asp-route-source="@ViewBag.PostSource"
                   class="post-nav-btn previous-btn"
                   title="Previous Post">
                    <i class="fa-solid fa-chevron-left"></i>
                    <span>Previous</span>
                </a>
            }

            @if (ViewBag.NextPostId != null)
            {
                <a asp-controller="Organization"
                   asp-action="ViewOrgPost"
                   asp-route-id="@ViewBag.NextPostId"
                   asp-route-source="@ViewBag.PostSource"
                   class="post-nav-btn next-btn"
                   title="Next Post">
                    <span>Next</span>
                    <i class="fa-solid fa-chevron-right"></i>
                </a>
            }
        </div>

        <!-- FOOTER -->
        <div class="post-footer">
            Powered by <strong>www.1trainee.com</strong>
        </div>

    </div>

    <!-- RIGHT BUTTONS -->
    <div class="right-buttons">
        <a href="@Url.Action("Dashboard", "Organization")" class="right-button" title="Home">
            <i class="fa-solid fa-house"></i>
        </a>
        <a href="#" id="btnPrint" class="right-button" title="Print">
            <i class="fa-solid fa-print"></i>
        </a>
        <a href="#" id="btnDownload" class="right-button" title="Download PDF">
            <i class="fa-solid fa-download"></i>
        </a>
        <a href="@Url.Action("Dashboard", "Organization")"
   class="right-button"
   title="Back to Dashboard"
   aria-label="Back to Dashboard">
    <i class="fa-solid fa-arrow-left"></i>
</a>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    (function () {

        var postId = "@(Context.Request.RouteValues["id"])";

        // PRINT
        document.getElementById("btnPrint").addEventListener("click", function (e) {
            e.preventDefault();
            window.print();
        });

        // DOWNLOAD - single page, same layout as print
        document.getElementById("btnDownload").addEventListener("click", function (e) {
            e.preventDefault();

            var btn  = this;
            var icon = btn.querySelector("i");
            var card = document.getElementById("postCard");

            btn.style.pointerEvents = "none";
            icon.className = "fa-solid fa-spinner fa-spin";

            // hidden copy: on-screen position, invisible, behind the page
            var holder = document.createElement("div");
            holder.style.cssText =
                "position:fixed;left:0;top:0;width:1250px;z-index:-1;" +
                "opacity:0;pointer-events:none;background:#fff;";

            var stage = document.createElement("div");
            stage.className = "pdf-stage";

            var clone = card.cloneNode(true);
            clone.removeAttribute("id");

            stage.appendChild(clone);
            holder.appendChild(stage);
            document.body.appendChild(holder);

            function done() {
                if (holder.parentNode) holder.parentNode.removeChild(holder);
                icon.className = "fa-solid fa-download";
                btn.style.pointerEvents = "";
            }

            var ready = (document.fonts && document.fonts.ready)
                ? document.fonts.ready
                : Promise.resolve();

            ready.then(function () {
                setTimeout(function () {

                    var w = 1250;
                    var h = Math.ceil(stage.getBoundingClientRect().height) + 2; // +2 prevents a 2nd page

                    html2pdf().set({
                        margin: 0,
                        filename: "OrganizationPost-" + postId + ".pdf",
                        image: { type: "jpeg", quality: 0.98 },
                        html2canvas: {
                            scale: 2,
                            useCORS: true,
                            scrollX: 0,
                            scrollY: 0,
                            backgroundColor: "#ffffff"
                        },
                        jsPDF: {
                            unit: "px",
                            format: [w, h],
                            orientation: "landscape",
                            hotfixes: ["px_scaling"]
                        },
                        pagebreak: { mode: [] }
                    })
                    .from(stage)
                    .toPdf()
                    .get("pdf")
                    .then(function (pdf) {
                        // keep only page 1
                        var n = pdf.internal.getNumberOfPages();
                        while (n > 1) { pdf.deletePage(n); n--; }
                    })
                    .save()
                    .then(done)
                    .catch(function (err) {
                        console.error(err);
                        done();
                    });

                }, 300);
            });
        });

    })();
</script>