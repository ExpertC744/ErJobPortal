@model ErJobPortal.Models.OrgPostM

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/ViewViewOrgPost.css" asp-append-version="true" />
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
       Layout = null;
    ViewData["Title"] = "View Organization Post";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />



<!-- =========================================================
     PAGE
     ========================================================= -->

<div class="view-post-page">


    <!-- =====================================================
         MAIN CARD
         ===================================================== -->

    <div class="post-card">


        <!-- =================================================
             HEADER
             ================================================= -->

        <div class="post-header">

            <div class="header-content">

                <div class="header-badge">

                    <i class="fa-solid fa-building"></i>

                    ORGANIZATION POST

                </div>


                <h1 class="post-title">
                    Organization Post
                </h1>


                <div class="post-subtitle">
                    Internship and trainee opportunity details
                </div>

            </div>

        </div>


        <!-- =================================================
             PROFILE IMAGE
             Separate area so image is NEVER clipped
             ================================================= -->

        <div class="profile-image-area">

            <div class="company-logo">

                @if (!string.IsNullOrWhiteSpace(ViewBag.CompanyLogo))
                {
                    <img src="@Url.Content("~/uploads/organization/" + ViewBag.CompanyLogo)"
                         alt="Organization Logo" />
                }
                else
                {
                    <img src="@Url.Content("~/images/HUNTCV.png")"
                         alt="HUNTCV" />
                }

            </div>

        </div>


        <!-- =================================================
             CONTENT
             ================================================= -->

        <div class="post-content">


            <!-- =================================================
                 SECTION TITLE
                 ================================================= -->

            <div class="section-title">

                <span class="section-icon">
                    <i class="fa-solid fa-list"></i>
                </span>

                <span>
                    Post Information
                </span>

            </div>


            <!-- =================================================
                 DETAILS
                 ================================================= -->

            <div class="post-details">


                <!-- POST CREATED -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>

                    <div class="detail-label">
                        Post Created
                    </div>

                    <div class="detail-value">

                        @if (Model.dRegisterDate.HasValue)
                        {
                            @Model.dRegisterDate.Value.ToString("dd-MM-yyyy")
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- POST VALIDITY -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-calendar-check"></i>
                    </div>

                    <div class="detail-label">
                        Post Validity
                    </div>

                    <div class="detail-value">
                        @Model.dCompletionDate.ToString("dd-MM-yyyy")
                    </div>

                </div>


                <!-- POSITION -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-briefcase"></i>
                    </div>

                    <div class="detail-label">
                        Position
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sPositionName))
                        {
                            @Model.sPositionName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- REQUIRED TRAINEES -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-users"></i>
                    </div>

                    <div class="detail-label">
                        Required Trainees
                    </div>

                    <div class="detail-value">
                        @Model.nRequiredTrainees
                    </div>

                </div>


                <!-- GENDER -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="detail-label">
                        Gender
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sGenderName))
                        {
                            @Model.sGenderName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- MINIMUM QUALIFICATION -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>

                    <div class="detail-label">
                        Minimum Qualification
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sMinimumQualificationName))
                        {
                            @Model.sMinimumQualificationName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- COUNTRY -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-globe"></i>
                    </div>

                    <div class="detail-label">
                        Country
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sCountryName))
                        {
                            @Model.sCountryName
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.sCountryName))
                        {
                            @Model.sCountryName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- STATE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-map"></i>
                    </div>

                    <div class="detail-label">
                        State
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sStateName))
                        {
                            @Model.sStateName
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.sStateName))
                        {
                            @Model.sStateName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- CITY -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-location-dot"></i>
                    </div>

                    <div class="detail-label">
                        City
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.nCityName))
                        {
                            @Model.nCityName
                        }
                        @* else if (Model.nCityName > 0)
                        {
                            @Model.nCityName
                        } *@
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- WORKING HOURS -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>

                    <div class="detail-label">
                        Working Hrs / Day
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sWorkingHours))
                        {
                            @Model.sWorkingHours @:Hrs
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- INTERNSHIP TYPE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-tag"></i>
                    </div>

                    <div class="detail-label">
                        Internship Type
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sInternshipTypeName))
                        {
                            @Model.sInternshipTypeName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- WORKING SHIFT -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-business-time"></i>
                    </div>

                    <div class="detail-label">
                        Working Shift
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sWorkingShift))
                        {
                            @Model.sWorkingShift
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- INTERNSHIP / FELLOWSHIP TYPE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-book-open"></i>
                    </div>

                    <div class="detail-label">
                        Internship / Fellowship Type
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sInternshipFellowshipTypeName))
                        {
                            @Model.sInternshipFellowshipTypeName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- TOTAL CHARGES -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-indian-rupee-sign"></i>
                    </div>

                    <div class="detail-label">
                        Total Charges
                    </div>

                    <div class="detail-value">

                        @if (Model.sTotalCharges.HasValue)
                        {
                            @Model.sTotalCharges.Value.ToString("0.00")

                            @if (!string.IsNullOrWhiteSpace(Model.sCurrency))
                            {
                                @: @Model.sCurrency
                            }
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- TRAINING INVOLVED -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>

                    <div class="detail-label">
                        Training Involved
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sTrainingInvolvedName))
                        {
                            @Model.sTrainingInvolvedName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- INTERNSHIP DURATION -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-hourglass-half"></i>
                    </div>

                    <div class="detail-label">
                        Internship Duration
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sInternshipDurationName))
                        {
                            @Model.sInternshipDurationName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- START DATE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-calendar-plus"></i>
                    </div>

                    <div class="detail-label">
                        Start Date
                    </div>

                    <div class="detail-value">
                        @(Model.dStartDate?.ToString("dd-MM-yyyy") ?? "-")
                    </div>

                </div>


                <!-- COMPLETION DATE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </div>

                    <div class="detail-label">
                        Completion Date
                    </div>

                    <div class="detail-value">
                        @Model.dCompletionDate.ToString("dd-MM-yyyy")
                    </div>

                </div>


                <!-- INTERNSHIP MODE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-laptop-house"></i>
                    </div>

                    <div class="detail-label">
                        Internship Mode
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sInternshipModeName))
                        {
                            @Model.sInternshipModeName
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- DIVYANG -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-wheelchair"></i>
                    </div>

                    <div class="detail-label">
                        Divyang (Allowed)
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sDivyang))
                        {
                            @Model.sDivyang
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- LANGUAGE -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-language"></i>
                    </div>

                    <div class="detail-label">
                        Language Known
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sLanguageKnown))
                        {
                            @Model.sLanguageKnown
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- WORKING DAYS -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-calendar-week"></i>
                    </div>

                    <div class="detail-label">
                        Weekly Working Days
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sWorkingDays))
                        {
                            @Model.sWorkingDays
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- FACILITIES -->

                <div class="detail-item">

                    <div class="detail-icon">
                        <i class="fa-solid fa-certificate"></i>
                    </div>

                    <div class="detail-label">
                        Facilities Available
                    </div>

                    <div class="detail-value">

                        @if (!string.IsNullOrWhiteSpace(Model.sFacilities))
                        {
                            @Model.sFacilities
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>


                <!-- MEDICAL SKILLS -->

                @if (!string.IsNullOrWhiteSpace(Model.sMedicalSkills))
                {
                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="fa-solid fa-notes-medical"></i>
                        </div>

                        <div class="detail-label">
                            Medical Skills Required
                        </div>

                        <div class="detail-value skill-value">
                            @Model.sMedicalSkills
                        </div>

                    </div>
                }


                <!-- TECHNICAL SKILLS -->

                @if (!string.IsNullOrWhiteSpace(Model.sTechnicalSkills))
                {
                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="fa-solid fa-code"></i>
                        </div>

                        <div class="detail-label">
                            Technical Skills Required
                        </div>

                        <div class="detail-value skill-value">
                            @Model.sTechnicalSkills
                        </div>

                    </div>
                }


                <!-- NON TECHNICAL SKILLS -->

                @if (!string.IsNullOrWhiteSpace(Model.sNonTechnicalSkills))
                {
                    <div class="detail-item">

                        <div class="detail-icon">
                            <i class="fa-solid fa-comments"></i>
                        </div>

                        <div class="detail-label">
                            Non-Technical Skills Required
                        </div>

                        <div class="detail-value skill-value">
                            @Model.sNonTechnicalSkills
                        </div>

                    </div>
                }


            </div>

        </div>


        <!-- =================================================
             FOOTER
             ================================================= -->

        <div class="post-footer">

            Powered by
            <strong>www.1trainee.com</strong>

        </div>

    </div>

    <div class="post-navigation">

        @if (ViewBag.PreviousPostId != null)
        {
            <a asp-controller="Organization"
               asp-action="ViewOrgPost"
               asp-route-id="@ViewBag.PreviousPostId"
               class="post-nav-btn previous-btn"
               title="Previous Post">

                <i class="fa-solid fa-chevron-left"></i>
                <span>Previous</span>

            </a>
        }

        @if (ViewBag.NextPostId != null)
        {
            <a asp-controller="Organization"
               asp-action="ViewOrgPost"
               asp-route-id="@ViewBag.NextPostId"
               class="post-nav-btn next-btn"
               title="Next Post">

                <span>Next</span>
                <i class="fa-solid fa-chevron-right"></i>

            </a>
        }

    </div>


    <!-- =====================================================
     RIGHT BUTTONS
     ===================================================== -->

    <div class="right-buttons">

        <a href="@Url.Action("Dashboard", "Organization")"
           class="right-button"
           title="Home">

            <i class="fa-solid fa-house"></i>

        </a>

        <a href="javascript:window.print();"
           class="right-button"
           title="Print">

            <i class="fa-solid fa-print"></i>

        </a>

        <a href="javascript:window.print();"
           class="right-button"
           title="Download">

            <i class="fa-solid fa-download"></i>

        </a>

    </div>


    <!-- =====================================================
         RIGHT BUTTONS
         ===================================================== -->

    <div class="right-buttons">

        <a href="@Url.Action("Dashboard", "Organization")"
           class="right-button"
           title="Home">

            <i class="fa-solid fa-house"></i>

        </a>


        <a href="javascript:window.print();"
           class="right-button"
           title="Print">

            <i class="fa-solid fa-print"></i>

        </a>


        <a href="javascript:window.print();"
           class="right-button"
           title="Download">

            <i class="fa-solid fa-download"></i>

        </a>

    </div>


</div>