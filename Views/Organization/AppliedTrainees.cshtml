@model List<ErJobPortal.Models.OrgPostM>

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Applied Trainees";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<div class="container-fluid applied-trainees-page">

    <!-- MASTER TABLE -->
    <div class="master-table-container">

        <!-- PAGE HEADER -->
        <div class="page-header mb-4">

            <h1>
                Applied Trainees
            </h1>

            <p>
                @ViewBag.OrgCode
            </p>

        </div>

        <!-- TABLE -->
        <div class="table-responsive">

            <table id="appliedTraineesTable"
                   class="master-data-table">

                <thead>

                    <tr>

                        <th>
                            Sr. No.
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            Position
                        </th>

                        <th>
                            View Post
                        </th>

                        <th>
                            Applied Trainees
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int srNo = 1;
                    }

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>

                                <!-- Sr. No. -->
                                <td class="master-id">
                                    @srNo
                                </td>

                                <!-- Date -->
                                <td>
                                    @(item.dStartDate.HasValue
                                                                ? item.dStartDate.Value.ToString("dd-MM-yyyy")
                                                                : "")
                                </td>

                                <!-- Position -->
                                <td>
                                    @item.sPositionName
                                </td>

                                <!-- View Post -->
                                <td class="text-center">

                                    <a asp-controller="Organization"
                                       asp-action="ViewOrgPost"
                                       asp-route-id="@item.nID"
                                       class="resume-view-btn"
                                       title="View Post">

                                        <i class="fas fa-eye"></i>

                                    </a>

                                </td>

                                @* AppliedTrainee.cshtml *@ 
                                        <td class="text-center">

                                    <a asp-controller="Organization"
                                       asp-action="OrgPositionTR"
                                       asp-route-id="@item.nID"
                                       class="resume-view-btn"
                                       title="View Applied Trainees">

                                        <i class="fas fa-users"></i>

                                        @* Optional count *@
                                        <span>
                                            @item.MatchingTraineeCount
                                        </span>

                                    </a>

                                </td>

                            </tr>

                            srNo++;
                        }
                    }

                </tbody>

            </table>

        </div>

        <!-- PAGE INFORMATION -->
        <div id="appliedTraineesPageInfo"
             class="master-page-info d-none">
        </div>

    </div>

</div>


<script>

    $(document).ready(function () {

        $('#appliedTraineesTable').DataTable({

            pageLength: 25,

            lengthMenu: [
                [10, 25, 50, 100],
                [10, 25, 50, 100]
            ],

            searching: true,

            ordering: true,

            paging: true,

            info: true,

            autoWidth: false,

            responsive: true,

            columnDefs: [

                {
                    targets: 0,
                    className: "text-center"
                },

                {
                    targets: [3, 4],
                    className: "text-center",
                    orderable: false
                }

            ],

            language: {

                search: "",

                searchPlaceholder: "Search...",

                lengthMenu: "_MENU_ entries per page",

                emptyTable: "No applied trainees found.",

                zeroRecords: "No matching records found",

                info: "Showing _START_ to _END_ of _TOTAL_ entries",

                infoEmpty: "Showing 0 to 0 of 0 entries"

            }

        });

    });

</script>