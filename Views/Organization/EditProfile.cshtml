<!-- =========================================================
     LOGO PREVIEW SCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const logoInput =
            document.getElementById("OrganizationLogo");

        const logoPreview =
            document.getElementById("logoPreview");

        const defaultLogoIcon =
            document.getElementById("defaultLogoIcon");

        const logoFileName =
            document.getElementById("logoFileName");


        if (!logoInput) {
            return;
        }


        logoInput.addEventListener("change", function () {

            const file = this.files[0];


            if (!file) {

                logoPreview.style.display = "none";

                defaultLogoIcon.style.display = "block";

                logoFileName.textContent =
                    "No file selected";

                return;
            }


            /* FILE NAME */

            logoFileName.textContent =
                file.name;


            /* CHECK IMAGE */

            if (!file.type.startsWith("image/")) {

                logoPreview.style.display = "none";

                defaultLogoIcon.style.display = "block";

                logoFileName.textContent =
                    "Please select an image";

                this.value = "";

                return;
            }


            /* PREVIEW */

            const reader =
                new FileReader();


            reader.onload = function (event) {

                logoPreview.src =
                    event.target.result;

                logoPreview.style.display =
                    "block";

                defaultLogoIcon.style.display =
                    "none";

            };


            reader.readAsDataURL(file);

        });

    });

</script>