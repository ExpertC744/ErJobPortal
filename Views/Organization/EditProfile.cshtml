@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    ViewData["Title"] = "Organization Profile";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<style>

    /* =========================================================
               ORGANIZATION PROFILE PAGE
            ========================================================= */

    .org-profile-page {
        width: 100%;
        padding: 8px 12px 30px;
        background: #f8fafb;
        color: #344054;
    }


    /* =========================================================
               PAGE HEADER
            ========================================================= */

    .org-profile-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
    }

    .org-profile-title h2 {
        margin: 0;
        color: #1f2937;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.3;
    }

    .org-profile-title p {
        margin: 5px 0 0;
        color: #8b95a5;
        font-size: 13px;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 13px;
        background: #e8f7f2;
        color: #1e7b67;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .profile-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #1e7b67;
    }


    /* =========================================================
               MAIN CARD
            ========================================================= */

    .org-profile-card {
        width: 100%;
        background: #ffffff;
        border: 1px solid #e8ecee;
        border-radius: 15px;
        box-shadow: 0 6px 25px rgba(30, 123, 103, 0.06);
        overflow: hidden;
    }


    /* =========================================================
               CARD HEADER
            ========================================================= */

    .org-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 17px 22px;
        background: #ffffff;
        border-bottom: 1px solid #edf0f2;
    }

    .org-card-icon {
        width: 42px;
        height: 42px;
        min-width: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e8f5f1;
        color: #1e7b67;
        border-radius: 11px;
        font-size: 17px;
    }

    .org-card-header h5 {
        margin: 0;
        color: #1f2937;
        font-size: 16px;
        font-weight: 700;
    }

    .org-card-header span {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 12px;
    }


    /* =========================================================
               FORM
            ========================================================= */

    .org-profile-form {
        padding: 22px;
    }


    /* =========================================================
               FORM SECTION
            ========================================================= */

    .form-section {
        margin-bottom: 23px;
    }

        .form-section:last-child {
            margin-bottom: 0;
        }


    /* =========================================================
               SECTION TITLE
            ========================================================= */

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 15px;
        padding-bottom: 9px;
        border-bottom: 1px solid #edf0f2;
    }

        .section-title i {
            width: 25px;
            height: 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 7px;
            background: #e8f5f1;
            color: #1e7b67;
            font-size: 11px;
        }

        .section-title span {
            color: #344054;
            font-size: 14px;
            font-weight: 700;
        }


    /* =========================================================
               FIELD
            ========================================================= */

    .org-field {
        margin-bottom: 14px;
    }

        .org-field label {
            display: block;
            margin-bottom: 6px;
            color: #475467;
            font-size: 12px;
            font-weight: 600;
        }

            .org-field label .required {
                color: #e5484d;
                margin-left: 2px;
            }


    /* =========================================================
               INPUT WRAPPER
            ========================================================= */

    .input-icon {
        position: relative;
        width: 100%;
    }

        .input-icon > i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: #98a2b3;
            font-size: 12px;
            pointer-events: none;
            z-index: 3;
        }

        .input-icon:focus-within > i {
            color: #1e7b67;
        }


    /* =========================================================
               INPUT / SELECT
            ========================================================= */

    .org-field .form-control,
    .org-field .form-select {
        width: 100%;
        height: 39px;
        padding: 7px 10px 7px 34px;
        border: 1px solid #dfe4e7;
        border-radius: 8px;
        background: #ffffff;
        color: #344054;
        font-size: 13px;
        line-height: 1.3;
        box-shadow: none;
        transition: all .2s ease;
    }

        .org-field .form-control::placeholder {
            color: #aeb6be;
            font-size: 12px;
        }

        .org-field .form-control:hover,
        .org-field .form-select:hover {
            border-color: #c8d1d0;
        }

        .org-field .form-control:focus,
        .org-field .form-select:focus {
            border-color: #1e7b67;
            box-shadow: 0 0 0 3px rgba(30, 123, 103, .08);
            outline: none;
        }

    .org-field .form-select {
        cursor: pointer;
        padding-right: 32px;
    }


    /* =========================================================
               TEXTAREA
            ========================================================= */

    .org-field textarea.form-control {
        height: 82px;
        min-height: 82px;
        resize: vertical;
        padding-top: 10px;
        line-height: 1.5;
    }

    .input-icon textarea + i {
        top: 15px;
        transform: none;
    }


    /* =========================================================
               LOGO UPLOAD
            ========================================================= */

    .logo-upload-box {
        width: 100%;
        min-height: 82px;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 9px;
        border: 1px dashed #cbd8d4;
        border-radius: 9px;
        background: #fbfdfc;
        transition: all .2s ease;
    }

        .logo-upload-box:hover {
            border-color: #1e7b67;
            background: #f8fcfa;
        }


    /* =========================================================
               LOGO PREVIEW
            ========================================================= */

    .logo-preview {
        width: 60px;
        height: 60px;
        min-width: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 9px;
        border: 1px solid #d9ebe5;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 20px;
    }

        .logo-preview img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #ffffff;
        }


    /* =========================================================
               LOGO UPLOAD CONTENT
            ========================================================= */

    .logo-upload-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
    }

    .logo-upload-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        padding: 6px 10px;
        border-radius: 6px;
        background: #e8f5f1;
        color: #1e7b67;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all .2s ease;
    }

        .logo-upload-btn:hover {
            background: #1e7b67;
            color: #ffffff;
        }

        .logo-upload-btn i {
            font-size: 11px;
        }

    #logoFileName {
        max-width: 170px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: #667085;
        font-size: 10px;
    }

    .logo-upload-content small {
        color: #98a2b3;
        font-size: 9px;
    }


    /* =========================================================
               FIELD HELP
            ========================================================= */

    .field-help {
        margin-top: 4px;
        color: #98a2b3;
        font-size: 10px;
    }


    /* =========================================================
               ACTION BUTTONS
            ========================================================= */

    .org-form-actions {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 20px;
        padding-top: 17px;
        border-top: 1px solid #edf0f2;
    }

    .btn-org-cancel,
    .btn-org-save {
        height: 38px;
        padding: 0 18px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s ease;
    }

    .btn-org-cancel {
        border: 1px solid #dfe4e7;
        background: #ffffff;
        color: #667085;
    }

        .btn-org-cancel:hover {
            background: #f8fafb;
            color: #344054;
        }

    .btn-org-save {
        border: 0;
        background: #1e7b67;
        color: #ffffff;
        font-weight: 700;
        box-shadow: 0 5px 12px rgba(30, 123, 103, .18);
    }

        .btn-org-save:hover {
            background: #176653;
            transform: translateY(-1px);
            box-shadow: 0 7px 16px rgba(30, 123, 103, .22);
        }


    /* =========================================================
               RESPONSIVE - TABLET
            ========================================================= */

    @@media (max-width: 991px) {

        .org-profile-page {
            padding: 7px;
        }

        .org-profile-form {
            padding: 18px;
        }

        .org-profile-title h2 {
            font-size: 23px;
        }

        .org-profile-title p {
            font-size: 12px;
        }

        .org-field .form-control,
        .org-field .form-select {
            height: 38px;
            font-size: 12px;
        }

        .org-card-header {
            padding: 16px 18px;
        }
    }


    /* =========================================================
               RESPONSIVE - MOBILE
            ========================================================= */

    @@media (max-width: 767px) {

        .org-profile-page {
            padding: 5px;
        }

        .org-profile-header {
            flex-direction: column;
            align-items: flex-start;
            margin-bottom: 15px;
        }

        .profile-status {
            align-self: flex-start;
        }

        .org-profile-title h2 {
            font-size: 22px;
        }

        .org-profile-title p {
            font-size: 12px;
        }

        .org-card-header {
            padding: 14px;
        }

        .org-profile-form {
            padding: 15px;
        }

        .form-section {
            margin-bottom: 20px;
        }

        .org-field {
            margin-bottom: 12px;
        }

        .logo-upload-box {
            max-width: 100%;
        }
    }


    /* =========================================================
               RESPONSIVE - SMALL MOBILE
            ========================================================= */

    @@media (max-width: 576px) {

        .org-profile-page {
            padding: 3px;
        }

        .org-profile-title h2 {
            font-size: 20px;
        }

        .org-profile-title p {
            font-size: 11px;
        }

        .org-card-header {
            gap: 10px;
            padding: 13px;
        }

        .org-card-icon {
            width: 38px;
            height: 38px;
            min-width: 38px;
            font-size: 15px;
        }

        .org-card-header h5 {
            font-size: 14px;
        }

        .org-card-header span {
            font-size: 10px;
        }

        .org-profile-form {
            padding: 13px;
        }

        .section-title span {
            font-size: 13px;
        }

        .org-field label {
            font-size: 11px;
        }

        .org-field .form-control,
        .org-field .form-select {
            height: 38px;
            font-size: 12px;
        }

            .org-field .form-control::placeholder {
                font-size: 11px;
            }

        .logo-preview {
            width: 55px;
            height: 55px;
            min-width: 55px;
        }

        .logo-upload-btn {
            font-size: 10px;
        }

        .org-form-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-org-save,
        .btn-org-cancel {
            width: 100%;
        }
    }


    /* =========================================================
               VERY SMALL MOBILE
            ========================================================= */

    @@media (max-width: 400px) {

        .org-profile-title h2 {
            font-size: 19px;
        }

        .org-profile-form {
            padding: 11px;
        }

        .org-card-header {
            padding: 12px;
        }

        .logo-upload-box {
            gap: 8px;
            padding: 7px;
        }

        .logo-preview {
            width: 50px;
            height: 50px;
            min-width: 50px;
        }

        #logoFileName {
            max-width: 130px;
        }
    }

</style>


<div class="org-profile-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="org-profile-header">

        <div class="org-profile-title">

            <h2>Organization Profile</h2>

        </div>



    </div>


    <!-- =====================================================
         MAIN PROFILE CARD
    ====================================================== -->

    <div class="org-profile-card">

        <!-- CARD HEADER -->

        <div class="org-card-header">

            <div class="org-card-icon">
                <i class="fas fa-building"></i>
            </div>
            <div>

                <h5>
                    Organization Information
                </h5>

                <span>
                    Keep your organization details up to date
                </span>

            </div>

        </div>


        <!-- =================================================
             FORM
        ================================================== -->

        <div class="org-profile-form">

            <form method="post"
                  enctype="multipart/form-data">


                <!-- =================================================
                     BASIC INFORMATION
                ================================================== -->

                <div class="form-section">

                    <div class="section-title">

                        <i class="fas fa-id-card"></i>

                        <span>
                            Basic Information
                        </span>

                    </div>


                    <div class="row">


                        <!-- ORGANIZATION NAME -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Organization Name
                                    <span class="required">*</span>
                                </label>

                                <div class="input-icon">

                                    <input type="text"
                                           class="form-control"
                                           name="OrganizationName"
                                           placeholder="Enter organization name" />

                                    <i class="fas fa-building"></i>

                                </div>

                            </div>

                        </div>


                        <!-- REGISTRATION NUMBER -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Registration Number
                                </label>

                                <div class="input-icon">

                                    <input type="text"
                                           class="form-control"
                                           name="RegistrationNumber"
                                           placeholder="Registration number" />

                                    <i class="fas fa-hashtag"></i>

                                </div>

                            </div>

                        </div>


                        <!-- INDUSTRY -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Industry
                                </label>

                                <div class="input-icon">

                                    <select class="form-select"
                                            name="Industry">

                                        <option value="">
                                            Select industry
                                        </option>

                                        <option>
                                            Information Technology
                                        </option>

                                        <option>
                                            Education
                                        </option>

                                        <option>
                                            Healthcare
                                        </option>

                                        <option>
                                            Finance
                                        </option>

                                        <option>
                                            Manufacturing
                                        </option>

                                        <option>
                                            Retail
                                        </option>

                                    </select>

                                    <i class="fas fa-industry"></i>

                                </div>

                            </div>

                        </div>


                        <!-- WEBSITE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Website
                                </label>

                                <div class="input-icon">

                                    <input type="url"
                                           class="form-control"
                                           name="Website"
                                           placeholder="https://example.com" />

                                    <i class="fas fa-globe"></i>

                                </div>

                            </div>

                        </div>


                        <!-- ESTABLISHED YEAR -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Established Year
                                </label>

                                <div class="input-icon">

                                    <input type="number"
                                           class="form-control"
                                           name="EstablishedYear"
                                           placeholder="e.g. 2015" />

                                    <i class="fas fa-calendar-alt"></i>

                                </div>

                            </div>

                        </div>


                        <!-- ORGANIZATION LOGO -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Organization Logo
                                </label>

                                <div class="logo-upload-box">


                                    <!-- LOGO PREVIEW -->

                                    <div class="logo-preview"
                                         id="logoPreviewBox">

                                        <i class="fas fa-building"
                                           id="defaultLogoIcon"></i>

                                        <img id="logoPreview"
                                             src=""
                                             alt="Organization Logo"
                                             style="display:none;" />

                                    </div>


                                    <!-- UPLOAD AREA -->

                                    <div class="logo-upload-content">

                                        <label for="OrganizationLogo"
                                               class="logo-upload-btn">

                                            <i class="fas fa-cloud-upload-alt"></i>

                                            Choose Logo

                                        </label>

                                        <input type="file"
                                               id="OrganizationLogo"
                                               name="OrganizationLogo"
                                               accept="image/png,image/jpeg,image/jpg,image/webp"
                                               hidden />

                                        <span id="logoFileName">
                                            No file selected
                                        </span>

                                        <small>
                                            PNG, JPG or WEBP
                                        </small>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     CONTACT INFORMATION
                ================================================== -->

                <div class="form-section">

                    <div class="section-title">

                        <i class="fas fa-address-book"></i>

                        <span>
                            Contact Information
                        </span>

                    </div>


                    <div class="row">


                        <!-- EMAIL -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Email Address
                                    <span class="required">*</span>
                                </label>

                                <div class="input-icon">

                                    <input type="email"
                                           class="form-control"
                                           name="Email"
                                           placeholder="organization@email.com" />

                                    <i class="fas fa-envelope"></i>

                                </div>

                            </div>

                        </div>


                        <!-- MOBILE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Mobile Number
                                    <span class="required">*</span>
                                </label>

                                <div class="input-icon">

                                    <input type="tel"
                                           class="form-control"
                                           name="Mobile"
                                           placeholder="Enter mobile number" />

                                    <i class="fas fa-phone"></i>

                                </div>

                            </div>

                        </div>


                        <!-- ALTERNATE MOBILE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Alternate Number
                                </label>

                                <div class="input-icon">

                                    <input type="tel"
                                           class="form-control"
                                           name="AlternateMobile"
                                           placeholder="Alternate number" />

                                    <i class="fas fa-phone-alt"></i>

                                </div>

                            </div>

                        </div>


                        <!-- CONTACT PERSON -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Contact Person
                                </label>

                                <div class="input-icon">

                                    <input type="text"
                                           class="form-control"
                                           name="ContactPerson"
                                           placeholder="Contact person name" />

                                    <i class="fas fa-user"></i>

                                </div>

                            </div>

                        </div>


                        <!-- DESIGNATION -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Designation
                                </label>

                                <div class="input-icon">

                                    <input type="text"
                                           class="form-control"
                                           name="Designation"
                                           placeholder="Designation" />

                                    <i class="fas fa-user-tie"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     ADDRESS DETAILS
                ================================================== -->

                <div class="form-section">

                    <div class="section-title">

                        <i class="fas fa-map-marker-alt"></i>

                        <span>
                            Address Details
                        </span>

                    </div>


                    <div class="row">


                        <!-- ADDRESS -->

                        <div class="col-lg-8 col-md-12">

                            <div class="org-field">

                                <label>
                                    Address
                                </label>

                                <div class="input-icon">

                                    <textarea class="form-control"
                                              name="Address"
                                              placeholder="Enter complete organization address"></textarea>

                                    <i class="fas fa-map-marker-alt"></i>

                                </div>

                            </div>

                        </div>


                        <!-- PINCODE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Pincode
                                </label>

                                <div class="input-icon">

                                    <input type="text"
                                           class="form-control"
                                           name="Pincode"
                                           placeholder="Pincode" />

                                    <i class="fas fa-map-pin"></i>

                                </div>

                            </div>

                        </div>


                        <!-- CITY -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    City
                                </label>

                                <div class="input-icon">

                                    <input type="text"
                                           class="form-control"
                                           name="City"
                                           placeholder="City" />

                                    <i class="fas fa-city"></i>

                                </div>

                            </div>

                        </div>


                        <!-- STATE -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    State
                                </label>

                                <div class="input-icon">

                                    <select class="form-select"
                                            name="State">

                                        <option value="">
                                            Select state
                                        </option>

                                        <option>
                                            Maharashtra
                                        </option>

                                        <option>
                                            Gujarat
                                        </option>

                                        <option>
                                            Karnataka
                                        </option>

                                        <option>
                                            Delhi
                                        </option>

                                        <option>
                                            Tamil Nadu
                                        </option>

                                        <option>
                                            Telangana
                                        </option>

                                    </select>

                                    <i class="fas fa-map"></i>

                                </div>

                            </div>

                        </div>


                        <!-- COUNTRY -->

                        <div class="col-lg-4 col-md-6">

                            <div class="org-field">

                                <label>
                                    Country
                                </label>

                                <div class="input-icon">

                                    <select class="form-select"
                                            name="Country">

                                        <option value="">
                                            Select country
                                        </option>

                                        <option selected>
                                            India
                                        </option>

                                        <option>
                                            United States
                                        </option>

                                        <option>
                                            United Kingdom
                                        </option>

                                        <option>
                                            Australia
                                        </option>

                                    </select>

                                    <i class="fas fa-globe-asia"></i>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     ABOUT ORGANIZATION
                ================================================== -->

                <div class="form-section">

                    <div class="section-title">

                        <i class="fas fa-align-left"></i>

                        <span>
                            About Organization
                        </span>

                    </div>


                    <div class="row">

                        <div class="col-lg-8 col-md-12">

