@model ErJobPortal.Models.OrgProfile

@* Radhika30-09 *@
<link rel="stylesheet" href="~/css/OrgEditProfile.css" asp-append-version="true" />
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Edit Internship Post";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}



<div class="internship-edit-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="internship-page-header">

        <h1>
           Edit Profile
        </h1>

        <p>
            Organization ID : @Model.nOrgID
        </p>

    </div>


    <!-- =====================================================
         SUCCESS MESSAGE
         ===================================================== -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="success-message">

            <i class="fas fa-check-circle"></i>

            <span>
                @TempData["SuccessMessage"]
            </span>

        </div>
    }


    <!-- =====================================================
         ERROR MESSAGE
         ===================================================== -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="error-message">

            <strong>
                <i class="fas fa-exclamation-circle me-1"></i>
                Error
            </strong>

            <div>
                @TempData["ErrorMessage"]
            </div>

        </div>
    }


    <!-- =====================================================
         MODEL VALIDATION
         ===================================================== -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="error-message">

            <strong>
                <i class="fas fa-exclamation-triangle me-1"></i>
                Please correct the following errors:
            </strong>

            <div asp-validation-summary="All"></div>

        </div>
    }


    <!-- =====================================================
         MAIN FORM
         ===================================================== -->

    <div class="internship-form-card">

        <!-- Card Header -->

            


        <form asp-controller="Organization"
              asp-action="EditProfile"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()


            <!-- Hidden Values -->

            <input type="hidden"
                   asp-for="nID" />

            <input type="hidden"
                   asp-for="nOrgID" />

            <input type="hidden"
                   asp-for="sCompanyLogo" />


            <!-- Form Body -->

            <div class="internship-form-body">

                <div class="internship-form-grid">


                    <!-- =================================================
                         ORGANIZATION NAME
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Organization Name
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-building"></i>

                            <input asp-for="sOrganizationName"
                                   class="form-control"
                                   readonly />

                        </div>

                        <span asp-validation-for="sOrganizationName"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         DESIGNATION
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Designation
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-user-tie"></i>

                            <input asp-for="sDesignation"
                                   class="form-control"
                                   readonly />

                        </div>

                        <span asp-validation-for="sDesignation"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         CONTACT
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Contact No.
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-phone"></i>

                            <input asp-for="sMobile"
                                   class="form-control"
                                   readonly />

                        </div>

                        <span asp-validation-for="sMobile"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         EMAIL
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Verification Email
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-envelope"></i>

                            <input asp-for="sOrganizationEmail"
                                   class="form-control"
                                   type="email"
                                   readonly />

                        </div>

                        <span asp-validation-for="sOrganizationEmail"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         DATE OF BIRTH
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Date of Birth
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-calendar-alt"></i>

                            <input asp-for="dDateOfBirth"
                                   class="form-control"
                                   type="date" />

                        </div>

                        <span asp-validation-for="dDateOfBirth"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         ESTABLISHMENT YEAR
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Establishment Year
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-calendar-check"></i>

                            <input asp-for="nEstablishmentYear"
                                   class="form-control"
                                   type="number"
                                   min="1800"
                                   max="@DateTime.Now.Year"
                                   placeholder="e.g. 2002" />

                        </div>

                        <span asp-validation-for="nEstablishmentYear"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         COMPANY LOGO
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Company Logo
                        </label>

                        <input type="file"
                               id="companyLogo"
                               name="CompanyLogo"
                               class="file-input"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                        <div class="field-note">
                            JPG, JPEG, PNG or WEBP. Maximum 5 MB.
                        </div>

                        <span id="logoError"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         LOGO PREVIEW
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Logo Preview
                        </label>

                        <div class="logo-preview-wrapper">

                            <div class="logo-preview-info">

                                <span class="logo-preview-label">
                                    Company Logo
                                </span>

                                <span class="logo-size">
                                    100 × 100
                                </span>

                            </div>


                            @if (!string.IsNullOrWhiteSpace(Model.sCompanyLogo))
                            {
                                <img src="@Url.Content("~/uploads/organization/" + Model.sCompanyLogo)"
                                     id="logoPreview"
                                     class="logo-preview"
                                     alt="Company Logo" />
                            }
                            else
                            {
                                <img src=""
                                     id="logoPreview"
                                     class="logo-preview"
                                     alt="Company Logo"
                                     style="display:none;" />
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         GST
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            GST No.
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-file-invoice"></i>

                            <input asp-for="sGSTNo"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="Enter GST number" />

                        </div>

                        <span asp-validation-for="sGSTNo"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         CIN
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            CIN No.
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-file-contract"></i>

                            <input asp-for="sCINNo"
                                   class="form-control"
                                   maxlength="50"
                                   placeholder="Enter CIN number" />

                        </div>

                        <span asp-validation-for="sCINNo"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         EMPLOYEE STRENGTH
                         ================================================= -->

                    <div class="internship-field">

                        <label>
                            Current Employee Strength
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper">

                            <i class="fas fa-users"></i>

                            <input asp-for="nEmployeeStrength"
                                   class="form-control"
                                   maxlength="100"
                                   placeholder="Example: 1-10" />

                        </div>

                        <span asp-validation-for="nEmployeeStrength"
                              class="validation-message">
                        </span>

                    </div>


                    <!-- =================================================
                         COMPANY ADDRESS
                         ================================================= -->

                    <div class="internship-field field-full">

                        <label>
                            Company Address
                            <span class="required">*</span>
                        </label>

                        <div class="input-wrapper textarea-wrapper">

                            <i class="fas fa-map-marker-alt"></i>

                            <textarea asp-for="sCompanyAddress"
                                      class="form-control"
                                      placeholder="Enter company address"></textarea>

                        </div>

                        <span asp-validation-for="sCompanyAddress"
                              class="validation-message">
                        </span>

                    </div>


                </div>

            </div>


            <!-- =====================================================
                 FORM FOOTER
                 ===================================================== -->

            <div class="internship-form-footer">

                <a asp-controller="Organization"
                   asp-action="Profile"
                   class="cancel-btn">

                    <i class="fas fa-times"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="save-btn">

                    <i class="fas fa-save"></i>

                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const logoInput =
                document.getElementById("companyLogo");

            const logoPreview =
                document.getElementById("logoPreview");

            const logoError =
                document.getElementById("logoError");


            if (!logoInput || !logoPreview) {
                return;
            }


            logoInput.addEventListener("change", function (event) {

                const file =
                    event.target.files[0];


                if (logoError) {
                    logoError.textContent = "";
                }


                if (!file) {
                    return;
                }


                const allowedTypes = [
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];


                const allowedExtensions = [
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".webp"
                ];


                const fileName =
                    file.name.toLowerCase();


                const extension =
                    fileName.substring(
                        fileName.lastIndexOf(".")
                    );


                if (!allowedTypes.includes(file.type) ||
                    !allowedExtensions.includes(extension)) {

                    if (logoError) {
                        logoError.textContent =
                            "Please select a JPG, JPEG, PNG or WEBP image.";
                    }

                    event.target.value = "";

                    return;
                }


                const maxSize =
                    5 * 1024 * 1024;


                if (file.size > maxSize) {

                    if (logoError) {
                        logoError.textContent =
                            "Company logo size cannot exceed 5 MB.";
                    }

                    event.target.value = "";

                    return;
                }


                const reader =
                    new FileReader();


                reader.onload = function (e) {

                    logoPreview.src =
                        e.target.result;

                    logoPreview.style.display =
                        "block";

                };


                reader.readAsDataURL(file);

            });

        });

    </script>

}