                if (!start.value) return;


                const today = new Date();

                today.setHours(0, 0, 0, 0);


                const startDate =
                    new Date(start.value + "T00:00:00");


                if (startDate < today) {

                    start.setCustomValidity(
                        "Start date cannot be earlier than today."
                    );

