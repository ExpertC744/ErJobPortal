                }


                const shift =
                    document.getElementById("sWorkingShift");

                if (shift) {

                    shift.setCustomValidity(
                        shift.value
                            ? ""
                            : "Please select working shift."
                    );

                }


                validateDates();

                validateWorkingDays();

                validateFacilities();

                validateSkills();


                // =====================================================
                // HTML5 VALIDATION
                // =====================================================

                if (!form.checkValidity()) {

                    event.preventDefault();

                    form.reportValidity();

                    return false;
                }


                // =====================================================
                // ENABLE DISABLED LOCATION FIELDS
                // =====================================================

                const state =
                    document.getElementById("sStateName");

                const city =
                    document.getElementById("nCityName");


                if (state) {
                    state.disabled = false;
                }

                if (city) {
                    city.disabled = false;
                }


                // =====================================================
                // FINAL VALUES
                // =====================================================

                updateAllHiddenValues();

