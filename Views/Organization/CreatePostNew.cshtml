                        "#medicalBody input[type='checkbox']:checked"
                    ).length;


                const nonTechnical =
                    document.querySelectorAll(
                        "#nonTechnicalBody input[type='checkbox']:checked"
                    ).length;


                const total =
                    technical +
                    medical +
                    nonTechnical;


                const allSkillCheckboxes =
                    document.querySelectorAll(
                        "#technicalBody input[type='checkbox'], " +
                        "#medicalBody input[type='checkbox'], " +
                        "#nonTechnicalBody input[type='checkbox']"
                    );


                allSkillCheckboxes.forEach(function (checkbox) {

                    checkbox.setCustomValidity("");

                });


                if (total === 0 && allSkillCheckboxes.length > 0) {

                    allSkillCheckboxes[0].setCustomValidity(
                        "Please select at least one skill."
                    );

                    return false;
                }


                return true;
            }


