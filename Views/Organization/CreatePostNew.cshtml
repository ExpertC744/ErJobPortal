            );

            // Internship Mode
            loadDropdown(
                "nInternshipModeID",
                "/Organization/GetInternshipMode",
                "-- Select Internship Mode --"
            );

        });


        async function loadDropdown(dropdownId, url, defaultText) {

            const dropdown =
                document.getElementById(dropdownId);

            if (!dropdown) {
                console.error(
                    "Dropdown not found: " + dropdownId
                );
                return;
            }

            try {

                const response =
                    await fetch(url);

                if (!response.ok) {

                    throw new Error(
                        "HTTP Error: " + response.status
                    );

                }

                const data =
                    await response.json();


                // IMPORTANT:
                // Empty value is required for [Required] validation

                dropdown.innerHTML =
                    `<option value="">
                        ${defaultText}
                     </option>`;


                if (!Array.isArray(data)) {

                    console.error(
                        "Invalid dropdown data:",
                        data
                    );

                    return;
                }


                data.forEach(function (item) {

                    const option =
                        document.createElement("option");

                    option.value =
                        item.nID;

                    option.textContent =
                        item.sName;

                    dropdown.appendChild(option);

                });

            }
            catch (error) {

                console.error(
                    "Error loading " + dropdownId,
                    error
                );

                dropdown.innerHTML =
                    `<option value="">
                        Unable to load data
                     </option>`;

            }

        }

    </script>

    <script>

        // =========================================================
        // MUTUALLY EXCLUSIVE SKILL CATEGORIES
        // Technical OR Medical OR Non-Technical
        // Only ONE category can be selected at a time.
        // =========================================================

        function applySkillCategoryState() {

            const technicalChecked =
                document.querySelectorAll(
                    "#technicalBody input[type='checkbox']:checked"
                ).length > 0;

            const medicalChecked =
                document.querySelectorAll(
                    "#medicalBody input[type='checkbox']:checked"
                ).length > 0;

            const nonTechnicalChecked =
                document.querySelectorAll(
                    "#nonTechnicalBody input[type='checkbox']:checked"
                ).length > 0;


            // =====================================================
            // IF TECHNICAL IS SELECTED
            // Disable Medical + Non-Technical
            // =====================================================

            if (technicalChecked) {

                document.querySelectorAll(
                    "#medicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = true;

                });

                document.querySelectorAll(
                    "#nonTechnicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = true;

                });

            }


            // =====================================================
            // IF MEDICAL IS SELECTED
            // Disable Technical + Non-Technical
            // =====================================================

            else if (medicalChecked) {

                document.querySelectorAll(
                    "#technicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = true;

                });

                document.querySelectorAll(
                    "#nonTechnicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = true;

                });

            }


            // =====================================================
            // IF NON-TECHNICAL IS SELECTED
            // Disable Technical + Medical
            // =====================================================

            else if (nonTechnicalChecked) {

                document.querySelectorAll(
                    "#technicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = true;

                });

                document.querySelectorAll(
                    "#medicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = true;

                });

            }


            // =====================================================
            // NOTHING SELECTED
            // Enable ALL
            // =====================================================

            else {

                document.querySelectorAll(
                    "#technicalBody input[type='checkbox'], " +
                    "#medicalBody input[type='checkbox'], " +
                    "#nonTechnicalBody input[type='checkbox']"
                ).forEach(function (checkbox) {

                    checkbox.disabled = false;

                });

            }


            // Update counts
            if (typeof updateTechnicalCount === "function") {
                updateTechnicalCount();
            }

            if (typeof updateMedicalCount === "function") {
                updateMedicalCount();
            }

            if (typeof updateNonTechnicalCount === "function") {
                updateNonTechnicalCount();
            }

        }


        // =========================================================
        // WHEN ANY SKILL IS SELECTED / UNSELECTED
        // =========================================================

        document.addEventListener("change", function (event) {

            if (
                event.target.matches(
                    "#technicalBody input[type='checkbox'], " +
                    "#medicalBody input[type='checkbox'], " +
                    "#nonTechnicalBody input[type='checkbox']"
                )
            ) {

                applySkillCategoryState();

            }

        });


        // =========================================================
        // CHECK STATE AFTER SKILLS ARE LOADED
        // =========================================================

        document.addEventListener("DOMContentLoaded", function () {

            // Wait because skills are loaded using fetch()
            setTimeout(function () {

                applySkillCategoryState();

            }, 500);

        });

    </script>

