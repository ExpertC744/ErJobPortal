    <script>
        // Radhika30-09
    // =========================================================
    // SKILLS ACCORDION - only one category open at a time
    // =========================================================

    const SKILL_BODIES = ["medicalBody", "technicalBody", "nonTechnicalBody"];

    let skillUserToggled = false;

    function getSkillBox(bodyId) {
        const body = document.getElementById(bodyId);
        return body ? body.closest(".skill-box") : null;
    }

    function isSkillOpen(bodyId) {
        const box = getSkillBox(bodyId);
        return box ? !box.classList.contains("collapsed") : false;
    }

    function openSkill(bodyId) {
        SKILL_BODIES.forEach(function (id) {
            const box = getSkillBox(id);
            if (box) {
                box.classList.toggle("collapsed", id !== bodyId);
            }
        });
    }

    // Called by onclick="toggleSkill('medicalBody')" in your HTML
    function toggleSkill(bodyId) {

        skillUserToggled = true;

        if (isSkillOpen(bodyId)) {
            const box = getSkillBox(bodyId);
            if (box) box.classList.add("collapsed");   // click again to close
        }
        else {
            openSkill(bodyId);                          // opens this, closes others
        }
    }


    // Starting state
  // Starting state: all three categories closed
document.addEventListener("DOMContentLoaded", function () {

    SKILL_BODIES.forEach(function (id) {
        const box = getSkillBox(id);
        if (box) box.classList.add("collapsed");
    });

});


    // If validation fails on a checkbox inside a closed box, open that box
    document.addEventListener("invalid", function (event) {

        const body = event.target.closest(".skill-body");

        if (body) {
            openSkill(body.id);
        }

    }, true);

</script>

