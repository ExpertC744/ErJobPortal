            // =========================================================
            // 35. FELLOWSHIP / CHARGES VALIDATION
            // =========================================================

            const fellowship =
                document.getElementById(
                    "nInternshipFellowshipTypeID"
                );

            const charges =
                document.getElementById("sTotalCharges");

            const currency =
                document.getElementById("sCurrency");


            function validateCharges() {

                if (!fellowship) return;


                const text =
                    fellowship.options[
                        fellowship.selectedIndex
                    ]?.text.trim() || "";


                const isFree =
                    text === "Free" ||
                    text ===
                    "Any (Free/Paid/Stipend/Sponsored)";


                if (isFree) {

                    if (charges) {

                        charges.disabled = true;
                        charges.value = "";
                        charges.setCustomValidity("");

                    }

                    if (currency) {

                        currency.disabled = true;
                        currency.value = "";
                        currency.setCustomValidity("");

                    }

                    return;
                }


                if (charges) {

                    charges.disabled = false;

                    if (!charges.value) {

                        charges.setCustomValidity(
                            "Please enter total charges."
                        );

                    }
                    else if (parseFloat(charges.value) < 0) {

                        charges.setCustomValidity(
                            "Charges cannot be negative."
                        );

                    }
                    else {

                        charges.setCustomValidity("");

                    }

                }


                if (currency) {

                    currency.disabled = false;

                    if (!currency.value) {

                        currency.setCustomValidity(
                            "Please select currency."
                        );

                    }
                    else {

                        currency.setCustomValidity("");

                    }

                }

            }


            fellowship?.addEventListener(
                "change",
                validateCharges
            );


            charges?.addEventListener(
                "input",
                validateCharges
            );


            currency?.addEventListener(
                "change",
                validateCharges
            );


            validateCharges();


            // =========================================================
            // 36. INITIAL UPDATE
            // =========================================================

            updateAllHiddenValues();

        });
