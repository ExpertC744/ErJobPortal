    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const countryDropdown = document.getElementById("sCountryName");
            const stateDropdown = document.getElementById("sStateName");
            const cityDropdown = document.getElementById("nCityName");

            if (!countryDropdown || !stateDropdown || !cityDropdown) {
                console.error("Country / State / City dropdown not found.");
                return;
            }


            // ============================================================
            // LOAD COUNTRIES
            // ============================================================

            fetch('@Url.Action("GetCountries", "Organization")')
                .then(response => {

                    if (!response.ok) {
                        throw new Error(
                            "Country API failed: " + response.status
                        );
                    }

                    return response.json();
                })
                .then(countries => {

                    countryDropdown.innerHTML =
                        '<option value="">-- Select Country --</option>';

                    if (!countries || countries.length === 0) {

                        countryDropdown.innerHTML =
                            '<option value="">No countries found</option>';

                        return;
                    }

                    countries.forEach(country => {

                        const option = document.createElement("option");

                        // COUNTRY NAME WILL BE SUBMITTED
                        option.value = country.name;

                        // COUNTRY NAME WILL BE DISPLAYED
                        option.textContent = country.name;

                        // COUNTRY CODE ONLY FOR API
                        option.dataset.code = country.iso2;

                        countryDropdown.appendChild(option);
                    });

                })
                .catch(error => {

                    console.error("Country Error:", error);

                    countryDropdown.innerHTML =
                        '<option value="">Unable to load countries</option>';
                });


            // ============================================================
            // COUNTRY CHANGE
            // ============================================================

            countryDropdown.addEventListener("change", function () {

                const selectedCountry =
                    countryDropdown.options[
                        countryDropdown.selectedIndex
                    ];

                if (!selectedCountry || !selectedCountry.value) {

                    stateDropdown.innerHTML =
                        '<option value="">-- Select State --</option>';

                    cityDropdown.innerHTML =
                        '<option value="">-- Select City --</option>';

                    stateDropdown.disabled = true;
                    cityDropdown.disabled = true;

                    return;
                }


                // COUNTRY NAME
                // Example: India

                const countryName =
                    selectedCountry.value;


                // COUNTRY CODE
                // Example: IN
                // Used ONLY for API

                const countryCode =
                    selectedCountry.dataset.code;


                console.log("Country Name:", countryName);
                console.log("Country Code:", countryCode);


                // ========================================================
                // RESET STATE
                // ========================================================

                stateDropdown.innerHTML =
                    '<option value="">Loading states...</option>';

                stateDropdown.disabled = true;


                // ========================================================
                // RESET CITY
                // ========================================================

                cityDropdown.innerHTML =
                    '<option value="">-- Select City --</option>';

                cityDropdown.disabled = true;


                if (!countryCode) {

                    console.error("Country code not found.");

                    return;
                }


                // ========================================================
                // LOAD STATES
                // ========================================================
                //
                // YOUR CONTROLLER EXPECTS:
                //
                // GetStates(string countryCode)
                //
                // Therefore:
                //
                // GetStates?countryCode=IN

                const stateUrl =
                    '@Url.Action("GetStates", "Organization")' +
                    '?countryCode=' +
                    encodeURIComponent(countryCode);


                console.log("State Request:", stateUrl);


                fetch(stateUrl)
                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "State API failed: " +
                                response.status
                            );
                        }

                        return response.json();
                    })
                    .then(states => {

                        stateDropdown.innerHTML =
                            '<option value="">-- Select State --</option>';


                        if (!states || states.length === 0) {

                            stateDropdown.innerHTML =
                                '<option value="">No states found</option>';

                            return;
                        }


                        states.forEach(state => {

                            const option =
                                document.createElement("option");


                            // STATE NAME
                            // Example: Maharashtra

                            option.value = state.name;

                            option.textContent = state.name;


                            // STATE CODE
                            // Example: MH
                            // Used ONLY for city API

                            option.dataset.code =
                                state.stateCode;


                            stateDropdown.appendChild(option);
                        });


                        stateDropdown.disabled = false;

                    })
                    .catch(error => {

                        console.error("State Error:", error);

                        stateDropdown.innerHTML =
                            '<option value="">Unable to load states</option>';

                        stateDropdown.disabled = true;
                    });

            });


            // ============================================================
            // STATE CHANGE
            // ============================================================

            stateDropdown.addEventListener("change", function () {

                const selectedCountry =
                    countryDropdown.options[
                        countryDropdown.selectedIndex
                    ];

                const selectedState =
                    stateDropdown.options[
                        stateDropdown.selectedIndex
                    ];


                if (!selectedCountry ||
                    !selectedCountry.value ||
                    !selectedState ||
                    !selectedState.value) {

                    cityDropdown.innerHTML =
                        '<option value="">-- Select City --</option>';

                    cityDropdown.disabled = true;

                    return;
                }


                // COUNTRY CODE
                // Example: IN

                const countryCode =
                    selectedCountry.dataset.code;


                // STATE NAME
                // Example: Maharashtra
                //
                // This is what your form will submit.

                const stateName =
                    selectedState.value;


                // STATE CODE
                // Example: MH
                //
                // Used ONLY for API.

                const stateCode =
                    selectedState.dataset.code;


                console.log("Country Code:", countryCode);
                console.log("State Name:", stateName);
                console.log("State Code:", stateCode);


                // ========================================================
                // RESET CITY
                // ========================================================

                cityDropdown.innerHTML =
                    '<option value="">Loading cities...</option>';

                cityDropdown.disabled = true;


                if (!countryCode || !stateCode) {

                    console.error(
                        "Country code or state code missing."
                    );

                    return;
                }


                // ========================================================
                // LOAD CITIES
                // ========================================================
                //
                // YOUR CONTROLLER EXPECTS:
                //
                // GetCities(string countryCode, string stateCode)
                //
                // Example:
                //
                // GetCities?countryCode=IN&stateCode=MH

                const cityUrl =
                    '@Url.Action("GetCities", "Organization")' +
                    '?countryCode=' +
                    encodeURIComponent(countryCode) +
                    '&stateCode=' +
                    encodeURIComponent(stateCode);


                console.log("City Request:", cityUrl);


                fetch(cityUrl)
                    .then(response => {

                        if (!response.ok) {

                            throw new Error(
                                "City API failed: " +
                                response.status
                            );
                        }

                        return response.json();
                    })
                    .then(cities => {

                        cityDropdown.innerHTML =
                            '<option value="">-- Select City --</option>';


                        if (!cities || cities.length === 0) {

                            cityDropdown.innerHTML =
                                '<option value="">No cities found</option>';

                            return;
                        }


                        cities.forEach(city => {

                            const option =
                                document.createElement("option");


                            // CITY NAME
                            // Example: Pune

                            option.value = city.name;

                            option.textContent = city.name;


                            cityDropdown.appendChild(option);
                        });


                        cityDropdown.disabled = false;

                    })
                    .catch(error => {

                        console.error("City Error:", error);

                        cityDropdown.innerHTML =
                            '<option value="">Unable to load cities</option>';

                        cityDropdown.disabled = true;
                    });

            });


            // ============================================================
            // ENABLE STATE + CITY BEFORE FORM SUBMIT
            // ============================================================

            const form =
                countryDropdown.closest("form");

            if (form) {

                form.addEventListener("submit", function () {

                    stateDropdown.disabled = false;
                    cityDropdown.disabled = false;

                });
            }

        });
    </script>

