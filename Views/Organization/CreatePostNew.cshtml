@model JobPortalTrainee.Models.OrgPostM
@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Create New Post";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Create New Post — Internship Posting</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">

    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet">

    <style>

        :root {
            --navy: #152A4A;
            --navy-deep: #0E1E38;
            --teal: #0E8C82;
            --teal-light: #E4F5F3;
            --amber: #D98A2B;
            --bg: #F5F7FA;
            --card: #FFFFFF;
            --line: #E3E8EF;
            --text: #1F2937;
            --muted: #6B7686;
            --danger: #D64545;
            --radius: 12px;
            --shadow: 0 8px 24px -12px rgba(21,42,74,.18);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
        }

        h1,
        h2,
        h3,
        .brand {
            font-family: 'Sora', sans-serif;
        }

        .topbar {
            background: var(--navy-deep);
            color: white;
            padding: 16px 32px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            font-size: 17px;
        }

        .brand-mark {
            width: 34px;
            height: 34px;
            border-radius: 9px;
            background: linear-gradient(135deg, var(--teal), #0BB8AB);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: 700;
            color: #04211E;
        }

        .org-chip {
            font-size: 12px;
            color: #C7D0E0;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.12);
            padding: 7px 13px;
            border-radius: 50px;
        }

        .page-header {
            background: linear-gradient(180deg, var(--navy) 0%, var(--navy-deep) 100%);
            color: white;
            padding: 40px 32px 65px;
        }

        .page-header-inner {
            max-width: 1180px;
            margin: auto;
        }

        .eyebrow {
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 1.5px;
            color: #8FE0D6;
            font-weight: 600;
            margin-bottom: 10px;
        }

        .page-header h1 {
            margin: 0 0 8px;
            font-size: 30px;
        }

        .page-header p {
            margin: 0;
            max-width: 620px;
            color: #B9C4D6;
            font-size: 14px;
            line-height: 1.6;
        }

        .layout {
            max-width: 1180px;
            margin: -40px auto 60px;
            padding: 0 32px;
            display: grid;
            grid-template-columns: 245px 1fr;
            gap: 28px;
            align-items: start;
        }

        .side-nav {
            position: sticky;
            top: 20px;
            background: white;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            padding: 10px;
            box-shadow: var(--shadow);
        }

            .side-nav a {
                display: flex;
                align-items: center;
                gap: 10px;
                text-decoration: none;
                color: var(--muted);
                font-size: 13px;
                font-weight: 500;
                padding: 11px 12px;
                border-radius: 8px;
            }

                .side-nav a:hover,
                .side-nav a.active {
                    background: var(--teal-light);
                    color: var(--teal);
                }

        .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--line);
        }

        .side-nav a.active .dot {
            background: var(--teal);
        }

        .side-note {
            margin-top: 14px;
            padding: 14px;
            background: #FBF6EC;
            border: 1px solid #F0E1BE;
            border-radius: 10px;
            color: #8A6416;
            font-size: 12px;
            line-height: 1.5;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 22px;
        }

        .section {
            background: white;
            border: 1px solid var(--line);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            padding: 26px 28px;
            scroll-margin-top: 20px;
        }

        .section-head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .section-icon {
            width: 35px;
            height: 35px;
            border-radius: 9px;
            background: var(--teal-light);
            color: var(--teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
        }

        .section-head h2 {
            margin: 0;
            font-size: 16px;
            color: var(--navy);
        }

        .sub {
            margin: 3px 0 0;
            font-size: 12px;
            color: var(--muted);
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
        }

        .field label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 7px;
        }

        .req {
            color: var(--danger);
        }

        .field select,
        .field input {
            width: 100%;
            padding: 10px 12px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            background: white;
            border: 1.5px solid var(--line);
            border-radius: 8px;
            outline: none;
        }

            .field select:focus,
            .field input:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(14,140,130,.13);
            }

            .field select:disabled {
                background: #F2F4F7;
                cursor: not-allowed;
            }

        .hint {
            display: block;
            margin-top: 5px;
            font-size: 11px;
            color: var(--muted);
        }

        .checkbox-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
        }

        .check-item {
            display: flex;
            align-items: center;
            gap: 9px;
            border: 1px solid var(--line);
            border-radius: 8px;
            padding: 10px;
            font-size: 12.5px;
            cursor: pointer;
            background: white;
        }

            .check-item:hover {
                border-color: var(--teal);
                background: var(--teal-light);
            }

            .check-item input {
                width: 16px;
                height: 16px;
                accent-color: var(--teal);
            }

        .skill-box {
            border: 1px solid var(--line);
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 12px;
        }

        .skill-title {
            padding: 13px 16px;
            background: #FAFBFC;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            color: var(--navy);
        }

        .skill-count {
            font-size: 11px;
            color: var(--teal);
            background: var(--teal-light);
            padding: 3px 8px;
            border-radius: 20px;
        }

        .skill-body {
            padding: 15px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 10px;
            border-top: 1px solid var(--line);
        }

        .submit-bar {
            position: sticky;
            bottom: 0;
            z-index: 20;
            background: white;
            border: 1px solid var(--line);
            border-radius: 12px;
            box-shadow: var(--shadow);
            padding: 18px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

            .submit-bar p {
                margin: 0;
                font-size: 12px;
                color: var(--muted);
            }

        .btn-row {
            display: flex;
            gap: 10px;
        }

        .btn {
            border: 0;
            border-radius: 9px;
            padding: 12px 22px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--teal);
            color: white;
        }

            .btn-primary:hover {
                background: #0B786F;
            }

        .btn-secondary {
            background: white;
            border: 1px solid var(--line);
            color: var(--navy);
        }

        footer {
            text-align: center;
            padding: 25px;
            color: var(--muted);
            font-size: 12px;
        }

        #messageBox {
            display: none;
            padding: 13px 16px;
            border-radius: 8px;
            margin-bottom: 10px;
            font-size: 13px;
            font-weight: 500;
        }

            #messageBox.success {
                display: block;
                background: #E7F7F3;
                border: 1px solid #B8E8DF;
                color: #08766D;
            }

            #messageBox.error {
                display: block;
                background: #FDECEC;
                border: 1px solid #F4C3C3;
                color: #B42318;
            }

        @@media(max-width:900px) {

            .layout {
                grid-template-columns: 1fr;
            }

            .side-nav {
                position: static;
            }

            .grid,
            .checkbox-grid,
            .skill-body {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media(max-width:600px) {

            .topbar {
                padding: 14px 18px;
            }

            .org-chip {
                display: none;
            }

            .page-header {
                padding: 30px 18px 55px;
            }

            .layout {
                padding: 0 14px;
            }

            .section {
                padding: 20px 18px;
            }

            .grid,
            .checkbox-grid,
            .skill-body {
                grid-template-columns: 1fr;
            }

            .submit-bar {
                position: static;
                flex-direction: column;
                align-items: stretch;
            }

            .btn-row {
                width: 100%;
            }

            .btn {
                flex: 1;
            }
        }

    </style>

</head>

<body>

    <!-- TOP BAR -->

    <div class="topbar">

        <div class="brand">

            <div class="brand-mark">
                IN
            </div>

            Internship Connect

        </div>

        <div class="org-chip">
            Organization Internship Posting
        </div>

    </div>


    <!-- HEADER -->

    <div class="page-header">

        <div class="page-header-inner">

            <div class="eyebrow">
                New Posting
            </div>

            <h1>
                Create an internship post
            </h1>

            <p>
                Fill in the details below so candidates know exactly
                what to expect — role, location, duration and skills.
            </p>

        </div>

    </div>


    <!-- MAIN -->

    <div class="layout">

        <!-- SIDEBAR -->

        <nav class="side-nav">

            <a href="#role" class="active">
                <span class="dot"></span>
                Role Details
            </a>

            <a href="#location">
                <span class="dot"></span>
                Location
            </a>

            <a href="#terms">
                <span class="dot"></span>
                Work Terms
            </a>

            <a href="#schedule">
                <span class="dot"></span>
                Duration & Dates
            </a>

            <a href="#mode">
                <span class="dot"></span>
                Mode & Language
            </a>

            <a href="#days">
                <span class="dot"></span>
                Working Days
            </a>

            <a href="#facilities">
                <span class="dot"></span>
                Facilities
            </a>

            <a href="#skills">
                <span class="dot"></span>
                Skills Required
            </a>

            <div class="side-note">
                Fields marked
                <strong style="color:#D64545">*</strong>
                are required.
            </div>

        </nav>


        <!-- FORM -->

        <form id="internshipPostForm"
              asp-controller="Organization"
              asp-action="CreatePostNew"
              method="post">

            <div id="messageBox"></div>


            <!-- =================================================
                 ROLE DETAILS
            ================================================== -->

            <section class="section" id="role">

                <div class="section-head">

                    <div class="section-icon">
                        ★
                    </div>

                    <div>

                        <h2>
                            Role Details
                        </h2>

                        <p class="sub">
                            Position and candidate requirements
                        </p>

                    </div>

                </div>


                <div class="grid">

                    <!-- POSITION -->

                    <div class="field">

                        <label>
                            Position
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nPositionID"
                                id="nPositionID"
                                class="form-select">
                            <option value="">-- Select Position --</option>
                        </select>

                        <span asp-validation-for="nPositionID"
                              class="text-danger"></span>

                    </div>


                    <!-- REQUIRED TRAINEES -->

                    <div class="field">

                        <label>
                            Required Trainees
                            <span class="req">*</span>
                        </label>

                        <input type="number"
                               id="nRequiredTrainees"
                               name="nRequiredTrainees"
                               min="1"
                               placeholder="e.g. 20"
                               required />

                    </div>


                    <!-- GENDER -->

                    <div class="field">

                        <label>
                            Gender
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nGenderID"
                                id="nGenderID"
                                class="form-select">
                            <option value="0">-- Select Gender --</option>
                        </select>

                    </div>


                    <!-- QUALIFICATION -->

                    <div class="field">

                        <label>
                            Minimum Qualification
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nMinimumQualificationID"
                                id="nMinimumQualificationID"
                                class="form-select">
                            <option value="0">-- Select Qualification --</option>
                        </select>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 LOCATION
            ================================================== -->

            <section class="section" id="location">

                <div class="section-head">

                    <div class="section-icon">
                        📍
                    </div>

                    <div>

                        <h2>
                            Location
                        </h2>

                        <p class="sub">
                            Select country, state and city
                        </p>

                    </div>

                </div>


                <div class="grid">

                    <!-- COUNTRY -->

                    <div class="field">

                        <label>
                            Country <span class="req">*</span>
                        </label>

                        <select asp-for="sCountryName"
                                @*  id="sCountryCode" *@
                                class="form-select"
                                required>

                            <option value="">
                                -- Select Country --
                            </option>

                        </select>

                    </div>


                    <!-- STATE -->

                    <div class="field">

                        <label>
                            State <span class="req">*</span>
                        </label>

                        <select asp-for="sStateName"
                                @*  id="sStateCode" *@
                                class="form-select"
                                disabled
                                required>

                            <option value="">
                                -- Select State --
                            </option>

                        </select>

                    </div>


                    <!-- CITY -->

                    <div class="field">

                        <label>
                            City <span class="req">*</span>
                        </label>

                        <select asp-for="nCityName"
                                @* id="nCityID" *@
                                class="form-select"
                                disabled
                                required>

                            <option value="0">
                                -- Select City --
                            </option>

                        </select>

                    </div>



                    <!-- WORKING HOURS -->

                    <div class="field">

                        <label>
                            Working Hours / Day
                            <span class="req">*</span>
                        </label>

                        <select id="sWorkingHours"
                                name="sWorkingHours"
                                required>

                            <option value="">
                                -- Select Hours --
                            </option>

                            <option value="4">
                                4 Hours
                            </option>

                            <option value="6">
                                6 Hours
                            </option>

                            <option value="8">
                                8 Hours
                            </option>

                        </select>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 WORK TERMS
            ================================================== -->

            <section class="section" id="terms">

                <div class="section-head">

                    <div class="section-icon">
                        ☰
                    </div>

                    <div>

                        <h2>
                            Work Terms
                        </h2>

                        <p class="sub">
                            Internship type and charges
                        </p>

                    </div>

                </div>


                <div class="grid">

                    <!-- INTERNSHIP TYPE -->
                    @*     <div class="field">

                        <label>
                            Internship Type
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nInternshipFellowshipTypeID"
                                id="nInternshipFellowshipTypeID"
                                class="form-select">
                            <option value="0">-- Select Fellowship Type --</option>
                        </select>

                    </div> *@

                    <div class="field">

                        <label>
                            Internship Type
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nInternshipTypeID"
                                id="nInternshipTypeID"
                                class="form-select">
                            <option value="0">-- Select Fellowship Type --</option>
                        </select>

                    </div>


                    <!-- SHIFT -->

                    <div class="field">

                        <label>
                            Working Shift
                            <span class="req">*</span>
                        </label>

                        <select id="sWorkingShift"
                                name="sWorkingShift"
                                required>

                            <option value="">
                                -- Select Shift --
                            </option>

                            <option value="Day">
                                Day
                            </option>

                            <option value="Night">
                                Night
                            </option>

                            <option value="Flexible">
                                Flexible
                            </option>

                        </select>

                    </div>


                    <!-- FREE / PAID -->
                    <div class="field">

                        <label>
                            Internship Fellowship Type
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nInternshipFellowshipTypeID"
                                id="nInternshipFellowshipTypeID"
                                class="form-select">
                            <option value="0">-- Select Fellowship Type --</option>
                        </select>

                    </div>

                    @* <div class="field">

                        <label>
                            Free / Paid Type
                            <span class="req">*</span>
                        </label>

                        <select id="nInternshipFellowshipTypeID"
                                name="nInternshipFellowshipTypeID"
                                required>

                            <option value="0">
                                -- Select Type --
                            </option>

                        </select>

                    </div> *@


                    <!-- TOTAL CHARGES -->

                    <div class="field">

                        <label>
                            Total Charges
                        </label>

                        <input type="number"
                               id="sTotalCharges"
                               name="sTotalCharges"
                               step="0.01"
                               min="0"
                               placeholder="Enter charges" />

                    </div>


                    <!-- CURRENCY -->

                    <div class="field">

                        <label>
                            Currency
                        </label>

                        <select id="sCurrency"
                                name="sCurrency">

                            <option value="">
                                -- Select Currency --
                            </option>

                            <option value="INR">
                                INR
                            </option>

                            <option value="USD">
                                USD
                            </option>

                            <option value="EUR">
                                EUR
                            </option>

                        </select>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 DURATION
            ================================================== -->

            <section class="section" id="schedule">

                <div class="section-head">

                    <div class="section-icon">
                        📅
                    </div>

                    <div>

                        <h2>
                            Duration & Dates
                        </h2>

                        <p class="sub">
                            Define internship duration
                        </p>

                    </div>

                </div>


                <div class="grid">

                    <!-- TRAINING INVOLVED -->

                    <div class="field">

                        <label>
                            Training Involved
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nTrainingInvolvedID"
                                id="nTrainingInvolvedID"
                                class="form-select">
                            <option value="0">-- Select Training Involved --</option>
                        </select>

                    </div>


                    <!-- DURATION -->

                    <div class="field">

                        <label>
                            Internship Duration
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nInternshipDurationID"
                                id="nInternshipDurationID"
                                class="form-select">
                            <option value="0">-- Select Duration --</option>
                        </select>

                    </div>


                    <!-- START DATE -->

                    <div class="field">

                        <label>
                            Start Date
                            <span class="req">*</span>
                        </label>

                        <input type="date"
                               id="dStartDate"
                               name="dStartDate"
                               required />

                    </div>


                    <!-- COMPLETION DATE -->

                    <div class="field">

                        <label>
                            Completion Date
                            <span class="req">*</span>
                        </label>

                        <input type="date"
                               id="dCompletionDate"
                               name="dCompletionDate"
                               required />

                    </div>

                </div>

            </section>


            <!-- =================================================
                 MODE
            ================================================== -->

            <section class="section" id="mode">

                <div class="section-head">

                    <div class="section-icon">
                        💼
                    </div>

                    <div>

                        <h2>
                            Mode & Language
                        </h2>

                        <p class="sub">
                            Select working mode and candidate requirements
                        </p>

                    </div>

                </div>


                <div class="grid">

                    <!-- MODE -->

                    <div class="field">

                        <label>
                            Internship Mode
                            <span class="req">*</span>
                        </label>

                        <select asp-for="nInternshipModeID"
                                id="nInternshipModeID"
                                class="form-select">
                            <option value="0">-- Select Internship Mode --</option>
                        </select>

                    </div>


                    <!-- DIVYANG -->

                    <div class="field">

                        <label>
                            Divyang
                        </label>

                        <select id="sDivyang"
                                name="sDivyang">

                            <option value="">
                                -- Select --
                            </option>

                            <option value="Yes">
                                Yes
                            </option>

                            <option value="No">
                                No
                            </option>

                        </select>

                    </div>


                    <!-- LANGUAGE -->

                    <div class="field">

                        <label>
                            Language Known
                        </label>

                        <input type="text"
                               id="sLanguageKnown"
                               name="sLanguageKnown"
                               placeholder="e.g. English, Hindi" />

                    </div>

                </div>

            </section>


            <!-- =================================================
                 WORKING DAYS
            ================================================== -->

            <input type="hidden"
                   id="sWorkingDays"
                   name="sWorkingDays"
                   value="" />

            <input type="hidden"
                   id="sFacilities"
                   name="sFacilities"
                   value="" />

            <section class="section" id="days">

                <div class="section-head">

                    <div class="section-icon">
                        🗓
                    </div>

                    <div>

                        <h2>
                            Working Days
                        </h2>

                        <p class="sub">
                            Select applicable working days
                        </p>

                    </div>

                </div>


                <div id="daysGroup"
                     class="checkbox-grid">

                    <label class="check-item">
                        <input type="checkbox"
                               name="WorkingDays"
                               value="Monday">
                        Monday
                    </label>

                    <label class="check-item">
                        <input type="checkbox"
                               name="WorkingDays"
                               value="Tuesday">
                        Tuesday
                    </label>

                    <label class="check-item">
                        <input type="checkbox"
                               name="WorkingDays"
