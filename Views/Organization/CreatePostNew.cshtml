    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const durationDropdown =
                document.getElementById("nInternshipDurationID");

            const startDate =
                document.getElementById("dStartDate");

            const completionDate =
                document.getElementById("dCompletionDate");


            // Duration changed
            durationDropdown.addEventListener("change", function () {

                calculateCompletionDate();

            });


            // Start date changed
            startDate.addEventListener("change", function () {

                calculateCompletionDate();

            });


            function calculateCompletionDate() {

                const durationId =
                    parseInt(durationDropdown.value);

                const startValue =
                    startDate.value;


                // Nothing selected
                if (durationId === 0 || !startValue) {

                    completionDate.value = "";

                    return;
                }


                // Create date
                const date =
                    new Date(startValue + "T00:00:00");


                if (isNaN(date.getTime())) {

                    completionDate.value = "";

                    return;
                }


                /*
                    IMPORTANT

                    Change these IDs according to
                    your Duration master table.

                    Example:
                    4 Weeks  = 1
                    6 Weeks  = 2
                    12 Weeks = 3
                    24 Weeks = 4
                    1 Year   = 5
                */


                switch (durationId) {

                    case 1: // 4 Weeks

                        date.setDate(
                            date.getDate() + 28
                        );

                        break;


                    case 2: // 6 Weeks

                        date.setDate(
                            date.getDate() + 42
                        );

                        break;


                    case 3: // 12 Weeks

                        date.setDate(
                            date.getDate() + 84
                        );

                        break;


                    case 4: // 24 Weeks

                        date.setDate(
                            date.getDate() + 168
                        );

                        break;


                    case 5: // 1 Year

                        date.setFullYear(
                            date.getFullYear() + 1
                        );

                        break;


                    default:

                        completionDate.value = "";

                        return;
                }


                // Convert date to yyyy-MM-dd
                const year =
                    date.getFullYear();

                const month =
                    String(
                        date.getMonth() + 1
                    ).padStart(2, "0");

                const day =
                    String(
                        date.getDate()
                    ).padStart(2, "0");


                completionDate.value =
                    `${year}-${month}-${day}`;

            }

        });

    </script>



    <script>

        // =========================================================
        // LOAD ALL SKILLS WHEN PAGE LOADS
        // =========================================================

        document.addEventListener("DOMContentLoaded", function () {

            loadTechnicalSkills();

            loadMedicalSkills();

            loadNonTechnicalSkills();

        });


        // =========================================================
        // TECHNICAL SKILLS
        // =========================================================

        async function loadTechnicalSkills() {

            const container =
                document.getElementById("technicalBody");

            if (!container) {
                return;
            }

            try {

                const response =
                    await fetch("/Organization/GetTechnicalSkills");

                if (!response.ok) {

                    throw new Error(
                        "Technical Skills API returned HTTP " +
                        response.status
                    );
                }

                const skills =
                    await response.json();

                container.innerHTML = "";

                if (!Array.isArray(skills) ||
                    skills.length === 0) {

                    container.innerHTML =
                        "<span>No technical skills available.</span>";

                    return;
                }


                skills.forEach(function (skill) {

                    const label =
                        document.createElement("label");

                    label.className = "check-item";


                    const checkbox =
                        document.createElement("input");

                    checkbox.type = "checkbox";

                    checkbox.name = "TechnicalSkillIDs";

                    checkbox.value =
                        skill.nTechnicalSkillID;


                    // Existing checked value from database
                    checkbox.checked =
                        skill.isChecked === true ||
                        skill.IsChecked === true;


                    checkbox.addEventListener(
                        "change",
                        updateTechnicalCount
                    );


                    const text =
                        document.createTextNode(
                            skill.sTechnicalSkillName
                        );


                    label.appendChild(checkbox);

                    label.appendChild(text);

                    container.appendChild(label);

