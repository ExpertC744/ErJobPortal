            // =========================================================
            // 20. DATE VALIDATION
            // =========================================================

            function validateDates() {

                const start =
                    document.getElementById("dStartDate");

                const completion =
                    document.getElementById("dCompletionDate");


                if (!start || !completion) return;


                if (!start.value) return;


                const today = new Date();

                today.setHours(0, 0, 0, 0);


                const startDate =
                    new Date(start.value + "T00:00:00");


                if (startDate < today) {

                    start.setCustomValidity(
                        "Start date cannot be earlier than today."
                    );

                }
                else {

                    start.setCustomValidity("");

                }


                if (completion.value) {

                    const completionDate =
                        new Date(
                            completion.value + "T00:00:00"
                        );


                    if (completionDate <= startDate) {

                        completion.setCustomValidity(
                            "Completion date must be after start date."
                        );

                    }
                    else {

                        completion.setCustomValidity("");

                    }

                }

            }


