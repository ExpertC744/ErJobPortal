<script>
    (function () {
        "use strict";

        const root = document.querySelector(".ap");

        if (!root) return;

        const form = root.querySelector("#phaseForm");
        const messageBox = root.querySelector("#messageBox");
        const navLinks = root.querySelectorAll('.side-nav a[href^="#"]');

        // Display feedback
        function showMessage(message, type) {
            messageBox.textContent = message;
            messageBox.className = type;
            messageBox.setAttribute("role", "status");

            messageBox.scrollIntoView({
                behavior: "smooth",
                block: "center"
            });
        }

        // Sidebar navigation and active section
        navLinks.forEach(function (link) {
            link.addEventListener("click", function (event) {
                const target = root.querySelector(link.getAttribute("href"));

                if (!target) return;

                event.preventDefault();

                target.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

                navLinks.forEach(function (item) {
                    item.classList.toggle("active", item === link);
                });
            });
        });

        // Update active navigation on scroll
        let ticking = false;

        function updateActiveLink() {
            const offset = 155;
            let current = null;

            root.querySelectorAll("main .section[id]").forEach(function (section) {
                if (section.getBoundingClientRect().top <= offset) {
                    current = section.id;
                }
            });

            navLinks.forEach(function (link) {
                link.classList.toggle(
                    "active",
                    link.getAttribute("href") === "#" + current
                );
            });

            ticking = false;
        }

        window.addEventListener("scroll", function () {
            if (!ticking) {
                window.requestAnimationFrame(updateActiveLink);
                ticking = true;
            }
        }, { passive: true });

        // Remove invalid styling as the user edits fields
        form.querySelectorAll("input, select, textarea").forEach(function (field) {
            field.addEventListener("input", function () {
                field.classList.remove("invalid");
            });

            field.addEventListener("change", function () {
                field.classList.remove("invalid");
            });
        });

        // Validate and save the static profile demo
        form.addEventListener("submit", function (event) {
            event.preventDefault();

            const requiredFields = [
                root.querySelector("#alumniName"),
                root.querySelector("#graduationYear"),
                root.querySelector("#alumniEmail"),
                root.querySelector("#company"),
                root.querySelector("#designation")
            ];

            let firstInvalid = null;

            requiredFields.forEach(function (field) {
                field.classList.remove("invalid");

                if (!field.value.trim() || !field.checkValidity()) {
                    field.classList.add("invalid");

                    if (!firstInvalid) {
                        firstInvalid = field;
                    }
                }
            });

            if (firstInvalid) {
                showMessage(
                    "Please complete all required fields with valid information.",
                    "error"
                );

                firstInvalid.focus();
                return;
            }

            showMessage(
                "Profile validated successfully. This is a static demo; no data was saved.",
                "success"
            );
        });

        // Reset form and validation messages
        form.addEventListener("reset", function () {
            window.setTimeout(function () {
                form.querySelectorAll(".invalid").forEach(function (field) {
                    field.classList.remove("invalid");
                });

                messageBox.textContent = "";
                messageBox.className = "";
            }, 0);
        });

        // Static opportunity demo
        root.querySelector("#postOpportunity").addEventListener("click", function () {
            const role = root.querySelector("#roleTitle");
            const company = root.querySelector("#opportunityCompany");
            const applyLink = root.querySelector("#applyLink");

            [role, company, applyLink].forEach(function (field) {
                field.classList.remove("invalid");
            });

            let invalid = null;

            if (!role.value.trim()) {
                invalid = role;
            } else if (!company.value.trim()) {
                invalid = company;
            } else if (applyLink.value.trim() && !applyLink.checkValidity()) {
                invalid = applyLink;
            }

            if (invalid) {
                invalid.classList.add("invalid");

                showMessage(
                    "Enter a role title and company. If provided, the application link must be valid.",
                    "error"
                );

                invalid.focus();
                return;
            }

            showMessage(
                "Opportunity details validated successfully. This is a static demo; the opportunity was not published.",
                "success"
            );
        });

        // Demo directory actions
        root.querySelectorAll("[data-profile]").forEach(function (button) {
            button.addEventListener("click", function () {
                showMessage(
                    "Static directory preview: " +
                    button.getAttribute("data-profile") +
                    ". Connect this action to your alumni profile details page.",
                    "success"
                );
            });
        });

        root.querySelectorAll("[data-connect]").forEach(function (button) {
            button.addEventListener("click", function () {
                showMessage(
                    "Connect request preview for " +
                    button.getAttribute("data-connect") +
                    ". Connect this action to your messaging or connection workflow.",
                    "success"
                );
            });
        });

    })();
</script>
