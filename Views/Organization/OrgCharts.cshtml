<script>

    document.addEventListener("DOMContentLoaded", function () {


        // =====================================================
        // CANDIDATE DATA FROM C#
        // =====================================================

        const candidateData =
        @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                                barData.Select(x => new
                                {
                                            year = x.RegistrationYear,
                                            month = x.RegistrationMonth,
                                            count = x.TotalRegistrations
                                })
                )
                );


        // =====================================================
        // CURRENT YEAR
        // =====================================================

        const currentYear =
            new Date().getFullYear();


        // =====================================================
        // MONTH NAMES
        // =====================================================

        const monthNames = [

            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"

        ];


        // =====================================================
        // CREATE 12 MONTHS
        // =====================================================

        const months = [];


        for (let i = 0; i < 12; i++) {

            months.push({

                year: currentYear,

                month: i + 1,

                label:
                    monthNames[i] +
                    " " +
                    String(currentYear).slice(-2),

                count: 0

            });

        }


        // =====================================================
        // PUT DATABASE DATA INTO MONTHS
        // =====================================================

        if (Array.isArray(candidateData)) {

            candidateData.forEach(function (item) {


                const found =
                    months.find(function (x) {

                        return (

                            x.year === Number(item.year)

                            &&

                            x.month === Number(item.month)

                        );

                    });


                if (found) {

                    found.count =
                        Number(item.count) || 0;

                }

            });

        }


        // =====================================================
        // CHART SETTINGS
        // =====================================================

        const chartLeft = 60;

        const chartRight = 735;

        const chartTop = 30;

        const chartBottom = 255;

        const chartWidth =
            chartRight - chartLeft;


        const monthGap =
            chartWidth / 11;


        // =====================================================
        // GET MAX VALUE
        // =====================================================

        const maxValue =
            Math.max(
                ...months.map(x => x.count),
                1
            );


        // =====================================================
        // IMPORTANT
        // =====================================================
        // Y AXIS IS ALWAYS 0 TO 100
        //
        // August = 6
        // September = 8
        //
        // Therefore:
        //
        // 6 / 100 = 6%
        // 8 / 100 = 8%
        //
        // The bars will NOT be converted to 60 or 80.
        // =====================================================

        const yAxisMax = 100;


        // =====================================================
        // REGISTRATION BAR CHART
        // =====================================================

        const registrationBars =
            document.getElementById(
                "registrationBars"
            );


        const barWidth = 30;


        months.forEach(function (item, index) {


            // =================================================
            // BAR X POSITION
            // =================================================

            const x =
                chartLeft +
                (index * monthGap) -
                (barWidth / 2);


            // =================================================
            // BAR HEIGHT
            // =================================================
            //
            // Example:
            //
            // count = 6
            //
            // 6 / 100 * 225
            //
            // = 13.5 pixels
            //
            // count = 8
            //
            // 8 / 100 * 225
            //
            // = 18 pixels
            //
            // =================================================

            const barHeight =
                (item.count / yAxisMax) *
                (chartBottom - chartTop);


            // =================================================
            // BAR Y POSITION
            // =================================================

            const y =
                chartBottom - barHeight;


            // =================================================
            // CREATE RECTANGLE
            // =================================================

            const rect =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "rect"
                );


            rect.setAttribute(
                "x",
                x
            );


            rect.setAttribute(
                "y",
                y
            );


            rect.setAttribute(
                "width",
                barWidth
            );


            rect.setAttribute(
                "height",
                Math.max(
                    barHeight,
                    0
                )
            );


            rect.setAttribute(
                "class",
                "chart-bar"
            );


            // =================================================
            // TOOLTIP
            // =================================================

            const title =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "title"
                );


            title.textContent =
                item.label +
                " : " +
                item.count +
                " candidate(s)";


            rect.appendChild(title);


            // =================================================
            // ADD BAR
            // =================================================

            registrationBars.appendChild(
                rect
            );

        });


        // =====================================================
        // REGISTRATION MONTH LABELS
        // =====================================================

        const registrationMonths =
            document.getElementById(
                "registrationMonths"
            );


        months.forEach(function (item, index) {


            const text =
                document.createElementNS(
                    "http://www.w3.org/2000/svg",
                    "text"
                );


            const x =
                chartLeft +
                (index * monthGap);


            text.setAttribute(
                "x",
                x
            );


            text.setAttribute(
                "y",
                chartBottom + 20
            );


            text.setAttribute(
                "text-anchor",
                "middle"
            );


            text.setAttribute(
                "class",
                "chart-axis-text"
            );


            text.textContent =
                item.label;


            registrationMonths.appendChild(
                text
            );

        });


        // =====================================================
        // TOTAL CANDIDATE REGISTRATIONS
        // =====================================================

        const totalCandidates =
            months.reduce(
                function (total, item) {

                    return total + item.count;

                },
                0
            );


        // =====================================================
        // DEBUG
        // =====================================================

        console.log(
            "Candidate registrations:",
            totalCandidates
        );


        console.log(
            "Candidate monthly data:",
            months
        );


    });

</script>