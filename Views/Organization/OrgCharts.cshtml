@model ErJobPortal.Models.OrganizationChartsViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Charts";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";

    var areaData = Model?.AreaChartData
        ?? new List<ErJobPortal.Models.OrganizationChartViewModel>();

    var barData = Model?.BarChartData
        ?? new List<ErJobPortal.Models.OrganizationChartViewModel>();

    var latestEligibleTrainees = areaData.Any()
        ? areaData
            .OrderByDescending(x => x.PostYear)
            .ThenByDescending(x => x.PostMonth)
            .First()
            .TotalEligibleTrainees
        : 0;

    var latestRegistrations = barData.Any()
        ? barData
            .OrderByDescending(x => x.RegistrationMonth)
            .First()
            .TotalRegistrations
        : 0;
}

<div class="candidate-charts-page">

    <div class="charts-heading">
        <h1>Charts</h1>
        <p>@ViewContext.RouteData.Values["id"]</p>
    </div>

    <div class="charts-grid">

        <div class="chart-card">

            <div class="chart-card-top">

                <div class="chart-info">

                    <div class="chart-title">
                        No. of Suitable Openings
                    </div>

                    <div class="chart-number">
                        @latestEligibleTrainees
                    </div>

                    <div class="chart-subtitle">
                        Current month
                    </div>

                </div>

                <div class="chart-icon">
                    <i class="fas fa-briefcase"></i>
                </div>

            </div>

            <div class="chart-wrapper">
                <canvas id="suitableOpeningChart"></canvas>
            </div>

            <div class="chart-footer">
                <i class="fas fa-chart-line"></i>

                <span>
                    Monthly suitable-opening trend
                </span>
            </div>

        </div>


        <div class="chart-card">

            <div class="chart-card-top">

                <div class="chart-info">

                    <div class="chart-title">
                        Internship Posts from Organization
                    </div>

                    <div class="chart-number">
                        @latestRegistrations
                    </div>

                    <div class="chart-subtitle">
                        Current month
                    </div>

                </div>

                <div class="chart-icon">
                    <i class="fas fa-building"></i>
                </div>

            </div>

            <div class="chart-wrapper">
                <canvas id="organizationInternshipChart"></canvas>
            </div>

            <div class="chart-footer">

                <i class="fas fa-chart-line"></i>

                <span>
                    Monthly organization internship trend
                </span>

            </div>

        </div>

    </div>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

    const months = [
    "Jan", "Feb", "Mar", "Apr",
    "May", "Jun", "Jul", "Aug",
    "Sep", "Oct", "Nov", "Dec"
    ];


    // ================================================
    // DATABASE DATA FROM MODEL
    // ================================================

    const areaData = @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                        areaData.Select(x => new
                                        {
                                                year = x.PostYear,
                                                month = x.PostMonth,
                                                value = x.TotalEligibleTrainees
                                        })
                                )
                        );


    const barData = @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                        barData.Select(x => new
                                        {
                                                month = x.RegistrationMonth,
                                                value = x.TotalRegistrations
                                        })
                                )
                        );


    // ================================================
    // 12 MONTH ARRAYS
    // ================================================

    const suitableOpeningValues =
    new Array(12).fill(0);

    const organizationInternshipValues =
    new Array(12).fill(0);


    // ================================================
    // AREA CHART DATA
    // ================================================

    areaData.forEach(function (item) {

    const monthIndex =
    Number(item.month) - 1;

    if (
    monthIndex >= 0 &&
    monthIndex < 12
    ) {

    suitableOpeningValues[monthIndex] =
    Number(item.value);

    }

    });


    // ================================================
    // BAR CHART DATA
    // ================================================

    barData.forEach(function (item) {

    const monthIndex =
    Number(item.month) - 1;

    if (
    monthIndex >= 0 &&
    monthIndex < 12
    ) {

    organizationInternshipValues[monthIndex] =
    Number(item.value);

    }

    });


    // ================================================
    // SUITABLE OPENINGS CHART
    // ================================================

    const suitableCanvas =
    document.getElementById(
    "suitableOpeningChart"
    );

    const suitableCtx =
    suitableCanvas.getContext("2d");


    const suitableGradient =
    suitableCtx.createLinearGradient(
    0,
    0,
    0,
    250
    );


    suitableGradient.addColorStop(
    0,
    "rgba(30, 123, 103, 0.18)"
    );


    suitableGradient.addColorStop(
    1,
    "rgba(30, 123, 103, 0)"
    );


    new Chart(suitableCtx, {

    type: "line",

    data: {

    labels: months,

    datasets: [{

    label: "Suitable Openings",

    data: suitableOpeningValues,

    borderColor: "#1e7b67",

    backgroundColor: suitableGradient,

    borderWidth: 3,

    fill: true,

    tension: 0.35,

    pointRadius: function (context) {

    return context.dataIndex === 11
    ? 5
    : 0;

    },

    pointHoverRadius: 6,

    pointBackgroundColor: "#ffffff",

    pointBorderColor: "#1e7b67",

    pointBorderWidth: 3

    }]

    },

    options: {

    responsive: true,

    maintainAspectRatio: false,

    plugins: {

    legend: {
    display: false
    },

    tooltip: {
    enabled: true
    }

    },

    scales: {

    x: {

    grid: {
    display: false
    },

    border: {
    display: false
    },

    ticks: {

    color: "#7c8ba5",

    font: {
    size: 11
    }

    }

    },

    y: {

    display: false,

    grid: {
    display: false
    },

    border: {
    display: false
    },

    beginAtZero: false

    }

    },

    interaction: {

    intersect: false,

    mode: "index"

    }

    }

    });


    // ================================================
    // ORGANIZATION INTERNSHIP CHART
    // ================================================

    const organizationCanvas =
    document.getElementById(
    "organizationInternshipChart"
    );

    const organizationCtx =
    organizationCanvas.getContext("2d");


    const organizationGradient =
    organizationCtx.createLinearGradient(
    0,
    0,
    0,
    250
    );


    organizationGradient.addColorStop(
    0,
    "rgba(30, 123, 103, 0.18)"
    );


    organizationGradient.addColorStop(
    1,
    "rgba(30, 123, 103, 0)"
    );


    new Chart(organizationCtx, {

    type: "line",

    data: {

    labels: months,

    datasets: [{

    label:
    "Organization Internship Posts",

    data:
    organizationInternshipValues,

    borderColor: "#1e7b67",

    backgroundColor:
    organizationGradient,

    borderWidth: 3,

    fill: true,

    tension: 0.35,

    pointRadius: function (context) {

    return context.dataIndex === 11
    ? 5
    : 0;

    },

    pointHoverRadius: 6,

    pointBackgroundColor: "#ffffff",

    pointBorderColor: "#1e7b67",

    pointBorderWidth: 3

    }]

    },

    options: {

    responsive: true,

    maintainAspectRatio: false,

    plugins: {

    legend: {
    display: false
    },

    tooltip: {
    enabled: true
    }

    },

    scales: {

    x: {

    grid: {
    display: false
    },

    border: {
    display: false
    },

    ticks: {

    color: "#7c8ba5",

    font: {
    size: 11
    }

    }

    },

    y: {

    display: false,

    grid: {
    display: false
    },

    border: {
    display: false
    },

    beginAtZero: false

    }

    },

    interaction: {

    intersect: false,

    mode: "index"

    }

    }

    });

    });

</script>


<style>

    .candidate-charts-page {
        width: 100%;
        padding: 0;
    }

    .charts-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 30px;
    }

    .chart-card {
        background: #ffffff;
        border: 1px solid #e6ebf1;
        border-radius: 22px;
        padding: 28px 30px 26px;
        min-height: 370px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.04);
    }

    .chart-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
    }

    .chart-title {
        color: #64748b;
        font-size: 15px;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .chart-number {
        color: #0f172a;
        font-size: 38px;
        line-height: 1;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .chart-subtitle {
        color: #8b9ab0;
        font-size: 13px;
    }

    .chart-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: #e7f5f1;
        color: #1e7b67;
        font-size: 22px;
    }

    .chart-wrapper {
        width: 100%;
        height: 175px;
        margin-top: 20px;
    }

        .chart-wrapper canvas {
            width: 100% !important;
            height: 100% !important;
        }

    .chart-footer {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        color: #71819a;
        font-size: 13px;
    }

        .chart-footer i {
            color: #1e7b67;
            font-size: 15px;
        }

    @@media (max-width: 991px) {

        .charts-grid {
            grid-template-columns: 1fr;
        }

        .chart-card {
            min-height: 350px;
        }
    }

    @@media (max-width: 576px) {

        .chart-card {
            padding: 22px 20px;
            border-radius: 18px;
        }

        .chart-title {
            font-size: 14px;
        }

        .chart-number {
            font-size: 32px;
        }

        .chart-icon {
            width: 48px;
            height: 48px;
            font-size: 19px;
        }

        .chart-wrapper {
            height: 160px;
        }

        .chart-footer {
            font-size: 12px;
        }
    }

</style>