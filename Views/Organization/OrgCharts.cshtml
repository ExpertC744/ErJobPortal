@model ErJobPortal.Models.OrganizationChartsViewModel

@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Charts";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";

    var areaData = Model?.AreaChartData
        ?? new List<ErJobPortal.Models.OrganizationChartViewModel>();

    var barData = Model?.BarChartData
        ?? new List<ErJobPortal.Models.OrganizationChartViewModel>();

    var latestEligibleTrainees = areaData.Any()
        ? areaData
            .OrderByDescending(x => x.PostYear)
            .ThenByDescending(x => x.PostMonth)
            .First()
            .TotalEligibleTrainees
        : 0;

    var latestRegistrations = barData.Any()
        ? barData
            .OrderByDescending(x => x.RegistrationYear)
            .ThenByDescending(x => x.RegistrationMonth)
            .First()
            .TotalRegistrations
        : 0;
}

<style>

    /* =====================================================
               TRAINEE MONTHLY ANALYTICS
               ===================================================== */

    .analytics-card {
        background: #ffffff;
        border: 1px solid #dfe5e8;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        transition: all .25s ease;
    }

        .analytics-card:hover {
            box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
        }


    /* =====================================================
               CHART HEADER
               ===================================================== */

    .analytics-header {
        min-height: 52px;
        padding: 0 18px;
        display: flex;
        align-items: center;
        gap: 11px;
        border-bottom: 1px solid #dfe5e8;
        background: #ffffff;
    }

    .analytics-header-icon {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1e7b67;
        font-size: 17px;
    }

    .analytics-header h5 {
        margin: 0;
        color: #16324f;
        font-size: 17px;
        font-weight: 500;
        letter-spacing: .1px;
    }


    /* =====================================================
               CHART BODY
               ===================================================== */

    .analytics-body {
        padding: 18px 16px 14px;
    }

    .chart-wrapper {
        position: relative;
        width: 100%;
        height: 235px;
    }

        .chart-wrapper svg {
            width: 100%;
            height: 100%;
            display: block;
        }


    /* =====================================================
               LEGEND
               ===================================================== */

    .chart-legend {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        color: #667085;
        font-size: 12px;
    }

    .legend-box {
        width: 50px;
        height: 16px;
        border: 2px solid #1e7b67;
        background: rgba(30, 123, 103, .14);
    }

    .legend-box-bar {
        width: 50px;
        height: 16px;
        background: #1e7b67;
    }


    /* =====================================================
               AXIS TEXT
               ===================================================== */

    .chart-axis-text {
        fill: #667085;
        font-size: 11px;
        font-family: Arial, sans-serif;
    }


    /* =====================================================
               GRID
               ===================================================== */

    .chart-grid {
        stroke: #e6eaed;
        stroke-width: 1;
    }

    .chart-axis {
        stroke: #cfd6da;
        stroke-width: 1;
    }


    /* =====================================================
               LINE CHART
               ===================================================== */

    .chart-line {
        fill: none;
        stroke: #1e7b67;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .chart-area {
        fill: rgba(30, 123, 103, .14);
    }

    .chart-point {
        fill: #ffffff;
        stroke: #1e7b67;
        stroke-width: 2;
    }


    /* =====================================================
               BAR CHART
               ===================================================== */

    .chart-bar {
        fill: #1e7b67;
        transition: opacity .2s ease;
    }

        .chart-bar:hover {
            opacity: .78;
        }


    /* =====================================================
               CURRENT VALUE
               ===================================================== */

    .analytics-value {
        text-align: center;
        margin-top: 5px;
        color: #667085;
        font-size: 11px;
    }


    /* =====================================================
               FOOTER
               ===================================================== */

    .analytics-footer {
        border-top: 1px solid #edf0f2;
        padding: 10px 16px;
        color: #7a8494;
        font-size: 11px;
    }

        .analytics-footer i {
            color: #1e7b67;
            margin-right: 5px;
        }


    /* =====================================================
               MOBILE
               ===================================================== */

    @@media (max-width: 767px) {

        .analytics-header {
            min-height: 48px;
            padding: 0 14px;
        }

            .analytics-header h5 {
                font-size: 15px;
            }

        .analytics-body {
            padding: 15px 10px 10px;
        }

        .chart-wrapper {
            height: 210px;
        }

        .chart-axis-text {
            font-size: 9px;
        }
    }
</style>


