                 class="master-page-info text-center d-none">
            </div>

        </div>


    </div>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // MONTH NAMES
        // =====================================================

        const monthNames = [
        "Jan",
        "Feb",
        "Mar",
        "Apr",
        "May",
        "Jun",
        "Jul",
        "Aug",
        "Sep",
        "Oct",
        "Nov",
        "Dec"
        ];


        // =====================================================
        // CURRENT YEAR
        // =====================================================

        const currentYear = new Date().getFullYear();


        // =====================================================
        // =====================================================
        // 1. ELIGIBLE TRAINEE CHART
        // =====================================================
        // =====================================================


        // =====================================================
        // DATA FROM C#
        // =====================================================

        const eligibleData =
        @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                                areaData.Select(x => new
                                {
                                        year = x.PostYear,
                                        month = x.PostMonth,
                                        count = x.TotalEligibleTrainees
                                })
                )
                );


        console.log(
        "Eligible Data From C#:",
        eligibleData
        );


        // =====================================================
        // CREATE 12 MONTHS
        // =====================================================

        const eligibleMonths = [];


        for (let i = 1; i <= 12; i++) {

        eligibleMonths.push({

        year: currentYear,

        month: i,

        label:
        monthNames[i - 1] +
        " " +
        String(currentYear).slice(-2),

        count: 0

        });

        }


        // =====================================================
        // PUT DATABASE VALUES INTO MONTHS
        // =====================================================

        if (Array.isArray(eligibleData)) {

        eligibleData.forEach(function (item) {

        const itemYear =
        Number(item.year);

        const itemMonth =
        Number(item.month);

        const itemCount =
        Number(item.count) || 0;


        const found =
        eligibleMonths.find(function (x) {

        return (
        x.year === itemYear &&
        x.month === itemMonth
        );

        });


        if (found) {

        /*
        * IMPORTANT:
        * Do NOT add the value again.
        *
        * SP should already return the
        * monthly eligible trainee total.
        */

        found.count = itemCount;

        }

        });

        }


        console.log(
        "Eligible Monthly Data:",
        eligibleMonths
        );


        // =====================================================
        // CHART SETTINGS
        // =====================================================

        const eligibleChartLeft = 60;

        const eligibleChartRight = 735;

        const eligibleChartTop = 30;

        const eligibleChartBottom = 255;

        const eligibleChartHeight =
        eligibleChartBottom -
        eligibleChartTop;

        const eligibleChartWidth =
        eligibleChartRight -
        eligibleChartLeft;

        const eligibleMonthGap =
        eligibleChartWidth / 11;


        // =====================================================
        // Y AXIS ALWAYS 0 TO 100
        // =====================================================

        const eligibleYAxisMax = 100;


        // =====================================================
        // CREATE POINTS
        // =====================================================

        const eligiblePointsData = [];


        eligibleMonths.forEach(function (item, index) {

        const x =
        eligibleChartLeft +
        (
        index *
        eligibleMonthGap
        );


        const value =
        Math.max(
        0,
        Math.min(
        Number(item.count) || 0,
        eligibleYAxisMax
        )
        );


        const y =
        eligibleChartBottom -
        (
        (
        value /
        eligibleYAxisMax
        ) *
        eligibleChartHeight
        );


        eligiblePointsData.push({

        x: x,

        y: y,

        count: value,

        label: item.label

        });

        });


        // =====================================================
        // DRAW LINE
        // =====================================================

        const eligibleLine =
        document.getElementById(
        "eligibleLine"
        );


        if (eligibleLine) {

        eligibleLine.setAttribute(
        "points",

        eligiblePointsData
        .map(function (p) {

        return (
        p.x +
        "," +
        p.y
        );

        })
        .join(" ")
        );

        }


        // =====================================================
        // DRAW AREA
        // =====================================================

        const eligibleArea =
        document.getElementById(
        "eligibleArea"
        );


        if (eligibleArea) {

        let areaPoints =
        eligiblePointsData
        .map(function (p) {

        return (
        p.x +
        "," +
        p.y
        );

        })
        .join(" ");


        areaPoints +=
        " " +
        eligibleChartRight +
        "," +
        eligibleChartBottom;


        areaPoints +=
        " " +
        eligibleChartLeft +
        "," +
        eligibleChartBottom;


        eligibleArea.setAttribute(
        "points",
        areaPoints
        );

        }


        // =====================================================
        // DRAW POINTS
        // =====================================================

        const eligiblePoints =
        document.getElementById(
        "eligiblePoints"
        );


        if (eligiblePoints) {

        eligiblePoints.innerHTML = "";


        eligiblePointsData.forEach(
        function (p) {

        const circle =
        document.createElementNS(
        "http://www.w3.org/2000/svg",
        "circle"
        );


        circle.setAttribute(
        "cx",
        p.x
        );


        circle.setAttribute(
        "cy",
        p.y
        );


        circle.setAttribute(
        "r",
        "4"
        );


        circle.setAttribute(
        "class",
        "chart-point"
        );


        // =================================================
        // TOOLTIP
        // =================================================

        const title =
        document.createElementNS(
        "http://www.w3.org/2000/svg",
        "title"
        );


        title.textContent =
        p.label +
        " : " +
        p.count +
        " eligible trainee(s)";


        circle.appendChild(
        title
        );


        eligiblePoints.appendChild(
        circle
        );

        }
        );

        }


        // =====================================================
        // ELIGIBLE MONTH LABELS
        // =====================================================

        const eligibleMonthsElement =
        document.getElementById(
        "eligibleMonths"
        );


        if (eligibleMonthsElement) {

        eligibleMonthsElement.innerHTML = "";


        eligibleMonths.forEach(
        function (item, index) {

        const text =
        document.createElementNS(
        "http://www.w3.org/2000/svg",
        "text"
        );


        const x =
        eligibleChartLeft +
        (
        index *
        eligibleMonthGap
        );


        text.setAttribute(
        "x",
        x
        );


        text.setAttribute(
        "y",
        eligibleChartBottom + 20
        );


        text.setAttribute(
        "text-anchor",
        "middle"
        );


        text.setAttribute(
        "class",
        "chart-axis-text"
        );


        text.textContent =
        item.label;


        eligibleMonthsElement.appendChild(
        text
        );

        }
        );

        }



        // =====================================================
        // =====================================================
        // 2. CANDIDATE REGISTRATION CHART
        // =====================================================
        // =====================================================


        // =====================================================
        // DATA FROM C#
        // =====================================================

        const candidateData =
        @Html.Raw(
                                System.Text.Json.JsonSerializer.Serialize(
                                                barData.Select(x => new
                                                {
                                                        year = x.RegistrationYear,
                                                        month = x.RegistrationMonth,
                                                        count = x.TotalRegistrations
                                                })
                                )
                );


        console.log(
        "Candidate Data From C#:",
        candidateData
        );


        // =====================================================
        // CREATE 12 MONTHS
        // =====================================================

        const registrationMonths = [];


        for (let i = 1; i <= 12; i++) {

        registrationMonths.push({

        year: currentYear,

        month: i,

        label:
        monthNames[i - 1] +
        " " +
        String(currentYear).slice(-2),

        count: 0

        });

        }


        // =====================================================
        // PUT DATABASE DATA INTO MONTHS
        // =====================================================

        if (Array.isArray(candidateData)) {

        candidateData.forEach(function (item) {

        const itemYear =
        Number(item.year);

        const itemMonth =
        Number(item.month);

        const itemCount =
        Number(item.count) || 0;


        const found =
        registrationMonths.find(
        function (x) {

        return (
        x.year === itemYear &&
        x.month === itemMonth
        );

        }
        );


        if (found) {

        found.count = itemCount;

        }

        });

        }


        // =====================================================
        // CHART SETTINGS
        // =====================================================

        const registrationChartLeft = 60;

        const registrationChartRight = 735;

        const registrationChartTop = 30;

        const registrationChartBottom = 255;

        const registrationChartHeight =
        registrationChartBottom -
        registrationChartTop;

        const registrationChartWidth =
        registrationChartRight -
        registrationChartLeft;

        const registrationMonthGap =
        registrationChartWidth / 11;


        // =====================================================
        // Y AXIS = 0 TO 100
        // =====================================================

        const registrationYAxisMax = 100;


        // =====================================================
        // BARS
        // =====================================================

        const registrationBars =
        document.getElementById(
        "registrationBars"
        );


        if (registrationBars) {

        registrationBars.innerHTML = "";

        const barWidth = 30;


        registrationMonths.forEach(
        function (item, index) {

        const x =
        registrationChartLeft +
        (
        index *
        registrationMonthGap
        ) -
        (
        barWidth / 2
        );


        const value =
        Math.max(
        0,
        Math.min(
        Number(item.count) || 0,
        registrationYAxisMax
        )
        );


        const barHeight =
        (
        value /
        registrationYAxisMax
        ) *
        registrationChartHeight;


        const y =
        registrationChartBottom -
        barHeight;


        const rect =
        document.createElementNS(
        "http://www.w3.org/2000/svg",
        "rect"
        );


        rect.setAttribute(
        "x",
        x
        );


        rect.setAttribute(
        "y",
        y
        );


        rect.setAttribute(
        "width",
        barWidth
        );


        rect.setAttribute(
        "height",
        barHeight
        );


        rect.setAttribute(
        "class",
        "chart-bar"
        );


        // =================================================
        // TOOLTIP
        // =================================================

        const title =
        document.createElementNS(
        "http://www.w3.org/2000/svg",
        "title"
        );


        title.textContent =
        item.label +
        " : " +
        value +
        " candidate(s)";


        rect.appendChild(
        title
        );


        registrationBars.appendChild(
        rect
        );

        }
        );

        }


        // =====================================================
        // REGISTRATION MONTH LABELS
        // =====================================================

        const registrationMonthsElement =
        document.getElementById(
        "registrationMonths"
        );


        if (registrationMonthsElement) {

        registrationMonthsElement.innerHTML = "";


        registrationMonths.forEach(
        function (item, index) {

        const text =
        document.createElementNS(
        "http://www.w3.org/2000/svg",
        "text"
        );


        const x =
        registrationChartLeft +
        (
        index *
        registrationMonthGap
        );


        text.setAttribute(
        "x",
        x
        );


        text.setAttribute(
        "y",
        registrationChartBottom + 20
        );


        text.setAttribute(
        "text-anchor",
        "middle"
        );


        text.setAttribute(
        "class",
        "chart-axis-text"
        );


        text.textContent =
        item.label;


        registrationMonthsElement.appendChild(
        text
        );

        }
        );

        }


        // =====================================================
        // DEBUG
        // =====================================================

        console.log(
        "FINAL ELIGIBLE MONTHS:",
        eligibleMonths
        );

        console.log(
        "FINAL REGISTRATION MONTHS:",
        registrationMonths
        );

        });

    </script>
</div>


