<!-- =========================================================
     JQUERY
========================================================= -->

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
 

        <script>

    document.addEventListener("DOMContentLoaded", function () {

        /* =====================================================
           MONTHS
        ===================================================== */

        const months = [
            "Jan",
            "Feb",
            "Mar",
            "Apr",
            "May",
            "Jun",
            "Jul",
            "Aug",
            "Sep",
            "Oct",
            "Nov",
            "Dec"
        ];


        /* =====================================================
           MONTHLY CANDIDATE REGISTRATION DATA
        ===================================================== */

        const monthlyRegistrationData =
            @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    ViewBag.MonthlyCandidateRegistrations
                )
            );


        /* =====================================================
           COMMON GRADIENT
        ===================================================== */

        function createTealGradient(context) {

            const chart =
                context.chart;

            const ctx =
                chart.ctx;

            const gradient =
                ctx.createLinearGradient(
                    0,
                    0,
                    0,
                    190
                );

            gradient.addColorStop(
                0,
                "rgba(30, 123, 103, 0.20)"
            );

            gradient.addColorStop(
                1,
                "rgba(30, 123, 103, 0.01)"
            );

            return gradient;
        }


        /* =====================================================
           COMMON OPTIONS
        ===================================================== */

        const commonOptions = {

            responsive: true,

            maintainAspectRatio: false,

            interaction: {

                intersect: false,

                mode: "index"

            },

            plugins: {

                legend: {

                    display: false

                },

                tooltip: {

                    backgroundColor: "#ffffff",

                    titleColor: "#344054",

                    bodyColor: "#1e7b67",

                    borderColor: "#e1ebe8",

                    borderWidth: 1,

                    padding: 11,

                    displayColors: false,

                    titleFont: {

                        size: 12,

                        weight: "600"

                    },

                    bodyFont: {

                        size: 13,

                        weight: "700"

                    },

                    callbacks: {

                        label: function (context) {

                            return " " +
                                context.parsed.y +
                                " trainees";

                        }

                    }

                }

            },

            scales: {

                x: {

                    grid: {

                        display: false

                    },

                    border: {

                        display: false

                    },

                    ticks: {

                        color: "#9aa9bd",

                        font: {

                            size: 11

                        },

                        padding: 9

                    }

                },

                y: {

                    beginAtZero: true,

                    grid: {

                        color:
                            "rgba(30,123,103,.07)",

                        drawBorder: false

                    },

                    border: {

                        display: false,

                        dash: [4, 4]

                    },

                    ticks: {

                        display: false

                    }

                }

            }

        };


        /* =====================================================
           CHART 1
           ELIGIBLE TRAINEES
        ===================================================== */

        const eligibleCanvas =
            document.getElementById(
                "internshipEligibleChart"
            );


        if (eligibleCanvas) {

            /*
             * Currently using the total eligible count
             * as the chart value.
             *
             * If you later want month-wise eligible data,
             * we can send a second 12-month array from SQL.
             */

            const eligibleCount =
                Number(
                    @ViewBag.InternshipEligibleCount
                );


            /*
             * Create a smooth trend representation
             * based on the current eligible count.
             *
             * Replace this with monthly eligible data
             * when your eligibility history is available.
             */

            const eligibleData = [

                Math.round(eligibleCount * 0.38),

                Math.round(eligibleCount * 0.46),

                Math.round(eligibleCount * 0.42),

                Math.round(eligibleCount * 0.55),

                Math.round(eligibleCount * 0.61),

                Math.round(eligibleCount * 0.52),

                Math.round(eligibleCount * 0.69),

                Math.round(eligibleCount * 0.78),

                Math.round(eligibleCount * 0.73),

                Math.round(eligibleCount * 0.87),

                Math.round(eligibleCount * 0.82),

                eligibleCount

            ];


            new Chart(
                eligibleCanvas,
                {

                    type: "line",

                    data: {

                        labels: months,

                        datasets: [

                            {

                                data: eligibleData,

                                borderColor:
                                    "#1e7b67",

                                backgroundColor:
                                    function (context) {

                                        return createTealGradient(
                                            context
                                        );

                                    },

                                fill: true,

                                borderWidth: 3,

                                tension: 0.35,

                                pointRadius: function (context) {

                                    return context.dataIndex === 11
                                        ? 5
                                        : 0;

                                },

                                pointHoverRadius: 5,

                                pointBackgroundColor:
                                    "#ffffff",

                                pointBorderColor:
                                    "#1e7b67",

                                pointBorderWidth: 3

                            }

                        ]

                    },

                    options: commonOptions

                }
            );

        }


        /* =====================================================
           CHART 2
           TOTAL REGISTRATION PER MONTH
        ===================================================== */

        const registrationCanvas =
            document.getElementById(
                "monthlyRegistrationChart"
            );


        if (registrationCanvas) {

            new Chart(
                registrationCanvas,
                {

                    type: "line",

                    data: {

                        labels: months,

                        datasets: [

                            {

                                data:
                                    monthlyRegistrationData,

                                borderColor:
                                    "#1e7b67",

                                backgroundColor:
                                    function (context) {

                                        return createTealGradient(
                                            context
                                        );

                                    },

                                fill: true,

                                borderWidth: 3,

                                tension: 0.35,

                                pointRadius: function (context) {

                                    /*
                                     * Only show the final point,
                                     * exactly like your reference.
                                     */

                                    return context.dataIndex ===
                                        monthlyRegistrationData.length - 1
                                        ? 5
                                        : 0;

                                },

                                pointHoverRadius: 5,

                                pointBackgroundColor:
                                    "#ffffff",

                                pointBorderColor:
                                    "#1e7b67",

                                pointBorderWidth: 3

                            }

                        ]

                    },

                    options: commonOptions

                }

            );

        }

    });

</script>