<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script>

    document.addEventListener("DOMContentLoaded", function () {

    /* =====================================================
    MONTHS
    ===================================================== */

    const months = [
    "Jan 26",
    "Feb 26",
    "Mar 26",
    "Apr 26",
    "May 26",
    "Jun 26",
    "Jul 26",
    "Aug 26",
    "Sep 26",
    "Oct 26",
    "Nov 26",
    "Dec 26"
    ];


    /* =====================================================
    FIXED Y AXIS

    IMPORTANT:
    0 to 100 means:
    value 6 = 6
    value 20 = 20
    value 50 = 50
    value 80 = 80
    value 100 = 100
    ===================================================== */

    const yAxisMax = 100;


    /* =====================================================
    CHART POSITION
    ===================================================== */

    const chartLeft = 60;
    const chartRight = 735;
    const chartTop = 30;
    const chartBottom = 255;

    const chartHeight =
    chartBottom - chartTop;

    const chartWidth =
    chartRight - chartLeft;

    const monthGap =
    chartWidth / 11;


    /* =====================================================
    ELIGIBLE TRAINEES DATA

    Replace this later with your database data.
    ===================================================== */

    const eligibleData = [
    3,
    5,
    4,
    7,
    8,
    6,
    9,
    11,
    10,
    13,
    12,
    15
    ];


    /* =====================================================
    REGISTRATION DATA FROM C#
    ===================================================== */

    const rawRegistrationData =
    @Html.Raw(
        System.Text.Json.JsonSerializer.Serialize(
                ViewBag.MonthlyCandidateRegistrations
                ?? new object[0]
        )
        );


    /* =====================================================
    CREATE 12 MONTH DATA
    ===================================================== */

    let registrationData =
    new Array(12).fill(0);


    /* =====================================================
    READ REGISTRATION DATA
    ===================================================== */

    if (Array.isArray(rawRegistrationData)) {

    rawRegistrationData.forEach(function (item, index) {

    if (index >= 12) {
    return;
    }


    /* ---------------------------------------------
    If backend directly returns number
    --------------------------------------------- */

    if (typeof item === "number") {

    registrationData[index] =
    Number(item) || 0;

    }


    /* ---------------------------------------------
    If backend returns object
    --------------------------------------------- */

    else if (item) {

    registrationData[index] =
    Number(
    item.count ??
    item.Count ??
    item.total ??
    item.Total ??
    item.value ??
    item.Value ??
    0
    ) || 0;

    }

    });

    }


    console.log(
    "Registration Data:",
    registrationData
    );


    /* =====================================================
    =====================================================
    ELIGIBLE TRAINEE LINE CHART
    =====================================================
    ===================================================== */

    const eligibleLine =
    document.getElementById(
    "eligibleLine"
    );


    const eligibleArea =
    document.getElementById(
    "eligibleArea"
    );


    const eligiblePointGroup =
    document.getElementById(
    "eligiblePoints"
    );


    const eligibleMonths =
    document.getElementById(
    "eligibleMonths"
    );


    /* =====================================================
    CREATE ELIGIBLE LINE POINTS
    ===================================================== */

    const eligiblePoints = [];


    eligibleData.forEach(function (value, index) {

    /*
    * IMPORTANT:
    *
    * value / 100
    *
    * Therefore:
    *
    * 6  = 6%
    * 20 = 20%
    * 50 = 50%
    * 100 = 100%
    */

    const x =
    chartLeft +
    (index * monthGap);


    const y =
    chartBottom -
    (
    (Number(value) / yAxisMax)
    * chartHeight
    );


    eligiblePoints.push(
    `${x},${y}`
    );

    });


    /* =====================================================
    DRAW ELIGIBLE LINE
    ===================================================== */

    if (eligibleLine) {

    eligibleLine.setAttribute(
    "points",
    eligiblePoints.join(" ")
    );

    }


    /* =====================================================
    DRAW ELIGIBLE AREA
    ===================================================== */

    if (eligibleArea) {

    const areaPoints = [

    `${chartLeft},${chartBottom}`,

    ...eligiblePoints,

    `${chartRight},${chartBottom}`

    ];


    eligibleArea.setAttribute(
    "points",
    areaPoints.join(" ")
    );

    }


    /* =====================================================
    CLEAR OLD POINTS
    ===================================================== */

    if (eligiblePointGroup) {

    eligiblePointGroup.innerHTML = "";

    }


    /* =====================================================
    DRAW ELIGIBLE POINTS
    ===================================================== */

    eligibleData.forEach(function (value, index) {

    const x =
    chartLeft +
    (index * monthGap);


    const y =
    chartBottom -
    (
    (Number(value) / yAxisMax)
    * chartHeight
    );


    const circle =
    document.createElementNS(
    "http://www.w3.org/2000/svg",
    "circle"
    );


    circle.setAttribute(
    "cx",
    x
    );


    circle.setAttribute(
    "cy",
    y
    );


    circle.setAttribute(
    "r",
    "4"
    );


    circle.setAttribute(
    "class",
    "chart-point"
    );


    /* Tooltip */

    const title =
    document.createElementNS(
    "http://www.w3.org/2000/svg",
    "title"
    );


    title.textContent =
    months[index] +
    " : " +
    value +
    " eligible trainee(s)";


    circle.appendChild(title);


    if (eligiblePointGroup) {

    eligiblePointGroup.appendChild(
    circle
    );

    }

    });


    /* =====================================================
    ELIGIBLE MONTH LABELS
    ===================================================== */

    if (eligibleMonths) {

    eligibleMonths.innerHTML = "";


    months.forEach(function (month, index) {

    const text =
    document.createElementNS(
    "http://www.w3.org/2000/svg",
    "text"
    );


    const x =
    chartLeft +
    (index * monthGap);


    text.setAttribute(
    "x",
    x
    );


    text.setAttribute(
    "y",
    chartBottom + 20
    );


    text.setAttribute(
    "text-anchor",
    "middle"
    );


    text.setAttribute(
    "class",
    "chart-axis-text"
    );


    text.textContent =
    month;


    eligibleMonths.appendChild(
    text
    );

    });

    }


    /* =====================================================
    =====================================================
    REGISTRATION BAR CHART
    =====================================================
    ===================================================== */

    const registrationBars =
    document.getElementById(
    "registrationBars"
    );


    if (registrationBars) {

    registrationBars.innerHTML = "";

    }


    const barWidth = 30;


    registrationData.forEach(function (value, index) {

    const numericValue =
    Number(value) || 0;


    /* ---------------------------------------------
    BAR X POSITION
    --------------------------------------------- */

    const x =
    chartLeft +
    (index * monthGap) -
    (barWidth / 2);


    /* ---------------------------------------------
    BAR HEIGHT

    IMPORTANT:

    6 / 100

    means 6% of chart height.

    Therefore 6 stays visually at 6.
    --------------------------------------------- */

    const barHeight =
    (
    numericValue /
    yAxisMax
    ) *
    chartHeight;


    /* ---------------------------------------------
    BAR Y POSITION
    --------------------------------------------- */

    const y =
    chartBottom -
    barHeight;


    /* ---------------------------------------------
    CREATE SVG RECT
    --------------------------------------------- */

    const rect =
    document.createElementNS(
    "http://www.w3.org/2000/svg",
    "rect"
    );


    rect.setAttribute(
    "x",
    x
    );


    rect.setAttribute(
    "y",
    y
    );


    rect.setAttribute(
    "width",
    barWidth
    );


    rect.setAttribute(
    "height",
    Math.max(
    barHeight,
    0
    )
    );


    rect.setAttribute(
    "class",
    "chart-bar"
    );


    /* =================================================
    TOOLTIP
    ================================================= */

    const title =
    document.createElementNS(
    "http://www.w3.org/2000/svg",
    "title"
    );


    title.textContent =
    months[index] +
    " : " +
    numericValue +
    " candidate(s)";


    rect.appendChild(
    title
    );


    if (registrationBars) {

    registrationBars.appendChild(
    rect
    );

    }

    });


    /* =====================================================
    REGISTRATION MONTH LABELS
    ===================================================== */

    const registrationMonths =
    document.getElementById(
    "registrationMonths"
    );


    if (registrationMonths) {

    registrationMonths.innerHTML = "";


    months.forEach(function (month, index) {

    const text =
    document.createElementNS(
    "http://www.w3.org/2000/svg",
    "text"
    );


    const x =
    chartLeft +
    (index * monthGap);


    text.setAttribute(
    "x",
    x
    );


    text.setAttribute(
    "y",
    chartBottom + 20
    );


    text.setAttribute(
    "text-anchor",
    "middle"
    );


    text.setAttribute(
    "class",
    "chart-axis-text"
    );


    text.textContent =
    month;


    registrationMonths.appendChild(
    text
    );

    });

    }


    /* =====================================================
    CONSOLE CHECK
    ===================================================== */

    const totalRegistrations =
    registrationData.reduce(
    function (total, value) {

    return total +
    (Number(value) || 0);

    },
    0
    );


    console.log(
    "Monthly Registration Data:",
    registrationData
    );


    console.log(
    "Total Registrations:",
    totalRegistrations
    );

    });

</script>