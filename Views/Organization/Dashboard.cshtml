                Manage Jobs

                <i class="fas fa-arrow-right"></i>

            </a>

        </div>

        @* khushi 29-09 *@
        <!-- MASTER TABLE CARD -->
        <div class="master-table-container">

            <!-- MASTER TABLE -->
            <div class="table-responsive">

                <table id="organizationJobsTable"
                       class="master-data-table">

                    <thead>
                        <tr>
                            <th>Sr. No.</th>
                            <th>Date</th>
                            <th>Position</th>
                            <th>View Post</th>
                            <th>Applied Trainees</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (appliedTraineePosts.Any())
                {
                    int srNo = 1;

                    foreach (var item in appliedTraineePosts)
                    {
                        <tr>

                            <!-- Sr. No. -->
                            <td class="master-id">
                                @srNo
                            </td>

                            <!-- Date -->
                            <td>
                                @(item.dStartDate.HasValue
                                    ? item.dStartDate.Value.ToString("dd-MM-yyyy")
                                    : "")
                            </td>

                            <!-- Position -->
                            <td>
                                @item.sPositionName
                            </td>

                            <!-- View Post -->
                            <td class="text-center">

                                <a asp-controller="Organization"
                                   asp-action="ViewOrgPost"
                                   asp-route-id="@item.nID"
                                   class="resume-view-btn"
                                   title="View Post">

                                    <i class="fas fa-eye"></i>

                                </a>

                            </td>

                            <!-- Applied Trainees -->
                            <td class="text-center">

                                <a asp-controller="Organization"
                                   asp-action="AppliedTraineeList"
                                   asp-route-id="@item.nID"
                                   class="resume-view-btn"
                                   title="View Applied Trainees">

                                    <i class="fas fa-users"></i>

                                    <span>
                                        @item.MatchingTraineeCount
                                    </span>

                                </a>

                            </td>

                        </tr>

                        srNo++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">
                            No applied trainees found.
                        </td>
                    </tr>
                }
                  
                    
                    </tbody>

                </table>

            </div>


            <!-- MASTER PAGE INFO -->
            <div id="organizationJobsPageInfo"
                 class="master-page-info text-center d-none">
            </div>

        </div>

        <script>
            $(document).ready(function () {

                $('#organizationJobsTable').DataTable({
                    paging: true,
                    searching: true,
                    ordering: true,
                    info: true,
