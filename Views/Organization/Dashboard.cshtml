@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Dashboard";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
}
 
<link href="~/css/orgdashboard.css" rel="stylesheet" />

<!-- =========================================================
     DASHBOARD
========================================================= -->

<div class="container-fluid organization-dashboard">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="org-page-header">
        <div class="org-page-title">
            <h2>
                Organization Dashboard
            </h2>
            <p>
                Manage your jobs, candidates and hiring activities.
            </p>
        </div>
        <a href="#" class="post-job-btn">
            <i class="fas fa-plus"></i>
            Post New Job
        </a>
    </div>


    <!-- =====================================================
         STATISTICS
    ====================================================== -->

    <div class="row g-4 mb-4">

        <!-- POSTED JOBS -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon green">
                        <i class="fas fa-briefcase"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        12%
                    </span>

                </div>

                <span class="stat-label">
                    Total Trainees
                </span>

                <div class="stat-number">
                    @ViewBag.TraineeRegistrationCount
                </div>

                <a asp-controller="Organization"
                   asp-action="TraineeList"
                   asp-route-id="@ViewBag.OrgCode"
                   class="stat-link">
                    View Details
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>


        <!-- APPLICATIONS -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon blue">
                        <i class="fas fa-file-lines"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        18%
                    </span>

                </div>

                <span class="stat-label">
                    Total Organizations
                </span>

                <div class="stat-number">

                    @ViewBag.OrganizationRegistrationCount

                </div>

                <a asp-controller="Organization"
                   asp-action="OrgList"
                   asp-route-id="@ViewBag.OrgCode"
                   class="stat-link">
                    View Details
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

        </div>


        <!-- SHORTLISTED -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon purple">
                        <i class="fas fa-user-check"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        8%
                    </span>

                </div>

                <span class="stat-label">
                    Top Search
                </span>

                <div class="stat-number">
                    @ViewBag.TopSearch
                </div>

                <a asp-controller="Organization"
                   asp-action="Candidates"
                   class="stat-link">
                    View Candidates
                    <i class="fas fa-arrow-right"></i>
                </a>

            </div>

        </div>


        <!-- INTERVIEWS -->

        <div class="col-xl-3 col-lg-6 col-md-6">

            <div class="org-stat-card">

                <div class="stat-top">

                    <div class="stat-icon orange">
                        <i class="fas fa-calendar-check"></i>
                    </div>

                    <span class="stat-growth">
                        <i class="fas fa-arrow-up"></i>
                        5%
                    </span>

                </div>

                <span class="stat-label">
                    Trainees Applied Your Post
                </span>

                <div class="stat-number">
                    @ViewBag.TraineesApplied
                </div>

                <a asp-controller="Organization"
                   asp-action="Interviews"
                   class="stat-link">
                    View Interviews
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>

        </div>

    </div>

