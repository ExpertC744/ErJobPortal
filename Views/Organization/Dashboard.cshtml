@{
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    ViewData["Title"] = "Organization Dashboard";
    ViewData["Panel"] = "Organization";
    ViewData["UserName"] = "Organization";
    var appliedTraineePosts =
        ViewBag.AppliedTraineePosts as List<ErJobPortal.Models.OrgPostM>
        ?? new List<ErJobPortal.Models.OrgPostM>();
}

<link href="~/css/orgdashboard.css" rel="stylesheet" />
<style>

    /* =====================================================
       1TRAINEE MONTHLY ANALYTICS @* Radhika29-09 *@
    ===================================================== */

    .analytics-card {
        background: #ffffff;
        border: 1px solid #dfe5e8;
        border-radius: 14px;
        overflow: hidden;
        height: 100%;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);
        transition: all .25s ease;
    }

    .analytics-card:hover {
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    }

    /* Chart Header */
    .analytics-header {
        min-height: 52px;
        padding: 0 18px;
        display: flex;
        align-items: center;
        gap: 11px;
        border-bottom: 1px solid #dfe5e8;
        background: #ffffff;
    }

    .analytics-header-icon {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1e7b67;
        font-size: 17px;
    }

    .analytics-header h5 {
        margin: 0;
        color: #16324f;
        font-size: 17px;
        font-weight: 500;
        letter-spacing: .1px;
    }

    /* Chart Body */
    .analytics-body {
        padding: 18px 16px 14px;
    }

    .chart-wrapper {
        position: relative;
        width: 100%;
        height: 235px;
    }

        .chart-wrapper svg {
            width: 100%;
            height: 100%;
            display: block;
        }

    /* Legend */
    .chart-legend {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        color: #667085;
        font-size: 12px;
    }

    .legend-box {
        width: 50px;
        height: 16px;
        border: 2px solid #1e7b67;
        background: rgba(30, 123, 103, .14);
    }

    .legend-box-bar {
        width: 50px;
        height: 16px;
        background: #1e7b67;
    }

    /* Axis text */
    .chart-axis-text {
        fill: #667085;
        font-size: 11px;
        font-family: Arial, sans-serif;
    }

    /* Grid */
    .chart-grid {
        stroke: #e6eaed;
        stroke-width: 1;
    }

    .chart-axis {
        stroke: #cfd6da;
        stroke-width: 1;
    }

    /* Line chart */
    .chart-line {
        fill: none;
        stroke: #1e7b67;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    .chart-area {
        fill: rgba(30, 123, 103, .14);
    }

    .chart-point {
        fill: #ffffff;
        stroke: #1e7b67;
        stroke-width: 2;
    }

    /* Bar chart */
    .chart-bar {
        fill: #1e7b67;
        transition: opacity .2s ease;
    }

        .chart-bar:hover {
            opacity: .78;
        }

    /* Current value */
    .analytics-value {
        text-align: center;
        margin-top: 5px;
        color: #667085;
        font-size: 11px;
    }

    /* Footer */
    .analytics-footer {
        border-top: 1px solid #edf0f2;
        padding: 10px 16px;
        color: #7a8494;
        font-size: 11px;
    }

        .analytics-footer i {
            color: #1e7b67;
            margin-right: 5px;
        }

    @@media (max-width: 767px) {

        .analytics-header {
            min-height: 48px;
            padding: 0 14px;
        }

            .analytics-header h5 {
                font-size: 15px;
            }

        .analytics-body {
            padding: 15px 10px 10px;
        }

        .chart-wrapper {
            height: 210px;
        }

        .chart-axis-text {
            font-size: 9px;
        }
    }
</style>
