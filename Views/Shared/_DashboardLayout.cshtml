<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />
    <title>
        @ViewData["Title"] - 1Trainee
    </title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    @*   @model ErJobPortal.Models.SAFeedbackM *@

    @* @{
        Layout = "~/Views/Shared/_DashboardLayout.cshtml";

        ViewData["Title"] = "Super Admin Dashboard";

        ViewData["Panel"] = "SuperAdmin";

        ViewData["UserName"] = "Super Admin";
    } *@
    @section Styles {

        <link rel="stylesheet"
              href="~/css/EditSAFeedback.css"
              asp-append-version="true" />

    }
    @*     @{

        ViewData["Title"] = "Edit Trainee Feedback";
    } *@
     @* data-table css *@

    <link href="~/css/dashboardlayout.css" rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/datatables.min.css" />

    <link rel="stylesheet"
          href="~/css/master-table.css" />
    @* Page Specific CSS *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <div class="dashboard-wrapper">

        <!-- ================= SIDEBAR ================= -->

        <aside class="dashboard-sidebar" id="dashboardSidebar">

            <!-- Logo -->
            <div class="sidebar-logo">

                <div class="logo-icon">
                    <i class="fas fa-briefcase"></i>
                </div>

                <div class="logo-text">
                    <span>1</span>Trainee
                </div>

            </div>


            <!-- ================= CANDIDATE ================= -->
            @if (ViewData["Panel"]?.ToString() == "Candidate")
            {
                var candidateCode = ViewBag.CandidateCode?.ToString();
                <div class="sidebar-section candidate-sidebar">

                    <!-- ================= DASHBOARD ================= -->

                    <a asp-controller="Candidate"
                       asp-action="Dashboard"
                       class="sidebar-link"
                       asp-route-id="@candidateCode">

                        <span class="menu-text">
                            Dashboard
                        </span>

                    </a>




                    <!-- ================= PROFILE ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('candidateProfileSubmenu', 'candidateProfileArrow')">

                            <span class="menu-icon">
                                <i class="far fa-square"></i>
                            </span>

                            <span class="menu-text">
                                Profile
                            </span>

                            <span class="profile-arrow"
                                  id="candidateProfileArrow">

                                <i class="fas fa-chevron-right"></i>

                            </span>

                        </div>


                        <div class="profile-submenu"
                             id="candidateProfileSubmenu">

                             @* Radhika 21-09 *@

                          <a asp-controller="Resume"
   asp-action="Resume"
   asp-route-id="@Context.Session.GetInt32("CandidateID")"
   class="profile-submenu-link">

    View Profile

</a>

                            <a asp-controller="Candidate"
                               asp-action="Profile"
                               class="profile-submenu-link">

                                Edit Profile

                            </a>

                        </div>

                    </div>


                    <!-- ================= HISTORY ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('candidateHistorySubmenu', 'candidateHistoryArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-book-open"></i>
                            </span>

                            <span class="menu-text">
                                History
                            </span>

                            <span class="profile-arrow"
                                  id="candidateHistoryArrow">

                                <i class="fas fa-chevron-right"></i>

                            </span>

                        </div>


                        <div class="profile-submenu"
                             id="candidateHistorySubmenu">

                            <a asp-controller="Candidate"
                               asp-action="MyInternship"
                               asp-route-id="@ViewBag.CandidateCode"
                               class="profile-submenu-link">

                                My Internship

                            </a>

                        </div>

                    </div>


                    <!-- ================= STATUS ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('candidateStatusSubmenu', 'candidateStatusArrow')">

                            <span class="menu-icon">
                                <i class="far fa-square"></i>
                            </span>

                            <span class="menu-text">
                                Status
                            </span>

                            <span class="profile-arrow"
                                  id="candidateStatusArrow">

                                <i class="fas fa-chevron-right"></i>

                            </span>

                        </div>


                        <div class="profile-submenu"
                             id="candidateStatusSubmenu">

                            <a asp-controller="Candidate"
                               asp-action="OrganizationInterested"
                               asp-route-id="@candidateCode"
                               class="profile-submenu-link">

                                Organization Interested

                            </a>


                            <a asp-controller="Candidate"
                               asp-action="TraineeStatus"
                               asp-route-id="@candidateCode"
                               class="profile-submenu-link">

                                Trainee Status

                            </a>

                        </div>

                    </div>


                    <!-- ================= CHARTS ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('candidateChartsSubmenu', 'candidateChartsArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-chart-area"></i>
                            </span>

                            <span class="menu-text">
                                Charts
                            </span>

                            <span class="profile-arrow"
                                  id="candidateChartsArrow">

                                <i class="fas fa-chevron-right"></i>

                            </span>

                        </div>


                        <div class="profile-submenu"
                             id="candidateChartsSubmenu">

                            <a asp-controller="Candidate"
                               asp-action="InternshipInfo"
                               asp-route-id="@candidateCode"
                               class="profile-submenu-link">

                                Internship Info

                            </a>

                        </div>

                    </div>


                    <!-- ================= INTERNSHIP DETAILS ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('candidateInternshipSubmenu', 'candidateInternshipArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-table"></i>
                            </span>

                            <span class="menu-text">
                                Internship details
                            </span>

                            <span class="profile-arrow"
                                  id="candidateInternshipArrow">

                                <i class="fas fa-chevron-right"></i>

                            </span>

                        </div>


                        <div class="profile-submenu" id="candidateInternshipSubmenu">
                            <a asp-controller="Candidate"
                               asp-action="InternshipDetails"
                               asp-route-id="@ViewBag.CandidateCode"
                               class="profile-submenu-link">
                                View
                            </a>
                        </div>

                    </div>


                    <!-- ================= FEEDBACK ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('candidateFeedbackSubmenu', 'candidateFeedbackArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-table"></i>
                            </span>

                            <span class="menu-text">
                                Feedback
                            </span>

                            <span class="profile-arrow"
                                  id="candidateFeedbackArrow">

                                <i class="fas fa-chevron-right"></i>

                            </span>

                        </div>


                        <div class="profile-submenu"
                             id="candidateFeedbackSubmenu">

                            <a asp-controller="Candidate"
                               asp-action="CreateFeedback"
                               asp-route-id="@candidateCode"
                               class="profile-submenu-link">

                                Create Feedback

                            </a>

                        </div>

                    </div>

                    <!-- ================= LOGOUT ================= -->

                    <div class="sidebar-logout">

                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="logout-link">

                            <span class="menu-icon">
                                <i class="fas fa-right-from-bracket"></i>
                            </span>

                            <span class="menu-text">
                                Logout
                            </span>

                        </a>

                    </div>

                </div>
            }


            <!-- ================= ORGANIZATION ================= -->
            @if (ViewData["Panel"]?.ToString() == "Organization")
            {
                var orgCode = ViewBag.OrgCode?.ToString();
                orgCode = Context.Request.RouteValues["id"]?.ToString();
                <div class="sidebar-section">

                    <!-- ================= DASHBOARD ================= -->

                    <a asp-controller="Organization"
                       asp-action="Dashboard"
                       asp-route-id="@orgCode"
                       class="sidebar-link">

                        <span class="menu-icon">
                            <i class="fas fa-chart-pie"></i>
                        </span>

                        <span class="menu-text">
                            Dashboard
                        </span>

                    </a>


                    <!-- ================= PROFILE ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('profileSubmenu', 'profileArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-id-card"></i>
                            </span>

                            <span class="menu-text">
                                Profile
                            </span>

                            <span class="profile-arrow" id="profileArrow">
                                <i class="fas fa-chevron-right"></i>
                            </span>

                        </div>

                        <div class="profile-submenu" id="profileSubmenu">

                            <a asp-controller="Organization"
                               asp-action="ViewOrgProfile"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                View Profile
                            </a>

                            <a asp-controller="Organization"
                               asp-action="EditProfile"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                Edit Profile
                            </a>

                        </div>

                    </div>


                    <!-- ================= POST DETAILS ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('postSubmenu', 'postArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-clipboard-list"></i>
                            </span>

                            <span class="menu-text">
                                Post Details
                            </span>

                            <span class="profile-arrow" id="postArrow">
                                <i class="fas fa-chevron-right"></i>
                            </span>

                        </div>

                        <div class="profile-submenu" id="postSubmenu">

                            <a asp-controller="Organization"
                               asp-action="CreatePostNew"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                Create New Post
                            </a>

                            <a asp-controller="Organization"
                               asp-action="PostDetails"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                View All Post
                            </a>

                            <a asp-controller="Organization"
                               asp-action="FinalSelection"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                Final Selection
                            </a>

                        </div>

                    </div>


                    <!-- ================= HISTORY ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('historySubmenu', 'historyArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-book-open"></i>
                            </span>

                            <span class="menu-text">
                                History
                            </span>

                            <span class="profile-arrow" id="historyArrow">
                                <i class="fas fa-chevron-right"></i>
                            </span>

                        </div>

                        <div class="profile-submenu" id="historySubmenu">

                            <a asp-controller="Organization"
                               asp-action="PreviousPost"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                Previous Post
                            </a>

                        </div>

                    </div>


                    <!-- ================= CHARTS ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('chartsSubmenu', 'chartsArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-chart-area"></i>
                            </span>

                            <span class="menu-text">
                                Charts
                            </span>

                            <span class="profile-arrow" id="chartsArrow">
                                <i class="fas fa-chevron-right"></i>
                            </span>

                        </div>

                        <div class="profile-submenu" id="chartsSubmenu">

                            <a asp-controller="Organization"
                               asp-action="PostInfo"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                Post Info
                            </a>

                        </div>

                    </div>


                    <!-- ================= TOTAL TRAINEES ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('traineesSubmenu', 'traineesArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-users"></i>
                            </span>

                            <span class="menu-text">
                                Total Trainees
                            </span>

                            <span class="profile-arrow" id="traineesArrow">
                                <i class="fas fa-chevron-right"></i>
                            </span>

                        </div>

                        <div class="profile-submenu" id="traineesSubmenu">

                            <a asp-controller="Organization"
                               asp-action="Trainees"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                View
                            </a>

                        </div>

                    </div>


                    <!-- ================= FEEDBACK ================= -->

                    <div class="sidebar-dropdown">

                        <div class="sidebar-link"
                             onclick="toggleSidebarMenu('feedbackSubmenu', 'feedbackArrow')">

                            <span class="menu-icon">
                                <i class="fas fa-comment-dots"></i>
                            </span>

                            <span class="menu-text">
                                Feedback
                            </span>

                            <span class="profile-arrow" id="feedbackArrow">
                                <i class="fas fa-chevron-right"></i>
                            </span>

                        </div>

                        <div class="profile-submenu" id="feedbackSubmenu">

                            <a asp-controller="Organization"
                               asp-action="CreateFeedback"
                               asp-route-id="@orgCode"
                               class="profile-submenu-link">
                                Create Feedback
                            </a>

                        </div>

                    </div>

                    <!-- ================= LOGOUT ================= -->

                    <div class="sidebar-logout">

                        <a asp-controller="Account"
                           asp-action="Logout"
                           class="logout-link">

                            <span class="menu-icon">
                                <i class="fas fa-right-from-bracket"></i>
                            </span>

                            <span class="menu-text">
                                Logout
                            </span>

                        </a>

                    </div>

                </div>
                //session
                int? orgID = Context.Session.GetInt32("OrgID");
            }


            <!-- ================= SUPER ADMIN ================= -->
            @if (ViewData["Panel"]?.ToString() == "SuperAdmin")
            {
                <div class="sidebar-section superadmin-sidebar">

                    <!-- =========================================================
                         DASHBOARD
                    ========================================================== -->
                    <a asp-controller="SuperAdmin" asp-action="Dashboard" asp-route-id="1" class="sidebar-link active">

                        <span class="menu-icon">
                            <i class="fas fa-chart-pie"></i>
                        </span>

                        <span class="menu-text">
                            Dashboard
                        </span>

                    </a>


                    <!-- =========================================================
                         TRAINEE
                    ========================================================== -->
                    <div class="sidebar-menu">

                        <div class="sidebar-link sidebar-dropdown"
                             data-bs-toggle="collapse"
                             data-bs-target="#traineeMenu"
                             aria-expanded="false">

                            <span class="menu-icon">
                                <i class="fas fa-user-graduate"></i>
                            </span>

                            <span class="menu-text">
                                Trainee
                            </span>

                            <span class="menu-arrow">
                                <i class="fas fa-chevron-down"></i>
                            </span>

                        </div>


                        <div id="traineeMenu"
                             class="sidebar-submenu collapse">

                            <a asp-controller="SuperAdmin"
                               asp-action="SATrainees" asp-route-id="1">
                                Trainee Registrations
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Profiles" asp-route-id="1">
                                Trainee Profiles
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Status" asp-route-id="1">
                                Trainee Status
                            </a>

                        </div>

                    </div>


                    <!-- =========================================================
                         ORGANIZATION
                    ========================================================== -->
                    <div class="sidebar-menu">

                        <div class="sidebar-link sidebar-dropdown"
                             data-bs-toggle="collapse"
                             data-bs-target="#organizationMenu"
                             aria-expanded="false">

                            <span class="menu-icon">
                                <i class="fas fa-building"></i>
                            </span>

                            <span class="menu-text">
                                Organization
                            </span>

                            <span class="menu-arrow">
                                <i class="fas fa-chevron-down"></i>
                            </span>

                        </div>


                        <div id="organizationMenu"
                             class="sidebar-submenu collapse">

                            <a asp-controller="SuperAdmin"
                               asp-action="SAOrganizations" asp-route-id="1">
                                Org Registration
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Profiles" asp-route-id="1">
                                Org Profiles
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Posts" asp-route-id="1">
                                Org Posts
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="FinalSelectionDetails" asp-route-id="1">
                                Final Selection Details
                            </a>

                        </div>

                    </div>


                    <!-- =========================================================
                         CHARTS
                    ========================================================== -->
                    <div class="sidebar-menu">

                        <div class="sidebar-link sidebar-dropdown"
                             data-bs-toggle="collapse"
                             data-bs-target="#chartsMenu"
                             aria-expanded="false">

                            <span class="menu-icon">
                                <i class="fas fa-chart-area"></i>
                            </span>

                            <span class="menu-text">
                                Charts
                            </span>

                            <span class="menu-arrow">
                                <i class="fas fa-chevron-down"></i>
                            </span>

                        </div>


                        <div id="chartsMenu"
                             class="sidebar-submenu collapse">

                            <a asp-controller="SuperAdmin"
                               asp-action="Index" asp-route-id="1">
                                Charts
                            </a>

                        </div>

                    </div>


                    <!-- =========================================================
                         ADVERTISEMENT
                    ========================================================== -->
                    <div class="sidebar-menu">

                        <div class="sidebar-link sidebar-dropdown"
                             data-bs-toggle="collapse"
                             data-bs-target="#advertisementMenu"
                             aria-expanded="false">

                            <span class="menu-icon">
                                <i class="fas fa-bullhorn"></i>
                            </span>

                            <span class="menu-text">
                                Advertisement
                            </span>

                            <span class="menu-arrow">
                                <i class="fas fa-chevron-down"></i>
                            </span>

                        </div>


                        <div id="advertisementMenu"
                             class="sidebar-submenu collapse">

                            <a asp-controller="SuperAdmin"
                               asp-action="AddAdv" asp-route-id="1">
                                Add Adv
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Index" asp-route-id="1">
                                View All Adv
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Receipt" asp-route-id="1">
                                Receipt
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="Invoice" asp-route-id="1">
                                Invoice
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="BillingController" asp-route-id="1">
                                Billing Controller
                            </a>

                        </div>

                    </div>


                    <!-- =========================================================
                         CREATE FEEDBACK
                    ========================================================== -->
                    <div class="sidebar-menu">

                        <div class="sidebar-link sidebar-dropdown"
                             data-bs-toggle="collapse"
                             data-bs-target="#createFeedbackMenu"
                             aria-expanded="false">

                            <span class="menu-icon">
                                <i class="fas fa-comment-medical"></i>
                            </span>

                            <span class="menu-text">
                                Create Feedback
                            </span>

                            <span class="menu-arrow">
                                <i class="fas fa-chevron-down"></i>
                            </span>

                        </div>


                        <div id="createFeedbackMenu"
                             class="sidebar-submenu collapse">

                            <a asp-controller="SuperAdmin"
                               asp-action="SAFeedback" asp-route-id="1">
                                Trainee
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="SAOrgFeedback" asp-route-id="1">
                                Organization
                            </a>

                        </div>

                    </div>


                    <!-- =========================================================
                         VIEW FEEDBACK
                    ========================================================== -->
                    <div class="sidebar-menu">

                        <div class="sidebar-link sidebar-dropdown"
                             data-bs-toggle="collapse"
                             data-bs-target="#viewFeedbackMenu"
                             aria-expanded="false">

                            <span class="menu-icon">
                                <i class="fas fa-comments"></i>
                            </span>

                            <span class="menu-text">
                                View Feedback
                            </span>

                            <span class="menu-arrow">
                                <i class="fas fa-chevron-down"></i>
                            </span>

                        </div>


                        <div id="viewFeedbackMenu"
                             class="sidebar-submenu collapse">

                            <a asp-controller="SuperAdmin"
                               asp-action="CandidateFeedback" asp-route-id="1">
                                Trainee
                            </a>

                            <a asp-controller="SuperAdmin"
                               asp-action="OrganizationFeedback" asp-route-id="1">
                                Organization
                            </a>

                        </div>

                    </div>

                </div>
            }

            <!-- ================= SIDEBAR BOTTOM ================= -->

            <div class="sidebar-bottom">

                <div class="sidebar-user">

                    <div class="sidebar-user-avatar">
                        <i class="fas fa-user"></i>
                    </div>

                    <div class="sidebar-user-info">

                        <strong>
                            @ViewData["UserName"]
                        </strong>

                        <small>
                            @ViewData["Panel"]
                        </small>

                    </div>

                </div>


                <a asp-controller="Account"
                   asp-action="Logout"
                   class="logout-link">

                    <span class="menu-icon">
                        <i class="fas fa-right-from-bracket"></i>
                    </span>

                    <span class="menu-text">
                        Logout
                    </span>

                </a>

            </div>

        </aside>


        <!-- ================= MAIN ================= -->

        <div class="dashboard-main">


            <!-- ================= HEADER ================= -->

            <header class="dashboard-header">

                <div class="header-left">

                    <button class="sidebar-toggle"
                            id="sidebarToggle"
                            type="button">
                        <i class="fas fa-bars"></i>
                    </button>


                    <div class="header-page-info">

                        <span class="header-small-text">
                            @ViewData["Panel"] Portal
                        </span>

                        <strong>
                            @ViewData["Title"]
                        </strong>

                    </div>

                </div>


                <div class="header-right">

                    <!-- Search -->
                    <div class="header-search">

                        <i class="fas fa-search"></i>

                        <input type="text"
                               placeholder="Search..." />

                    </div>


                    <!-- Notification -->
                    <button class="header-icon-btn">

                        <i class="far fa-bell"></i>

                        <span class="notification-dot"></span>

                    </button>


                    <!-- User -->
                    <div class="header-user-dropdown">

                        <button type="button"
                                class="header-user"
                                id="userDropdownBtn">

                            <div class="header-avatar">
                                <i class="fas fa-user"></i>
                            </div>

                            <div class="header-user-info">

                                <strong>
                                    @ViewData["UserName"]
                                </strong>

                                <small>
                                    @ViewData["Panel"]
                                </small>

                            </div>

                            <i class="fas fa-chevron-down user-arrow"></i>

                        </button>


                        <!-- USER DROPDOWN -->

                        <div class="user-dropdown-menu"
                             id="userDropdownMenu">

                            <div class="dropdown-user-header">

                                <div class="dropdown-avatar">
                                    <i class="fas fa-user"></i>
                                </div>

                                <div>

                                    <strong>
                                        @ViewData["UserName"]
                                    </strong>

                                    <small>
                                        @ViewData["Panel"]
                                    </small>

                                </div>

                            </div>


                            <div class="dropdown-divider"></div>


                            <a href="#"
                               class="user-dropdown-item">

                                <span class="dropdown-item-icon">
                                    <i class="fas fa-user"></i>
                                </span>

                                <span>
                                    My Profile
                                </span>

                            </a>


                            <a href="#"
                               class="user-dropdown-item">

