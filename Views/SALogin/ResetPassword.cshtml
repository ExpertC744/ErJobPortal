
@model ErJobPortal.Models.SuperAdminResetPassword

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Reset Super Admin Password</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/SALogin.css" />

    <style>
        .otp-action-button {
            width: 100%;
            min-width: 0;
            margin-top: 10px;
        }

        .otp-input {
            letter-spacing: 5px;
            font-size: 16px;
            font-weight: 700;
            text-align: center;
        }

        .otp-status {
            display: block;
            margin-top: 9px;
            font-size: 11px;
            line-height: 1.5;
        }

        .otp-success {
            color: #198754;
        }

        .otp-error {
            color: #dc3545;
        }

        .otp-verified-badge {
            display: none;
            margin-top: 10px;
            padding: 9px 11px;
            border-radius: 8px;
            background: #eef8f5;
            color: #1e7b67;
            font-size: 11px;
            font-weight: 600;
        }

            .otp-verified-badge i {
                margin-right: 5px;
            }

        .sa-login-button:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

            .sa-login-button:disabled:hover {
                background: #1e7b67;
            }

        .otp-divider {
            border: 0;
            border-top: 1px solid #edf1ef;
            margin: 18px 0;
        }

        .sa-login-button span {
            white-space: nowrap;
        }
    </style>
</head>

<body>
    <div class="sa-login-page">
        <div class="bg-circle bg-circle-one"></div>
        <div class="bg-circle bg-circle-two"></div>

        <div class="sa-login-wrapper">
            <div class="sa-login-card">

                <!-- HEADER -->
                <div class="sa-login-brand">
                    <div class="sa-login-icon">
                        <i class="fas fa-key"></i>
                    </div>

                    <h2>Reset Password</h2>

                    <p>Securely reset your Super Admin account password</p>
                </div>

                <!-- SECURITY BADGE -->
                <div class="security-badge">
                    <i class="fas fa-shield-halved"></i>
                    Super Admin Password Reset
                </div>

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="login-error"
                     role="alert">
                </div>

                @if (TempData["Error"] != null)
                {
                    <div class="login-error" role="alert">
                        <i class="fas fa-circle-exclamation"></i>
                        @TempData["Error"]
                    </div>
                }

                <form asp-controller="SALogin"
                      asp-action="ResetPassword"
                      method="post"
                      id="resetPasswordForm">

                    @Html.AntiForgeryToken()

                    <!-- EMAIL -->
                    <div class="sa-form-group">
                        <label asp-for="sEmail" class="sa-form-label">
                            Registered Email Address
                        </label>

                        <div class="sa-input-wrapper">
                            <i class="fas fa-envelope sa-input-icon"></i>

                            <input asp-for="sEmail"
                                   id="sEmail"
                                   class="sa-input"
                                   type="email"
                                   placeholder="Enter your registered email"
                                   autocomplete="email" />
                        </div>

                        <span asp-validation-for="sEmail"
                              class="field-validation"></span>

                        <!-- SEND OTP -->
                        <button type="button"
                                id="sendOtpBtn"
                                class="sa-login-button otp-action-button">
                            <i class="fas fa-paper-plane"></i>
                            <span>Send Email OTP</span>
                        </button>

                        <!-- OTP STATUS -->
                        <div id="otpMessage"
                             class="otp-status"
                             role="status"
                             aria-live="polite"></div>

                        <!-- OTP INPUT -->
                        <div id="otpSection" style="display:none;">
                            <hr class="otp-divider" />

                            <label for="otpInput" class="sa-form-label">
                                Enter 6-Digit OTP
                            </label>

                            <div class="sa-input-wrapper">
                                <i class="fas fa-shield-halved sa-input-icon"></i>

                                <input type="text"
                                       id="otpInput"
                                       class="sa-input otp-input"
                                       placeholder="••••••"
                                       maxlength="6"
                                       inputmode="numeric"
                                       autocomplete="one-time-code" />
                            </div>

                            <button type="button"
                                    id="verifyOtpBtn"
                                    class="sa-login-button otp-action-button">
                                <i class="fas fa-circle-check"></i>
                                <span>Verify OTP</span>
                            </button>
                        </div>

                        <!-- VERIFIED MESSAGE -->
                        <div id="otpVerifiedMessage"
                             class="otp-verified-badge">
                            <i class="fas fa-circle-check"></i>
                            Email verified successfully.
                        </div>
                    </div>

                    <!-- NEW PASSWORD -->
                    <div class="sa-form-group">
                        <label asp-for="NewPassword" class="sa-form-label">
                            New Password
                        </label>

                        <div class="sa-input-wrapper">
                            <i class="fas fa-lock sa-input-icon"></i>

                            <input asp-for="NewPassword"
                                   id="newPassword"
                                   class="sa-input"
                                   type="password"
                                   placeholder="Enter new password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="toggleNewPassword"
                                    aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="NewPassword"
                              class="field-validation"></span>
                    </div>

                    <!-- CONFIRM PASSWORD -->
                    <div class="sa-form-group">
                        <label asp-for="ConfirmPassword"
                               class="sa-form-label">
                            Confirm Password
                        </label>

                        <div class="sa-input-wrapper">
                            <i class="fas fa-lock sa-input-icon"></i>

                            <input asp-for="ConfirmPassword"
                                   id="confirmPassword"
                                   class="sa-input"
                                   type="password"
                                   placeholder="Confirm new password"
                                   autocomplete="new-password" />

                            <button type="button"
                                    class="password-toggle"
                                    id="toggleConfirmPassword"
                                    aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              class="field-validation"></span>
                    </div>

                    <!-- RESET BUTTON -->
                    <button type="submit"
                            id="resetPasswordBtn"
                            class="sa-login-button otp-action-button"
                            disabled>
                        <i class="fas fa-key"></i>
                        <span>Reset Password</span>
                    </button>

                    <!-- BACK TO LOGIN -->
                    <div class="text-center mt-3">
                        <a asp-controller="SALogin"
                           asp-action="Index"
                           class="text-decoration-none fw-semibold"
                           style="color:#1e7b67;font-size:12px;">
                            <i class="fas fa-arrow-left me-1"></i>
                            Back to Login
                        </a>
                    </div>
                </form>

                <!-- FOOTER -->
                <div class="sa-login-footer">
                    <i class="fas fa-shield-halved"></i>
                    Authorized Super Admin Access Only
                </div>
            </div>
        </div>
    </div>

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("resetPasswordForm");
            const emailInput = document.getElementById("sEmail");
            const otpInput = document.getElementById("otpInput");
            const otpSection = document.getElementById("otpSection");
            const otpMessage = document.getElementById("otpMessage");
            const verifiedMessage =
                document.getElementById("otpVerifiedMessage");

            const sendOtpBtn = document.getElementById("sendOtpBtn");
            const verifyOtpBtn = document.getElementById("verifyOtpBtn");
            const resetPasswordBtn =
                document.getElementById("resetPasswordBtn");

            let verifiedEmail = "";

            function setOtpMessage(message, success) {
                otpMessage.textContent = message;
                otpMessage.className =
                    "otp-status " + (success ? "otp-success" : "otp-error");
            }

            function isEmailVerified() {
                return verifiedEmail !== "" &&
                    emailInput.value.trim().toLowerCase() === verifiedEmail;
            }

            function updateResetButton() {
                resetPasswordBtn.disabled = !isEmailVerified();
            }

            function invalidateVerification() {
                verifiedEmail = "";
                verifiedMessage.style.display = "none";
                updateResetButton();
            }

            async function postForm(url, values) {
                const token = form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                ).value;

                const body = new URLSearchParams();
                body.append("__RequestVerificationToken", token);

                Object.entries(values).forEach(([key, value]) => {
                    body.append(key, value);
                });

                const response = await fetch(url, {
                    method: "POST",
                    headers: {
                        "Content-Type":
                            "application/x-www-form-urlencoded; charset=UTF-8"
                    },
                    body: body.toString()
                });

                if (!response.ok) {
                    throw new Error(
                        "Request failed. Please try again."
                    );
                }

                return await response.json();
            }

            // Password visibility toggles
            function setupPasswordToggle(inputId, buttonId) {
                const input = document.getElementById(inputId);
                const button = document.getElementById(buttonId);

                if (!input || !button) return;

                button.addEventListener("click", function () {
                    const icon = button.querySelector("i");
                    const showPassword = input.type === "password";

                    input.type = showPassword ? "text" : "password";

                    icon.classList.toggle("fa-eye", !showPassword);
                    icon.classList.toggle("fa-eye-slash", showPassword);

                    button.setAttribute(
                        "aria-label",
                        showPassword ? "Hide password" : "Show password"
                    );
                });
            }

            setupPasswordToggle("newPassword", "toggleNewPassword");
            setupPasswordToggle(
                "confirmPassword",
                "toggleConfirmPassword"
            );

            // If the email changes, the previous verification is invalid.
            emailInput.addEventListener("input", function () {
                invalidateVerification();
                otpSection.style.display = "none";
                otpInput.value = "";
                otpMessage.textContent = "";
            });

            // Send OTP
            sendOtpBtn.addEventListener("click", async function () {
                const email = emailInput.value.trim();

                if (!email || !emailInput.checkValidity()) {
                    setOtpMessage(
                        "Please enter a valid registered email address.",
                        false
                    );
                    emailInput.focus();
                    return;
                }

                invalidateVerification();
                sendOtpBtn.disabled = true;
                sendOtpBtn.querySelector("span").textContent = "Sending OTP...";

                try {
                    const result = await postForm(
                        '@Url.Action("SendSuperAdminResetOTP", "SALogin")',
                        { sEmail: email }
                    );

                    setOtpMessage(result.message, result.success);

                    if (result.success) {
                        otpSection.style.display = "block";
                        otpInput.value = "";
                        otpInput.focus();
                    }
                } catch (error) {
                    setOtpMessage(
                        error.message || "Unable to send OTP.",
                        false
                    );
                } finally {
                    sendOtpBtn.disabled = false;
                    sendOtpBtn.querySelector("span").textContent =
                        "Send Email OTP";
                }
            });

            // Only allow digits in the OTP field.
            otpInput.addEventListener("input", function () {
                otpInput.value = otpInput.value
                    .replace(/\D/g, "")
                    .slice(0, 6);
            });

            // Verify OTP
            verifyOtpBtn.addEventListener("click", async function () {
                const email = emailInput.value.trim();
                const otp = otpInput.value.trim();

                if (!/^\d{6}$/.test(otp)) {
                    setOtpMessage(
                        "Please enter the complete 6-digit OTP.",
                        false
                    );
                    return;
                }

                verifyOtpBtn.disabled = true;
                verifyOtpBtn.querySelector("span").textContent =
                    "Verifying...";

                try {
                    const result = await postForm(
                        '@Url.Action("VerifySuperAdminResetOTP", "SALogin")',
                        {
                            sEmail: email,
                            otp: otp
                        }
                    );

                    setOtpMessage(result.message, result.success);

                    if (result.success) {
                        verifiedEmail = email.toLowerCase();
                        verifiedMessage.style.display = "block";
                        updateResetButton();
                    } else {
                        invalidateVerification();
                    }
                } catch (error) {
                    setOtpMessage(
                        error.message || "Unable to verify OTP.",
                        false
                    );
                } finally {
                    verifyOtpBtn.disabled = false;
                    verifyOtpBtn.querySelector("span").textContent =
                        "Verify OTP";
                }
            });

            // Client-side guard; controller must still validate the session.
            form.addEventListener("submit", function (event) {
                if (!isEmailVerified()) {
                    event.preventDefault();
                    setOtpMessage(
                        "Please verify your email using OTP before resetting your password.",
                        false
                    );
                }
            });

            updateResetButton();
        });
    </script>
</body>
</html>
